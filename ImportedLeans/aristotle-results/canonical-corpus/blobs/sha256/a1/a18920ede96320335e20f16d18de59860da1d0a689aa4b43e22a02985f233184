------------------------------------------------------------------------

-- Machine checked here: the composition of the near and far pointwise
-- estimates into the Row A1 shell bound over a box-split cell functional,
-- and the whole budget arithmetic at the optimal radius.
nearFarCompositionLevel : ProofLevel
nearFarCompositionLevel = machineChecked

compositionBudgetArithmeticLevel : ProofLevel
compositionBudgetArithmeticLevel = machineChecked

