/-
# Uniqueness of the generator of a physical time evolution on a common core

The terminal Yang–Mills lane needs the step

  `U_t^{YM} = U_t^{OS}`  ⟹  `H_YM = H_Stone`.

The usual justification quotes Stone's theorem.  In fact the *uniqueness* half
of that step needs no Stone theorem at all, and in particular no
self-adjointness, no spectral theorem and no completeness: it is exactly
uniqueness of the derivative of the orbit map `t ↦ U t ψ` at `t = 0`.

This file proves that in the honest generality in which it is true:

* `generator_eq_of_hasDerivAt` — if the same orbit map has derivative
  `-i • A ψ` and `-i • B ψ` at `0`, then `A ψ = B ψ`;
* `IsEvolutionGenerator` — the (unbounded) predicate "`A` generates `U` on the
  set `D`", requiring nothing but differentiability of the orbit maps;
* `generator_unique_on_core` — two generators of the *same* one-parameter
  family agree pointwise on the common core `D`;
* `generator_unique_of_evolution_eq` — the version actually used downstream:
  equal evolutions force equal generators on the common core;
* `clm_eq_of_eqOn_dense` / `generator_clm_unique` — if moreover the generators
  are bounded and the core is dense, they are equal as operators.

Nothing here is conditional on a physical receipt: `D` is an arbitrary set and
`U` an arbitrary family of maps.  What the physics has to supply is exactly the
hypothesis that both candidate Hamiltonians differentiate the *same* physical
evolution on a *common* core.
-/
import Mathlib.Analysis.Calculus.Deriv.Basic
import Mathlib.Analysis.Normed.Module.Basic
import Mathlib.Analysis.InnerProductSpace.Basic

namespace YangMills

open Complex

variable {H : Type*} [NormedAddCommGroup H] [NormedSpace ℂ H]

/-- Uniqueness of the derivative of an orbit map, in the normalisation
`d/dt U_t ψ |_{t=0} = -i H ψ`. -/
theorem generator_eq_of_hasDerivAt {U : ℝ → H → H} {A B : H → H} {ψ : H}
    (hA : HasDerivAt (fun t : ℝ => U t ψ) (-Complex.I • A ψ) 0)
    (hB : HasDerivAt (fun t : ℝ => U t ψ) (-Complex.I • B ψ) 0) :
    A ψ = B ψ := by
  have h : (-Complex.I) • A ψ = (-Complex.I) • B ψ := hA.unique hB
  have hI : (-Complex.I) ≠ 0 := by
    simp [Complex.I_ne_zero]
  exact smul_right_injective H hI h

/-- `A` generates the one-parameter family `U` on the set `D`: for every state
in `D` the orbit map is differentiable at `t = 0` with derivative `-i A ψ`.

This is deliberately the weakest possible reading of "generator": no
self-adjointness, no unitarity, no continuity, no density.  It is all that the
uniqueness argument below needs. -/
def IsEvolutionGenerator (U : ℝ → H → H) (D : Set H) (A : H → H) : Prop :=
  ∀ ψ ∈ D, HasDerivAt (fun t : ℝ => U t ψ) (-Complex.I • A ψ) 0

/-- **Two generators of the same evolution agree on the common core.** -/
theorem generator_unique_on_core {U : ℝ → H → H} {D : Set H} {A B : H → H}
    (hA : IsEvolutionGenerator U D A) (hB : IsEvolutionGenerator U D B) :
    Set.EqOn A B D :=
  fun ψ hψ => generator_eq_of_hasDerivAt (hA ψ hψ) (hB ψ hψ)

/-- **The downstream form.**  If the two physical evolutions coincide and each
candidate Hamiltonian generates its own evolution on the common core `D`, the
two Hamiltonians agree on `D`.  This is the uniqueness content of the step
`U_t^{YM} = U_t^{OS} ⟹ H_YM = H_Stone`. -/
theorem generator_unique_of_evolution_eq {U V : ℝ → H → H} {D : Set H} {A B : H → H}
    (hUV : U = V) (hA : IsEvolutionGenerator U D A) (hB : IsEvolutionGenerator V D B) :
    Set.EqOn A B D :=
  generator_unique_on_core hA (hUV ▸ hB)

/-- Two bounded operators agreeing on a dense set are equal. -/
theorem clm_eq_of_eqOn_dense {D : Set H} (hD : Dense D) {A B : H →L[ℂ] H}
    (h : Set.EqOn (A : H → H) (B : H → H) D) : A = B := by
  ext ψ
  exact congrFun (Continuous.ext_on hD A.continuous B.continuous h) ψ

/-- If the two generators are bounded and the common core is dense, they are
equal as operators on all of `H`. -/
theorem generator_clm_unique {U V : ℝ → H → H} {D : Set H} (hD : Dense D)
    {A B : H →L[ℂ] H} (hUV : U = V)
    (hA : IsEvolutionGenerator U D (A : H → H))
    (hB : IsEvolutionGenerator V D (B : H → H)) :
    A = B :=
  clm_eq_of_eqOn_dense hD (generator_unique_of_evolution_eq hUV hA hB)

/-- Sanity check that the notion is non-vacuous: the trivial evolution
`U t = id` is generated by the zero operator on every set. -/
theorem isEvolutionGenerator_zero (D : Set H) :
    IsEvolutionGenerator (fun _ : ℝ => (id : H → H)) D (fun _ => 0) := by
  intro ψ _
  simpa using (hasDerivAt_const (0 : ℝ) ψ)

end YangMills

#print axioms YangMills.generator_eq_of_hasDerivAt
#print axioms YangMills.generator_unique_on_core
#print axioms YangMills.generator_unique_of_evolution_eq
#print axioms YangMills.generator_clm_unique
#print axioms YangMills.isEvolutionGenerator_zero
