import Synthesis.MillenniumBSDFullyExplicitGlobalCoefficients\nimport Synthesis.MillenniumBSDOddAnalyticHalfPlane\nimport Synthesis.MillenniumBSDGlobalBadPrimeTwo\nimport Mathlib.Data.Nat.Factorization.Basic\nimport Mathlib.Tactic\n\n/-!\n# Full literal global BSD L-series = analytic Euler product\n\nSince the additive p=2 local polynomial is 1, every positive 2-power\ncoefficient vanishes.  Multiplicativity therefore kills every positive even\nglobal coefficient.  The previously named `cmOddLSeries` is consequently the\nentire literal mathlib `cmLSeries`.\n\nWe also remove the synthetic p=2 branch from the analytic denominator by\nshowing it equals evaluation of the actual localPolynomial at every prime.\n-/\n\nnamespace Synthesis.Millennium.BSD\n\nopen ArithmeticFunction\nopen Polynomial\n\ntheorem cmAllNCoefficient_eq_zero_of_even\n    {n : ℕ} (hnEven : Even n) (hn0 : n ≠ 0) :\n    cmAllNCoefficient n = 0 := by\n  let e := n.factorization 2\n  let m := Nat.ordCompl[2] n\n  have h2dvd : 2 ∣ n := (Nat.even_iff_two_dvd.mp hnEven)\n  have hepos : 0 < e := by\n    dsimp [e]\n    exact Nat.prime_two.factorization_pos_of_dvd hn0 h2dvd\n  have hdecomp : 2 ^ e * m = n := by\n    simpa [e, m, Nat.ordProj] using\n      (Nat.ordProj_mul_ordCompl_eq_self n 2)\n  have hcop : (2 ^ e).Coprime m := by\n    exact (Nat.coprime_ordCompl Nat.prime_two hn0).pow_left e\n  rw [← hdecomp, cmAllNCoefficient_coprime_mul hcop]\n  rw [cmAllNCoefficient_twoPower e]\n  simp [hepos.ne']\n\ntheorem cmAllNCoefficient_eq_zero_of_not_odd\n    {n : ℕ} (hnodd : ¬ Odd n) :\n    cmAllNCoefficient n = 0 := by\n  by_cases hn0 : n = 0\n  · subst n\n    exact cmAllNCoefficient_zero\n  · exact cmAllNCoefficient_eq_zero_of_even\n      (Nat.not_odd_iff_even.mp hnodd) hn0\n\ntheorem cmOddCoefficient_eq_globalCoefficient\n    (n : ℕ) :\n    cmOddCoefficient n = (cmAllNCoefficient n : ℂ) := by\n  by_cases hnodd : Odd n\n  · simp [cmOddCoefficient, hnodd]\n  · simp [cmOddCoefficient, hnodd,\n      cmAllNCoefficient_eq_zero_of_not_odd hnodd]\n\ntheorem cmLSeries_eq_cmOddLSeries\n    (s : ℂ) :\n    cmLSeries s = cmOddLSeries s := by\n  rw [cmOddLSeries_eq_LSeries]\n  unfold cmLSeries WeierstrassCurve.LSeries\n  apply LSeries_congr\n  intro n hn\n  simpa [Function.comp_apply] using\n    (cmOddCoefficient_eq_globalCoefficient n).symm\n\nnoncomputable def cmActualGlobalLocalDenominator\n    (p : Nat.Primes) (s : ℂ) : ℂ :=\n  letI : Fact p.1.Prime := ⟨p.2⟩\n  Polynomial.eval₂ (Int.castRingHom ℂ)\n    ((p.1 : ℂ) ^ (-s))\n    ((cmWeierstrass.baseChange\n      ((rationalPrimePlace p.1).adicCompletion ℚ)).localPolynomial\n      ((rationalPrimePlace p.1).adicCompletionIntegers ℚ))\n\ntheorem cmActualGlobalLocalDenominator_eq_cmGlobalLocalDenominator\n    (p : Nat.Primes) (s : ℂ) :\n    cmActualGlobalLocalDenominator p s =\n      cmGlobalLocalDenominator p s := by\n  letI : Fact p.1.Prime := ⟨p.2⟩\n  by_cases hp2 : p.1 = 2\n  · subst p\n    simp [cmActualGlobalLocalDenominator, cmGlobalLocalDenominator,\n      globalHeightOne_localPolynomial_two_eq_one]\n  · simp [cmActualGlobalLocalDenominator, cmGlobalLocalDenominator, hp2]\n\ntheorem cmActualGlobalLocalDenominator_eq_explicit\n    (p : Nat.Primes) (s : ℂ) :\n    cmActualGlobalLocalDenominator p s = explicitEulerDenominator p s := by\n  rw [cmActualGlobalLocalDenominator_eq_cmGlobalLocalDenominator]\n  exact cmGlobalLocalDenominator_eq_explicit p s\n\nnoncomputable def cmActualGlobalEulerDenominatorProduct\n    (s : ℂ) : ℂ :=\n  ∏' p : Nat.Primes, cmActualGlobalLocalDenominator p s\n\ntheorem cmActualGlobalEulerDenominatorProduct_eq_previous\n    (s : ℂ) :\n    cmActualGlobalEulerDenominatorProduct s =\n      cmPrimeToTwoEulerDenominatorProduct s := by\n  apply tprod_congr\n  intro p\n  exact cmActualGlobalLocalDenominator_eq_cmGlobalLocalDenominator p s\n\ntheorem cmActualGlobalEulerDenominatorProduct_ne_zero\n    {s : ℂ} (hs : 2 < s.re) :\n    cmActualGlobalEulerDenominatorProduct s ≠ 0 := by\n  rw [cmActualGlobalEulerDenominatorProduct_eq_previous]\n  exact cmPrimeToTwoEulerDenominatorProduct_ne_zero hs\n\nnoncomputable def cmActualGlobalAnalyticEulerProduct\n    (s : ℂ) : ℂ :=\n  (cmActualGlobalEulerDenominatorProduct s)⁻¹\n\ntheorem cmActualGlobalAnalyticEulerProduct_eq_previous\n    (s : ℂ) :\n    cmActualGlobalAnalyticEulerProduct s =\n      cmPrimeToTwoAnalyticEulerProduct s := by\n  simp [cmActualGlobalAnalyticEulerProduct,\n    cmPrimeToTwoAnalyticEulerProduct,\n    cmActualGlobalEulerDenominatorProduct_eq_previous]\n\ntheorem cmLSeries_eq_actualGlobalEulerProduct\n    {s : ℂ} (hs : 3 < s.re) :\n    cmLSeries s = cmActualGlobalAnalyticEulerProduct s := by\n  rw [cmLSeries_eq_cmOddLSeries s]\n  rw [cmOddLSeries_eq_primeToTwoAnalyticEulerProduct hs]\n  exact (cmActualGlobalAnalyticEulerProduct_eq_previous s).symm\n\ntheorem cmLSeries_ne_zero\n    {s : ℂ} (hs : 3 < s.re) :\n    cmLSeries s ≠ 0 := by\n  rw [cmLSeries_eq_actualGlobalEulerProduct hs]\n  rw [cmActualGlobalAnalyticEulerProduct_eq_previous]\n  exact cmPrimeToTwoAnalyticEulerProduct_ne_zero (by linarith)\n\ntheorem cmLSeries_analyticOn_halfPlane :\n    AnalyticOn ℂ cmLSeries {s : ℂ | 3 < s.re} := by\n  have heq : cmLSeries = cmOddLSeries := by\n    funext s\n    exact cmLSeries_eq_cmOddLSeries s\n  rw [heq]\n  exact cmOddLSeries_analyticOn\n\ntheorem cmLSeries_differentiableOn_halfPlane :\n    DifferentiableOn ℂ cmLSeries {s : ℂ | 3 < s.re} :=\n  cmLSeries_analyticOn_halfPlane.differentiableOn\n\ntheorem cmActualGlobalAnalyticEulerProduct_ne_zero\n    {s : ℂ} (hs : 2 < s.re) :\n    cmActualGlobalAnalyticEulerProduct s ≠ 0 := by\n  rw [cmActualGlobalAnalyticEulerProduct_eq_previous]\n  exact cmPrimeToTwoAnalyticEulerProduct_ne_zero hs\n\nend Synthesis.Millennium.BSD\n