regionThemeSemantic :
  ∀ {n t} → BrainRegionThemeAt n t → Semantic.BrainInvariantSemantic
regionThemeSemantic theme =
  Semantic.semanticOfState (BrainRegionThemeAt.carrier theme)

visualThemeSemantic :
  ∀ {n t} → BrainVisualThemeAt n t → Semantic.BrainInvariantSemantic
