        (PT.rec (isSetFin {k = 2}  _ _)
          (uncurry (ℤ/2-elim
          (λ p → ⊥.rec (snotz (sym (cong fst p))))
           λ p → ⊥.rec (snotz (sym (cong fst p)))))))
        (ℤ/2-elim (PT.rec (isSetFin {k = 2}  _ _)
          (uncurry (ℤ/2-elim
          (λ p → ⊥.rec (snotz (sym (cong fst p))))
