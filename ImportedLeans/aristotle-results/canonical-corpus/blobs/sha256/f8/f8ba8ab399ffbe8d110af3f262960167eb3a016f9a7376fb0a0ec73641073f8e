namespace Epistemic

/-! ## Admissible runs -/

variable {S A O C : Type}

/-- Running a list of actions through a step relation. -/
inductive Executes (step : S → A → S → Prop) : List A → S → S → Prop
  | nil {s : S} : Executes step [] s s
  | cons {a : A} {as : List A} {s t u : S} :
      step s a t → Executes step as t u → Executes step (a :: as) s u

theorem executes_single {step : S → A → S → Prop} {a : A} {s t : S} (h : step s a t) :
    Executes step [a] s t := Executes.cons h Executes.nil

/-! ## Consumer-relative dynamic safety -/

-- @source DASHI Agda bridge (PR #555/#581/#582): consumer-relative dynamic safety and terminalisation defects
/-- The consumer's view is *dynamically safe*: states it currently cannot separate
remain indistinguishable to it along every admissible run of the same actions. -/
def DynamicSafety (step : S → A → S → Prop) (obs : S → O) : Prop :=
  ∀ (as : List A) (x y x' y' : S), obs x = obs y →
    Executes step as x x' → Executes step as y y' → obs x' = obs y'

-- @source DASHI Agda bridge (PR #555/#581/#582): consumer-relative dynamic safety and terminalisation defects
/-- The exact refutation of dynamic safety: a currently invisible distinction that
an admissible run makes visible. -/
def TerminalisationDefect (step : S → A → S → Prop) (obs : S → O) : Prop :=
  ∃ (as : List A) (x y x' y' : S), obs x = obs y ∧
    Executes step as x x' ∧ Executes step as y y' ∧ obs x' ≠ obs y'

theorem not_dynamicSafety_of_defect {step : S → A → S → Prop} {obs : S → O}
    (h : TerminalisationDefect step obs) : ¬ DynamicSafety step obs := by
  obtain ⟨as, x, y, x', y', hobs, hx, hy, hne⟩ := h
  exact fun hsafe => hne (hsafe as x y x' y' hobs hx hy)

/-- A consumer that deliberately observes a constant public surface is safe. -/
theorem dynamicSafety_of_const (step : S → A → S → Prop) (o : O) :
    DynamicSafety step (fun _ => o) := by
  intro _ _ _ _ _ _ _ _; rfl

/-- A separating consumer is safe exactly when the dynamics are deterministic on
its runs; in particular a defect for a coarse consumer says nothing about a fine
one. -/
theorem dynamicSafety_of_injective_step {step : S → A → S → Prop} {obs : S → O}
    (hsep : Separating obs)
    (hdet : ∀ (as : List A) (x x' y' : S), Executes step as x x' → Executes step as x y' →
      x' = y') : DynamicSafety step obs := by
  intro as x y x' y' hobs hx hy
  have hxy : x = y := hsep x y hobs
  subst hxy
  rw [hdet as x x' y' hx hy]

-- @source DASHI Agda bridge (PR #555/#581/#582): consumer-relative dynamic safety and terminalisation defects
/-- Safety for a family of consumers. -/
def PluralDynamicSafety (step : S → A → S → Prop) (family : C → S → O) : Prop :=
  ∀ c, DynamicSafety step (family c)

-- @source DASHI Agda bridge (PR #555/#581/#582): consumer-relative dynamic safety and terminalisation defects
/-- **Local consumer safety does not promote to plural safety.** -/
theorem not_plural_of_defect {step : S → A → S → Prop} {family : C → S → O} {c : C}
    (h : TerminalisationDefect step (family c)) : ¬ PluralDynamicSafety step family :=
  fun hplural => not_dynamicSafety_of_defect h (hplural c)

/-- One consumer safe, another defective: the asymmetry that blocks promotion. -/
theorem consumer_safety_asymmetry {step : S → A → S → Prop} {family : C → S → O}
    {safeConsumer defectConsumer : C} (hsafe : DynamicSafety step (family safeConsumer))
    (hdefect : TerminalisationDefect step (family defectConsumer)) :
    DynamicSafety step (family safeConsumer) ∧ ¬ PluralDynamicSafety step family :=
  ⟨hsafe, not_plural_of_defect hdefect⟩

/-! ## Policy-relative safety

A policy chooses its intervention from the coarse observation alone. -/

-- @source DASHI Agda bridge (PR #555/#581/#582): policy-relative safety and policy-exposed quotient defects
/-- Safety of a coarse policy: acting on indistinguishable observations leads to
indistinguishable observations. -/
def PolicyRelativeSafety (step : S → A → S → Prop) (obs : S → O) (policy : O → A) : Prop :=
  ∀ x y x' y' : S, obs x = obs y →
    step x (policy (obs x)) x' → step y (policy (obs y)) y' → obs x' = obs y'

-- @source DASHI Agda bridge (PR #555/#581/#582): policy-relative safety and policy-exposed quotient defects
/-- The exact refutation: the policy selects the same action for two collapsed
states and the futures are then distinguishable. -/
def PolicyExposedQuotientDefect (step : S → A → S → Prop) (obs : S → O) (policy : O → A) :
    Prop :=
  ∃ x y x' y' : S, obs x = obs y ∧
    step x (policy (obs x)) x' ∧ step y (policy (obs y)) y' ∧ obs x' ≠ obs y'

theorem not_policySafety_of_defect {step : S → A → S → Prop} {obs : S → O} {policy : O → A}
    (h : PolicyExposedQuotientDefect step obs policy) :
    ¬ PolicyRelativeSafety step obs policy := by
  obtain ⟨x, y, x', y', hobs, hx, hy, hne⟩ := h
  exact fun hsafe => hne (hsafe x y x' y' hobs hx hy)

-- @source DASHI Agda bridge (PR #555/#581/#582): policy-relative safety and policy-exposed quotient defects
/-- Dynamic safety of a consumer implies safety of every coarse policy it drives. -/
theorem policyRelativeSafety_of_dynamicSafety {step : S → A → S → Prop} {obs : S → O}
    (h : DynamicSafety step obs) (policy : O → A) : PolicyRelativeSafety step obs policy := by
  intro x y x' y' hobs hx hy
  refine h [policy (obs x)] x y x' y' hobs (executes_single hx) ?_
  rw [hobs]
  exact executes_single hy

/-- Hence a policy defect is also a refutation of the consumer's dynamic safety. -/
theorem not_dynamicSafety_of_policyDefect {step : S → A → S → Prop} {obs : S → O}
    {policy : O → A} (h : PolicyExposedQuotientDefect step obs policy) :
    ¬ DynamicSafety step obs :=
  fun hsafe => not_policySafety_of_defect h (policyRelativeSafety_of_dynamicSafety hsafe policy)

/-! ## Diachronic delegated authority -/

namespace Authority

/-- Who issued a delegation.  Only the principal can confer authority over their
own affairs; a supporter cannot. -/
inductive Issuer
  | principal
  | supporter
  deriving DecidableEq, Repr, Inhabited

/-- A mandate: a holder authorised for a scope. -/
structure Mandate where
  /-- The party who would hold the authority. -/
  holder : Nat
  /-- The scope of the authority. -/
  scope : Nat
  deriving DecidableEq, Repr, Inhabited

/-- An event in the authority history. -/
inductive AuthEvent
  | grant (issuer : Issuer) (mandate : Mandate)
  | revoke (mandate : Mandate)
  deriving DecidableEq, Repr, Inhabited

/-- How one event updates the current authority for a given mandate. -/
def step (m : Mandate) (st : Bool) : AuthEvent → Bool
  | AuthEvent.grant issuer m' => if issuer = Issuer.principal ∧ m' = m then true else st
  | AuthEvent.revoke m' => if m' = m then false else st

-- @source DASHI Agda bridge (PR #555/#581/#582): diachronic delegated authority and revocation laws
/-- Current authority for a mandate, read off the whole chronological history. -/
def currentAuthority (history : List AuthEvent) (m : Mandate) : Bool :=
  history.foldl (step m) false

-- @source DASHI Agda bridge (PR #555/#581/#582): diachronic delegated authority and revocation laws
/-- The historical record: the mandate was granted at some point. -/
def everGranted (history : List AuthEvent) (m : Mandate) : Bool :=
  history.any (fun e => e = AuthEvent.grant Issuer.principal m)

@[simp] theorem currentAuthority_nil (m : Mandate) : currentAuthority [] m = false := rfl

theorem currentAuthority_append (h₁ h₂ : List AuthEvent) (m : Mandate) :
    currentAuthority (h₁ ++ h₂) m = h₂.foldl (step m) (currentAuthority h₁ m) := by
  simp [currentAuthority, List.foldl_append]

-- @source DASHI Agda bridge (PR #555/#581/#582): diachronic delegated authority and revocation laws
/-- **Revocation terminates prospective authority.** -/
theorem currentAuthority_append_revoke (h : List AuthEvent) (m : Mandate) :
    currentAuthority (h ++ [AuthEvent.revoke m]) m = false := by
  simp [currentAuthority_append, step]

/-- **A fresh authorisation is required, and suffices.** -/
theorem currentAuthority_append_grant (h : List AuthEvent) (m : Mandate) :
    currentAuthority (h ++ [AuthEvent.grant Issuer.principal m]) m = true := by
  simp [currentAuthority_append, step]

/-- No event other than a principal's grant of the very same mandate can turn
authority back on. -/
theorem foldl_step_eq_false (m : Mandate) :
    ∀ (h : List AuthEvent), (∀ e ∈ h, e ≠ AuthEvent.grant Issuer.principal m) →
      h.foldl (step m) false = false := by
  intro h
  induction h with
  | nil => intro _; rfl
  | cons e t ih =>
      intro hno
      have hstep : step m false e = false := by
        cases e with
        | grant issuer m' =>
            by_cases hi : issuer = Issuer.principal ∧ m' = m
            · exact absurd (by rw [hi.1, hi.2]) (hno _ List.mem_cons_self)
            · simp [step, hi]
        | revoke m' => by_cases hm : m' = m <;> simp [step, hm]
      simp only [List.foldl_cons, hstep]
      exact ih (fun e' he' => hno e' (List.mem_cons_of_mem _ he'))

-- @source DASHI Agda bridge (PR #555/#581/#582): diachronic delegated authority and revocation laws
/-- **Historical evidence does not restore authority**: after a revocation, only a
new grant can, and until then the authority stays off. -/
theorem currentAuthority_eq_false_of_no_regrant (h₁ h₂ : List AuthEvent) (m : Mandate)
    (hno : ∀ e ∈ h₂, e ≠ AuthEvent.grant Issuer.principal m) :
    currentAuthority (h₁ ++ AuthEvent.revoke m :: h₂) m = false := by
  rw [currentAuthority_append]
  simp only [List.foldl_cons]
  have : step m (currentAuthority h₁ m) (AuthEvent.revoke m) = false := by simp [step]
  rw [this]
  exact foldl_step_eq_false m h₂ hno

-- @source DASHI Agda bridge (PR #555/#581/#582): diachronic delegated authority and revocation laws
/-- **Revocation does not erase the record.** -/
theorem everGranted_append_revoke (h : List AuthEvent) (m : Mandate) :
    everGranted (h ++ [AuthEvent.revoke m]) m = everGranted h m := by
  simp [everGranted]

/-- The historical record and the current authority are different things. -/
theorem exists_everGranted_and_not_current :
    ∃ (h : List AuthEvent) (m : Mandate),
      everGranted h m = true ∧ currentAuthority h m = false := by
  refine ⟨[AuthEvent.grant Issuer.principal ⟨0, 0⟩, AuthEvent.revoke ⟨0, 0⟩], ⟨0, 0⟩, ?_, ?_⟩ <;>
    decide

-- @source DASHI Agda bridge (PR #555/#581/#582): diachronic delegated authority and revocation laws
/-- **A supporter cannot self-authorise an override.** -/
theorem supporter_cannot_self_authorise (h : List AuthEvent) (m : Mandate)
    (hno : ∀ e ∈ h, e ≠ AuthEvent.grant Issuer.principal m) :
    currentAuthority (h ++ [AuthEvent.grant Issuer.supporter m]) m = false := by
  rw [currentAuthority_append]
  have hfalse : currentAuthority h m = false := foldl_step_eq_false m h hno
  simp [hfalse, step]

/-- Authority is scope-sensitive: a grant for one mandate is not a grant for
another. -/
theorem currentAuthority_other_mandate (m m' : Mandate) (hne : m' ≠ m) :
    currentAuthority [AuthEvent.grant Issuer.principal m'] m = false := by
  simp [currentAuthority, step, hne]

/-! ### Acting under authority -/

/-- A discretionary act needs current authority; an unavoidable continuation of
something already under way does not, and confers none. -/
inductive ActKind
  | discretionary
  | unavoidableContinuation
  deriving DecidableEq, Repr, Inhabited

/-- An act, together with the mandate it would need. -/
structure Act where
  /-- Discretionary, or the unavoidable continuation of something already begun. -/
  kind : ActKind
  /-- The mandate the act would require if discretionary. -/
  mandate : Mandate
  deriving DecidableEq, Repr, Inhabited

/-- Whether an act may be performed against a history. -/
def Permitted (h : List AuthEvent) (a : Act) : Bool :=
  match a.kind with
  | ActKind.discretionary => currentAuthority h a.mandate
  | ActKind.unavoidableContinuation => true

-- @source DASHI Agda bridge (PR #555/#581/#582): diachronic delegated authority and revocation laws
/-- **An unavoidable continuation creates no new mandate**: it is permitted while
the corresponding discretionary act is not. -/
theorem unavoidable_continuation_creates_no_mandate (h : List AuthEvent) (m : Mandate)
    (hrevoked : currentAuthority h m = false) :
    Permitted h ⟨ActKind.unavoidableContinuation, m⟩ = true ∧
      Permitted h ⟨ActKind.discretionary, m⟩ = false := by
  refine ⟨rfl, ?_⟩
  simpa [Permitted] using hrevoked

-- @source DASHI Agda bridge (PR #555/#581/#582): diachronic delegated authority and revocation laws
/-- **New discretionary action after revocation requires fresh authorisation.** -/
theorem discretionary_act_requires_fresh_grant (h₁ h₂ : List AuthEvent) (m : Mandate)
    (hno : ∀ e ∈ h₂, e ≠ AuthEvent.grant Issuer.principal m) :
    Permitted (h₁ ++ AuthEvent.revoke m :: h₂) ⟨ActKind.discretionary, m⟩ = false := by
  simpa [Permitted] using currentAuthority_eq_false_of_no_regrant h₁ h₂ m hno

end Authority

end Epistemic
