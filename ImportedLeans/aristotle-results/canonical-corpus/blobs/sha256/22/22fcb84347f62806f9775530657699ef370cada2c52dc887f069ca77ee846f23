    (shiftCoarseStep-commute x)

shiftEigenSchedule :
  ∀ x →
  shiftRGAdmissible x →
  RGOI.RGObservable.eigenSummary
    (RGOI.RGObservableSurface.observe shiftRGSurface
      (shiftCoarse (EC.Contract.step ShiftC x)))
