    open AbGroupStr (snd G) renaming (_+_ to _+G_ ; -_ to -G_)

    a* : hLevelTrunc 2 A
    a* = conA .fst

  H⁰→G' : hLevelTrunc 2 A → H⁰A → fst G
  H⁰→G' = Trunc.rec (isSetΠ (λ _ → is-set))
            (λ a → ST.rec is-set λ f → f a)

