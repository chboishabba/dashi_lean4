import Integration.F3E6PGSpSameObjectBridge
import Mathlib

/-!
# Finite closure receipt for the F₃⁴ / E₆ exterior-square bridge

This owner closes the finite-group arithmetic seam left by the generator and
same-object bridge files.  It computes the subgroup generated by the six
literal four-space lifts already used by `F3E6PGSpSameObjectBridge`, proves the
closure has 103,680 matrices, proves its primitive exterior-square kernel is
exactly `{I,-I}`, and therefore records the projective quotient order 51,840.
All finite closure claims below are about those literal repo matrices, not an
order-only surrogate group.

The abstract identification of that quotient with the Weyl group remains a
separate theorem: the generated five-space action is already word-for-word the
repo E6 action, but cardinality is not used here to manufacture a group
isomorphism.
-/

namespace DASHI.Integration.F3E6PGSpClosure

open F3FourSymplecticExteriorSquare
open F3E6PGSpGeneratorBridge
open F3E6PGSpSameObjectBridge

/-- The six actual four-space lifts from the same-object bridge. -/
def generatorFinset : Finset M4 :=
  Finset.univ.image pgspLift

/-- One left-generator closure step.  Since the six lifts generate a finite
matrix group, iterating this operation from the identity reaches the exact
finite closure. -/
def closureStep (s : Finset M4) : Finset M4 :=
  s ∪ s.biUnion (fun a => generatorFinset.image (fun g => g * a))

/-- Breadth-style closure iterate. -/
def closureAfter : Nat → Finset M4
  | 0 => {1}
  | n + 1 => closureStep (closureAfter n)

/-- Local exact computation stabilizes after 36 expansion layers. -/
def generatedClosure : Finset M4 := closureAfter 36

/-- Kernel of the literal primitive exterior-square action on the generated
four-space closure. -/
def exteriorKernel : Finset M4 :=
  generatedClosure.filter (fun g => exteriorAction g = 1)

/-- Exact finite closure order of the six paid lifts. -/
theorem generatedClosure_card : generatedClosure.card = 103680 := by
  native_decide

/-- Thirty-six layers are enough: the next generator expansion adds nothing. -/
theorem generatedClosure_stable : closureStep generatedClosure = generatedClosure := by
  native_decide

/-- The primitive exterior-square representation kills exactly ±I on this
literal generated closure. -/
theorem exteriorKernel_eq_plusMinusIdentity :
    exteriorKernel = ({1, -1} : Finset M4) := by
  native_decide

theorem exteriorKernel_card : exteriorKernel.card = 2 := by
  rw [exteriorKernel_eq_plusMinusIdentity]
  native_decide

/-- Projectivizing by the exact ±I kernel gives the expected order 51,840. -/
theorem projectiveQuotientOrder :
    generatedClosure.card / exteriorKernel.card = 51840 := by
  rw [generatedClosure_card, exteriorKernel_card]
  decide

structure ClosureBoundary where
  sixLiteralLiftsConsumed : Bool
  fourSpaceClosureOrder103680Paid : Bool
  closureStabilityPaid : Bool
  exteriorKernelExactlyPlusMinusIPaid : Bool
  projectiveQuotientOrder51840Paid : Bool
  generatedFiveSpaceWordActionEqualsRepoE6 : Bool
  abstractPGSpQuotientWeylIsomorphismPaid : Bool
  deriving Repr

def closureBoundary : ClosureBoundary where
  sixLiteralLiftsConsumed := true
  fourSpaceClosureOrder103680Paid := true
  closureStabilityPaid := true
  exteriorKernelExactlyPlusMinusIPaid := true
  projectiveQuotientOrder51840Paid := true
  generatedFiveSpaceWordActionEqualsRepoE6 := true
  abstractPGSpQuotientWeylIsomorphismPaid := false

end DASHI.Integration.F3E6PGSpClosure
