  SU2Level4Representation →
  String
representationLabel j0Rep =
  "j=0"
representationLabel j1/2Rep =
  "j=1/2"
representationLabel j1Rep =
  "j=1"
representationLabel j3/2Rep =
  "j=3/2"
representationLabel j2Rep =
  "j=2"

record RationalReceipt : Set where
  field
