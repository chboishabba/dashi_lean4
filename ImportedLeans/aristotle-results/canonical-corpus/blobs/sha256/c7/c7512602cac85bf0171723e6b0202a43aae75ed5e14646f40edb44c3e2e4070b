namespace Wikidata

/-! ## Snaks, references, statements -/

/-- A Wikidata data value. -/
inductive Value
  | item (q : Qid)
  | quantity (q : Quantity)
  | time (t : TimeValue)
  | coordinate (c : Coordinate)
  | text (s : String)
  deriving DecidableEq, Repr, Inhabited

/-- A snak: a property with a value, or one of the two special snak types.
`someValue` records that a value exists but is unknown; `noValue` records that
there is none. -/
inductive Snak
  | value (p : Pid) (v : Value)
  | someValue (p : Pid)
  | noValue (p : Pid)
  deriving DecidableEq, Repr, Inhabited

namespace Snak

/-- The property a snak is about. -/
def property : Snak → Pid
  | value p _ => p
  | someValue p => p
  | noValue p => p

/-- The item a snak points at, when it points at an item at all. -/
def itemValue? : Snak → Option Qid
  | value _ (Value.item q) => some q
  | _ => none

end Snak

/-- A reference: a named source together with the snaks that make it up. -/
structure Reference where
  source : String
  snaks : List Snak := []
  deriving DecidableEq, Repr, Inhabited

/-- A full Wikidata statement: a main snak, qualifiers, references and a rank. -/
structure FullStatement where
  subject : Qid
  mainsnak : Snak
  qualifiers : List Snak := []
  references : List Reference := []
  rank : Rank := Rank.normal
  deriving DecidableEq, Repr, Inhabited

/-- A knowledge base of full statements. -/
structure FullKB where
  entities : List Qid
  statements : List FullStatement
  deriving Repr, Inhabited

/-! ## The projection onto the core layer -/

namespace FullStatement

/-- The core statement a full statement projects to: defined exactly when the main
snak points at an item. -/
def toStatement? (fs : FullStatement) : Option Statement :=
  match fs.mainsnak with
  | Snak.value p (Value.item v) => some ⟨fs.subject, p, v, fs.rank⟩
  | _ => none

@[simp] theorem toStatement?_someValue (s : Qid) (p : Pid) (qs : List Snak)
    (rs : List Reference) (r : Rank) :
    toStatement? ⟨s, Snak.someValue p, qs, rs, r⟩ = none := rfl

@[simp] theorem toStatement?_noValue (s : Qid) (p : Pid) (qs : List Snak)
    (rs : List Reference) (r : Rank) :
    toStatement? ⟨s, Snak.noValue p, qs, rs, r⟩ = none := rfl

@[simp] theorem toStatement?_item (s : Qid) (p : Pid) (v : Qid) (qs : List Snak)
    (rs : List Reference) (r : Rank) :
    toStatement? ⟨s, Snak.value p (Value.item v), qs, rs, r⟩ = some ⟨s, p, v, r⟩ := rfl

/-- The projection ignores the qualifiers and the references entirely. -/
theorem toStatement?_congr {fs gs : FullStatement} (hsub : fs.subject = gs.subject)
    (hmain : fs.mainsnak = gs.mainsnak) (hrank : fs.rank = gs.rank) :
    fs.toStatement? = gs.toStatement? := by
  cases fs with
  | mk s m qs rs r =>
    cases gs with
    | mk s' m' qs' rs' r' =>
      simp only at hsub hmain hrank
      subst hsub; subst hmain; subst hrank
      rfl

end FullStatement

namespace FullKB

/-- The core knowledge base underlying a full one. -/
def core (fkb : FullKB) : KB :=
  ⟨fkb.entities, fkb.statements.filterMap FullStatement.toStatement?⟩

@[simp] theorem core_entities (fkb : FullKB) : fkb.core.entities = fkb.entities := rfl

theorem mem_core_statements_iff (fkb : FullKB) (st : Statement) :
    st ∈ fkb.core.statements ↔ ∃ fs ∈ fkb.statements, fs.toStatement? = some st := by
  simp [core, List.mem_filterMap]

/-- Restricting the full statements restricts the core statements. -/
theorem core_statements_subset {fkb gkb : FullKB} (h : fkb.statements ⊆ gkb.statements) :
    fkb.core.statements ⊆ gkb.core.statements := by
  intro st hst
  rw [mem_core_statements_iff] at hst ⊢
  obtain ⟨fs, hfs, hst⟩ := hst
  exact ⟨fs, h hfs, hst⟩

end FullKB

/-! ## What the projection forgets -/

/-- `P1013`, "criterion used" — a qualifier that changes what the claim says. -/
def P1013 : Pid := ⟨1013⟩

/-- **The core layer forgets qualifiers.**  Two statements that differ in the
respect in which they hold have the same projection, so no reading of the core
layer can separate them. -/
theorem core_forgets_qualifiers :
    ∃ fs gs : FullStatement,
      fs ≠ gs ∧ fs.qualifiers ≠ gs.qualifiers ∧ fs.toStatement? = gs.toStatement? := by
  refine ⟨⟨⟨5⟩, Snak.value P31 (Value.item ⟨6581072⟩), [Snak.value P1013 (Value.item ⟨1⟩)], [], Rank.normal⟩,
          ⟨⟨5⟩, Snak.value P31 (Value.item ⟨6581072⟩), [Snak.value P1013 (Value.item ⟨2⟩)], [], Rank.normal⟩,
          ?_, ?_, rfl⟩ <;> decide

/-- **A `novalue` snak is invisible to the core layer.**  Recording that an item has
*no* value for a property is a positive claim, and the projection drops it: the
core layer cannot distinguish it from the property never having been recorded. -/
theorem noValue_is_invisible_to_core (fkb : FullKB) (s : Qid) (p : Pid) :
    ({ fkb with statements := ⟨s, Snak.noValue p, [], [], Rank.normal⟩ :: fkb.statements } :
      FullKB).core = fkb.core := by
  simp [FullKB.core, FullStatement.toStatement?]

/-- **A `somevalue` snak names no item.**  It asserts existence without a witness,
so it can never license an item-valued fact. -/
theorem someValue_names_no_item (s : Qid) (p : Pid) (qs : List Snak) (rs : List Reference)
    (r : Rank) :
    (Snak.someValue p).itemValue? = none ∧
      FullStatement.toStatement? ⟨s, Snak.someValue p, qs, rs, r⟩ = none :=
  ⟨rfl, rfl⟩

/-- Literal-valued statements are inert for the class engines: they never reach the
core layer at all. -/
theorem literal_statement_is_inert (fkb : FullKB) (s : Qid) (p : Pid) (q : Quantity) :
    ({ fkb with statements := ⟨s, Snak.value p (Value.quantity q), [], [], Rank.normal⟩ ::
        fkb.statements } : FullKB).core = fkb.core := by
  simp [FullKB.core, FullStatement.toStatement?]

/-! ## Temporal qualifiers

`P580` (start time), `P582` (end time) and `P585` (point in time) are the
qualifiers that place a claim in time.  They cut out a *slice* of the knowledge
base: the statements in force at a given instant.
-/

/-- `P580`, "start time". -/
def P580 : Pid := ⟨580⟩
/-- `P582`, "end time". -/
def P582 : Pid := ⟨582⟩
/-- `P585`, "point in time". -/
def P585 : Pid := ⟨585⟩

namespace FullStatement

/-- The time values carried by qualifiers with the given property. -/
def timeQualifiers (fs : FullStatement) (p : Pid) : List TimeValue :=
  fs.qualifiers.filterMap fun s =>
    match s with
    | Snak.value q (Value.time t) => if q = p then some t else none
    | _ => none

/-- Is the statement in force at the given instant, as far as its temporal
qualifiers say?  A statement with no temporal qualifiers is in force always. -/
def validAt (fs : FullStatement) (u : TimeValue) : Bool :=
  (fs.timeQualifiers P580).all (fun s => decide (s.stamp ≤ u.stamp)) &&
    (fs.timeQualifiers P582).all (fun e => decide (u.stamp ≤ e.stamp))

theorem validAt_iff (fs : FullStatement) (u : TimeValue) :
    fs.validAt u = true ↔
      (∀ s ∈ fs.timeQualifiers P580, s.stamp ≤ u.stamp) ∧
        (∀ e ∈ fs.timeQualifiers P582, u.stamp ≤ e.stamp) := by
  simp [validAt, List.all_eq_true]

/-- A statement with no temporal qualifiers is in force at every instant. -/
theorem validAt_of_no_temporal_qualifiers {fs : FullStatement}
    (hs : fs.timeQualifiers P580 = []) (he : fs.timeQualifiers P582 = []) (u : TimeValue) :
    fs.validAt u = true := by
  rw [validAt_iff, hs, he]
  exact ⟨by simp, by simp⟩

end FullStatement

namespace FullKB

/-- The statements of the knowledge base that are in force at an instant. -/
def temporalSlice (fkb : FullKB) (u : TimeValue) : FullKB :=
  { fkb with statements := fkb.statements.filter (fun fs => fs.validAt u) }

@[simp] theorem temporalSlice_entities (fkb : FullKB) (u : TimeValue) :
    (fkb.temporalSlice u).entities = fkb.entities := rfl

theorem temporalSlice_subset (fkb : FullKB) (u : TimeValue) :
    (fkb.temporalSlice u).statements ⊆ fkb.statements := fun _ h => List.mem_of_mem_filter h

theorem core_temporalSlice_subset (fkb : FullKB) (u : TimeValue) :
    (fkb.temporalSlice u).core.statements ⊆ fkb.core.statements :=
  core_statements_subset (temporalSlice_subset fkb u)

/-- A subclass fact in force at an instant is a subclass fact of the whole base. -/
theorem subclassOf_of_temporalSlice (fkb : FullKB) (u : TimeValue)
    (hnormal : AllNormal fkb.core) {a b : Qid}
    (h : SubclassOf (fkb.temporalSlice u).core a b) : SubclassOf fkb.core a b :=
  subclassOf_mono (core_temporalSlice_subset fkb u) hnormal h

/-- An instance fact in force at an instant is an instance fact of the whole base. -/
theorem instanceOf_of_temporalSlice (fkb : FullKB) (u : TimeValue)
    (hnormal : AllNormal fkb.core) {x c : Qid}
    (h : InstanceOf (fkb.temporalSlice u).core x c) : InstanceOf fkb.core x c :=
  instanceOf_mono (core_temporalSlice_subset fkb u) hnormal h

end FullKB

/-! ### The core layer erases expiry

Ceres (`Q596`) was recorded as an instance of *planet* (`Q634`) until 1801.  The
claim is qualified with an end time; the core layer keeps the claim and drops the
qualifier.
-/

/-- Ceres, `Q596`. -/
def ceres : Qid := ⟨596⟩
/-- Planet, `Q634`. -/
def planet : Qid := ⟨634⟩

/-- 1801, at year precision. -/
def y1801 : TimeValue := ⟨1801, 0, 0, TimePrecision.year, gregorian⟩
/-- 2020, at year precision. -/
def y2020 : TimeValue := ⟨2020, 0, 0, TimePrecision.year, gregorian⟩

/-- A knowledge base with one expired claim. -/
def expiredKB : FullKB :=
  ⟨[ceres, planet],
   [⟨ceres, Snak.value P31 (Value.item planet),
      [Snak.value P582 (Value.time y1801)], [], Rank.normal⟩]⟩

/-- **The core layer erases expiry.**  The claim is not in force in 2020 — the
temporal slice is empty — yet the core layer still derives it. -/
theorem core_erases_expiry :
    (expiredKB.temporalSlice y2020).statements = [] ∧
      ¬ InstanceOf (expiredKB.temporalSlice y2020).core ceres planet ∧
      InstanceOf expiredKB.core ceres planet := by
  refine ⟨by decide, ?_, ?_⟩
  · intro h
    exact absurd ((isInstanceOf_iff _ ceres planet).2 h) (by decide)
  · exact (isInstanceOf_iff _ ceres planet).1 (by decide)

/-- The claim *is* in force at a time before its end. -/
theorem expired_claim_holds_before_expiry :
    InstanceOf (expiredKB.temporalSlice ⟨1800, 0, 0, TimePrecision.year, gregorian⟩).core
      ceres planet :=
  (isInstanceOf_iff _ ceres planet).1 (by decide)

/-! ## References

A reference is an object attached to a statement.  The core-level provenance
shadow of `Wikidata.Provenanced` is recovered from it — but only up to the
projection, which is where it loses information.
-/

namespace FullKB

/-- Does the statement carry a reference? -/
def hasReference (fs : FullStatement) : Bool := !fs.references.isEmpty

/-- The statements of the base that carry a reference. -/
def referencedSlice (fkb : FullKB) : FullKB :=
  { fkb with statements := fkb.statements.filter hasReference }

theorem referencedSlice_subset (fkb : FullKB) :
    fkb.referencedSlice.statements ⊆ fkb.statements := fun _ h => List.mem_of_mem_filter h

/-- The core-level provenance shadow: the sources of *every* full statement that
projects to the given core statement. -/
def shadowRefs (fkb : FullKB) (st : Statement) : List String :=
  (fkb.statements.filter (fun fs => fs.toStatement? = some st)).flatMap
    (fun fs => fs.references.map Reference.source)

/-- The `Wikidata.Provenanced` structure induced by the references. -/
def shadow (fkb : FullKB) (reliable : String → Bool) : Provenanced :=
  ⟨fkb.core, fkb.shadowRefs, reliable⟩

/-- The projection of a referenced statement is sourced in the shadow. -/
theorem sourced_of_referenced (fkb : FullKB) (reliable : String → Bool) {fs : FullStatement}
    (hfs : fs ∈ fkb.statements) (href : hasReference fs = true) {st : Statement}
    (hst : fs.toStatement? = some st) :
    (fkb.shadow reliable).keep Slice.sourced st = true := by
  simp only [shadow, Provenanced.keep, shadowRefs, Bool.not_eq_true',
    List.isEmpty_eq_false_iff, ne_eq]
  intro hnil
  have hmem : fs ∈ fkb.statements.filter (fun gs => gs.toStatement? = some st) :=
    List.mem_filter.2 ⟨hfs, by simp [hst]⟩
  have : fs.references.map Reference.source = [] := by
    have hsub : fs.references.map Reference.source ⊆
        (fkb.statements.filter (fun gs => gs.toStatement? = some st)).flatMap
          (fun gs => gs.references.map Reference.source) := by
      intro x hx
      exact List.mem_flatMap.2 ⟨fs, hmem, hx⟩
    rw [hnil] at hsub
    exact List.eq_nil_iff_forall_not_mem.2 (fun x hx => by simpa using hsub hx)
  rw [List.map_eq_nil_iff] at this
  simp [hasReference, this] at href

end FullKB

/-! ### The shadow credits the wrong statement

Because two full statements can project to the same core statement, the core-level
provenance shadow cannot say *which* of them is referenced.
-/

/-- A base with two claims that project to the same core statement: one sourced,
one not. -/
def twinKB : FullKB :=
  ⟨[⟨1⟩, ⟨2⟩],
   [⟨⟨1⟩, Snak.value P31 (Value.item ⟨2⟩), [Snak.value P1013 (Value.item ⟨10⟩)],
      [⟨"catalogue", []⟩], Rank.normal⟩,
    ⟨⟨1⟩, Snak.value P31 (Value.item ⟨2⟩), [Snak.value P1013 (Value.item ⟨11⟩)],
      [], Rank.normal⟩]⟩

/-- **The core provenance shadow credits an unreferenced statement.**  The second
claim carries no reference, but its projection is judged sourced, because the
first claim projects to the same core statement. -/
theorem projection_conflates_referenced_and_unreferenced :
    ∃ fs ∈ twinKB.statements,
      FullKB.hasReference fs = false ∧
        ∃ st, fs.toStatement? = some st ∧
          (twinKB.shadow (fun _ => true)).keep Slice.sourced st = true := by
  refine ⟨twinKB.statements[1]!, by decide, by decide,
    ⟨⟨1⟩, P31, ⟨2⟩, Rank.normal⟩, by decide, by decide⟩

/-- **Being referenced is not being true, nor even being queryable.**  A deprecated
claim can be perfectly well sourced, and it is still dropped by the truthy
projection. -/
theorem reference_is_not_truth :
    ∃ fkb : FullKB, ∃ fs ∈ fkb.statements, ∃ st,
      FullKB.hasReference fs = true ∧ fs.toStatement? = some st ∧
        IsTruthy fkb.core st = false := by
  refine ⟨⟨[⟨1⟩, ⟨2⟩],
    [⟨⟨1⟩, Snak.value P31 (Value.item ⟨2⟩), [], [⟨"catalogue", []⟩], Rank.deprecated⟩]⟩,
    ⟨⟨1⟩, Snak.value P31 (Value.item ⟨2⟩), [], [⟨"catalogue", []⟩], Rank.deprecated⟩,
    by decide, ⟨⟨1⟩, P31, ⟨2⟩, Rank.deprecated⟩, by decide, by decide, by decide⟩

end Wikidata
