         ℤ.pos ((suc m) ℕ.· (suc n))
           ≡⟨ refl ⟩
         ℕ₊₁→ℤ ((1+ m) ·₊₁ (1+ n))
           ≡⟨ sym (ℤ.·IdL _) ⟩
