    invariantDepth : Nat
    structuralOrder : ScanOrder
    emittedAdmissibility : Bool
    recoveredWidth : Nat
    thermoChecksum : Nat
    hamiltonianChecksum : Nat

brainChemistryCodecConsumerProfile :
  ∀ {n} → BrainState n → BrainChemistryCodecConsumerProfile
