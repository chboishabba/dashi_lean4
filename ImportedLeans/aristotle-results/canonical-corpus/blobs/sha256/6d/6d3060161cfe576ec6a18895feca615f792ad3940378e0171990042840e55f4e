    maxNat≤⊔ (suc a) zero = ≤-refl
    maxNat≤⊔ (suc a) (suc b) = s≤s (maxNat≤⊔ a b)

    ⊔≤+ :
      ∀ a b →
      a ⊔ b ≤ a + b
    ⊔≤+ a b =
