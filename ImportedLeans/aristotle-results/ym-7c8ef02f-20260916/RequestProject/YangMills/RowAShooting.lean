/-
# Row A-ii — beta-history sensitivity and the tuned bare coupling

The Row-A completion contract asks for more than a positive shell coefficient:
it asks for a **tuned bare coupling**, i.e. a bare inverse coupling `u₀` whose
generated trajectory

    u_{j+1} = u_j + β_j(u₀),        j < K,

reaches a *prescribed* value `u_K = u⋆` at the physical observation scale, while
every intermediate effective coupling stays inside the small-field window.

The bridge the repository already carries is "strict cumulative-beta sensitivity
`q < 1` ⇒ shooting-map contraction".  This file supplies both halves in the form
in which they are actually available on the trajectory built by the Row-A files:

* `cumulative_sensitivity_le` / `cumulative_sensitivity_lt_one` — if the
  sensitivity of the individual shell coefficients to the bare coupling is
  quartically suppressed, `|∂_{u₀}β_j| ≤ C_s·g_j⁴` (in Lipschitz form), then the
  *whole* cumulative sensitivity is bounded, uniformly in the cutoff `K`, by
  `C_s·κ/(b₋u₀)` with `κ = (u₀+b₊)/u₀`; in particular it is `< 1` for a bare
  coupling that is small enough.  The proof is the telescoping quartic-debt
  estimate of `RowATerminalTube`, so no new RG input is used.
* `shooting_exists_unique` — a cumulative sensitivity `q < 1` makes the shooting
  map `T(v) = u⋆ − Σ_{j<K} β_j(v)` a contraction of `ℝ`, hence there is exactly
  one bare coupling hitting the prescribed observation-scale value.
* `tuned_bare_coupling_window` — the trajectory generated by that tuned bare
  coupling reaches `u_K = u⋆` exactly, and every effective coupling on the way
  obeys `0 < g_j² ≤ (u⋆ − b₊K)⁻¹`, i.e. it stays in a prescribed small-field
  window, with a nonzero prescribed coupling `g_K² = 1/u⋆` at the observation
  scale.

**Honest status.**  What is *proved* here is the sensitivity-to-tuning
implication and the tuning itself.  The physical input that is *not* proved here
is the per-shell Lipschitz constant `|β_j(v) − β_j(w)| ≤ C_s·g_j⁴·|v − w|` of the
Bałaban shell coefficient in the bare coupling; it is carried as a hypothesis.
In Bałaban's own program the corresponding statement is CMP 109 Theorem 2, whose
proof is explicitly deferred there to a separate paper.
-/
import RequestProject.YangMills.RowATerminalTube

namespace YangMills

/-! ## 1. Cumulative sensitivity of the beta history -/

variable {u beta : ℕ → ℝ} {bm bp : ℝ}

/-- **The cumulative sensitivity is bounded uniformly in the cutoff.**  If each
shell sensitivity is quartically suppressed, `L_j ≤ C_s·g_j⁴`, then
`Σ_{j<K} L_j ≤ C_s·κ·b₋⁻¹·g₀²` for every `K`, with `κ = (u₀+b₊)/u₀`. -/
theorem cumulative_sensitivity_le {L : ℕ → ℝ} {Cs : ℝ}
    (hstep : ∀ j, u (j + 1) = u j + beta j)
    (hb : ∀ j, bm ≤ beta j) (hbu : ∀ j, beta j ≤ bp) (hbm : 0 < bm) (hu0 : 0 < u 0)
    (hCs : 0 ≤ Cs) (hL : ∀ j, L j ≤ Cs * couplingSq u j ^ 2) (K : ℕ) :
    ∑ j ∈ Finset.range K, L j ≤ Cs * (((u 0 + bp) / u 0) * bm⁻¹ * couplingSq u 0) := by
  have hrange : Finset.range K = Finset.Ico 0 K := congrFun Finset.range_eq_Ico K
  have h1 : ∑ j ∈ Finset.Ico 0 K, L j ≤ ∑ j ∈ Finset.Ico 0 K, Cs * couplingSq u j ^ 2 :=
    Finset.sum_le_sum fun j _ => hL j
  have h2 : ∑ j ∈ Finset.Ico 0 K, Cs * couplingSq u j ^ 2
      = Cs * ∑ j ∈ Finset.Ico 0 K, couplingSq u j ^ 2 := by rw [Finset.mul_sum]
  have h3 : ∑ j ∈ Finset.Ico 0 K, couplingSq u j ^ 2
      ≤ ((u 0 + bp) / u 0) * bm⁻¹ * couplingSq u 0 :=
    debt_block_telescope hstep hb hbu hbm hu0 0 K
  have h4 : Cs * ∑ j ∈ Finset.Ico 0 K, couplingSq u j ^ 2
      ≤ Cs * (((u 0 + bp) / u 0) * bm⁻¹ * couplingSq u 0) :=
    mul_le_mul_of_nonneg_left h3 hCs
  rw [hrange]
  linarith [h1, h2.le, h2.ge, h4]

/-- **A small bare coupling makes the cumulative sensitivity a contraction
factor.**  Explicitly, `q := C_s·κ·b₋⁻¹·u₀⁻¹ < 1` suffices, and this holds for
`u₀` large, i.e. for a small bare coupling. -/
theorem cumulative_sensitivity_lt_one {L : ℕ → ℝ} {Cs : ℝ}
    (hstep : ∀ j, u (j + 1) = u j + beta j)
    (hb : ∀ j, bm ≤ beta j) (hbu : ∀ j, beta j ≤ bp) (hbm : 0 < bm) (hu0 : 0 < u 0)
    (hCs : 0 ≤ Cs) (hL : ∀ j, L j ≤ Cs * couplingSq u j ^ 2)
    (hsmall : Cs * (((u 0 + bp) / u 0) * bm⁻¹ * (u 0)⁻¹) < 1) (K : ℕ) :
    ∑ j ∈ Finset.range K, L j < 1 := by
  have h := cumulative_sensitivity_le hstep hb hbu hbm hu0 hCs hL K
  have : couplingSq u 0 = (u 0)⁻¹ := rfl
  rw [this] at h
  linarith

/-! ## 2. The shooting map is a contraction -/

/-- The prefix of the beta history is Lipschitz in the bare coupling with
constant `Σ_{j<K} L_j`. -/
theorem prefix_sum_lipschitz {bet : ℕ → ℝ → ℝ} {L : ℕ → ℝ} {K : ℕ}
    (hL : ∀ j v w, |bet j v - bet j w| ≤ L j * |v - w|) (v w : ℝ) :
    |∑ j ∈ Finset.range K, bet j v - ∑ j ∈ Finset.range K, bet j w|
      ≤ (∑ j ∈ Finset.range K, L j) * |v - w| := by
  have hsub : ∑ j ∈ Finset.range K, bet j v - ∑ j ∈ Finset.range K, bet j w
      = ∑ j ∈ Finset.range K, (bet j v - bet j w) := by
    rw [Finset.sum_sub_distrib]
  rw [hsub]
  calc |∑ j ∈ Finset.range K, (bet j v - bet j w)|
      ≤ ∑ j ∈ Finset.range K, |bet j v - bet j w| := Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ j ∈ Finset.range K, L j * |v - w| := Finset.sum_le_sum fun j _ => hL j v w
    _ = (∑ j ∈ Finset.range K, L j) * |v - w| := by rw [← Finset.sum_mul]

/-- **Shooting: existence and uniqueness of the tuned bare coupling.**  A
cumulative sensitivity `q < 1` makes `T(v) = u⋆ − Σ_{j<K} β_j(v)` a contraction
of the (complete) real line, so there is exactly one bare inverse coupling whose
beta history lands on the prescribed observation-scale value `u⋆`. -/
theorem shooting_exists_unique {bet : ℕ → ℝ → ℝ} {L : ℕ → ℝ} {q target : ℝ} {K : ℕ}
    (hL : ∀ j v w, |bet j v - bet j w| ≤ L j * |v - w|)
    (hq : ∑ j ∈ Finset.range K, L j ≤ q) (hq0 : 0 ≤ q) (hq1 : q < 1) :
    ∃! v : ℝ, v + ∑ j ∈ Finset.range K, bet j v = target := by
  set T : ℝ → ℝ := fun v => target - ∑ j ∈ Finset.range K, bet j v with hT
  have hlip : LipschitzWith (Real.toNNReal q) T := by
    refine LipschitzWith.of_dist_le_mul fun v w => ?_
    have h1 : dist (T v) (T w)
        = |∑ j ∈ Finset.range K, bet j v - ∑ j ∈ Finset.range K, bet j w| := by
      rw [Real.dist_eq, hT]
      simp only
      rw [abs_sub_comm]
      ring_nf
    have h2 := prefix_sum_lipschitz (bet := bet) (L := L) (K := K) hL v w
    have h3 : (∑ j ∈ Finset.range K, L j) * |v - w| ≤ q * |v - w| :=
      mul_le_mul_of_nonneg_right hq (abs_nonneg _)
    have h4 : (Real.toNNReal q : ℝ) = q := Real.coe_toNNReal q hq0
    rw [h1, h4, Real.dist_eq]
    linarith
  have hcontr : ContractingWith (Real.toNNReal q) T := by
    constructor
    · rw [← NNReal.coe_lt_coe, Real.coe_toNNReal q hq0]
      simpa using hq1
    · exact hlip
  refine ⟨hcontr.fixedPoint T, ?_, ?_⟩
  · have hfix : T (hcontr.fixedPoint T) = hcontr.fixedPoint T := hcontr.fixedPoint_isFixedPt
    have h2 : target - ∑ j ∈ Finset.range K, bet j (hcontr.fixedPoint T)
        = hcontr.fixedPoint T := hfix
    show hcontr.fixedPoint T + ∑ j ∈ Finset.range K, bet j (hcontr.fixedPoint T) = target
    linarith
  · intro y hy
    have hTy : T y = y := by
      show target - ∑ j ∈ Finset.range K, bet j y = y
      linarith [hy]
    exact hcontr.fixedPoint_unique hTy

/-! ## 3. The tuned trajectory and its physical window -/

/-- The trajectory generated by a bare coupling `v` and the beta history
`β_j(v)`. -/
noncomputable def shootingTrajectory (bet : ℕ → ℝ → ℝ) (v : ℝ) (j : ℕ) : ℝ :=
  v + ∑ i ∈ Finset.range j, bet i v

@[simp] theorem shootingTrajectory_zero (bet : ℕ → ℝ → ℝ) (v : ℝ) :
    shootingTrajectory bet v 0 = v := by simp [shootingTrajectory]

theorem shootingTrajectory_step (bet : ℕ → ℝ → ℝ) (v : ℝ) (j : ℕ) :
    shootingTrajectory bet v (j + 1) = shootingTrajectory bet v j + bet j v := by
  simp [shootingTrajectory, Finset.sum_range_succ]
  ring

/-- **The tuned bare coupling and its physical observation window.**  With a
cumulative sensitivity `q < 1` and per-shell bounds `b₋ ≤ β_j(v) ≤ b₊`, there is
a bare inverse coupling whose trajectory

* hits the prescribed observation-scale value exactly, `u_K = u⋆`, so the
  physical coupling there is the prescribed nonzero `g_K² = 1/u⋆`;
* stays inside the small-field window at every intermediate scale,
  `0 < g_j² ≤ (u⋆ − b₊K)⁻¹` for `j ≤ K`,

provided the prescribed observation-scale coupling is small enough that
`u⋆ − b₊K > 0`. -/
theorem tuned_bare_coupling_window {bet : ℕ → ℝ → ℝ} {L : ℕ → ℝ}
    {q target bZm bZp : ℝ} {K : ℕ}
    (hL : ∀ j v w, |bet j v - bet j w| ≤ L j * |v - w|)
    (hq : ∑ j ∈ Finset.range K, L j ≤ q) (hq0 : 0 ≤ q) (hq1 : q < 1)
    (hZl : ∀ j v, bZm ≤ bet j v) (hZu : ∀ j v, bet j v ≤ bZp) (hbZm : 0 ≤ bZm)
    (hwin : 0 < target - bZp * K) :
    ∃ v : ℝ, (shootingTrajectory bet v K = target)
      ∧ (∀ j ≤ K, target - bZp * K ≤ shootingTrajectory bet v j)
      ∧ (∀ j ≤ K, 0 < couplingSq (shootingTrajectory bet v) j
            ∧ couplingSq (shootingTrajectory bet v) j ≤ (target - bZp * K)⁻¹)
      ∧ couplingSq (shootingTrajectory bet v) K = target⁻¹ := by
  obtain ⟨v, hv, -⟩ := shooting_exists_unique (bet := bet) (L := L) (q := q)
    (target := target) (K := K) hL hq hq0 hq1
  have hK : shootingTrajectory bet v K = target := by
    simp [shootingTrajectory]; linarith [hv]
  -- the bare coupling is bounded below by `u⋆ − b₊K`
  have hsumu : ∑ j ∈ Finset.range K, bet j v ≤ bZp * K := by
    calc ∑ j ∈ Finset.range K, bet j v ≤ ∑ _j ∈ Finset.range K, bZp :=
          Finset.sum_le_sum fun j _ => hZu j v
      _ = bZp * K := by rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul]; ring
  have hv0 : target - bZp * K ≤ v := by linarith [hv, hsumu]
  have hmono : ∀ j, v ≤ shootingTrajectory bet v j := by
    intro j
    have : 0 ≤ ∑ i ∈ Finset.range j, bet i v := by
      refine Finset.sum_nonneg fun i _ => le_trans hbZm (hZl i v)
    simp [shootingTrajectory]; linarith
  have hlow : ∀ j, target - bZp * K ≤ shootingTrajectory bet v j := fun j =>
    le_trans hv0 (hmono j)
  refine ⟨v, hK, fun j _ => hlow j, fun j _ => ?_, ?_⟩
  · have hpos : 0 < shootingTrajectory bet v j := lt_of_lt_of_le hwin (hlow j)
    refine ⟨by simpa [couplingSq] using hpos, ?_⟩
    simpa [couplingSq] using inv_anti₀ hwin (hlow j)
  · rw [couplingSq, hK]

end YangMills
