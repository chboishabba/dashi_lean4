  ΣPathP (funExt
          (⋀-fun≡'.main _ _
            (λ xy → mainᵣ (fst xy) (snd xy))
            (λ x → sym (rUnit refl) ◁ mainᵣ-pt-coh x)
            (⋀→∙Homogeneous≡ (isHomogeneousPath _ _) mainᵣ-coh))
