    ; mask = mask
    ; coreQσ = λ x → IMQ.Qσ mask (TCP.coarseOf m k x)
    ; coreB2σ = λ x y → IMQ.B2σ mask (TCP.coarseOf m k x) (TCP.coarseOf m k y)
