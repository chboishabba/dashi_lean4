      ∀ {i j} {A : U i} {B : U j}
      → (A → B) → ∥ A ∥ → ∥ B ∥
    ∥→ f ∥→ = ∥-∥-recursion _ (∥-∥-is-truncation _) (λ a → ∣ (f a) ∣)

