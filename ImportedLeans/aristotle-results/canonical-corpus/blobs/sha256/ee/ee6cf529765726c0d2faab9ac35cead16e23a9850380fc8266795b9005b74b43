learningThemeSemantic theme =
  Semantic.semanticOfState (BrainLearningThemeAt.carrier theme)

morphospaceThemeSemantic :
  ∀ {n t} → BrainMorphospaceThemeAt n t → Semantic.BrainInvariantSemantic
