singleLanePowerDivides :
  ∀ p x y →
  pow (toNat p) (deltaAt p x y) ∣ (x + y)
singleLanePowerDivides = deltaPowerDividesSum

singleLanePowerBound :
  ∀ p x y →
  .{{_ : NonZero (x + y)}} →
