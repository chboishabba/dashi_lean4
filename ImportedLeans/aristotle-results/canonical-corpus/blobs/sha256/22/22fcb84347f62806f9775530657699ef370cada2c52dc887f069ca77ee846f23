    (shiftCoarseStep-commute x)

shiftMotifSchedule :
  ∀ x →
  shiftRGAdmissible x →
  RGOI.RGObservable.motifClass
    (RGOI.RGObservableSurface.observe shiftRGSurface
      (shiftCoarse (EC.Contract.step ShiftC x)))
    ≡
  RGOI.RGObservable.motifClass
    (RGOI.RGObservableSurface.observe shiftRGSurface
      (EC.Contract.step ShiftC (shiftCoarse x)))
shiftMotifSchedule x _ =
