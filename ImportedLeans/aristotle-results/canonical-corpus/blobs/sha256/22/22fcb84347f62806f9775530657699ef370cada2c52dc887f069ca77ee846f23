canonicalKnownLimitsQFTBridgeTheorem =
  let
    u = CCS.physicsUnification
    cq = UC.PhysicsUnification.cq u
    q2cl = UC.PhysicsUnification.q2cl u
    wl = UC.PhysicsUnification.wl u
