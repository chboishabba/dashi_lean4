-- Morphism on ℤ[x]

  ϕ₀-pres1 : (m : ℕ) → inv (fst (H⁰-Sⁿ≅ℤ m)) 1 ≡ 1⌣
  ϕ₀-pres1 zero = refl
  ϕ₀-pres1 (suc m) = refl

  -- doesn't compute without an abstract value !
  ℤ[x]→H*-Sⁿ-pres1 : ℤ[x]→H*-Sⁿ (1Pℤ) ≡ 1H*
