              Integration.ReachabilityBarrier.coarseLanguage) x y →
          Integration.ReachabilityBarrier.Reachable
            (Integration.ReachabilityBarrier.counter
              Integration.ReachabilityBarrier.fullLanguage) x y)
        (fun h _ _ hr =>
          Integration.ReachabilityBarrier.reachable_of_weaker_precondition h
            (fun _ _ _ hp => hp) hr)
      prov := about "Lean/Integration/ReachabilityBarrier.lean"
        ["Integration.ReachabilityBarrier.unreachability_never_survives_extension"]
        "The hypothesis is the language inclusion, which each lane must supply \
         for its own two systems; here it is discharged by \
         `coarse_subset_full`, which is why the general form is filed as the \
         bridge and the instance as row 55." }
  , -- 57. A reversal between marginals is a proof of interaction
    { owner := "Integration.CoordinateSufficiency (Separable)"
      consumer := "marginal readings of two-coordinate consumers across the corpus"
      relation := .negativeResult
        (Integration.CoordinateSufficiency.Separable Integration.Marginalisation.parityQ)
        Integration.Marginalisation.parityQ_not_separable
      prov := about "Lean/Integration/Marginalisation.lean"
        ["Integration.Marginalisation.separable_contrast_weight_invariant",
         "Integration.Marginalisation.reversal_implies_interaction"]
        "For a separable consumer the coordinate contrast is the same under \
         every convex weighting of the other coordinate; a reversal therefore \
         refutes separability.  The carriers are `Bool` and `ℚ`, and no \
         probability space, sample or estimator appears." }
  , -- 58. Per-stratum dominance does not survive pooling
    { owner := "Integration.Marginalisation"
      consumer := "pooled comparisons downstream of a stratified aggregate"
      relation := .negativeResult
        (Integration.Marginalisation.rateB Integration.Marginalisation.stratum₁
            < Integration.Marginalisation.rateA Integration.Marginalisation.stratum₁ →
          Integration.Marginalisation.rateB Integration.Marginalisation.stratum₂
            < Integration.Marginalisation.rateA Integration.Marginalisation.stratum₂ →
          Integration.Marginalisation.pooledB
              Integration.Marginalisation.stratum₁ Integration.Marginalisation.stratum₂
            ≤ Integration.Marginalisation.pooledA
              Integration.Marginalisation.stratum₁ Integration.Marginalisation.stratum₂)
        (fun h => absurd
          (h Integration.Marginalisation.pooled_reversal.1
            Integration.Marginalisation.pooled_reversal.2.1)
          (not_le.mpr Integration.Marginalisation.pooled_reversal.2.2))
      prov := about "Lean/Integration/Marginalisation.lean"
        ["Integration.Marginalisation.pooling_weights_differ",
         "Integration.Marginalisation.common_weights_no_reversal"]
        "The mechanism is proved as well: the two pooled numbers average the \
         same stratum rates against different weightings, and with a common \
         weighting no reversal is possible.  The counts are explicit integers \
         and are not data about anything." }
  , -- 59. Completeness is relative to the declared carrier
    { owner := "Integration.DeclaredCarrier"
      consumer := "the corpus atlases' coverage disclaimers"
      relation := .negativeResult
        (Integration.DeclaredCarrier.ExhaustiveOn
          Integration.DeclaredCarrier.sample (fun _ : ℕ => True))
        Integration.DeclaredCarrier.sample_not_exhaustive_ambient
      prov := about "Lean/Integration/DeclaredCarrier.lean"
        ["Agda/DASHI/Culture/Cuisine/CuisineKnowledgeSourceAtlas.agda",
         "Agda/DASHI/Governance/RevolutionarySourceAtlas.agda",
         "Integration.DeclaredCarrier.universal_of_exhaustive"]
        "The two atlases disclaim exhaustive coverage in prose; this row is the \
         theorem behind the disclaimer, on a two-element enumeration of `ℕ`.  \
         No statement is made about either atlas's contents." }
  , -- 60. An observer sufficient on the declared carrier need not be sufficient globally
    { owner := "Integration.DeclaredCarrier (DeterminesOn)"
      consumer := "model-internal completeness claims"
      relation := .negativeResult
        (Integration.CoordinateSufficiency.Determines
          (fun n : ℕ => n % 2) (fun n : ℕ => n))
        Integration.DeclaredCarrier.determinesOn_not_determines.2
      prov := about "Lean/Integration/DeclaredCarrier.lean"
        ["Integration.DeclaredCarrier.determinesOn_of_determines"]
        "The positive half is proved alongside it: parity *is* sufficient on \
         the declared two-element carrier.  So internal completeness and \
         global completeness are different properties, and only the first is \
         established by an internal argument." }
  , -- 61. Reconstruction adequacy is consumer-indexed, not absolute
    { owner := "Integration.RealisationAdequacy (AdequateFor)"
      consumer := "DASHI.Core.IntersectionalNonFactorability (flattening as a realisation)"
      relation := .negativeResult
        (Integration.RealisationAdequacy.AdequateFor
          Integration.LevelIIWelds.flatteningPipeline
          Integration.LevelIIWelds.relationalConsumer)
        Integration.LevelIIWelds.weld_reconstruction_instance.2
      prov := about "Lean/Integration/LevelIIWelds.lean"
        ["Integration.ContextIndexedRole.flat_reweighting_cannot_repair",
         "Integration.RealisationAdequacy.adequateFor_not_transfers"]
        "The positive half is proved alongside it: the same flattening is \
         adequate for the consumer that asks only for the label.  So the row \
         refutes adequacy *for one consumer*, and asserts nothing about the \
         reconstruction as such." }
  , -- 62. Mediator adequacy: the bridge a provisioning lane would discharge
    { owner := "Integration.RealisationAdequacy (RealisationAdequate)"
      consumer := "mediation/provisioning surfaces named in the handoff"
      relation := .candidateBridge
        (∃ (P : Integration.RealisationAdequacy.Pipeline ℕ ℕ ℕ)
            (c : Integration.RealisationAdequacy.ConsumerSpec ℕ ℕ),
          Nonempty (Integration.FactorisationCollision.Collision P.state c.demand))
        (∃ (P : Integration.RealisationAdequacy.Pipeline ℕ ℕ ℕ)
            (c : Integration.RealisationAdequacy.ConsumerSpec ℕ ℕ),
          ¬ Integration.RealisationAdequacy.RealisationAdequate P c)
        (fun h => by
          obtain ⟨P, c, ⟨w⟩⟩ := h
          exact ⟨P, c, w.not_determines⟩)
      prov := about "Lean/Integration/LevelIIWelds.lean"
        ["Integration.LevelIIWelds.weld_mediator_bridge",
         "Integration.LevelIIWelds.weld_mediator_instance"]
        "No provisioning surface exists in this tree, so the hypothesis is not \
         discharged from the corpus: the row is a bridge.  An in-tree instance \
         of the same shape (a compiled decision as mediator) is proved \
         separately and is what row 66 cites." }
  , -- 63. Threshold and trajectory comparisons: the interaction bridge
    { owner := "Integration.SeparabilityContrast (contrast reversal)"
      consumer := "threshold-distance and trajectory surfaces named in the handoff"
      relation := .candidateBridge
        (∃ C : Bool → Bool → ℚ,
          0 < Integration.SeparabilityContrast.contrast C
              Integration.SeparabilityContrast.atTrue true false ∧
            Integration.SeparabilityContrast.contrast C
              Integration.SeparabilityContrast.atFalse true false < 0)
        (∃ C : Bool → Bool → ℚ, ¬ Integration.CoordinateSufficiency.Separable C)
        (fun h => by
          obtain ⟨C, hpos, hneg⟩ := h
          exact ⟨C, Integration.LevelIIWelds.weld_threshold_bridge hpos hneg⟩)
      prov := about "Lean/Integration/SeparabilityContrast.lean"
        ["Integration.SeparabilityContrast.separable_contrast_invariant",
         "Integration.SeparabilityContrast.thresholdInstance",
         "Integration.Marginalisation.reversal_implies_interaction"]
        "The hypothesis is the lane's datum: two weightings of the second \
         coordinate under which the first-coordinate contrast changes sign.  \
         Two in-tree witnesses of that shape are proved (a trajectory pair and \
         an indicator product); no corpus surface supplies one." }
  , -- 64. The hidden coordinate is essential: coordinate deletion, owned once
    { owner := "Integration.FactorisationCollision (Collision.ofEssential)"
      consumer := "DASHI early-learning / counterfactual exposure records"
      relation := .negativeResult
        (Integration.CoordinateSufficiency.Determines
          (Integration.FactorisationCollision.deleteCoord
            (A := fun _ : Fin 2 => Bool) 1)
          Integration.LevelIIWelds.effectOfCoords)
        Integration.LevelIIWelds.weld_hidden_deletion
      prov := about "Lean/Integration/LevelIIWelds.lean"
        ["Integration.CounterfactualEffect.counterfactual_determines_effect",
         "Integration.FactorisationCollision.nonempty_collision_of_essential"]
        "The re-coordinatisation of the corpus record onto a two-coordinate \
         Boolean product is proved surjective, so the encoding drops nothing; \
         the intervention-label carrier has one element.  The positive half — \
         the hidden coordinate alone determines the effect — is the corpus \
         module's, and is cited, not re-proved." }
  , -- 65. Scalarisation: the total does not determine the objective vector
    { owner := "Integration.FactorisationCollision (scalarisation family)"
      consumer := "DASHI Pareto planning surfaces"
      relation := .negativeResult
        (Integration.CoordinateSufficiency.Determines Integration.ParetoOutcome.total
          (fun a : Integration.ParetoOutcome.Outcome 2 => a 0))
        Integration.LevelIIWelds.weld_pareto_scalarisation.1
      prov := about "Lean/Integration/LevelIIWelds.lean"
        ["Integration.FactorisationCollision.scalarCollision",
         "Integration.LevelIIWelds.weld_scalar_descent_is_not_dominance"]
        "The owner proves the collision for *every* weight vector, so no choice \
         of weights repairs it; the row's witness is the corpus's unweighted \
         total.  The non-descent half is separate: a strict decrease of the \
         total is exhibited between two Pareto-incomparable outcomes." }
  , -- 66. The compiled action is not invertible
    { owner := "Integration.FactorisationCollision (Collision.projection_not_injective)"
      consumer := "DASHI.Applications selective-decision compilation"
      relation := .negativeResult
        (Function.Injective Integration.SelectiveDecision.compileDecision)
        Integration.LevelIIWelds.weld_action_not_invertible
      prov := about "Lean/Integration/LevelIIWelds.lean"
        ["Integration.SelectiveDecision.action_does_not_determine_direction",
         "Integration.LevelIIWelds.weld_mediator_instance"]
        "Row 45 states the same failure in the corpus's own vocabulary; this \
         row is the reduction of it to the collision owner, together with the \
         mediator form: no reading of the action recovers the direction." }
  , -- 67. Atlases: exhaustiveness evidence, not a coverage flag
    { owner := "Integration.RealisationAdequacy (Exhaustive)"
      consumer := "the corpus atlases' coverage disclaimers"
      relation := .candidateBridge
        (∃ l : List ℕ, Integration.DeclaredCarrier.ExhaustiveOn l (fun _ => True))
        (∃ l : List ℕ,
          Nonempty (Integration.RealisationAdequacy.Exhaustive (fun x : ℕ => x ∈ l)))
        (fun h => by
          obtain ⟨l, hl⟩ := h
          exact ⟨l, ⟨Integration.LevelIIWelds.exhaustiveOfList hl⟩⟩)
      prov := about "Lean/Integration/LevelIIWelds.lean"
        ["Integration.DeclaredCarrier.universal_of_exhaustive",
         "Integration.RealisationAdequacy.adequate_of_adequateOn_exhaustive"]
        "The hypothesis is exhaustiveness of the enumeration *of the ambient \
         type*, which the atlases decline to claim.  Rows 59 and 60 are the \
         negatives that make this bridge the only route." }
  , -- 68. Unreachability transports nowhere, in general
    { owner := "Integration.LanguageReachability (ReachableIn)"
      consumer := "DASHI.Core.AdmissibleReachability.Reachable"
      relation := .negativeResult
        (∀ (S : Integration.ReachabilityBarrier.ActionSystem ℕ Bool)
            (L₁ L₂ : Bool → Prop), (∀ a, L₁ a → L₂ a) → ∀ x y,
          ¬ Integration.LanguageReachability.ReachableIn S L₁ x y →
            ¬ Integration.LanguageReachability.ReachableIn S L₂ x y)
        Integration.LevelIIWelds.weld_unreachability_negative
      prov := about "Lean/Integration/LanguageReachability.lean"
        ["Integration.LevelIIWelds.weld_counter_is_language_indexed",
         "Integration.LanguageReachability.reachableIn_mono"]
        "The corpus's counter system under a declared language is proved equal \
         to the owner's language-indexed reachability, so rows 55 and 56 are \
         instances of this owner.  The row refutes the general transfer of \
         unreachability; the positive transfer of reachability is proved." }
  , -- 69. A coverage flag constrains nothing
    { owner := "Integration.RealisationAdequacy (CoverageDeclaration)"
      consumer := "Bool coverage/exhaustiveness fields across the corpus"
      relation := .openSocket
        (∃ d : Integration.RealisationAdequacy.CoverageDeclaration ℕ,
          d.claimsExhaustive = true ∧
            ¬ Nonempty (Integration.RealisationAdequacy.Exhaustive d.carrier))
        Integration.RealisationAdequacy.flag_does_not_give_exhaustive
      prov := about "Lean/Integration/RealisationAdequacy.lean"
        ["Integration.DeclaredCarrier.exhaustion_flag_is_free",
         "Integration.RealisationAdequacy.upgrade_needs_evidence_not_a_flag"]
        "The socket is the field, not the artefact: a `Bool` asserting \
         exhaustive coverage is compatible with a carrier that is not \
         exhaustive, so setting it is a declaration and never evidence." }
  ]

/-! ## Meta-theorems -/

/-- **No row claims an Agda typecheck.**  No Agda checker was run here. -/
theorem no_row_claims_agda_typechecked :
    ∀ r ∈ sewingRegistry, r.claimsAgdaTypechecked = false := by
  have h : sewingRegistry.all (fun r => !r.claimsAgdaTypechecked) = true := rfl
  intro r hr
  simpa using List.all_eq_true.mp h r hr

/-- Every row carries a non-empty claim boundary. -/
theorem every_row_has_boundary : ∀ r ∈ sewingRegistry, r.hasBoundary = true := by
  have h : sewingRegistry.all (fun r => r.hasBoundary) = true := rfl
  intro r hr
  simpa using List.all_eq_true.mp h r hr

/-- **No row is sourced from a PR head.**  The PR_HEADS surfaces named in the
handoff are not present in this tree, so none may be cited as provenance. -/
theorem no_branch_only_rows : ∀ r ∈ sewingRegistry, r.branchOnly = false := by
  have h : sewingRegistry.all (fun r => !r.branchOnly) = true := rfl
  intro r hr
  simpa using List.all_eq_true.mp h r hr

/-- Every row's Lean side is in a build target. -/
theorem every_row_lean_built : ∀ r ∈ sewingRegistry, r.prov.lean = .leanBuilt := by
  have h : sewingRegistry.all (fun r => decide (r.prov.lean = .leanBuilt)) = true := rfl
  intro r hr
  simpa using List.all_eq_true.mp h r hr

/-- The machine-checked census: the number of rows of each class.  Every count
quoted anywhere in this repository is this function evaluated by the compiler,
not a hand-maintained number. -/
noncomputable def kindCensus (k : Kind) : ℕ := (sewingRegistry.filter (fun r => r.kind == k)).length

/-- The classes this round exercises, and their counts. -/
theorem kinds_exercised :
    kindCensus .exactInstance = 2 ∧
    kindCensus .approximateInstance = 2 ∧
    kindCensus .finiteShadow = 1 ∧
    kindCensus .structuralAnalogue = 1 ∧
    kindCensus .candidateBridge = 7 ∧
    kindCensus .negativeResult = 47 ∧
    kindCensus .openSocket = 9 :=
  ⟨rfl, rfl, rfl, rfl, rfl, rfl, rfl⟩

/-- The registry has sixty-nine rows. -/
theorem registry_length : sewingRegistry.length = 69 := rfl

/-- **The census is complete**: the seven class counts sum to the number of
rows, so no row escapes classification and no row is counted twice. -/
theorem census_total :
    kindCensus .exactInstance + kindCensus .approximateInstance +
        kindCensus .finiteShadow + kindCensus .structuralAnalogue +
        kindCensus .candidateBridge + kindCensus .negativeResult +
        kindCensus .openSocket = sewingRegistry.length := rfl

/-- Negatives and deliberately open obligations remain the majority of the
registry. -/
theorem negatives_and_sockets_dominate :
    (sewingRegistry.filter
      (fun r => r.kind == .negativeResult || r.kind == .openSocket)).length = 56 := rfl

/-- And the majority is proved as such, rather than asserted by a count: more
than half of the registry is refutations and sockets. -/
theorem negatives_and_sockets_majority :
    2 * (sewingRegistry.filter
      (fun r => r.kind == .negativeResult || r.kind == .openSocket)).length >
        sewingRegistry.length := by decide

end Integration.SewingRegistry
