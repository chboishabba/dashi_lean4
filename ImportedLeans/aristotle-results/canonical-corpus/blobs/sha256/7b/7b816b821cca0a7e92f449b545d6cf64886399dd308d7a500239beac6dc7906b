------------------------------------------------------------------------
-- 0.  Two arithmetic helpers (the standard library has no additive
--     cancellation lemma for the rational order).
------------------------------------------------------------------------

+-cancelʳ-≤ : ∀ {a b : ℚ} (c : ℚ) → a + c ≤ b + c → a ≤ b
+-cancelʳ-≤ {a} {b} c hyp =
  subst₂ _≤_ (collapse a) (collapse b)
    (ℚP.+-mono-≤ hyp ℚP.≤-refl)
  where
    collapse : ∀ z → (z + c) + (- c) ≡ z
    collapse z =
      trans (ℚP.+-assoc z c (- c))
        (trans (cong (λ w → z + w) (ℚP.+-inverseʳ c)) (ℚP.+-identityʳ z))

-- ((1-θ)*γ)*n + (θ*γ)*n = γ*n, without a ring solver.
splitScaledNorm : ∀ (θ γ n : ℚ) → ((1ℚ - θ) * γ) * n + ((θ * γ) * n) ≡ γ * n
splitScaledNorm θ γ n =
  trans (sym (ℚP.*-distribʳ-+ n ((1ℚ - θ) * γ) (θ * γ)))
    (cong (_* n)
      (trans (sym (ℚP.*-distribʳ-+ γ (1ℚ - θ) θ))
        (trans
          (cong (_* γ)
            (trans (ℚP.+-assoc 1ℚ (- θ) θ)
              (trans (cong (λ w → 1ℚ + w) (ℚP.+-inverseˡ θ)) (ℚP.+-identityʳ 1ℚ))))
          (ℚP.*-identityˡ γ))))

------------------------------------------------------------------------
-- 1.  The rescaled norm, and the equivalence of the two readings
------------------------------------------------------------------------

module Rescaling
  (State : Set)
  (pairing : Nat → State → ℚ)      -- <x, H_j x>, the constrained Gaussian form
  (normSq : State → ℚ)             -- the unrescaled (dimensionful) ||x||^2
  (weight : Nat → ℚ)               -- the block-spin / coupling normalisation
  (Tangent : Nat → State → Set)    -- the gauge-fixed constrained tangent space
  where

  -- THE NORM.  This is the object J.4 asked to be named.
  rescaledNormSq : Nat → State → ℚ
  rescaledNormSq j x = weight j * normSq x

  -- The literal, coupling-scaled hypothesis, as the current A1 surface states
  -- it: the reference constant carries the running coupling.
  CouplingScaledCoercivity : ℚ → Set
  CouplingScaledCoercivity γ =
    ∀ j x → Tangent j x → (γ * weight j) * normSq x ≤ pairing j x

  -- A scale-uniform floor, stated in the rescaled norm.
  ScaleUniformRescaledFloor : ℚ → Set
  ScaleUniformRescaledFloor c =
    ∀ j x → Tangent j x → c * rescaledNormSq j x ≤ pairing j x

  couplingScaledIsUniformAfterRescaling :
    ∀ γ → CouplingScaledCoercivity γ → ScaleUniformRescaledFloor γ
  couplingScaledIsUniformAfterRescaling γ hyp j x tangent =
    subst (_≤ pairing j x) (ℚP.*-assoc γ (weight j) (normSq x)) (hyp j x tangent)

  uniformRescaledFloorIsCouplingScaled :
    ∀ γ → ScaleUniformRescaledFloor γ → CouplingScaledCoercivity γ
  uniformRescaledFloorIsCouplingScaled γ hyp j x tangent =
    subst (_≤ pairing j x) (sym (ℚP.*-assoc γ (weight j) (normSq x)))
      (hyp j x tangent)

------------------------------------------------------------------------
-- 2.  The relative perturbation budget is rescaling invariant, so the
--     full constrained Hessian floor is scale uniform too.
------------------------------------------------------------------------

  -- A relative penalty, read in the rescaled norm, keeps the same ratio θ.
  relativePenaltyIsRescalingInvariant :
    ∀ θ γ (penalty : Nat → State → ℚ) →
    (∀ j x → Tangent j x → penalty j x ≤ (θ * (γ * weight j)) * normSq x) →
    ∀ j x → Tangent j x → penalty j x ≤ (θ * γ) * rescaledNormSq j x
  relativePenaltyIsRescalingInvariant θ γ penalty hyp j x tangent =
    subst (penalty j x ≤_) reassociate (hyp j x tangent)
    where
      reassociate :
        (θ * (γ * weight j)) * normSq x ≡ (θ * γ) * rescaledNormSq j x
      reassociate =
        trans (cong (_* normSq x) (sym (ℚP.*-assoc θ γ (weight j))))
          (ℚP.*-assoc (θ * γ) (weight j) (normSq x))

  -- The mechanism of `BalabanRelativeHessianCoercivity`, in the rescaled norm:
  -- reference floor γ minus a relative budget θ gives the full Hessian the
  -- SCALE-INDEPENDENT floor (1-θ)γ.
  rescaledRelativeCoercivity :
    ∀ γ θ (full penalty : Nat → State → ℚ) →
    ScaleUniformRescaledFloor γ →
    (∀ j x → Tangent j x → pairing j x ≤ full j x + penalty j x) →
    (∀ j x → Tangent j x → penalty j x ≤ (θ * γ) * rescaledNormSq j x) →
    ∀ j x → Tangent j x →
      ((1ℚ - θ) * γ) * rescaledNormSq j x ≤ full j x
  rescaledRelativeCoercivity γ θ full penalty floor dominated relative j x tangent =
    +-cancelʳ-≤ ((θ * γ) * rescaledNormSq j x)
      (subst (_≤ full j x + ((θ * γ) * rescaledNormSq j x))
        (sym (splitScaledNorm θ γ (rescaledNormSq j x)))
        (ℚP.≤-trans (floor j x tangent)
          (ℚP.≤-trans (dominated j x tangent)
            (ℚP.+-monoʳ-≤ (full j x) (relative j x tangent)))))

------------------------------------------------------------------------
-- 3.  THE RESCALING WEIGHT IS FORCED BY THE PHYSICS
------------------------------------------------------------------------

  -- Suppose a candidate weight family `w` carries a scale-uniform positive
  -- floor `c` for the same pairing, and the pairing has the coupling-scaled
  -- ceiling `Γ` at a witness state of positive norm.  Then `w` cannot exceed
  -- the coupling weight by more than the fixed factor Γ/c.
  admissibleWeightBelowCouplingWeight :
    ∀ (w : Nat → ℚ) (c Γ : ℚ) (x : State) → 0ℚ < normSq x →
    (∀ j → c * (w j * normSq x) ≤ pairing j x) →
    (∀ j → pairing j x ≤ (Γ * weight j) * normSq x) →
    ∀ j → c * w j ≤ Γ * weight j
  admissibleWeightBelowCouplingWeight w c Γ x 0<n floor ceiling j =
    ℚP.*-cancelʳ-≤-pos (normSq x) {{ℚ.positive 0<n}}
      (subst (_≤ (Γ * weight j) * normSq x)
        (sym (ℚP.*-assoc c (w j) (normSq x)))
        (ℚP.≤-trans (floor j) (ceiling j)))

  -- Dually: a scale-uniform finite ceiling `C` in the `w`-norm, against the
  -- coupling-scaled floor `γ`, forces `w` to be at least a fixed fraction of
  -- the coupling weight.
  admissibleWeightAboveCouplingWeight :
    ∀ (w : Nat → ℚ) (C γ : ℚ) (x : State) → 0ℚ < normSq x →
    (∀ j → (γ * weight j) * normSq x ≤ pairing j x) →
    (∀ j → pairing j x ≤ C * (w j * normSq x)) →
    ∀ j → γ * weight j ≤ C * w j
  admissibleWeightAboveCouplingWeight w C γ x 0<n floor ceiling j =
    ℚP.*-cancelʳ-≤-pos (normSq x) {{ℚ.positive 0<n}}
      (subst ((γ * weight j) * normSq x ≤_)
        (sym (ℚP.*-assoc C (w j) (normSq x)))
        (ℚP.≤-trans (floor j) (ceiling j)))

  -- Both sides at once: every admissible dimensionless norm is comparable to
  -- the coupling-weighted one.  This is the uniqueness statement A1 needs.
  rescalingWeightIsForced :
    ∀ (w : Nat → ℚ) (c C γ Γ : ℚ) (x : State) → 0ℚ < normSq x →
    (∀ j → (γ * weight j) * normSq x ≤ pairing j x) →
    (∀ j → pairing j x ≤ (Γ * weight j) * normSq x) →
    (∀ j → c * (w j * normSq x) ≤ pairing j x) →
    (∀ j → pairing j x ≤ C * (w j * normSq x)) →
    ∀ j → (γ * weight j ≤ C * w j) × (c * w j ≤ Γ * weight j)
  rescalingWeightIsForced w c C γ Γ x 0<n floorγ ceilingΓ floorc ceilingC j =
    admissibleWeightAboveCouplingWeight w C γ x 0<n floorγ ceilingC j ,
    admissibleWeightBelowCouplingWeight w c Γ x 0<n floorc ceilingΓ j

------------------------------------------------------------------------
-- 4.  The existing scale-free record shape, satisfied by carrying the scale
------------------------------------------------------------------------

  -- `RelativeHessianCoercivityData` has `normSq : State -> Bound` with no
  -- scale index, so the rescaled norm lives there only on states that know
  -- their own scale.  On those, one scale-independent constant works.
  PairedState : Set
  PairedState = Nat × State

  pairedNormSq : PairedState → ℚ
  pairedNormSq p = rescaledNormSq (proj₁ p) (proj₂ p)

  pairedPairing : PairedState → ℚ
  pairedPairing p = pairing (proj₁ p) (proj₂ p)

  pairedScaleUniformFloor :
    ∀ γ → ScaleUniformRescaledFloor γ →
    ∀ p → Tangent (proj₁ p) (proj₂ p) →
    γ * pairedNormSq p ≤ pairedPairing p
  pairedScaleUniformFloor γ floor p tangent = floor (proj₁ p) (proj₂ p) tangent

------------------------------------------------------------------------
-- 5.  ONE MODEL, TWO NORMS:  the J.4 failure and its rescaled repair
------------------------------------------------------------------------

module Model where

  -- One-dimensional exact rational model with the dyadic coupling weight.
  dyadicWeight : Nat → ℚ
  dyadicWeight j = pow (+ 1 / 2) j

  modelNormSq : ℚ → ℚ
  modelNormSq x = x * x

  -- <x, H_j x> = weight_j ||x||^2 : the coupling-scaled Gaussian form.
  modelPairing : Nat → ℚ → ℚ
  modelPairing j x = dyadicWeight j * modelNormSq x

  ModelTangent : Nat → ℚ → Set
  ModelTangent _ _ = ⊤

  open Rescaling ℚ modelPairing modelNormSq dyadicWeight ModelTangent public

  -- In the RESCALED norm the floor is 1 at every scale (with equality).
  modelRescaledUniformFloor : ScaleUniformRescaledFloor 1ℚ
  modelRescaledUniformFloor j x _ =
    ℚP.≤-reflexive (ℚP.*-identityˡ (dyadicWeight j * modelNormSq x))

  -- In the UNRESCALED norm no floor above 1/1000 survives: at scale 10 the
  -- pairing at the unit state is 1/1024.  (This is the J.4 phenomenon, on the
  -- very same data as above.)
  modelPairingAtScaleTen : modelPairing 10 1ℚ < (+ 1 / 1000) * modelNormSq 1ℚ
  modelPairingAtScaleTen =
    toWitness {a? = (modelPairing 10 1ℚ) ℚP.<? ((+ 1 / 1000) * modelNormSq 1ℚ)} _

  modelNoUnrescaledFloorAboveOneThousandth :
    (∀ j → (+ 1 / 1000) * modelNormSq 1ℚ ≤ modelPairing j 1ℚ) → ⊥
  modelNoUnrescaledFloorAboveOneThousandth floor =
    ℚP.<-irrefl refl (ℚP.≤-<-trans (floor 10) modelPairingAtScaleTen)

  -- The two facts are about one family of forms and one physical trajectory;
  -- only the norm differs.  So "the reference coercivity constant contracts"
  -- is a statement about the dimensionful norm, and carries no information
  -- about the dimensionless one.
  sameDataBothNorms :
    ScaleUniformRescaledFloor 1ℚ
    × ((∀ j → (+ 1 / 1000) * modelNormSq 1ℚ ≤ modelPairing j 1ℚ) → ⊥)
  sameDataBothNorms =
    modelRescaledUniformFloor , modelNoUnrescaledFloorAboveOneThousandth

