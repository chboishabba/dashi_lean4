targetCount [] = zero
targetCount (_ ∷ xs) = suc (targetCount xs)

ruleCount : List FiniteRuleTarget → Nat
ruleCount [] = zero
ruleCount (_ ∷ xs) = suc (ruleCount xs)

mkFiniteRuleTarget :
  String →
  FiniteRuleKind →
  String →
  String →
