8319) or second-order class (Q24017414), is a class all of whose instances are implicitly or explicitly instances of (P31) second-order class (Q24017414).  A class is implicitly a third-order classes if it is a subclass of (P279) another class that is a third-order class.  These implicit instance of (P31) statements are not all observable in Wikidata.There are very few natural third-order classes.  Before stating that a class is instance of (P31) third-order class (Q24017465) check that it is actually a third-order class.","language":"en"},"type":"monolingualtext"},"datatype":"monolingualtext"},"type":"statement","id":"Q24017465$84a7ac19-471c-f544-3bf9-0ce7d8ba6707","rank":"normal"}],"P8225":[{"mainsnak":{"snaktype":"value","property":"P8225","hash":"ccd23585ad3f1ceee43bb32e0912f8cd1d79749a","datavalue":{"value":{"entity-type":"item","numeric-id":24017414,"id":"Q24017414"},"type":"wikibase-entityid"},"datatype":"wikibase-item"},"type":"statement","id":"Q24017465$0ae0bfde-4110-5dd3-5e58-c08e27c77de2","rank":"normal"}],"P6104":[{"mainsnak":{"snaktype":"value","property":"P6104","hash":"2bcf963484ee556d691849e71ea3ae951738fc36","datavalue":{"value":{"entity-type":"item","numeric-id":60005226,"id":"Q60005226"},"type":"wikibase-entityid"},"datatype":"wikibase-item"},"type":"statement","id":"Q24017465$663D7506-21B9-4E6D-8C7C-A8BCE0741A0C","rank":"normal"}],"P5869":[{"mainsnak":{"snaktype":"value","property":"P5869","hash":"16f016d33f37c95e20cd74d6ecfd05e95e6c9e65","datavalue":{"value":{"entity-type":"item","numeric-id":60484681,"id":"Q60484681"},"type":"wikibase-entityid"},"datatype":"wikibase-item"},"type":"statement","qualifiers":{"P11527":[{"snaktype":"value","property":"P11527","hash":"03333cd9754e182cbd8cf05cf461c34d428ffcbe","datavalue":{"value":{"entity-type":"property","numeric-id":31,"id":"P31"},"type":"wikibase-entityid"},"datatype":"wikibase-property"}]},"qualifiers-order":["P11527"],"id":"Q24017465$94ec4971-4fd8-8b7d-2fe9-eb825e6a536b","rank":"normal"}]},"site