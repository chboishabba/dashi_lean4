                                  (Group→AbGroup _ (π'-comm _))))
                   (lockIso l)
    snd (→Goal l s p) w =
      cong (fun (fst (lockIso l)))
         (cong (inv' (fst (AbelianizationIdempotent
                           (Group→AbGroup _ (π'-comm _))))) (p w))
      ∙ lockInvHomGen' l w _ refl

