=== [DEFINITION] AristotleExporter.formatFrontier ===
Type / Statement:
Array Lean.Name → Lean.MetaM (Array String)
Proof / Definition:
fun frontier => do
  let env ← Lean.getEnv
  have sorted : Array Lean.Name := frontier.qsort fun a b => decide (a.toString < b.toString)
  have blocks : Array String := #[]
  let r ←
    forIn sorted blocks fun name r =>
        have blocks := r;
        match env.find? name with
        | some info => do
          let typeFmt ← Lean.Meta.ppExpr info.type
          have modStr : String :=
            match AristotleExporter.declModule env name with
            | some m => m.toString
            | none => "<local>"
          have blocks : Array String :=
            blocks.push
              (toString "\n--- [FRONTIER · " ++ toString (AristotleExporter.kindTag info) ++ toString "] " ++
                          toString name ++
                        toString "  (from " ++
                      toString modStr ++
                    toString ") ---\nStatement:\n" ++
                  toString typeFmt ++
                toString "\n")
          pure PUnit.unit
          pure (ForInStep.yield blocks)
        | none =>
          have blocks := blocks.push (toString "\n--- [FRONTIER] " ++ toString name ++ toString " (not found) ---\n");
          do
          pure PUnit.unit
          pure (ForInStep.yield blocks)
  have blocks : Array String := r
  pure blocks
