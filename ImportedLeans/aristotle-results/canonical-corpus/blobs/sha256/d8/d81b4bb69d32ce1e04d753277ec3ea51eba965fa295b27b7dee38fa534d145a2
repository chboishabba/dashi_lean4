    PrimeLaneRelation

  distinctPrimeLanes :
    PrimeLaneRelation

data CarrierProjectorTerm : Set where
  Ppow :
    (primeLane : Nat) →
    (depthIndex : Nat) →
    CarrierProjectorTerm

data CrossPrimeInteractionShape : Set where
  projectedTransport :
    CarrierProjectorTerm →
    CarrierProjectorTerm →
    CrossPrimeInteractionShape

canonicalCrossPrimeInteractionShape :
