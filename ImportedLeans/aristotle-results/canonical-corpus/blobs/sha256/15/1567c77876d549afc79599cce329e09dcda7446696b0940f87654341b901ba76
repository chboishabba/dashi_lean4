crossLaneFlowPreservationBoundFormula =
  "||F_cross(u)||_{H^{-1}} <= C sum cross-base (p^l)/(p^j+q^l) a_j^{1/2} b_l^{1/2}"

crossLaneLipschitzFormula :
  String
crossLaneLipschitzFormula =
  "||F_cross(u)-F_cross(v)||_{H^{-1}} <= C' ||u-v||_{H^{11/8}}"

crossLaneLipschitzBoundFlag :
