  ≤→∧ : a ≤ b → a ≡ a ∧l b
  ≤→∧ = equivFun ≤≃∧

  ≤→∧≡Left : a ≤ b → a ∧l b ≡ a
  ≤→∧≡Left = sym ∘ ≤→∧

  ≥→∧≡Right : b ≤ a → a ∧l b ≡ b
  ≥→∧≡Right = sym ∘ (_∙ ∧Comm) ∘ ≤→∧

  Pseudolattice→Semigroup∧ : Semigroup ℓ
  Pseudolattice→Semigroup∧ .fst = L
  Pseudolattice→Semigroup∧ .snd .SemigroupStr._·_ = _∧l_
  Pseudolattice→Semigroup∧ .snd .SemigroupStr.isSemigroup =
    issemigroup is-set (λ _ _ _ → ∧Assoc)

