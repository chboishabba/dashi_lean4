    StrictSelectedBoundaryCancellationRow

  combineWithCanonicalBoundaryRow :
    StrictSelectedBoundaryCancellationRow

  actionVariationReducesToEulerLagrangeRow :
    StrictSelectedBoundaryCancellationRow

