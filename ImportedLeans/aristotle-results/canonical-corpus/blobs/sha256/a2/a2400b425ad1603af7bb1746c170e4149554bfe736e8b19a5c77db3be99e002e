namespace Wikidata

variable (kb : KB) (c : Qid) (ms : List Qid)

/-! ## Union -/

/-- `c` is the union of `ms`, as far as `kb` knows: every member is a subclass of
`c`, and every known instance of `c` is an instance of some member. -/
def IsUnionOn (kb : KB) (c : Qid) (ms : List Qid) : Prop :=
  (∀ m ∈ ms, SubclassOf kb m c) ∧
    (∀ x ∈ kb.entities, InstanceOf kb x c → ∃ m ∈ ms, InstanceOf kb x m)

/-- Executable union checker. -/
def unionOk (kb : KB) (c : Qid) (ms : List Qid) : Bool :=
  ms.all (fun m => isSubclassOf kb m c) &&
    kb.entities.all (fun x => !isInstanceOf kb x c || ms.any (fun m => isInstanceOf kb x m))

theorem unionOk_iff : unionOk kb c ms = true ↔ IsUnionOn kb c ms := by
  simp only [unionOk, Bool.and_eq_true, List.all_eq_true, List.any_eq_true, Bool.or_eq_true,
    Bool.not_eq_true', IsUnionOn]
  constructor
  · rintro ⟨h1, h2⟩
    refine ⟨fun m hm => (isSubclassOf_iff kb m c).1 (h1 m hm), ?_⟩
    intro x hx hinst
    rcases h2 x hx with h | ⟨m, hm, hxm⟩
    · exact absurd ((isInstanceOf_iff kb x c).2 hinst) (by simp [h])
    · exact ⟨m, hm, (isInstanceOf_iff kb x m).1 hxm⟩
  · rintro ⟨h1, h2⟩
    refine ⟨fun m hm => (isSubclassOf_iff kb m c).2 (h1 m hm), ?_⟩
    intro x hx
    by_cases hinst : isInstanceOf kb x c = true
    · obtain ⟨m, hm, hxm⟩ := h2 x hx ((isInstanceOf_iff kb x c).1 hinst)
      exact Or.inr ⟨m, hm, (isInstanceOf_iff kb x m).2 hxm⟩
    · exact Or.inl (by simpa using hinst)

/-- Soundness direction, in the shape used by the bridge layer. -/
theorem isUnion_of_unionOk (h : unionOk kb c ms = true) : IsUnionOn kb c ms :=
  (unionOk_iff kb c ms).1 h

/-! ## Intersection -/

/-- `c` is the intersection of `ms`, as far as `kb` knows. -/
def IsIntersectionOn (kb : KB) (c : Qid) (ms : List Qid) : Prop :=
  (∀ m ∈ ms, SubclassOf kb c m) ∧
    (∀ x ∈ kb.entities, (∀ m ∈ ms, InstanceOf kb x m) → InstanceOf kb x c)

/-- Executable intersection checker. -/
def interOk (kb : KB) (c : Qid) (ms : List Qid) : Bool :=
  ms.all (fun m => isSubclassOf kb c m) &&
    kb.entities.all (fun x => !ms.all (fun m => isInstanceOf kb x m) || isInstanceOf kb x c)

theorem interOk_iff : interOk kb c ms = true ↔ IsIntersectionOn kb c ms := by
  simp only [interOk, Bool.and_eq_true, List.all_eq_true, Bool.or_eq_true, Bool.not_eq_true',
    IsIntersectionOn]
  constructor
  · rintro ⟨h1, h2⟩
    refine ⟨fun m hm => (isSubclassOf_iff kb c m).1 (h1 m hm), ?_⟩
    intro x hx hall
    rcases h2 x hx with h | h
    · have htrue : ms.all (fun m => isInstanceOf kb x m) = true :=
        List.all_eq_true.2 (fun m hm => (isInstanceOf_iff kb x m).2 (hall m hm))
      rw [htrue] at h
      exact absurd h (by simp)
    · exact (isInstanceOf_iff kb x c).1 h
  · rintro ⟨h1, h2⟩
    refine ⟨fun m hm => (isSubclassOf_iff kb c m).2 (h1 m hm), ?_⟩
    intro x hx
    by_cases hall : ms.all (fun m => isInstanceOf kb x m) = true
    · refine Or.inr ((isInstanceOf_iff kb x c).2 (h2 x hx ?_))
      intro m hm
      simp only [List.all_eq_true] at hall
      exact (isInstanceOf_iff kb x m).1 (hall m hm)
    · exact Or.inl (by simpa using hall)

theorem isIntersection_of_interOk (h : interOk kb c ms = true) : IsIntersectionOn kb c ms :=
  (interOk_iff kb c ms).1 h

/-! ## Disjointness and disjoint union -/

/-- Two classes have no common known instance. -/
def DisjointOn (kb : KB) (c d : Qid) : Prop :=
  ∀ x ∈ kb.entities, ¬ (InstanceOf kb x c ∧ InstanceOf kb x d)

/-- Executable disjointness checker. -/
def disjointOk (kb : KB) (c d : Qid) : Bool :=
  kb.entities.all (fun x => !(isInstanceOf kb x c && isInstanceOf kb x d))

theorem disjointOk_iff (kb : KB) (c d : Qid) :
    disjointOk kb c d = true ↔ DisjointOn kb c d := by
  simp only [disjointOk, List.all_eq_true, Bool.not_eq_true', Bool.and_eq_false_iff,
    DisjointOn]
  constructor
  · intro h x hx ⟨h1, h2⟩
    rcases h x hx with h' | h'
    · exact absurd ((isInstanceOf_iff kb x c).2 h1) (by simp [h'])
    · exact absurd ((isInstanceOf_iff kb x d).2 h2) (by simp [h'])
  · intro h x hx
    by_cases h1 : isInstanceOf kb x c = true
    · refine Or.inr ?_
      by_contra h2
      simp only [Bool.not_eq_false] at h2
      exact h x hx ⟨(isInstanceOf_iff kb x c).1 h1, (isInstanceOf_iff kb x d).1 h2⟩
    · exact Or.inl (by simpa using h1)

/-- No entity instantiates two disjoint classes. -/
theorem no_common_instance_of_disjoint {kb : KB} {c d : Qid} (h : DisjointOn kb c d)
    {x : Qid} (hx : x ∈ kb.entities) (h1 : InstanceOf kb x c) : ¬ InstanceOf kb x d :=
  fun h2 => h x hx ⟨h1, h2⟩

/-- `c` is the *disjoint* union of `ms`, as far as `kb` knows. -/
def IsDisjointUnionOn (kb : KB) (c : Qid) (ms : List Qid) : Prop :=
  IsUnionOn kb c ms ∧
    ∀ m₁ ∈ ms, ∀ m₂ ∈ ms, m₁ ≠ m₂ → DisjointOn kb m₁ m₂

/-- Executable disjoint-union checker. -/
def dunOk (kb : KB) (c : Qid) (ms : List Qid) : Bool :=
  unionOk kb c ms &&
    ms.all (fun m₁ => ms.all (fun m₂ => (m₁ = m₂) || disjointOk kb m₁ m₂))

theorem dunOk_iff : dunOk kb c ms = true ↔ IsDisjointUnionOn kb c ms := by
  simp only [dunOk, Bool.and_eq_true, List.all_eq_true, Bool.or_eq_true, unionOk_iff,
    IsDisjointUnionOn, decide_eq_true_eq]
  constructor
  · rintro ⟨h1, h2⟩
    refine ⟨h1, ?_⟩
    intro m₁ hm₁ m₂ hm₂ hne
    rcases h2 m₁ hm₁ m₂ hm₂ with h | h
    · exact absurd h hne
    · exact (disjointOk_iff kb m₁ m₂).1 h
  · rintro ⟨h1, h2⟩
    refine ⟨h1, ?_⟩
    intro m₁ hm₁ m₂ hm₂
    by_cases hne : m₁ = m₂
    · exact Or.inl hne
    · exact Or.inr ((disjointOk_iff kb m₁ m₂).2 (h2 m₁ hm₁ m₂ hm₂ hne))

theorem isDisjointUnion_of_dunOk (h : dunOk kb c ms = true) : IsDisjointUnionOn kb c ms :=
  (dunOk_iff kb c ms).1 h

/-- A disjoint union is in particular a union: the extra disjointness content is
never lost, but never silently assumed either. -/
theorem isUnion_of_isDisjointUnion (h : IsDisjointUnionOn kb c ms) : IsUnionOn kb c ms := h.1

theorem unionOk_of_dunOk (h : dunOk kb c ms = true) : unionOk kb c ms = true :=
  (unionOk_iff kb c ms).2 (isDisjointUnion_of_dunOk kb c ms h).1

end Wikidata
