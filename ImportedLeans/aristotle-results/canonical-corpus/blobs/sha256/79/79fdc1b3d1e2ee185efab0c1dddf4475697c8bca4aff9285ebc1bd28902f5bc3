currentBoardHasExternalRequiredW2 :
  GateReport.status
    (W7ClaimGovernanceCurrentGateBoard.w2
      canonicalW7ClaimGovernanceCurrentGateBoard)
  ≡
  externalRequired
currentBoardHasExternalRequiredW2 =
  refl

currentBoardNotAllClosed :
  AllW7ClaimGovernanceGatesClosed
    canonicalW7ClaimGovernanceCurrentGateBoard →
  ⊥
