namespace Wikidata

namespace Owl

/-- A triple of the knowledge base, as read by the query and entailment layers. -/
abbrev Triple := Qid × Pid × Qid

/-- The truthy triples of a knowledge base. -/
def triples (kb : KB) : List Triple :=
  (kb.statements.filter (fun st => IsTruthy kb st)).map
    (fun st => (st.subject, st.property, st.value))

theorem mem_triples_iff (kb : KB) (t : Triple) :
    t ∈ triples kb ↔
      ∃ st ∈ kb.statements, IsTruthy kb st = true ∧
        (st.subject, st.property, st.value) = t := by
  simp [triples, List.mem_map, List.mem_filter, and_assoc]

/-- Which properties are declared transitive or symmetric, and which pairs are
declared inverse to one another. -/
structure Profile where
  transitive : List Pid := []
  symmetric : List Pid := []
  inverse : List (Pid × Pid) := []
  deriving DecidableEq, Repr, Inhabited

/-- The entailment relation generated by a profile over the truthy triples. -/
inductive Entails (pr : Profile) (kb : KB) : Qid → Pid → Qid → Prop
  | base {a p b} : (a, p, b) ∈ triples kb → Entails pr kb a p b
  | symm {a p b} : p ∈ pr.symmetric → Entails pr kb a p b → Entails pr kb b p a
  | inv {a p q b} : (p, q) ∈ pr.inverse → Entails pr kb a p b → Entails pr kb b q a
  | trans {a p b c} : p ∈ pr.transitive → Entails pr kb a p b → Entails pr kb b p c →
      Entails pr kb a p c

/-! ## Closed bases -/

/-- A list of triples is closed under a profile when every rule of the profile
leads back into the list. -/
def Closed (pr : Profile) (ts : List Triple) : Prop :=
  (∀ t ∈ ts, t.2.1 ∈ pr.symmetric → (t.2.2, t.2.1, t.1) ∈ ts) ∧
    (∀ t ∈ ts, ∀ pq ∈ pr.inverse, pq.1 = t.2.1 → (t.2.2, pq.2, t.1) ∈ ts) ∧
    (∀ t ∈ ts, ∀ u ∈ ts, t.2.1 ∈ pr.transitive → u.1 = t.2.2 → u.2.1 = t.2.1 →
      (t.1, t.2.1, u.2.2) ∈ ts)

instance (pr : Profile) (ts : List Triple) : Decidable (Closed pr ts) :=
  inferInstanceAs (Decidable (_ ∧ _ ∧ _))

/-- The executable closure check. -/
def closedOk (pr : Profile) (ts : List Triple) : Bool := decide (Closed pr ts)

/-- **Exactness of the closure check.** -/
theorem closedOk_iff (pr : Profile) (ts : List Triple) :
    closedOk pr ts = true ↔ Closed pr ts := decide_eq_true_iff

/-- **Completeness on a closed base**: if the truthy triples are already closed
under the profile, then everything the profile entails is already recorded. -/
theorem mem_of_entails_of_closed {pr : Profile} {kb : KB} (hclosed : Closed pr (triples kb))
    {a b : Qid} {p : Pid} (h : Entails pr kb a p b) : (a, p, b) ∈ triples kb := by
  induction h with
  | @base a p b hmem => exact hmem
  | @symm a p b hs _ ih => exact hclosed.1 (a, p, b) ih hs
  | @inv a p q b hi _ ih => exact hclosed.2.1 (a, p, b) ih (p, q) hi rfl
  | @trans a p b c ht _ _ ih₁ ih₂ => exact hclosed.2.2 (a, p, b) ih₁ (b, p, c) ih₂ ht rfl rfl

/-- Entailment always contains the recorded triples. -/
theorem entails_of_mem_triples {pr : Profile} {kb : KB} {a b : Qid} {p : Pid}
    (h : (a, p, b) ∈ triples kb) : Entails pr kb a p b := Entails.base h

/-- With no characteristics declared, entailment is inert: it adds nothing to what
the base records. -/
theorem closed_empty_profile (ts : List Triple) : Closed { } ts := by
  refine ⟨?_, ?_, ?_⟩
  · intro t _ h; simp at h
  · intro t _ pq h; simp at h
  · intro t _ u _ h; simp at h

theorem entails_empty_profile_iff (kb : KB) (a b : Qid) (p : Pid) :
    Entails { } kb a p b ↔ (a, p, b) ∈ triples kb :=
  ⟨mem_of_entails_of_closed (closed_empty_profile _), Entails.base⟩

/-! ## Boundary results -/

/-- `P361`, "part of". -/
def P361 : Pid := ⟨361⟩
/-- `P22`, "father". -/
def P22owl : Pid := ⟨22⟩
/-- `P40`, "child". -/
def P40owl : Pid := ⟨40⟩

/-- A base with a two-step part-of chain and nothing else. -/
def chainKB : KB :=
  ⟨[⟨1⟩, ⟨2⟩, ⟨3⟩],
   [⟨⟨1⟩, P361, ⟨2⟩, Rank.normal⟩, ⟨⟨2⟩, P361, ⟨3⟩, Rank.normal⟩]⟩

/-- The profile that declares part-of transitive. -/
def transitiveProfile : Profile := { transitive := [P361] }

/-- **Declaring a property transitive is not conservative.**  The declaration
alone yields a fact the base never asserted, so it edits the theory rather than
reading it. -/
theorem transitivity_is_not_conservative :
    Entails transitiveProfile chainKB ⟨1⟩ P361 ⟨3⟩ ∧
      ((⟨1⟩, P361, ⟨3⟩) : Triple) ∉ triples chainKB := by
  refine ⟨?_, by decide⟩
  exact Entails.trans (b := ⟨2⟩) (by decide) (Entails.base (by decide)) (Entails.base (by decide))

/-- The base without the declaration is closed, and with it is not. -/
theorem declaration_breaks_closure :
    Closed { } (triples chainKB) ∧ ¬ Closed transitiveProfile (triples chainKB) := by
  constructor
  · exact (closedOk_iff _ _).1 (by decide)
  · intro h
    exact absurd ((closedOk_iff transitiveProfile (triples chainKB)).2 h) (by decide)

/-- A base recording only the father direction. -/
def fatherKB : KB := ⟨[⟨1⟩, ⟨2⟩], [⟨⟨1⟩, P22owl, ⟨2⟩, Rank.normal⟩]⟩

/-- The profile declaring father and child inverse. -/
def inverseProfile : Profile := { inverse := [(P22owl, P40owl)] }

/-- **The converse is derived, not recorded.**  The inverse declaration yields the
child triple, which the base does not contain: a consumer reading the entailed
triples cannot tell which direction was asserted. -/
theorem converse_is_derived_not_recorded :
    Entails inverseProfile fatherKB ⟨2⟩ P40owl ⟨1⟩ ∧
      ((⟨2⟩, P40owl, ⟨1⟩) : Triple) ∉ triples fatherKB := by
  refine ⟨Entails.inv (p := P22owl) (by decide) (Entails.base (by decide)), by decide⟩

/-- `P3373`, "sibling". -/
def P3373 : Pid := ⟨3373⟩

/-- A base recording one direction of a sibling relation. -/
def siblingKB : KB := ⟨[⟨1⟩, ⟨2⟩], [⟨⟨1⟩, P3373, ⟨2⟩, Rank.normal⟩]⟩

/-- The profile declaring sibling symmetric. -/
def symmetricProfile : Profile := { symmetric := [P3373] }

/-- A symmetry declaration likewise yields a triple the base does not record. -/
theorem symmetry_is_not_conservative :
    Entails symmetricProfile siblingKB ⟨2⟩ P3373 ⟨1⟩ ∧
      ((⟨2⟩, P3373, ⟨1⟩) : Triple) ∉ triples siblingKB := by
  refine ⟨Entails.symm (by decide) (Entails.base (by decide)), by decide⟩

/-- Two classes made equivalent by a pair of mutual `P279` statements. -/
def cycleKB : KB :=
  ⟨[⟨1⟩, ⟨2⟩], [⟨⟨1⟩, P279, ⟨2⟩, Rank.normal⟩, ⟨⟨2⟩, P279, ⟨1⟩, Rank.normal⟩]⟩

/-- **Class equivalence must not be encoded as a subclass cycle.**  The mutual
statements do make each class a subclass of the other, and they make the base
invalid by the project's own diagnostics — so `owl:equivalentClass` needs a
predicate of its own rather than a cycle in the class order. -/
theorem equivalence_by_cycle_is_invalid :
    SubclassOf cycleKB ⟨1⟩ ⟨2⟩ ∧ SubclassOf cycleKB ⟨2⟩ ⟨1⟩ ∧ ¬ Valid cycleKB := by
  refine ⟨(isSubclassOf_iff _ _ _).1 (by decide), (isSubclassOf_iff _ _ _).1 (by decide), ?_⟩
  intro h
  exact absurd ((valid_iff cycleKB).2 h) (by decide)

end Owl

end Wikidata
