    → (η : a ≈ a′)
    → η ≈ γ • γ ⁻¹ • η
  concatenating γ and-its-inverse-to-the-left-of η changes-nothing =
    refl-is-left-neutral η •
      (λ ζ → ζ • η) ⁎ ⁻¹-is-right-inversion γ ⁻¹


  move-up-left : ∀ {A : 𝒰₀} {a a′ a″ : A} (γ : a ≈ a′) (γ′ : a″ ≈ a′) (γ″ : a ≈ a″)
