    postulate
      ℑ-is-lex : ∀ (a a′ : A) → ι a ≈ ι a′ → ℑ (a ≈ a′)

    ℑ-transport : {a a′ : A}
      → (ι a ≈ ι a′) → (ℑ (P a) →  ℑ (P a′))
    ℑ-transport = ℑ-transport′ ∘ (ℑ-is-lex _ _)

