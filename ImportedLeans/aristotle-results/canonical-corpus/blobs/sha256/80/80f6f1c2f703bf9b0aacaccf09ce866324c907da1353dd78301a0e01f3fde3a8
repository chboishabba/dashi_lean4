      SelectedBoundaryClosedAt

    canonicalBoundaryClosed :
      (connection : YMObs.YMSFGCUserSuppliedNonFlatConnectionCarrier) →
      (δA : YMObs.YMSFGCUserSuppliedVariationCarrier) →
