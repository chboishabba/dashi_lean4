-ₕ^-gen-eq : ∀ {ℓ} {k : ℕ} {A : Type ℓ} (n m : ℕ)
  → (p : isEvenT n ⊎ isOddT n) (q : isEvenT m ⊎ isOddT m)
  → (x : coHom k A)
