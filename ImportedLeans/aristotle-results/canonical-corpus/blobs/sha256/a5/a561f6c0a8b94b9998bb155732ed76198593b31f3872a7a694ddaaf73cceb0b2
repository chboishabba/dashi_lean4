import Integration.Experiment.Uncertainty
import Integration.LanguageReachability

/-!
# Lane 3 — experimental protocols as interventions

An experiment is formalised here as the quadruple `(X₀, U, T, O)`: an initial
state, a control signal, dynamics, and a measurement map.  The protocol is the
control signal — the *intervention* — and the predicted observations are read
off the resulting trajectory.

## The connection to the existing reachability work

`trajectory_reachableIn` proves the slogan exactly: **an experiment is a
constrained reachable-state query with observations.**  The trajectory of a
protocol whose controls all lie in a declared action language `L` reaches its
final state in the sense of `Integration.LanguageReachability.ReachableIn` for
that same `L`, with no new reachability notion introduced.

## Contents

* `§1` `Dynamics`, `trajectory`, and determinism
  (`trajectory_determined_by_initial_state_and_controls`);
* `§2` protocols: the pulse `I(t) = I₀ · 1[0 ≤ t < T]`, and the closed forms it
  produces under an accumulating dynamics (`pulse_accumulates`,
  `constant_after_pulse`);
* `§3` the reachability bridge;
* `§4` observation traces, and the standing negative: a trace need not
  determine the trajectory that produced it.
-/

namespace Integration.Experiment.Intervention

open Integration.CoordinateSufficiency
open Integration.FactorisationCollision
open Integration.ReachabilityBarrier
open Integration.LanguageReachability

variable {State Control Obs : Type}

/-! ## §1 Dynamics and trajectories -/

/-- Deterministic controlled dynamics: a state and a control give the next
state. -/
structure Dynamics (State Control : Type) where
  /-- One time step under the given control. -/
  step : State → Control → State

/-- The trajectory generated by an initial state and a control signal. -/
def trajectory (D : Dynamics State Control) (x₀ : State) (u : ℕ → Control) : ℕ → State
  | 0 => x₀
  | n + 1 => D.step (trajectory D x₀ u n) (u n)

@[simp] theorem trajectory_zero (D : Dynamics State Control) (x₀ : State) (u : ℕ → Control) :
    trajectory D x₀ u 0 = x₀ := rfl

@[simp] theorem trajectory_succ (D : Dynamics State Control) (x₀ : State) (u : ℕ → Control)
    (n : ℕ) : trajectory D x₀ u (n + 1) = D.step (trajectory D x₀ u n) (u n) := rfl

/-- **Determinism.**  The trajectory depends on nothing beyond the initial state
and the controls actually applied: two protocols agreeing on the first `n`
controls agree on the state at time `n`. -/
theorem trajectory_determined_by_initial_state_and_controls
    (D : Dynamics State Control) (x₀ : State) (u v : ℕ → Control) (n : ℕ)
    (h : ∀ k, k < n → u k = v k) : trajectory D x₀ u n = trajectory D x₀ v n := by
  induction n with
  | zero => rfl
  | succ n ih =>
    have hn : ∀ k, k < n → u k = v k := fun k hk => h k (by omega)
    rw [trajectory_succ, trajectory_succ, ih hn, h n (by omega)]

/-! ## §2 Protocols -/

/-- A protocol: the control signal and the horizon over which it is run. -/
structure Protocol (Control : Type) where
  /-- The control applied at each time step. -/
  control : ℕ → Control
  /-- The number of steps the experiment runs for. -/
  horizon : ℕ

/-- **The galvanostatic pulse** `I(t) = 0` for `t < 0`, `I₀` for `0 ≤ t < T`,
`0` for `t ≥ T`.  Time is indexed by `ℕ` here, so the first clause is the
convention that the experiment starts at step `0`. -/
def pulse (I₀ : ℚ) (T : ℕ) : ℕ → ℚ := fun t => if t < T then I₀ else 0

@[simp] theorem pulse_during {I₀ : ℚ} {T t : ℕ} (h : t < T) : pulse I₀ T t = I₀ := by
  simp [pulse, h]

@[simp] theorem pulse_after {I₀ : ℚ} {T t : ℕ} (h : ¬ t < T) : pulse I₀ T t = 0 := by
  simp [pulse, h]

/-- The accumulating (coulomb-counting) dynamics with time step `dt`. -/
def accumulate (dt : ℚ) : Dynamics ℚ ℚ where
  step := fun q i => q + i * dt

/-- **Closed form during the pulse.**  After `n ≤ T` steps of the pulse the
accumulated quantity is `q₀ + n I₀ dt`. -/
theorem pulse_accumulates (q₀ I₀ dt : ℚ) (T n : ℕ) (h : n ≤ T) :
    trajectory (accumulate dt) q₀ (pulse I₀ T) n = q₀ + n * I₀ * dt := by
  induction n with
  | zero => simp
  | succ n ih =>
    have hn : n ≤ T := by omega
    rw [trajectory_succ, ih hn, pulse_during (by omega : n < T)]
    simp [accumulate]
    ring

/-- **The charge delivered by a complete pulse.** -/
theorem charge_after_pulse (q₀ I₀ dt : ℚ) (T : ℕ) :
    trajectory (accumulate dt) q₀ (pulse I₀ T) T = q₀ + T * I₀ * dt :=
  pulse_accumulates q₀ I₀ dt T T le_rfl

/-- **And nothing happens afterwards**: once the pulse is off the accumulated
quantity is constant, so the protocol's effect is exactly its on-interval. -/
theorem constant_after_pulse (q₀ I₀ dt : ℚ) (T n : ℕ) (h : T ≤ n) :
    trajectory (accumulate dt) q₀ (pulse I₀ T) n = q₀ + T * I₀ * dt := by
  induction n with
  | zero =>
    have : T = 0 := by omega
    simp [this]
  | succ n ih =>
    rcases Nat.lt_or_ge T (n + 1) with hlt | hge
    · have hTn : T ≤ n := by omega
      rw [trajectory_succ, ih hTn, pulse_after (by omega : ¬ n < T)]
      simp [accumulate]
    · have : T = n + 1 := by omega
      subst this
      exact charge_after_pulse q₀ I₀ dt _

/-! ## §3 An experiment is a constrained reachability query -/

/-- The action system generated by deterministic dynamics: every control is
attemptable, and the successor is the one the dynamics computes. -/
def toActionSystem (D : Dynamics State Control) : ActionSystem State Control where
  Precondition := fun _ _ => True
  Postcondition := fun x a y => y = D.step x a

/-- **The bridge.**  If every control the protocol applies before time `n` lies
in the declared action language `L`, then the state at time `n` is reachable
from the initial state *in that language* — the existing language-indexed
reachability, not a new relation.  An experiment is a reachable-state query
constrained by the protocol, and its output is the observation of the state
reached. -/
theorem trajectory_reachableIn (D : Dynamics State Control) (L : Control → Prop)
    (x₀ : State) (u : ℕ → Control) (n : ℕ) (hL : ∀ k, k < n → L (u k)) :
    ReachableIn (toActionSystem D) L x₀ (trajectory D x₀ u n) := by
  induction n with
  | zero => exact Reachable.refl _
  | succ n ih =>
    refine reachableIn_trans (ih fun k hk => hL k (by omega)) ?_
    exact reachableIn_step (u n) (hL n (by omega)) trivial rfl (Reachable.refl _)

/-! ## §4 Observation traces -/

/-- An experiment: initial state, protocol, dynamics, measurement map. -/
structure ExperimentRun (State Control Obs : Type) where
  /-- The initial state `X₀`. -/
  initial : State
  /-- The protocol `U`. -/
  protocol : Protocol Control
  /-- The dynamics `T`. -/
  dynamics : Dynamics State Control
  /-- The measurement map `O`. -/
  observe : State → Obs

/-- The state of the run at time `n`. -/
def ExperimentRun.state (e : ExperimentRun State Control Obs) (n : ℕ) : State :=
  trajectory e.dynamics e.initial e.protocol.control n

/-- The predicted observation trace over the horizon. -/
def ExperimentRun.trace (e : ExperimentRun State Control Obs) : List Obs :=
  (List.range (e.protocol.horizon + 1)).map (fun n => e.observe (e.state n))

theorem ExperimentRun.trace_length (e : ExperimentRun State Control Obs) :
    e.trace.length = e.protocol.horizon + 1 := by
  simp [ExperimentRun.trace]

/-- The trace really is the observation of the trajectory, pointwise. -/
theorem ExperimentRun.trace_get (e : ExperimentRun State Control Obs) (n : ℕ)
    (h : n < e.protocol.horizon + 1) :
    e.trace[n]'(by simpa [ExperimentRun.trace_length] using h) = e.observe (e.state n) := by
  simp [ExperimentRun.trace]

/-- **The standing negative.**  A trace need not determine the trajectory that
produced it: here a constant measurement is compatible with two different
accumulating runs.  Everything the later lanes do about risk observability and
sensor choice is a refinement of this one collision. -/
def traceCollision :
    Collision (fun _ : ℚ => (0 : ℚ)) (fun q : ℚ => trajectory (accumulate 1) q (pulse 1 1) 1) where
  left := 0
  right := 1
  distinct := by norm_num
  collide := rfl
  separate := by
    rw [charge_after_pulse, charge_after_pulse]
    norm_num

theorem blind_trace_does_not_determine_the_state :
    ¬ Determines (fun _ : ℚ => (0 : ℚ))
      (fun q : ℚ => trajectory (accumulate 1) q (pulse 1 1) 1) :=
  traceCollision.not_determines

end Integration.Experiment.Intervention
