  refl

selectedInitialHFiltrationStep :
  selectedP2Filtration (selectedH selectedInitialFactorVec)
  ≡
  Agda.Builtin.Nat.suc (selectedP2Filtration selectedInitialFactorVec)
selectedInitialHFiltrationStep =
  selectedHFiltrationStep selectedInitialFactorVec

