isOpen : ResearchRow → Bool
isOpen row with status row
... | openRow   = true
... | provedRow = false

openRows : List ResearchRow → Nat
openRows [] = zero
openRows (row ∷ rows) with isOpen row
... | true  = suc (openRows rows)
... | false = openRows rows

frozenResearchCount : Nat
frozenResearchCount = openRows frozenRows

