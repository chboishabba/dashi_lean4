          singCaseAux (inr i) = transp (λ 𝕚 → h ⋆⟨ C ⟩
              (++Lemmas.toConeOutPathPR ((pbPr₁ ⋁Pullback) ★ (restCone γ γ∈L'))
                                        ((pbPr₂ ⋁Pullback) ★ (restCone β β∈L'))
                                        (to++ConeSquare _ _ (pbCommutes ⋁Pullback)) i 𝕚)
