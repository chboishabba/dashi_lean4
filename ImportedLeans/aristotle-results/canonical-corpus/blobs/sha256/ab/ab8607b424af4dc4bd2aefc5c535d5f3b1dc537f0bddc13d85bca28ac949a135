                  , sym (⌣-1ₕ _ _ ∙ cong (λ p → subst (λ p → coHom p R-ab A) p a)
                        (isSetℕ _ _ _ _)))))
        (λ _ → ΣPathTransport→PathΣ _ _ (refl , transportRefl _ ∙ 1ₕ-⌣ _ _))
        (λ _ _ _ → distrL⌣ _ _ _ _ _)
        λ _ _ _ → distrR⌣ _ _ _ _ _

