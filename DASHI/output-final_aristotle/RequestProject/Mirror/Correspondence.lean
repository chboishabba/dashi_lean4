/-! ## §2 `statement = "lean-defeq"`

The translation between the two `Observation` carriers, and the defeq of every
mirrored declaration across it.
-/

/-- The facade's observation record, read as the native one. -/
def toNative (o : _root_.JFixedPoint.Observation) : Mirror.JFixedPoint.Observation :=
  ⟨o.e47, o.e59, o.e71⟩

/-- And back. -/
def ofNative (o : Mirror.JFixedPoint.Observation) : _root_.JFixedPoint.Observation :=
  { e47 := o.e47, e59 := o.e59, e71 := o.e71 }

theorem toNative_ofNative (o : Mirror.JFixedPoint.Observation) :
    toNative (ofNative o) = o := rfl

theorem ofNative_toNative (o : _root_.JFixedPoint.Observation) :
    ofNative (toNative o) = o := rfl

/-- `JFixedPoint.contract` is definitionally the native `contract`. -/
theorem contract_defeq (o : _root_.JFixedPoint.Observation) :
    _root_.JFixedPoint.contract o = Mirror.JFixedPoint.contract (toNative o) := rfl

/-- `JFixedPoint.unit-obs` is definitionally the native `unitObs`. -/
theorem unitObs_defeq : toNative _root_.JFixedPoint.«unit-obs» = Mirror.JFixedPoint.unitObs := rfl

/-- `JFixedPoint.stack` is definitionally the native `stack`. -/
theorem stack_defeq (n : Nat) :
    toNative (_root_.JFixedPoint.stack n) = Mirror.JFixedPoint.stack n := by
  cases n <;> rfl

/-- `JFixedPoint.contract-all` is definitionally the native `contractAll`. -/
theorem contractAll_defeq (t : _root_.JFixedPoint.Tower) :
    _root_.JFixedPoint.«contract-all» t = Mirror.JFixedPoint.contractAll (t.map toNative) := by
  induction t with
  | nil => rfl
  | cons o os ih =>
      simp only [List.map_cons, _root_.JFixedPoint.«contract-all», Mirror.JFixedPoint.contractAll,
        List.cons.injEq]
      exact ⟨rfl, ih⟩

/-- `JFixedPoint.tower-3` is definitionally the native `tower3`. -/
theorem tower3_defeq :
    _root_.JFixedPoint.«tower-3».map toNative = Mirror.JFixedPoint.tower3 := rfl

/-! ### The `semantic` mapping rows

The registry maps `fixed-0`, `fixed-1`, `fixed-2` and `fixed-100` onto the single
native theorem `stack_converges`.  A semantic mapping is sound only if the target
implies each source statement; here is that implication, for every layer at once
and hence for the four the Agda names.
-/

theorem facade_stack_converges (n : Nat) : _root_.JFixedPoint.contract (_root_.JFixedPoint.stack n) = 196884 := by
  rw [contract_defeq, stack_defeq]
  exact Mirror.JFixedPoint.stack_converges n

example : _root_.JFixedPoint.«fixed-0» = facade_stack_converges 0 := rfl
example : _root_.JFixedPoint.«fixed-1» = facade_stack_converges 1 := rfl
example : _root_.JFixedPoint.«fixed-2» = facade_stack_converges 2 := rfl
example : _root_.JFixedPoint.«fixed-100» = facade_stack_converges 100 := rfl

