namespace Epistemic

open Wikidata Wikidata.Sparql

/-- An imported query answer. -/
structure QueryCertificate where
  kb : KB
  query : Query
  binding : Binding
  sourceMatched : Bool
  references : List String

namespace QueryCertificate

/-- Is the reported binding really an answer to the query over this base? -/
def accepted (cert : QueryCertificate) : Bool :=
  decide (cert.binding ∈ eval cert.kb cert.query)

/-- Fail-closed evidence state. -/
def state (cert : QueryCertificate) : Trit := receiptState cert.sourceMatched cert.accepted

theorem state_eq_supported_iff (cert : QueryCertificate) :
    cert.state = Trit.supported ↔
      cert.sourceMatched = true ∧ cert.binding ∈ eval cert.kb cert.query := by
  rw [state, receiptState_eq_supported_iff]
  exact and_congr_right fun _ => decide_eq_true_iff

/-- **Supported evidence is really an answer.** -/
theorem answer_of_supported {cert : QueryCertificate} (h : cert.state = Trit.supported) :
    cert.binding ∈ eval cert.kb cert.query :=
  ((state_eq_supported_iff cert).1 h).2

/-- **Fail-closed import**: a query that does not return the reported binding leaves
the state `unresolved`, never a refutation. -/
theorem state_ne_contradicted (cert : QueryCertificate) : cert.state ≠ Trit.contradicted :=
  receiptState_ne_contradicted _ _

theorem state_of_checker_failure {cert : QueryCertificate} (h : cert.accepted = false) :
    cert.state = Trit.unresolved := by
  rw [state, h, receiptState_of_checker_failure]

end QueryCertificate

/-- **An answer to a positive query is stable under growth.**  Support obtained
from one base is support over any larger base, so it may be imported as such. -/
theorem positive_support_is_stable {kb₁ kb₂ : KB} {q : Query} {b : Binding}
    {refs : List String} (hsub : kb₁.statements ⊆ kb₂.statements) (hnormal : AllNormal kb₂)
    (hpos : Positive q)
    (h : (⟨kb₁, q, b, true, refs⟩ : QueryCertificate).state = Trit.supported) :
    (⟨kb₂, q, b, true, refs⟩ : QueryCertificate).state = Trit.supported := by
  rw [QueryCertificate.state_eq_supported_iff] at h ⊢
  exact ⟨rfl, eval_mono hsub hnormal hpos h.2⟩

/-- **An answer produced by negation as failure is not stable.**  The `!bound`
query is supported over the smaller base and unresolved over the larger one, so
such an answer records an absence in the base that was queried and nothing more. -/
theorem negation_as_failure_support_is_not_stable :
    (⟨smallKB, negQuery, [("x", (⟨1⟩ : Qid))], true, ["query service"]⟩ :
        QueryCertificate).state = Trit.supported ∧
      (⟨bigKB, negQuery, [("x", (⟨1⟩ : Qid))], true, ["query service"]⟩ :
        QueryCertificate).state = Trit.unresolved := by
  refine ⟨?_, QueryCertificate.state_of_checker_failure (by decide)⟩
  rw [QueryCertificate.state_eq_supported_iff]
  exact ⟨rfl, by decide⟩

end Epistemic
