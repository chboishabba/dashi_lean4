namespace Epistemic.Governed

open Epistemic Epistemic.Authority

/-! ## The carrier -/

/-- Whether the technical proof obligations attached to a claim are discharged. -/
inductive ObligationStatus
  | open
  | discharged
  deriving DecidableEq, Repr, Inhabited

/-- A claim under governance: its evidence, its obligation status, and the
mandate whose gate controls its promotion. -/
structure GovernedClaim where
  evidence : SupportSquare
  obligations : ObligationStatus
  mandate : Mandate
  deriving DecidableEq, Repr, Inhabited

/-- Promotion reads the authority gate, and nothing else. -/
def promoted (h : List AuthEvent) (s : GovernedClaim) : Bool :=
  currentAuthority h s.mandate

/-- **Promotion is a function of the gate alone.** -/
theorem promoted_eq_of_mandate_eq (h : List AuthEvent) {s t : GovernedClaim}
    (hm : s.mandate = t.mandate) : promoted h s = promoted h t := by
  simp [promoted, hm]

/-! ## The three coordinates do not determine one another -/

/-- The mandate used by the witnesses below. -/
def m0 : Mandate := ⟨0, 0⟩

/-- A supported claim whose obligations are still open. -/
def supportedOpen : GovernedClaim := ⟨⟨true, false⟩, ObligationStatus.open, m0⟩

/-- The same evidence with the obligations discharged. -/
def supportedDischarged : GovernedClaim := ⟨⟨true, false⟩, ObligationStatus.discharged, m0⟩

/-- A claim with evidence on both sides and discharged obligations. -/
def conflictDischarged : GovernedClaim := ⟨⟨true, true⟩, ObligationStatus.discharged, m0⟩

/-- **Support does not discharge obligations.**  No function of the evidence
computes the obligation status. -/
theorem no_obligations_from_evidence (g : SupportSquare → ObligationStatus) :
    ¬ ∀ s : GovernedClaim, s.obligations = g s.evidence := by
  intro h
  have h1 := h supportedOpen
  have h2 := h supportedDischarged
  simp only [supportedOpen, supportedDischarged] at h1 h2
  rw [← h1] at h2
  exact absurd h2 (by decide)

/-- The history in which the principal has granted the mandate. -/
def granted : List AuthEvent := [AuthEvent.grant Issuer.principal m0]

theorem currentAuthority_granted : currentAuthority granted m0 = true := by decide

theorem currentAuthority_nil_m0 : currentAuthority [] m0 = false := rfl

/-- **Evidence does not open the gate.**  No function of the evidence computes
promotion, because promotion moves with the mandate history while the evidence
stays fixed. -/
theorem no_promotion_from_evidence (g : SupportSquare → Bool) :
    ¬ ∀ (h : List AuthEvent) (s : GovernedClaim), promoted h s = g s.evidence := by
  intro h
  have h1 := h [] supportedDischarged
  have h2 := h granted supportedDischarged
  rw [← h1] at h2
  simp [promoted, supportedDischarged, currentAuthority_granted] at h2

/-- **Discharging obligations does not open the gate either.** -/
theorem no_promotion_from_obligations (g : ObligationStatus → Bool) :
    ¬ ∀ (h : List AuthEvent) (s : GovernedClaim), promoted h s = g s.obligations := by
  intro h
  have h1 := h [] supportedDischarged
  have h2 := h granted supportedDischarged
  rw [← h1] at h2
  simp [promoted, supportedDischarged, currentAuthority_granted] at h2

/-! ## A closed gate stays closed -/

/-- **A supported claim with every obligation discharged cannot bypass a closed
gate.**  The conclusion records all three coordinates at once: the evidence sits
in the affirmation corner, the obligations are discharged, and the claim is
still not promoted, because promotion reads the gate and nothing else. -/
theorem support_and_discharge_cannot_open_closed_gate (h : List AuthEvent)
    (s : GovernedClaim) (hclosed : currentAuthority h s.mandate = false)
    (hsupport : s.evidence = ⟨true, false⟩)
    (hdischarged : s.obligations = ObligationStatus.discharged) :
    classify s.evidence = Corner.positionOnly ∧
      s.obligations = ObligationStatus.discharged ∧ promoted h s = false :=
  ⟨by rw [hsupport]; rfl, hdischarged, hclosed⟩

/-- Neither can a conflicted one, and for the same reason: the gate does not read
the evidence. -/
theorem conflict_cannot_open_closed_gate (h : List AuthEvent)
    (hclosed : currentAuthority h m0 = false) : promoted h conflictDischarged = false :=
  hclosed

/-- Revocation closes the gate again, whatever the evidence and obligations
say. -/
theorem revocation_closes_gate (h : List AuthEvent) (s : GovernedClaim) :
    promoted (h ++ [AuthEvent.revoke s.mandate]) s = false :=
  currentAuthority_append_revoke h s.mandate

/-- **The converse warning.**  A granted mandate promotes a claim with open
obligations and no supporting evidence at all: authority is a genuinely separate
coordinate, and must be recorded rather than inferred from evidence. -/
theorem authority_alone_promotes :
    promoted granted ⟨⟨false, false⟩, ObligationStatus.open, m0⟩ = true := by decide

/-- Supporters cannot promote their own claims: only a principal's grant moves
the gate. -/
theorem supporter_grant_does_not_promote (s : GovernedClaim) :
    promoted [AuthEvent.grant Issuer.supporter s.mandate] s = false := by
  simp [promoted, currentAuthority, Authority.step]

end Epistemic.Governed
