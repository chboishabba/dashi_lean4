-- propagator value, the pointwise floored quotient bound and its consumer
-- forms, the weighted far-region density bound, and the numerical comparison
-- with the split-parameter optimisation.
singleAxisFloorLevel : ProofLevel
singleAxisFloorLevel = machineChecked

flooredQuotientLevel : ProofLevel
flooredQuotientLevel = machineChecked

farRegionFourOrbitLevel : ProofLevel
farRegionFourOrbitLevel = machineChecked

-- STILL OPEN: that off the near box some coordinate really does satisfy the
-- single-axis sine bound, and the numerator sup of the literal joint
-- numerator on that region.
farRegionAxisSineBoundLevel : ProofLevel
farRegionAxisSineBoundLevel = conditional

-- Machine checked: the far window at the optimal radius lies inside the
-- window on which the repository's constructive outer sine gap is proved.
farWindowCompatibilityLevel : ProofLevel
farWindowCompatibilityLevel = machineChecked

farRegionNumeratorSupLevel : ProofLevel
farRegionNumeratorSupLevel = conditional
