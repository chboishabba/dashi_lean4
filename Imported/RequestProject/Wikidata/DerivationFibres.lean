namespace Wikidata.Fibres

/-! ## Base claims -/

/-- Where in a statement the claim sits. -/
inductive StatementRole
  | mainValue
  | qualifier
  | reference
  | candidateLink
  deriving DecidableEq, Repr, Inhabited

/-- What kind of claim the base point is. -/
inductive ClaimKind
  | wikidataStatement
  | weakCarrierLink
  | external (name : String)
  deriving DecidableEq, Repr, Inhabited

/-- The base point of a fibre: a surface claim, together with the statement
context that fixes which validation rules are in scope at all. -/
structure ClaimBase where
  claimId : String
  surface : String
  kind : ClaimKind
  role : StatementRole
  graphSnapshot : String
  deriving DecidableEq, Repr, Inhabited

/-! ## Ontology axes and domain pressure -/

/-- A structured direction of derivation.  Axes are not base points: they select
subfibres of the derivations over one fixed claim. -/
inductive OntologyAxis
  | bibliographic
  | legal
  | biological
  | eventOccurrent
  | continuantOccurrent
  | abstractConcrete
  | individualCollective
  | external (name : String)
  deriving DecidableEq, Repr, Inhabited

/-- How strongly a domain requires an axis at a given statement role. -/
inductive AxisRequirement
  | required
  | optional
  | inapplicable
  deriving DecidableEq, Repr, Inhabited

/-- The modelling domain applying the pressure. -/
inductive Domain
  | bibliographic
  | causalModeling
  | legal
  | biological
  | generic
  | external (name : String)
  deriving DecidableEq, Repr, Inhabited

/-- A domain's demand that a claim in a given role be derivable along a given
axis. -/
structure DomainPressure where
  domain : Domain
  axis : OntologyAxis
  role : StatementRole
  requirement : AxisRequirement
  reason : String
  deriving DecidableEq, Repr, Inhabited

/-- Causal modelling requires an event/occurrent path for a main value. -/
def causalEffectOccurrentPressure : DomainPressure :=
  { domain := Domain.causalModeling
    axis := OntologyAxis.eventOccurrent
    role := StatementRole.mainValue
    requirement := AxisRequirement.required
    reason := "A causal effect main value requires an event/occurrent derivation path." }

/-- The same rule is out of scope on a qualifier. -/
def causalQualifierOccurrentPressure : DomainPressure :=
  { domain := Domain.causalModeling
    axis := OntologyAxis.eventOccurrent
    role := StatementRole.qualifier
    requirement := AxisRequirement.inapplicable
    reason := "This validation rule is scoped to a main value rather than qualifier use." }

/-! ## Derivations over a base claim -/

/-- Which way a derivation argues. -/
inductive Polarity
  | supporting
  | contradicting
  | unresolved
  deriving DecidableEq, Repr, Inhabited

/-- A derivation over a fixed base claim.  `axes` is the list of ontology axes
the derivation travels through, so one derivation can inhabit several
subfibres. -/
structure Derivation where
  derivationId : String
  polarity : Polarity
  axes : List OntologyAxis
  evidence : String
  provenance : String
  obligations : List String
  deriving DecidableEq, Repr, Inhabited

/-- The fibre over a base claim: the derivations recorded for it. -/
abbrev Fibre := List Derivation

/-- The subfibre selected by an axis. -/
def subfibre (a : OntologyAxis) (f : Fibre) : Fibre :=
  f.filter (fun d => decide (a ∈ d.axes))

@[simp] theorem mem_subfibre_iff (a : OntologyAxis) (f : Fibre) (d : Derivation) :
    d ∈ subfibre a f ↔ d ∈ f ∧ a ∈ d.axes := by
  simp [subfibre, List.mem_filter]

/-- Subfibres overlap: a derivation listing two axes lies in both. -/
theorem mem_subfibre_of_two_axes {a b : OntologyAxis} {f : Fibre} {d : Derivation}
    (hd : d ∈ f) (ha : a ∈ d.axes) (hb : b ∈ d.axes) :
    d ∈ subfibre a f ∧ d ∈ subfibre b f :=
  ⟨(mem_subfibre_iff a f d).2 ⟨hd, ha⟩, (mem_subfibre_iff b f d).2 ⟨hd, hb⟩⟩

/-- Is there a supporting derivation? -/
def hasSupport (f : Fibre) : Bool :=
  f.any (fun d => decide (d.polarity = Polarity.supporting))

/-- Is there a contradicting derivation? -/
def hasContradiction (f : Fibre) : Bool :=
  f.any (fun d => decide (d.polarity = Polarity.contradicting))

@[simp] theorem hasSupport_iff (f : Fibre) :
    hasSupport f = true ↔ ∃ d ∈ f, d.polarity = Polarity.supporting := by
  simp [hasSupport]

@[simp] theorem hasContradiction_iff (f : Fibre) :
    hasContradiction f = true ↔ ∃ d ∈ f, d.polarity = Polarity.contradicting := by
  simp [hasContradiction]

/-- Evidence only accumulates: a larger fibre has at least as much support. -/
theorem hasSupport_mono {f g : Fibre} (h : ∀ d ∈ f, d ∈ g) (hf : hasSupport f = true) :
    hasSupport g = true := by
  obtain ⟨d, hd, hp⟩ := (hasSupport_iff f).1 hf
  exact (hasSupport_iff g).2 ⟨d, h d hd, hp⟩

theorem hasContradiction_mono {f g : Fibre} (h : ∀ d ∈ f, d ∈ g)
    (hf : hasContradiction f = true) : hasContradiction g = true := by
  obtain ⟨d, hd, hp⟩ := (hasContradiction_iff f).1 hf
  exact (hasContradiction_iff g).2 ⟨d, h d hd, hp⟩

/-! ## Validation outcomes -/

/-- The four corners of a fibre. -/
inductive FibreOutcome
  | satisfied
  | violated
  | both
  | undetermined
  deriving DecidableEq, Repr, Inhabited

/-- A validation verdict: either a fibre shape, or a statement that the rule was
out of scope in the first place. -/
inductive ValidationOutcome
  | fibreShape (o : FibreOutcome)
  | inapplicable (reason : String)
  deriving DecidableEq, Repr, Inhabited

/-- The corner determined by the presence of support and of contradiction. -/
def fibreOutcomeFromPresence : Bool → Bool → FibreOutcome
  | true, false => FibreOutcome.satisfied
  | false, true => FibreOutcome.violated
  | true, true => FibreOutcome.both
  | false, false => FibreOutcome.undetermined

/-- The corner an axis subfibre lands in. -/
def outcomeOn (a : OntologyAxis) (f : Fibre) : FibreOutcome :=
  fibreOutcomeFromPresence (hasSupport (subfibre a f)) (hasContradiction (subfibre a f))

/-- Validation of a domain pressure against a fibre.  An inapplicable
requirement never produces an evidential verdict. -/
def validate (r : AxisRequirement) (a : OntologyAxis) (f : Fibre) : ValidationOutcome :=
  match r with
  | AxisRequirement.inapplicable =>
      ValidationOutcome.inapplicable "The rule does not apply in this statement role or scope."
  | AxisRequirement.required => ValidationOutcome.fibreShape (outcomeOn a f)
  | AxisRequirement.optional => ValidationOutcome.fibreShape (outcomeOn a f)

/-! ### The corners, characterised -/

theorem outcomeOn_eq_satisfied_iff (a : OntologyAxis) (f : Fibre) :
    outcomeOn a f = FibreOutcome.satisfied ↔
      hasSupport (subfibre a f) = true ∧ hasContradiction (subfibre a f) = false := by
  unfold outcomeOn
  cases hs : hasSupport (subfibre a f) <;> cases hc : hasContradiction (subfibre a f) <;>
    simp [fibreOutcomeFromPresence]

theorem outcomeOn_eq_violated_iff (a : OntologyAxis) (f : Fibre) :
    outcomeOn a f = FibreOutcome.violated ↔
      hasSupport (subfibre a f) = false ∧ hasContradiction (subfibre a f) = true := by
  unfold outcomeOn
  cases hs : hasSupport (subfibre a f) <;> cases hc : hasContradiction (subfibre a f) <;>
    simp [fibreOutcomeFromPresence]

theorem outcomeOn_eq_both_iff (a : OntologyAxis) (f : Fibre) :
    outcomeOn a f = FibreOutcome.both ↔
      hasSupport (subfibre a f) = true ∧ hasContradiction (subfibre a f) = true := by
  unfold outcomeOn
  cases hs : hasSupport (subfibre a f) <;> cases hc : hasContradiction (subfibre a f) <;>
    simp [fibreOutcomeFromPresence]

theorem outcomeOn_eq_undetermined_iff (a : OntologyAxis) (f : Fibre) :
    outcomeOn a f = FibreOutcome.undetermined ↔
      hasSupport (subfibre a f) = false ∧ hasContradiction (subfibre a f) = false := by
  unfold outcomeOn
  cases hs : hasSupport (subfibre a f) <;> cases hc : hasContradiction (subfibre a f) <;>
    simp [fibreOutcomeFromPresence]

/-! ### Non-collapse receipts -/

/-- **Absence is not refutation.**  A required axis with no derivation at all is
undetermined, not violated. -/
theorem missing_subfibre_is_undetermined (a : OntologyAxis) (f : Fibre)
    (h : subfibre a f = []) :
    validate AxisRequirement.required a f =
      ValidationOutcome.fibreShape FibreOutcome.undetermined := by
  simp [validate, outcomeOn, hasSupport, hasContradiction, h, fibreOutcomeFromPresence]

/-- More generally: without a contradicting derivation on the axis, the outcome
is never a violation, however empty the subfibre is. -/
theorem outcomeOn_ne_violated_of_no_contradiction (a : OntologyAxis) (f : Fibre)
    (h : hasContradiction (subfibre a f) = false) :
    outcomeOn a f ≠ FibreOutcome.violated := by
  intro hv
  exact absurd ((outcomeOn_eq_violated_iff a f).1 hv).2 (by simp [h])

/-- A contradiction with no support is a violation. -/
theorem contradiction_without_support_is_violation (a : OntologyAxis) (f : Fibre)
    (hs : hasSupport (subfibre a f) = false) (hc : hasContradiction (subfibre a f) = true) :
    validate AxisRequirement.required a f =
      ValidationOutcome.fibreShape FibreOutcome.violated := by
  simp [validate, (outcomeOn_eq_violated_iff a f).2 ⟨hs, hc⟩]

/-- Support and contradiction together stay `both`: the conflict is not
silently resolved in either direction. -/
theorem support_and_contradiction_remain_both (a : OntologyAxis) (f : Fibre)
    (hs : hasSupport (subfibre a f) = true) (hc : hasContradiction (subfibre a f) = true) :
    validate AxisRequirement.required a f =
      ValidationOutcome.fibreShape FibreOutcome.both := by
  simp [validate, (outcomeOn_eq_both_iff a f).2 ⟨hs, hc⟩]

/-- **A scope gate is not evidence.**  An inapplicable requirement returns
`inapplicable` whatever the fibre contains. -/
theorem validate_inapplicable (a : OntologyAxis) (f : Fibre) :
    validate AxisRequirement.inapplicable a f =
      ValidationOutcome.inapplicable
        "The rule does not apply in this statement role or scope." := rfl

/-- In particular an out-of-scope rule is never a violation, even against a
fibre that is full of contradictions. -/
theorem validate_inapplicable_ne_violation (a : OntologyAxis) (f : Fibre) :
    validate AxisRequirement.inapplicable a f ≠
      ValidationOutcome.fibreShape FibreOutcome.violated := by
  simp [validate]

/-- Adding an unresolved derivation moves nothing. -/
theorem outcomeOn_cons_unresolved (a : OntologyAxis) (f : Fibre) (d : Derivation)
    (h : d.polarity = Polarity.unresolved) :
    outcomeOn a (d :: f) = outcomeOn a f := by
  by_cases hm : a ∈ d.axes <;>
    simp [outcomeOn, subfibre, List.filter, hm, hasSupport, hasContradiction, h]

/-! ### Collapsing to a three-valued state -/

/-- The three-valued reading of a fibre corner.  Both indeterminate corners —
nothing found and a genuine conflict — become `unresolved`. -/
def collapseOutcome : FibreOutcome → Epistemic.Trit
  | FibreOutcome.satisfied => Epistemic.Trit.supported
  | FibreOutcome.violated => Epistemic.Trit.contradicted
  | FibreOutcome.both => Epistemic.Trit.unresolved
  | FibreOutcome.undetermined => Epistemic.Trit.unresolved

/-- The collapse loses exactly the conflict/ignorance distinction. -/
theorem collapseOutcome_not_injective :
    FibreOutcome.both ≠ FibreOutcome.undetermined ∧
      collapseOutcome FibreOutcome.both = collapseOutcome FibreOutcome.undetermined :=
  ⟨by decide, rfl⟩

/-- Before the collapse the two indeterminate corners are distinguishable, and
neither of them is a violation. -/
theorem unresolved_corner_ne_violated :
    FibreOutcome.undetermined ≠ FibreOutcome.violated ∧
      FibreOutcome.both ≠ FibreOutcome.violated := ⟨by decide, by decide⟩

/-! ## Link strength gates transfer -/

/-- How strong an interwiki/ontology link is. -/
inductive LinkStrength
  | weakCarrier
  | candidateMatch
  | closeAlignment
  | exactAlignment
  | identityAlignment
  deriving DecidableEq, Repr, Inhabited

/-- May facts be transported across a link of this strength? -/
def factTransferPermitted : LinkStrength → Bool
  | LinkStrength.exactAlignment => true
  | LinkStrength.identityAlignment => true
  | _ => false

/-- May identity be transported across a link of this strength? -/
def identityTransferPermitted : LinkStrength → Bool
  | LinkStrength.identityAlignment => true
  | _ => false

/-- A weak carrier edge entails neither identity nor facts. -/
theorem weakCarrier_transfers_nothing :
    identityTransferPermitted LinkStrength.weakCarrier = false ∧
      factTransferPermitted LinkStrength.weakCarrier = false := ⟨rfl, rfl⟩

/-- Identity transfer is strictly stronger than fact transfer. -/
theorem identity_transfer_implies_fact_transfer (s : LinkStrength) :
    identityTransferPermitted s = true → factTransferPermitted s = true := by
  cases s <;> simp [identityTransferPermitted, factTransferPermitted]

/-- …and strictly so: an exact alignment carries facts but not identity. -/
theorem fact_transfer_not_identity_transfer :
    factTransferPermitted LinkStrength.exactAlignment = true ∧
      identityTransferPermitted LinkStrength.exactAlignment = false := ⟨rfl, rfl⟩

/-- A candidate link is a carrier, not a claim: no transfer of either kind. -/
theorem candidateMatch_transfers_nothing :
    identityTransferPermitted LinkStrength.candidateMatch = false ∧
      factTransferPermitted LinkStrength.candidateMatch = false := ⟨rfl, rfl⟩

end Wikidata.Fibres
