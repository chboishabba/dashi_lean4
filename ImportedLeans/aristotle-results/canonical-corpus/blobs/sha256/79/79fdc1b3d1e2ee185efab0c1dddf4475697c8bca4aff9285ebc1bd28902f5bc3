      actionTermSector t ≡ transferSector

record TransferMatrixTerm (t : ActionTerm) : Set where
  constructor transferMatrixTerm
  field
    transferMatrixSector :
      actionTermSector t ≡ transferSector

record ResidualActionTerm (t : ActionTerm) : Set where
