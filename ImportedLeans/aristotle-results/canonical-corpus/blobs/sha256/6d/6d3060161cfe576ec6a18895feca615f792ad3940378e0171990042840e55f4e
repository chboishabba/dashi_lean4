      familyToPoint (pointToFamily x)
      ≡
      x

    familyRoundtrip :
      (x : CompatibleFamilySurface) →
      pointToFamily (familyToPoint x)
      ≡
      x

open B01CompatibleFamilyRoundtripSurface public

canonicalB01CompatibleFamilyRoundtripSurface :
