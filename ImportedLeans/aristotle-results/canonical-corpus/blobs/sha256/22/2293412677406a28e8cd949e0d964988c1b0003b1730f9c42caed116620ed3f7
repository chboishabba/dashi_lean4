open Lean Elab Command

namespace AgdaFront
namespace Verbatim

/-! ## Small string utilities -/

/-- Characters that cannot occur in a Lean identifier and do occur in Agda ones. -/
def badIdentChars : List Char :=
  ['-', '?', '/', '\\', '+', '*', '&', '|', '^', '<', '>', '=', '~', '!', '@', '#', '$', '%']

/-- A placeholder for `=>`, used while rewriting arrows character by character. -/
private def lamMark : Char := '\u0001'

/-- Indentation of a line. -/
def indentOf (s : String) : Nat := (s.toList.takeWhile (· == ' ')).length

/-- Leading and trailing whitespace removed. -/
def trimStr (s : String) : String := s.trimAscii.toString

/-- Is this line blank or a comment? -/
def isCommentLine (s : String) : Bool :=
  let t := trimStr s
  t == "" || t.startsWith "--" || t.startsWith "/-" || t.startsWith "-/"

/-- Whitespace-separated tokens of a line. -/
def words (s : String) : List String :=
  ((s.replace "\t" " ").splitOn " ").filter (· != "")

/-- Split at the first occurrence of `sep`, if there is one. -/
def splitFirst (s sep : String) : Option (String × String) :=
  match s.splitOn sep with
  | [] => none
  | [_] => none
  | h :: rest => some (h, sep.intercalate rest)

/-- Does `s` contain `sub`? -/
def containsSub (s sub : String) : Bool := (s.splitOn sub).length > 1

/-- The number of `(` minus the number of `)` in a line. -/
def parenBalance (s : String) : Int :=
  s.toList.foldl (fun n c => if c == '(' then n + 1 else if c == ')' then n - 1 else n) 0

/-- Bracket depth contributed by a token. -/
def depthOf (s : String) : Int :=
  s.toList.foldl (fun n c =>
    if c == '(' || c == '{' || c == '[' || c == '⟨' then n + 1
    else if c == ')' || c == '}' || c == ']' || c == '⟩' then n - 1
    else n) 0

/-- The position of the first bracket-depth-zero occurrence of `tok`. -/
def findTopToken (ts : List String) (tok : String) : Option Nat := Id.run do
  let mut d : Int := 0
  let mut i := 0
  for t in ts do
    if d == 0 && t == tok then return some i
    d := d + depthOf t
    i := i + 1
  return none

/-- Split a token list at its bracket-depth-zero occurrences of `tok`. -/
def splitTopToken (ts : List String) (tok : String) : List (List String) := Id.run do
  let mut d : Int := 0
  let mut cur : List String := []
  let mut out : List (List String) := []
  for t in ts do
    if d == 0 && t == tok then
      out := cur.reverse :: out
      cur := []
    else
      cur := t :: cur
      d := d + depthOf t
  return (cur.reverse :: out).reverse

/-! ## Rewriting Agda's binder arrows -/

/-- Rewrite the binder arrows of a module: the first bracket-depth-zero `→`
after `∀`/`Π` becomes `,`, and after `λ` becomes `=>`.

The loop is iterative rather than recursive because upstream modules are long
enough that a per-character recursion overflows the stack. -/
partial def rewriteArrowsArray (a : Array Char) : Array Char := Id.run do
  let mut out := a
  let mut i := 0
  while i < out.size do
    let c := out[i]!
    if c == '∀' || c == 'Π' || c == 'λ' then
      let rep := if c == 'λ' then lamMark else ','
      let mut depth := 0
      let mut j := i + 1
      while j < out.size do
        let d := out[j]!
        if d == '(' || d == '[' || d == '{' then
          depth := depth + 1
        else if d == ')' || d == ']' || d == '}' then
          if depth == 0 then break else depth := depth - 1
        else if d == '→' && depth == 0 then
          out := out.set! j rep
          break
        else if (d == '∀' || d == 'λ' || d == 'Π') && depth == 0 then
          break
        j := j + 1
    i := i + 1
  return out

/-- Rewrite Agda's binder arrows to Lean's binder separators. -/
def rewriteBinderArrows (s : String) : String :=
  (String.ofList (rewriteArrowsArray s.toList.toArray).toList).replace
    (String.ofList [lamMark]) "=>"

/-! ## Names -/

/-- Is this name a mixfix operator, `_⊕_`? -/
def isMixfixName (n : String) : Bool :=
  n.toList.length > 2 && n.startsWith "_" && n.endsWith "_"

/-- Is this name a *binary* mixfix operator, `_⊕_` with no further holes? -/
def isBinaryMixfix (n : String) : Bool :=
  isMixfixName n && !((n.toList.drop 1).dropLast.contains '_')

/-- The symbol of a binary mixfix operator. -/
def mixfixSymbol (n : String) : String := String.ofList (n.toList.drop 1).dropLast

/-- Agda names that are Lean keywords, and so cannot be written bare even though
every character in them is legal in an identifier. -/
def leanKeywords : List String :=
  ["local", "private", "protected", "partial", "unsafe", "noncomputable", "mutual",
   "where", "with", "fun", "let", "have", "show", "from", "do", "by", "at", "in",
   "then", "else", "match", "deriving", "open", "end", "section", "namespace",
   "variable", "universe", "instance", "class", "structure", "inductive", "theorem",
   "example", "macro", "notation", "attribute", "set_option", "import", "export",
   "abbrev", "axiom", "calc", "this"]

/-- Characters Lean is certain to accept inside a bare identifier. -/
def plainIdentChar (c : Char) : Bool := c.isAlphanum || c == '_' || c == '\''

/-- Does this Agda name need to be quoted to be a Lean identifier?

Anything that is not a plain ASCII identifier is quoted.  Quoting is the
identity on names — `«x»` and `x` are the same Lean name — so quoting more than
is strictly necessary is harmless, whereas quoting less is not: a name such as
`zero≤` or `x∸y` would otherwise be split into several tokens by Lean's
lexer. -/
def needsQuoting (n : String) : Bool :=
  isMixfixName n || n.toList.any (badIdentChars.contains ·) || leanKeywords.contains n ||
    !n.toList.all plainIdentChar

/-- Quote an Agda name so that Lean can spell it. -/
def quoteName (n : String) : String := "«" ++ n ++ "»"

/-- Undo `quoteName`. -/
def unquoteName (n : String) : String :=
  if n.startsWith "«" && n.endsWith "»" then String.ofList (n.toList.drop 1).dropLast else n

/-- Split a line into tokens and the delimiters between them, so that the pieces
concatenate back to the line. -/
def splitKeep (s : String) : List String :=
  let rec go (cs : List Char) (cur : List Char) (acc : List String) : List String :=
    match cs with
    | [] => ((if cur.isEmpty then acc else String.ofList cur.reverse :: acc)).reverse
    | c :: rest =>
        if c == ' ' || c == '\t' || c == '(' || c == ')' || c == '{' || c == '}'
            || c == '[' || c == ']' || c == ',' || c == ';' then
          let acc := if cur.isEmpty then acc else String.ofList cur.reverse :: acc
          go rest [] (String.ofList [c] :: acc)
        else go rest (c :: cur) acc
  go s.toList [] []

/-- Does this token spell a name that Lean would lex as several tokens?

An Agda name may mix letters with symbols — `nat≟`, `zero≤`, `to-nat` — and it
may come from anywhere, not only from this module's own declarations, so it
cannot be caught by looking at what the module declares.  A token counts as such
a name when it has at least one ASCII letter or digit and at least one character
that is not legal in a bare Lean identifier.  A token made only of symbols
(`≡`, `∷`, `→`) is notation, and is left alone. -/
def isExoticName (t : String) : Bool :=
  let cs := t.toList
  match cs with
  | [] => false
  | c₀ :: _ =>
      cs.any (fun c => c.isAlpha || c.isDigit) &&
        -- a character Lean will not take, or a name that begins with a digit,
        -- such as the field `0s`, which Lean lexes as a numeral and a name
        (!cs.all plainIdentChar ||
          (c₀.isDigit && cs.any (fun c => c.isAlpha || c == '_'))) &&
        !cs.any (fun c => c == '"' || c == '«' || c == '»')

/-- Quote the components of a possibly qualified name that Lean cannot lex. -/
def quoteExotic (t : String) : String :=
  if t.toList.any (fun c => c == '"' || c == '«' || c == '»') then t
  else if containsSub t "." then
    ".".intercalate ((t.splitOn ".").map fun c => if isExoticName c then quoteName c else c)
  else if isExoticName t then quoteName t
  else t

/-- Quote every token of a line that Lean would otherwise lex as several
tokens. -/
def quoteExoticTokens (l : String) : String :=
  if isCommentLine l then l else String.join ((splitKeep l).map quoteExotic)

/-- Expand an operator *section*.

Agda lets a binary operator stand on its own as a function, written with its
holes: `max = _⊔_`.  Lean reads each underscore as a placeholder to be inferred,
which is a different term, so the section is expanded into the lambda it
abbreviates.  Only operators the module does not itself declare reach this
point — its own are already quoted into single identifiers. -/
def expandOperatorSections (l : String) : String :=
  if isCommentLine l then l
  else String.join <| (splitKeep l).map fun t =>
    if isBinaryMixfix t then
      s!"(fun agdaSectionL agdaSectionR => agdaSectionL {mixfixSymbol t} agdaSectionR)"
    else t

/-- Apply a renaming, and an expansion of `import M as A` aliases, to the
identifier tokens of a line. -/
def renameTokens (ren aliases : List (String × String)) (l : String) : String :=
  if ren.isEmpty && aliases.isEmpty then l
  else
    String.join <| (splitKeep l).map fun t =>
      match ren.lookup t with
      | some r => r
      | none =>
          match aliases.find? (fun (a, _) => t.startsWith (a ++ ".")) with
          | some (a, target) => target ++ "." ++ t.drop (a.length + 1)
          | none => t

/-! ## Universe levels

Agda writes universe polymorphism with a term-level `Level`: `∀ {a : Level}
{A : Set a} → …`.  Lean's levels are not terms, so a `{a : Level}` binder is
deleted and `Set a` becomes `Type a`, whose free level name Lean binds
automatically.  The declaration Lean checks is therefore the universe-polymorphic
one, with the level quantified by Lean instead of by Agda. -/

/-- Remove `{a b : Level}` binder groups from a line, returning the names. -/
def stripLevelBinders (line : String) : String × List String := Id.run do
  let cs := line.toList.toArray
  let mut out : Array Char := #[]
  let mut lvls : List String := []
  let mut i := 0
  while i < cs.size do
    let c := cs[i]!
    if c == '{' then
      -- scan to the matching '}'
      let mut j := i + 1
      let mut depth := 0
      while j < cs.size do
        let d := cs[j]!
        if d == '{' then depth := depth + 1
        else if d == '}' then
          if depth == 0 then break else depth := depth - 1
        j := j + 1
      if j < cs.size then
        let inner := trimStr (String.ofList (cs.extract (i + 1) j).toList)
        match splitFirst inner ":" with
        | some (names, ty) =>
            if trimStr ty == "Level" then
              lvls := lvls ++ words names
              i := j + 1
              -- also swallow one following space
              if i < cs.size && cs[i]! == ' ' then i := i + 1
              continue
        | none => pure ()
      out := out.push c
      i := i + 1
    else
      out := out.push c
      i := i + 1
  return (String.ofList out.toList, lvls)

/-- Tokens that cannot begin the argument of `Set`, so that `data D : Set where`
is not read as `Set` applied to `where`. -/
private def notALevel : List String :=
  ["where", "→", "->", ",", "=", "=>", ":", ";", ")", "}", "]", "|", "≡", "(", "{"]

/-- Render an Agda level expression as a Lean universe expression.

A level that is one of the module's own level *variables* is kept, so the
declaration stays universe-polymorphic; `lsuc`/`suc` and `⊔` become Lean's `+1`
and `max`.  Anything else — in particular a level that Agda passes as an
ordinary argument, which Lean cannot do — is the lowest universe. -/
partial def levelExpr (univ : List String) (ts : List String) : Option String :=
  let ts := ts.filter (fun t => trimStr t != "")
  match ts with
  | [] => none
  | [t] => if univ.contains t then some t else some "0"
  | _ =>
      -- a redundant outer bracket
      if ts.head! == "(" && ts.getLast! == ")" &&
          (ts.dropLast.tail!).foldl (fun d t => d + depthOf t) 0 == 0 then
        levelExpr univ (ts.dropLast.tail!)
      else
        match splitTopToken ts "⊔" with
        | [] => none
        | [_] =>
            match ts with
            | f :: rest =>
                if f == "suc" || f == "lsuc" then
                  (levelExpr univ rest).map (fun e => s!"({e} + 1)")
                else none
            | [] => none
        | parts => do
            let es ← parts.mapM (levelExpr univ)
            match es with
            | [] => none
            | e :: rest => some (rest.foldl (fun a b => s!"(max {a} {b})") e)

/-- Rewrite each application of `Set` to a level into the Lean sort it means. -/
def rewriteSetLevels (lvls : List String) (line : String) : String := Id.run do
  let parts := (splitKeep line).toArray
  let mut out : Array String := #[]
  let mut i := 0
  while i < parts.size do
    let t := parts[i]!
    if t != "Set" then
      out := out.push t
      i := i + 1
      continue
    -- the next non-space piece
    let mut j := i + 1
    while j < parts.size && trimStr parts[j]! == "" do
      j := j + 1
    if j >= parts.size || notALevel.contains parts[j]! then
      -- `Set` with no level argument at all
      if j < parts.size && parts[j]! == "(" then
        -- a bracketed level expression: find the matching bracket
        let mut k := j + 1
        let mut d := 1
        while k < parts.size && d > 0 do
          d := d + depthOf parts[k]!
          k := k + 1
        match levelExpr lvls ((parts.extract j k).toList) with
        | some e =>
            out := out.push ("Type " ++ e)
            i := k
        | none =>
            out := out.push t
            i := i + 1
      else
        out := out.push t
        i := i + 1
    else
      match levelExpr lvls [parts[j]!] with
      | some e =>
          out := out.push ("Type " ++ e)
          i := j + 1
      | none =>
          out := out.push t
          i := i + 1
  return String.join out.toList

/-- Delete a `∀` whose binders were all universe levels. -/
def dropEmptyForall (line : String) : String := Id.run do
  let mut l := line
  while containsSub l "∀  " do
    l := l.replace "∀  " "∀ "
  return (l.replace "∀ ," "").replace "∀," ""

/-- The names declared at the top level of a module body, together with the
constructor and field names of its `data`/`record` blocks. -/
def collectNames (body : List String) : List String := Id.run do
  let mut names : List String := []
  for line in body do
    if isCommentLine line then continue
    let toks := words line
    match toks with
    | [] => continue
    | hd :: _ =>
      if indentOf line == 0 then
        if (hd == "data" || hd == "record") && toks.length > 1 then
          names := toks[1]! :: names
        else if toks.contains ":" &&
            !["open", "import", "module", "infix", "infixl", "infixr"].contains hd then
          names := toks.take (toks.idxOf ":") ++ names
      else
        if toks.contains ":" then
          names := ((toks.take (toks.idxOf ":")).filter
            (fun t => t != "constructor" && t != "field")) ++ names
        else if toks.length == 2 && hd == "constructor" then
          names := toks[1]! :: names
  -- a declaration's binders and Agda's own syntax get caught by the scan above
  -- (`f : ∀ {n} , (x : A) → B` contributes `∀` and `(x`), and must not be taken
  -- for names of the module
  let isName (t : String) : Bool :=
    t != "" && t != "_" && !("∀λΠ→,;(){}⟨⟩".toList.any (t.toList.contains ·))
  return (names.filter isName).eraseDups

/-! ## `private` and `abstract` blocks

Agda's `private` and `abstract` blocks are scope and reduction annotations on an
indented group of declarations.  Neither changes what the declarations *say*, so
the group is flattened back to the top level; the Lean names are then public,
which is recorded here rather than hidden. -/

/-- Flatten `private` / `abstract` blocks: drop the keyword line and dedent the
group it introduces back to the enclosing indentation. -/
partial def flattenPrivateBlocks (body : Array String) : Array String := Id.run do
  let mut out : Array String := #[]
  let mut i := 0
  while i < body.size do
    let line := body[i]!
    let t := trimStr line
    if t == "private" || t == "abstract" then
      let bi := indentOf line
      let mut j := i + 1
      -- the group: the following lines indented strictly more than the keyword
      let mut group : Array String := #[]
      while j < body.size do
        let nxt := body[j]!
        if trimStr nxt == "" then
          group := group.push nxt
          j := j + 1
          continue
        if indentOf nxt <= bi then break
        group := group.push nxt
        j := j + 1
      -- drop trailing blank lines back to the outer level
      let inner := group.filter (fun l => trimStr l != "")
      let dedent := inner.foldl (fun m l => min m (indentOf l)) 1000
      let shift := if dedent > bi then dedent - bi else 0
      for l in group do
        out := out.push (if trimStr l == "" then l else String.ofList (l.toList.drop shift))
      i := j
    else
      out := out.push line
      i := i + 1
  return out

/-! ## `where` blocks

Agda attaches auxiliary definitions to a clause with a `where` block.  Lean's
`where` cannot see the clause's pattern variables, so the block is rendered as a
`let`-chain at the head of the right-hand side: a nullary definition becomes
`let x := e`, and one with arguments becomes `let f := fun a b => e`, which is
what the Agda block means.  A block with several clauses for one name, or with
anything that is neither a signature nor a clause, is refused. -/
partial def hoistWhereBlocks (body : Array String) : Except String (Array String) := Id.run do
  let mut out : Array String := #[]
  let mut i := 0
  while i < body.size do
    let line := body[i]!
    if trimStr line != "where" || indentOf line == 0 then
      out := out.push line
      i := i + 1
      continue
    let wi := indentOf line
    -- collect the block
    let mut j := i + 1
    let mut block : Array String := #[]
    while j < body.size do
      let nxt := body[j]!
      if trimStr nxt == "" then
        let mut k := j
        while k < body.size && trimStr body[k]! == "" do
          k := k + 1
        if k < body.size && indentOf body[k]! >= wi then
          block := block ++ body.extract j k
          j := k
          continue
        break
      if indentOf nxt < wi then break
      block := block.push nxt
      j := j + 1
    -- parse the block: signatures, and the clauses of each name
    let base := (block.filter (fun l => trimStr l != "")).foldl
      (fun m l => min m (indentOf l)) 1000
    let mut types : List (String × String) := []
    let mut order : Array String := #[]
    let mut cls : Array (String × List String × String) := #[]
    let mut okblock := true
    for bl in block do
      let t := trimStr bl
      if t == "" || t.startsWith "--" then continue
      if indentOf bl > base && !cls.isEmpty then
        -- a continuation of the previous right-hand side
        let (nm, ps, rhs) := cls[cls.size - 1]!
        cls := cls.set! (cls.size - 1) (nm, ps, rhs ++ " " ++ t)
        continue
      let colonAt := (splitFirst t ":").map (fun (h, _) => h.toList.length)
      let eqAt := (splitFirst t "=").map (fun (h, _) => h.toList.length)
      let isSig : Bool :=
        match colonAt, eqAt with
        | some c, some e => c < e
        | some _, none => true
        | _, _ => false
      if isSig then
        match splitFirst t ":" with
        | some (lhs, rhs) =>
            if (words lhs).length == 1 then types := (trimStr lhs, trimStr rhs) :: types
            else okblock := false
        | none => okblock := false
      else
        match splitFirst t "=" with
        | some (lhs, rhs) =>
            match words lhs with
            | [] => okblock := false
            | nm :: args =>
                unless order.contains nm do order := order.push nm
                cls := cls.push (nm, args, trimStr rhs)
        | none => okblock := false
    -- one `let` per name defined in the block; a name with several clauses, or
    -- with a pattern where a variable could be, becomes a `match`, and one that
    -- calls itself becomes a `let rec`
    let mut lets : Array String := #[]
    for nm in order do
      let cs := (cls.filter (fun (n, _, _) => n == nm)).map (fun (_, ps, rhs) => (ps, rhs))
      let arity := (cs[0]!).1.length
      if cs.any (fun (ps, _) => ps.length != arity) then okblock := false
      if arity == 0 && cs.size != 1 then okblock := false
      let plain := cs.size == 1 && (cs[0]!).1.all (fun p => p.toList.all plainIdentChar)
      let value :=
        if arity == 0 then (cs[0]!).2
        else if plain then "fun " ++ " ".intercalate (cs[0]!).1 ++ " => " ++ (cs[0]!).2
        else
          let xs := (List.range arity).map (fun i => s!"whereArg✝{i}")
          let alts := cs.toList.map (fun (ps, rhs) =>
            " | " ++ ", ".intercalate ps ++ " => " ++ rhs)
          "fun " ++ " ".intercalate xs ++ " => match " ++ ", ".intercalate xs ++ " with"
            ++ String.join alts
      let kw := if cs.any (fun (_, rhs) => (words rhs).contains nm) then "let rec" else "let"
      match types.lookup nm with
      | some ty => lets := lets.push s!"{kw} {nm} : {ty} := {value}"
      | none => lets := lets.push s!"{kw} {nm} := {value}"
    if !okblock || lets.isEmpty then
      return .error "clause-level where block that is not a list of definitions"
    -- locate the clause: the last emitted non-comment line at indent 0
    let mut start : Option Nat := none
    let mut k := out.size
    while k > 0 do
      k := k - 1
      let l := out[k]!
      if indentOf l == 0 && trimStr l != "" && !(trimStr l).startsWith "--" then
        start := some k
        break
    match start with
    | none => return .error "clause-level where block with no clause to attach to"
    | some st =>
      match splitFirst out[st]! "=" with
      | none => return .error "clause-level where block with no clause to attach to"
      | some (head, rhs) =>
          let rest := out.extract (st + 1) out.size
          out := out.extract 0 st
          out := out.push (trimStr head ++ " =")
          for l in lets do
            out := out.push ("  " ++ l)
          if trimStr rhs != "" then
            out := out.push ("  " ++ trimStr rhs)
          for l in rest do
            out := out.push (if trimStr l == "" then l else "  " ++ l)
    i := j
  return .ok out

/-! ## `with`-abstraction

Agda's `with` adds a scrutinee to the left-hand side of a clause and continues
with one clause per case:

```
f p₁ … pₙ with e₁ | e₂
… | q₁ | q₂ = r
```

What that means is a case split on `e₁`, `e₂` inside the right-hand side, so the
clause is rendered as a Lean `match`:

```
f p₁ … pₙ =
  match e₁, e₂ with
  | q₁, q₂ => r
```

This is exactly Agda's meaning for the fragment the upstream corpus uses — one
`with` per clause, the continuation clauses written with `…`, and no further
refinement of the original patterns.  Anything else (a nested `with`, a
continuation clause that repeats the left-hand side and so may refine it, an
absurd `with`-clause, or a pattern count that does not match the scrutinees) is
refused with a message naming what it was, rather than guessed at. -/

/-- Groups of tokens separated by `|`, with the empty group a leading `|`
produces dropped. -/
private def barGroups (ts : List String) : List (List String) :=
  match splitTopToken ts "|" with
  | [] :: rest => rest
  | gs => gs

/-- Rewrite every `with`-abstraction of a module body into a `match` on the
right-hand side of the clause it belongs to. -/
partial def desugarWith (body : Array String) : Except String (Array String) := Id.run do
  let mut out : Array String := #[]
  let mut i := 0
  while i < body.size do
    let line := body[i]!
    if isCommentLine line || indentOf line != 0 then
      if (trimStr line).startsWith "..." then
        return .error "with-clause outside a with-abstraction"
      out := out.push line
      i := i + 1
      continue
    let ts := words line
    if (trimStr line).startsWith "..." then
      return .error "with-clause outside a with-abstraction"
    if let some r := findTopToken ts "rewrite" then
      -- `f p₁ … pₙ rewrite e₁ | e₂ = r` rewrites the goal by the equations and
      -- then gives `r`, which is Lean's `rw`.  `rw` closes a goal that becomes
      -- reflexivity, and Agda's does too, so the right-hand side is offered
      -- rather than forced: if it is still needed and does not fit, the goal is
      -- left open and Lean rejects the clause.
      let mut toks := ts
      i := i + 1
      while i < body.size && indentOf body[i]! > 0 && trimStr body[i]! != ""
          && !isCommentLine body[i]! do
        toks := toks ++ words (trimStr body[i]!)
        i := i + 1
      let lhs := toks.take r
      let rest := toks.drop (r + 1)
      match findTopToken rest "=" with
      | none => return .error "rewrite clause with no right-hand side"
      | some j =>
          let eqs := barGroups (rest.take j)
          let rhs := rest.drop (j + 1)
          if lhs.isEmpty || eqs.isEmpty || eqs.any (·.isEmpty) || rhs.isEmpty then
            return .error "malformed rewrite clause"
          out := out.push (" ".intercalate lhs ++ " = by")
          out := out.push ("  rw [" ++ ", ".intercalate (eqs.map (" ".intercalate ·)) ++ "]")
          out := out.push ("  try exact " ++ " ".intercalate rhs)
      continue
    match findTopToken ts "with" with
    | none =>
        out := out.push line
        i := i + 1
    | some k =>
        if k == 0 then
          return .error "with-abstraction with no left-hand side"
        let lhs := ts.take k
        let mut discrToks := ts.drop (k + 1)
        i := i + 1
        -- the scrutinee may continue on the following indented lines
        while i < body.size && indentOf body[i]! > 0 && trimStr body[i]! != ""
            && !(trimStr body[i]!).startsWith "..." && !isCommentLine body[i]! do
          discrToks := discrToks ++ words (trimStr body[i]!)
          i := i + 1
        if discrToks.isEmpty then
          return .error "with-abstraction with no scrutinee"
        let discrs := barGroups discrToks
        -- the continuation clauses
        let mut alts : Array (Array String) := #[]
        let mut stop := false
        while i < body.size && !stop do
          let l := body[i]!
          let t := trimStr l
          if t == "" || isCommentLine l then
            i := i + 1
          else if t.startsWith "..." then
            let ats := (words t).drop 1
            if (findTopToken ats "with").isSome then
              return .error "nested with-abstraction"
            match findTopToken ats "=" with
            | none => return .error "with-clause with no right-hand side"
            | some j =>
                let pats := barGroups (ats.take j)
                let rhs := ats.drop (j + 1)
                if pats.length != discrs.length then
                  return .error "with-clause whose patterns do not match the scrutinees"
                if pats.any (·.isEmpty) || rhs.isEmpty then
                  return .error "malformed with-clause"
                let pat := ", ".intercalate (pats.map (" ".intercalate ·))
                alts := alts.push #["  | " ++ pat ++ " => " ++ " ".intercalate rhs]
                i := i + 1
          else if indentOf l > 0 then
            if alts.isEmpty then
              return .error "with-abstraction whose scrutinee is followed by a stray line"
            let last := alts[alts.size - 1]!
            alts := alts.set! (alts.size - 1) (last.push ("      " ++ t))
            i := i + 1
          else
            stop := true
        if alts.isEmpty then
          return .error "with-abstraction with no clauses"
        out := out.push (" ".intercalate lhs ++ " =")
        out := out.push
          ("  match " ++ ", ".intercalate (discrs.map (" ".intercalate ·)) ++ " with")
        for a in alts do
          out := out ++ a
  return .ok out

/-! ## Constructs outside the fragment -/

/-- Reasons this module is outside the verbatim fragment. -/
def unsupportedReasons (body : List String) : List String := Id.run do
  let mut rs : List String := []
  for line in body do
    let s := trimStr line
    if s.startsWith "postulate" then
      rs := "postulate (a signature with no clauses is not an axiom here)" :: rs
    if s.startsWith "mutual" then rs := "mutual block" :: rs
    if s.startsWith "variable" then rs := "variable block" :: rs
  return rs.eraseDups

/-! ## Segmentation into declarations -/

/-- One declaration of a module: its lines, and — if it defines a binary mixfix
operator — the operator's name and symbol. -/
structure Segment where
  lines : Array String
  mixfix : Option (String × String) := none
  deriving Inhabited

/-- Split a module body into declarations.  A declaration is an indent-zero line
together with the indented lines that follow it and, for a signature, the
clauses that repeat its name (or use its operator). -/
partial def segment (body : Array String) (mixfix : List (String × String)) :
    Except String (Array Segment) := Id.run do
  let mut segs : Array Segment := #[]
  let mut pending : Array String := #[]
  let mut i := 0
  while i < body.size do
    let line := body[i]!
    if isCommentLine line then
      pending := pending.push line
      i := i + 1
      continue
    if indentOf line != 0 then
      -- a stray continuation belongs to the previous declaration
      if segs.size > 0 then
        let last := segs[segs.size - 1]!
        segs := segs.set! (segs.size - 1) { last with lines := last.lines ++ pending ++ #[line] }
        pending := #[]
      i := i + 1
      continue
    let toks := words line
    let hd := toks[0]!
    let isSig := toks.length >= 2 && toks[1]! == ":"
    let opsym := if isSig then mixfix.lookup hd else none
    let continues (l : String) : Bool :=
      isSig &&
        ((words l).head? == some hd ||
          (match opsym with
           | some s => containsSub l (" " ++ s ++ " ") && containsSub l "="
           | none => false))
    let mut decl : Array String := pending ++ #[line]
    pending := #[]
    i := i + 1
    while i < body.size do
      let nxt := body[i]!
      if trimStr nxt == "" then
        let mut j := i
        while j < body.size && trimStr body[j]! == "" do
          j := j + 1
        if j >= body.size then break
        if indentOf body[j]! == 0 && !continues body[j]! then break
        decl := decl ++ body.extract i j
        i := j
        continue
      if indentOf nxt > 0 then
        decl := decl.push nxt
        i := i + 1
        continue
      if continues nxt then
        decl := decl.push nxt
        i := i + 1
        continue
      break
    if (!isSig) && toks.length >= 2 && (hd == "data" || hd == "record")
        && isMixfixName (unquoteName toks[1]!) then
      return .error s!"mixfix {hd} declaration {toks[1]!}"
    else if isSig && isMixfixName (unquoteName hd) then
      match opsym with
      | none => return .error s!"mixfix operator {unquoteName hd} that is not binary"
      | some sym =>
        -- rewrite the clauses of the operator into prefix form
        let mut rewritten : Array String := #[]
        for l in decl do
          let s := trimStr l
          if isCommentLine l || indentOf l > 0 then
            rewritten := rewritten.push l
          else if (words s).take 2 == [hd, ":"] then
            match splitFirst s ":" with
            | some (_, ty) => rewritten := rewritten.push (hd ++ " :" ++ ty)
            | none => rewritten := rewritten.push l
          else if containsSub s (" " ++ sym ++ " ") && containsSub s "=" then
            match splitFirst s "=" with
            | none => rewritten := rewritten.push l
            | some (lhs, rhs) =>
              match splitFirst lhs (" " ++ sym ++ " ") with
              | none => rewritten := rewritten.push l
              | some (left, right) =>
                  rewritten := rewritten.push
                    s!"{hd} {trimStr left} {trimStr right} ={rhs}"
          else
            rewritten := rewritten.push l
        segs := segs.push { lines := rewritten, mixfix := some (hd, sym) }
    else
      segs := segs.push { lines := decl }
  if !pending.isEmpty then
    segs := segs.push { lines := pending }
  return .ok segs

/-! ## Normalisation -/

/-- Normalise genuine Agda source into the sequence of Lean commands that the
`agda_module` front end understands.  Returns an error message, naming the
construct, if the module is outside the fragment. -/
def normalize (src : String) : Except String (List String) := do
  -- Agda's instance arguments `{{x : C}}` are Lean's instance binders `[x : C]`.
  let text := rewriteBinderArrows
    ((((src.replace "{-" "/-").replace "-}" "-/").replace "{{" "[").replace "}}" "]")
  let lines := text.splitOn "\n"
  let some i := lines.findIdx? (fun l => l.startsWith "module ")
    | throw "agda: no module header"
  let htoks := words lines[i]!
  unless htoks.length == 3 && htoks[2]! == "where" do
    throw s!"agda: parametrised or malformed module header: {lines[i]!}"
  let name := htoks[1]!
  let rawBody := lines.drop (i + 1)
  match unsupportedReasons rawBody with
  | [] => pure ()
  | rs => throw s!"agda: `{name}` is outside the verbatim fragment: {", ".intercalate rs}"
  let body ←
    match hoistWhereBlocks (flattenPrivateBlocks rawBody.toArray) >>= desugarWith with
    | .error e => throw s!"agda: `{name}` is outside the verbatim fragment: {e}"
    | .ok b => pure b.toList
  -- imports, aliases and fixity declarations
  let mut aliases : List (String × String) := []
  let mut opens : List String := []
  let mut kept : List String := []
  -- how much of a multi-line `using (…)` list is still open, and whether such a
  -- list may begin on the next line
  let mut listDepth : Int := 0
  let mut expectList := false
  for line in body do
    let s := trimStr line
    if listDepth > 0 then
      listDepth := listDepth + parenBalance s
      continue
    if expectList && s.startsWith "(" then
      listDepth := parenBalance s
      continue
    expectList := false
    let ws := words s
    -- An import line is `[open] import M [as A] [using (…)] [hiding (…)]`.  All
    -- of them render as `open import M`: the module's declarations become a Lean
    -- namespace, so the qualified names are available whatever the Agda line
    -- says, and an alias `A` is expanded textually further down.
    if ws.length >= 2 && (ws[0]! == "import" || (ws[0]! == "open" && ws[1]! == "import")) then
      let k := if ws[0]! == "import" then 1 else 2
      let m := ws[k]!
      if ws.length > k + 2 && ws[k + 1]! == "as" then
        aliases := (ws[k + 2]!, m) :: aliases
      opens := m :: opens
      kept := ("open import " ++ m) :: kept
      listDepth := parenBalance s
      expectList := true
    else if indentOf line > 0 && s.startsWith "open " then
      -- `open R x` inside a `record` block brings `R`'s fields into scope
      -- applied to `x`.  Lean has no such form, so the line is dropped: a name
      -- it would have supplied has to be written qualified, and if it is not,
      -- Lean reports it as unknown rather than the module quietly meaning
      -- something else.
      pure ()
    else
      kept := line :: kept
  let body := kept.reverse
  let mut fixities : List (String × (String × Nat)) := []
  let mut rest : List String := []
  for line in body do
    let ws := words (trimStr line)
    if ws.length == 3 && ["infix", "infixl", "infixr"].contains ws[0]! then
      match ws[1]!.toNat? with
      | some p => fixities := (ws[2]!, (ws[0]!, 10 * p)) :: fixities
      | none => rest := line :: rest
    else rest := line :: rest
  let body := rest.reverse
  -- universe levels
  let stripped := body.map stripLevelBinders
  let lvls := (stripped.flatMap (fun (_, l) => l)).eraseDups
  let body := (stripped.map (fun (l, _) => l)).map
    (fun l => dropEmptyForall (rewriteSetLevels lvls l))
  let names := collectNames body
  let mixfix := (names.filter isBinaryMixfix).map (fun n => (n, mixfixSymbol n))
  let ren := (names.filter needsQuoting).map (fun n => (n, quoteName n))
  let body := ((body.map (renameTokens ren aliases)).map quoteExoticTokens).map
    expandOperatorSections
  let segs ←
    match segment body.toArray (mixfix.map (fun (n, s) => (quoteName n, s))) with
    | .error e => throw s!"agda: `{name}` is outside the verbatim fragment: {e}"
    | .ok s => pure s
  -- Every declaration becomes its own command, so an `open` issued inside one of
  -- them would go out of scope at the end of that command.  The imports are
  -- therefore opened once, at the top level, where the scope lasts for the rest
  -- of the file.
  let imported := (opens.filter (fun m =>
      !["Agda", "Data", "Relation", "Function", "Level", "Codata", "Algebra",
        "Induction", "Size"].contains ((m.splitOn ".").headD ""))).eraseDups
  let openCmd : List String :=
    (if lvls.isEmpty then [] else ["universe " ++ " ".intercalate lvls]) ++
    (if imported.isEmpty then [] else ["open " ++ " ".intercalate imported])
  let mut cmds : List String := []
  for seg in segs do
    if seg.lines.toList.all isCommentLine then continue
    let block := "\n".intercalate
      (seg.lines.toList.map (fun l => if trimStr l == "" then "" else "  " ++ l))
    -- `autoImplicit` is off: a name the prelude does not supply must be an error,
    -- not a silently auto-bound variable that makes the module elaborate into
    -- something other than what the Agda says.
    cmds := (s!"set_option autoImplicit false in\nopen Agda in\nagda_module {name} where\n"
      ++ block) :: cmds
    if let some (op, sym) := seg.mixfix then
      let orig := unquoteName op
      let (fix, prec) := (fixities.lookup orig).getD ("infixl", 500)
      cmds := s!"{fix}:{prec} \" {sym} \" => {name}.{quoteName orig}" :: cmds
  return openCmd ++ cmds.reverse

/-! ## The commands -/

/-- Parse and elaborate verbatim Agda source, optionally inside a namespace. -/
def elabAgdaSource (ref : Syntax) (src : String) (ns : Option Ident) : CommandElabM Unit := do
  let cmds ←
    match normalize src with
    | .error e => throwErrorAt ref e
    | .ok t => pure t
  if let some n := ns then elabCommand (← `(namespace $n))
  for txt in cmds do
    match Lean.Parser.runParserCategory (← getEnv) `command txt "<agda>" with
    | .error e => throwErrorAt ref s!"agda: {e}\nin:\n{txt}"
    | .ok stx => elabCommand (⟨stx⟩ : TSyntax `command)
  if let some n := ns then elabCommand (← `(end $n))

/-- Elaborate a verbatim Agda module given as a (raw) string literal. -/
syntax (name := agdaVerbatim) "agda_verbatim " str (" into " ident)? : command

/-- Elaborate a verbatim Agda module read from a file, relative to the working
directory of the build. -/
syntax (name := agdaInclude) "agda_include " str (" into " ident)? : command

@[command_elab agdaVerbatim]
def elabAgdaVerbatim : CommandElab := fun stx => do
  match stx with
  | `(command| agda_verbatim $s:str $[into $n]?) => elabAgdaSource stx s.getString n
  | _ => throwError "agda: malformed agda_verbatim"

@[command_elab agdaInclude]
def elabAgdaInclude : CommandElab := fun stx => do
  match stx with
  | `(command| agda_include $s:str $[into $n]?) => do
      let path := s.getString
      unless (← System.FilePath.pathExists path) do
        throwErrorAt stx s!"agda: no such file: {path}"
      elabAgdaSource stx (← IO.FS.readFile path) n
  | _ => throwError "agda: malformed agda_include"

end Verbatim
end AgdaFront
