/-
# S0/S1a/S1b of the periodic-B control cut, in the Lean Galerkin carrier

The 2026-09-15 B-lane control record fixes three literal finite observables of
the live Galerkin state, built from the *same* finite state and the *literal*
projected nonlinearity:

```text
X_N(t) = ∑_k w(k) |u_k(t)|²                          -- critical endpoint mass
D_N(t) = ∑_k w(k) |k|² |u_k(t)|²                     -- critical viscous rate
N_N(t) = 2 ∑_k w(k) Re⟨ f_k(u(t)) , u_k(t) ⟩          -- signed production rate
```

with `w(k) = 2^{shellIndex k}` the dyadic critical multiplier of
`CriticalDyadicWeight.lean`.  This file installs them on `ClayNS.Waleffe.GalerkinFlow`
— the project's literal truncated Navier–Stokes carrier, whose forcing
`modalForcing` *is* `−P_k ∑_{p+q=k} i (u_p·q) u_q` — and proves:

* `critProduction_pairing_symm` (S2a mirror) — `Re⟨f_k,u_k⟩ = Re⟨u_k,f_k⟩`, so the
  production fold may be read on either side of the projected pairing;
* `critEnergy_hasDerivAt` (S1a) — the *pointwise* critical energy split
  `d/dt X_N = N_N − 2ν D_N`, with the dissipation carrying the exact ODE weight
  `w(k)|k|²` and the production carrying the factor two, exactly the convention
  fixed by the Agda owner;
* `critEnergy_balance` (S1b) — the **integrated** identity
  `X_N(T) + 2ν ∫₀ᵀ D_N = X_N(0) + ∫₀ᵀ N_N`.

The S1b statement is *unconditional* here: the FTC and the linearity of the
integral are Mathlib theorems about the Lebesgue/interval integral, not assumed
authority fields.  This is the Lean-carrier certification of the calculus
authorities that the Agda compiler `NSTriadKNLiteralCriticalEnergyCalculusExact`
lists as `concreteScalarFTCInstalled = false`,
`concreteIntegrationLinearityInstalled = false`.  It is *not* a transport of that
Agda theorem: the objects here are the Lean carrier's own, and no same-object
weld between the two carriers is claimed.

Nothing in this file estimates the production: S2b is untouched.
-/
import RequestProject.NavierStokes.CriticalDyadicWeight
import RequestProject.NavierStokes.WaleffeGalerkinEnergy
import RequestProject.NavierStokes.WaleffeWienerBudget

noncomputable section

open Finset

namespace ClayNS.Waleffe

namespace GalerkinFlow

variable (G : GalerkinFlow)

/-! ## S0 — the three literal finite critical observables -/

/-- `X_N(t) = ∑_k w(k)|u_k|²`, the dyadic critical endpoint mass. -/
def critEnergy (t : ℝ) : ℝ := ∑ k ∈ G.modes, critWeight k * nsq (G.u t k)

/-- `D_N(t) = ∑_k w(k)|k|²|u_k|²`, the critical viscous rate in the exact
quadratic form generated by the literal viscous ODE. -/
def critDissipationRate (t : ℝ) : ℝ := ∑ k ∈ G.modes, critWeight k * wsq k * nsq (G.u t k)

/-- `N_N(t) = 2∑_k w(k) Re⟨f_k,u_k⟩`, the signed production rate computed from the
literal projected nonlinearity — not by rearranging an energy identity. -/
def critProductionRate (t : ℝ) : ℝ :=
  2 * ∑ k ∈ G.modes, critWeight k * (herm (G.force t k) (G.u t k)).re

theorem critEnergy_nonneg (t : ℝ) : 0 ≤ G.critEnergy t :=
  Finset.sum_nonneg fun k _ => mul_nonneg (critWeight_nonneg k) (nsq_nonneg _)

theorem critDissipationRate_nonneg (t : ℝ) : 0 ≤ G.critDissipationRate t :=
  Finset.sum_nonneg fun k _ =>
    mul_nonneg (mul_nonneg (critWeight_nonneg k) (wsq_nonneg k)) (nsq_nonneg _)

/-! ## S2a — the projected pairing is the same object read on either side -/

/-- **S2a (pairing symmetry).**  The real Hermitian pairing of the projected
nonlinearity against the velocity is symmetric, so the literal production fold
`Re⟨f_k,u_k⟩` and the output-pairing fold `Re⟨u_k,f_k⟩` are the same scalar. -/
theorem critProduction_pairing_symm (t : ℝ) (k : Wave) :
    (herm (G.force t k) (G.u t k)).re = (herm (G.u t k) (G.force t k)).re := by
  have h := herm_conj (G.force t k) (G.u t k)
  rw [← h, Complex.conj_re]

theorem critProductionRate_eq_output_pairing (t : ℝ) :
    G.critProductionRate t = 2 * ∑ k ∈ G.modes, critWeight k * (herm (G.u t k) (G.force t k)).re := by
  unfold critProductionRate
  congr 1
  exact Finset.sum_congr rfl fun k _ => by rw [G.critProduction_pairing_symm t k]

/-! ## S1a — the pointwise critical-energy split -/

/-- **S1a.**  The literal pointwise critical-energy split
`d/dt X_N = N_N − 2ν D_N`.  The viscous weight is the exact `w(k)|k|²` produced
by the literal ODE, and the production carries the factor two of the quadratic
energy convention. -/
theorem critEnergy_hasDerivAt (t : ℝ) :
    HasDerivAt G.critEnergy
      (G.critProductionRate t - 2 * G.nu * G.critDissipationRate t) t := by
  have hterm : ∀ k ∈ G.modes,
      HasDerivAt (fun s => critWeight k * nsq (G.u s k))
        (critWeight k * (-2 * G.nu * (wsq k * nsq (G.u t k))
          + 2 * (herm (G.force t k) (G.u t k)).re)) t := by
    intro k hk
    have hd := nsq_hasDerivAt (fun s => G.u s k)
      (fun i => -((G.nu * wsq k : ℝ) : ℂ) * G.u t k i + G.force t k i) t
      (fun i => G.ode t k hk i)
    have hsplit : herm (G.u t k)
        (fun i => -((G.nu * wsq k : ℝ) : ℂ) * G.u t k i + G.force t k i)
        = -((G.nu * wsq k : ℝ) : ℂ) * (nsq (G.u t k) : ℂ) + herm (G.u t k) (G.force t k) := by
      rw [herm_add_right, herm_smul_right, herm_self]
    rw [hsplit] at hd
    have hre : (-((G.nu * wsq k : ℝ) : ℂ) * (nsq (G.u t k) : ℂ)
        + herm (G.u t k) (G.force t k)).re
        = -(G.nu * wsq k) * nsq (G.u t k) + (herm (G.u t k) (G.force t k)).re := by
      simp [Complex.add_re, Complex.mul_re]
    rw [hre] at hd
    have := hd.const_mul (critWeight k)
    convert this using 1
    rw [G.critProduction_pairing_symm t k]
    ring
  have hsum : HasDerivAt G.critEnergy
      (∑ k ∈ G.modes, critWeight k * (-2 * G.nu * (wsq k * nsq (G.u t k))
        + 2 * (herm (G.force t k) (G.u t k)).re)) t := by
    have h := HasDerivAt.sum hterm
    have hfun : (∑ k ∈ G.modes, fun s => critWeight k * nsq (G.u s k)) = G.critEnergy := by
      funext s; simp [critEnergy, Finset.sum_apply]
    rwa [hfun] at h
  have hsplit : ∑ k ∈ G.modes, critWeight k * (-2 * G.nu * (wsq k * nsq (G.u t k))
        + 2 * (herm (G.force t k) (G.u t k)).re)
      = G.critProductionRate t - 2 * G.nu * G.critDissipationRate t := by
    rw [critProductionRate, critDissipationRate, Finset.mul_sum, Finset.mul_sum,
      ← Finset.sum_sub_distrib]
    exact Finset.sum_congr rfl fun k _ => by ring
  rwa [hsplit] at hsum

/-! ## S1b — the integrated critical-energy identity, unconditionally -/

theorem continuous_critEnergy : Continuous G.critEnergy :=
  continuous_finset_sum _ fun k _ => continuous_const.mul (G.continuous_nsq_u k)

theorem continuous_critDissipationRate : Continuous G.critDissipationRate :=
  continuous_finset_sum _ fun k _ => continuous_const.mul (G.continuous_nsq_u k)

theorem continuous_critProductionRate : Continuous G.critProductionRate := by
  refine continuous_const.mul (continuous_finset_sum _ fun k _ => continuous_const.mul ?_)
  exact Complex.continuous_re.comp
    (continuous_herm_of (G.continuous_force k) (G.continuous_u k))

/-- **S1b, unconditional in this carrier.**  The integrated critical-energy
identity

`X_N(t₁) + 2ν ∫_{t₀}^{t₁} D_N = X_N(t₀) + ∫_{t₀}^{t₁} N_N`.

The fundamental theorem of calculus and the linearity of the interval integral
are used as Mathlib theorems, so no calculus authority is assumed. -/
theorem critEnergy_balance (t₀ t₁ : ℝ) :
    G.critEnergy t₁ + 2 * G.nu * ∫ t in t₀..t₁, G.critDissipationRate t
      = G.critEnergy t₀ + ∫ t in t₀..t₁, G.critProductionRate t := by
  have hderiv : ∀ t ∈ Set.uIcc t₀ t₁,
      HasDerivAt G.critEnergy
        (G.critProductionRate t - 2 * G.nu * G.critDissipationRate t) t :=
    fun t _ => G.critEnergy_hasDerivAt t
  have hintP : IntervalIntegrable G.critProductionRate MeasureTheory.volume t₀ t₁ :=
    G.continuous_critProductionRate.intervalIntegrable _ _
  have hintD : IntervalIntegrable (fun t => 2 * G.nu * G.critDissipationRate t)
      MeasureTheory.volume t₀ t₁ :=
    (continuous_const.mul G.continuous_critDissipationRate).intervalIntegrable _ _
  have hint : IntervalIntegrable
      (fun t => G.critProductionRate t - 2 * G.nu * G.critDissipationRate t)
      MeasureTheory.volume t₀ t₁ := hintP.sub hintD
  have hftc := intervalIntegral.integral_eq_sub_of_hasDerivAt hderiv hint
  have hsplit : (∫ t in t₀..t₁, (G.critProductionRate t - 2 * G.nu * G.critDissipationRate t))
      = (∫ t in t₀..t₁, G.critProductionRate t)
        - 2 * G.nu * ∫ t in t₀..t₁, G.critDissipationRate t := by
    rw [intervalIntegral.integral_sub hintP hintD, intervalIntegral.integral_const_mul]
  rw [hsplit] at hftc
  linarith

/-- The critical energy decays exactly when the integrated production is paid by
the retained viscosity: the S1b identity rearranged. -/
theorem critEnergy_le_of_production_le (t₀ t₁ : ℝ)
    (h : (∫ t in t₀..t₁, G.critProductionRate t)
      ≤ 2 * G.nu * ∫ t in t₀..t₁, G.critDissipationRate t) :
    G.critEnergy t₁ ≤ G.critEnergy t₀ := by
  have hbal := G.critEnergy_balance t₀ t₁
  linarith

end GalerkinFlow

end ClayNS.Waleffe
