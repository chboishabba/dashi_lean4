fullfaith (isWeakEquivalenceTransportFunctor {C = C} p) x y = isEquivTransport
  λ i → cong Category.Hom[_,_] p i
   (transport-filler (cong Category.ob p) x i)
   (transport-filler (cong Category.ob p) y i)
