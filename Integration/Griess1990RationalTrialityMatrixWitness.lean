def sourceOne : Fin 27 → ℚ := fun i => if i = 0 then 1 else 0
def nativeOne : Fin 27 → ℚ := fun i => if i.val < 3 then 1 else 0

def applyWitness (M : Matrix (Fin 27) (Fin 27) ℚ)
    (v : Fin 27 → ℚ) : Fin 27 → ℚ :=
  fun i => ∑ j : Fin 27, M i j * v j

/-- Exact finite inverse identities, with all 729 entries determined. -/
theorem source_native_left_inverse :
    nativeToSource * sourceToNative = 1 := by native_decide

theorem source_native_right_inverse :
    sourceToNative * nativeToSource = 1 := by native_decide

/-- Distinguish Q-real-form 3*A₂ block metric from Peirce A₂^4. -/
theorem source_native_trace_gram :
    sourceToNative.transpose * nativeTraceGram * sourceToNative =
      sourceTraceGram := by native_decide

theorem source_native_unit :
    ∀ i, applyWitness sourceToNative sourceOne i = nativeOne i := by
  native_decide

/-- Final same-object product gate. Its two source-matching fields
are explicitly required so a random 27D bilinear tensor cannot pay A4. -/
structure GriessNativeFiniteProductPayment : Prop where
  sourceTensor : Fin 27 → Fin 27 → Fin 27 → ℚ
  nativeTensor : Fin 27 → Fin 27 → Fin 27 → ℚ
  sourceIsOriginalGriess1990 : Prop
  nativeIsActualRationalAlbertProduct : Prop
  all729BasisProducts :
    ∀ i j k : Fin 27,
      (∑ a : Fin 27, sourceToNative k a * sourceTensor i j a) =
      (∑ b : Fin 27, ∑ c : Fin 27,
        sourceToNative b i * sourceToNative c j * nativeTensor b c k)

end Integration.Griess1990RationalTrialityMatrixWitness
