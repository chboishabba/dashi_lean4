import Mathlib

namespace Synthesis.HolographicUpstreamStateContractNoGo

/-- Real-valued shadow of the inspected upstream `holographicState` amplitude.
The upstream state is complex-valued, but every amplitude is a real scalar
embedded in `ℂ`, so inequality of this real shadow already blocks equality with
the diagonal contract generated by the same source formulas. -/
noncomputable def upstreamUniformAmplitudeReal (n : ℕ) : ℝ :=
  1 / Real.sqrt ((2 ^ n : ℕ) : ℝ)

/-- Density kernel of the inspected upstream uniform **pure** state, restricted
to its real-valued entries.  Since the amplitude is constant and real, every
matrix entry is the same positive product. -/
noncomputable def upstreamPureDensityReal (n : ℕ) :
    Matrix (ZMod (2 ^ n)) (ZMod (2 ^ n)) ℝ :=
  fun _ _ => upstreamUniformAmplitudeReal n * upstreamUniformAmplitudeReal n

/-- Real-valued shadow of the inspected upstream `holographicContract`: a
maximally mixed diagonal matrix, not the outer product of the named state. -/
noncomputable def upstreamDiagonalContractReal (n : ℕ) :
    Matrix (ZMod (2 ^ n)) (ZMod (2 ^ n)) ℝ :=
  fun i j => if i = j then 1 / ((2 ^ n : ℕ) : ℝ) else 0

/-- Depth-one specializations are enough to give a concrete source-level
counterexample to the claimed same-object reading. -/
noncomputable def upstreamPureDensityDepthOne : Matrix (ZMod 2) (ZMod 2) ℝ :=
  upstreamPureDensityReal 1

noncomputable def upstreamDiagonalContractDepthOne : Matrix (ZMod 2) (ZMod 2) ℝ :=
  upstreamDiagonalContractReal 1

/-- The pure-state `0,1` coherence is strictly positive at depth one. -/
theorem upstreamPureDensityDepthOne_offdiag_positive :
    0 < upstreamPureDensityDepthOne 0 1 := by
  unfold upstreamPureDensityDepthOne upstreamPureDensityReal upstreamUniformAmplitudeReal
  norm_num
  positivity

/-- The inspected diagonal contract has exactly zero `0,1` coherence. -/
theorem upstreamDiagonalContractDepthOne_offdiag_zero :
    upstreamDiagonalContractDepthOne 0 1 = 0 := by
  unfold upstreamDiagonalContractDepthOne upstreamDiagonalContractReal
  norm_num

/-- Exact no-go for the inspected source formulas: already at depth one, the
density matrix of the named uniform pure state is not the named diagonal
`holographicContract`.

Thus the upstream RT same-object state weld cannot be completed merely by adding
a proof around the current definitions; one of the constructions/identifications
has to change. -/
theorem upstreamStateContractMismatchDepthOne :
    upstreamPureDensityDepthOne ≠ upstreamDiagonalContractDepthOne := by
  intro h
  have hentry := congrFun (congrFun h (0 : ZMod 2)) (1 : ZMod 2)
  rw [upstreamDiagonalContractDepthOne_offdiag_zero] at hentry
  have hp := upstreamPureDensityDepthOne_offdiag_positive
  linarith

/-- Status boundary. -/
def upstreamStateContractSameObjectImpossibleAsWritten : Bool := true

def upstreamDefinitionsMustChangeForStateContractWeld : Bool := true

def correctedRTStateStillRequiresExplicitSourceReplacement : Bool := true

def carrierFactorizationDoesNotRepairStateMismatch : Bool := true

def definitionalAreaLawStillDoesNotDeriveStateEntropy : Bool := true

def physicalAdSCFTStillRequired : Bool := true

end Synthesis.HolographicUpstreamStateContractNoGo
