/-
# Rendering the prime-power fibers as SVG

This file turns the (verified) colouring of `RequestProject/FiberColors.lean` into two SVG
pictures of the integers `1, …, 256`:

* `twoThreeSvg` — the fiber of `2` in red and the fiber of `3` in blue, everything else
  neutral;
* `firstTwentySvg` — all twenty fibers, each in its own colour.

Everything here is plain string manipulation; the mathematical content (that the colours
really are the fibers) is in `RequestProject/FiberColors.lean`. The rendered files live in
`visualization/`; they are regenerated by `scripts/GenerateSvg.lean`.
-/
import RequestProject.FiberColors

namespace PrimeFibers

/-! ## Small SVG helpers -/

private def attr (k v : String) : String := k ++ "=\"" ++ v ++ "\""

private def rectTag (x y w h : ℕ) (fill stroke : String) (rx : ℕ) : String :=
  "  <rect " ++ attr "x" (toString x) ++ " " ++ attr "y" (toString y) ++ " " ++
    attr "width" (toString w) ++ " " ++ attr "height" (toString h) ++ " " ++
    attr "rx" (toString rx) ++ " " ++ attr "fill" fill ++ " " ++
    attr "stroke" stroke ++ " " ++ attr "stroke-width" "1" ++ "/>"

private def textTag (x y size : ℕ) (fill anchor weight body : String) : String :=
  "  <text " ++ attr "x" (toString x) ++ " " ++ attr "y" (toString y) ++ " " ++
    attr "font-family" "ui-monospace, SFMono-Regular, Menlo, monospace" ++ " " ++
    attr "font-size" (toString size) ++ " " ++ attr "font-weight" weight ++ " " ++
    attr "fill" fill ++ " " ++ attr "text-anchor" anchor ++ ">" ++ body ++ "</text>"

/-- Colours on which white text is more readable than dark text. -/
def darkColors : List String :=
  [redColor, blueColor, "#3cb44b", "#911eb4", "#f032e6", "#008080", "#9a6324", "#800000",
   "#808000", "#000075"]

/-- The colour used for the numeral drawn inside a cell of the given background colour. -/
def labelColor (background : String) : String :=
  if background ∈ darkColors then "#ffffff" else "#1f2933"

/-! ## The grid -/

private def cellSize : ℕ := 44
private def cols : ℕ := 16
private def marginX : ℕ := 26
private def gridTop : ℕ := 96

/-- One cell of the grid: a coloured square carrying the numeral `n`. -/
private def cellSvg (colFn : ℕ → String) (n : ℕ) : String :=
  let i := n - 1
  let x := marginX + (i % cols) * cellSize
  let y := gridTop + (i / cols) * cellSize
  let c := colFn n
  let stroke := if c = neutralColor then "#dbe1ea" else "#ffffff"
  rectTag x y cellSize cellSize c stroke 6 ++ "\n" ++
    textTag (x + cellSize / 2) (y + cellSize / 2 + 5) 14 (labelColor c) "middle"
      (if c = neutralColor then "400" else "700") (toString n)

/-- The whole grid of the numbers `1, …, N`. -/
private def gridSvg (N : ℕ) (colFn : ℕ → String) : String :=
  String.intercalate "\n" ((List.range N).map (fun i => cellSvg colFn (i + 1)))

/-- One legend entry: a swatch plus the label `p^k`. -/
private def legendEntry (x y : ℕ) (color label : String) : String :=
  rectTag x y 18 18 color "#ffffff" 4 ++ "\n" ++
    textTag (x + 26) (y + 14) 14 "#1f2933" "start" "500" label

private def legendSvg (y0 : ℕ) (entries : List (String × String)) (perRow : ℕ)
    (colWidth : ℕ) : String :=
  String.intercalate "\n"
    ((entries.zipIdx).map (fun (e, i) =>
      legendEntry (marginX + (i % perRow) * colWidth) (y0 + (i / perRow) * 28) e.1 e.2))

private def svgDoc (width height : ℕ) (title subtitle body : String) : String :=
  "<svg xmlns=\"http://www.w3.org/2000/svg\" " ++
    attr "width" (toString width) ++ " " ++ attr "height" (toString height) ++ " " ++
    attr "viewBox" ("0 0 " ++ toString width ++ " " ++ toString height) ++ ">\n" ++
  rectTag 0 0 width height "#ffffff" "#ffffff" 0 ++ "\n" ++
  textTag marginX 40 22 "#111827" "start" "700" title ++ "\n" ++
  textTag marginX 66 14 "#4b5563" "start" "400" subtitle ++ "\n" ++
  body ++ "\n</svg>\n"

/-! ## The two pictures -/

/-- Number of integers displayed. -/
def displayN : ℕ := 256

private def gridHeight : ℕ := gridTop + ((displayN + cols - 1) / cols) * cellSize

/-- The picture of the fibers of `2` (red) and `3` (blue) inside `1, …, 256`. -/
def twoThreeSvg : String :=
  svgDoc (marginX * 2 + cols * cellSize) (gridHeight + 74)
    "Prime-power fibers: the domains of 2 and 3"
    ("red = { 2^k : k \u2265 1 }   blue = { 3^k : k \u2265 1 }   grey = neither, for n \u2264 " ++
      toString displayN)
    (gridSvg displayN twoThreeColor ++ "\n" ++
      legendSvg (gridHeight + 22) [(redColor, "2^k  (fiber of 2)"),
        (blueColor, "3^k  (fiber of 3)"), (neutralColor, "not a power of 2 or 3")] 3 240)

/-- The picture of all twenty fibers inside `1, …, 256`, one colour per prime. -/
def firstTwentySvg : String :=
  svgDoc (marginX * 2 + cols * cellSize) (gridHeight + 158)
    "Prime-power fibers of the first twenty primes"
    ("cell n is coloured by the prime p with n = p^k (k \u2265 1); grey = not a prime power" ++
      " with p \u2264 71")
    (gridSvg displayN cellColor ++ "\n" ++
      legendSvg (gridHeight + 22)
        (primeList.map (fun p => (fiberColor p, toString p ++ "^k")) ++
          [(neutralColor, "other")]) 5 140)

end PrimeFibers
