import Mathlib
import Integration.Experiment.CoverageSemantics
import Integration.Experiment.ModelDiscrepancy

/-!
# Stage 7, lane 1b — unmodelled discrepancy destroys *nominal coverage*

`Integration.Experiment.ModelDiscrepancy` proves the deterministic half of the
Stage-7 lane-1 claim: an unmodelled `δ(x)` drops the generating parameter out of
the surviving region.  That is a statement about a *possibility set*.

The boxed claim of the roadmap is stronger and probabilistic:

```
unmodelled discrepancy can destroy nominal coverage.
```

This file proves that, in the frequentist semantics of
`Integration.Experiment.CoverageSemantics`.  The Stage-6 bridge theorem
`tolerance_procedure_has_full_coverage` certifies the admissible region as a
**coverage-one** procedure under bounded noise.  Here the same procedure, with
the same declared tolerance, is shown to have coverage **exactly zero** once the
data are generated by the model *plus* a discrepancy exceeding the tolerance —
and therefore to satisfy no positive nominal level at all.

## What is proved

| Statement | Kind | Content |
|---|---|---|
| `coverageProb_eq_zero_of_always_missing` | theorem | a procedure that misses `θ` on every possible outcome has coverage `0` |
| **`discrepancy_destroys_nominal_coverage`** | theorem (negative) | if the observation is off by more than the tolerance on every possible outcome, the certified region has coverage `0` at the generating parameter |
| **`no_positive_level_under_discrepancy`** | theorem (negative) | so the procedure has *no* positive level: the nominal certificate is void, not merely degraded |
| `discrepancy_coverage_of_bounded_noise` | theorem | the quantitative form: `tol + noiseBound < |δ(time)|` suffices |
| `inflated_tolerance_restores_full_coverage` | theorem | and inflating the tolerance by a discrepancy bound restores coverage one |
| `pointModel`, `slopeFamily`, **`nominal_coverage_can_be_destroyed`** | definition / theorem | a fully concrete witness: the *same* procedure has coverage `1` on data the model generates and coverage `0` on data bent by `δ` |

## Claim boundary

`Ω` is a `Fintype` and the sampling law is a `FinPMF`, exactly as in Stage 6:
there is no continuous noise model here, and no asymptotic statement.  "Coverage"
is the finite sum `P_θ(θ ∈ C(Y))` under a *declared* sampling model, and `δ` is
a declared function.  Nothing here says any real experiment has a discrepancy.
-/

namespace Integration.Experiment.DiscrepancyCoverage

open Integration.Experiment.Probability
open Integration.Experiment.ParameterRegion
open Integration.Experiment.CoverageSemantics
open Integration.Experiment.ModelDiscrepancy

variable {Θ Ω : Type} [Fintype Ω]

/-! ## §1 Coverage zero -/

open scoped Classical in
/-- A procedure that misses `θ` on every outcome of positive mass has coverage
`0` at `θ` — the exact opposite pole of `coverageProb_eq_one_iff`. -/
theorem coverageProb_eq_zero_of_always_missing (S : SamplingModel Θ Ω) (C : Ω → Set Θ)
    (θ : Θ) (h : ∀ w, 0 < (S.law θ).mass w → θ ∉ C w) :
    coverageProb S C θ = 0 := by
  classical
  simp only [coverageProb, FinPMF.expect]
  refine Finset.sum_eq_zero (fun w _ => ?_)
  rcases lt_or_eq_of_le ((S.law θ).nonneg w) with hw | hw
  · simp [h w hw]
  · simp [← hw]

/-! ## §2 The negative -/

/-- **Unmodelled discrepancy destroys nominal coverage.**  The Stage-4
admissible region, read through `toleranceProcedure` with the declared tolerance
`tol`, has coverage *zero* at the generating parameter as soon as the observed
value is further than `tol` from the model prediction on every possible
outcome.

Compare `CoverageSemantics.tolerance_procedure_has_full_coverage`: the same
procedure, the same tolerance, coverage one under bounded noise and coverage
zero under discrepancy.  The certificate was never a property of the procedure
alone — it was a property of the procedure *together with the assumption that
the model is adequate*. -/
theorem discrepancy_destroys_nominal_coverage (S : SamplingModel Θ Ω)
    (F : ParamFamily Θ) (time tol : ℝ) (htol : 0 ≤ tol) (obs : Ω → ℝ) (θ : Θ)
    (hbad : ∀ w, 0 < (S.law θ).mass w → tol < |obs w - F.predict θ time|) :
    coverageProb S (toleranceProcedure F time tol htol obs) θ = 0 := by
  refine coverageProb_eq_zero_of_always_missing S _ θ (fun w hw hmem => ?_)
  have hfit := hmem.2 ⟨time, obs w, tol, htol⟩ (by simp)
  exact absurd hfit (not_le.mpr (hbad w hw))

/-- **The nominal certificate is void, not merely degraded**: the procedure has
no positive level whatsoever. -/
theorem no_positive_level_under_discrepancy (S : SamplingModel Θ Ω)
    (F : ParamFamily Θ) (time tol : ℝ) (htol : 0 ≤ tol) (obs : Ω → ℝ) (θ : Θ)
    (hbad : ∀ w, 0 < (S.law θ).mass w → tol < |obs w - F.predict θ time|)
    {level : ℝ} (hlevel : 0 < level) :
    ¬ HasLevel S (toleranceProcedure F time tol htol obs) level := by
  intro h
  have := h θ
  rw [discrepancy_destroys_nominal_coverage S F time tol htol obs θ hbad] at this
  exact absurd this (not_le.mpr hlevel)

/-- The quantitative form, phrased with the discrepancy of
`Integration.Experiment.ModelDiscrepancy`.  If the truth is the model plus `δ`,
the noise is bounded by `noiseBound`, and

```
tol + noiseBound < |δ(time)|,
```

then coverage at the generating parameter is zero. -/
theorem discrepancy_coverage_of_bounded_noise (S : SamplingModel Θ Ω)
    (F : ParamFamily Θ) (θ : Θ) (truth : ℝ → ℝ) (time tol noiseBound : ℝ) (htol : 0 ≤ tol)
    (obs : Ω → ℝ)
    (hobs : ∀ w, 0 < (S.law θ).mass w → |obs w - truth time| ≤ noiseBound)
    (hbig : tol + noiseBound < |discrepancy F θ truth time|) :
    coverageProb S (toleranceProcedure F time tol htol obs) θ = 0 := by
  refine discrepancy_destroys_nominal_coverage S F time tol htol obs θ (fun w hw => ?_)
  have hn := hobs w hw
  have hsplit : |discrepancy F θ truth time| ≤
      |obs w - F.predict θ time| + |obs w - truth time| := by
    have : discrepancy F θ truth time
        = (truth time - obs w) + (obs w - F.predict θ time) := by
      simp only [discrepancy]; ring
    calc |discrepancy F θ truth time|
        ≤ |truth time - obs w| + |obs w - F.predict θ time| := by
          rw [this]; exact abs_add_le _ _
      _ = |obs w - F.predict θ time| + |obs w - truth time| := by
          rw [abs_sub_comm (truth time) (obs w)]; ring
  linarith

/-- And the repair: inflating the declared tolerance by a bound on the
discrepancy *and* the noise restores coverage one.  The price is the width, made
explicit in `ModelDiscrepancy.inflation_strictly_widens`. -/
theorem inflated_tolerance_restores_full_coverage (S : SamplingModel Θ Ω)
    (F : ParamFamily Θ) (θ : Θ) (time tol' : ℝ) (htol' : 0 ≤ tol') (obs : Ω → ℝ)
    (hprior : θ ∈ F.prior)
    (hcover : ∀ w, 0 < (S.law θ).mass w → |obs w - F.predict θ time| ≤ tol') :
    coverageProb S (toleranceProcedure F time tol' htol' obs) θ = 1 :=
  tolerance_procedure_has_full_coverage S F time tol' htol' obs θ hprior hcover

/-! ## §3 A concrete witness -/

/-- A one-outcome sampling model: the instrument reports a single value with
probability one, whatever the parameter.  Noise plays no role, so the failure
below is attributable to the discrepancy alone. -/
noncomputable def pointModel : SamplingModel ℝ Unit where
  law := fun _ =>
    { mass := fun _ => 1
      nonneg := by intro _; norm_num
      total := by simp }

/-- The one-parameter family `y = θ t`, with every slope admissible. -/
def slopeFamily : ParamFamily ℝ where
  prior := Set.univ
  predict := fun θ t => θ * t

@[simp] theorem slopeFamily_predict (θ t : ℝ) : slopeFamily.predict θ t = θ * t := rfl

/-- Reading the observable at `t = 1` with a declared tolerance of `1/10`, on
data that the model generated exactly. -/
noncomputable def cleanProcedure : Unit → Set ℝ :=
  toleranceProcedure slopeFamily 1 (1/10) (by norm_num) (fun _ => 1)

/-- The same procedure, on data bent by a discrepancy `δ(1) = 1`. -/
noncomputable def bentProcedure : Unit → Set ℝ :=
  toleranceProcedure slopeFamily 1 (1/10) (by norm_num) (fun _ => 2)

/-- **The witness.**  With the true slope `θ₀ = 1`: on model-generated data the
declared procedure has coverage `1`; on data carrying a discrepancy of `1` at
the same time, with the same tolerance and the same declared family, it has
coverage `0` — and therefore no positive nominal level. -/
theorem nominal_coverage_can_be_destroyed :
    coverageProb pointModel cleanProcedure 1 = 1 ∧
      coverageProb pointModel bentProcedure 1 = 0 ∧
      ∀ level : ℝ, 0 < level → ¬ HasLevel pointModel bentProcedure level := by
  refine ⟨?_, ?_, ?_⟩
  · refine inflated_tolerance_restores_full_coverage pointModel slopeFamily 1 1 (1/10)
      (by norm_num) (fun _ => 1) (Set.mem_univ _) (fun w _ => ?_)
    norm_num
  · refine discrepancy_destroys_nominal_coverage pointModel slopeFamily 1 (1/10)
      (by norm_num) (fun _ => 2) 1 (fun w _ => ?_)
    norm_num
  · intro level hlevel
    refine no_positive_level_under_discrepancy pointModel slopeFamily 1 (1/10)
      (by norm_num) (fun _ => 2) 1 (fun w _ => ?_) hlevel
    norm_num

end Integration.Experiment.DiscrepancyCoverage
