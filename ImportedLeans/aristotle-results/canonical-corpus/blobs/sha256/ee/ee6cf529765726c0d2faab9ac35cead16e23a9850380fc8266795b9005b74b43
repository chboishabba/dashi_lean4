  -ₖConst : (n : ℕ) → (x : EM G (suc n)) → -ₖ x ≡ x
  -ₖConst =
   elim+2 -ₖConst₁
     (TR.elim (λ _ → isOfHLevelPath 4
                       (hLevelEM _ 2) _ _)
     λ { north → refl
       ; south i → ∣ merid embase i ∣
       ; (merid a i) j →
         hcomp (λ r → λ {(i = i0) → ∣ north ∣
                         ; (i = i1) → ∣ merid embase (j ∧ r) ∣
                         ; (j = i0) → EM→ΩEM+1-sym (suc zero) a r i
                         ; (j = i1) → ∣ compPath-filler (merid a)
