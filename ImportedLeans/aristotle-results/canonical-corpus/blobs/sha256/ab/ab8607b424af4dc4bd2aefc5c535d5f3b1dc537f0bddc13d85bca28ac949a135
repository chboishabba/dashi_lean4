          ∙ₑ invEquiv (fiberProjEquiv X _ x₀))
        (Σ-cong-equiv-snd (λ _ → invEquiv ΣPathP≃PathPΣ)
          ∙ₑ invEquiv Σ-assoc-≃
          ∙ₑ invEquiv (fiberProjEquiv Y _ y₀))
