theorem t1Coeffs_size : t1Coeffs.size = 100 := by native_decide

/-- **The precomputed `T1`/`j` expansion is correct.**  For each `k < 100` the
supplied coefficient equals the coefficient of `q^{k+1}` in the honestly computed
`j`-series, i.e. `t1Coeffs[k] = jSeries[k+2]`.  Equivalently, `t1Coeffs` is the
slice `jSeries[2 … 101]`. -/
theorem t1Coeffs_correct :
    (Array.range 100).map (fun k => jSeries[k + 2]!) = t1Coeffs := by
  native_decide

/-
A pointwise restatement of `t1Coeffs_correct`.
-/
theorem t1Coeffs_eq_jSeries (k : Nat) (hk : k < 100) :
    t1Coeffs[k]! = jSeries[k + 2]! := by
  native_decide +revert

/-! ## Moonshine "configurations": each coefficient as a sum of Monster irreps

`smallIrrepDegrees = [1, 196883, 21296876, 842609326, 18538750076,
19360062527, 293553734298]` are the seven smallest Monster irrep degrees.  The
classical head-character identities express each low coefficient of `j` as a
non-negative integer combination of these.  `moonshine_c1 … c3` are in
`Moonshine`; here are the next two. -/

/-- **Monstrous Moonshine, level 4.**  The coefficient of `q⁴` in `j` decomposes
over the five smallest Monster irrep degrees with multiplicities `(3,3,1,2,1)`. -/
theorem moonshine_c4 :
    jCoeff 5 = 3 * 1 + 3 * 196883 + 1 * 21296876 + 2 * 842609326
        + 1 * 18538750076 := by native_decide

/-- **Monstrous Moonshine, level 5.**  The coefficient of `q⁵` in `j` decomposes
over the seven smallest Monster irrep degrees with multiplicities
`(4,5,3,2,1,1,1)`. -/
theorem moonshine_c5 :
    jCoeff 6 = 4 * 1 + 5 * 196883 + 3 * 21296876 + 2 * 842609326
        + 1 * 18538750076 + 1 * 19360062527 + 1 * 293553734298 := by native_decide

/-- The level-4 and level-5 identities, stated directly against the precomputed
table `t1Coeffs` (whose `k`-th entry is `c(k+1) = jCoeff (k+2)`). -/
theorem t1_c4 :
    t1Coeffs[3]! = 3 * 1 + 3 * 196883 + 1 * 21296876 + 2 * 842609326
        + 1 * 18538750076 := by native_decide

theorem t1_c5 :
    t1Coeffs[4]! = 4 * 1 + 5 * 196883 + 3 * 21296876 + 2 * 842609326
        + 1 * 18538750076 + 1 * 19360062527 + 1 * 293553734298 := by native_decide

end Moonshine