    ; localEnergy = coarseLocalEnergy
    ; updatedEnergy = coarseUpdatedLocalEnergy
    ; localCurrent = coarseLocalCurrentMagnitude
    ; pairInteractionCurrent = phaseInteractionCurrent
    ; pairInterferenceCurrent = interferenceCurrent
