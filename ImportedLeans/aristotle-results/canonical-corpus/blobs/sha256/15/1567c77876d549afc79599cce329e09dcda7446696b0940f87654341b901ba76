su2LConditionalLabel =
  "SU2_L is conditional on the supplied spin-sector Rep(SU2) witness"

u1yCandidateLabel : String
u1yCandidateLabel =
  "U1_Y is recorded as a candidate from the Z/3 subset {0,2,4} inside the finite Z/6 factor"

