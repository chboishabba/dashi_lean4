import RequestProject.Agda.Syntax

/-!
# `DASHI.Foundations.Base369Nat`, hand-written shim

The upstream module of this name defines natural-number remainder from
`Agda.Builtin.Nat.mod-helper`, guarded by an instance argument `NonZero`.  The
Agda front end of `RequestProject.Agda.Syntax` does not cover instance
arguments or `private` blocks, so this module is written directly in Lean
instead of being generated by `tools/agda2lean.py`.

It is a *shim*, not a translation: it supplies the same interface — a
`NonZero` predicate and the operator `_%_` — with Lean's own `Nat.mod`, which
is the same function (`mod-helper 0 n m n = m % (n+1)`), so that the upstream
modules that use it can be transliterated.  Nothing is postulated.
-/

namespace DASHI.Foundations.Base369Nat

/-- Upstream `NonZero n`: inhabited exactly when `n` is a successor. -/
abbrev NonZero (n : Nat) : Prop := n ≠ 0

/-- Upstream `_%_`, which is Lean's `Nat.mod`. -/
def «_%_» (m n : Nat) : Nat := m % n

theorem mod_shim_is_nat_mod (m n : Nat) : «_%_» m n = m % n := rfl

end DASHI.Foundations.Base369Nat

infixl:70 " % " => DASHI.Foundations.Base369Nat.«_%_»
