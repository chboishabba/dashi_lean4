open BcMesonCarrier public

bcPlusCarrier :
  BcMesonCarrier
bcPlusCarrier =
  record
    { firstLeg =
        charmQuark
    ; secondLeg =
        antiBottomQuark
    ; charge =
        plusCharge
    }

