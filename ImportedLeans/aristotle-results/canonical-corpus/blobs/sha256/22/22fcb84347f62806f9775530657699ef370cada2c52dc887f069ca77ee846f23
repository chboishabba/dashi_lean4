      (ψ : QS.Carrier S) →
      quotientEvolution (QS.quotientClass Q ψ)
      ≡
      QS.quotientClass Q
        (QS.SetoidUnaryOperationSurface.unaryOperation
          prequotientEvolution
          ψ)

    kernelPreservation :
      {ψ χ : QS.Carrier S} →
      QS._≈_ S ψ χ →
      QS._≈_ S
