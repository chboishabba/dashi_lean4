  sum-over-1 :
    ∀ {A : 𝒰₀} {F : 𝒰₀}
    → ∑ (λ {∗ → F}) ≃ F
  sum-over-1 = (λ {(∗ , x) → x}) is-an-equivalence-because
    (has-left-inverse (λ x → ∗ , x) by (λ {(∗ , x) → refl}) and-right-inverse (λ x → ∗ , x) by (λ a → refl))

