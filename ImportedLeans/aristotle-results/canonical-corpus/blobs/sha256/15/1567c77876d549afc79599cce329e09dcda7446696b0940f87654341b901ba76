concatW (xs ∷ xss) = xs ++ concatW xss
  where
    _++_ : ∀ {A : Set} → List A → List A → List A
    [] ++ ys = ys
    (x ∷ xs) ++ ys = x ∷ (xs ++ ys)

concatMapW : ∀ {A B : Set} → (A → List B) → List A → List B
