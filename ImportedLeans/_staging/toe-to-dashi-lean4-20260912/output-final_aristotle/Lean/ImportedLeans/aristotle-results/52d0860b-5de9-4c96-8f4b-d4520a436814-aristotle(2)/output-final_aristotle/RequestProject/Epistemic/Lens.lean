namespace Epistemic

universe u v w

/-- A latent object seen through a family of projections. -/
structure ViewFamily (Latent : Type u) (Idx : Type v) (View : Type w) where
  /-- The view of a latent object through a given lens. -/
  project : Idx → Latent → View

namespace ViewFamily

variable {Latent : Type u} {Idx : Type v} {View : Type w}

/-- The `i`-view determines the `j`-view: latent objects indistinguishable
through `i` are indistinguishable through `j`. -/
def Determines (F : ViewFamily Latent Idx View) (i j : Idx) : Prop :=
  ∀ l l' : Latent, F.project i l = F.project i l' → F.project j l = F.project j l'

theorem determines_refl (F : ViewFamily Latent Idx View) (i : Idx) : F.Determines i i :=
  fun _ _ h => h

theorem determines_trans {F : ViewFamily Latent Idx View} {i j k : Idx}
    (h₁ : F.Determines i j) (h₂ : F.Determines j k) : F.Determines i k :=
  fun l l' h => h₂ l l' (h₁ l l' h)

/-- A lens transition: an explicit, two-sided transport between two views.  The
transport must both hit the requested view on every latent object and be an
isomorphism of the view type; neither half follows from the other. -/
structure Transition (F : ViewFamily Latent Idx View) (i j : Idx) where
  /-- Transport from the `i`-view to the `j`-view. -/
  forward : View → View
  /-- Transport from the `j`-view back to the `i`-view. -/
  backward : View → View
  /-- The forward transport really produces the `j`-view. -/
  forwardProjects : ∀ l, forward (F.project i l) = F.project j l
  /-- The backward transport really produces the `i`-view. -/
  backwardProjects : ∀ l, backward (F.project j l) = F.project i l
  /-- The transports are mutually inverse. -/
  leftInv : ∀ x, backward (forward x) = x
  /-- The transports are mutually inverse. -/
  rightInv : ∀ x, forward (backward x) = x

namespace Transition

variable {F : ViewFamily Latent Idx View} {i j : Idx}

/-- A transition witnesses that each of the two views determines the other. -/
theorem determines (T : Transition F i j) : F.Determines i j := by
  intro l l' h
  rw [← T.forwardProjects, ← T.forwardProjects, h]

theorem determines_symm (T : Transition F i j) : F.Determines j i := by
  intro l l' h
  rw [← T.backwardProjects, ← T.backwardProjects, h]

/-- Transitions are symmetric. -/
def symm (T : Transition F i j) : Transition F j i where
  forward := T.backward
  backward := T.forward
  forwardProjects := T.backwardProjects
  backwardProjects := T.forwardProjects
  leftInv := T.rightInv
  rightInv := T.leftInv

/-- The identity transition of a view with itself. -/
def refl (F : ViewFamily Latent Idx View) (i : Idx) : Transition F i i where
  forward := id
  backward := id
  forwardProjects := fun _ => rfl
  backwardProjects := fun _ => rfl
  leftInv := fun _ => rfl
  rightInv := fun _ => rfl

end Transition

/-- **A lens transition requires explicit transport.**  If the `i`-view fails to
determine the `j`-view then there is no transition between them — comparing the
two projections does not manufacture one. -/
theorem isEmpty_transition_of_not_determines {F : ViewFamily Latent Idx View} {i j : Idx}
    (h : ¬ F.Determines i j) : IsEmpty (Transition F i j) :=
  ⟨fun T => h T.determines⟩

/-! ## Comparing two views -/

variable (F : ViewFamily Latent Idx View)

/-- Reading a view off as an evidence state. -/
def observe (q : View → Trit) (i : Idx) (l : Latent) : Trit := q (F.project i l)

/-- The ordered pair of evidence states obtained from two lenses. -/
def comparePair (q : View → Trit) (i j : Idx) (l : Latent) : Trit × Trit :=
  (F.observe q i l, F.observe q j l)

@[simp] theorem comparePair_fst (q : View → Trit) (i j : Idx) (l : Latent) :
    (F.comparePair q i j l).1 = F.observe q i l := rfl

@[simp] theorem comparePair_snd (q : View → Trit) (i j : Idx) (l : Latent) :
    (F.comparePair q i j l).2 = F.observe q j l := rfl

/-- The summary of a comparison. -/
def compareDisposition (q : View → Trit) (i j : Idx) (l : Latent) : Disposition :=
  compareStates (F.observe q i l) (F.observe q j l)

theorem compareDisposition_eq (q : View → Trit) (i j : Idx) (l : Latent) :
    F.compareDisposition q i j l =
      compareStates (F.comparePair q i j l).1 (F.comparePair q i j l).2 := rfl

end ViewFamily

/-- **The summary is lossy, so the directed pair must be retained.**  Distinct
ordered pairs of evidence states can carry the same disposition. -/
theorem disposition_forgets_pair :
    ∃ p q : Trit × Trit, p ≠ q ∧ compareStates p.1 p.2 = compareStates q.1 q.2 :=
  ⟨(Trit.supported, Trit.supported), (Trit.contradicted, Trit.contradicted), by decide, rfl⟩

/-! ## Only resolved views may enter a comparison -/

/-- A determinate reading of a view. -/
inductive Polarity
  | against
  | inFavour
  deriving DecidableEq, Repr, Inhabited

/-- The evidence state a polarity stands for. -/
def Polarity.state : Polarity → Trit
  | Polarity.against => Trit.contradicted
  | Polarity.inFavour => Trit.supported

/-- **Ignorance has no polarity.** -/
theorem unresolved_not_resolved (p : Polarity) : Trit.unresolved ≠ p.state := by
  cases p <;> simp [Polarity.state]

/-- An unobserved source cannot be read as either polarity. -/
theorem notObserved_not_resolved (m a : Bool) (p : Polarity) :
    verdictState m a ObjectVerdict.notObserved ≠ p.state := by
  rw [verdictState_notObserved]
  exact unresolved_not_resolved p

/-- An unmatched source cannot be read as either polarity. -/
theorem sourceMismatch_not_resolved (a : Bool) (v : ObjectVerdict) (p : Polarity) :
    verdictState false a v ≠ p.state := by
  rw [verdictState_of_source_mismatch]
  exact unresolved_not_resolved p

/-- A resolved reading collapses to its polarity, and a conflict is not one: the
top corner of the support square has no polarity either. -/
theorem bothSupported_not_resolved (p : Polarity) :
    collapse Corner.bothSupported ≠ p.state := by
  cases p <;> simp [Polarity.state, collapse]

end Epistemic
