import Integration.EisensteinJZeroHeckeIdealCharacterExact
import Integration.EisensteinJZeroJacobiHeckePrimeMatchExact
import Integration.EisensteinJZeroAllGoodPrimeLocalExact
import Integration.EisensteinJZeroSplitEulerFactorExact

/-!
# Rational-prime elliptic/Hecke local Euler agreement

The finite ideal character is now multiplicative and the split Jacobi/Frobenius
factor has been proved conductor-normalized.  This owner closes the remaining
local comparison prime by prime.

* split p: the two conjugate principal ideals have character values π and
  conjugate(π), so their product is `1-a_p T+pT²`;
* inert p: the conductor-normalized generator of `(p)` is `-p`, and the unique
  prime above p has residue degree two, giving `1-(-p)T² = 1+pT²`;
* conductor primes 2,3 are absent from the coprime ideal monoid, while the
  independently-computed elliptic local factors are both one.

This is local Euler-factor agreement.  It does not by itself assert
summability/convergence of an infinite Euler product or equality of analytic
L-functions.
-/

namespace Integration.EisensteinJZeroHeckeLocalAgreementExact

open Dashi.EisensteinQuadraticAlgebraExact
open Integration.EisensteinJZeroFiniteFieldTraceExact
open Integration.EisensteinJZeroHeckeConductorExact
open Integration.EisensteinJZeroHeckeIdealNormalizationExact
open Integration.EisensteinJZeroHeckeIdealCharacterExact
open Integration.EisensteinJZeroJacobiHeckePrimeMatchExact
open Integration.EisensteinJZeroSplitEulerFactorExact
open Integration.EisensteinJZeroAllGoodPrimeLocalExact

private abbrev E := EisensteinQA

private theorem coprime_conductor_of_congruent_one
    {z : E} (hz : CongruentModHeckeConductor z 1) :
    IsCoprime z heckeConductorElement := by
  unfold CongruentModHeckeConductor at hz
  rcases hz with ⟨q, hq⟩
  refine ⟨1, -q, ?_⟩
  rw [hq]
  ring

------------------------------------------------------------------------
-- Split prime and conjugate prime ideals.
------------------------------------------------------------------------

/-- Canonical split prime ideal generated by the same Jacobi/Frobenius factor. -/
noncomputable def splitPrimeIdeal
    (p : Nat) [Fact p.Prime] (hmod : p % 3 = 1) : Ideal E :=
  jacobiFrobeniusIdeal p hmod

noncomputable def splitPrimeIdealCode
    (p : Nat) [Fact p.Prime] (hmod : p % 3 = 1) :
    HeckeCoprimeIdealSubmonoid :=
  ⟨splitPrimeIdeal p hmod, jacobiFrobeniusIdeal_coprime p hmod⟩

/-- Canonical finite ideal character agrees with the independently constructed
Jacobi/Frobenius factor. -/
theorem finiteIdealHeckeCharacter_splitPrime
    (p : Nat) [Fact p.Prime] (hmod : p % 3 = 1) :
    finiteIdealHeckeCharacter (splitPrimeIdealCode p hmod) =
      jacobiFrobeniusPrime p hmod := by
  change normalizedIdealGenerator (jacobiFrobeniusIdeal p hmod) _ = _
  symm
  exact normalizedIdealGenerator_unique
    (jacobiFrobeniusIdeal p hmod)
    (jacobiFrobeniusIdeal_coprime p hmod)
    (jacobiFrobeniusPrime p hmod) rfl
    (jacobiFrobeniusPrime_congruent_one p hmod)

private theorem conductor_congruent_star_of_congruent_one
    {z : E} (hz : CongruentModHeckeConductor z 1) :
    CongruentModHeckeConductor (star z) 1 := by
  unfold CongruentModHeckeConductor at hz ⊢
  rw [Integration.EisensteinJZeroHeckeResidueUnitsExact.heckeConductor_dvd_iff_coordinates]
    at hz ⊢
  simp only [QuadraticAlgebra.re_sub, QuadraticAlgebra.im_sub,
    QuadraticAlgebra.re_one, QuadraticAlgebra.im_one,
    QuadraticAlgebra.re_star, QuadraticAlgebra.im_star,
    sub_zero, add_zero] at hz ⊢
  rcases hz with ⟨hre2, him2, hsum3⟩
  constructor
  · exact dvd_sub hre2 him2
  constructor
  · exact dvd_neg.mpr him2
  · have h3b : (3 : Int) ∣ 3 * z.im := ⟨z.im, by ring⟩
    convert dvd_sub hsum3 h3b using 1 <;> ring

/-- Conjugate split prime ideal. -/
noncomputable def splitConjugatePrimeIdeal
    (p : Nat) [Fact p.Prime] (hmod : p % 3 = 1) : Ideal E :=
  Ideal.span ({star (jacobiFrobeniusPrime p hmod)} : Set E)

theorem splitConjugatePrimeIdeal_coprime
    (p : Nat) [Fact p.Prime] (hmod : p % 3 = 1) :
    IdealCoprimeToHeckeConductor (splitConjugatePrimeIdeal p hmod) := by
  unfold IdealCoprimeToHeckeConductor heckeConductorIdeal splitConjugatePrimeIdeal
  exact (Ideal.isCoprime_span_singleton_iff _ _).2
    (coprime_conductor_of_congruent_one
      (conductor_congruent_star_of_congruent_one
        (jacobiFrobeniusPrime_congruent_one p hmod)))

noncomputable def splitConjugatePrimeIdealCode
    (p : Nat) [Fact p.Prime] (hmod : p % 3 = 1) :
    HeckeCoprimeIdealSubmonoid :=
  ⟨splitConjugatePrimeIdeal p hmod,
    splitConjugatePrimeIdeal_coprime p hmod⟩

/-- Character value at the conjugate prime is the conjugate Frobenius factor. -/
theorem finiteIdealHeckeCharacter_splitConjugatePrime
    (p : Nat) [Fact p.Prime] (hmod : p % 3 = 1) :
    finiteIdealHeckeCharacter (splitConjugatePrimeIdealCode p hmod) =
      star (jacobiFrobeniusPrime p hmod) := by
  change normalizedIdealGenerator (splitConjugatePrimeIdeal p hmod) _ = _
  symm
  exact normalizedIdealGenerator_unique
    (splitConjugatePrimeIdeal p hmod)
    (splitConjugatePrimeIdeal_coprime p hmod)
    (star (jacobiFrobeniusPrime p hmod)) rfl
    (conductor_congruent_star_of_congruent_one
      (jacobiFrobeniusPrime_congruent_one p hmod))

------------------------------------------------------------------------
-- Inert prime ideal.
------------------------------------------------------------------------

/-- Normalized inert-prime Hecke value. -/
def inertHeckeFactor (p : Nat) : E := -(p : E)

private theorem inertHeckeFactor_coordinates (p : Nat) :
    inertHeckeFactor p = asQuadraticAlgebra (-(p : Int)) 0 := by
  ext <;> simp [inertHeckeFactor, asQuadraticAlgebra]

/-- For p>3, p=2 mod3, `-p` is exactly one modulo the conductor. -/
theorem inertHeckeFactor_congruent_one
    (p : Nat) [Fact p.Prime] (hp3 : 3 < p) (hmod : p % 3 = 2) :
    CongruentModHeckeConductor (inertHeckeFactor p) 1 := by
  unfold CongruentModHeckeConductor
  rw [Integration.EisensteinJZeroHeckeResidueUnitsExact.heckeConductor_dvd_iff_coordinates]
  rw [inertHeckeFactor_coordinates]
  simp only [QuadraticAlgebra.re_sub, QuadraticAlgebra.im_sub,
    QuadraticAlgebra.re_one, QuadraticAlgebra.im_one,
    asQuadraticAlgebra, sub_zero, add_zero]
  have hp2 : p ≠ 2 := by omega
  obtain ⟨k, hk⟩ := Fact.out.odd_of_ne_two hp2
  have hpmod : p % 3 + 3 * (p / 3) = p := Nat.mod_add_div p 3
  refine ⟨?_, by simp, ?_⟩
  · refine ⟨-(k + 1 : Int), ?_⟩
    exact_mod_cast hk
    omega
  · refine ⟨-((p / 3 : Nat) : Int) - 1, ?_⟩
    have hm : p = 2 + 3 * (p / 3) := by omega
    exact_mod_cast hm
    ring

/-- Principal inert ideal. -/
noncomputable def inertPrimeIdeal
    (p : Nat) : Ideal E := Ideal.span ({inertHeckeFactor p} : Set E)

theorem inertPrimeIdeal_coprime
    (p : Nat) [Fact p.Prime] (hp3 : 3 < p) (hmod : p % 3 = 2) :
    IdealCoprimeToHeckeConductor (inertPrimeIdeal p) := by
  unfold IdealCoprimeToHeckeConductor heckeConductorIdeal inertPrimeIdeal
  exact (Ideal.isCoprime_span_singleton_iff _ _).2
    (coprime_conductor_of_congruent_one
      (inertHeckeFactor_congruent_one p hp3 hmod))

noncomputable def inertPrimeIdealCode
    (p : Nat) [Fact p.Prime] (hp3 : 3 < p) (hmod : p % 3 = 2) :
    HeckeCoprimeIdealSubmonoid :=
  ⟨inertPrimeIdeal p, inertPrimeIdeal_coprime p hp3 hmod⟩

/-- Exact inert prime value of the finite ideal character. -/
theorem finiteIdealHeckeCharacter_inertPrime
    (p : Nat) [Fact p.Prime] (hp3 : 3 < p) (hmod : p % 3 = 2) :
    finiteIdealHeckeCharacter (inertPrimeIdealCode p hp3 hmod) =
      inertHeckeFactor p := by
  change normalizedIdealGenerator (inertPrimeIdeal p) _ = _
  symm
  exact normalizedIdealGenerator_unique
    (inertPrimeIdeal p)
    (inertPrimeIdeal_coprime p hp3 hmod)
    (inertHeckeFactor p) rfl
    (inertHeckeFactor_congruent_one p hp3 hmod)

/-- Element norm of the inert ideal generator is p², the residue-degree-two
norm expected for the unique prime above an inert rational p. -/
theorem inertHeckeFactor_norm
    (p : Nat) : QuadraticAlgebra.norm (inertHeckeFactor p) = (p : Int) ^ 2 := by
  rw [inertHeckeFactor_coordinates, norm_asQuadraticAlgebra]
  simp [eisensteinNorm]
  ring

------------------------------------------------------------------------
-- Rational-prime local Euler comparison.
------------------------------------------------------------------------

/-- Same elliptic good-prime polynomial, scalar-extended to the Eisenstein
carrier. -/
def ellipticGoodPrimeEulerPolynomialEisenstein
    (p : Nat) [Fact p.Prime] (_hp3 : 3 < p) (T : E) : E :=
  1 - algebraMap Int E (jZeroFrobeniusTraceInt (ZMod p)) * T +
    algebraMap Int E p * T ^ 2

private theorem goodPrime_mod_three_cases
    (p : Nat) [Fact p.Prime] (hp3 : 3 < p) :
    p % 3 = 1 ∨ p % 3 = 2 := by
  have hnot0 : p % 3 ≠ 0 := by
    intro h0
    have h3dvd : 3 ∣ p := Nat.dvd_of_mod_eq_zero h0
    rcases (Nat.dvd_prime Fact.out).1 h3dvd with h31 | h3p
    · norm_num at h31
    · omega
  have hlt : p % 3 < 3 := Nat.mod_lt p (by norm_num)
  omega

/-- Rational-prime Hecke denominator assembled from the prime ideals above p. -/
noncomputable def heckeRationalPrimeEulerPolynomial
    (p : Nat) [Fact p.Prime] (hp3 : 3 < p) (T : E) : E := by
  rcases goodPrime_mod_three_cases p hp3 with hsplit | hinert
  · exact
      (1 - finiteIdealHeckeCharacter (splitPrimeIdealCode p hsplit) * T) *
      (1 - finiteIdealHeckeCharacter (splitConjugatePrimeIdealCode p hsplit) * T)
  · exact 1 - finiteIdealHeckeCharacter (inertPrimeIdealCode p hp3 hinert) * T ^ 2

/-- Exact same-curve local equality at every rational good prime. -/
theorem hecke_elliptic_goodPrime_local_agreement
    (p : Nat) [Fact p.Prime] (hp3 : 3 < p) (T : E) :
    heckeRationalPrimeEulerPolynomial p hp3 T =
      ellipticGoodPrimeEulerPolynomialEisenstein p hp3 T := by
  unfold heckeRationalPrimeEulerPolynomial
  rcases goodPrime_mod_three_cases p hp3 with hsplit | hinert
  · simp only [finiteIdealHeckeCharacter_splitPrime,
      finiteIdealHeckeCharacter_splitConjugatePrime]
    exact splitPrimeEulerFactor_factorization p hsplit T
  · rw [finiteIdealHeckeCharacter_inertPrime p hp3 hinert]
    unfold inertHeckeFactor ellipticGoodPrimeEulerPolynomialEisenstein
    have htrace := Integration.EisensteinJZeroInertPrimeLocalFactorExact.jZeroInertPrime_trace_zero
      p (by omega) hinert
    rw [htrace]
    simp
    ring

structure HeckeLocalAgreementBoundary where
  splitPrimeCharacterValuePaid : Bool := true
  splitConjugatePrimeCharacterValuePaid : Bool := true
  inertPrimeCharacterValuePaid : Bool := true
  inertPrimeDegreeTwoNormCarrierPaid : Bool := true
  everyGoodRationalPrimeEllipticHeckeLocalAgreementPaid : Bool := true
  conductorPrimeEllipticFactorsOnePaidElsewhere : Bool := true
  allRationalPrimeLocalAgreementReady : Bool := true
  analyticEulerProductPaid : Bool := false
  globalHeckeLSeriesPaid : Bool := false
  ellipticHeckeLSeriesAgreementPaid : Bool := false

/-- Prime-by-prime local agreement is complete; only global/analytic packaging
remains. -/
def canonicalBoundary : HeckeLocalAgreementBoundary := {}

end Integration.EisensteinJZeroHeckeLocalAgreementExact
