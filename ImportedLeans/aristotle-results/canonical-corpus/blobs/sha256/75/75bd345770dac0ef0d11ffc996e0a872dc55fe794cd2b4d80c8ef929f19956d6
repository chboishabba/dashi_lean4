                  (toString "  project modules   : [" ++ toString projRootStr ++ toString "]\n") ++
                (toString "  project partition : " ++ toString st.projectBlocks.size ++ toString " declaration(s), " ++
                    toString projFiles ++
                  toString " file(s)\n") ++
              if cfg.expandBoundary = true then "  core library     : expanded inline (expandBoundary := true)\n"
