import Synthesis.RiemannZetaMuExactAbelAC
import Synthesis.RiemannProjectiveQuarticFourWindowSignedPoleFourierTerminal

/-!
# Absolutely-continuous quartic symmetric cap

For 0 <= s0 <= S, the fourth symmetric-discrepancy primitive is generated by
a cap whose derivative is

  +(S-s)^3/6   on the left annulus x=t-s, s0<s<=S,
  0            on the inner window |x-t|<=s0,
  -(S-s)^3/6   on the right annulus x=t+s, s0<s<=S.

We define the cap as the interval primitive of this derivative.  This makes
absolute continuity theorem-bearing and avoids pretending the derivative
exists at the two inner kink points.
-/

noncomputable section

open MeasureTheory Set Filter
open scoped BigOperators Interval Real

namespace Synthesis

def quarticSymmetricCapDeriv
    (t s0 S x : ℝ) : ℝ :=
  Set.indicator (Set.Iio (t-s0))
    (fun y : ℝ => (S-(t-y))^3 / 6) x
  +
  Set.indicator (Set.Ioi (t+s0))
    (fun y : ℝ => -(S-(y-t))^3 / 6) x

theorem quarticSymmetricCapDeriv_intervalIntegrable
    (t s0 S A B : ℝ) :
    IntervalIntegrable
      (quarticSymmetricCapDeriv t s0 S)
      volume A B := by
  let fL : ℝ -> ℝ := fun y => (S-(t-y))^3 / 6
  let fR : ℝ -> ℝ := fun y => -(S-(y-t))^3 / 6
  have hL : IntervalIntegrable fL volume A B :=
    (by dsimp [fL]; fun_prop : Continuous fL).intervalIntegrable A B
  have hR : IntervalIntegrable fR volume A B :=
    (by dsimp [fR]; fun_prop : Continuous fR).intervalIntegrable A B
  have hLi := hL.indicator measurableSet_Iio
  have hRi := hR.indicator measurableSet_Ioi
  simpa [quarticSymmetricCapDeriv,fL,fR] using hLi.add hRi

def quarticSymmetricCapAC
    (t s0 S y : ℝ) : ℝ :=
  ∫ x in (t-S)..y, quarticSymmetricCapDeriv t s0 S x

theorem quarticSymmetricCapAC_absolutelyContinuous
    {t s0 S : ℝ}
    (hS : 0 <= S) :
    AbsolutelyContinuousOnInterval
      (quarticSymmetricCapAC t s0 S)
      (t-S) (t+S) := by
  have hint :=
    quarticSymmetricCapDeriv_intervalIntegrable
      t s0 S (t-S) (t+S)
  have hleft : t-S ∈ Set.uIcc (t-S) (t+S) := by
    rw [Set.uIcc_of_le (by linarith)]
    exact ⟨le_rfl, by linarith⟩
  unfold quarticSymmetricCapAC
  exact hint.absolutelyContinuousOnInterval_intervalIntegral hleft

theorem quarticSymmetricCapAC_ae_deriv
    {t s0 S : ℝ}
    (hS : 0 <= S) :
    ∀ᵐ x : ℝ,
      x ∈ Set.uIcc (t-S) (t+S) ->
      deriv (quarticSymmetricCapAC t s0 S) x
        = quarticSymmetricCapDeriv t s0 S x := by
  have hint :=
    quarticSymmetricCapDeriv_intervalIntegrable
      t s0 S (t-S) (t+S)
  have hleft : t-S ∈ Set.uIcc (t-S) (t+S) := by
    rw [Set.uIcc_of_le (by linarith)]
    exact ⟨le_rfl, by linarith⟩
  have hraw := hint.ae_hasDerivAt_integral
  filter_upwards [hraw] with x hx
  intro hmem
  exact (hx hmem (t-S) hleft).deriv

theorem quarticSymmetricCapDeriv_right
    {t s0 S s : ℝ}
    (hs0 : 0 <= s0)
    (hs : 0 <= s) :
    quarticSymmetricCapDeriv t s0 S (t+s)
      =
    if s0 < s then -(S-s)^3 / 6 else 0 := by
  unfold quarticSymmetricCapDeriv
  by_cases h : s0 < s
  · have hleft : ¬ t+s < t-s0 := by linarith
    have hright : t+s0 < t+s := by linarith
    simp [Set.indicator, hleft, hright, h]
    ring
  · have hsle : s <= s0 := le_of_not_gt h
    have hleft : ¬ t+s < t-s0 := by linarith
    have hright : ¬ t+s0 < t+s := by linarith
    simp [Set.indicator, hleft, hright, h]

theorem quarticSymmetricCapDeriv_left
    {t s0 S s : ℝ}
    (hs0 : 0 <= s0)
    (hs : 0 <= s) :
    quarticSymmetricCapDeriv t s0 S (t-s)
      =
    if s0 < s then (S-s)^3 / 6 else 0 := by
  unfold quarticSymmetricCapDeriv
  by_cases h : s0 < s
  · have hleft : t-s < t-s0 := by linarith
    have hright : ¬ t+s0 < t-s := by linarith
    simp [Set.indicator, hleft, hright, h]
    ring
  · have hsle : s <= s0 := le_of_not_gt h
    have hleft : ¬ t-s < t-s0 := by linarith
    have hright : ¬ t+s0 < t-s := by linarith
    simp [Set.indicator, hleft, hright, h]

theorem quarticSymmetricCapDeriv_reflect
    {t s0 S s : ℝ}
    (hs0 : 0 <= s0)
    (hs : 0 <= s) :
    quarticSymmetricCapDeriv t s0 S (t-s)
      =
    - quarticSymmetricCapDeriv t s0 S (t+s) := by
  rw [quarticSymmetricCapDeriv_left hs0 hs,
      quarticSymmetricCapDeriv_right hs0 hs]
  by_cases h : s0 < s <;> simp [h]

theorem quarticSymmetricCapAC_left_zero
    (t s0 S : ℝ) :
    quarticSymmetricCapAC t s0 S (t-S) = 0 := by
  simp [quarticSymmetricCapAC]

theorem quarticSymmetricCapAC_right_zero
    {t s0 S : ℝ}
    (hs0 : 0 <= s0)
    (hS : 0 <= S) :
    quarticSymmetricCapAC t s0 S (t+S) = 0 := by
  let f : ℝ -> ℝ := quarticSymmetricCapDeriv t s0 S
  have hint :
      IntervalIntegrable f volume (t-S) (t+S) :=
    quarticSymmetricCapDeriv_intervalIntegrable
      t s0 S (t-S) (t+S)
  have hleft :
      IntervalIntegrable f volume (t-S) t :=
    hint.mono_set <| by
      rw [Set.uIcc_of_le (by linarith),
          Set.uIcc_of_le (by linarith)]
      intro x hx
      exact ⟨hx.1, hx.2.trans (by linarith)⟩
  have hright :
      IntervalIntegrable f volume t (t+S) :=
    hint.mono_set <| by
      rw [Set.uIcc_of_le (by linarith),
          Set.uIcc_of_le (by linarith)]
      intro x hx
      exact ⟨(by linarith : t-S <= x), hx.2⟩
  have hleft' :
      IntervalIntegrable (fun s : ℝ => f (t-s))
        volume 0 S := by
    simpa using hleft.comp_sub_left t
  have hright' :
      IntervalIntegrable (fun s : ℝ => f (t+s))
        volume 0 S := by
    simpa using hright.comp_add_left t
  have hL :
      (∫ x in (t-S)..t, f x)
        =
      ∫ s in (0:ℝ)..S, f (t-s) := by
    symm
    simpa using
      (intervalIntegral.integral_comp_sub_mul
        (f:=f) (a:=(0:ℝ)) (b:=S)
        (c:=(1:ℝ)) (by norm_num) t)
  have hR :
      (∫ x in t..(t+S), f x)
        =
      ∫ s in (0:ℝ)..S, f (t+s) := by
    symm
    simpa using
      (intervalIntegral.integral_comp_add_left
        (f:=f) (a:=(0:ℝ)) (b:=S) t)
  unfold quarticSymmetricCapAC
  rw [← intervalIntegral.integral_add_adjacent_intervals hleft hright,
      hL,hR, ← intervalIntegral.integral_add hleft' hright']
  apply intervalIntegral.integral_eq_zero
  intro s hs
  rw [Set.uIcc_of_le hS] at hs
  rw [quarticSymmetricCapDeriv_reflect hs0 hs.1]
  ring

def QuarticFourSignedPolePair.physicalFourthCapPairAC
    {t : ℝ}
    (W : QuarticFourSignedPolePair t)
    (S : ℝ) : ℝ :=
  let s0 := quarticSignedPoleCanonicalPhysicalHalfWidth t
  zetaWindowMinusMuPair
    (t-S) (t+S)
    (quarticSymmetricCapAC t s0 S)

end Synthesis
