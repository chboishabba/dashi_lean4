    ∀ {X : 𝒰₀}
    → {E : X → 𝒰₀} {F : X → 𝒰₀}
    → (φ : (x : X) → E x → F x)
    → ((x : X) → J∞ E x → J∞ F x)
  J∞→ {_} {E} {_} φ x = λ (f : formal-disk-at x → E x) → φ x ∘ f

  {-

    a section of the bundle is mapped to
    the dependent function of its jets

  -}

  j∞ : ∀ {X : 𝒰₀}
    → (E : X → 𝒰₀)
    → Π E → Π (J∞ E)
  j∞ {X} E s = λ (x : X) (γ : formal-disk-at x) → s x

  {-
    the relative formal disk bundle
  -}

  T∞′ :
    ∀ {X : 𝒰₀}
    → (E : X → 𝒰₀)
