import Integration.E8StructuredGlueReflection
import Integration.E8StructuredGlueReflectionDeterminant
import Mathlib

/-!
# Full intrinsic E8 Weyl root datum on the structured 240 carrier

The structured carrier already has exact W(E6) x W(A2) branching.  The companion
glue owner reconstructs the E6+A2 bilinear form from inverse Cartan data and
defines one cross-branch reflection without transporting a literal E8 action.

This capstone packages the resulting rank-eight root datum:

* 240 structured roots;
* eight selected norm-two simple roots;
* E8 Cartan Gram matrix with determinant one;
* a total unique reflection relation for every simple generator;
* involution, adjacent braid and non-adjacent commutation on all 240 roots;
* a glue reflection that genuinely changes branch type.

That is the intrinsic finite E8 Weyl/root-system recognition target.  A local
independent Python/SymPy Schreier-Sims probe in
`scripts/e8_structured_glue_reflection_probe.py` additionally verifies that the
permutation group generated by the paid E6 x A2 subgroup plus the intrinsic glue
reflection has order 696729600.  That Python order is diagnostic authority, not
a Lean kernel theorem.
-/

namespace Integration.E8StructuredFullWeylRecognition

open Integration.E8StructuredTernary240E6A2Action
open Integration.E8StructuredGlueReflection
open Integration.E8StructuredGlueReflectionDeterminant

/-- Root-datum recognition interface actually paid by the source-written finite owners. -/
structure StructuredE8RootDatumRecognition : Prop where
  rootCount240 : Fintype.card StructuredTernary240 = 240
  simpleGramIsE8 :
    ∀ r s,
      simpleGram r s = if r = s then 2 else if e8Adjacent r s then -1 else 0
  simpleGramDetOne : Matrix.det e8SimpleGramMatrix = 1
  simpleReflectionTotalUnique : ∀ s x, ∃! y, simpleReflectRel s x y
  simpleReflectionInvolutive : ∀ s x z, composed2 s s x z ↔ z = x
  adjacentBraid :
    ∀ a b, e8Adjacent a b = true → ∀ x z,
      composed3 a b a x z ↔ composed3 b a b x z
  nonadjacentCommute :
    ∀ a b, a ≠ b → e8Adjacent a b = false → ∀ x z,
      composed2 a b x z ↔ composed2 b a x z
  crossBranch : ∃ x y, GlueReflects x y ∧ branchKind x ≠ branchKind y

 theorem structured_e8_root_datum_recognition : StructuredE8RootDatumRecognition where
  rootCount240 := structured_ternary_240_card
  simpleGramIsE8 := selected_simple_gram_is_e8_cartan
  simpleGramDetOne := e8_simple_gram_determinant_one
  simpleReflectionTotalUnique := every_simple_reflection_has_unique_target
  simpleReflectionInvolutive := e8_simple_reflections_involutive
  adjacentBraid := e8_adjacent_braid
  nonadjacentCommute := e8_nonadjacent_commute
  crossBranch := glue_reflection_mixes_branch_types

/-- Exact numerical group-order target independently checked by the local probe. -/
def expectedWE8Order : Nat := 696729600

def expectedWE6TimesWA2Order : Nat := 311040

theorem expected_subgroup_order_arithmetic : expectedWE6TimesWA2Order = 51840 * 6 := by
  norm_num [expectedWE6TimesWA2Order]

/-- This is intentionally a receipt type rather than a theorem: Python/SymPy
checks the generated permutation order, but Lean does not import that external
computation as kernel authority. -/
structure LocalPermutationOrderReceipt where
  subgroupOrder : Nat
  fullOrder : Nat
  subgroupOrderMatches : subgroupOrder = expectedWE6TimesWA2Order
  fullOrderMatches : fullOrder = expectedWE8Order
  deriving Repr


def localPythonOrderReceipt : LocalPermutationOrderReceipt where
  subgroupOrder := 311040
  fullOrder := 696729600
  subgroupOrderMatches := rfl
  fullOrderMatches := rfl

inductive LiteralCoordinateTransportDefinesGlue : Prop
inductive OriginalPuncturedT5IsStructured240 : Prop

 theorem intrinsic_glue_not_declared_literal_transport :
    ¬ LiteralCoordinateTransportDefinesGlue := by intro h; cases h

 theorem full_structured_e8_does_not_identify_original_t5_cut :
    ¬ OriginalPuncturedT5IsStructured240 := by intro h; cases h

structure Boundary where
  structuredRootCount240Paid : Bool
  intrinsicGlueReflectionPaid : Bool
  e8SimpleGramPaid : Bool
  e8SimpleGramDetOnePaid : Bool
  e8CoxeterActionPaid : Bool
  branchMixingPaid : Bool
  intrinsicStructuredE8RootDatumPaid : Bool
  localPythonWE8OrderDiagnosticPaid : Bool
  leanKernelWE8OrderEnumerationPaid : Bool
  originalPuncturedT5RecognitionPaid : Bool
  deriving Repr


def canonicalBoundary : Boundary where
  structuredRootCount240Paid := true
  intrinsicGlueReflectionPaid := true
  e8SimpleGramPaid := true
  e8SimpleGramDetOnePaid := true
  e8CoxeterActionPaid := true
  branchMixingPaid := true
  intrinsicStructuredE8RootDatumPaid := true
  localPythonWE8OrderDiagnosticPaid := true
  leanKernelWE8OrderEnumerationPaid := false
  originalPuncturedT5RecognitionPaid := false

end Integration.E8StructuredFullWeylRecognition
