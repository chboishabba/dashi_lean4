namespace Epistemic

open Wikidata

/-! ## Bounded accumulation -/

/-- A bounded evidence tally: a count together with the cap it saturates at. -/
structure Tally where
  /-- The largest count the accumulator can hold. -/
  cap : Nat
  /-- The current count, never above the cap. -/
  count : Nat
  /-- The bound. -/
  le_cap : count ≤ cap
  deriving Repr

/-- Reading one source: an in-scope source increments the tally, up to the cap. -/
def Tally.bump (t : Tally) (inScope : Bool) : Tally :=
  if inScope then ⟨t.cap, min t.cap (t.count + 1), Nat.min_le_left _ _⟩ else t

/-- The tally never exceeds its cap. -/
theorem tally_le_cap (t : Tally) (inScope : Bool) : (t.bump inScope).count ≤ t.cap := by
  unfold Tally.bump
  cases inScope with
  | false => simpa using t.le_cap
  | true => simp

/-- **Accumulation is monotone.** -/
theorem le_accumulate (t : Tally) (inScope : Bool) : t.count ≤ (t.bump inScope).count := by
  unfold Tally.bump
  cases inScope with
  | false => simp
  | true => simpa using Nat.le_min.2 ⟨t.le_cap, Nat.le_succ _⟩

/-- **Accumulation saturates**: once the tally is at the cap, further in-scope
sources add nothing. -/
theorem accumulate_saturates (t : Tally) (h : t.count = t.cap) :
    (t.bump true).count = t.count := by
  simp [Tally.bump, h]

/-- **An out-of-scope source does not accumulate.** -/
theorem accumulate_irrelevant (t : Tally) : t.bump false = t := by simp [Tally.bump]

/-- **The same source read under two scopes gives two different tallies.**  The
scope is a coordinate of the accumulator, not a property of the source. -/
theorem scope_changes_tally :
    ((⟨2, 0, by omega⟩ : Tally).bump true).count ≠
      ((⟨2, 0, by omega⟩ : Tally).bump false).count := by decide

/-! ## The commitment threshold -/

/-- Whether the curator has committed to acting. -/
inductive Commitment
  | deliberating
  | committed
  deriving DecidableEq, Repr, Inhabited

/-- The threshold rule: commit once the tally reaches `threshold`. -/
def commit (threshold : Nat) (t : Tally) : Commitment :=
  if threshold ≤ t.count then Commitment.committed else Commitment.deliberating

/-- **Commitment is monotone in the tally.** -/
theorem commit_mono {threshold : Nat} {s t : Tally} (h : s.count ≤ t.count)
    (hs : commit threshold s = Commitment.committed) :
    commit threshold t = Commitment.committed := by
  unfold commit at hs ⊢
  by_cases hc : threshold ≤ s.count
  · simp [Nat.le_trans hc h]
  · simp [hc] at hs

/-- **Accumulating is not committing**: one in-scope source raises the tally
while the decision stays open. -/
theorem accumulation_is_not_commitment :
    ((⟨2, 0, by omega⟩ : Tally).bump true).count = 1 ∧
      commit 2 ((⟨2, 0, by omega⟩ : Tally).bump true) = Commitment.deliberating := by
  constructor <;> decide

/-- Two in-scope sources do commit, at the same threshold. -/
theorem two_sources_commit :
    commit 2 (((⟨2, 0, by omega⟩ : Tally).bump true).bump true) = Commitment.committed := by
  decide

/-! ## The threshold is not truth

A dossier is a claim, a knowledge base and the tally the curator has built for
it.  The two theorems below are the boundary: the tally answers "have we read
enough to act?", the checker answers "does the claim hold here?", and neither
answer determines the other. -/

/-- A claim under consideration, with the evidence tally built for it. -/
structure Dossier where
  /-- The knowledge base the claim is read against. -/
  kb : KB
  /-- The claim. -/
  claim : ClassClaim
  /-- The bounded tally of in-scope sources read so far. -/
  tally : Tally

/-- Does the claim actually hold in the knowledge base? -/
def Dossier.verified (d : Dossier) : Bool := d.claim.check d.kb

/-- Has the curator committed at this threshold? -/
def Dossier.commitment (threshold : Nat) (d : Dossier) : Commitment := commit threshold d.tally

/-- The empty knowledge base. -/
def emptyKB : KB := ⟨[], []⟩

/-- A knowledge base recording `painter ⊑ artist`. -/
def paintKB : KB :=
  ⟨[⟨1028181⟩, ⟨483501⟩],
    [{ subject := ⟨1028181⟩, property := P279, value := ⟨483501⟩, rank := Rank.normal }]⟩

/-- **Crossing the threshold does not make the claim hold.**  A committed
dossier whose claim is refuted by the checker. -/
theorem committed_does_not_entail_holds :
    ∃ d : Dossier, Dossier.commitment 2 d = Commitment.committed ∧
      ¬ d.claim.Holds d.kb := by
  refine ⟨⟨emptyKB, ClassClaim.subclass ⟨1028181⟩ ⟨483501⟩, ⟨2, 2, by omega⟩⟩, by decide, ?_⟩
  exact ClassClaim.not_holds_of_check_false (by decide)

/-- **A claim can hold while the curator is still deliberating.**  Truth in the
knowledge base does not wait for the threshold. -/
theorem holds_does_not_entail_committed :
    ∃ d : Dossier, Dossier.commitment 2 d = Commitment.deliberating ∧
      d.claim.Holds d.kb := by
  refine ⟨⟨paintKB, ClassClaim.subclass ⟨1028181⟩ ⟨483501⟩, ⟨2, 0, by omega⟩⟩, by decide, ?_⟩
  exact (ClassClaim.check_iff _ _).1 (by decide)

-- @source DASHI Agda bridge (PR #555/#581/#582): bounded accumulation is not the commitment threshold, and the threshold is not truth
/-- **Commitment does not determine the evidence state.**  Two dossiers at the
same commitment whose claims are decided the other way by the checker; so no
function from commitments to evidence states can be correct. -/
theorem commitment_does_not_determine_state :
    ¬ ∃ decode : Commitment → Bool,
        ∀ d : Dossier, decode (Dossier.commitment 2 d) = d.verified := by
  rintro ⟨decode, h⟩
  have h₁ := h ⟨emptyKB, ClassClaim.subclass ⟨1028181⟩ ⟨483501⟩, ⟨2, 0, by omega⟩⟩
  have h₂ := h ⟨paintKB, ClassClaim.subclass ⟨1028181⟩ ⟨483501⟩, ⟨2, 0, by omega⟩⟩
  rw [show Dossier.commitment 2 ⟨emptyKB, ClassClaim.subclass ⟨1028181⟩ ⟨483501⟩,
      ⟨2, 0, by omega⟩⟩ = Dossier.commitment 2 ⟨paintKB,
      ClassClaim.subclass ⟨1028181⟩ ⟨483501⟩, ⟨2, 0, by omega⟩⟩ from rfl] at h₁
  rw [h₁] at h₂
  revert h₂
  decide

end Epistemic
