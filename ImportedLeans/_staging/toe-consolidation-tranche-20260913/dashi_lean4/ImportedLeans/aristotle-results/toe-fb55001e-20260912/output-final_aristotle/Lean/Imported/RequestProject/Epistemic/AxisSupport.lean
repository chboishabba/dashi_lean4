import RequestProject.Epistemic.Opposition
import RequestProject.Epistemic.ObligationAuthority

/-!
# Required axes, and why support on one axis does not pay for another

The upstream tranche points at a layer it does not build: evidence indexed by
*axis*, a list of axes that a claim is required to resolve, the notion of a
*missing* required axis, and a non-compensation theorem — strong support on the
axes you did look at is not support on the axis you did not.  It also says how
that layer should meet the governance layer: a proof that every required axis is
resolved is a legitimate producer of "technical obligations discharged", and
nothing more than that.

This module builds it.

* `Epistemic.AxisEvidenceFamily` — a support square per axis;
* `Epistemic.RequiredAxesResolved` — every required axis carries affirmative,
  unconflicted evidence, with `Epistemic.requiredAxesResolved_iff_no_missing`
  the exact reformulation in terms of `Epistemic.MissingRequiredAxis`;
* `Epistemic.not_resolved_of_missing` and
  `Epistemic.strong_support_does_not_compensate` — the non-compensation
  statement: a missing axis is fatal however strongly every other axis is
  supported;
* `Epistemic.no_resolution_from_supportCount` — sharper: resolution is not a
  function of *how many* axes are supported, because a conflicted axis is
  supported and unresolved at once;
* `Epistemic.resolved_axes_do_not_open_authority` — the governance boundary:
  discharging the technical obligations this way still leaves a closed gate
  closed.
-/

/-! ### Provenance (generated by `tools/provenance.py`)

Source mix of this module's 26 declarations: 9 traced to the DASHI Agda
bridge (`chboishabba/dashi_agda` PR #555 / #581 / #582), 0 rendering the Wikidata
data model, 17 original to this port.  The bridge-traced declarations are
marked with `-- @source` below.  Full ledger: `docs/status/PROVENANCE.md`.
-/

namespace Epistemic

/-! ## Axis-indexed evidence -/

-- @source DASHI Agda bridge (PR #555/#581/#582): axis-indexed evidence with required axes and a missing axis
/-- Evidence recorded separately on each axis of a claim. -/
abbrev AxisEvidenceFamily (Axis : Type) := Axis → SupportSquare

/-- An axis is *resolved* when its evidence is affirmative and unconflicted. -/
def AxisResolved (s : SupportSquare) : Prop := s.forPos = true ∧ s.against = false

instance : DecidablePred AxisResolved := fun s => by
  unfold AxisResolved; infer_instance

@[simp] theorem axisResolved_iff (s : SupportSquare) :
    AxisResolved s ↔ s = ⟨true, false⟩ := by
  obtain ⟨p, n⟩ := s
  cases p <;> cases n <;> simp [AxisResolved]

/-- The affirmed, conflicted and silent squares. -/
theorem axisResolved_positionOnly : AxisResolved ⟨true, false⟩ := ⟨rfl, rfl⟩

theorem not_axisResolved_conflict : ¬ AxisResolved ⟨true, true⟩ := by simp

theorem not_axisResolved_empty : ¬ AxisResolved SupportSquare.empty := by
  simp [SupportSquare.empty]

/-! ## Required axes -/

variable {Axis : Type}

-- @source DASHI Agda bridge (PR #555/#581/#582): axis-indexed evidence with required axes and a missing axis
/-- Every axis the claim is required to resolve carries affirmative,
unconflicted evidence. -/
def RequiredAxesResolved (required : List Axis) (f : AxisEvidenceFamily Axis) : Prop :=
  ∀ a ∈ required, AxisResolved (f a)

-- @source DASHI Agda bridge (PR #555/#581/#582): axis-indexed evidence with required axes and a missing axis
/-- A required axis that the evidence does not resolve. -/
def MissingRequiredAxis (required : List Axis) (f : AxisEvidenceFamily Axis) (a : Axis) : Prop :=
  a ∈ required ∧ ¬ AxisResolved (f a)

-- @source DASHI Agda bridge (PR #555/#581/#582): axis-indexed evidence with required axes and a missing axis
/-- **Resolution is exactly the absence of a missing axis.** -/
theorem requiredAxesResolved_iff_no_missing (required : List Axis) (f : AxisEvidenceFamily Axis) :
    RequiredAxesResolved required f ↔ ¬ ∃ a, MissingRequiredAxis required f a := by
  constructor
  · rintro h ⟨a, ha, hna⟩
    exact hna (h a ha)
  · intro h a ha
    by_contra hna
    exact h ⟨a, ha, hna⟩

-- @source DASHI Agda bridge (PR #555/#581/#582): support on one axis does not pay for another
/-- **Non-compensation.**  One missing required axis defeats resolution, no
matter what the evidence on the other axes says. -/
theorem not_resolved_of_missing {required : List Axis} {f : AxisEvidenceFamily Axis} {a : Axis}
    (h : MissingRequiredAxis required f a) : ¬ RequiredAxesResolved required f := by
  intro hres
  exact h.2 (hres a h.1)

/-- Dropping requirements is safe; adding them is not. -/
theorem requiredAxesResolved_of_subset {required required' : List Axis}
    {f : AxisEvidenceFamily Axis} (hsub : ∀ a ∈ required', a ∈ required)
    (h : RequiredAxesResolved required f) : RequiredAxesResolved required' f :=
  fun a ha => h a (hsub a ha)

/-! ## Three axes, and what a count cannot see -/

/-- Evidence that resolves every one of three axes. -/
def allResolved : AxisEvidenceFamily (Fin 3) := fun _ => ⟨true, false⟩

/-- Evidence that resolves two axes and is conflicted on the third. -/
def conflictedFirst : AxisEvidenceFamily (Fin 3) :=
  fun a => if a = 0 then ⟨true, true⟩ else ⟨true, false⟩

/-- Evidence that resolves two axes and is silent on the third. -/
def silentFirst : AxisEvidenceFamily (Fin 3) :=
  fun a => if a = 0 then SupportSquare.empty else ⟨true, false⟩

/-- The three axes of the running example. -/
def threeAxes : List (Fin 3) := [0, 1, 2]

theorem allResolved_resolves : RequiredAxesResolved threeAxes allResolved := by
  intro a _
  exact axisResolved_positionOnly

theorem conflictedFirst_missing : MissingRequiredAxis threeAxes conflictedFirst 0 :=
  ⟨by decide, by simp [conflictedFirst]⟩

theorem silentFirst_missing : MissingRequiredAxis threeAxes silentFirst 0 :=
  ⟨by decide, by simp [silentFirst, SupportSquare.empty]⟩

-- @source DASHI Agda bridge (PR #555/#581/#582): support on one axis does not pay for another
/-- **Strong support elsewhere does not compensate.**  Two of the three axes are
affirmed and unconflicted, and the claim is still unresolved. -/
theorem strong_support_does_not_compensate :
    (∀ a ∈ threeAxes, a ≠ 0 → AxisResolved (silentFirst a)) ∧
      ¬ RequiredAxesResolved threeAxes silentFirst := by
  refine ⟨?_, not_resolved_of_missing silentFirst_missing⟩
  intro a _ ha
  simp [silentFirst, ha]

/-- How many of the required axes carry affirmative evidence. -/
def supportCount (required : List (Fin 3)) (f : AxisEvidenceFamily (Fin 3)) : ℕ :=
  (required.filter (fun a => (f a).forPos)).length

theorem supportCount_allResolved : supportCount threeAxes allResolved = 3 := by decide

theorem supportCount_conflictedFirst : supportCount threeAxes conflictedFirst = 3 := by decide

-- @source DASHI Agda bridge (PR #555/#581/#582): support on one axis does not pay for another
/-- **Resolution is not a function of the support count.**  Both families
affirm all three axes, and exactly one of them resolves them: a conflicted axis
is counted as supported and is not resolved. -/
theorem no_resolution_from_supportCount (g : ℕ → Bool) :
    ¬ ∀ f : AxisEvidenceFamily (Fin 3),
      (g (supportCount threeAxes f) = true ↔ RequiredAxesResolved threeAxes f) := by
  intro h
  have h1 : g 3 = true := by
    have := (h allResolved).2 allResolved_resolves
    rwa [supportCount_allResolved] at this
  have h2 := h conflictedFirst
  rw [supportCount_conflictedFirst] at h2
  exact not_resolved_of_missing conflictedFirst_missing (h2.1 h1)

/-! ## The governance boundary -/

open Epistemic.Governed

-- @source DASHI Agda bridge (PR #555/#581/#582): resolved axes meet the governance layer as "obligations discharged", no more
/-- Resolving every required axis is what may discharge the technical
obligations — and nothing else. -/
def obligationOf (required : List Axis) (f : AxisEvidenceFamily Axis)
    [Decidable (RequiredAxesResolved required f)] : ObligationStatus :=
  if RequiredAxesResolved required f then ObligationStatus.discharged else ObligationStatus.open

/-- **Resolved axes discharge the obligations.** -/
theorem obligationOf_eq_discharged {required : List Axis} {f : AxisEvidenceFamily Axis}
    [Decidable (RequiredAxesResolved required f)] (h : RequiredAxesResolved required f) :
    obligationOf required f = ObligationStatus.discharged := by
  simp [obligationOf, h]

-- @source DASHI Agda bridge (PR #555/#581/#582): resolved axes meet the governance layer as "obligations discharged", no more
/-- **…and stop there.**  A claim whose required axes are all resolved, and
whose obligations are therefore discharged, is still not promoted while the gate
is closed. -/
theorem resolved_axes_do_not_open_authority (hist : List Authority.AuthEvent)
    (s : GovernedClaim) (hclosed : Authority.currentAuthority hist s.mandate = false)
    {required : List Axis} {f : AxisEvidenceFamily Axis}
    [Decidable (RequiredAxesResolved required f)] (hres : RequiredAxesResolved required f)
    (hdis : s.obligations = obligationOf required f) :
    s.obligations = ObligationStatus.discharged ∧ promoted hist s = false :=
  ⟨by rw [hdis, obligationOf_eq_discharged hres], hclosed⟩

end Epistemic
