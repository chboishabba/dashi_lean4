------------------------------------------------------------------------
-- Quadratic invariant: a function Q preserved by an operator F

record QuadraticInvariant {A : Set} (Q : A → Nat) (F : A → A) : Set where
  field
    Q-invariant : ∀ x → Q (F x) ≡ Q x

------------------------------------------------------------------------
-- Indefinite signature (axiomatized)

