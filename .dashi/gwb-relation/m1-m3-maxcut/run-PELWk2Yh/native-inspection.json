      "statement_ref": "statement:sha256:84ecb4111a9da5478bc68cf839cbef7c78fddf059c837c14fa631c07d71845f3",
      "region_ref": "document-region:source-revision:sha256:8dd2afe20c7cfb36bc1372f764b7683962e6acdfac6fe0bfa47554812d4eab00:sentence:19:4053-4141",
      "start_char": 4053,
      "end_char": 4141,
      "literal": "Indeed, Bush seems highly qualified to be the \npresident of any community’s Rotary Club."
    },
