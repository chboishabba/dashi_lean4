/-
# Rendering the modular-form graph as SVG

This file draws the graph specified in `RequestProject/ModularGraph.lean`: for `n = 1, …, 256`
the Deligne-normalised coefficient `τ(n) / n^{11/2}` of the modular discriminant
`Δ = η^24 = ∑ τ(n) qⁿ`, with the prime-power fibers highlighted.

* `tauGraphSvg` — all twenty fibers highlighted, one colour per prime;
* `tauGraphTwoThreeSvg` — only the fiber of `2` (red) and the fiber of `3` (blue).

Only the string manipulation and the floating-point coordinates live here; the mathematical
content of the picture (which points are highlighted, in which colour, how many there are, and
that the plotted values stay inside the Deligne band `|τ(n)/n^{11/2}| ≤ d(n)` and never vanish)
is proved in `RequestProject/ModularGraph.lean` and `RequestProject/RamanujanTau.lean`.
The rendered files live in `visualization/`; they are regenerated by `scripts/GenerateSvg.lean`.
-/
import RequestProject.ModularGraph

namespace ModularGraph

open PrimeFibers RamanujanTau

/-! ## Geometry -/

/-- The Deligne-normalised value `τ(n) / n^{11/2}` that is plotted vertically. -/
def plotValue (n : ℕ) : Float :=
  Float.ofInt (tau n) / (Float.ofNat n) ^ (5.5 : Float)

private def plotLeft : Float := 92.0
private def plotRight : Float := 1512.0
private def plotTop : Float := 118.0
private def plotBottom : Float := 718.0
private def yZero : Float := (plotTop + plotBottom) / 2.0
/-- Vertical pixels per unit of `τ(n)/n^{11/2}` (the plotted values all lie in `(-2, 2)`). -/
private def yScale : Float := 145.0

private def xOf (n : ℕ) : Float :=
  plotLeft + (Float.ofNat (n - 1)) * (plotRight - plotLeft) / Float.ofNat (displayN - 1)

private def yOf (n : ℕ) : Float := yZero - plotValue n * yScale

private def fmt (x : Float) : String := toString x

/-! ## SVG helpers -/

private def attr (k v : String) : String := k ++ "=\"" ++ v ++ "\""

private def rectTag (x y w h : Float) (fill : String) : String :=
  "  <rect " ++ attr "x" (fmt x) ++ " " ++ attr "y" (fmt y) ++ " " ++
    attr "width" (fmt w) ++ " " ++ attr "height" (fmt h) ++ " " ++ attr "fill" fill ++ "/>"

private def lineTag (x1 y1 x2 y2 : Float) (stroke : String) (width : Float)
    (dash : String) : String :=
  "  <line " ++ attr "x1" (fmt x1) ++ " " ++ attr "y1" (fmt y1) ++ " " ++
    attr "x2" (fmt x2) ++ " " ++ attr "y2" (fmt y2) ++ " " ++ attr "stroke" stroke ++ " " ++
    attr "stroke-width" (fmt width) ++
    (if dash = "" then "" else " " ++ attr "stroke-dasharray" dash) ++ "/>"

private def circleTag (cx cy r : Float) (fill stroke : String) : String :=
  "  <circle " ++ attr "cx" (fmt cx) ++ " " ++ attr "cy" (fmt cy) ++ " " ++
    attr "r" (fmt r) ++ " " ++ attr "fill" fill ++ " " ++ attr "stroke" stroke ++ " " ++
    attr "stroke-width" "1.2" ++ "/>"

private def textTag (x y : Float) (size : ℕ) (fill anchor weight body : String) : String :=
  "  <text " ++ attr "x" (fmt x) ++ " " ++ attr "y" (fmt y) ++ " " ++
    attr "font-family" "ui-monospace, SFMono-Regular, Menlo, monospace" ++ " " ++
    attr "font-size" (toString size) ++ " " ++ attr "font-weight" weight ++ " " ++
    attr "fill" fill ++ " " ++ attr "text-anchor" anchor ++ ">" ++ body ++ "</text>"

private def polylineTag (pts : List (Float × Float)) (stroke : String) : String :=
  "  <polyline " ++
    attr "points" (String.intercalate " " (pts.map (fun p => fmt p.1 ++ "," ++ fmt p.2))) ++
    " " ++ attr "fill" "none" ++ " " ++ attr "stroke" stroke ++ " " ++
    attr "stroke-width" "1.6" ++ " " ++ attr "stroke-dasharray" "5 4" ++ " " ++
    attr "opacity" "0.75" ++ "/>"

/-! ## The frame: axes, grid, ticks -/

private def gridSvg : String :=
  let hlines := [((-2.0 : Float), "-2.0"), (-1.5, "-1.5"), (-1.0, "-1.0"), (-0.5, "-0.5"),
      (0.5, "+0.5"), (1.0, "+1.0"), (1.5, "+1.5"), (2.0, "+2.0")].map fun (v, lbl) =>
    lineTag plotLeft (yZero - v * yScale) plotRight (yZero - v * yScale) "#e7ebf1" 1.0 "" ++
      "\n" ++
      textTag (plotLeft - 12.0) (yZero - v * yScale + 4.0) 12 "#8a94a6" "end" "400" lbl
  let vlines := [1, 32, 64, 96, 128, 160, 192, 224, 256].map fun n =>
    lineTag (xOf n) plotTop (xOf n) plotBottom "#f1f4f8" 1.0 "" ++ "\n" ++
      textTag (xOf n) (plotBottom + 20.0) 12 "#8a94a6" "middle" "400" (toString n)
  String.intercalate "\n" hlines ++ "\n" ++ String.intercalate "\n" vlines ++ "\n" ++
    lineTag plotLeft yZero plotRight yZero "#9aa4b2" 1.4 "" ++ "\n" ++
    textTag (plotLeft - 12.0) (yZero + 4.0) 12 "#8a94a6" "end" "400" "0" ++ "\n" ++
    textTag ((plotLeft + plotRight) / 2.0) (plotBottom + 44.0) 13 "#4b5563" "middle" "500"
      "n" ++ "\n" ++
    textTag plotLeft (plotTop - 16.0) 13 "#4b5563" "start" "500"
      "\u03c4(n) / n^(11/2)   (Deligne-normalised coefficient of \u0394 = \u03b7\u00b2\u2074)"

/-! ## The data points -/

/-- Highlighted points can be only a few pixels apart, so their numerals are staggered over
three levels. -/
private def labelOffset (colFn : ℕ → String) (n : ℕ) : Float :=
  let k := ((List.range n).countP (fun m => colFn (m + 1) ≠ neutralColor)) % 3
  12.0 + 12.0 * Float.ofNat k

/-- One plotted point: a stem down to the axis and a dot, coloured if `n` is highlighted. -/
private def pointSvg (colFn : ℕ → String) (n : ℕ) : String :=
  let c := colFn n
  let x := xOf n
  let y := yOf n
  if c = neutralColor then
    lineTag x yZero x y "#dfe4ec" 1.0 "" ++ "\n" ++ circleTag x y 1.9 "#b9c1cd" "#b9c1cd"
  else
    let off := labelOffset colFn n
    lineTag x yZero x y c 2.0 "" ++ "\n" ++ circleTag x y 4.2 c "#ffffff" ++ "\n" ++
      textTag x (if plotValue n ≥ 0.0 then y - off else y + off + 6.0) 11 "#374151" "middle"
        "600" (toString n)

private def pointsSvg (colFn : ℕ → String) : String :=
  String.intercalate "\n" ((List.range displayN).map (fun i => pointSvg colFn (i + 1)))

/-- The points `p, p², p³, …` of one fiber, joined by a dashed line of the fiber's colour. -/
private def fiberTrailSvg (p : ℕ) : String :=
  let ks := (List.range 9).filterMap fun k =>
    if 1 ≤ k && p ^ k ≤ displayN then some (p ^ k) else none
  if ks.length ≤ 1 then "" else polylineTag (ks.map fun n => (xOf n, yOf n)) (fiberColor p)

private def trailsSvg (ps : List ℕ) : String :=
  String.intercalate "\n" ((ps.map fiberTrailSvg).filter (fun s => s ≠ ""))

/-! ## Legends and the document -/

private def legendEntry (x y : Float) (color label : String) : String :=
  circleTag (x + 7.0) (y + 7.0) 5.0 color "#ffffff" ++ "\n" ++
    textTag (x + 20.0) (y + 12.0) 12 "#374151" "start" "500" label

private def legendSvg (y0 : Float) (entries : List (String × String)) (perRow : ℕ)
    (colWidth : Float) : String :=
  String.intercalate "\n"
    (entries.zipIdx.map fun (e, i) =>
      legendEntry (plotLeft + Float.ofNat (i % perRow) * colWidth)
        (y0 + Float.ofNat (i / perRow) * 26.0) e.1 e.2)

private def svgDoc (width height : Float) (title subtitle body : String) : String :=
  "<svg xmlns=\"http://www.w3.org/2000/svg\" " ++
    attr "width" (fmt width) ++ " " ++ attr "height" (fmt height) ++ " " ++
    attr "viewBox" ("0 0 " ++ fmt width ++ " " ++ fmt height) ++ ">\n" ++
  rectTag 0.0 0.0 width height "#ffffff" ++ "\n" ++
  textTag 92.0 46.0 22 "#111827" "start" "700" title ++ "\n" ++
  textTag 92.0 72.0 14 "#4b5563" "start" "400" subtitle ++ "\n" ++
  body ++ "\n</svg>\n"

/-! ## The two pictures -/

/-- The graph of `τ(n)/n^{11/2}` for `n ≤ 256`, with all twenty prime-power fibers
highlighted. -/
def tauGraphSvg : String :=
  svgDoc 1604.0 900.0
    "Modular discriminant \u0394 = \u03b7\u00b2\u2074 = \u2211 \u03c4(n) q\u207f: the fibers of the first twenty primes"
    ("each point is n \u21a6 \u03c4(n)/n^(11/2) for n \u2264 256; a point is coloured exactly when" ++
      " n = p^k (k \u2265 1) for one of the first twenty primes p")
    (gridSvg ++ "\n" ++ pointsSvg pointColor ++ "\n" ++ trailsSvg primeList ++ "\n" ++
      legendSvg (plotBottom + 70.0)
        (primeList.map (fun p => (fiberColor p, toString p ++ "^k")) ++
          [(neutralColor, "other n")]) 7 200.0)

/-- The same graph with only the fiber of `2` (red) and the fiber of `3` (blue)
highlighted. -/
def tauGraphTwoThreeSvg : String :=
  svgDoc 1604.0 850.0
    "Modular discriminant \u0394 = \u03b7\u00b2\u2074: the fibers of 2 and 3"
    ("each point is n \u21a6 \u03c4(n)/n^(11/2) for n \u2264 256; red = 2^k, blue = 3^k, grey =" ++
      " neither")
    (gridSvg ++ "\n" ++ pointsSvg twoThreePointColor ++ "\n" ++ trailsSvg [2, 3] ++ "\n" ++
      legendSvg (plotBottom + 70.0)
        [(redColor, "2^k  (fiber of 2)"), (blueColor, "3^k  (fiber of 3)"),
          (neutralColor, "not a power of 2 or 3")] 3 300.0)

end ModularGraph
