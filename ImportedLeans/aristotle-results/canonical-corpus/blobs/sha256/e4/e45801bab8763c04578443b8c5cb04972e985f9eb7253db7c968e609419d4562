namespace Wikidata

/-- Every statement of the knowledge base has normal rank. -/
def AllNormal (kb : KB) : Prop := ∀ st ∈ kb.statements, st.rank = Rank.normal

theorem hasPreferred_eq_false_of_allNormal {kb : KB} (h : AllNormal kb) (s : Qid) (p : Pid) :
    hasPreferred kb s p = false := by
  simp only [hasPreferred, statementsFor, List.any_filter]
  rw [Bool.eq_false_iff]
  intro hany
  simp only [List.any_eq_true] at hany
  obtain ⟨st, hst, hcond⟩ := hany
  have : st.rank = Rank.normal := h st hst
  revert hcond
  simp [this]

theorem isTruthy_of_allNormal {kb : KB} (h : AllNormal kb) {st : Statement}
    (hst : st ∈ kb.statements) : IsTruthy kb st = true := by
  have hn : st.rank = Rank.normal := h st hst
  exact isTruthy_normal_of_not_hasPreferred kb st hn
    (hasPreferred_eq_false_of_allNormal h st.subject st.property)

theorem allNormal_of_subset {kb₁ kb₂ : KB} (h : kb₁.statements ⊆ kb₂.statements)
    (h₂ : AllNormal kb₂) : AllNormal kb₁ := fun st hst => h₂ st (h hst)

/-! ## Monotonicity in the statement list -/

theorem subclassEdges_mono {kb₁ kb₂ : KB} (hsub : kb₁.statements ⊆ kb₂.statements)
    (h₂ : AllNormal kb₂) {a b : Qid} (h : (a, b) ∈ subclassEdges kb₁) :
    (a, b) ∈ subclassEdges kb₂ := by
  simp only [subclassEdges, List.mem_map, List.mem_filter, decide_eq_true_eq] at h ⊢
  obtain ⟨st, ⟨hst, hp, _⟩, heq⟩ := h
  exact ⟨st, ⟨hsub hst, hp, isTruthy_of_allNormal h₂ (hsub hst)⟩, heq⟩

theorem instanceEdges_mono {kb₁ kb₂ : KB} (hsub : kb₁.statements ⊆ kb₂.statements)
    (h₂ : AllNormal kb₂) {x c : Qid} (h : (x, c) ∈ instanceEdges kb₁) :
    (x, c) ∈ instanceEdges kb₂ := by
  simp only [instanceEdges, List.mem_map, List.mem_filter, decide_eq_true_eq] at h ⊢
  obtain ⟨st, ⟨hst, hp, _⟩, heq⟩ := h
  exact ⟨st, ⟨hsub hst, hp, isTruthy_of_allNormal h₂ (hsub hst)⟩, heq⟩

/-- Derived subclass facts survive enlarging the knowledge base. -/
theorem subclassOf_mono {kb₁ kb₂ : KB} (hsub : kb₁.statements ⊆ kb₂.statements)
    (h₂ : AllNormal kb₂) {a b : Qid} (h : SubclassOf kb₁ a b) : SubclassOf kb₂ a b := by
  induction h with
  | refl => exact Relation.ReflTransGen.refl
  | tail _ hstep ih => exact Relation.ReflTransGen.tail ih (subclassEdges_mono hsub h₂ hstep)

/-- Derived instance facts survive enlarging the knowledge base. -/
theorem instanceOf_mono {kb₁ kb₂ : KB} (hsub : kb₁.statements ⊆ kb₂.statements)
    (h₂ : AllNormal kb₂) {x c : Qid} (h : InstanceOf kb₁ x c) : InstanceOf kb₂ x c := by
  obtain ⟨c₀, hc₀, hs⟩ := h
  exact ⟨c₀, instanceEdges_mono hsub h₂ hc₀, subclassOf_mono hsub h₂ hs⟩

/-- Restricting the statement list preserves validity. -/
theorem valid_of_subset {kb₁ kb₂ : KB} (hents : kb₁.entities = kb₂.entities)
    (hsub : kb₁.statements ⊆ kb₂.statements) (h₂ : AllNormal kb₂) (hvalid : Valid kb₂) :
    Valid kb₁ := by
  refine ⟨fun st hst => ?_, ?_⟩
  · rw [hents]
    exact hvalid.1 st (hsub hst)
  · rintro a ha ⟨b, hab, hba⟩
    refine hvalid.2 a (hents ▸ ha) ⟨b, subclassEdges_mono hsub h₂ hab, ?_⟩
    exact subclassOf_mono hsub h₂ hba

/-! ## Provenance slices -/

/-- Which provenance slice of a knowledge base is under consideration. -/
inductive Slice
  | asserted
  | sourced
  | reliable
  deriving DecidableEq, Repr, Inhabited

-- @source DASHI Agda bridge (PR #555/#581/#582): provenance / temporal context slices
/-- A knowledge base whose statements carry references, together with a
reliability judgement on sources. -/
structure Provenanced where
  base : KB
  refs : Statement → List String
  reliableSource : String → Bool

namespace Provenanced

/-- Membership test of a statement in a slice. -/
def keep (p : Provenanced) : Slice → Statement → Bool
  | Slice.asserted, _ => true
  | Slice.sourced, st => !(p.refs st).isEmpty
  | Slice.reliable, st => (p.refs st).any p.reliableSource

/-- The knowledge base restricted to a slice. -/
def slice (p : Provenanced) (s : Slice) : KB :=
  { p.base with statements := p.base.statements.filter (p.keep s) }

@[simp] theorem slice_entities (p : Provenanced) (s : Slice) :
    (p.slice s).entities = p.base.entities := rfl

theorem slice_subset (p : Provenanced) (s : Slice) :
    (p.slice s).statements ⊆ p.base.statements := by
  intro st hst
  exact List.mem_of_mem_filter hst

/-- The reliable slice is contained in the sourced slice. -/
theorem reliable_subset_sourced (p : Provenanced) :
    (p.slice Slice.reliable).statements ⊆ (p.slice Slice.sourced).statements := by
  intro st hst
  simp only [slice, List.mem_filter, keep] at hst ⊢
  refine ⟨hst.1, ?_⟩
  obtain ⟨r, hr, _⟩ := List.any_eq_true.1 hst.2
  simp only [Bool.not_eq_true', List.isEmpty_eq_false_iff]
  exact List.ne_nil_of_mem hr

@[simp] theorem slice_asserted (p : Provenanced) : p.slice Slice.asserted = p.base := by
  cases p with
  | mk base refs rel =>
      cases base with
      | mk ents sts => simp [slice, keep]

/-- Evidence from a reliable slice transfers to the full knowledge base. -/
theorem subclassOf_of_slice (p : Provenanced) (s : Slice) (hnormal : AllNormal p.base)
    {a b : Qid} (h : SubclassOf (p.slice s) a b) : SubclassOf p.base a b :=
  subclassOf_mono (p.slice_subset s) hnormal h

theorem instanceOf_of_slice (p : Provenanced) (s : Slice) (hnormal : AllNormal p.base)
    {x c : Qid} (h : InstanceOf (p.slice s) x c) : InstanceOf p.base x c :=
  instanceOf_mono (p.slice_subset s) hnormal h

/-- Slicing preserves validity. -/
theorem valid_slice (p : Provenanced) (s : Slice) (hnormal : AllNormal p.base)
    (hvalid : Valid p.base) : Valid (p.slice s) :=
  valid_of_subset (kb₁ := p.slice s) (kb₂ := p.base) rfl (p.slice_subset s) hnormal hvalid

end Provenanced

/-! ## Temporal snapshots -/

-- @source DASHI Agda bridge (PR #555/#581/#582): provenance / temporal context slices
/-- A knowledge base whose statements carry a validity interval `[start, stop)`. -/
structure Timed where
  base : KB
  start : Statement → Nat
  stop : Statement → Nat

namespace Timed

/-- The knowledge base as of instant `n`. -/
def snapshot (t : Timed) (n : Nat) : KB :=
  { t.base with statements := t.base.statements.filter (fun st => t.start st ≤ n ∧ n < t.stop st) }

@[simp] theorem snapshot_entities (t : Timed) (n : Nat) :
    (t.snapshot n).entities = t.base.entities := rfl

/-- A snapshot only ever removes statements. -/
theorem snapshot_subset (t : Timed) (n : Nat) :
    (t.snapshot n).statements ⊆ t.base.statements :=
  fun _ hst => List.mem_of_mem_filter hst

/-- A snapshot derives no new facts. -/
theorem subclassOf_of_snapshot (t : Timed) (n : Nat) (hnormal : AllNormal t.base)
    {a b : Qid} (h : SubclassOf (t.snapshot n) a b) : SubclassOf t.base a b :=
  subclassOf_mono (t.snapshot_subset n) hnormal h

/-- Snapshots preserve validity. -/
theorem valid_snapshot (t : Timed) (n : Nat) (hnormal : AllNormal t.base)
    (hvalid : Valid t.base) : Valid (t.snapshot n) :=
  valid_of_subset (kb₁ := t.snapshot n) (kb₂ := t.base) rfl (t.snapshot_subset n) hnormal hvalid

end Timed

end Wikidata
