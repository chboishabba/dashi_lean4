  elimProp (λ _ → squash/ _ _) λ a → cong [_] (Iso.sec (fst ϕ) a)
Iso.ret (fst (Hom/Iso ϕ ϕ' ψ')) =
  elimProp (λ _ → squash/ _ _) λ a → cong [_] (Iso.ret (fst ϕ) a)
