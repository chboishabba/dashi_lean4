p ≢ q = p ≡ q → ⊥

gcdTable : SSP → SSP → Nat
gcdTable p q with p ≟ q
... | yes _ = toNat p
... | no _  = 1

gcdTable-distinct :
  ∀ p q →
  p ≢ q →
  gcdTable p q ≡ 1
gcdTable-distinct p q p≢q with p ≟ q
... | yes p≡q = ⊥-elim (p≢q p≡q)
... | no _    = refl

