import Mathlib
import Integration.Experiment.BestReading

/-!
# Stage 5, lane 4 — measurement choice beyond the affine case

`TOE_STAGE4_INFERENCE.md` frontier item 5 records:

> **The next-measurement optimisation is affine-only.**  `steepest` … is proved
> optimal over that list, but only for a family *affine* in the parameter … There
> is still no analogue for nonlinear parameter dependence.

This file supplies the analogue, in the only form that is actually true: a
*guarantee*, not an ordering of regions.

## The object

`SeparationModulus F t L θstar` says the family's predictions at time `t`
separate the parameter at least linearly around `θstar`:

```
L · |θ − θ*|  ≤  |predict θ t − predict θ* t|      for every prior θ.
```

This is a hypothesis about the model, discharged for affine families by
`affine_separationModulus` and available for nonlinear ones as well; it does not
require monotonicity, differentiability or a slope.

| Theorem | Content |
|---|---|
| `compatible_subset_Icc_of_modulus` | one reading with modulus `L > 0` confines the surviving region to `[θ* − tol/L, θ* + tol/L]` — the nonlinear replacement for `affineConstraint_eq_Icc` |
| `affine_separationModulus` | an affine family has modulus `\|slope\|`, so the Stage-4 affine result is the special case |
| `separationModulus_mono` | a modulus is a *lower* bound: any smaller positive value is one too |
| `guaranteedRadius_antitone` | a larger modulus is a smaller guaranteed radius |
| `mostSeparating_guarantee_is_best` | selecting the candidate of maximal declared modulus (reusing the Stage-4 selector) gives the smallest guaranteed radius offered |
| `mostSeparating_region_within_guarantee` | and the surviving region really is inside that radius |

## The honest negatives

| Theorem | Content |
|---|---|
| `bigger_modulus_does_not_contract_more` | a bigger modulus does **not** give a smaller surviving region: the modulus is a lower bound, so a weakly certified but sharply discriminating reading can beat a strongly certified one.  The affine ordering result does not survive the move to moduli |
| `guarantee_is_vacuous_at_zero_modulus` | with modulus `0` the guarantee says nothing, and that case is real: a reading blind to the parameter has no positive modulus |

Together: in the nonlinear case one can rank measurements by *what they
guarantee*, and that is strictly weaker than ranking them by the regions they
produce.
-/

namespace Integration.Experiment.NonlinearDiscrimination

open Integration.Experiment.ParameterRegion
open Integration.Experiment.BestReading
open Set

/-! ## §1 The separation modulus -/

/-- **A separation modulus.**  At time `t` the family's predictions separate the
parameter from `θstar` at least linearly with constant `L`. -/
def SeparationModulus (F : ParamFamily ℝ) (t L θstar : ℝ) : Prop :=
  ∀ θ ∈ F.prior, L * |θ - θstar| ≤ |F.predict θ t - F.predict θstar t|

/-- A modulus is a lower bound, so any smaller nonnegative constant is one
too. -/
theorem separationModulus_mono {F : ParamFamily ℝ} {t L L' θstar : ℝ}
    (h : SeparationModulus F t L θstar) (hL' : L' ≤ L) :
    SeparationModulus F t L' θstar := by
  intro θ hθ
  exact le_trans (mul_le_mul_of_nonneg_right hL' (abs_nonneg _)) (h θ hθ)

/-- An affine family separates with modulus `|slope t|`. -/
theorem affine_separationModulus (prior : Set ℝ) (base slope : ℝ → ℝ) (t θstar : ℝ) :
    SeparationModulus (affineFamily prior base slope) t |slope t| θstar := by
  intro θ _
  have h : base t + slope t * θ - (base t + slope t * θstar) = slope t * (θ - θstar) := by ring
  simp only [affineFamily, h, abs_mul]
  exact le_refl _

/-- The radius a reading of tolerance `tol` guarantees at modulus `L`. -/
noncomputable def guaranteedRadius (tol L : ℝ) : ℝ := tol / L

/-- **A larger modulus is a smaller guaranteed radius.** -/
theorem guaranteedRadius_antitone {tol L₁ L₂ : ℝ} (htol : 0 ≤ tol) (h1 : 0 < L₁)
    (h : L₁ ≤ L₂) : guaranteedRadius tol L₂ ≤ guaranteedRadius tol L₁ :=
  div_le_div_of_nonneg_left htol h1 h

/-! ## §2 What one reading guarantees -/

/-- **The nonlinear contraction guarantee.**  A reading generated by `θstar` at a
time where the family separates with modulus `L > 0` confines the surviving
region to the interval of half-width `tol / L` around `θstar`. -/
theorem compatible_subset_Icc_of_modulus (F : ParamFamily ℝ) (r : Reading) (L θstar : ℝ)
    (hL : 0 < L) (hmod : SeparationModulus F r.time L θstar)
    (hgen : r.value = F.predict θstar r.time) :
    Compatible F [r] ⊆
      Icc (θstar - guaranteedRadius r.tol L) (θstar + guaranteedRadius r.tol L) := by
  intro θ hθ
  obtain ⟨hp, hf⟩ := hθ
  have hfit : |r.value - F.predict θ r.time| ≤ r.tol := hf r (List.mem_cons_self ..)
  rw [hgen] at hfit
  have hsep : L * |θ - θstar| ≤ |F.predict θ r.time - F.predict θstar r.time| := hmod θ hp
  have hswap : |F.predict θstar r.time - F.predict θ r.time|
      = |F.predict θ r.time - F.predict θstar r.time| := abs_sub_comm _ _
  have hbound : L * |θ - θstar| ≤ r.tol := by
    refine hsep.trans ?_
    rw [← hswap]
    exact hfit
  have habs : |θ - θstar| ≤ guaranteedRadius r.tol L := by
    rw [guaranteedRadius, le_div_iff₀ hL, mul_comm]
    exact hbound
  rw [mem_Icc]
  constructor <;> [linarith [(abs_le.1 habs).1]; linarith [(abs_le.1 habs).2]]

/-! ## §3 Choosing a measurement by what it guarantees

The Stage-4 selector `Integration.Experiment.BestReading.steepest` is reused
verbatim, with the *declared modulus* in place of the affine slope: it needs
only a real-valued function of the reading's time.
-/

variable (modulus : ℝ → ℝ)

/-- The candidate of maximal declared modulus. -/
noncomputable def mostSeparating (r : Reading) (cs : List Reading) : Reading :=
  steepest modulus r cs

/-- The selection is one of the offered candidates. -/
theorem mostSeparating_mem (r : Reading) (cs : List Reading) :
    mostSeparating modulus r cs ∈ r :: cs := steepest_mem modulus cs r

/-- **The selection gives the smallest guaranteed radius offered.** -/
theorem mostSeparating_guarantee_is_best (r : Reading) (cs : List Reading) (tol : ℝ)
    (htol : 0 ≤ tol) (hpos : ∀ c ∈ r :: cs, 0 < |modulus c.time|)
    (c : Reading) (hc : c ∈ r :: cs) :
    guaranteedRadius tol |modulus (mostSeparating modulus r cs).time|
      ≤ guaranteedRadius tol |modulus c.time| :=
  guaranteedRadius_antitone htol (hpos c hc) (steepest_maximal modulus cs r c hc)

/-- And the region really is inside the radius the selection guarantees. -/
theorem mostSeparating_region_within_guarantee (F : ParamFamily ℝ) (θstar : ℝ)
    (r : Reading) (cs : List Reading)
    (hmod : ∀ c ∈ r :: cs, SeparationModulus F c.time |modulus c.time| θstar)
    (hgen : ∀ c ∈ r :: cs, c.value = F.predict θstar c.time)
    (hpos : ∀ c ∈ r :: cs, 0 < |modulus c.time|) :
    Compatible F [mostSeparating modulus r cs] ⊆
      Icc (θstar - guaranteedRadius (mostSeparating modulus r cs).tol
              |modulus (mostSeparating modulus r cs).time|)
          (θstar + guaranteedRadius (mostSeparating modulus r cs).tol
              |modulus (mostSeparating modulus r cs).time|) :=
  compatible_subset_Icc_of_modulus F _ _ θstar
    (hpos _ (mostSeparating_mem modulus r cs))
    (hmod _ (mostSeparating_mem modulus r cs))
    (hgen _ (mostSeparating_mem modulus r cs))

/-! ## §4 The honest negatives -/

/-- A family that is *five times* as discriminating at time `0` as at time `1`,
but for which only the modulus `1` is declared at time `0`. -/
def kinkFamily : ParamFamily ℝ where
  prior := Set.univ
  predict := fun θ t => (10 - 8 * t) * θ

/-- A reading of `kinkFamily` at time `t`, generated by `θ* = 0` with tolerance
`1`. -/
def kinkReading (t : ℝ) : Reading where
  time := t
  value := 0
  tol := 1
  tol_nonneg := zero_le_one

/-- **A bigger modulus does not contract more.**  Both readings satisfy the
declared modulus stated for them, the second one's modulus is strictly larger,
and yet its surviving region is *not* contained in the first's.  A modulus is a
lower bound on discrimination, so ranking measurements by it ranks guarantees,
not regions — the affine ordering theorem does not survive the generalisation. -/
theorem bigger_modulus_does_not_contract_more :
    SeparationModulus kinkFamily 0 1 0 ∧
    SeparationModulus kinkFamily 1 2 0 ∧
    (1 : ℝ) < 2 ∧
    ¬ (Compatible kinkFamily [kinkReading 1] ⊆ Compatible kinkFamily [kinkReading 0]) := by
  refine ⟨?_, ?_, by norm_num, ?_⟩
  · intro θ _
    show (1 : ℝ) * |θ - 0| ≤ |(10 - 8 * (0:ℝ)) * θ - (10 - 8 * (0:ℝ)) * 0|
    rw [sub_zero, one_mul]
    norm_num
    nlinarith [abs_nonneg θ]
  · intro θ _
    show (2 : ℝ) * |θ - 0| ≤ |(10 - 8 * (1:ℝ)) * θ - (10 - 8 * (1:ℝ)) * 0|
    rw [sub_zero]
    norm_num
  · intro hsub
    have hmem : (3 / 10 : ℝ) ∈ Compatible kinkFamily [kinkReading 1] := by
      refine ⟨Set.mem_univ _, fun r hr => ?_⟩
      rw [List.mem_singleton] at hr
      subst hr
      show |(0 : ℝ) - (10 - 8 * (1:ℝ)) * (3 / 10)| ≤ (1 : ℝ)
      norm_num
    obtain ⟨-, hf⟩ := hsub hmem
    have hval : |(0 : ℝ) - (10 - 8 * (0:ℝ)) * (3 / 10)| ≤ (1 : ℝ) :=
      hf (kinkReading 0) (List.mem_cons_self ..)
    norm_num at hval

/-- **The guarantee is vacuous at modulus zero**, and that case is real: a
reading whose prediction does not depend on the parameter at all admits no
positive modulus, so it guarantees nothing — exactly the situation the affine
negative `steepest_of_flat_candidates_is_no_better` describes. -/
theorem guarantee_is_vacuous_at_zero_modulus (prior : Set ℝ) (base : ℝ → ℝ) (t θstar : ℝ)
    (hne : ∃ θ ∈ prior, θ ≠ θstar) :
    SeparationModulus (affineFamily prior base (fun _ => 0)) t 0 θstar ∧
      ∀ L : ℝ, 0 < L → ¬ SeparationModulus (affineFamily prior base (fun _ => 0)) t L θstar := by
  refine ⟨fun θ _ => by simp, fun L hL hmod => ?_⟩
  obtain ⟨θ, hθ, hne'⟩ := hne
  have := hmod θ hθ
  simp only [affineFamily] at this
  have hzero : |(base t + 0 * θ) - (base t + 0 * θstar)| = 0 := by simp
  rw [hzero] at this
  have hpos : 0 < L * |θ - θstar| :=
    mul_pos hL (abs_pos.2 (sub_ne_zero.2 hne'))
  linarith

end Integration.Experiment.NonlinearDiscrimination
