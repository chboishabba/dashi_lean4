           λ f → cong ∣_∣₂ (funExt λ x → rCancelₖ n (f x))

  lCancelₕ : (x : coHom n G A) → (-ₕ x) +ₕ x ≡ 0ₕ
  lCancelₕ = ST.elim (λ _ → isSetPathImplicit)
           λ f → cong ∣_∣₂ (funExt λ x → lCancelₖ n (f x))

