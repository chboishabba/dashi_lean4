#!/usr/bin/env python3
"""Build small, viewable reports from the (large) atlas_duplicates.json.

Outputs:
  * atlas_embodiment.json     - compact, 2-3 exemplars per proof-semantics class
  * EmbodimentReport.md       - human-readable embodiment of those exemplars
  * DuplicateReport/          - a 10-page summary (page_01.md .. page_10.md + index.md)
  * atlas_user_duplicates.json - the non-autogenerated ("user code") duplicate groups

Proof-term heads (the head symbol of each member's value, with leading lambdas
stripped) are not stored in atlas_duplicates.json; they were obtained once by
reflection over the live environment (Lean 4.28 / Mathlib v4.28) and embedded in
PROOF_HEADS below so the reports are self-contained and reproducible.
"""
import json, os, textwrap
from collections import Counter

SRC = "atlas_duplicates.json"

# Head symbol of each member's proof/def value (leading lambdas stripped),
# obtained by reflection over the live environment.
PROOF_HEADS = {
    "Tropical.trop_sup_def": "rfl",
    "Tropical.trop_max_def": "rfl",
    "Nat.pow_lt_pow_right": "Iff.mpr",
    "Nat.pow_lt_pow_of_lt": "Exists.casesOn  (Nat.exists_eq_add_of_lt + Nat.mul_lt_mul_of_lt_of_le ...)",
    "IsCompact.finite_cover_balls": "const finite_cover_balls_of_compact  (proof = the other lemma)",
    "finite_cover_balls_of_compact": "finite_cover_balls_of_compact.match_1_1 (case split)",
    "Nat.zero_mul": "Nat.brecOn  (structural recursion / elaborated)",
    "Quaternion.im_one": "rfl",
    "Cubic.disc": "const Cubic.discr  (def = the renamed def)",
    "Cubic.discr": "HAdd.hAdd  (the actual discriminant expression)",
    "Metric.ediam_one": "Metric.ediam_singleton",
    "EMetric.diam_one": "const Metric.ediam_one  (proof = the renamed lemma)",
    "Quaternion.one_im": "const Quaternion.im_one  (proof = the renamed lemma)",
    "Lean.Level.param": "<no value> (constructor)",
    "Lean.mkLevelParam": "lam -> Lean.Level.param  (thin wrapper)",
    "Lean.Elab.DefKind.abbrev": "<no value> (constructor)",
    "Lean.Elab.DefKind.theorem": "<no value> (constructor)",
    "CategoryTheory.Adjunction.leftAdjointUniq_hom_counit": "CategoryTheory.NatTrans.ext'",
    "NFA._sizeOf_1": "NFA.rec  (auto sizeOf)",
}

# substrings marking a Lean/auto-generated (not user-authored) declaration name
AUTO = ['match_', '_simp_', '_sunfold', '_unsafe_rec', '_private', '_eq_',
        'proof_', '_cstage', '_sizeOf', '.brecOn', '.below', '.rec', '.injEq',
        '.funext', '.induct', '_flat_ctor', '_inherited_default', '_default',
        '.eq_', '._eq', '.mk', 'ctorIdx', '._@.', '_spec', '.hash',
        '.noConfusion', '.ofNat', '.toCtorIdx', '.ndrec', '_sorry', '._override']

def is_auto(name: str) -> bool:
    return any(b in name for b in AUTO)

def group_is_user(e) -> bool:
    return all(not is_auto(m['name']) for m in e['members'])

def load():
    with open(SRC) as f:
        return json.load(f)

def short(s, n=240):
    s = ' '.join(s.split())
    return s if len(s) <= n else s[:n] + ' …'

def member_line(m):
    h = PROOF_HEADS.get(m['name'])
    tags = []
    if m['isRfl']: tags.append('rfl')
    if m['deprecated']: tags.append('@[deprecated]')
    if not m['hasValue']: tags.append('no-value')
    tag = (' _[' + ', '.join(tags) + ']_') if tags else ''
    head = f"  · proof head: `{h}`\n" if h else ""
    ns = m['namespace'] if m['namespace'] else '_root_'
    return (f"- `{m['name']}`{tag}\n"
            f"  · namespace `{ns}`  ·  base `{m['baseName']}`\n"
            f"{head}")

# ----- exemplar selection (group ids verified against the live atlas) -----
EXEMPLARS = {
    'alias':       [0, 131],
    'independent': [70, 197],
    'rfl-variant': [839, 3074],
    'deprecated':  [83, 185, 217],
    'unknown':     [45, 252],
}
HASH_ONLY = [841, 2936, 3181]

CLASS_BLURB = {
    'alias': "Two (or more) names, often one namespace apart, carrying the **identical proof term** — one is a copy/alias of another. Look for `alias`, `abbrev`, or `theorem X := Y` patterns.",
    'independent': "Same statement fingerprint, **distinct proof trees** — the most mathematically interesting class. We show the two proof-term heads side by side.",
    'rfl-variant': "One member's proof is `Eq.refl`/`rfl`/`trivial`, the other is **elaborated**. We surface the elaborated proof head.",
    'deprecated': "At least one member carries `@[deprecated]`. We flag which one, and what it points to.",
    'unknown': "At least one member exposes **no proof value** (axiom / opaque / constructor / structural). We show the declaration kinds.",
}

def main():
    d = load()
    ent = {e['groupId']: e for e in d['entries']}
    entries = d['entries']
    bytag = Counter(e['proofTag'] for e in entries)

    # ---------- atlas_embodiment.json ----------
    emb = {
        "totalDecls": d['totalDecls'],
        "groups": d['groups'],
        "byProofSemantics": dict(bytag),
        "classes": {},
        "hashOnlyCollisions": [],
        "note": ("A 'duplicate group' is a set of declarations whose statement "
                 "type-fingerprint info.type.hash collides. structurallyEqual=false "
                 "marks a true hash collision of genuinely different statements."),
    }
    def slim(e):
        return {
            "groupId": e['groupId'],
            "fingerprint": e['fingerprint'],
            "proofTag": e['proofTag'],
            "size": e['size'],
            "syntaxIdentical": e['syntaxIdentical'],
            "structurallyEqual": e['structurallyEqual'],
            "members": [{
                "name": m['name'],
                "namespace": m['namespace'],
                "baseName": m['baseName'],
                "isRfl": m['isRfl'],
                "hasValue": m['hasValue'],
                "deprecated": m['deprecated'],
                "proofHead": PROOF_HEADS.get(m['name']),
                "statement": short(m['statement'], 400),
            } for m in e['members']],
        }
    for cls, gids in EXEMPLARS.items():
        emb["classes"][cls] = {"description": CLASS_BLURB[cls],
                               "exemplars": [slim(ent[g]) for g in gids]}
    emb["hashOnlyCollisions"] = [slim(ent[g]) for g in HASH_ONLY]

    # user (non-autogenerated) duplicates
    user = [e for e in entries if group_is_user(e)]
    user_bytag = Counter(e['proofTag'] for e in user)
    emb["userAuthoredDuplicates"] = {
        "count": len(user),
        "byProofSemantics": dict(user_bytag),
        "note": ("Groups where every member name is free of Lean's auto-generated "
                 "markers (match_/_simp_/_private/.rec/.mk/_default/…). For Prop-valued "
                 "members the shared type IS the shared statement (genuine duplicate "
                 "propositions); for plain defs a shared type signature is not by itself "
                 "a duplicate."),
    }
    with open("atlas_embodiment.json", "w") as f:
        json.dump(emb, f, indent=1)

    with open("atlas_user_duplicates.json", "w") as f:
        json.dump({"count": len(user),
                   "byProofSemantics": dict(user_bytag),
                   "groups": [slim(e) for e in user]}, f, indent=1)

    # ---------- EmbodimentReport.md ----------
    L = []
    A = L.append
    A("# Embodiment Report — duplicate classes, with exemplars\n")
    A("Sampled from the live `atlas_duplicates.json` "
      f"({d['totalDecls']:,} declarations, {d['groups']:,} duplicate groups).\n")
    A("A **duplicate group** is a set of declarations whose statement "
      "type-fingerprint `info.type.hash` collides. Each group is tagged by *how* the "
      "duplication arose. Counts across the whole corpus:\n")
    A("| class | groups |")
    A("|---|---|")
    for k in ['alias', 'independent', 'unknown', 'deprecated', 'rfl-variant']:
        A(f"| {k} | {bytag[k]:,} |")
    A("")
    for cls, gids in EXEMPLARS.items():
        A(f"## {cls}\n")
        A(CLASS_BLURB[cls] + "\n")
        for g in gids:
            e = ent[g]
            A(f"### Group {g} — fingerprint `{e['fingerprint']}` "
              f"({e['size']} members)\n")
            syn = "byte-identical statements" if e['syntaxIdentical'] else "syntax delta (pretty-prints differ)"
            seq = "structurally equal" if e['structurallyEqual'] else "**hash-only collision (types differ!)**"
            A(f"*{syn}; {seq}.*\n")
            # statement(s)
            if e['syntaxIdentical']:
                A(f"Statement: `{short(e['members'][0]['statement'])}`\n")
            for m in e['members']:
                A(member_line(m))
            A("")
    # hash-only
    A("## hash-only collisions (the couch crease)\n")
    A("Three groups share a 64-bit fingerprint but have **structurally different "
      "statements** — the hash collided, the mathematics did not. The atlas already "
      "records `structurallyEqual = false` for exactly these three, i.e. a *finer "
      "expansion than the hash* (structural `Expr` equality) immediately separates "
      "them. Any sharper view — full `Expr` walk, a different hash seed, or the "
      "pretty-print — shows the difference.\n")
    for g in HASH_ONLY:
        e = ent[g]
        A(f"### Group {g} — fingerprint `{e['fingerprint']}`\n")
        for m in e['members']:
            A(f"- `{m['name']}` — `{short(m['statement'], 160)}`")
            h = PROOF_HEADS.get(m['name'])
            if h: A(f"  · head: `{h}`")
        A("")
    with open("EmbodimentReport.md", "w") as f:
        f.write("\n".join(L))

    # ---------- 10-page report ----------
    os.makedirs("DuplicateReport", exist_ok=True)
    build_pages(d, ent, entries, bytag, user, user_bytag)
    print("done. user duplicate groups:", len(user), dict(user_bytag))


def build_pages(d, ent, entries, bytag, user, user_bytag):
    P = {}
    def page(n, title, body):
        P[n] = f"# Page {n} — {title}\n\n{body.strip()}\n"

    # Page 1
    page(1, "What this report is",
         f"""
The full machine-readable atlas lives in **`atlas_duplicates.json`** — it is ~7 MB
and not meant to be read by eye. This 10-page report is the small, viewable summary.

- Declarations scanned: **{d['totalDecls']:,}**
- Duplicate groups (≥ 2 members sharing a statement fingerprint): **{d['groups']:,}**

**What "duplicate" means here (honest scope).** Every group is a collision of the
*structural statement hash* `info.type.hash`. Members of a group always share that
fingerprint; we additionally record whether their types are **structurally equal**
(`Expr` BEq), so a rare hash collision of genuinely different statements is *flagged*,
not silently called a duplicate. For a `Prop`-valued member the shared type **is** the
shared statement; for a plain `def`, a shared type signature is *not by itself* a
duplicate (e.g. `Char.toUpper` and `Char.toLower` share the type `Char → Char`).

Companion files produced alongside this report:
- `EmbodimentReport.md` — exemplars per class, with proof-term heads.
- `atlas_embodiment.json` — the same exemplars, machine-readable.
- `atlas_user_duplicates.json` — the non-autogenerated ("user code") duplicates only.
""")

    # Page 2
    rows = "\n".join(f"| {k} | {bytag[k]:,} | {desc} |" for k, desc in [
        ("alias", "identical proof term — one is a copy/alias of another"),
        ("independent", "same statement, **distinct** proof trees"),
        ("unknown", "≥1 member has no proof value (axiom/opaque/ctor/structural)"),
        ("deprecated", "≥1 member carries `@[deprecated]`"),
        ("rfl-variant", "≥1 proof is `rfl`/`trivial`, another is elaborated"),
    ])
    page(2, "The five proof-semantics classes",
         f"""
Each group is classified by inspecting the stored proof terms. Priority when several
apply: **deprecated > alias > rfl-variant > independent > unknown**.

| class | groups | meaning |
|---|---|---|
{rows}

By syntax: **{d['bySyntax']['identical']:,}** byte-identical statements,
**{d['bySyntax']['delta']:,}** with a spelling delta, of which
**{d['bySyntax']['hashOnly']}** are pure hash collisions (see Page 9).

Pages 3–7 take each class in turn with 2–3 exemplars; Page 8 isolates the
non-autogenerated (user-written) duplicates; Page 9 dissects the hash collisions.
""")

    def exemplar_md(g):
        e = ent[g]
        out = [f"**Group {g}** — fp `{e['fingerprint']}`, {e['size']} members "
               f"({'identical' if e['syntaxIdentical'] else 'syntax delta'};"
               f" {'struct-equal' if e['structurallyEqual'] else 'HASH-ONLY'})."]
        if e['syntaxIdentical']:
            out.append(f"\nStatement: `{short(e['members'][0]['statement'])}`\n")
        for m in e['members']:
            h = PROOF_HEADS.get(m['name'])
            extra = []
            if m['isRfl']: extra.append('rfl')
            if m['deprecated']: extra.append('@[deprecated]')
            if not m['hasValue']: extra.append('no-value')
            ex = f" _[{', '.join(extra)}]_" if extra else ""
            line = f"- `{m['name']}`{ex}"
            if h: line += f" — head `{h}`"
            if not e['syntaxIdentical']:
                line += f"\n    `{short(m['statement'], 150)}`"
            out.append(line)
        return "\n".join(out)

    page(3, "Class: alias",
         "Two names, one namespace delta, **identical proof term**. The split shows the "
         "two homes of the same fact; the proof head is the same on both sides.\n\n"
         + "\n\n".join(exemplar_md(g) for g in EXEMPLARS['alias']) +
         "\n\nGroup 0 is also a *spelling* delta: `cngen` vs `cNGen` in the binder names — "
         "same fingerprint, different source text. Group 131 (`trop_sup_def` / "
         "`trop_max_def`) are both literally `rfl`: two names for one defeq fact.")

    page(4, "Class: independent (the interesting one)",
         "Same statement, **two different proofs**. Heads side by side:\n\n"
         + "\n\n".join(exemplar_md(g) for g in EXEMPLARS['independent']) +
         "\n\nGroup 70: `Nat.pow_lt_pow_right` discharges `1<a → m<n → a^m<a^n` via "
         "`Iff.mpr`, while `Nat.pow_lt_pow_of_lt` builds the same fact from "
         "`Nat.exists_eq_add_of_lt` + an explicit `Exists.casesOn` — genuinely "
         "independent derivations of one theorem.\n\n"
         "Group 197 is subtler: `IsCompact.finite_cover_balls`'s proof term is literally "
         "`const finite_cover_balls_of_compact` — it *is* the other lemma by reference, "
         "yet the classifier calls the group `independent` because the two stored terms "
         "are not byte-identical (one is a `const`, one is a `match`). A reminder that "
         "`independent` means *distinct proof terms*, not *unrelated proofs*.\n\n"
         "**Caveat for `def`s.** Many `independent` groups are plain definitions that "
         "merely share a type signature (e.g. `Char.toUpper`/`toLower : Char → Char`, "
         "`Int32.lor`/`land`/`xor`). Those are not duplicate *statements* — only "
         "`Prop`-valued members give genuine duplicate theorems.")

    page(5, "Class: rfl-variant",
         "One side is `rfl`/`trivial`, the other is elaborated. We surface the "
         "elaborated head.\n\n"
         + "\n\n".join(exemplar_md(g) for g in EXEMPLARS['rfl-variant']) +
         "\n\nGroup 839: the compiler's internal `arithmeticFolders._proof_18` proves "
         "`∀ a, 0*a = 0` by `rfl`, while the public `Nat.zero_mul` proves the same shape "
         "through structural recursion (`Nat.brecOn`). Group 3074: four `Parser → Parser` "
         "combinators land on one fingerprint; `ppDedent` is `rfl` (a pure reducible "
         "alias) while the others are elaborated parser builders.")

    page(6, "Class: deprecated",
         "At least one member is `@[deprecated]`; we flag which, and what it points to. "
         "These are the cleanest *genuine* user-side duplicates — a rename that left both "
         "names alive.\n\n"
         + "\n\n".join(exemplar_md(g) for g in EXEMPLARS['deprecated']) +
         "\n\n- Group 83: `Quaternion.one_im` is `@[deprecated]`; its proof is "
         "`const Quaternion.im_one` — the new name.\n"
         "- Group 185: `Cubic.disc` is `@[deprecated]`; its body is `const Cubic.discr`.\n"
         "- Group 217: `EMetric.diam_one` is `@[deprecated]`; its proof is "
         "`const Metric.ediam_one`.\n\nIn every case the deprecated member's proof term "
         "is *literally the surviving declaration*, so the deprecation arrow is visible "
         "directly in the proof head.")

    page(7, "Class: unknown",
         "At least one member exposes **no proof value** — an axiom, opaque, structure "
         "constructor, or other structural decl. We show the declaration kinds.\n\n"
         + "\n\n".join(exemplar_md(g) for g in EXEMPLARS['unknown']) +
         "\n\nGroup 45: `Lean.Level.param` is a **constructor** (`Name → Level`, no value) "
         "while `Lean.mkLevelParam` is a **def** wrapping it — same type, one has a body, "
         "one does not. Group 252: `DefKind.abbrev` and `DefKind.theorem` are two "
         "**constructors** of the same inductive, so both share the type `DefKind` with no "
         "proof value to compare. `unknown` is the honest 'cannot inspect the derivation' "
         "bucket.")

    # Page 8 — user duplicates
    def names(e, k=2):
        return ' ; '.join(f"`{m['name']}`" for m in e['members'][:k])
    dep_rows = "\n".join(f"| `{e['members'][0]['name']}` | `{e['members'][1]['name']}` |"
                         for e in user if e['proofTag'] == 'deprecated' and e['size'] == 2)
    dep_sample = [e for e in user if e['proofTag'] == 'deprecated' and e['size'] == 2][:14]
    def dep_pair(e):
        dep = next((m for m in e['members'] if m['deprecated']), e['members'][0])
        sur = next((m for m in e['members'] if m is not dep), e['members'][-1])
        return dep['name'], sur['name']
    dep_tbl = "\n".join((lambda p: f"| `{p[0]}` | `{p[1]}` |")(dep_pair(e))
                        for e in dep_sample)
    ind_thm = [70, 134, 197, 277]  # verified theorem (Prop) duplicate pairs
    ind_lines = "\n".join(f"- {names(ent[g])}" for g in ind_thm if g in ent)
    page(8, "Not autogenerated by Lean — user-code duplicates",
         f"""
Filtering out every group that contains a Lean-generated name (`match_`, `_simp_`,
`_private`, `.rec`, `.mk`, `_default`, `_unsafe_rec`, …) leaves **{len(user)}** groups
whose members are *all* hand-written declarations.

By class among those user-code groups:

| class | groups |
|---|---|
""" + "\n".join(f"| {k} | {user_bytag[k]} |" for k in
                ['independent', 'unknown', 'deprecated', 'alias', 'rfl-variant']) + f"""

**The honest reading.** Among these, the `deprecated` groups ({user_bytag['deprecated']})
are the clearest true duplicates: a Mathlib declaration was renamed and the old name
kept as a deprecated shim. A representative sample:

| deprecated (old / shim) | survivor |
|---|---|
{dep_tbl}

The `independent` user groups split in two: genuine **duplicate theorems** (same
`Prop`, two proofs) and mere **same-signature `def`s** (not duplicates). Verified
duplicate-theorem examples:

{ind_lines}

Full list of all {len(user)} user-code groups: **`atlas_user_duplicates.json`**.
""")

    # Page 9 — hash-only
    ho_md = []
    for g in HASH_ONLY:
        e = ent[g]
        ho_md.append(f"**Group {g}** — fp `{e['fingerprint']}` "
                     f"(`structurallyEqual = false`):")
        for m in e['members']:
            ho_md.append(f"- `{m['name']}` : `{short(m['statement'], 150)}`")
        ho_md.append("")
    page(9, "Hash-only collisions — and your question",
         f"""
Exactly **{d['bySyntax']['hashOnly']}** groups share a 64-bit fingerprint while their
statements are structurally *different*. The fingerprint collided; the mathematics did
not.

{chr(10).join(ho_md)}
Group 841 is the startling one: a category-theory adjunction-uniqueness lemma and an
auto-generated `sizeOf` for nondeterministic finite automata, landing in the same cell
purely by the geometry of `Expr.hash`. Groups 2936 and 3181 are milder — a definition
and its `._unsafe_rec` twin, differing only by `have`- vs `let`-bindings in the type.

**Your question — "if we keep looking at it from different expansions we will see a
difference, no?" — yes, exactly.** The 64-bit hash is a *lossy projection*: it folds the
whole statement tree down to one number, so distinct trees can land together. Any *finer
expansion* of the same object separates them:

1. **Structural `Expr` equality** (a full walk of the syntax tree, no folding). This is
   already what the atlas computes, and it returns `false` for all three groups — that is
   precisely "look from a finer expansion and the difference appears."
2. **A different hash seed / a second independent hash.** A collision under one seed is
   astronomically unlikely under another; two hashes together make accidental agreement
   vanish.
3. **The pretty-printed statement**, or the fully β/δ-expanded `Expr`, which differ
   visibly (an adjunction equation vs a `ℕ`-valued size function).

So a "hash-only" duplicate is never a real duplicate — it is the couch-crease artifact of
one lossy coordinate, and every sharper coordinate dissolves it. That is exactly why the
atlas pairs the hash with the structural-equality check and flags these three rather than
counting them as duplicates.
""")

    # Page 10
    page(10, "How to regenerate & where things live",
         """
**Files**
- `atlas_duplicates.json` — full atlas, one object per duplicate group (large).
- `EmbodimentReport.md` / `atlas_embodiment.json` — exemplars per class (this report's source).
- `atlas_user_duplicates.json` — the non-autogenerated duplicate groups only.
- `DuplicateGlossary.md` — the original full per-group glossary.
- `DuplicateReport/page_01.md … page_10.md` — this 10-page summary.

**Regenerate the summaries** (from the existing atlas) with:

```
python3 gen_embodiment.py
```

**Regenerate the underlying atlas** (re-scan the environment) from Lean with the commands
in `RequestProject/DuplicateGlossary.lean`: `#dupglossary` (full) or `#dupglossary_sample n`.

**One-line takeaways**
- A "duplicate" = a `info.type.hash` collision; structural equality is checked on top.
- Five classes: alias, independent, rfl-variant, deprecated, unknown.
- The genuinely user-authored duplicates are dominated by `@[deprecated]` renames.
- The 3 hash-only collisions are artifacts: every finer expansion separates them.
""")

    for n in range(1, 11):
        with open(f"DuplicateReport/page_{n:02d}.md", "w") as f:
            f.write(P[n])
    idx = ["# Duplicate Atlas — 10-page summary\n",
           "A small, viewable digest of the large `atlas_duplicates.json`.\n"]
    titles = {1: "What this report is", 2: "The five proof-semantics classes",
              3: "Class: alias", 4: "Class: independent (the interesting one)",
              5: "Class: rfl-variant", 6: "Class: deprecated", 7: "Class: unknown",
              8: "Not autogenerated by Lean — user-code duplicates",
              9: "Hash-only collisions — and your question",
              10: "How to regenerate & where things live"}
    for n in range(1, 11):
        idx.append(f"{n}. [{titles[n]}](page_{n:02d}.md)")
    with open("DuplicateReport/index.md", "w") as f:
        f.write("\n".join(idx) + "\n")


if __name__ == "__main__":
    main()
