  field
    status :
      CliffordFromP2LaneStatus

    statusIsConditionalCandidate :
      status ≡ conditionalCandidateCarrierReceipt

    phi :
      Mat2F2

    phiIsCompanionMatrix :
      phi ≡ p2LanePhiCompanionMatrix

    phiSquared :
      Mat2F2

