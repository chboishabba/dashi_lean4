namespace Wikidata

namespace BlankNodes

open Wikidata.Rdf

/-! ## §1 Syntax -/

/-- A term of a blank-node graph: either a name of `Rdf.Term`, or a blank node. -/
inductive BTerm
  | ground (t : Term)
  | blank (b : Nat)
  deriving DecidableEq, Repr, Inhabited

/-- A triple over `BTerm`. -/
structure BTriple where
  subj : BTerm
  pred : BTerm
  obj : BTerm
  deriving DecidableEq, Repr, Inhabited

/-- An RDF graph with blank nodes. -/
abbrev BGraph := List BTriple

/-- An instance mapping: an assignment of terms to blank nodes. -/
abbrev Subst := Nat → BTerm

/-- Instantiate a term. -/
def substTerm (s : Subst) : BTerm → BTerm
  | .ground t => .ground t
  | .blank b => s b

/-- Instantiate a triple. -/
def substTriple (s : Subst) (t : BTriple) : BTriple :=
  ⟨substTerm s t.subj, substTerm s t.pred, substTerm s t.obj⟩

/-- Instantiate a graph. -/
def substGraph (s : Subst) (g : BGraph) : BGraph := g.map (substTriple s)

/-- The identity instance mapping. -/
def idSubst : Subst := BTerm.blank

/-- Composition of instance mappings. -/
def comp (s₂ s₁ : Subst) : Subst := fun b => substTerm s₂ (s₁ b)

theorem substTerm_id (t : BTerm) : substTerm idSubst t = t := by
  cases t <;> rfl

theorem substTriple_id (t : BTriple) : substTriple idSubst t = t := by
  cases t; simp [substTriple, substTerm_id]

theorem substGraph_id (g : BGraph) : substGraph idSubst g = g := by
  simp only [substGraph]
  induction g with
  | nil => rfl
  | cons t ts ih => simp [substTriple_id, ih]

theorem substTerm_comp (s₂ s₁ : Subst) (t : BTerm) :
    substTerm s₂ (substTerm s₁ t) = substTerm (comp s₂ s₁) t := by
  cases t <;> rfl

theorem substTriple_comp (s₂ s₁ : Subst) (t : BTriple) :
    substTriple s₂ (substTriple s₁ t) = substTriple (comp s₂ s₁) t := by
  cases t; simp [substTriple, substTerm_comp]

theorem substGraph_comp (s₂ s₁ : Subst) (g : BGraph) :
    substGraph s₂ (substGraph s₁ g) = substGraph (comp s₂ s₁) g := by
  simp [substGraph, substTriple_comp]

/-! ## §2 Semantics -/

/-- `Models I g` — the interpretation `I`, presented as the graph of the triples
it makes true, satisfies the existential reading of `g`: some instance of `g` is
contained in `I`. -/
def Models (I g : BGraph) : Prop := ∃ s : Subst, ∀ t ∈ g, substTriple s t ∈ I

/-- Simple entailment: every model of `g` is a model of `e`. -/
def Entails (g e : BGraph) : Prop := ∀ I : BGraph, Models I g → Models I e

/-- Two graphs are equivalent when they entail one another. -/
def Equiv (g e : BGraph) : Prop := Entails g e ∧ Entails e g

/-- Every graph is its own canonical model. -/
theorem models_self (g : BGraph) : Models g g :=
  ⟨idSubst, fun t ht => by rw [substTriple_id]; exact ht⟩

theorem models_of_instance_subset {I g : BGraph} {s : Subst}
    (h : ∀ t ∈ g, substTriple s t ∈ I) : Models I g := ⟨s, h⟩

/-- **The interpolation lemma.**  Model-theoretic simple entailment is exactly the
syntactic condition that some instance of `e` is a subgraph of `g`. -/
theorem entails_iff_instance_subset (g e : BGraph) :
    Entails g e ↔ ∃ s : Subst, ∀ t ∈ e, substTriple s t ∈ g := by
  constructor
  · intro h
    exact h g (models_self g)
  · rintro ⟨s, hs⟩ I ⟨s', hs'⟩
    refine ⟨comp s' s, fun t ht => ?_⟩
    rw [← substTriple_comp]
    exact hs' _ (hs t ht)

/-! ## §3 The structural consequences -/

theorem entails_refl (g : BGraph) : Entails g g := fun _ h => h

theorem entails_trans {g e f : BGraph} (h₁ : Entails g e) (h₂ : Entails e f) :
    Entails g f := fun I hI => h₂ I (h₁ I hI)

theorem entails_of_subset {g e : BGraph} (h : ∀ t ∈ e, t ∈ g) : Entails g e := by
  rw [entails_iff_instance_subset]
  exact ⟨idSubst, fun t ht => by rw [substTriple_id]; exact h t ht⟩

/-- **Simple entailment is monotone**: extra data never withdraws a consequence. -/
theorem entails_mono {g g' e : BGraph} (hsub : ∀ t ∈ g, t ∈ g') (h : Entails g e) :
    Entails g' e := by
  rw [entails_iff_instance_subset] at h ⊢
  obtain ⟨s, hs⟩ := h
  exact ⟨s, fun t ht => hsub _ (hs t ht)⟩

/-! ## §4 Ground graphs -/

/-- A term is ground when it is not a blank node. -/
def GroundTerm : BTerm → Prop
  | .ground _ => True
  | .blank _ => False

/-- A triple is ground when all three of its terms are. -/
def GroundTriple (t : BTriple) : Prop :=
  GroundTerm t.subj ∧ GroundTerm t.pred ∧ GroundTerm t.obj

/-- A graph is ground when all of its triples are. -/
def Ground (g : BGraph) : Prop := ∀ t ∈ g, GroundTriple t

theorem substTerm_ground {s : Subst} {t : BTerm} (h : GroundTerm t) :
    substTerm s t = t := by
  cases t with
  | ground _ => rfl
  | blank _ => exact absurd h not_false

theorem substTriple_ground {s : Subst} {t : BTriple} (h : GroundTriple t) :
    substTriple s t = t := by
  obtain ⟨h₁, h₂, h₃⟩ := h
  cases t
  simp [substTriple, substTerm_ground h₁, substTerm_ground h₂, substTerm_ground h₃]

/-- On a ground conclusion, simple entailment is containment: nothing is derived
that was not already recorded. -/
theorem ground_entails_iff_subset {g e : BGraph} (he : Ground e) :
    Entails g e ↔ ∀ t ∈ e, t ∈ g := by
  rw [entails_iff_instance_subset]
  constructor
  · rintro ⟨s, hs⟩ t ht
    have := hs t ht
    rwa [substTriple_ground (he t ht)] at this
  · intro h
    exact ⟨idSubst, fun t ht => by rw [substTriple_id]; exact h t ht⟩

/-! ## §5 What a blank node is, and what it is not -/

/-- **A blank node may be introduced for the object of any recorded triple.**  This
is the existential-generalisation direction. -/
theorem entails_blank_generalisation {g : BGraph} {a p o : Term} {b : Nat}
    (h : ⟨.ground a, .ground p, .ground o⟩ ∈ g) :
    Entails g [⟨.ground a, .ground p, .blank b⟩] := by
  rw [entails_iff_instance_subset]
  refine ⟨fun _ => .ground o, fun t ht => ?_⟩
  simp only [List.mem_singleton] at ht
  subst ht
  simpa [substTriple, substTerm] using h

/-- A concrete instance of the previous lemma, and its converse failure below: the
two make precise that a blank node is an existential and not a name. -/
def aTerm : Term := .item ⟨1⟩
/-- A second name, distinct from `aTerm`. -/
def cTerm : Term := .item ⟨2⟩
/-- A predicate name. -/
def pTerm : Term := .prop P31

/-- **A blank node is not a witness.**  The existential statement "something is
related to `a` by `p`" does not entail any particular instance of itself. -/
theorem blank_is_not_a_witness :
    ¬ Entails [⟨.ground aTerm, .ground pTerm, .blank 0⟩]
        [⟨.ground aTerm, .ground pTerm, .ground cTerm⟩] := by
  rw [entails_iff_instance_subset]
  rintro ⟨s, hs⟩
  have := hs _ (List.mem_singleton_self _)
  simp [substTriple, substTerm, aTerm, cTerm, pTerm] at this

/-- **Entailment does not distribute over union when blank nodes are shared.**  A
graph entails each of two one-triple graphs that reuse the blank node `0`, but not
their union: a single instance mapping would have to send `0` to two different
terms.  This is why the RDF merge operation standardises blank nodes apart. -/
theorem entails_union_needs_standardising_apart :
    Entails [⟨.ground aTerm, .ground pTerm, .ground aTerm⟩,
             ⟨.ground cTerm, .ground pTerm, .ground cTerm⟩]
        [⟨.ground aTerm, .ground pTerm, .blank 0⟩] ∧
    Entails [⟨.ground aTerm, .ground pTerm, .ground aTerm⟩,
             ⟨.ground cTerm, .ground pTerm, .ground cTerm⟩]
        [⟨.blank 0, .ground pTerm, .ground cTerm⟩] ∧
    ¬ Entails [⟨.ground aTerm, .ground pTerm, .ground aTerm⟩,
               ⟨.ground cTerm, .ground pTerm, .ground cTerm⟩]
        [⟨.ground aTerm, .ground pTerm, .blank 0⟩,
         ⟨.blank 0, .ground pTerm, .ground cTerm⟩] := by
  refine ⟨?_, ?_, ?_⟩
  · rw [entails_iff_instance_subset]
    refine ⟨fun _ => .ground aTerm, ?_⟩
    intro t ht
    simp only [List.mem_singleton] at ht
    subst ht
    simp [substTriple, substTerm]
  · rw [entails_iff_instance_subset]
    refine ⟨fun _ => .ground cTerm, ?_⟩
    intro t ht
    simp only [List.mem_singleton] at ht
    subst ht
    simp [substTriple, substTerm]
  · rw [entails_iff_instance_subset]
    rintro ⟨s, hs⟩
    have h₁ := hs ⟨.ground aTerm, .ground pTerm, .blank 0⟩ (by simp)
    have h₂ := hs ⟨.blank 0, .ground pTerm, .ground cTerm⟩ (by simp)
    simp [substTriple, substTerm, aTerm, cTerm, pTerm, BTriple.mk.injEq] at h₁ h₂
    rw [h₁] at h₂
    simp at h₂

/-- **A graph need not be lean.**  Two blank nodes asserting the same thing are
equivalent to one: the two graphs entail each other although they have different
sizes, so entailment-equivalence is not graph equality even up to renaming. -/
theorem redundant_blank_is_removable :
    Equiv [⟨.blank 0, .ground pTerm, .ground aTerm⟩,
           ⟨.blank 1, .ground pTerm, .ground aTerm⟩]
          [⟨.blank 0, .ground pTerm, .ground aTerm⟩] := by
  constructor
  · exact entails_of_subset (by simp)
  · rw [entails_iff_instance_subset]
    refine ⟨fun _ => .blank 0, ?_⟩
    intro t ht
    simp only [List.mem_cons, List.not_mem_nil, or_false] at ht
    rcases ht with rfl | rfl <;> simp [substTriple, substTerm]

/-! ## §6 A decision procedure -/

/-- Every term occurring in a graph. -/
def termsOf (g : BGraph) : List BTerm :=
  g.flatMap fun t => [t.subj, t.pred, t.obj]

/-- The blank nodes occurring in a term. -/
def blanksOfTerm : BTerm → List Nat
  | .ground _ => []
  | .blank b => [b]

/-- The blank nodes occurring in a graph. -/
def blanksOf (g : BGraph) : List Nat :=
  g.flatMap fun t => blanksOfTerm t.subj ++ blanksOfTerm t.pred ++ blanksOfTerm t.obj

/-- All tables assigning to each key of `ks` a value from `vs`. -/
def assignments : List Nat → List BTerm → List (List (Nat × BTerm))
  | [], _ => [[]]
  | k :: ks, vs => vs.flatMap fun v => (assignments ks vs).map fun tbl => (k, v) :: tbl

/-- The instance mapping read off a table (blank nodes outside the table are left
alone). -/
def tableSubst (tbl : List (Nat × BTerm)) : Subst :=
  fun b => (tbl.lookup b).getD (.blank b)

/-- The decision procedure: try every map from the blank nodes of `e` into the
terms of `g`. -/
def entailsCheck (g e : BGraph) : Bool :=
  (assignments (blanksOf e) (termsOf g)).any fun tbl =>
    e.all fun t => decide (substTriple (tableSubst tbl) t ∈ g)

theorem substTerm_congr {s s' : Subst} {t : BTerm}
    (h : ∀ b ∈ blanksOfTerm t, s b = s' b) : substTerm s t = substTerm s' t := by
  cases t with
  | ground _ => rfl
  | blank b => exact h b (by simp [blanksOfTerm])

theorem substTriple_congr {s s' : Subst} {t : BTriple}
    (h : ∀ b ∈ blanksOfTerm t.subj ++ blanksOfTerm t.pred ++ blanksOfTerm t.obj,
      s b = s' b) : substTriple s t = substTriple s' t := by
  have h₁ : ∀ b ∈ blanksOfTerm t.subj, s b = s' b := fun b hb => h b (by simp [hb])
  have h₂ : ∀ b ∈ blanksOfTerm t.pred, s b = s' b := fun b hb => h b (by simp [hb])
  have h₃ : ∀ b ∈ blanksOfTerm t.obj, s b = s' b := fun b hb => h b (by simp [hb])
  simp [substTriple, substTerm_congr h₁, substTerm_congr h₂, substTerm_congr h₃]

theorem mem_termsOf_of_mem_substTriple {g : BGraph} {s : Subst} {t : BTriple} {b : Nat}
    (ht : substTriple s t ∈ g)
    (hb : b ∈ blanksOfTerm t.subj ++ blanksOfTerm t.pred ++ blanksOfTerm t.obj) :
    s b ∈ termsOf g := by
  have hsub : ∀ u : BTerm, b ∈ blanksOfTerm u → substTerm s u = s b := by
    intro u hu
    cases u with
    | ground _ => simp [blanksOfTerm] at hu
    | blank c => simp only [blanksOfTerm, List.mem_singleton] at hu; subst hu; rfl
  simp only [List.mem_append] at hb
  have : s b ∈ [(substTriple s t).subj, (substTriple s t).pred, (substTriple s t).obj] := by
    rcases hb with (hb | hb) | hb
    · simp [substTriple, hsub _ hb]
    · simp [substTriple, hsub _ hb]
    · simp [substTriple, hsub _ hb]
  exact List.mem_flatMap.2 ⟨substTriple s t, ht, this⟩

theorem assignments_complete (ks : List Nat) (vs : List BTerm) (f : Nat → BTerm)
    (hf : ∀ k ∈ ks, f k ∈ vs) :
    ∃ tbl ∈ assignments ks vs, ∀ k ∈ ks, tableSubst tbl k = f k := by
  induction ks with
  | nil => exact ⟨[], by simp [assignments], by simp⟩
  | cons k ks ih =>
      obtain ⟨tbl, htbl, hval⟩ := ih fun j hj => hf j (by simp [hj])
      refine ⟨(k, f k) :: tbl, ?_, ?_⟩
      · refine List.mem_flatMap.2 ⟨f k, hf k (by simp), ?_⟩
        exact List.mem_map.2 ⟨tbl, htbl, rfl⟩
      · intro j hj
        by_cases hjk : j = k
        · subst hjk; simp [tableSubst]
        · have hj' : j ∈ ks := by
            simp only [List.mem_cons] at hj
            exact hj.resolve_left hjk
          have hbeq : (j == k) = false := by simp [hjk]
          have : (((k, f k) :: tbl).lookup j) = tbl.lookup j := by
            simp [List.lookup_cons, hbeq]
          simp only [tableSubst, this]
          exact hval j hj'

/-- The decision procedure is exact. -/
theorem entailsCheck_iff (g e : BGraph) : entailsCheck g e = true ↔ Entails g e := by
  rw [entails_iff_instance_subset]
  constructor
  · intro h
    obtain ⟨tbl, _, hall⟩ := List.any_eq_true.1 h
    refine ⟨tableSubst tbl, fun t ht => ?_⟩
    have := List.all_eq_true.1 hall t ht
    simpa using this
  · rintro ⟨s, hs⟩
    have hmem : ∀ b ∈ blanksOf e, s b ∈ termsOf g := by
      intro b hb
      obtain ⟨t, ht, hbt⟩ := List.mem_flatMap.1 hb
      exact mem_termsOf_of_mem_substTriple (hs t ht) hbt
    obtain ⟨tbl, htbl, hval⟩ :=
      assignments_complete (blanksOf e) (termsOf g) s hmem
    refine List.any_eq_true.2 ⟨tbl, htbl, ?_⟩
    refine List.all_eq_true.2 fun t ht => ?_
    have hcongr : substTriple (tableSubst tbl) t = substTriple s t := by
      refine substTriple_congr fun b hb => ?_
      exact hval b (List.mem_flatMap.2 ⟨t, ht, hb⟩)
    simp [hcongr, hs t ht]

instance instDecidableEntails (g e : BGraph) : Decidable (Entails g e) :=
  decidable_of_iff _ (entailsCheck_iff g e)

/-- A worked entailment, decided by the kernel: the two recorded triples entail
"something is `p`-related to `a` and `p`-related from it to itself" once the two
blank nodes are standardised apart. -/
example :
    Entails [⟨.ground aTerm, .ground pTerm, .ground aTerm⟩,
             ⟨.ground cTerm, .ground pTerm, .ground cTerm⟩]
        [⟨.ground aTerm, .ground pTerm, .blank 0⟩,
         ⟨.blank 1, .ground pTerm, .ground cTerm⟩] := by decide

/-- And the shared-blank-node version is refuted by the kernel too. -/
example :
    ¬ Entails [⟨.ground aTerm, .ground pTerm, .ground aTerm⟩,
               ⟨.ground cTerm, .ground pTerm, .ground cTerm⟩]
        [⟨.ground aTerm, .ground pTerm, .blank 0⟩,
         ⟨.blank 0, .ground pTerm, .ground cTerm⟩] := by decide

/-! ## §7 The bridge to the Wikidata layer -/

/-- A ground RDF triple, read as a blank-node triple. -/
def embed (t : Triple) : BTriple :=
  ⟨.ground t.subj, .ground t.pred, .ground t.obj⟩

theorem ground_embed (t : Triple) : GroundTriple (embed t) := ⟨trivial, trivial, trivial⟩

theorem ground_map_embed (ts : List Triple) : Ground (ts.map embed) := by
  intro t ht
  obtain ⟨u, _, rfl⟩ := List.mem_map.1 ht
  exact ground_embed u

/-- The embedded direct triples of a knowledge base entail exactly themselves: on
the ground layer nothing new appears. -/
theorem entails_embed_directTriples (kb : KB) (ts : List Triple)
    (h : ∀ t ∈ ts, t ∈ directTriples kb) :
    Entails ((directTriples kb).map embed) (ts.map embed) := by
  rw [ground_entails_iff_subset (ground_map_embed ts)]
  intro t ht
  obtain ⟨u, hu, rfl⟩ := List.mem_map.1 ht
  exact List.mem_map_of_mem (h u hu)

/-- Blanking the object of a truthy statement gives a consequence of the base: the
base entails "`x` is an instance of *something*". -/
theorem kb_entails_blanked_object (kb : KB) (x c : Qid) (b : Nat)
    (h : ⟨Term.item x, Term.prop P31, Term.item c⟩ ∈ directTriples kb) :
    Entails ((directTriples kb).map embed)
      [⟨.ground (Term.item x), .ground (Term.prop P31), .blank b⟩] :=
  entails_blank_generalisation (List.mem_map_of_mem h)

/-! ## §8 Lean graphs -/

/-- A graph is *lean* when no proper subgraph of it entails it: there is nothing
to throw away. -/
def IsLean (g : BGraph) : Prop :=
  ∀ g' : BGraph, (∀ t ∈ g', t ∈ g) → Entails g' g → ∀ t ∈ g, t ∈ g'

/-- **A ground graph is lean**: with no existentials there is no redundancy to
remove. -/
theorem ground_isLean {g : BGraph} (hg : Ground g) : IsLean g := by
  intro g' _ hent t ht
  exact (ground_entails_iff_subset hg).1 hent t ht

/-- **A graph with two interchangeable blank nodes is not lean**: one of the two
triples is entailed by the other, so the subgraph consisting of the first alone
entails the whole. -/
theorem twoBlanks_not_isLean :
    ¬ IsLean [⟨.blank 0, .ground pTerm, .ground aTerm⟩,
              ⟨.blank 1, .ground pTerm, .ground aTerm⟩] := by
  intro h
  have hsub : ∀ t ∈ [(⟨.blank 0, .ground pTerm, .ground aTerm⟩ : BTriple)],
      t ∈ [(⟨.blank 0, .ground pTerm, .ground aTerm⟩ : BTriple),
           ⟨.blank 1, .ground pTerm, .ground aTerm⟩] := by simp
  have hent := redundant_blank_is_removable.2
  have := h _ hsub hent ⟨.blank 1, .ground pTerm, .ground aTerm⟩ (by simp)
  simp [BTriple.mk.injEq] at this

/-! ## §9 The merge, and why it standardises blank nodes apart -/

/-- Renaming every blank node upwards by `k`. -/
def shift (k : Nat) : Subst := fun b => .blank (b + k)

/-- The renamed graph. -/
def shiftGraph (k : Nat) (g : BGraph) : BGraph := substGraph (shift k) g

/-- A blank node index not used by the graph. -/
def freshFrom (g : BGraph) : Nat := (blanksOf g).foldr Nat.max 0 + 1

theorem lt_freshFrom {g : BGraph} {b : Nat} (h : b ∈ blanksOf g) : b < freshFrom g := by
  have key : ∀ l : List Nat, ∀ b ∈ l, b ≤ l.foldr Nat.max 0 := by
    intro l
    induction l with
    | nil => intro b hb; simp at hb
    | cons a as ih =>
        intro b hb
        simp only [List.mem_cons] at hb
        rcases hb with rfl | hb
        · exact Nat.le_max_left _ _
        · exact le_trans (ih b hb) (Nat.le_max_right _ _)
  exact Nat.lt_succ_of_le (key _ b h)

/-- **The RDF merge**: the union of two graphs after standardising their blank
nodes apart. -/
def merge (e f : BGraph) : BGraph := e ++ shiftGraph (freshFrom e) f

theorem entails_merge_left (e f : BGraph) : Entails (merge e f) e :=
  entails_of_subset fun _ ht => List.mem_append_left _ ht

theorem entails_merge_right (e f : BGraph) : Entails (merge e f) f := by
  rw [entails_iff_instance_subset]
  refine ⟨shift (freshFrom e), fun t ht => ?_⟩
  exact List.mem_append_right _ (List.mem_map_of_mem ht)

/-- **The merge is exactly the conjunction of its parts.**  A graph entails the
merge of two graphs precisely when it entails each of them — which is what the
naive concatenation fails to do, by
`entails_union_needs_standardising_apart`. -/
theorem entails_merge_iff (h e f : BGraph) :
    Entails h (merge e f) ↔ Entails h e ∧ Entails h f := by
  constructor
  · intro hm
    exact ⟨entails_trans hm (entails_merge_left e f),
      entails_trans hm (entails_merge_right e f)⟩
  · rintro ⟨he, hf⟩
    rw [entails_iff_instance_subset] at he hf ⊢
    obtain ⟨se, hse⟩ := he
    obtain ⟨sf, hsf⟩ := hf
    set k := freshFrom e with hk
    refine ⟨fun b => if b < k then se b else sf (b - k), fun t ht => ?_⟩
    rcases List.mem_append.1 ht with ht | ht
    · have hcongr : substTriple (fun b => if b < k then se b else sf (b - k)) t
          = substTriple se t := by
        refine substTriple_congr fun b hb => ?_
        have : b ∈ blanksOf e := List.mem_flatMap.2 ⟨t, ht, hb⟩
        simp [hk ▸ lt_freshFrom this]
      rw [hcongr]
      exact hse t ht
    · obtain ⟨u, hu, rfl⟩ := List.mem_map.1 ht
      rw [substTriple_comp]
      have hcomp : comp (fun b => if b < k then se b else sf (b - k)) (shift k) = sf := by
        funext b
        simp [comp, shift, substTerm, Nat.not_lt.2 (Nat.le_add_left k b)]
      rw [hcomp]
      exact hsf u hu

/-- The merge of the two conclusions of
`entails_union_needs_standardising_apart` *is* entailed by the base, although
their concatenation is not: the merge is the correct union of two graphs. -/
theorem merge_repairs_the_shared_blank :
    Entails [⟨.ground aTerm, .ground pTerm, .ground aTerm⟩,
             ⟨.ground cTerm, .ground pTerm, .ground cTerm⟩]
        (merge [⟨.ground aTerm, .ground pTerm, .blank 0⟩]
               [⟨.blank 0, .ground pTerm, .ground cTerm⟩]) := by
  rw [entails_merge_iff]
  exact ⟨(entails_union_needs_standardising_apart).1,
    (entails_union_needs_standardising_apart).2.1⟩

end BlankNodes

end Wikidata
