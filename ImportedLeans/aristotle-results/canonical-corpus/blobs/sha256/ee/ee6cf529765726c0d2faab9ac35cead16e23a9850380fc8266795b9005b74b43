 IsNormalised[] = lower

 IsNormalised[x] : ∀ x → IsNormalised [ x ]
 IsNormalised[x] _ = ⊎.rec lower lower

 IsNormalisedTail : ∀ xs → IsNormalised xs → IsNormalised (tail xs)
