  record
    { Inv = strobeInv
    ; inv-step² = strobeInv-step²
    ; defect = lagDefect
    ; defect-nonincr-step² = lagDefect-nonincreasing-step²
    ; coarse-phase-step² = λ x _ → clock-coarsePhase-step² x
