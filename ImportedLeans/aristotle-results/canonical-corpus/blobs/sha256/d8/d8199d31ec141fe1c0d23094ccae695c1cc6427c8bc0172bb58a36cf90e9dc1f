namespace Wikidata.AlignmentSafety

open Wikidata

/-! ## Languages and profiles -/

/-- The inference language a mapping is being used for. -/
inductive InferenceLanguage
  | subclass
  | instanceTransport
  | disjointness
  | disjointUnion
  deriving DecidableEq, Repr, Inhabited

/-- What a concrete alignment has been shown to provide. -/
structure AlignmentProfile where
  subclassPreserved : Bool
  instanceTransportAvailable : Bool
  targetDisjointnessAvailable : Bool
  finiteUnionCoverageAvailable : Bool
  deriving DecidableEq, Repr, Inhabited

/-- Which inference languages a profile licenses. -/
def safeFor (p : AlignmentProfile) : InferenceLanguage → Bool
  | InferenceLanguage.subclass => p.subclassPreserved
  | InferenceLanguage.instanceTransport => p.instanceTransportAvailable
  | InferenceLanguage.disjointness =>
      p.instanceTransportAvailable && p.targetDisjointnessAvailable
  | InferenceLanguage.disjointUnion =>
      p.subclassPreserved && p.instanceTransportAvailable &&
        p.targetDisjointnessAvailable && p.finiteUnionCoverageAvailable

/-- A mapping checked only for subclass preservation. -/
def subclassOnly : AlignmentProfile := ⟨true, false, false, false⟩

/-- Subclass preservation plus instance transport, but no target disjointness. -/
def subclassAndInstances : AlignmentProfile := ⟨true, true, false, false⟩

/-- Everything the finite class algebra needs. -/
def fullFiniteClassAlgebra : AlignmentProfile := ⟨true, true, true, true⟩

/-! ## Separations between the languages -/

theorem subclassOnly_safe_for_subclass :
    safeFor subclassOnly InferenceLanguage.subclass = true := rfl

theorem subclassOnly_not_safe_for_disjointness :
    safeFor subclassOnly InferenceLanguage.disjointness = false := rfl

/-- Transporting instances does not manufacture target-side disjointness. -/
theorem instance_transport_does_not_manufacture_disjointness :
    safeFor subclassAndInstances InferenceLanguage.instanceTransport = true ∧
      safeFor subclassAndInstances InferenceLanguage.disjointness = false := ⟨rfl, rfl⟩

theorem fullProfile_safe_for_disjointUnion :
    safeFor fullFiniteClassAlgebra InferenceLanguage.disjointUnion = true := rfl

/-- **No intrinsic "good mapping" Boolean exists.**  Whatever summary function of
a profile one proposes, it disagrees with `safeFor` on some language, because a
single profile is safe for one language and unsafe for another. -/
theorem no_single_boolean_summary (f : AlignmentProfile → Bool) :
    ¬ ∀ p l, safeFor p l = f p := by
  intro h
  have h1 : f subclassOnly = true := (h subclassOnly InferenceLanguage.subclass).symm
  have h2 : f subclassOnly = false := (h subclassOnly InferenceLanguage.disjointness).symm
  rw [h1] at h2
  exact Bool.noConfusion h2

/-! ## The profile order -/

/-- One profile provides at least what another does. -/
def Le (p q : AlignmentProfile) : Prop :=
  (p.subclassPreserved = true → q.subclassPreserved = true) ∧
    (p.instanceTransportAvailable = true → q.instanceTransportAvailable = true) ∧
    (p.targetDisjointnessAvailable = true → q.targetDisjointnessAvailable = true) ∧
    (p.finiteUnionCoverageAvailable = true → q.finiteUnionCoverageAvailable = true)

theorem le_refl (p : AlignmentProfile) : Le p p := ⟨id, id, id, id⟩

theorem le_trans {p q r : AlignmentProfile} (h₁ : Le p q) (h₂ : Le q r) : Le p r :=
  ⟨fun h => h₂.1 (h₁.1 h), fun h => h₂.2.1 (h₁.2.1 h), fun h => h₂.2.2.1 (h₁.2.2.1 h),
    fun h => h₂.2.2.2 (h₁.2.2.2 h)⟩

/-- **More capability never licenses less.**  `safeFor` is monotone in the
profile order. -/
theorem safeFor_mono {p q : AlignmentProfile} (h : Le p q) (l : InferenceLanguage)
    (hp : safeFor p l = true) : safeFor q l = true := by
  obtain ⟨h1, h2, h3, h4⟩ := h
  cases l <;> simp only [safeFor, Bool.and_eq_true] at hp ⊢
  · exact h1 hp
  · exact h2 hp
  · exact ⟨h2 hp.1, h3 hp.2⟩
  · exact ⟨⟨⟨h1 hp.1.1.1, h2 hp.1.1.2⟩, h3 hp.1.2⟩, h4 hp.2⟩

/-- The order is strict where it matters: the subclass-only profile is below the
full one, and only the full one licenses disjointness. -/
theorem subclassOnly_le_full : Le subclassOnly fullFiniteClassAlgebra := by
  refine ⟨fun _ => rfl, fun h => ?_, fun h => ?_, fun h => ?_⟩ <;> exact absurd h (by decide)

/-! ## A countermodel in the engine -/

/-- Source classes: `Q10` and `Q11`, with one instance `Q1` of `Q10` only. -/
def cmSrc : KB :=
  { entities := [⟨1⟩, ⟨10⟩, ⟨11⟩]
    statements := [⟨⟨1⟩, P31, ⟨10⟩, Rank.normal⟩] }

/-- Target classes: `Q20` and `Q21`, sharing the instance `Q2`. -/
def cmTgt : KB :=
  { entities := [⟨2⟩, ⟨20⟩, ⟨21⟩]
    statements := [⟨⟨2⟩, P31, ⟨20⟩, Rank.normal⟩, ⟨⟨2⟩, P31, ⟨21⟩, Rank.normal⟩] }

/-- The declared mapping `Q10 ↦ Q20`, `Q11 ↦ Q21`. -/
def cmAlignment : Alignment :=
  { src := cmSrc
    tgt := cmTgt
    links := [(⟨10⟩, ⟨20⟩), (⟨11⟩, ⟨21⟩)] }

/-- **Passing the subclass checker says nothing about disjointness.**  The
alignment preserves every source subclass edge, and `Q10`, `Q11` are disjoint in
the source, yet their images `Q20`, `Q21` share the instance `Q2` in the target.
Source-side disjointness therefore does not travel forward along a mapping that
`alignOk` accepts. -/
theorem alignOk_does_not_transport_disjointness :
    Alignment.alignOk cmAlignment = true ∧
      DisjointOn cmSrc ⟨10⟩ ⟨11⟩ ∧
      ¬ DisjointOn cmTgt ⟨20⟩ ⟨21⟩ := by
  refine ⟨by decide, (disjointOk_iff cmSrc ⟨10⟩ ⟨11⟩).1 (by decide), ?_⟩
  intro h
  have : disjointOk cmTgt ⟨20⟩ ⟨21⟩ = true := (disjointOk_iff cmTgt ⟨20⟩ ⟨21⟩).2 h
  exact absurd this (by decide)

/-- The same alignment read as a profile: subclass preservation is established,
target disjointness is not, so the profile does not license the disjointness
language. -/
def cmProfile : AlignmentProfile := ⟨true, false, false, false⟩

theorem cmProfile_not_safe_for_disjointness :
    safeFor cmProfile InferenceLanguage.subclass = true ∧
      safeFor cmProfile InferenceLanguage.disjointness = false := ⟨rfl, rfl⟩

end Wikidata.AlignmentSafety
