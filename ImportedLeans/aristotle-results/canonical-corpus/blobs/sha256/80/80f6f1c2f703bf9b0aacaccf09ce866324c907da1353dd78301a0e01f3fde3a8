  refl

selectedBumpAt :
  SSP →
  SelectedG3Operator
selectedBumpAt p v =
  FVI.primeBump p v

selectedP2Bump :
  SelectedG3Operator
selectedP2Bump =
  selectedBumpAt p2

selectedSpatialBump :
  G3SpatialDirection →
  SelectedG3Operator
selectedSpatialBump d =
  selectedBumpAt (spatialPrime d)

selectedP :
  G3SpatialDirection →
  SelectedG3Operator
selectedP =
  selectedSpatialBump

selectedH :
  SelectedG3Operator
selectedH =
  selectedP2Bump

selectedK :
  G3SpatialDirection →
  SelectedG3Operator
selectedK d v =
  selectedP2Bump (selectedSpatialBump d v)

selectedBumpCommutes :
  (p q : SSP) →
  (v : SelectedG3State) →
  selectedBumpAt p (selectedBumpAt q v)
  ≡
  selectedBumpAt q (selectedBumpAt p v)
