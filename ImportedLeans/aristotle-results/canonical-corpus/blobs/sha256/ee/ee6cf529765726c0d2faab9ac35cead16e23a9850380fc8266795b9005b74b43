                   (EM-raw→EM _ _ a) (EM-raw'→EM _ _ y)))
            ∙∙ cong (EM→ΩEM+1 _)
                    (assocConvert ind (EM-raw→EM _ _ a) (EM-raw'→EM _ _ y) z
                  ∙ preSubstFunLoop _ _)
