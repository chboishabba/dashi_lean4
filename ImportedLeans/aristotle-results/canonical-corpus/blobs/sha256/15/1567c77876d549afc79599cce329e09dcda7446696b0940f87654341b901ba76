    ; finiteRBianchiLaw =
        GRNF.grSelectedFiniteRFiniteBianchiLaw
    ; contractedBianchiDivergenceZero =
        GRNF.GRSelectedFourChartLeviCivitaBianchiEinsteinStagingReceipt.contractedBianchiDivergenceZero
