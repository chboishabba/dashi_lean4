·DistPosRMin (suc x) (negsuc (suc y)) (negsuc (suc z))
  = ·predℤ (pos (suc x)) (min (negsuc y) (negsuc z)) ∙
    cong (_- pos (suc x)) (·DistPosRMin (suc x) (negsuc y) (negsuc z)) ∙
