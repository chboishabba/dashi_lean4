  (R : RefinementTower ℓ) : Set (lsuc ℓ) where
  open RefinementTower R
  field
    Obs   : ∀ n → PT.State (TheoryAt n) → Set ℓ
    ObsEq : ∀ n → Set ℓ → Set ℓ → Set ℓ

    transport :
      ∀ n x →
      ObsEq n
        (Obs n (ApproxRefinementStep.project (refine n) x))
        (Obs (suc n) x)

