    isHomYoneda : IsLatticeHom (DistLattice→Lattice (ZariskiLattice R) .snd)
                               (yonedaᴾ ZarLatFun R .inv)
                               (DistLattice→Lattice (CompOpenDistLattice ⟅ Sp ⟅ R ⟆ ⟆) .snd)
