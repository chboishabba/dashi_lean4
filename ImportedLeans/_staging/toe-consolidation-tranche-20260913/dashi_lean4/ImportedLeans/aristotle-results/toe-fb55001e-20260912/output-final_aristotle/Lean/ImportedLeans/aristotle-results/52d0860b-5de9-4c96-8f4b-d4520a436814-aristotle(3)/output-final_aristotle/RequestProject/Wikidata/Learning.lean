namespace Wikidata

open Epistemic

/-! ## Cohort admission -/

-- @source DASHI Agda bridge (PR #555/#581/#582): governed residual ontology learning: cohort admission
/-- The disposition of a candidate cohort member after review. -/
inductive Admission
  | confirmed
  | confirmedAfterSplit
  | confirmedAfterRepair
  | held
  | ambiguous
  | unresolved
  | manualReconstruction
  | coverageIncomplete
  deriving DecidableEq, Repr, Inhabited, Fintype

-- @source DASHI Agda bridge (PR #555/#581/#582): governed residual ontology learning: cohort admission
/-- Whether a disposition may refine the empirical invariant.  Only an
independently confirmed member does. -/
def Admission.trains : Admission → Bool
  | .confirmed => true
  | .confirmedAfterSplit => true
  | .confirmedAfterRepair => true
  | .held => false
  | .ambiguous => false
  | .unresolved => false
  | .manualReconstruction => false
  | .coverageIncomplete => false

/-- A candidate member of the training cohort. -/
structure CohortMember where
  item : Qid
  admission : Admission
  deriving DecidableEq, Repr, Inhabited

-- @source DASHI Agda bridge (PR #555/#581/#582): governed residual ontology learning: cohort admission
/-- The items that may refine the invariant. -/
def admitted (c : List CohortMember) : List Qid :=
  (c.filter (fun m => m.admission.trains)).map (·.item)

@[simp] theorem admitted_nil : admitted [] = [] := rfl

@[simp] theorem admitted_cons_of_trains {m : CohortMember} {c : List CohortMember}
    (h : m.admission.trains = true) : admitted (m :: c) = m.item :: admitted c := by
  simp [admitted, h]

@[simp] theorem admitted_cons_of_not_trains {m : CohortMember} {c : List CohortMember}
    (h : m.admission.trains = false) : admitted (m :: c) = admitted c := by
  simp [admitted, h]

@[simp] theorem admitted_append (c c' : List CohortMember) :
    admitted (c ++ c') = admitted c ++ admitted c' := by
  simp [admitted]

-- @source DASHI Agda bridge (PR #555/#581/#582): governed residual ontology learning: cohort admission
/-- Held members do not train the invariant. -/
theorem held_does_not_train : Admission.held.trains = false := rfl

-- @source DASHI Agda bridge (PR #555/#581/#582): governed residual ontology learning: cohort admission
/-- Neither do unresolved ones. -/
theorem unresolved_does_not_train : Admission.unresolved.trains = false := rfl

-- @source DASHI Agda bridge (PR #555/#581/#582): governed residual ontology learning: cohort admission
/-- Nor do members whose coverage is incomplete: an unmeasured member is not a
conforming one. -/
theorem coverageIncomplete_does_not_train : Admission.coverageIncomplete.trains = false := rfl

/-! ## The learned invariant -/

/-- The properties the base asserts anywhere: the candidate vocabulary of an
empirical invariant. -/
def kbProperties (kb : KB) : List Pid :=
  (kb.statements.map (·.property)).eraseDups

/-- Whether an item carries a property in the truthy layer. -/
def hasProperty (kb : KB) (x : Qid) (p : Pid) : Bool :=
  kb.statements.any (fun st => st.subject == x && st.property == p && IsTruthy kb st)

/-- The feature signature of an item: which of the base's properties it carries. -/
def signature (kb : KB) (x : Qid) : List Pid :=
  (kbProperties kb).filter (hasProperty kb x)

-- @source DASHI Agda bridge (PR #555/#581/#582): an empirical invariant refined only by reviewed conforming members
/-- The learned empirical invariant of a cohort: the properties every admitted
member carries. -/
def learned (kb : KB) (c : List CohortMember) : List Pid :=
  (kbProperties kb).filter (fun p => (admitted c).all (fun y => hasProperty kb y p))

-- @source DASHI Agda bridge (PR #555/#581/#582): an empirical invariant refined only by reviewed conforming members
/-- **Exactness.**  A property is in the learned invariant exactly when the base
uses it and every admitted member carries it. -/
theorem mem_learned_iff (kb : KB) (c : List CohortMember) (p : Pid) :
    p ∈ learned kb c ↔ p ∈ kbProperties kb ∧ ∀ y ∈ admitted c, hasProperty kb y p = true := by
  simp [learned, List.mem_filter, List.all_eq_true]

/-- An admitted member really carries every learned property. -/
theorem hasProperty_of_mem_learned {kb : KB} {c : List CohortMember} {p : Pid} {y : Qid}
    (hp : p ∈ learned kb c) (hy : y ∈ admitted c) : hasProperty kb y p = true :=
  ((mem_learned_iff kb c p).1 hp).2 y hy

-- @source DASHI Agda bridge (PR #555/#581/#582): an empirical invariant refined only by reviewed conforming members
/-- **A member that does not train changes nothing.**  Recording a held or
unresolved candidate leaves the invariant literally equal, so there is no
back door by which resemblance re-enters. -/
theorem learned_ignores_untrained (kb : KB) (m : CohortMember) (c : List CohortMember)
    (h : m.admission.trains = false) : learned kb (m :: c) = learned kb c := by
  simp [learned, admitted_cons_of_not_trains h]

-- @source DASHI Agda bridge (PR #555/#581/#582): an empirical invariant refined only by reviewed conforming members
/-- **The invariant only weakens as the cohort grows.** -/
theorem learned_append_subset (kb : KB) (c c' : List CohortMember) :
    ∀ p ∈ learned kb (c ++ c'), p ∈ learned kb c := by
  intro p hp
  rcases (mem_learned_iff kb (c ++ c') p).1 hp with ⟨hmem, hall⟩
  refine (mem_learned_iff kb c p).2 ⟨hmem, fun y hy => hall y ?_⟩
  simp [admitted_append, hy]

-- @source DASHI Agda bridge (PR #555/#581/#582): an empirical invariant refined only by reviewed conforming members
/-- **Coverage is a precondition, not a score.**  With no admitted member the
invariant is the whole vocabulary: it says nothing, while looking maximal. -/
theorem empty_cohort_learns_everything (kb : KB) (c : List CohortMember)
    (h : admitted c = []) : learned kb c = kbProperties kb := by
  simp [learned, h]

/-! ## A worked fragment: empirical is not normative

`Q1` and `Q2` are confirmed members of the class `Q100`; `Q3` is a member too but
lacks the property `P5` that both confirmed members carry, and `Q4` carries every
learned property without being a member at all. -/

/-- The class of the worked fragment. -/
def cls : Qid := ⟨100⟩

/-- The feature property both confirmed members happen to carry. -/
def feature : Pid := ⟨5⟩

/-- The value the feature points at. -/
def featureValue : Qid := ⟨500⟩

/-- Two confirmed members, one legitimate exception, one non-member lookalike. -/
def learningKB : KB where
  entities := [⟨1⟩, ⟨2⟩, ⟨3⟩, ⟨4⟩, cls]
  statements :=
    [ { subject := ⟨1⟩, property := P31, value := cls }
    , { subject := ⟨1⟩, property := feature, value := featureValue }
    , { subject := ⟨2⟩, property := P31, value := cls }
    , { subject := ⟨2⟩, property := feature, value := featureValue }
    , { subject := ⟨3⟩, property := P31, value := cls }
    , { subject := ⟨4⟩, property := P31, value := ⟨101⟩ }
    , { subject := ⟨4⟩, property := feature, value := featureValue } ]

/-- The reviewed cohort: the two confirmed members, plus a held one. -/
def learningCohort : List CohortMember :=
  [ ⟨⟨1⟩, .confirmed⟩, ⟨⟨2⟩, .confirmedAfterRepair⟩, ⟨⟨3⟩, .held⟩ ]

/-- The invariant learned from the cohort is exactly "instance of the class, and
carries the feature". -/
theorem learned_learningCohort : learned learningKB learningCohort = [P31, feature] := by
  decide

/-- The held member is invisible to it: dropping it changes nothing. -/
theorem learned_drop_held :
    learned learningKB learningCohort
      = learned learningKB [⟨⟨1⟩, .confirmed⟩, ⟨⟨2⟩, .confirmedAfterRepair⟩] := by
  decide

-- @source DASHI Agda bridge (PR #555/#581/#582): the empirical surface is not the normative one
/-- **A legitimate exception.**  `Q3` is a genuine instance of the class and
violates the learned invariant, so the invariant is not a membership criterion in
the "only if" direction. -/
theorem learned_has_legitimate_exception :
    InstanceOf learningKB ⟨3⟩ cls ∧ hasProperty learningKB ⟨3⟩ feature = false := by
  refine ⟨?_, by decide⟩
  exact (isInstanceOf_iff learningKB ⟨3⟩ cls).1 (by decide)

-- @source DASHI Agda bridge (PR #555/#581/#582): the empirical surface is not the normative one
/-- **A lookalike.**  `Q4` carries the feature and is not an instance, so the
invariant is not a membership criterion in the "if" direction either. -/
theorem learned_does_not_characterise :
    hasProperty learningKB ⟨4⟩ feature = true ∧ ¬ InstanceOf learningKB ⟨4⟩ cls := by
  refine ⟨by decide, ?_⟩
  intro h
  exact absurd ((isInstanceOf_iff learningKB ⟨4⟩ cls).2 h) (by decide)

/-! ## Resemblance is context-gated -/

-- @source DASHI Agda bridge (PR #555/#581/#582): resemblance is context-gated
/-- How a comparison between two items stands relative to the context that makes
it meaningful. -/
inductive ContextStatus
  | admissible
  | masked
  | unknown
  | inadmissible
  deriving DecidableEq, Repr, Inhabited, Fintype

-- @source DASHI Agda bridge (PR #555/#581/#582): resemblance is context-gated
/-- What a residual graph may record about a pair. -/
inductive EdgeKind
  | similarity
  | maskedAnalogy
  | unknownCoverage
  deriving DecidableEq, Repr, Inhabited, Fintype

-- @source DASHI Agda bridge (PR #555/#581/#582): resemblance is context-gated
/-- Only an admissible comparison becomes a similarity edge. -/
def edgeFor : ContextStatus → EdgeKind
  | .admissible => .similarity
  | .masked => .maskedAnalogy
  | .inadmissible => .maskedAnalogy
  | .unknown => .unknownCoverage

-- @source DASHI Agda bridge (PR #555/#581/#582): resemblance is context-gated
/-- An inadmissible comparison is recorded as a masked analogy. -/
theorem inadmissible_context_is_masked : edgeFor .inadmissible = .maskedAnalogy := rfl

-- @source DASHI Agda bridge (PR #555/#581/#582): resemblance is context-gated
/-- Unknown coverage is not resemblance. -/
theorem unknown_context_is_not_similarity : edgeFor .unknown ≠ .similarity := by decide

-- @source DASHI Agda bridge (PR #555/#581/#582): resemblance is context-gated
/-- Only admissible comparisons produce similarity edges. -/
theorem similarity_only_from_admissible (s : ContextStatus) (h : edgeFor s = .similarity) :
    s = .admissible := by
  cases s <;> simp_all [edgeFor]

-- @source DASHI Agda bridge (PR #555/#581/#582): the empirical surface is not the normative one
/-- **Resemblance cannot decide membership.**  Class membership in the worked
fragment is not a function of the feature signature: `Q2` and `Q4` have the same
signature and only one of them is an instance.  The statement quantifies over
*every* interpretation of a signature, so no similarity gate, however tuned,
recovers the class. -/
theorem membership_not_factorsThrough_signature :
    ¬ Epistemic.FactorsThrough (signature learningKB) (fun x => isInstanceOf learningKB x cls) := by
  rintro ⟨interpret, h⟩
  have hsig : signature learningKB ⟨2⟩ = signature learningKB ⟨4⟩ := by decide
  have h2 : isInstanceOf learningKB ⟨2⟩ cls = interpret (signature learningKB ⟨2⟩) := h ⟨2⟩
  have h4 : isInstanceOf learningKB ⟨4⟩ cls = interpret (signature learningKB ⟨4⟩) := h ⟨4⟩
  have : isInstanceOf learningKB ⟨2⟩ cls = isInstanceOf learningKB ⟨4⟩ cls := by
    rw [h2, h4, hsig]
  exact absurd this (by decide)

/-! ## Merge candidates -/

/-- How two classes stand to each other normatively. -/
inductive NormativeCompatibility
  | equivalent
  | leftSubsumesRight
  | rightSubsumesLeft
  | conditionallyEquivalent
  | historicallyDistinct
  | incompatible
  | underspecified
  deriving DecidableEq, Repr, Inhabited, Fintype

/-- The outcome a merge candidate may be routed to. -/
inductive MergeMode
  | exactDuplicate
  | subsumption
  | sharedSuperclassOnly
  | conditionalDistinctionPreserved
  | historicalAliasOnly
  | blocked
  | insufficientCoverage
  deriving DecidableEq, Repr, Inhabited, Fintype

-- @source DASHI Agda bridge (PR #555/#581/#582): geometry convergence is not a merge
/-- A merge candidate emitted by a residual solver: the geometry is one
coordinate among the normative and impact ones, never a substitute for them. -/
structure MergeCandidate where
  left : Qid
  right : Qid
  compatibility : NormativeCompatibility
  geometryConverged : Bool
  typedObstruction : Bool
  conditionalDistinction : Bool
  substitutable : Bool
  impactBounded : Bool
  provenanceTransferred : Bool
  adequateCoverage : Bool
  deriving DecidableEq, Repr, Inhabited

-- @source DASHI Agda bridge (PR #555/#581/#582): geometry convergence is not a merge
/-- The mode a candidate is routed to.  A blocked or under-covered candidate
keeps its own outcome instead of being relabelled as a merge. -/
def mergeMode (c : MergeCandidate) : MergeMode :=
  if c.adequateCoverage = false then .insufficientCoverage
  else if c.typedObstruction then .blocked
  else if c.conditionalDistinction then .conditionalDistinctionPreserved
  else
    match c.compatibility with
    | .equivalent => .exactDuplicate
    | .leftSubsumesRight => .subsumption
    | .rightSubsumesLeft => .subsumption
    | .conditionallyEquivalent => .conditionalDistinctionPreserved
    | .historicallyDistinct => .historicalAliasOnly
    | .incompatible => .blocked
    | .underspecified => .sharedSuperclassOnly

-- @source DASHI Agda bridge (PR #555/#581/#582): geometry convergence is not a merge
/-- The conservative gate for a *direct* merge. -/
def mergeGate (c : MergeCandidate) : Bool :=
  c.adequateCoverage && !c.typedObstruction && !c.conditionalDistinction
    && c.substitutable && c.impactBounded && c.provenanceTransferred
    && (mergeMode c == MergeMode.exactDuplicate)

/-- A candidate whose geometry has converged and whose normative side is
untouched: everything a spectral solver can see, and nothing else. -/
def geometryOnly (a b : Qid) : MergeCandidate where
  left := a
  right := b
  compatibility := .underspecified
  geometryConverged := true
  typedObstruction := false
  conditionalDistinction := false
  substitutable := false
  impactBounded := false
  provenanceTransferred := false
  adequateCoverage := false

/-- The same pair, fully checked. -/
def fullyChecked (a b : Qid) : MergeCandidate where
  left := a
  right := b
  compatibility := .equivalent
  geometryConverged := true
  typedObstruction := false
  conditionalDistinction := false
  substitutable := true
  impactBounded := true
  provenanceTransferred := true
  adequateCoverage := true

-- @source DASHI Agda bridge (PR #555/#581/#582): geometry convergence is not a merge
/-- **Geometry alone is not a merge.** -/
theorem geometryOnly_fails_gate (a b : Qid) : mergeGate (geometryOnly a b) = false := rfl

/-- Its coverage is what is missing, and the outcome says so rather than
pretending the boundary was checked. -/
theorem geometryOnly_mode (a b : Qid) : mergeMode (geometryOnly a b) = .insufficientCoverage := rfl

/-- The fully checked candidate passes. -/
theorem fullyChecked_passes_gate (a b : Qid) : mergeGate (fullyChecked a b) = true := rfl

-- @source DASHI Agda bridge (PR #555/#581/#582): geometry convergence is not a merge
/-- **The gate is not a function of the geometry.**  Two candidates with the same
convergence flag receive opposite verdicts, so no reading of a residual geometry,
however elaborate, reproduces the gate. -/
theorem gate_not_factorsThrough_geometry :
    ¬ Epistemic.FactorsThrough (fun c : MergeCandidate => c.geometryConverged) mergeGate := by
  rintro ⟨interpret, h⟩
  have h₁ := h (geometryOnly ⟨1⟩ ⟨2⟩)
  have h₂ := h (fullyChecked ⟨1⟩ ⟨2⟩)
  rw [geometryOnly_fails_gate] at h₁
  rw [fullyChecked_passes_gate] at h₂
  simp [geometryOnly, fullyChecked] at h₁ h₂
  exact absurd (h₁.symm.trans h₂) (by decide)

/-- The same pair with a typed incompatibility recorded. -/
def incompatiblePair (a b : Qid) : MergeCandidate :=
  { fullyChecked a b with compatibility := .incompatible }

/-- The same pair with a conditional distinction recorded. -/
def conditionalPair (a b : Qid) : MergeCandidate :=
  { fullyChecked a b with conditionalDistinction := true }

-- @source DASHI Agda bridge (PR #555/#581/#582): geometry convergence is not a merge
/-- Typed incompatibility blocks a merge outright. -/
theorem incompatible_blocks_merge (a b : Qid) : mergeMode (incompatiblePair a b) = .blocked := rfl

/-- A blocked candidate does not pass the gate. -/
theorem incompatiblePair_fails_gate (a b : Qid) : mergeGate (incompatiblePair a b) = false := rfl

-- @source DASHI Agda bridge (PR #555/#581/#582): geometry convergence is not a merge
/-- A conditional distinction is preserved rather than merged away. -/
theorem conditional_distinction_preserved (a b : Qid) :
    mergeMode (conditionalPair a b) = .conditionalDistinctionPreserved := rfl

/-- And a preserved distinction is not a merge either. -/
theorem conditionalPair_fails_gate (a b : Qid) : mergeGate (conditionalPair a b) = false := rfl

/-! ## Enacting a merge -/

/-- Rewriting every occurrence of the left class to the right class. -/
def applyMerge (kb : KB) (c : MergeCandidate) : KB where
  entities := kb.entities.filter (· != c.left)
  statements := kb.statements.map fun st =>
    { st with
      subject := if st.subject = c.left then c.right else st.subject
      value := if st.value = c.left then c.right else st.value }

-- @source DASHI Agda bridge (PR #555/#581/#582): no solver output edits the ontology
/-- A merge is applied only when the conservative gate passes *and* a reviewer
approves. -/
def enactMerge (kb : KB) (c : MergeCandidate) : Epistemic.Decision → KB
  | .approved => if mergeGate c then applyMerge kb c else kb
  | .pending => kb
  | .rejected => kb

@[simp] theorem enactMerge_pending (kb : KB) (c : MergeCandidate) :
    enactMerge kb c .pending = kb := rfl

@[simp] theorem enactMerge_rejected (kb : KB) (c : MergeCandidate) :
    enactMerge kb c .rejected = kb := rfl

-- @source DASHI Agda bridge (PR #555/#581/#582): no solver output edits the ontology
/-- **No solver output edits.**  Without an approval nothing happens, whatever
the gate says. -/
theorem enactMerge_eq_of_not_approved (kb : KB) (c : MergeCandidate) {d : Epistemic.Decision}
    (h : d ≠ .approved) : enactMerge kb c d = kb := by
  cases d with
  | pending => rfl
  | rejected => rfl
  | approved => exact absurd rfl h

-- @source DASHI Agda bridge (PR #555/#581/#582): no solver output edits the ontology
/-- **No approval overrides the checks.**  An approved but ungated merge is still
not applied. -/
theorem enactMerge_eq_of_gate_failed (kb : KB) (c : MergeCandidate) (d : Epistemic.Decision)
    (h : mergeGate c = false) : enactMerge kb c d = kb := by
  cases d with
  | pending => rfl
  | rejected => rfl
  | approved => simp [enactMerge, h]

-- @source DASHI Agda bridge (PR #555/#581/#582): no solver output edits the ontology
/-- In particular a geometry-only candidate never edits the base. -/
theorem geometryOnly_never_edits (kb : KB) (a b : Qid) (d : Epistemic.Decision) :
    enactMerge kb (geometryOnly a b) d = kb :=
  enactMerge_eq_of_gate_failed kb _ d (geometryOnly_fails_gate a b)

-- @source DASHI Agda bridge (PR #555/#581/#582): no solver output edits the ontology
/-- **A merge is not inert.**  Unlike pruning a redundant edge, applying a merge
moves the derived instance relation: after merging `Q100` into `Q101`, the
instances of `Q100` become instances of `Q101`.  That is why the gate and the
review exist. -/
theorem applied_merge_changes_instances :
    ¬ InstanceOf learningKB ⟨1⟩ ⟨101⟩ ∧
      InstanceOf (applyMerge learningKB (fullyChecked cls ⟨101⟩)) ⟨1⟩ ⟨101⟩ := by
  constructor
  · intro h
    exact absurd ((isInstanceOf_iff learningKB ⟨1⟩ ⟨101⟩).2 h) (by decide)
  · exact (isInstanceOf_iff _ ⟨1⟩ ⟨101⟩).1 (by decide)

end Wikidata
