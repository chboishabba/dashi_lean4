open import Agda.Builtin.Equality using (_≡_; refl)

open import DASHI.Physics.Closure.ShiftContractGeneratorTaxonomy as GT
  using
    ( PrefixBoundaryShape
    ; ShiftContractGeneratorTaxonomy
