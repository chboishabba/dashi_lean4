    G6.canonicalG6NontrivialTrackedCrossLaneCommutingReceipt
canonicalG6TrackedAboveThresholdCoordinateIndependence =
  trackedAboveThresholdCoordinateIndependenceFromReceipt
    G6.canonicalG6NontrivialTrackedCrossLaneCommutingReceipt

