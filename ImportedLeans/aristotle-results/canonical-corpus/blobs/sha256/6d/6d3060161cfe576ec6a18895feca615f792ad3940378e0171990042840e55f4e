ContinuityChargeLaw =
  (w : SPWSI.ShiftWavePhaseState) →
  continuityCharge w
    ≡
  continuityCharge (SPWSI.advanceWavePhaseState w)

continuityChargeWitness :
  ContinuityChargeLaw
continuityChargeWitness =
  SPWSI.shiftPhaseWaveInterferenceTransport

