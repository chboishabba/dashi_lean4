/-
# Row A-ii — the cumulative sensitivity `q < 1` from the history-response kernel

`RowAShooting` turns a cumulative sensitivity `q < 1` of the beta history with
respect to the bare coupling into the tuned bare coupling, and `RowACompletion`
turns that, together with the shell bounds, into the Row-A completion predicate.
What was still supplied as a bare hypothesis there was the per-shell Lipschitz
constant `L_j`.

This file *derives* the whole cumulative sensitivity from two structural inputs
the Row-A lane already owns:

* the **history-response kernel** of `BetaHistoryResponse`:
  `|β_j(g) − β_j(g')| ≤ Σ_{k<j} |R_{j,k}|·|g_k − g'_k|` with geometric decay
  `|R_{j,k}| ≤ C θ^{j−k}`, `0 ≤ θ < 1` — itself derived in `HistoryChainRule`
  from a uniform one-step irrelevance factor;
* a **summable sensitivity of the coupling history to the bare coupling**,
  `|g_k(v) − g_k(w)| ≤ S_k|v − w|` with `Σ_k S_k ≤ S_tot`.

The output is
`Σ_{j<K} L_j ≤ C·θ/(1−θ)·S_tot`, **uniformly in the cutoff `K`** — the double sum
is resummed by exchanging the order of summation, which is where the uniformity
comes from — and hence `q < 1` whenever `C·θ/(1−θ)·S_tot < 1`.

`rowA_completion_of_response_decay` chains this into the Row-A completion
predicate.  The residual physical inputs are then exactly two scalars: the
one-step irrelevance factor `θ` behind the response decay, and the total history
sensitivity `S_tot`.  Neither is supplied by the Bałaban source pack; see
`docs/ym/rowA_source_pack_verification_round.md`.

Note on the history argument: `hist v` is *any* assignment of a coupling history
to a bare coupling; in the intended instantiation it is the coupling history of
the trajectory generated by `v`.  No consistency hypothesis is needed because the
estimate is proved for an arbitrary assignment.
-/
import RequestProject.YangMills.BetaHistoryResponse
import RequestProject.YangMills.RowACompletion

namespace YangMills

open Finset

/-- Partial geometric sums are bounded by `(1−θ)⁻¹`. -/
theorem geom_partial_le {theta : ℝ} (h0 : 0 ≤ theta) (h1 : theta < 1) (n : ℕ) :
    ∑ i ∈ range n, theta ^ i ≤ (1 - theta)⁻¹ := by
  have hs : Summable (fun i : ℕ => theta ^ i) := summable_geometric_of_lt_one h0 h1
  have h := hs.sum_le_tsum (range n) (fun i _ => pow_nonneg h0 i)
  rwa [tsum_geometric_of_lt_one h0 h1] at h

/-- The per-shell Lipschitz constant of the shell coefficient in the bare
coupling, produced by the response kernel and the history sensitivity. -/
noncomputable def bareSensitivity (C theta : ℝ) (S : ℕ → ℝ) (j : ℕ) : ℝ :=
  ∑ k ∈ range j, C * theta ^ (j - k) * S k

/-- **Per-shell sensitivity to the bare coupling.**  Geometric response decay
composed with a Lipschitz history gives a Lipschitz shell coefficient. -/
theorem bareLipschitz_of_response {beta : ℕ → (ℕ → ℝ) → ℝ} {R : ℕ → ℕ → ℝ}
    {C theta : ℝ} {hist : ℝ → ℕ → ℝ} {S : ℕ → ℝ}
    (hresp : HasHistoryResponse beta R) (hdec : HasResponseDecay R C theta)
    (hS : ∀ k v w, |hist v k - hist w k| ≤ S k * |v - w|)
    (hC : 0 ≤ C) (hth : 0 ≤ theta) (j : ℕ) (v w : ℝ) :
    |beta j (hist v) - beta j (hist w)| ≤ bareSensitivity C theta S j * |v - w| := by
  have h1 : |beta j (hist v) - beta j (hist w)|
      ≤ ∑ k ∈ range j, |R j k| * |hist v k - hist w k| := hresp j (hist v) (hist w)
  have h2 : ∑ k ∈ range j, |R j k| * |hist v k - hist w k|
      ≤ ∑ k ∈ range j, (C * theta ^ (j - k) * S k) * |v - w| := by
    refine Finset.sum_le_sum fun k hk => ?_
    have hkj : k < j := Finset.mem_range.mp hk
    have hR : |R j k| ≤ C * theta ^ (j - k) := hdec j k hkj
    have hpow : 0 ≤ C * theta ^ (j - k) := by positivity
    calc |R j k| * |hist v k - hist w k|
        ≤ (C * theta ^ (j - k)) * |hist v k - hist w k| :=
          mul_le_mul_of_nonneg_right hR (abs_nonneg _)
      _ ≤ (C * theta ^ (j - k)) * (S k * |v - w|) :=
          mul_le_mul_of_nonneg_left (hS k v w) hpow
      _ = (C * theta ^ (j - k) * S k) * |v - w| := by ring
  have h3 : ∑ k ∈ range j, (C * theta ^ (j - k) * S k) * |v - w|
      = bareSensitivity C theta S j * |v - w| := by
    rw [bareSensitivity, Finset.sum_mul]
  linarith [h1, h2, h3.le, h3.ge]

/-- **The cumulative sensitivity, uniformly in the cutoff.**  Exchanging the
order of summation resums the geometric factor scale by scale:
`Σ_{j<K} L_j ≤ C·θ/(1−θ)·S_tot` for every `K`. -/
theorem cumulative_bareSensitivity_le {C theta Stot : ℝ} {S : ℕ → ℝ}
    (hC : 0 ≤ C) (hth0 : 0 ≤ theta) (hth1 : theta < 1) (hS0 : ∀ k, 0 ≤ S k)
    (hStot : ∀ K, ∑ k ∈ range K, S k ≤ Stot) (K : ℕ) :
    ∑ j ∈ range K, bareSensitivity C theta S j ≤ C * (theta / (1 - theta)) * Stot := by
  have hswap : ∑ j ∈ range K, ∑ k ∈ range j, C * theta ^ (j - k) * S k
      = ∑ k ∈ range K, ∑ j ∈ Finset.Ico (k + 1) K, C * theta ^ (j - k) * S k := by
    rw [Finset.sum_sigma', Finset.sum_sigma']
    apply Finset.sum_nbij' (fun x => ⟨x.2, x.1⟩) (fun x => ⟨x.2, x.1⟩) <;>
      simp +contextual [Finset.mem_sigma, Finset.mem_range, Finset.mem_Ico]
    all_goals omega
  -- the inner geometric sum
  have hinner : ∀ k, ∑ j ∈ Finset.Ico (k + 1) K, C * theta ^ (j - k) * S k
      ≤ C * (theta / (1 - theta)) * S k := by
    intro k
    have hfac : ∑ j ∈ Finset.Ico (k + 1) K, C * theta ^ (j - k) * S k
        = (C * S k) * ∑ j ∈ Finset.Ico (k + 1) K, theta ^ (j - k) := by
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun j _ => by ring
    have hgeo : ∑ j ∈ Finset.Ico (k + 1) K, theta ^ (j - k) ≤ theta / (1 - theta) := by
      have hmap : ∑ j ∈ Finset.Ico (k + 1) K, theta ^ (j - k)
          = ∑ i ∈ range (K - (k + 1)), theta ^ (i + 1) := by
        rw [Finset.sum_Ico_eq_sum_range]
        refine Finset.sum_congr rfl fun i hi => ?_
        congr 1
        omega
      rw [hmap]
      have hfac2 : ∑ i ∈ range (K - (k + 1)), theta ^ (i + 1)
          = theta * ∑ i ∈ range (K - (k + 1)), theta ^ i := by
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl fun i _ => by ring
      rw [hfac2, div_eq_mul_inv]
      exact mul_le_mul_of_nonneg_left (geom_partial_le hth0 hth1 _) hth0
    have hCS : 0 ≤ C * S k := mul_nonneg hC (hS0 k)
    calc ∑ j ∈ Finset.Ico (k + 1) K, C * theta ^ (j - k) * S k
        = (C * S k) * ∑ j ∈ Finset.Ico (k + 1) K, theta ^ (j - k) := hfac
      _ ≤ (C * S k) * (theta / (1 - theta)) := mul_le_mul_of_nonneg_left hgeo hCS
      _ = C * (theta / (1 - theta)) * S k := by ring
  have hsum : ∑ k ∈ range K, ∑ j ∈ Finset.Ico (k + 1) K, C * theta ^ (j - k) * S k
      ≤ ∑ k ∈ range K, C * (theta / (1 - theta)) * S k :=
    Finset.sum_le_sum fun k _ => hinner k
  have hfin : ∑ k ∈ range K, C * (theta / (1 - theta)) * S k
      ≤ C * (theta / (1 - theta)) * Stot := by
    rw [← Finset.mul_sum]
    have hnn : 0 ≤ C * (theta / (1 - theta)) := by
      have : 0 ≤ theta / (1 - theta) := by
        have : 0 < 1 - theta := by linarith
        positivity
      positivity
    exact mul_le_mul_of_nonneg_left (hStot K) hnn
  calc ∑ j ∈ range K, bareSensitivity C theta S j
      = ∑ j ∈ range K, ∑ k ∈ range j, C * theta ^ (j - k) * S k := by
        refine Finset.sum_congr rfl fun j _ => rfl
    _ = ∑ k ∈ range K, ∑ j ∈ Finset.Ico (k + 1) K, C * theta ^ (j - k) * S k := hswap
    _ ≤ ∑ k ∈ range K, C * (theta / (1 - theta)) * S k := hsum
    _ ≤ C * (theta / (1 - theta)) * Stot := hfin

/-- **Row A's completion predicate from the response kernel.**  The `q < 1`
hypothesis of `rowA_completion_of_uniform_debt` is now itself derived: geometric
response decay of the history kernel plus a summable history sensitivity to the
bare coupling give a cumulative sensitivity bounded uniformly in the cutoff, and
the completion predicate follows as soon as that bound is below `1`. -/
theorem rowA_completion_of_response_decay
    {beta : ℕ → (ℕ → ℝ) → ℝ} {R : ℕ → ℕ → ℝ} {betaZ betaInt : ℕ → ℝ → ℝ}
    {C theta Stot target bZm bZp eps : ℝ} {S : ℕ → ℝ} {hist : ℝ → ℕ → ℝ} {K : ℕ}
    (hresp : HasHistoryResponse beta R) (hdec : HasResponseDecay R C theta)
    (hS : ∀ k v w, |hist v k - hist w k| ≤ S k * |v - w|) (hS0 : ∀ k, 0 ≤ S k)
    (hC : 0 ≤ C) (hth0 : 0 ≤ theta) (hth1 : theta < 1)
    (hStot : ∀ K', ∑ k ∈ range K', S k ≤ Stot) (hStot0 : 0 ≤ Stot)
    (hq1 : C * (theta / (1 - theta)) * Stot < 1)
    (hdecomp : ∀ j v, beta j (hist v) = betaZ j v + betaInt j v)
    (hZl : ∀ j v, bZm ≤ betaZ j v) (hZu : ∀ j v, betaZ j v ≤ bZp)
    (hIntEps : ∀ j v, |betaInt j v| ≤ eps)
    (hwin : 0 < target - (bZp + eps) * K) (hepsm : eps < bZm) :
    RowACompletion (fun j v => beta j (hist v)) K target
      (bZm - eps) (bZp + eps) (target - (bZp + eps) * K)⁻¹ := by
  have hq0 : 0 ≤ C * (theta / (1 - theta)) * Stot := by
    have h1 : 0 ≤ theta / (1 - theta) := by
      have : 0 < 1 - theta := by linarith
      positivity
    positivity
  refine rowA_completion_of_uniform_debt
    (bet := fun j v => beta j (hist v)) (betaZ := betaZ) (betaInt := betaInt)
    (L := bareSensitivity C theta S) (q := C * (theta / (1 - theta)) * Stot)
    hdecomp hZl hZu hIntEps
    (fun j v w => bareLipschitz_of_response hresp hdec hS hC hth0 j v w)
    (cumulative_bareSensitivity_le hC hth0 hth1 hS0 hStot K) hq0 hq1 hwin hepsm

end YangMills
