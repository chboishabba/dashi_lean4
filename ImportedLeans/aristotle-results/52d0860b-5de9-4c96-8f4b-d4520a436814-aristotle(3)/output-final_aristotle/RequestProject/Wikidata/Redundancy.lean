namespace Wikidata

/-- Delete one occurrence of a statement from a knowledge base. -/
def prune (kb : KB) (st : Statement) : KB :=
  { kb with statements := kb.statements.erase st }

@[simp] theorem prune_entities (kb : KB) (st : Statement) : (prune kb st).entities = kb.entities :=
  rfl

theorem mem_statements_prune {kb : KB} {st t : Statement} (h : t ∈ (prune kb st).statements) :
    t ∈ kb.statements :=
  List.mem_of_mem_erase h

theorem mem_statements_prune_of_ne {kb : KB} {st t : Statement} (hne : t ≠ st)
    (h : t ∈ kb.statements) : t ∈ (prune kb st).statements :=
  (List.mem_erase_of_ne hne).2 h

private theorem any_erase_of_false {α : Type} [DecidableEq α] (l : List α) (a : α)
    (p : α → Bool) (h : p a = false) : (l.erase a).any p = l.any p := by
  rw [Bool.eq_iff_iff]
  simp only [List.any_eq_true]
  constructor
  · rintro ⟨x, hx, hpx⟩
    exact ⟨x, List.mem_of_mem_erase hx, hpx⟩
  · rintro ⟨x, hx, hpx⟩
    have hne : x ≠ a := by
      rintro rfl
      rw [h] at hpx
      exact absurd hpx (by simp)
    exact ⟨x, (List.mem_erase_of_ne hne).2 hx, hpx⟩

/-- Deleting a *normal* statement does not change which statements are truthy:
it cannot promote a normal statement by removing a preferred one. -/
theorem isTruthy_prune (kb : KB) (st : Statement) (hst : st.rank = Rank.normal)
    (t : Statement) : IsTruthy (prune kb st) t = IsTruthy kb t := by
  have hpref : ∀ s p, hasPreferred (prune kb st) s p = hasPreferred kb s p := by
    intro s p
    simp only [hasPreferred, statementsFor, prune, List.any_filter]
    exact any_erase_of_false _ _ _ (by simp [hst])
  simp [IsTruthy, hpref]

section Prune

variable {kb : KB} {st : Statement}

theorem subclassEdges_prune_subset (hst : st.rank = Rank.normal) {a b : Qid}
    (h : (a, b) ∈ subclassEdges (prune kb st)) : (a, b) ∈ subclassEdges kb := by
  simp only [subclassEdges, List.mem_map, List.mem_filter, decide_eq_true_eq] at h ⊢
  obtain ⟨t, ⟨ht, hp, htruthy⟩, heq⟩ := h
  exact ⟨t, ⟨mem_statements_prune ht, hp, by rwa [isTruthy_prune kb st hst] at htruthy⟩, heq⟩

theorem subclassEdges_prune_of_ne (hst : st.rank = Rank.normal) {a b : Qid}
    (h : (a, b) ∈ subclassEdges kb) (hne : (a, b) ≠ (st.subject, st.value)) :
    (a, b) ∈ subclassEdges (prune kb st) := by
  simp only [subclassEdges, List.mem_map, List.mem_filter, decide_eq_true_eq] at h ⊢
  obtain ⟨t, ⟨ht, hp, htruthy⟩, heq⟩ := h
  have htne : t ≠ st := by
    rintro rfl
    exact hne heq.symm
  exact ⟨t, ⟨mem_statements_prune_of_ne htne ht, hp, by rw [isTruthy_prune kb st hst]; exact htruthy⟩,
    heq⟩

/-- A statement is redundant when its endpoints stay connected after deletion. -/
def Redundant (kb : KB) (st : Statement) : Prop :=
  SubclassOf (prune kb st) st.subject st.value

/-- Executable redundancy check. -/
def isRedundant (kb : KB) (st : Statement) : Bool :=
  isSubclassOf (prune kb st) st.subject st.value

theorem isRedundant_iff (kb : KB) (st : Statement) :
    isRedundant kb st = true ↔ Redundant kb st :=
  isSubclassOf_iff _ _ _

/-- Pruning never invents subclass relationships. -/
theorem subclassOf_of_subclassOf_prune (hst : st.rank = Rank.normal) {a b : Qid}
    (h : SubclassOf (prune kb st) a b) : SubclassOf kb a b := by
  induction h with
  | refl => exact Relation.ReflTransGen.refl
  | tail _ hstep ih =>
      exact Relation.ReflTransGen.tail ih (subclassEdges_prune_subset hst hstep)

/-- **Redundancy pruning preserves the subclass relation.** -/
theorem subclassOf_prune_iff (hst : st.rank = Rank.normal) (hred : Redundant kb st) (a b : Qid) :
    SubclassOf (prune kb st) a b ↔ SubclassOf kb a b := by
  constructor
  · exact subclassOf_of_subclassOf_prune hst
  · intro h
    induction h with
    | refl => exact Relation.ReflTransGen.refl
    | tail _ hstep ih =>
        rename_i x y _
        by_cases hxy : (x, y) = (st.subject, st.value)
        · have : SubclassOf (prune kb st) x y := by
            have h1 : x = st.subject := congrArg Prod.fst hxy
            have h2 : y = st.value := congrArg Prod.snd hxy
            rw [h1, h2]
            exact hred
          exact Relation.ReflTransGen.trans ih this
        · exact Relation.ReflTransGen.tail ih (subclassEdges_prune_of_ne hst hstep hxy)

/-- Pruning a `P279` statement leaves the `P31` edges untouched. -/
theorem instanceEdges_prune (hst : st.rank = Rank.normal) (hp : st.property = P279) (x c : Qid) :
    ((x, c) ∈ instanceEdges (prune kb st) ↔ (x, c) ∈ instanceEdges kb) := by
  simp only [instanceEdges, List.mem_map, List.mem_filter, decide_eq_true_eq]
  constructor
  · rintro ⟨t, ⟨ht, hpt, htruthy⟩, heq⟩
    exact ⟨t, ⟨mem_statements_prune ht, hpt, by rwa [isTruthy_prune kb st hst] at htruthy⟩, heq⟩
  · rintro ⟨t, ⟨ht, hpt, htruthy⟩, heq⟩
    have htne : t ≠ st := by
      rintro rfl
      rw [hp] at hpt
      exact absurd hpt (by decide)
    exact ⟨t, ⟨mem_statements_prune_of_ne htne ht, hpt,
      by rw [isTruthy_prune kb st hst]; exact htruthy⟩, heq⟩

/-- **Redundancy pruning preserves the instance relation.** -/
theorem instanceOf_prune_iff (hst : st.rank = Rank.normal) (hp : st.property = P279)
    (hred : Redundant kb st) (x c : Qid) :
    InstanceOf (prune kb st) x c ↔ InstanceOf kb x c := by
  constructor
  · rintro ⟨c₀, hc₀, hsub⟩
    exact ⟨c₀, (instanceEdges_prune hst hp x c₀).1 hc₀, (subclassOf_prune_iff hst hred c₀ c).1 hsub⟩
  · rintro ⟨c₀, hc₀, hsub⟩
    exact ⟨c₀, (instanceEdges_prune hst hp x c₀).2 hc₀, (subclassOf_prune_iff hst hred c₀ c).2 hsub⟩

end Prune

end Wikidata
