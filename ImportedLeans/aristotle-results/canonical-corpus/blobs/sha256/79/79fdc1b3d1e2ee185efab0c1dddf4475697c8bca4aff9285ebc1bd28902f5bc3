  doubledIntegerRootFamily :
    E8DoubledCoordinateFamily
  doubledHalfIntegerRootFamily :
    E8DoubledCoordinateFamily

canonicalE8DoubledCoordinateFamilies :
  List E8DoubledCoordinateFamily
