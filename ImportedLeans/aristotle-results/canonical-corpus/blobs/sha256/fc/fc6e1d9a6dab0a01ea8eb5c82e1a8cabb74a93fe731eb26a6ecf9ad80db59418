namespace Wikidata

namespace Sparql

/-! ## Solution mappings -/

/-- A SPARQL variable. -/
abbrev Var := String

/-- A term of a triple pattern: a fixed item or a variable. -/
inductive Term
  | item (q : Qid)
  | var (v : Var)
  deriving DecidableEq, Repr, Inhabited

/-- A solution mapping, as an association list. -/
abbrev Binding := List (Var × Qid)

/-- The value a solution mapping gives a variable, if any. -/
def lookupVar : Binding → Var → Option Qid
  | [], _ => none
  | (w, q) :: r, v => if w = v then some q else lookupVar r v

@[simp] theorem lookupVar_nil (v : Var) : lookupVar [] v = none := rfl

/-- A triple pattern: subject and object may be variables, the property is fixed
(as it is in the overwhelming majority of Wikidata queries). -/
structure TriplePattern where
  subj : Term
  prop : Pid
  obj : Term
  deriving DecidableEq, Repr, Inhabited

/-- Match a term against an item, extending the solution mapping if the term is a
fresh variable. -/
def matchTerm (b : Binding) : Term → Qid → Option Binding
  | Term.item q, r => if q = r then some b else none
  | Term.var v, r =>
      match lookupVar b v with
      | none => some (b ++ [(v, r)])
      | some q => if q = r then some b else none

/-- Match a triple pattern against a statement. -/
def matchPattern (b : Binding) (tp : TriplePattern) (st : Statement) : Option Binding :=
  if st.property = tp.prop then
    match matchTerm b tp.subj st.subject with
    | none => none
    | some b' => matchTerm b' tp.obj st.value
  else none

/-- The statements the query service sees: the truthy projection. -/
def truthyStatements (kb : KB) : List Statement :=
  kb.statements.filter (fun st => IsTruthy kb st)

theorem mem_truthyStatements_iff (kb : KB) (st : Statement) :
    st ∈ truthyStatements kb ↔ st ∈ kb.statements ∧ IsTruthy kb st = true := by
  simp [truthyStatements, List.mem_filter]

/-- Evaluate a triple pattern from a partial solution mapping. -/
def evalPattern (kb : KB) (b : Binding) (tp : TriplePattern) : List Binding :=
  (truthyStatements kb).filterMap (fun st => matchPattern b tp st)

theorem mem_evalPattern_iff (kb : KB) (b : Binding) (tp : TriplePattern) (b' : Binding) :
    b' ∈ evalPattern kb b tp ↔
      ∃ st ∈ truthyStatements kb, matchPattern b tp st = some b' := by
  simp [evalPattern, List.mem_filterMap]

/-- **Soundness**: every answer to a pattern comes from a truthy statement of the
knowledge base. -/
theorem evalPattern_sound {kb : KB} {b b' : Binding} {tp : TriplePattern}
    (h : b' ∈ evalPattern kb b tp) :
    ∃ st ∈ kb.statements, IsTruthy kb st = true ∧ matchPattern b tp st = some b' := by
  rw [mem_evalPattern_iff] at h
  obtain ⟨st, hst, hmatch⟩ := h
  rw [mem_truthyStatements_iff] at hst
  exact ⟨st, hst.1, hst.2, hmatch⟩

/-! ## Queries -/

/-- The classical core fragment of SPARQL. -/
inductive Query
  | pattern (tp : TriplePattern)
  | and (q₁ q₂ : Query)
  | union (q₁ q₂ : Query)
  | opt (q₁ q₂ : Query)
  | filterBound (q : Query) (v : Var)
  | filterNotBound (q : Query) (v : Var)
  deriving DecidableEq, Repr, Inhabited

/-- Nested-loop evaluation from a partial solution mapping. -/
def evalFrom (kb : KB) : Query → Binding → List Binding
  | Query.pattern tp, b => evalPattern kb b tp
  | Query.and q₁ q₂, b => (evalFrom kb q₁ b).flatMap (fun b' => evalFrom kb q₂ b')
  | Query.union q₁ q₂, b => evalFrom kb q₁ b ++ evalFrom kb q₂ b
  | Query.opt q₁ q₂, b =>
      (evalFrom kb q₁ b).flatMap (fun b' =>
        match evalFrom kb q₂ b' with
        | [] => [b']
        | l => l)
  | Query.filterBound q v, b =>
      (evalFrom kb q b).filter (fun b' => (lookupVar b' v).isSome)
  | Query.filterNotBound q v, b =>
      (evalFrom kb q b).filter (fun b' => (lookupVar b' v).isNone)

/-- The answers to a query: evaluation from the empty solution mapping. -/
def eval (kb : KB) (q : Query) : List Binding := evalFrom kb q []

/-! ## The positive fragment is monotone -/

/-- The fragment built without `OPTIONAL` and without `!bound`. -/
def Positive : Query → Prop
  | Query.pattern _ => True
  | Query.and q₁ q₂ => Positive q₁ ∧ Positive q₂
  | Query.union q₁ q₂ => Positive q₁ ∧ Positive q₂
  | Query.opt _ _ => False
  | Query.filterBound q _ => Positive q
  | Query.filterNotBound _ _ => False

theorem evalPattern_mono {kb₁ kb₂ : KB} (hsub : kb₁.statements ⊆ kb₂.statements)
    (h₂ : AllNormal kb₂) (b : Binding) (tp : TriplePattern) {b' : Binding}
    (h : b' ∈ evalPattern kb₁ b tp) : b' ∈ evalPattern kb₂ b tp := by
  rw [mem_evalPattern_iff] at h ⊢
  obtain ⟨st, hst, hmatch⟩ := h
  rw [mem_truthyStatements_iff] at hst
  refine ⟨st, ?_, hmatch⟩
  rw [mem_truthyStatements_iff]
  exact ⟨hsub hst.1, isTruthy_of_allNormal h₂ (hsub hst.1)⟩

/-- **Monotonicity of the positive fragment.**  Every answer over a knowledge base
is an answer over any larger one, so on this fragment new data never withdraws an
answer. -/
theorem evalFrom_mono {kb₁ kb₂ : KB} (hsub : kb₁.statements ⊆ kb₂.statements)
    (h₂ : AllNormal kb₂) :
    ∀ (q : Query), Positive q → ∀ (b b' : Binding),
      b' ∈ evalFrom kb₁ q b → b' ∈ evalFrom kb₂ q b := by
  intro q
  induction q with
  | pattern tp => intro _ b b' h; exact evalPattern_mono hsub h₂ b tp h
  | and q₁ q₂ ih₁ ih₂ =>
      intro hpos b b' h
      simp only [evalFrom, List.mem_flatMap] at h ⊢
      obtain ⟨c, hc, hb'⟩ := h
      exact ⟨c, ih₁ hpos.1 b c hc, ih₂ hpos.2 c b' hb'⟩
  | union q₁ q₂ ih₁ ih₂ =>
      intro hpos b b' h
      simp only [evalFrom, List.mem_append] at h ⊢
      exact h.imp (ih₁ hpos.1 b b') (ih₂ hpos.2 b b')
  | opt q₁ q₂ _ _ => intro hpos; exact absurd hpos not_false
  | filterBound q v ih =>
      intro hpos b b' h
      simp only [evalFrom, List.mem_filter] at h ⊢
      exact ⟨ih hpos b b' h.1, h.2⟩
  | filterNotBound q v _ => intro hpos; exact absurd hpos not_false

theorem eval_mono {kb₁ kb₂ : KB} (hsub : kb₁.statements ⊆ kb₂.statements)
    (h₂ : AllNormal kb₂) {q : Query} (hpos : Positive q) {b' : Binding}
    (h : b' ∈ eval kb₁ q) : b' ∈ eval kb₂ q :=
  evalFrom_mono hsub h₂ q hpos [] b' h

/-! ## Two knowledge bases, one contained in the other -/

/-- The smaller base: one instance statement. -/
def smallKB : KB := ⟨[⟨1⟩, ⟨2⟩, ⟨3⟩], [⟨⟨1⟩, P31, ⟨2⟩, Rank.normal⟩]⟩

/-- The larger base: the same statement, plus a subclass statement about the same
subject. -/
def bigKB : KB :=
  ⟨[⟨1⟩, ⟨2⟩, ⟨3⟩], [⟨⟨1⟩, P31, ⟨2⟩, Rank.normal⟩, ⟨⟨1⟩, P279, ⟨3⟩, Rank.normal⟩]⟩

theorem small_subset_big : smallKB.statements ⊆ bigKB.statements := by decide

theorem bigKB_allNormal : AllNormal bigKB := by
  intro st hst
  simp only [bigKB, List.mem_cons, List.not_mem_nil, or_false] at hst
  rcases hst with h | h <;> subst h <;> rfl

/-- `?x P31 Q2` — the positive pattern. -/
def patX : Query := Query.pattern ⟨Term.var "x", P31, Term.item ⟨2⟩⟩

/-- `?x P279 ?y` — the optional extension. -/
def patY : Query := Query.pattern ⟨Term.var "x", P279, Term.var "y"⟩

/-- `?x P31 Q2 OPTIONAL { ?x P279 ?y }`. -/
def optQuery : Query := Query.opt patX patY

/-- `?x P31 Q2 OPTIONAL { ?x P279 ?y } FILTER (!bound(?y))` — SPARQL's negation. -/
def negQuery : Query := Query.filterNotBound optQuery "y"

/-- **`OPTIONAL` is not monotone.**  The answer `?x = Q1` over the smaller base is
not an answer over the larger one: adding a statement *withdrew* an answer. -/
theorem optional_not_monotone :
    [("x", (⟨1⟩ : Qid))] ∈ eval smallKB optQuery ∧
      [("x", (⟨1⟩ : Qid))] ∉ eval bigKB optQuery := by
  constructor
  · decide
  · decide

/-- **Negation as failure is not monotone.**  `!bound` reports the absence of a
statement as a positive answer, and the answer disappears when the statement
arrives — so such an answer is an absence in *this* base, never a refutation. -/
theorem notBound_not_monotone :
    [("x", (⟨1⟩ : Qid))] ∈ eval smallKB negQuery ∧ eval bigKB negQuery = [] := by
  constructor
  · decide
  · decide

/-- The positive part of the same query behaves as the monotonicity theorem says
it must. -/
theorem positive_query_answer_survives :
    Positive patX ∧
      [("x", (⟨1⟩ : Qid))] ∈ eval smallKB patX ∧ [("x", (⟨1⟩ : Qid))] ∈ eval bigKB patX := by
  refine ⟨trivial, by decide, ?_⟩
  exact eval_mono small_subset_big bigKB_allNormal (q := patX) trivial (by decide)

/-! ## The query layer is the truthy layer -/

/-- A base whose normal statement is shadowed by a preferred one. -/
def rankedKB : KB :=
  ⟨[⟨1⟩, ⟨2⟩, ⟨3⟩],
   [⟨⟨1⟩, P31, ⟨2⟩, Rank.normal⟩, ⟨⟨1⟩, P31, ⟨3⟩, Rank.preferred⟩]⟩

/-- `?x P31 ?y`. -/
def patXY : Query := Query.pattern ⟨Term.var "x", P31, Term.var "y"⟩

/-- **The query reads a projection, not the base.**  The rank-shadowed statement is
in the knowledge base and contributes no answer; only the preferred one does. -/
theorem query_reads_the_truthy_layer :
    (⟨⟨1⟩, P31, ⟨2⟩, Rank.normal⟩ : Statement) ∈ rankedKB.statements ∧
      [("x", (⟨1⟩ : Qid)), ("y", (⟨2⟩ : Qid))] ∉ eval rankedKB patXY ∧
      [("x", (⟨1⟩ : Qid)), ("y", (⟨3⟩ : Qid))] ∈ eval rankedKB patXY := by
  refine ⟨by decide, by decide, by decide⟩

/-- A base whose only statement is deprecated. -/
def deprecatedKB : KB := ⟨[⟨1⟩, ⟨2⟩], [⟨⟨1⟩, P31, ⟨2⟩, Rank.deprecated⟩]⟩

/-- **Deprecated data is unanswerable.**  The statement is recorded and the query
returns nothing, so an empty answer set does not even mean the base is silent. -/
theorem deprecated_statement_is_unanswerable :
    (⟨⟨1⟩, P31, ⟨2⟩, Rank.deprecated⟩ : Statement) ∈ deprecatedKB.statements ∧
      eval deprecatedKB patXY = [] := by
  refine ⟨by decide, by decide⟩

/-- **An empty answer set is not a refutation**, even in the positive fragment:
the query has no answers over the smaller base and an answer over the larger one. -/
theorem absence_from_answers_is_not_refutation :
    eval smallKB patY = [] ∧ [("x", (⟨1⟩ : Qid)), ("y", (⟨3⟩ : Qid))] ∈ eval bigKB patY := by
  refine ⟨by decide, by decide⟩

/-! ## The query does not close over the class order -/

/-- A base where instance-hood of `Q3` is derived through a subclass edge. -/
def closureKB : KB :=
  ⟨[⟨1⟩, ⟨2⟩, ⟨3⟩],
   [⟨⟨1⟩, P31, ⟨2⟩, Rank.normal⟩, ⟨⟨2⟩, P279, ⟨3⟩, Rank.normal⟩]⟩

/-- **A triple pattern is not the instance relation.**  The engine derives that
`Q1` is an instance of `Q3` through the subclass edge; the pattern `?x P31 Q3`
returns nothing, because a triple pattern reads statements and not the closure.
Recovering the closure needs a property path (`P31/P279*`), which this fragment
deliberately does not model. -/
theorem query_does_not_close_over_subclasses :
    InstanceOf closureKB ⟨1⟩ ⟨3⟩ ∧
      [("x", (⟨1⟩ : Qid))] ∉
        eval closureKB (Query.pattern ⟨Term.var "x", P31, Term.item ⟨3⟩⟩) := by
  refine ⟨(isInstanceOf_iff _ ⟨1⟩ ⟨3⟩).1 (by decide), by decide⟩

end Sparql

end Wikidata
