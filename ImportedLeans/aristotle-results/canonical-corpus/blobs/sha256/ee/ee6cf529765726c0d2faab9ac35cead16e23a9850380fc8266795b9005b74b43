    (the-square-commuting-by η and-inducing-an-equivalence-by proof-of-equivalence′)
    =
      {-
       obtain a factorization by using
       universality of the right pullback square

        w₁
       W--> Z--z₁
       |\       ↘
       | φ->P--> A
       |    |⌟   |
       w₂   p₂   f
       |    |    |
       v h  v g  v
       D -> B -> C

       φ is the induced map to the pullback of f and g
