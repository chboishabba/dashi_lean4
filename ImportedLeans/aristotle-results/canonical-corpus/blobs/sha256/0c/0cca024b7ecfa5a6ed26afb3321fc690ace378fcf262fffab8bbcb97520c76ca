/-
# Row B — the polymer entropy bound: connected sets are exponentially many

`RowBShellEnergy` needs, besides the activity decay, an entropy bound

    #{X : shell(X) = n} ≤ B e^{ν n}

for the polymer family.  For the polymer families of a lattice cluster expansion
the polymers are *connected* sets of blocks, so the required statement is the
lattice-animal counting bound: in a graph of bounded degree `d`, the number of
connected sets of size `n` containing a fixed vertex grows at most
exponentially in `n`.

This file proves that from scratch.  The argument is the classical
depth-first-traversal encoding, arranged so that no spanning-tree or graph-metric
machinery is needed:

* `exists_boundary_edge` — a connected set has an edge from any proper subset
  containing the base point to its complement (the greedy growth step);
* `CoverWalk` — a closed walk from `v`, of length at most `2(|T|−1)`, staying in
  `T` and visiting every vertex of `T`;
* `coverWalk_insert` — a cover walk for `T` is extended to one for `T ∪ {y}` by
  splicing in the two-step detour `x → y → x` at a time when it stands at `x`;
* `exists_coverWalk` — hence every connected set carries a cover walk;
* `connected_subsets_card_le` — since a walk is determined by its sequence of
  neighbour choices, and the set it covers is determined by the walk, the number
  of connected sets of size `n` containing `v` is at most
  `(2n−1)·d^{2n−2}`;
* `connected_subsets_entropy` — in the exponential form `B e^{νn}` that Row B
  consumes, with `B = 2` and `ν = 1 + 2 log d`.
-/
import Mathlib

namespace YangMills

open Finset

variable {V : Type*} {ι : Type*}

/-! ## 1. Walks generated by a sequence of neighbour choices -/

/-- The walk from `v` that at step `i` moves to the `c i`-th neighbour. -/
def walkOf (nbE : V → ι → V) (v : V) (c : ℕ → ι) : ℕ → V
  | 0 => v
  | (i + 1) => nbE (walkOf nbE v c i) (c i)

@[simp] theorem walkOf_zero (nbE : V → ι → V) (v : V) (c : ℕ → ι) :
    walkOf nbE v c 0 = v := rfl

theorem walkOf_succ (nbE : V → ι → V) (v : V) (c : ℕ → ι) (i : ℕ) :
    walkOf nbE v c (i + 1) = nbE (walkOf nbE v c i) (c i) := rfl

/-- Reachability inside a set: a walk from `v` to `u` all of whose vertices lie
in `S`. -/
def ReachIn (nb : V → Finset V) (S : Finset V) (v u : V) : Prop :=
  ∃ (L : ℕ) (w : ℕ → V), w 0 = v ∧ w L = u ∧ (∀ i < L, w (i + 1) ∈ nb (w i))
    ∧ (∀ i ≤ L, w i ∈ S)

/-- A set is a *connected animal* based at `v` when it contains `v` and every
member is reachable from `v` without leaving the set. -/
def IsAnimal (nb : V → Finset V) (v : V) (S : Finset V) : Prop :=
  v ∈ S ∧ ∀ u ∈ S, ReachIn nb S v u

/-! ## 2. The greedy growth step -/

/-- **From a proper subset of a connected set there is an edge leaving it.**
Take a walk to a vertex outside the subset and stop at the first step that
leaves. -/
theorem exists_boundary_edge [DecidableEq V] {nb : V → Finset V} {S T : Finset V} {v : V}
    (hv : v ∈ T) (hTS : T ⊆ S) (hne : T ≠ S) (hconn : IsAnimal nb v S) :
    ∃ x ∈ T, ∃ y ∈ S, y ∉ T ∧ y ∈ nb x := by
  classical
  obtain ⟨z, hzS, hzT⟩ : ∃ z ∈ S, z ∉ T := by
    by_contra hcon
    push_neg at hcon
    exact hne (Finset.Subset.antisymm hTS hcon)
  obtain ⟨L, w, hw0, hwL, hstep, hmem⟩ := hconn.2 z hzS
  have hex : ∃ i, i ≤ L ∧ w i ∉ T := ⟨L, le_rfl, by rw [hwL]; exact hzT⟩
  obtain ⟨hiL, hiT⟩ := Nat.find_spec hex
  have hipos : Nat.find hex ≠ 0 := by
    intro h
    exact hiT (by rw [h, hw0]; exact hv)
  obtain ⟨j, hj⟩ : ∃ j, Nat.find hex = j + 1 := ⟨Nat.find hex - 1, by omega⟩
  have hjT : w j ∈ T := by
    have hlt : j < Nat.find hex := by omega
    have hmin := Nat.find_min hex hlt
    push_neg at hmin
    exact hmin (by omega)
  refine ⟨w j, hjT, w (Nat.find hex), hmem _ hiL, hiT, ?_⟩
  have hstepj : w (j + 1) ∈ nb (w j) := hstep j (by omega)
  rwa [← hj] at hstepj

/-! ## 3. Cover walks -/

/-- A closed walk from `v`, of length `L ≤ 2(|T|−1)`, which stays inside `T` and
visits every vertex of `T`. -/
structure CoverWalk (nbE : V → ι → V) (v : V) (T : Finset V) (L : ℕ)
    (c : ℕ → ι) : Prop where
  ret : walkOf nbE v c L = v
  stay : ∀ i ≤ L, walkOf nbE v c i ∈ T
  cover : ∀ y ∈ T, ∃ i ≤ L, walkOf nbE v c i = y
  len : L ≤ 2 * (T.card - 1)

/-- The trivial cover walk of the one-point set. -/
theorem coverWalk_singleton [DecidableEq V] (nbE : V → ι → V) (v : V) (c : ℕ → ι) :
    CoverWalk nbE v {v} 0 c where
  ret := rfl
  stay := by
    intro i hi
    interval_cases i
    simp
  cover := by
    intro y hy
    refine ⟨0, le_rfl, ?_⟩
    simpa using (Finset.mem_singleton.mp hy).symm
  len := by simp

/-- The spliced choice sequence: run `c` up to time `t`, then take the two-step
detour, then resume `c`. -/
def spliceChoice (c : ℕ → ι) (t : ℕ) (iy ix : ι) : ℕ → ι := fun i =>
  if i < t then c i else if i = t then iy else if i = t + 1 then ix else c (i - 2)

theorem walkOf_splice_le {nbE : V → ι → V} {v : V} {c : ℕ → ι} {t : ℕ}
    (iy ix : ι) : ∀ i ≤ t,
    walkOf nbE v (spliceChoice c t iy ix) i = walkOf nbE v c i := by
  intro i
  induction i with
  | zero => intro _; rfl
  | succ i ih =>
      intro hi
      have hit : i < t := by omega
      rw [walkOf_succ, walkOf_succ, ih (by omega)]
      congr 1
      simp [spliceChoice, hit]

theorem walkOf_splice_shift {nbE : V → ι → V} {v x y : V} {c : ℕ → ι} {t : ℕ}
    {iy ix : ι} (hxt : walkOf nbE v c t = x)
    (hiy : nbE x iy = y) (hix : nbE y ix = x) : ∀ i, t ≤ i →
    walkOf nbE v (spliceChoice c t iy ix) (i + 2) = walkOf nbE v c i := by
  have hstep1 : walkOf nbE v (spliceChoice c t iy ix) (t + 1) = y := by
    rw [walkOf_succ, walkOf_splice_le iy ix t le_rfl, hxt]
    simpa [spliceChoice] using hiy
  have hstep2 : walkOf nbE v (spliceChoice c t iy ix) (t + 2) = x := by
    have : t + 2 = (t + 1) + 1 := by omega
    rw [this, walkOf_succ, hstep1]
    have hc : spliceChoice c t iy ix (t + 1) = ix := by
      simp [spliceChoice]
    rw [hc, hix]
  intro i
  induction i with
  | zero =>
      intro hi
      have ht : t = 0 := by omega
      subst ht
      rw [hstep2, ← hxt]
  | succ i ih =>
      intro hi
      rcases Nat.lt_or_ge t (i + 1) with hlt | hge
      · have hti : t ≤ i := by omega
        have hc : spliceChoice c t iy ix (i + 2) = c i := by
          have h1 : ¬ (i + 2 < t) := by omega
          have h2 : ¬ (i + 2 = t) := by omega
          have h3 : ¬ (i + 2 = t + 1) := by omega
          have h4 : i + 2 - 2 = i := by omega
          simp only [spliceChoice, if_neg h1, if_neg h2, if_neg h3, h4]
        have hidx : i + 1 + 2 = (i + 2) + 1 := by omega
        rw [hidx, walkOf_succ, ih hti, hc, walkOf_succ nbE v c i]
      · have ht : t = i + 1 := by omega
        subst ht
        rw [hstep2, ← hxt]

/-- **The detour splice.**  A cover walk for `T` standing at `x` at time `t`,
together with a neighbour `y ∉ T` of `x`, yields a cover walk for `T ∪ {y}` of
length `L + 2`. -/
theorem coverWalk_insert [DecidableEq V] {nbE : V → ι → V} {v x y : V} {T : Finset V}
    {L t : ℕ} {c : ℕ → ι} {iy ix : ι}
    (hcw : CoverWalk nbE v T L c) (hvT : v ∈ T) (ht : t ≤ L)
    (hxt : walkOf nbE v c t = x) (hyT : y ∉ T)
    (hiy : nbE x iy = y) (hix : nbE y ix = x) :
    CoverWalk nbE v (insert y T) (L + 2) (spliceChoice c t iy ix) := by
  have hshift := walkOf_splice_shift (nbE := nbE) (v := v) hxt hiy hix
  have hle := walkOf_splice_le (nbE := nbE) (v := v) (c := c) (t := t) iy ix
  have hstep1 : walkOf nbE v (spliceChoice c t iy ix) (t + 1) = y := by
    rw [walkOf_succ, hle t le_rfl, hxt]
    simpa [spliceChoice] using hiy
  refine ⟨?_, ?_, ?_, ?_⟩
  · rw [hshift L ht, hcw.ret]
  · intro i hi
    rcases Nat.lt_or_ge i (t + 1) with h1 | h1
    · rw [hle i (by omega)]
      exact Finset.mem_insert_of_mem (hcw.stay i (by omega))
    · rcases Nat.eq_or_lt_of_le h1 with h2 | h2
      · rw [← h2, hstep1]
        exact Finset.mem_insert_self _ _
      · obtain ⟨j, hj⟩ : ∃ j, i = j + 2 := ⟨i - 2, by omega⟩
        have hjt : t ≤ j := by omega
        rw [hj, hshift j hjt]
        exact Finset.mem_insert_of_mem (hcw.stay j (by omega))
  · intro z hz
    rcases Finset.mem_insert.mp hz with hz1 | hz1
    · exact ⟨t + 1, by omega, by rw [hstep1, hz1]⟩
    · obtain ⟨i, hiL, hiz⟩ := hcw.cover z hz1
      rcases Nat.lt_or_ge i (t + 1) with h1 | h1
      · exact ⟨i, by omega, by rw [hle i (by omega)]; exact hiz⟩
      · exact ⟨i + 2, by omega, by rw [hshift i (by omega)]; exact hiz⟩
  · have hcard : (insert y T).card = T.card + 1 := Finset.card_insert_of_notMem hyT
    have hT1 : 1 ≤ T.card := Finset.card_pos.mpr ⟨v, hvT⟩
    have := hcw.len
    omega

/-! ## 4. Every connected set carries a cover walk -/

theorem exists_coverWalk_aux [DecidableEq V] {nb : V → Finset V} {nbE : V → ι → V} {v : V}
    {S : Finset V}
    (hnbE : ∀ x y, y ∈ nb x → ∃ i, nbE x i = y)
    (hsym : ∀ x y, y ∈ nb x → x ∈ nb y)
    (hconn : IsAnimal nb v S) :
    ∀ (k : ℕ) (T : Finset V) (L : ℕ) (c : ℕ → ι), T ⊆ S → v ∈ T →
      S.card ≤ T.card + k → CoverWalk nbE v T L c →
      ∃ L' c', CoverWalk nbE v S L' c' := by
  intro k
  induction k with
  | zero =>
      intro T L c hTS hvT hcard hcw
      have hTeq : T = S := Finset.eq_of_subset_of_card_le hTS (by omega)
      exact ⟨L, c, hTeq ▸ hcw⟩
  | succ k ih =>
      intro T L c hTS hvT hcard hcw
      by_cases hTeq : T = S
      · exact ⟨L, c, hTeq ▸ hcw⟩
      · obtain ⟨x, hxT, y, hyS, hyT, hyx⟩ := exists_boundary_edge hvT hTS hTeq hconn
        obtain ⟨t, htL, hxt⟩ := hcw.cover x hxT
        obtain ⟨iy, hiy⟩ := hnbE x y hyx
        obtain ⟨ix, hix⟩ := hnbE y x (hsym x y hyx)
        have hcw' := coverWalk_insert hcw hvT htL hxt hyT hiy hix
        have hcard' : (insert y T).card = T.card + 1 := Finset.card_insert_of_notMem hyT
        exact ih (insert y T) (L + 2) _ (Finset.insert_subset hyS hTS)
          (Finset.mem_insert_of_mem hvT) (by omega) hcw'

/-- **Every connected set carries a closed cover walk of length `≤ 2(|S|−1)`.** -/
theorem exists_coverWalk [DecidableEq V] [Nonempty ι] {nb : V → Finset V} {nbE : V → ι → V} {v : V}
    {S : Finset V} 
    (hnbE : ∀ x y, y ∈ nb x → ∃ i, nbE x i = y)
    (hsym : ∀ x y, y ∈ nb x → x ∈ nb y)
    (hconn : IsAnimal nb v S) :
    ∃ (L : ℕ) (c : ℕ → ι), CoverWalk nbE v S L c := by
  refine exists_coverWalk_aux hnbE hsym hconn S.card {v} 0 (fun _ => (Classical.arbitrary ι))
    ?_ (Finset.mem_singleton_self v) ?_ (coverWalk_singleton nbE v _)
  · simpa using hconn.1
  · simp

/-! ## 5. Counting: the trace of a walk determines the set -/

/-- The set of vertices a walk visits up to time `L`. -/
def traceOf [DecidableEq V] (nbE : V → ι → V) (v : V) (c : ℕ → ι) (L : ℕ) :
    Finset V :=
  (Finset.range (L + 1)).image (walkOf nbE v c)

theorem traceOf_eq_of_coverWalk [DecidableEq V] {nbE : V → ι → V} {v : V} {T : Finset V}
    {L : ℕ} {c : ℕ → ι} (hcw : CoverWalk nbE v T L c) :
    traceOf nbE v c L = T := by
  apply Finset.Subset.antisymm
  · intro z hz
    rw [traceOf, Finset.mem_image] at hz
    obtain ⟨i, hi, hiz⟩ := hz
    rw [Finset.mem_range] at hi
    exact hiz ▸ hcw.stay i (by omega)
  · intro z hz
    obtain ⟨i, hiL, hiz⟩ := hcw.cover z hz
    rw [traceOf, Finset.mem_image]
    exact ⟨i, Finset.mem_range.mpr (by omega), hiz⟩

/-- The walk only depends on the choices it has actually made. -/
theorem walkOf_congr {nbE : V → ι → V} {v : V} {c₁ c₂ : ℕ → ι} {m : ℕ}
    (h : ∀ i, i < m → c₁ i = c₂ i) : ∀ j ≤ m, walkOf nbE v c₁ j = walkOf nbE v c₂ j := by
  intro j
  induction j with
  | zero => intro _; rfl
  | succ j ih =>
      intro hj
      rw [walkOf_succ, walkOf_succ, ih (by omega), h j (by omega)]

/-- The finite decoder: a length together with a finite string of neighbour
choices determines a set of vertices. -/
noncomputable def decodeTrace [DecidableEq V] [Nonempty ι] (nbE : V → ι → V) (v : V) 
    (Lmax : ℕ) (p : Fin (Lmax + 1) × (Fin Lmax → ι)) : Finset V :=
  traceOf nbE v (fun i => if h : i < Lmax then p.2 ⟨i, h⟩ else (Classical.arbitrary ι)) (p.1 : ℕ)

/-- **Every connected set of size `n` containing `v` is decoded from a string of
`2(n−1)` neighbour choices together with a length.** -/
theorem animal_mem_range_decode [DecidableEq V] [Nonempty ι] {nb : V → Finset V} {nbE : V → ι → V}
    {v : V} {S : Finset V} {n : ℕ} 
    (hnbE : ∀ x y, y ∈ nb x → ∃ i, nbE x i = y)
    (hsym : ∀ x y, y ∈ nb x → x ∈ nb y)
    (hconn : IsAnimal nb v S) (hcard : S.card = n) :
    S ∈ Set.range (decodeTrace nbE v (2 * (n - 1))) := by
  obtain ⟨L, c, hcw⟩ := exists_coverWalk hnbE hsym hconn
  set Lmax := 2 * (n - 1) with hLmax
  have hLle : L ≤ Lmax := by
    have hl := hcw.len
    rw [hcard] at hl
    rw [hLmax]
    exact hl
  refine ⟨(⟨L, by omega⟩, fun i => c (i : ℕ)), ?_⟩
  have hagree : ∀ i, i < Lmax →
      (fun i => if h : i < Lmax then (fun j : Fin Lmax => c (j : ℕ)) ⟨i, h⟩ else ((Classical.arbitrary ι) : ι)) i
        = c i := by
    intro i hi
    simp [hi]
  have hwalk : ∀ j ≤ Lmax,
      walkOf nbE v (fun i => if h : i < Lmax then (fun j : Fin Lmax => c (j : ℕ)) ⟨i, h⟩
        else ((Classical.arbitrary ι) : ι)) j = walkOf nbE v c j :=
    walkOf_congr hagree
  have htr : traceOf nbE v (fun i => if h : i < Lmax then (fun j : Fin Lmax => c (j : ℕ)) ⟨i, h⟩
      else ((Classical.arbitrary ι) : ι)) L = traceOf nbE v c L := by
    rw [traceOf, traceOf]
    refine Finset.image_congr ?_
    intro i hi
    rw [Finset.mem_coe, Finset.mem_range] at hi
    exact hwalk i (by omega)
  have hfinal : traceOf nbE v (fun i => if h : i < Lmax then (fun j : Fin Lmax => c (j : ℕ)) ⟨i, h⟩
      else ((Classical.arbitrary ι) : ι)) L = S := by
    rw [htr]
    exact traceOf_eq_of_coverWalk hcw
  simp only [decodeTrace]
  exact hfinal

/-- **The lattice-animal counting bound.**  In a graph whose neighbourhoods are
enumerated by `d` indices, the connected sets of size `n` containing a fixed
vertex number at most `(2(n−1)+1)·d^{2(n−1)}`: exponentially many. -/
theorem animals_ncard_le [DecidableEq V] [Fintype ι] [Nonempty ι] {nb : V → Finset V} {nbE : V → ι → V}
    {v : V} 
    (hnbE : ∀ x y, y ∈ nb x → ∃ i, nbE x i = y)
    (hsym : ∀ x y, y ∈ nb x → x ∈ nb y) (n : ℕ) :
    {S : Finset V | IsAnimal nb v S ∧ S.card = n}.ncard
      ≤ (2 * (n - 1) + 1) * Fintype.card ι ^ (2 * (n - 1)) := by
  classical
  set Lmax := 2 * (n - 1) with hLmax
  have hsub : {S : Finset V | IsAnimal nb v S ∧ S.card = n}
      ⊆ Set.range (decodeTrace nbE v Lmax) := by
    intro S hS
    exact animal_mem_range_decode hnbE hsym hS.1 hS.2
  have hfin : (Set.range (decodeTrace nbE v Lmax)).Finite := Set.finite_range _
  have h1 : {S : Finset V | IsAnimal nb v S ∧ S.card = n}.ncard
      ≤ (Set.range (decodeTrace nbE v Lmax)).ncard := Set.ncard_le_ncard hsub hfin
  have h2 : (Set.range (decodeTrace nbE v Lmax)).ncard
      ≤ Nat.card (Fin (Lmax + 1) × (Fin Lmax → ι)) := by
    rw [← Set.image_univ]
    calc ((decodeTrace nbE v Lmax) '' Set.univ).ncard
        ≤ (Set.univ : Set (Fin (Lmax + 1) × (Fin Lmax → ι))).ncard :=
          Set.ncard_image_le Set.finite_univ
      _ = Nat.card (Fin (Lmax + 1) × (Fin Lmax → ι)) := Set.ncard_univ _
  have h3 : Nat.card (Fin (Lmax + 1) × (Fin Lmax → ι)) = (Lmax + 1) * Fintype.card ι ^ Lmax := by
    simp [Nat.card_eq_fintype_card]
  omega

/-! ## 6. Finiteness, and the exponential form Row B consumes -/

theorem animals_finite [DecidableEq V] [Fintype ι] [Nonempty ι] {nb : V → Finset V}
    {nbE : V → ι → V} {v : V}
    (hnbE : ∀ x y, y ∈ nb x → ∃ i, nbE x i = y)
    (hsym : ∀ x y, y ∈ nb x → x ∈ nb y) (n : ℕ) :
    {S : Finset V | IsAnimal nb v S ∧ S.card = n}.Finite := by
  refine Set.Finite.subset (Set.finite_range (decodeTrace nbE v (2 * (n - 1)))) ?_
  intro S hS
  exact animal_mem_range_decode hnbE hsym hS.1 hS.2

/-- **The polymer entropy bound.**  The connected sets of size `n` containing a
fixed vertex are at most `2·e^{νn}` many, with `ν = 1 + 2 log d`, `d` the number
of neighbour directions.  This is exactly the shape of the entropy hypothesis of
`RowBShellEnergy.shell_energy_geometric`. -/
theorem animals_entropy [DecidableEq V] [Fintype ι] [Nonempty ι] {nb : V → Finset V}
    {nbE : V → ι → V} {v : V}
    (hnbE : ∀ x y, y ∈ nb x → ∃ i, nbE x i = y)
    (hsym : ∀ x y, y ∈ nb x → x ∈ nb y) (n : ℕ) :
    ({S : Finset V | IsAnimal nb v S ∧ S.card = n}.ncard : ℝ)
      ≤ 2 * Real.exp ((1 + 2 * Real.log (Fintype.card ι)) * n) := by
  set D : ℕ := Fintype.card ι with hD
  have hD1 : 1 ≤ D := Fintype.card_pos
  have hDR : (1 : ℝ) ≤ (D : ℝ) := by exact_mod_cast hD1
  have hDpos : (0 : ℝ) < (D : ℝ) := by linarith
  have hcount := animals_ncard_le (nb := nb) (nbE := nbE) (v := v) hnbE hsym n
  have hcast : ({S : Finset V | IsAnimal nb v S ∧ S.card = n}.ncard : ℝ)
      ≤ ((2 * (n - 1) + 1 : ℕ) : ℝ) * ((D : ℝ) ^ (2 * (n - 1))) := by
    have := (Nat.cast_le (α := ℝ)).mpr hcount
    simpa using this
  have hlin : ((2 * (n - 1) + 1 : ℕ) : ℝ) ≤ 2 * (n : ℝ) + 1 := by
    have : 2 * (n - 1) + 1 ≤ 2 * n + 1 := by omega
    have h2 := (Nat.cast_le (α := ℝ)).mpr this
    push_cast at h2 ⊢
    linarith
  have hpow : ((D : ℝ) ^ (2 * (n - 1))) ≤ ((D : ℝ) ^ (2 * n)) :=
    pow_le_pow_right₀ hDR (by omega)
  have hpow0 : (0 : ℝ) ≤ (D : ℝ) ^ (2 * (n - 1)) := by positivity
  have hlin0 : (0 : ℝ) ≤ 2 * (n : ℝ) + 1 := by positivity
  have hstep : ({S : Finset V | IsAnimal nb v S ∧ S.card = n}.ncard : ℝ)
      ≤ (2 * (n : ℝ) + 1) * ((D : ℝ) ^ (2 * n)) := by
    calc ({S : Finset V | IsAnimal nb v S ∧ S.card = n}.ncard : ℝ)
        ≤ ((2 * (n - 1) + 1 : ℕ) : ℝ) * ((D : ℝ) ^ (2 * (n - 1))) := hcast
      _ ≤ (2 * (n : ℝ) + 1) * ((D : ℝ) ^ (2 * (n - 1))) :=
          mul_le_mul_of_nonneg_right hlin hpow0
      _ ≤ (2 * (n : ℝ) + 1) * ((D : ℝ) ^ (2 * n)) :=
          mul_le_mul_of_nonneg_left hpow hlin0
  have hexpn : 2 * (n : ℝ) + 1 ≤ 2 * Real.exp (n : ℝ) := by
    have h := Real.add_one_le_exp (n : ℝ)
    linarith
  have hpowexp : ((D : ℝ) ^ (2 * n)) = Real.exp (2 * (n : ℝ) * Real.log D) := by
    have hc : ((2 * n : ℕ) : ℝ) * Real.log D = 2 * (n : ℝ) * Real.log D := by
      push_cast; ring
    rw [← hc, ← Real.log_pow, Real.exp_log (by positivity)]
  have hfinal : 2 * Real.exp ((1 + 2 * Real.log (D : ℝ)) * n)
      = 2 * Real.exp (n : ℝ) * Real.exp (2 * (n : ℝ) * Real.log D) := by
    rw [mul_assoc, ← Real.exp_add]
    congr 2
    ring
  rw [hfinal]
  have hpos : (0 : ℝ) ≤ Real.exp (2 * (n : ℝ) * Real.log D) := (Real.exp_pos _).le
  calc ({S : Finset V | IsAnimal nb v S ∧ S.card = n}.ncard : ℝ)
      ≤ (2 * (n : ℝ) + 1) * ((D : ℝ) ^ (2 * n)) := hstep
    _ = (2 * (n : ℝ) + 1) * Real.exp (2 * (n : ℝ) * Real.log D) := by rw [hpowexp]
    _ ≤ (2 * Real.exp (n : ℝ)) * Real.exp (2 * (n : ℝ) * Real.log D) :=
        mul_le_mul_of_nonneg_right hexpn hpos

/-- The entropy bound in the `Finset`-indexed form used by the shell-energy
theorem: any shell of polymers consisting of connected sets of size `n`
containing `v` has cardinality at most `B e^{νn}`. -/
theorem animal_shell_card_le [DecidableEq V] [Fintype ι] [Nonempty ι] {nb : V → Finset V}
    {nbE : V → ι → V} {v : V}
    (hnbE : ∀ x y, y ∈ nb x → ∃ i, nbE x i = y)
    (hsym : ∀ x y, y ∈ nb x → x ∈ nb y) {shell : ℕ → Finset (Finset V)}
    (hshell : ∀ n, ∀ S ∈ shell n, IsAnimal nb v S ∧ S.card = n) (n : ℕ) :
    ((shell n).card : ℝ) ≤ 2 * Real.exp ((1 + 2 * Real.log (Fintype.card ι)) * n) := by
  have hsub : (↑(shell n) : Set (Finset V)) ⊆ {S : Finset V | IsAnimal nb v S ∧ S.card = n} := by
    intro S hS
    exact hshell n S (Finset.mem_coe.mp hS)
  have hfin := animals_finite (nbE := nbE) (v := v) hnbE hsym n
  have h1 : (↑(shell n) : Set (Finset V)).ncard
      ≤ {S : Finset V | IsAnimal nb v S ∧ S.card = n}.ncard := Set.ncard_le_ncard hsub hfin
  rw [Set.ncard_coe_finset] at h1
  have h2 := animals_entropy (nb := nb) (nbE := nbE) (v := v) hnbE hsym n
  have h3 : ((shell n).card : ℝ)
      ≤ ({S : Finset V | IsAnimal nb v S ∧ S.card = n}.ncard : ℝ) := by exact_mod_cast h1
  linarith

/-! ## 7. Neighbour structures from an involutive step map -/

/-- The neighbourhood generated by a step map. -/
def nbFromE [DecidableEq V] [Fintype ι] (nbE : V → ι → V) (x : V) : Finset V :=
  Finset.image (nbE x) Finset.univ

theorem nbFromE_enumerates [DecidableEq V] [Fintype ι] (nbE : V → ι → V) (x y : V)
    (hy : y ∈ nbFromE nbE x) : ∃ i, nbE x i = y := by
  rw [nbFromE, Finset.mem_image] at hy
  obtain ⟨i, -, hi⟩ := hy
  exact ⟨i, hi⟩

theorem nbFromE_symm [DecidableEq V] [Fintype ι] {nbE : V → ι → V}
    (hinv : ∀ x i, ∃ j, nbE (nbE x i) j = x) (x y : V) (hy : y ∈ nbFromE nbE x) :
    x ∈ nbFromE nbE y := by
  obtain ⟨i, hi⟩ := nbFromE_enumerates nbE x y hy
  obtain ⟨j, hj⟩ := hinv x i
  rw [nbFromE, Finset.mem_image]
  exact ⟨j, Finset.mem_univ _, by rw [hi] at hj; exact hj⟩

/-- **The entropy bound for a graph generated by an involutive step map.** -/
theorem animals_entropy_of_involutive [DecidableEq V] [Fintype ι] [Nonempty ι]
    {nbE : V → ι → V} (v : V) (hinv : ∀ x i, ∃ j, nbE (nbE x i) j = x) (n : ℕ) :
    ({S : Finset V | IsAnimal (nbFromE nbE) v S ∧ S.card = n}.ncard : ℝ)
      ≤ 2 * Real.exp ((1 + 2 * Real.log (Fintype.card ι)) * n) :=
  animals_entropy (nb := nbFromE nbE) (nbE := nbE) (nbFromE_enumerates nbE)
    (nbFromE_symm hinv) n

/-! ## 8. The four-dimensional lattice -/

/-- The `2·4 = 8` nearest-neighbour directions of `ℤ⁴`. -/
abbrev LatticeDir : Type := Fin 4 × Bool

/-- The nearest-neighbour step of `ℤ⁴`. -/
def latticeStep (x : Fin 4 → ℤ) (i : LatticeDir) : Fin 4 → ℤ :=
  Function.update x i.1 (x i.1 + if i.2 then 1 else -1)

theorem latticeStep_involutive (x : Fin 4 → ℤ) (i : LatticeDir) :
    ∃ j, latticeStep (latticeStep x i) j = x := by
  refine ⟨(i.1, !i.2), ?_⟩
  rw [latticeStep, latticeStep]
  simp only [Function.update_self]
  rw [Function.update_idem]
  rcases i with ⟨k, b⟩
  cases b <;> simp [Function.update_eq_self]

theorem card_latticeDir : Fintype.card LatticeDir = 8 := by simp

/-- **The polymer entropy bound on the four-dimensional lattice.**  The connected
subsets of `ℤ⁴` of size `n` containing a fixed site number at most
`2 e^{(1 + 2 log 8) n}`.  This supplies, unconditionally, the entropy half of the
Row-B decay/entropy competition: it fixes `B = 2` and `ν = 1 + 2 log 8`. -/
theorem lattice4_animals_entropy (v : Fin 4 → ℤ) (n : ℕ) :
    ({S : Finset (Fin 4 → ℤ) | IsAnimal (nbFromE latticeStep) v S ∧ S.card = n}.ncard : ℝ)
      ≤ 2 * Real.exp ((1 + 2 * Real.log 8) * n) := by
  have h := animals_entropy_of_involutive (nbE := latticeStep) v latticeStep_involutive n
  rwa [card_latticeDir] at h
  

end YangMills
