import RequestProject.Wikidata.Alignment
import RequestProject.Wikidata.Diagnostics
import RequestProject.Epistemic.Trit

/-!
# Importing Wikidata checker results as evidence

This is the bridge layer: ontology claims about a knowledge base are imported as
provenance-bearing evidence with a three-valued state.

Two things make the Lean version stronger than a purely descriptive bridge:

* every claim comes with an **exact** executable checker (`ClassClaim.check_iff`),
  so `supported` evidence provably entails the claim it reports
  (`holds_of_supported`) — support is never a mere label;
* because the checkers are exact, a checker *failure* is a certified negative
  about the given knowledge base (`not_holds_of_refuted`), which is genuinely
  different from having no observation at all.  Only the former is allowed to
  contradict; see `RequestProject.Epistemic.Trit.verdictState`.

Claims are always relative to a knowledge base.  `¬ Holds kb` says the claim is
not supported by `kb`, never that the world refutes it: knowledge bases grow, and
`Wikidata.Examples.absence_is_not_world_refutation` exhibits a claim that fails
in one knowledge base and holds in a larger one.
-/

/-! ### Provenance (generated by `tools/provenance.py`)

Source mix of this module's 28 declarations: 3 traced to the DASHI Agda
bridge (`chboishabba/dashi_agda` PR #555 / #581 / #582), 0 rendering the Wikidata
data model, 25 original to this port.  The bridge-traced declarations are
marked with `-- @source` below.  Full ledger: `docs/status/PROVENANCE.md`.
-/

namespace Epistemic

open Wikidata

/-- The ontology surface an imported claim belongs to. -/
inductive SurfaceKind
  | classFact
  | statementFact
  | constraintFact
  | provenanceFact
  | identityFact
  | rdfFact
  | diagnosticFact
  | repairFact
  deriving DecidableEq, Repr, Inhabited

/-- The claims the bridge can import, each backed by an exact checker. -/
inductive ClassClaim
  | subclass (a b : Qid)
  | instanceOf (x c : Qid)
  | unionOf (c : Qid) (ms : List Qid)
  | intersectionOf (c : Qid) (ms : List Qid)
  | disjointUnionOf (c : Qid) (ms : List Qid)
  | disjointWith (c d : Qid)
  | validKB
  deriving DecidableEq, Repr, Inhabited

namespace ClassClaim

/-- What a claim means, relative to a knowledge base. -/
def Holds (kb : KB) : ClassClaim → Prop
  | subclass a b => SubclassOf kb a b
  | instanceOf x c => InstanceOf kb x c
  | unionOf c ms => IsUnionOn kb c ms
  | intersectionOf c ms => IsIntersectionOn kb c ms
  | disjointUnionOf c ms => IsDisjointUnionOn kb c ms
  | disjointWith c d => DisjointOn kb c d
  | validKB => Valid kb

/-- The executable checker for a claim. -/
def check (kb : KB) : ClassClaim → Bool
  | subclass a b => isSubclassOf kb a b
  | instanceOf x c => isInstanceOf kb x c
  | unionOf c ms => unionOk kb c ms
  | intersectionOf c ms => interOk kb c ms
  | disjointUnionOf c ms => dunOk kb c ms
  | disjointWith c d => disjointOk kb c d
  | validKB => valid kb

/-- **Checker exactness.**  Every imported claim is decided by its checker. -/
theorem check_iff (kb : KB) (cl : ClassClaim) : cl.check kb = true ↔ cl.Holds kb := by
  cases cl with
  | subclass a b => exact isSubclassOf_iff kb a b
  | instanceOf x c => exact isInstanceOf_iff kb x c
  | unionOf c ms => exact unionOk_iff kb c ms
  | intersectionOf c ms => exact interOk_iff kb c ms
  | disjointUnionOf c ms => exact dunOk_iff kb c ms
  | disjointWith c d => exact disjointOk_iff kb c d
  | validKB => exact valid_iff kb

theorem not_holds_of_check_false {kb : KB} {cl : ClassClaim} (h : cl.check kb = false) :
    ¬ cl.Holds kb := by
  intro hc
  rw [(check_iff kb cl).2 hc] at h
  exact absurd h (by simp)

end ClassClaim

/-! ## Certificates -/

-- @source DASHI Agda bridge (PR #555/#581/#582): invariant 3: Accepted results become scoped supporting evidence only
/-- An imported result: a claim about a knowledge base, tagged with whether the
pinned source snapshot matched, and carrying its source references. -/
structure Certificate where
  kb : KB
  claim : ClassClaim
  surface : SurfaceKind
  sourceMatched : Bool
  references : List String

namespace Certificate

/-- Did the checker accept? -/
def accepted (cert : Certificate) : Bool := cert.claim.check cert.kb

/-- Fail-closed evidence state of the certificate. -/
def state (cert : Certificate) : Trit := receiptState cert.sourceMatched cert.accepted

theorem state_eq_supported_iff (cert : Certificate) :
    cert.state = Trit.supported ↔ cert.sourceMatched = true ∧ cert.claim.Holds cert.kb := by
  rw [state, receiptState_eq_supported_iff]
  exact and_congr_right fun _ => ClassClaim.check_iff cert.kb cert.claim

-- @source DASHI Agda bridge (PR #555/#581/#582): invariant 3: Accepted results become scoped supporting evidence only
/-- **Supported evidence is really backed**: a supported certificate entails the
claim it reports. -/
theorem holds_of_supported {cert : Certificate} (h : cert.state = Trit.supported) :
    cert.claim.Holds cert.kb :=
  ((state_eq_supported_iff cert).1 h).2

/-- A checker failure is unresolved, not a refutation. -/
theorem state_of_checker_failure {cert : Certificate} (h : cert.accepted = false) :
    cert.state = Trit.unresolved := by
  rw [state, h, receiptState_of_checker_failure]

/-- A source mismatch is unresolved, whatever the checker says. -/
theorem state_of_source_mismatch {cert : Certificate} (h : cert.sourceMatched = false) :
    cert.state = Trit.unresolved := by
  rw [state, h, receiptState_of_source_mismatch]

/-- **Fail-closed**: importing a certificate never produces a refutation. -/
theorem state_ne_contradicted (cert : Certificate) : cert.state ≠ Trit.contradicted :=
  receiptState_ne_contradicted _ _

/-- The scoped, provenance-bearing claim generated by a certificate. -/
def scopedClaim (cert : Certificate) : ScopedClaim SurfaceKind :=
  scopedOfReceipt cert.sourceMatched cert.accepted cert.references

@[simp] theorem scopedClaim_references (cert : Certificate) :
    cert.scopedClaim.references = cert.references := rfl

@[simp] theorem scopedClaim_stateAt (cert : Certificate) (k : SurfaceKind) :
    cert.scopedClaim.stateAt k = cert.state := rfl

/-! ### The certified-negative lane -/

/-- Because the checkers are exact, a certificate carries a *verdict*: the claim
is certified to hold, or certified not to hold of this knowledge base. -/
def verdict (cert : Certificate) : ObjectVerdict :=
  if cert.accepted then ObjectVerdict.certifiedHolds else ObjectVerdict.certifiedRefuted

/-- The evidence state of the reported proposition under its verdict. -/
def verdictEvidence (cert : Certificate) : Trit :=
  verdictState cert.sourceMatched true cert.verdict

theorem verdictEvidence_eq_supported_iff (cert : Certificate) :
    cert.verdictEvidence = Trit.supported ↔ cert.sourceMatched = true ∧ cert.claim.Holds cert.kb := by
  unfold verdictEvidence verdict
  by_cases hacc : cert.accepted = true
  · rw [if_pos hacc, ← ClassClaim.check_iff cert.kb cert.claim]
    cases hm : cert.sourceMatched
    · simp [verdictState]
    · refine ⟨fun _ => ⟨rfl, hacc⟩, fun _ => ?_⟩
      simp [verdictState]
  · simp only [Bool.not_eq_true] at hacc
    have hnot : ¬ cert.claim.Holds cert.kb := ClassClaim.not_holds_of_check_false hacc
    rw [if_neg (by simp [hacc])]
    constructor
    · intro h
      simp only [verdictState] at h
      split at h <;> simp at h
    · rintro ⟨_, hc⟩
      exact absurd hc hnot

/-- A certified negative refutes the claim *for this knowledge base*. -/
theorem not_holds_of_refuted {cert : Certificate}
    (h : cert.verdictEvidence = Trit.contradicted) : ¬ cert.claim.Holds cert.kb := by
  have := (verdictState_eq_contradicted_iff cert.sourceMatched true cert.verdict).1 h
  have hv : cert.verdict = ObjectVerdict.certifiedRefuted := this.2.2
  unfold verdict at hv
  by_cases hacc : cert.accepted = true
  · rw [if_pos hacc] at hv
    exact absurd hv (by simp)
  · simp only [Bool.not_eq_true] at hacc
    exact ClassClaim.not_holds_of_check_false hacc

/-- Without a matched source there is never a refutation, only ignorance. -/
theorem verdictEvidence_of_source_mismatch {cert : Certificate} (h : cert.sourceMatched = false) :
    cert.verdictEvidence = Trit.unresolved := by
  rw [verdictEvidence, h, verdictState_of_source_mismatch]

end Certificate

/-! ## Cross-source comparison -/

/-- Compare an imported certificate with an external source's evidence. -/
def compareWithExternal (cert : Certificate) (external : Trit) : Disposition :=
  compareStates cert.state external

/-- A source mismatch can never manufacture a cross-ontology conflict. -/
theorem no_conflict_of_source_mismatch (cert : Certificate) (external : Trit)
    (h : cert.sourceMatched = false) :
    compareWithExternal cert external ≠ Disposition.conflicting := by
  rw [compareWithExternal, Certificate.state_of_source_mismatch h]
  exact unresolved_left_never_conflicts external

/-- A failed checker can never manufacture a cross-ontology conflict. -/
theorem no_conflict_of_checker_failure (cert : Certificate) (external : Trit)
    (h : cert.accepted = false) :
    compareWithExternal cert external ≠ Disposition.conflicting := by
  rw [compareWithExternal, Certificate.state_of_checker_failure h]
  exact unresolved_left_never_conflicts external

/-! ## Authority non-promotion -/

/-- Importing evidence about a knowledge base never changes the knowledge base. -/
def importEvidence (kb : KB) (_cert : Certificate) : KB := kb

-- @source DASHI Agda bridge (PR #555/#581/#582): authority non-promotion (truth / edit)
@[simp] theorem importEvidence_eq (kb : KB) (cert : Certificate) :
    importEvidence kb cert = kb := rfl

/-- Imported evidence carries no truth authority: it cannot refute a claim on its
own (only an exact certified negative can, and that is a statement about the
knowledge base, not about the world). -/
theorem import_carries_no_refutation (cert : Certificate) : cert.state ≠ Trit.contradicted :=
  Certificate.state_ne_contradicted cert

end Epistemic
