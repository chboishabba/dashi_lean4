open Lean Elab Command

namespace AgdaFront

/-! ## Term-level Agda syntax -/

/-- Agda's anonymous record value, `record { a = x ; b = y }`. -/
syntax agdaRecordField := ident " = " term

/-- Agda's anonymous record value, `record { a = x ; b = y }`. -/
syntax "record " "{" sepBy(agdaRecordField, "; ") "}" : term

macro_rules
  | `(record { $[$fs];* }) => do
      let fields ← fs.mapM fun f => match f with
        | `(agdaRecordField| $n:ident = $v:term) =>
            `(Lean.Parser.Term.structInstField| $n:ident := $v)
        | _ => Macro.throwUnsupported
      let fields' := Syntax.TSepArray.ofElems (sep := ",") fields
      `(Lean.Parser.Term.structInst| { $fields',* })

/-! ## Declaration-level Agda syntax -/

declare_syntax_cat agdaDecl

/-- A constructor line inside a `data` block. -/
syntax agdaCtorDecl := many1(ppSpace ident) " : " term

/-- A field line inside a `field` block. -/
syntax agdaFieldDecl := many1(ppSpace ident) " : " term

/-- Agda's `data`. -/
syntax (name := agdaData)
  "data " ident (ppSpace bracketedBinder)* " : " term " where "
    manyIndent(agdaCtorDecl) : agdaDecl

/-- Agda's `record`. -/
syntax (name := agdaRecord)
  "record " ident (ppSpace bracketedBinder)* " : " term " where "
    (ppLine "constructor " ident)? (ppLine "field" manyIndent(agdaFieldDecl))? : agdaDecl

/-- Agda's `open import M using (a; b; c)`. -/
syntax (name := agdaOpenImport)
  "open " "import " ident (" using " "(" sepBy(ident, "; ") ")")? : agdaDecl

/-- Agda's `import M as N` (the alias must already have been expanded by the
translator, so this only brings `M` into scope). -/
syntax (name := agdaImportAs) "import " ident " as " ident : agdaDecl

/-- Agda's `open R public`. -/
syntax (name := agdaOpenPublic) "open " ident (" public")? : agdaDecl

/-- A top-level type signature. -/
syntax (name := agdaSig) ident " : " term : agdaDecl

/-- A defining clause, possibly absurd (no right-hand side). -/
syntax (name := agdaClause) ident (ppSpace term:max)* (" = " term)? : agdaDecl

/-- An Agda module: a name and a layout block of declarations. -/
syntax (name := agdaModule) "agda_module " ident " where " manyIndent(agdaDecl) : command

/-! ## Elaboration -/

/-- Is this pattern Agda's absurd pattern `()`? -/
private def isAbsurdPattern (p : Term) : Bool :=
  match p.raw.reprint with
  | some s => s.trimAscii.toString == "()"
  | none => false

/-- Is this pattern an Agda *implicit-argument* pattern?

Agda writes a pattern for an implicit argument in braces, either positionally,
`f {n} x = …`, or by the name the signature gives the argument,
`f {n = zero} x = …`.  Lean has no such pattern, and reads `{n = zero}` as a
singleton collection instead, so the two forms are recognised here and turned
into discriminants of the generated `match`.  The result is the name, when the
form is the named one, together with the pattern itself. -/
private partial def implicitPattern? (p : Term) : Option (Option Name × Term) :=
  go p.raw
where
  go (s : Syntax) : Option (Option Name × Term) :=
    if s.getKind == choiceKind then s.getArgs.findSome? go
    else if s.getKind == `«term{_}» then
      let elems := (s.getArg 1).getSepArgs
      if h : elems.size = 1 then
        let e := elems[0]
        if e.getKind == `«term_=_» then
          match (e.getArg 0).isIdent, (e.getArg 0).getId with
          | true, nm => some (some nm, ⟨e.getArg 2⟩)
          | _, _ => none
        else some (none, ⟨e⟩)
      else none
    else none

/-- The names of the implicit arguments a signature binds before its first
explicit one, which is what a named implicit pattern refers to. -/
private def leadingImplicitNames (ty : Term) : Array Name := Id.run do
  let s := ty.raw
  unless s.getKind == ``Lean.Parser.Term.forall do return #[]
  let mut out := #[]
  for b in (s.getArg 1).getArgs do
    if b.getKind == ``Lean.Parser.Term.implicitBinder then
      for x in (b.getArg 1).getArgs do
        if x.isIdent then out := out.push x.getId
    else
      return out
  return out

/-- The name the generated definition gives the `i`-th implicit argument it
binds explicitly. -/
private def implicitArgName (i : Nat) : Ident := mkIdent (Name.mkSimple s!"agdaImp✝{i}")

/-- `{a₀} … {aₘ₋₁}`, the binders for the implicit arguments matched on. -/
private def implicitBinders (m : Nat) :
    CommandElabM (Array (TSyntax ``Lean.Parser.Term.funBinder)) :=
  (Array.range m).mapM fun i => do
    let x := implicitArgName i
    `(Lean.Parser.Term.funBinder| { $x:ident })

/-- The discriminants for the implicit arguments matched on. -/
private def implicitDiscrs (m : Nat) :
    CommandElabM (Array (TSyntax ``Lean.Parser.Term.matchDiscr)) :=
  (Array.range m).mapM fun i => do
    let x := implicitArgName i
    `(Lean.Parser.Term.matchDiscr| $x:term)

/-- Turn the clauses collected for one signature into a Lean definition.

An Agda definition is a signature followed by clauses; a nullary definition has
exactly one clause and becomes `def f : T := e`, and a definition with patterns
becomes `def f : T | pats => e`.  A clause with no right-hand side must contain
an absurd pattern, and becomes a `nomatch`.  Patterns on implicit arguments are
supported: the generated definition binds those arguments explicitly and matches
on them alongside the explicit ones. -/
private def emitAgdaDef (n : Ident) (ty : Term) (cls : Array (TSyntax `agdaDecl)) :
    CommandElabM Unit := do
  if cls.isEmpty then
    throwErrorAt n
      s!"agda: `{n.getId}` has a signature but no clauses; postulates are not supported"
  let impNames := leadingImplicitNames ty
  -- split each clause into (slot, pattern) pairs on the implicit arguments and
  -- the remaining patterns on the explicit ones
  let mut split : Array (Array (Nat × Term) × Array Term × TSyntax `agdaDecl) := #[]
  let mut impCount := 0
  for c in cls do
    match c with
    | `(agdaDecl| $_cn:ident $ps* $[= $_rhs?]?) =>
        let mut imps : Array (Nat × Term) := #[]
        let mut exps : Array Term := #[]
        let mut positional := 0
        for p in ps do
          match implicitPattern? p with
          | some (nm?, pat) =>
              unless exps.isEmpty do
                throwErrorAt c s!"agda: `{n.getId}` has an implicit-argument pattern after an \
explicit one"
              let slot ← match nm? with
                | none => pure positional
                | some nm =>
                    match impNames.findIdx? (· == nm) with
                    | some i => pure i
                    | none =>
                        throwErrorAt c s!"agda: `{n.getId}` has a pattern for an implicit \
argument `{nm}`, which its signature does not bind"
              positional := positional + 1
              impCount := max impCount (slot + 1)
              imps := imps.push (slot, pat)
          | none => exps := exps.push p
        split := split.push (imps, exps, c)
    | _ => throwErrorAt c "agda: malformed clause"
  let hole : Term ← `(_)
  let mut alts : Array (TSyntax ``Lean.Parser.Term.matchAlt) := #[]
  let mut arity : Option Nat := none
  for (imps, exps, c) in split do
    if let some a := arity then
      unless a == exps.size do
        throwErrorAt c s!"agda: clauses of `{n.getId}` have different numbers of patterns"
    arity := some exps.size
    if exps.size == 0 && impCount == 0 then
      continue
    let mut impPats : Array Term := (Array.range impCount).map fun _ => hole
    for (slot, pat) in imps do
      impPats := impPats.set! slot pat
    let ps := impPats ++ exps
    match c with
    | `(agdaDecl| $_cn:ident $_ps* = $rhs) =>
        alts := alts.push (← `(Lean.Parser.Term.matchAltExpr| | $ps,* => $rhs))
    | _ =>
        -- absurd clause: replace `()` patterns by fresh variables and refute
        let mut fresh : Option Ident := none
        let mut ps' : Array Term := #[]
        for p in ps do
          if isAbsurdPattern p && fresh.isNone then
            let x := mkIdent (← Lean.Elab.Term.mkFreshBinderName)
            fresh := some x
            ps' := ps'.push x
          else
            ps' := ps'.push p
        match fresh with
        | none => throwErrorAt c "agda: clause without a right-hand side is not absurd"
        | some x =>
            alts := alts.push (← `(Lean.Parser.Term.matchAltExpr| | $ps',* => nomatch $x))
  match arity with
  | some 0 =>
      if impCount == 0 then
        if cls.size ≠ 1 then
          throwErrorAt n s!"agda: `{n.getId}` takes no arguments but has several clauses"
        match cls[0]! with
        | `(agdaDecl| $_cn:ident $_ps* = $rhs) => elabCommand (← `(def $n : $ty := $rhs))
        | _ => throwErrorAt n "agda: malformed nullary clause"
      else
        elabCommand (← `(def $n : $ty := fun $(← implicitBinders impCount)* =>
          match $[$(← implicitDiscrs impCount)],* with $alts:matchAlt*))
  | some k =>
      -- `fun x₁ … x_k => match x₁, …, x_k with | …`, rather than clauses attached
      -- directly to the signature: this way Lean inserts the implicit arguments
      -- of the signature itself, so a universe-polymorphic Agda signature such as
      -- `∀ {A : Set a} → List A → Nat` still takes its patterns on the explicit
      -- arguments only.
      let xs : Array Ident := (Array.range k).map fun i =>
        mkIdent (Name.mkSimple s!"agdaArg✝{i}")
      let bs : Array (TSyntax ``Lean.Parser.Term.funBinder) :=
        (← implicitBinders impCount) ++ xs.map (⟨·.raw⟩)
      let ds : Array (TSyntax ``Lean.Parser.Term.matchDiscr) ←
        xs.mapM fun x => `(Lean.Parser.Term.matchDiscr| $x:term)
      let ds := (← implicitDiscrs impCount) ++ ds
      elabCommand (← `(def $n : $ty := fun $bs* => match $[$ds],* with $alts:matchAlt*))
  | none => throwErrorAt n "agda: malformed definition"

/-- Agda modules that the prelude already provides; `open import` of one of
these is a no-op, and `open import` of anything else opens the corresponding
Lean namespace (which is how a transliterated DASHI module refers to another). -/
private def preludeRoots : List Name :=
  [`Agda, `Data, `Relation, `Function, `Level, `Codata, `Algebra, `Induction, `Size]

/-- Is this an Agda standard-library module, whose content the prelude already
supplies? -/
private def isPreludeModule (m : Name) : Bool :=
  match m.components with
  | root :: _ => preludeRoots.contains root
  | [] => false

/-- Agda's `open R public` re-exports the names of `R`.  For a record we can do
exactly that in Lean — export the fields and the constructor — which, unlike
`open`, survives the end of the enclosing namespace block, so that later blocks
of the same transliterated module still see the names. -/
private def exportOrOpen (x : Ident) : CommandElabM Unit := do
  let env ← getEnv
  let n? ← try
      pure (some (← liftCoreM (Lean.realizeGlobalConstNoOverload x)))
    catch _ => pure none
  match n? with
  | some n =>
      if Lean.isStructure env n then
        let fields := (Lean.getStructureFields env n).map mkIdent
        let ctor := mkIdent (Lean.getStructureCtor env n).name.componentsRev.head!
        elabCommand (← `(export $(mkIdent n) ($fields* $ctor)))
      else
        elabCommand (← `(open $x:ident))
  | none => elabCommand (← `(open $x:ident))

@[command_elab agdaModule]
def elabAgdaModule : CommandElab := fun stx => do
  match stx with
  | `(command| agda_module $mn:ident where $[$decls]*) => do
      elabCommand (← `(namespace $mn))
      let mut pending : Option (Ident × Term) := none
      let mut clauses : Array (TSyntax `agdaDecl) := #[]
      let mut i := 0
      while h : i < decls.size do
        let d := decls[i]
        i := i + 1
        -- a clause continues the pending signature; anything else closes it
        match d with
        | `(agdaDecl| $cn:ident $ps* $[= $_rhs]?) =>
            if !ps.isEmpty || d.raw.isOfKind ``agdaClause then
              match pending with
              | some (n, _) =>
                  unless n.getId == cn.getId do
                    throwErrorAt cn
                      s!"agda: clause for `{cn.getId}` does not match signature `{n.getId}`"
                  clauses := clauses.push d
                  continue
              | none => throwErrorAt cn s!"agda: clause for `{cn.getId}` has no signature"
        | _ => pure ()
        if let some (n, ty) := pending then
          emitAgdaDef n ty clauses
          pending := none
          clauses := #[]
        match d with
        | `(agdaDecl| $n:ident : $ty:term) =>
            pending := some (n, ty)
        | `(agdaDecl| open import $m:ident $[using ($[$_ns];*)]?) =>
            unless isPreludeModule m.getId do
              elabCommand (← `(open $m:ident))
        | `(agdaDecl| import $m:ident as $_a:ident) =>
            unless isPreludeModule m.getId do
              elabCommand (← `(open $m:ident))
        | `(agdaDecl| open $x:ident $[public%$_p]?) =>
            exportOrOpen x
        | `(agdaDecl| data $n:ident $bs* : $ty where $[$cs]*) =>
            let mut ctors : Array (TSyntax ``Lean.Parser.Command.ctor) := #[]
            let mut ctorNames : Array Ident := #[]
            for c in cs do
              match c with
              | `(agdaCtorDecl| $cns* : $ct:term) =>
                  for cn in cns do
                    ctors := ctors.push (← `(Lean.Parser.Command.ctor| | $cn:ident : $ct))
                    ctorNames := ctorNames.push cn
              | _ => throwErrorAt c "agda: malformed constructor"
            elabCommand (← `(inductive $n $bs* : $ty where $ctors*))
            elabCommand (← `(export $n:ident ($ctorNames*)))
        | `(agdaDecl| record $n:ident $bs* : $ty where
              $[constructor $c:ident]? $[field $[$fs]*]?) =>
            let fields := fs.getD #[]
            let mut sfs : Array (TSyntax ``Lean.Parser.Command.structSimpleBinder) := #[]
            for f in fields do
              match f with
              | `(agdaFieldDecl| $fns* : $ft:term) =>
                  for fn in fns do
                    sfs := sfs.push (← `(Lean.Parser.Command.structSimpleBinder| $fn:ident : $ft))
              | _ => throwErrorAt f "agda: malformed field"
            match c with
            | some cn =>
                elabCommand (← `(structure $n $bs* : $ty where $cn:ident :: $[$sfs]*))
                elabCommand (← `(export $n:ident ($cn:ident)))
            | none =>
                elabCommand (← `(structure $n $bs* : $ty where $[$sfs]*))
        | _ => throwErrorAt d "agda: unsupported declaration"
      if let some (n, ty) := pending then
        emitAgdaDef n ty clauses
      elabCommand (← `(end $mn))
  | _ => throwError "agda: malformed module"

end AgdaFront
