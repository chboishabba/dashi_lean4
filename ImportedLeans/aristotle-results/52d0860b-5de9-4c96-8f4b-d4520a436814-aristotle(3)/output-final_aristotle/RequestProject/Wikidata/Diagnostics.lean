import RequestProject.Wikidata.Redundancy

/-!
# Diagnostics

An error list and an independently defined validity predicate for a knowledge
base, with the exactness theorem `errors_eq_nil_iff_valid` (the diagnostic
report is empty exactly when the knowledge base is valid) and a semantic
characterisation `valid_iff`.

Validity here means: no statement refers to an unknown entity, and the truthy
`P279` graph has no cycle through a known entity.
-/

/-! ### Provenance (generated by `tools/provenance.py`)

Source mix of this module's 8 declarations: 0 traced to the DASHI Agda
bridge (`chboishabba/dashi_agda` PR #555 / #581 / #582), 8 rendering the Wikidata
data model, 0 original to this port.  The bridge-traced declarations are
marked with `-- @source` below.  Full ledger: `docs/status/PROVENANCE.md`.
-/

namespace Wikidata

/-- A diagnostic finding. -/
inductive KBError
  | danglingSubject (st : Statement)
  | danglingValue (st : Statement)
  | subclassCycle (a : Qid)
  deriving DecidableEq, Repr

/-- Is `a` on a `P279` cycle: does some direct superclass of `a` have `a` as a
superclass? -/
def onSubclassCycle (kb : KB) (a : Qid) : Bool :=
  (superclasses kb a).any (fun b => isSubclassOf kb b a)

/-- Executable validity check. -/
def valid (kb : KB) : Bool :=
  kb.statements.all (fun st => (st.subject ∈ kb.entities) && (st.value ∈ kb.entities)) &&
    kb.entities.all (fun a => !onSubclassCycle kb a)

/-- The diagnostic report. -/
def errors (kb : KB) : List KBError :=
  kb.statements.filterMap
      (fun st => if st.subject ∈ kb.entities then none else some (KBError.danglingSubject st)) ++
    kb.statements.filterMap
      (fun st => if st.value ∈ kb.entities then none else some (KBError.danglingValue st)) ++
    kb.entities.filterMap
      (fun a => if onSubclassCycle kb a then some (KBError.subclassCycle a) else none)

/-- **Diagnostics exactness**: the report is empty exactly on valid knowledge
bases. -/
theorem errors_eq_nil_iff_valid (kb : KB) : errors kb = [] ↔ valid kb = true := by
  simp only [errors, valid, List.append_eq_nil_iff, List.filterMap_eq_nil_iff, Bool.and_eq_true,
    List.all_eq_true, Bool.not_eq_true', decide_eq_true_eq]
  constructor
  · rintro ⟨⟨h1, h2⟩, h3⟩
    refine ⟨fun st hst => ?_, fun a ha => ?_⟩
    · have hs := h1 st hst
      have hv := h2 st hst
      by_cases hsubj : st.subject ∈ kb.entities
      · by_cases hval : st.value ∈ kb.entities
        · simp [hsubj, hval]
        · simp [hval] at hv
      · simp [hsubj] at hs
    · have := h3 a ha
      by_cases hc : onSubclassCycle kb a
      · simp [hc] at this
      · simpa using hc
  · rintro ⟨h1, h2⟩
    refine ⟨⟨fun st hst => ?_, fun st hst => ?_⟩, fun a ha => ?_⟩
    · simp [(h1 st hst).1]
    · simp [(h1 st hst).2]
    · simp [h2 a ha]

/-- Declarative validity. -/
def Valid (kb : KB) : Prop :=
  (∀ st ∈ kb.statements, st.subject ∈ kb.entities ∧ st.value ∈ kb.entities) ∧
    (∀ a ∈ kb.entities, ¬ ∃ b, DirectSubclass kb a b ∧ SubclassOf kb b a)

theorem valid_iff (kb : KB) : valid kb = true ↔ Valid kb := by
  simp only [valid, Bool.and_eq_true, List.all_eq_true, Bool.not_eq_true', Valid,
    decide_eq_true_eq, onSubclassCycle, List.any_eq_false]
  constructor
  · rintro ⟨h1, h2⟩
    refine ⟨fun st hst => by simpa using h1 st hst, ?_⟩
    rintro a ha ⟨b, hab, hba⟩
    have := h2 a ha b ((mem_superclasses_iff kb a b).2 hab)
    rw [(isSubclassOf_iff kb b a).2 hba] at this
    exact absurd this (by simp)
  · rintro ⟨h1, h2⟩
    refine ⟨fun st hst => by simpa using h1 st hst, ?_⟩
    intro a ha b hb
    by_contra hcon
    exact h2 a ha ⟨b, (mem_superclasses_iff kb a b).1 hb, (isSubclassOf_iff kb b a).1 hcon⟩

/-- In a valid knowledge base the subclass relation is antisymmetric on known
entities: a proper subclass cycle is impossible. -/
theorem subclassOf_antisymm_of_valid {kb : KB} (hvalid : Valid kb) {a b : Qid}
    (ha : a ∈ kb.entities) (hab : SubclassOf kb a b) (hba : SubclassOf kb b a) : a = b := by
  rcases Relation.ReflTransGen.cases_head hab with h | ⟨c, hac, hcb⟩
  · exact h
  · exact absurd ⟨c, hac, Relation.ReflTransGen.trans hcb hba⟩ (hvalid.2 a ha)

end Wikidata
