          → (p1B : (γ : 𝔸 → B) → ((x : 𝔸) → γ x ≈ κB γ))
          → (p2B : (x : B) → x ≈ κ′B (const x))
          → (γ : 𝔸 → ʃ A) → (x : 𝔸)
          → (ʃ-as-HIT-recursion σB κB κ′B p1B p2B) ⁎ (p1 γ x) ≈ p1B ((ʃ-as-HIT-recursion σB κB κ′B p1B p2B) ∘ γ) x
            
    module _ (P : ʃ A → 𝒰₀) where
