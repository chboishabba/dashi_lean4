    ; basisIsUnit = refl
    ; newBasis = newBasisAt
    ; newBasisIsEmpty = refl
    ; embedding = depthEmbed
    ; embeddingIsCanonical = λ _ _ → refl
    ; projection = depthProject
    ; projectionIsCanonical = λ _ _ → refl
    ; isometryWitness = depthEmbedIsometry
    ; traversalWitness = traversalCompat
