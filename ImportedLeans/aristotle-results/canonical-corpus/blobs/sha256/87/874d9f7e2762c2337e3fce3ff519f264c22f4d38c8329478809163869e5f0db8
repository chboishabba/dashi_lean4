------------------------------------------------------------------------
-- 1.  THE SHARPENED LITERAL ROW A1 CHAIN
------------------------------------------------------------------------

module SharpenedLiteralRowA1
  (Point : Set)
  (integral : (Point → ℚ) → ℚ)
  (integralMono :
     ∀ (f g : Point → ℚ) → (∀ p → f p ≤ g p) → integral f ≤ integral g)
  (integralAdd :
     ∀ (f g : Point → ℚ) →
     integral (λ p → f p + g p) ≡ integral f + integral g)
  (integralScale :
     ∀ (c : ℚ) (f : Point → ℚ) → integral (λ p → c * f p) ≡ c * integral f)
  (cellMeasure : ℚ)
  (integralConstant : ∀ (c : ℚ) → integral (λ _ → c) ≡ cellMeasure * c)
  where

  open Canc.LinearCellIntegral Point integral integralMono
    integralAdd integralScale cellMeasure integralConstant public

  -- The assembled data.  The local radius is cellMeasure * epsilon -- NOT
  -- 15 * cellMeasure * epsilon -- and the history profile is kappa^d for an
  -- arbitrary kappa in [0,1), through its budget B with 1 + kappa B = B.
  sharpenedRowA1Data :
    ∀ (casimir influence κ budget ε : ℚ) →
      0ℚ ≤ influence → 0ℚ ≤ κ → 0ℚ ≤ budget → 1ℚ + κ * budget ≡ budget →
      (shells : Nat → ShellCombinedDensity ε)
      (increment : Nat → Nat → ℚ) →
      (∀ j d → (- (influence * Gen.geometric κ d)) ≤ increment j d) →
      halfWidth ε + influence * budget
        < RowA1.universalBetaCoefficient casimir →
    Gen.SummableHistoryPositiveBetaData
  sharpenedRowA1Data casimir influence κ budget ε
      influenceNonNeg κnn budgetNonNeg fix shells increment
      incrementBound numericalGate =
    Gen.geometricHistoryPositiveBetaData
      casimir (halfWidth ε) influence κ budget
      influenceNonNeg κnn budgetNonNeg fix
      (λ j _ → shellRegularRemainder (shells j))
      increment
      (λ j _ → shellRegularRemainderLower (shells j))
      incrementBound
      numericalGate

  -- The assembled shell beta is LITERALLY the universal coefficient plus the
  -- literal normalized regular remainder of the joint Wilson + reduced
  -- Faddeev-Popov + Haar evaluator plus the summed history increments.
  sharpenedBetaIsLiteral :
    ∀ (casimir influence κ budget ε : ℚ)
      (influenceNonNeg : 0ℚ ≤ influence) (κnn : 0ℚ ≤ κ)
      (budgetNonNeg : 0ℚ ≤ budget) (fix : 1ℚ + κ * budget ≡ budget)
      (shells : Nat → ShellCombinedDensity ε)
      (increment : Nat → Nat → ℚ)
      (incrementBound :
         ∀ j d → (- (influence * Gen.geometric κ d)) ≤ increment j d)
      (numericalGate : halfWidth ε + influence * budget
                         < RowA1.universalBetaCoefficient casimir)
      j n →
    Gen.beta
      (sharpenedRowA1Data casimir influence κ budget ε
        influenceNonNeg κnn budgetNonNeg fix shells increment
        incrementBound numericalGate) j n
    ≡ RowA1.universalBetaCoefficient casimir
        + (shellRegularRemainder (shells j)
            + Gen.incrementSum (increment j) n)
  sharpenedBetaIsLiteral _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ = refl

  -- ...and it is bounded below by b_-(G) > 0, uniformly in j and n.
  sharpenedPositiveBeta :
    ∀ (casimir influence κ budget ε : ℚ)
      (influenceNonNeg : 0ℚ ≤ influence) (κnn : 0ℚ ≤ κ)
      (budgetNonNeg : 0ℚ ≤ budget) (fix : 1ℚ + κ * budget ≡ budget)
      (shells : Nat → ShellCombinedDensity ε)
      (increment : Nat → Nat → ℚ)
      (incrementBound :
         ∀ j d → (- (influence * Gen.geometric κ d)) ≤ increment j d)
      (numericalGate : halfWidth ε + influence * budget
                         < RowA1.universalBetaCoefficient casimir)
      j n →
    (0ℚ < Gen.generalBetaFloor
            (sharpenedRowA1Data casimir influence κ budget ε
              influenceNonNeg κnn budgetNonNeg fix shells increment
              incrementBound numericalGate))
    × (Gen.generalBetaFloor
         (sharpenedRowA1Data casimir influence κ budget ε
           influenceNonNeg κnn budgetNonNeg fix shells increment
           incrementBound numericalGate)
       ≤ RowA1.universalBetaCoefficient casimir
           + (shellRegularRemainder (shells j)
               + Gen.incrementSum (increment j) n))
  sharpenedPositiveBeta casimir influence κ budget ε
      influenceNonNeg κnn budgetNonNeg fix shells increment
      incrementBound numericalGate j n =
    Gen.generalBetaFloorPositive assembled
    , Gen.generalBetaAboveFloor assembled j n
    where
      assembled = sharpenedRowA1Data casimir influence κ budget ε
        influenceNonNeg κnn budgetNonNeg fix shells increment
        incrementBound numericalGate

------------------------------------------------------------------------
-- 2.  THE WELD INTO THE SOURCE-NORMALIZED TRAJECTORY COMPILER
--
-- The consumer of Row A1 is the recurrence
--     inverseCoupling_d = inverseCoupling_{d+1} + beta_{d+1} .
-- A uniform positive shell beta is exactly the input its enclosure record
-- wants; the telescope then gives linear ultraviolet growth of the inverse
-- coupling, i.e. the small-coupling history the CMP119/CMP122 machinery
-- consumes.  The shell beta at trajectory depth d is the shell beta with a
-- preceding history of exactly d scales, so no history length is fixed.
------------------------------------------------------------------------

sharpenedBetaTrajectoryEnclosure :
  ∀ (dataSet : Gen.SummableHistoryPositiveBetaData)
    (trajectory : Flow.SourceNormalizedCouplingTrajectory)
    (betaCeiling : ℚ) →
  (∀ depth → Flow.beta trajectory (suc depth) ≡ Gen.beta dataSet depth depth) →
  (∀ depth → Flow.beta trajectory (suc depth) ≤ betaCeiling) →
  Flow.UniformBetaEnclosure trajectory
sharpenedBetaTrajectoryEnclosure dataSet trajectory betaCeiling matches ceiling =
  record
    { betaLower = Gen.generalBetaFloor dataSet
    ; betaUpper = betaCeiling
    ; betaLowerNonnegative = ℚP.<⇒≤ (Gen.generalBetaFloorPositive dataSet)
    ; betaLowerBelow = λ depth →
        subst (Gen.generalBetaFloor dataSet ≤_) (sym (matches depth))
          (Gen.generalBetaAboveFloor dataSet depth depth)
    ; betaBelowUpper = ceiling
    }

sharpenedLinearInverseCouplingGrowth :
  ∀ (dataSet : Gen.SummableHistoryPositiveBetaData)
    (trajectory : Flow.SourceNormalizedCouplingTrajectory)
    (betaCeiling : ℚ)
    (matches :
       ∀ depth → Flow.beta trajectory (suc depth) ≡ Gen.beta dataSet depth depth)
    (ceiling : ∀ depth → Flow.beta trajectory (suc depth) ≤ betaCeiling) →
  ∀ depth →
  Sums.natAsRational depth * Gen.generalBetaFloor dataSet
      + Flow.inverseCoupling trajectory depth
  ≤ Flow.inverseCoupling trajectory 0
sharpenedLinearInverseCouplingGrowth
    dataSet trajectory betaCeiling matches ceiling depth =
  subst
    (λ target → Sums.natAsRational depth * Gen.generalBetaFloor dataSet
                  + Flow.inverseCoupling trajectory depth ≤ target)
    (sym telescope)
    (subst
      (λ target → Sums.natAsRational depth * Gen.generalBetaFloor dataSet
                    + Flow.inverseCoupling trajectory depth ≤ target)
      (ℚP.+-comm (Flow.betaPartial (Flow.beta trajectory) depth)
                 (Flow.inverseCoupling trajectory depth))
      (ℚP.+-monoˡ-≤ (Flow.inverseCoupling trajectory depth) partialLower))
  where
    enclosure = sharpenedBetaTrajectoryEnclosure
      dataSet trajectory betaCeiling matches ceiling

    partialLower :
      Sums.natAsRational depth * Gen.generalBetaFloor dataSet
      ≤ Flow.betaPartial (Flow.beta trajectory) depth
    partialLower = Flow.betaPartialLower enclosure depth

    telescope :
      Flow.inverseCoupling trajectory 0
      ≡ Flow.inverseCoupling trajectory depth
          + Flow.betaPartial (Flow.beta trajectory) depth
    telescope = Flow.sourceRecurrenceTelescope trajectory depth

------------------------------------------------------------------------
-- 3.  A BUDGET THAT THE EARLIER STATEMENT COULD NOT REACH
--
-- SU(2) (C_A = 2, universal coefficient 11/12) on the normalized cube
-- (cellMeasure 1/16), with
--
--     epsilon = 5      (negative sup norm of the COMBINED joint density),
--     kappa   = 3/4    (one-step contraction factor),
--     K gamma = 1/20 ,  budget B = 4  (since 1 + (3/4)*4 = 4).
--
-- Gate:  (1/16)*5 + (1/20)*4  =  5/16 + 1/5  =  41/80  <  11/12 .
-- Floor: b_- = 11/12 - 5/16 - 1/5 = 97/240 > 0.
--
-- Neither hypothesis is admissible for the earlier statement: it would charge
-- 15 * 5/16 = 75/16 = 4.6875 for the orbit half alone, far above 11/12, and
-- it cannot accept kappa = 3/4 > 1/2 at all.
------------------------------------------------------------------------

sampleEpsilon sampleKappa sampleBudget sampleInfluence : ℚ
sampleEpsilon = + 5 / 1
sampleKappa = + 3 / 4
sampleBudget = + 4 / 1
sampleInfluence = + 1 / 20

sampleLocalRadius : ℚ
sampleLocalRadius = Canc.cubeCellMeasure * sampleEpsilon        -- 5/16

sampleLocalRadiusValue : sampleLocalRadius ≡ + 5 / 16
sampleLocalRadiusValue = refl

sampleBudgetFixedPoint : 1ℚ + sampleKappa * sampleBudget ≡ sampleBudget
sampleBudgetFixedPoint = refl

sampleGate :
  sampleLocalRadius + sampleInfluence * sampleBudget
  < RowA1.universalBetaCoefficient Floor.su2AdjointCasimir
sampleGate =
  toWitness
    {a? = (sampleLocalRadius + sampleInfluence * sampleBudget)
            ℚP.<? RowA1.universalBetaCoefficient Floor.su2AdjointCasimir}
    _

-- The same epsilon is far outside the reach of the per-orbit gate.
sampleFailsPerOrbitGate :
  RowA1.universalBetaCoefficient Floor.su2AdjointCasimir
  < RowA1.fifteen * sampleLocalRadius
sampleFailsPerOrbitGate =
  toWitness
    {a? = RowA1.universalBetaCoefficient Floor.su2AdjointCasimir
            ℚP.<? RowA1.fifteen * sampleLocalRadius}
    _

-- ...and the contraction factor is outside the reach of the 2^-(d+2) profile.
sampleKappaAboveHalf : RowA1.half < sampleKappa
sampleKappaAboveHalf = toWitness {a? = RowA1.half ℚP.<? sampleKappa} _

sampleIncrement : Nat → Nat → ℚ
sampleIncrement _ d = - (sampleInfluence * Gen.geometric sampleKappa d)

sampleLocalRemainder : Nat → Nat → ℚ
sampleLocalRemainder _ _ = - sampleLocalRadius

sampleData : Gen.SummableHistoryPositiveBetaData
sampleData =
  Gen.geometricHistoryPositiveBetaData
    Floor.su2AdjointCasimir sampleLocalRadius sampleInfluence
    sampleKappa sampleBudget
    (toWitness {a? = 0ℚ ℚP.≤? sampleInfluence} _)
    (toWitness {a? = 0ℚ ℚP.≤? sampleKappa} _)
    (toWitness {a? = 0ℚ ℚP.≤? sampleBudget} _)
    sampleBudgetFixedPoint
    sampleLocalRemainder sampleIncrement
    (λ _ _ → ℚP.≤-refl)
    (λ _ _ → ℚP.≤-refl)
    sampleGate

sampleFloorValue : Gen.generalBetaFloor sampleData ≡ + 97 / 240
sampleFloorValue = refl

samplePositiveBeta : ∀ j n → 0ℚ < Gen.beta sampleData j n
samplePositiveBeta = Gen.generalBetaPositive sampleData

