import Mathlib
import Integration.Experiment.ModelSelection

/-!
# Stage 4, lane 1 — continuously parameterised hypothesis families

Stage 3 selected among a *finite* declared family `H = {h₁, …, hₙ}`
(`Integration.Experiment.ModelSelection`).  This file replaces the enumeration
by a parameter:

```
h_θ,  θ ∈ Θ₀ ⊆ Θ        (typically Θ = ℝ and Θ₀ = [a,b])
```

and rebuilds the same three-step architecture — *declared family → observation →
data-derived admissible family → recompiled prediction/risk envelope* — with the
admissible family now a **region** rather than a sublist.

## The objects

* `Reading` — a time, a measured value and a **declared** instrument tolerance.
  It is a tolerance, not a noise distribution: nothing in this file is
  probabilistic.
* `ParamFamily Θ` — a prior region `prior : Set Θ` and a predicted observable
  `predict : Θ → ℝ → ℝ`.
* `Compatible F E` — the surviving parameter region
  `Θ_E = {θ ∈ Θ₀ : h_θ agrees with every reading in E}`.
* `envelope F E C` — the prediction envelope `{C θ : θ ∈ Θ_E}` of a consumer,
  and `riskEnvelope F E R` for a (finitely valued) risk read-out.

## What is proved

Architecture, exactly mirroring the finite case:

* `compatible_subset_prior`, `compatible_nil`, `compatible_append`;
* `more_evidence_no_larger` — **monotonicity**: additional readings never
  enlarge the surviving region, hence never enlarge the prediction envelope
  (`envelope_antitone`) or the risk envelope (`riskEnvelope_antitone`);
* `truth_survives` / `truth_in_envelope` — soundness: a true parameter whose
  predictions lie inside the declared tolerances survives, so the envelope still
  covers its value;
* `coarser_tolerance_admits_more` — a loose instrument is paid for in width;
* `data_cannot_separate_identical_predictions` — the Stage-3 negative, in the
  continuous setting: parameters with equal predicted time-series survive
  together, whatever is observed;
* `FamilyFalsified` with `falsified_iff_forall_exists_bad_reading`,
  `falsified_is_permanent` and `falsified_envelope_empty` — the continuous
  analogue of `refutation_is_total`: the failure is of the *whole parameter
  family*, and no parameter value repairs it.

Continuity/order structure, which the finite case had no analogue of:

* `compatible_isClosed` — a closed region when each `θ ↦ predict θ t` is
  continuous;
* `compatible_ordConnected` — an interval when each is monotone;
* `envelope_eq_Icc` — the prediction envelope of a continuous consumer over a
  nonempty compact interval region **is a closed interval** `[lo, hi]`, so the
  continuous envelope is reportable in exactly the form the finite one was.

Discrimination, quantitatively:

* `affineConstraint_eq_Icc` — for a family affine in the parameter, one reading
  cuts out an interval of half-width `tol / |slope|`;
* `steeper_reading_contracts_more` — of two readings generated by the same true
  parameter, the one whose prediction depends more steeply on the parameter
  leaves the smaller region.  This is the continuous replacement for the counted
  `bestSensor` ranking of Lane 5.

**Claim boundary.** `predict` is an arbitrary function `Θ → ℝ → ℝ`, a tolerance
is a declared nonnegative real, and no probability measure appears anywhere. A
`Compatible` region is a possibility set, *not* a confidence set and *not* a
credible set.
-/

namespace Integration.Experiment.ParameterRegion

open Set

/-! ## §1 Readings and parameterised families -/

/-- **A reading**: the observable was measured at time `time`, the instrument
reported `value`, and the instrument's *declared* tolerance is `tol`.

This is the continuous-time counterpart of the `InstrumentModel` tolerance of
`Integration.Experiment.ModelSelection`, and like it, it is a declared
comparison rule and not a noise distribution. -/
structure Reading where
  /-- When the measurement was taken. -/
  time : ℝ
  /-- What the instrument reported. -/
  value : ℝ
  /-- The declared tolerance of the comparison. -/
  tol : ℝ
  /-- A tolerance is nonnegative. -/
  tol_nonneg : 0 ≤ tol

/-- **A continuously parameterised model family**: a prior region of parameter
values and, for each parameter, the predicted time-series of the observable. -/
structure ParamFamily (Θ : Type*) where
  /-- The parameter values the declaration admits before any data. -/
  prior : Set Θ
  /-- The observable predicted by parameter `θ` at time `t`. -/
  predict : Θ → ℝ → ℝ

variable {Θ : Type*}

/-- Parameter `θ` **fits** a reading when the predicted value is inside the
reading's declared tolerance. -/
def Fits (F : ParamFamily Θ) (θ : Θ) (r : Reading) : Prop :=
  |r.value - F.predict θ r.time| ≤ r.tol

/-- **The surviving parameter region** `Θ_E`: prior parameters fitting all the
evidence. -/
def Compatible (F : ParamFamily Θ) (E : List Reading) : Set Θ :=
  {θ | θ ∈ F.prior ∧ ∀ r ∈ E, Fits F θ r}

theorem mem_compatible {F : ParamFamily Θ} {E : List Reading} {θ : Θ} :
    θ ∈ Compatible F E ↔ θ ∈ F.prior ∧ ∀ r ∈ E, Fits F θ r := Iff.rfl

/-- Evidence can only remove parameters the declaration already allowed. -/
theorem compatible_subset_prior (F : ParamFamily Θ) (E : List Reading) :
    Compatible F E ⊆ F.prior := fun _ h => h.1

/-- With no data, the surviving region is the declared prior region. -/
@[simp] theorem compatible_nil (F : ParamFamily Θ) : Compatible F [] = F.prior := by
  ext θ; simp [Compatible]

/-- Evidence combines by intersection. -/
theorem compatible_append (F : ParamFamily Θ) (E E' : List Reading) :
    Compatible F (E ++ E') = Compatible F E ∩ Compatible F E' := by
  ext θ
  constructor
  · rintro ⟨hp, hf⟩
    exact ⟨⟨hp, fun r hr => hf r (List.mem_append_left _ hr)⟩,
      ⟨hp, fun r hr => hf r (List.mem_append_right _ hr)⟩⟩
  · rintro ⟨⟨hp, h1⟩, ⟨-, h2⟩⟩
    refine ⟨hp, fun r hr => ?_⟩
    rcases List.mem_append.mp hr with h | h
    · exact h1 r h
    · exact h2 r h

/-- **Monotonicity of evidence.**  If every reading of `E` also occurs in `E'`,
the region surviving `E'` is contained in the region surviving `E`: more
discriminating evidence yields no larger an admissible family. -/
theorem more_evidence_no_larger (F : ParamFamily Θ) {E E' : List Reading}
    (h : ∀ r ∈ E, r ∈ E') : Compatible F E' ⊆ Compatible F E := by
  rintro θ ⟨hp, hf⟩
  exact ⟨hp, fun r hr => hf r (h r hr)⟩

/-- Adding one reading contracts the region. -/
theorem compatible_cons_subset (F : ParamFamily Θ) (r : Reading) (E : List Reading) :
    Compatible F (r :: E) ⊆ Compatible F E :=
  more_evidence_no_larger F (fun _ hr => List.mem_cons_of_mem _ hr)

/-! ## §2 Soundness, tolerance, and the indistinguishability negative -/

/-- **Soundness.**  A prior parameter whose predictions are within tolerance of
every reading survives. -/
theorem truth_survives (F : ParamFamily Θ) (E : List Reading) (θ : Θ)
    (hp : θ ∈ F.prior) (hf : ∀ r ∈ E, |r.value - F.predict θ r.time| ≤ r.tol) :
    θ ∈ Compatible F E := ⟨hp, hf⟩

/-- In particular, data generated *exactly* by a prior parameter never removes
it. -/
theorem truth_survives_exact (F : ParamFamily Θ) (E : List Reading) (θ : Θ)
    (hp : θ ∈ F.prior) (hgen : ∀ r ∈ E, r.value = F.predict θ r.time) :
    θ ∈ Compatible F E :=
  truth_survives F E θ hp (fun r hr => by simp [hgen r hr, r.tol_nonneg])

/-- **A coarser instrument admits more.**  Widening the tolerances (at the same
times and values) can only keep more parameters alive. -/
theorem coarser_tolerance_admits_more (F : ParamFamily Θ) {E E' : List Reading}
    (hlen : E.length = E'.length)
    (hmatch : ∀ i : Fin E.length, (E.get i).time = (E'.get (Fin.cast hlen i)).time ∧
      (E.get i).value = (E'.get (Fin.cast hlen i)).value ∧
      (E.get i).tol ≤ (E'.get (Fin.cast hlen i)).tol) :
    Compatible F E ⊆ Compatible F E' := by
  rintro θ ⟨hp, hf⟩
  refine ⟨hp, fun r hr => ?_⟩
  obtain ⟨j, hj⟩ := List.mem_iff_get.mp hr
  -- `j` indexes `E'`; transport it back to `E`.
  have hlen' : E'.length = E.length := hlen.symm
  set i : Fin E.length := Fin.cast hlen' j with hi
  have hji : Fin.cast hlen i = j := by
    apply Fin.ext; simp [hi]
  obtain ⟨ht, hv, htol⟩ := hmatch i
  rw [hji] at ht hv htol
  have hmem : E.get i ∈ E := List.get_mem _ _
  have := hf _ hmem
  unfold Fits at this ⊢
  rw [← hj]
  rw [ht, hv] at this
  exact this.trans htol

/-- **Data cannot separate parameters with identical predicted series.**  The
Stage-3 negative survives the move to a continuum: if two parameters predict the
same observable at every time, no observation whatsoever keeps one and drops the
other.  Contracting such a region needs a *new observable*, not more data. -/
theorem data_cannot_separate_identical_predictions (F : ParamFamily Θ)
    (E : List Reading) {θ₁ θ₂ : Θ} (hpred : ∀ t, F.predict θ₁ t = F.predict θ₂ t)
    (hprior : θ₁ ∈ F.prior ↔ θ₂ ∈ F.prior) :
    θ₁ ∈ Compatible F E ↔ θ₂ ∈ Compatible F E := by
  constructor
  · rintro ⟨hp, hf⟩
    exact ⟨hprior.mp hp, fun r hr => by
      have := hf r hr; unfold Fits at this ⊢; rwa [← hpred r.time]⟩
  · rintro ⟨hp, hf⟩
    exact ⟨hprior.mpr hp, fun r hr => by
      have := hf r hr; unfold Fits at this ⊢; rwa [hpred r.time]⟩

/-! ## §3 Envelopes -/

/-- **The prediction envelope** of a consumer over the surviving region. -/
def envelope (F : ParamFamily Θ) (E : List Reading) (C : Θ → ℝ) : Set ℝ :=
  C '' Compatible F E

/-- **The risk envelope**: the set of risk read-outs the surviving region
allows. -/
def riskEnvelope {Z : Type*} (F : ParamFamily Θ) (E : List Reading) (R : Θ → Z) : Set Z :=
  R '' Compatible F E

/-- **More evidence, no wider prediction.** -/
theorem envelope_antitone (F : ParamFamily Θ) {E E' : List Reading}
    (h : ∀ r ∈ E, r ∈ E') (C : Θ → ℝ) : envelope F E' C ⊆ envelope F E C :=
  Set.image_mono (more_evidence_no_larger F h)

/-- **More evidence, no wider risk envelope.** -/
theorem riskEnvelope_antitone {Z : Type*} (F : ParamFamily Θ) {E E' : List Reading}
    (h : ∀ r ∈ E, r ∈ E') (R : Θ → Z) : riskEnvelope F E' R ⊆ riskEnvelope F E R :=
  Set.image_mono (more_evidence_no_larger F h)

/-- **Soundness of the recompiled prediction.** -/
theorem truth_in_envelope (F : ParamFamily Θ) (E : List Reading) (C : Θ → ℝ) (θ : Θ)
    (hp : θ ∈ F.prior) (hf : ∀ r ∈ E, |r.value - F.predict θ r.time| ≤ r.tol) :
    C θ ∈ envelope F E C := ⟨θ, truth_survives F E θ hp hf, rfl⟩

/-- The same for the risk envelope. -/
theorem truth_in_riskEnvelope {Z : Type*} (F : ParamFamily Θ) (E : List Reading) (R : Θ → Z)
    (θ : Θ) (hp : θ ∈ F.prior) (hf : ∀ r ∈ E, |r.value - F.predict θ r.time| ≤ r.tol) :
    R θ ∈ riskEnvelope F E R := ⟨θ, truth_survives F E θ hp hf, rfl⟩

/-- A point prediction is exactly agreement of the surviving parameters. -/
theorem envelope_subsingleton_iff (F : ParamFamily Θ) (E : List Reading) (C : Θ → ℝ) :
    (envelope F E C).Subsingleton ↔
      ∀ θ₁ ∈ Compatible F E, ∀ θ₂ ∈ Compatible F E, C θ₁ = C θ₂ := by
  constructor
  · intro hs θ₁ h1 θ₂ h2; exact hs ⟨θ₁, h1, rfl⟩ ⟨θ₂, h2, rfl⟩
  · rintro hall _ ⟨θ₁, h1, rfl⟩ _ ⟨θ₂, h2, rfl⟩; exact hall θ₁ h1 θ₂ h2

/-! ## §4 Failure of the whole family -/

/-- **Model-family failure**: no parameter value in the declared family explains
the data.  This is a typed frontier, not a fallback to the nearest parameter. -/
def FamilyFalsified (F : ParamFamily Θ) (E : List Reading) : Prop :=
  Compatible F E = ∅

/-- Failure is exactly "every prior parameter is contradicted by some
reading". -/
theorem falsified_iff_forall_exists_bad_reading (F : ParamFamily Θ) (E : List Reading) :
    FamilyFalsified F E ↔ ∀ θ ∈ F.prior, ∃ r ∈ E, ¬ Fits F θ r := by
  constructor
  · intro h θ hp
    by_contra hcon
    push_neg at hcon
    exact Set.eq_empty_iff_forall_notMem.mp h θ ⟨hp, hcon⟩
  · intro h
    apply Set.eq_empty_iff_forall_notMem.mpr
    rintro θ ⟨hp, hf⟩
    obtain ⟨r, hr, hbad⟩ := h θ hp
    exact hbad (hf r hr)

/-- **Refutation is permanent**: once the family is falsified, no further
measurement revives it. -/
theorem falsified_is_permanent (F : ParamFamily Θ) {E E' : List Reading}
    (h : ∀ r ∈ E, r ∈ E') (hfail : FamilyFalsified F E) : FamilyFalsified F E' :=
  Set.subset_eq_empty (more_evidence_no_larger F h) hfail

/-- A falsified family predicts nothing: the envelope is empty, rather than
being the value of the best-fitting parameter. -/
theorem falsified_envelope_empty (F : ParamFamily Θ) (E : List Reading) (C : Θ → ℝ)
    (hfail : FamilyFalsified F E) : envelope F E C = ∅ := by
  rw [envelope, hfail, Set.image_empty]

/-- And the risk envelope is empty too, so a falsified family issues no safety
verdict either. -/
theorem falsified_riskEnvelope_empty {Z : Type*} (F : ParamFamily Θ) (E : List Reading)
    (R : Θ → Z) (hfail : FamilyFalsified F E) : riskEnvelope F E R = ∅ := by
  rw [riskEnvelope, hfail, Set.image_empty]

/-- A single reading contradicted by every prior parameter already falsifies the
family. -/
theorem falsified_of_single_reading (F : ParamFamily Θ) (r : Reading)
    (h : ∀ θ ∈ F.prior, ¬ Fits F θ r) : FamilyFalsified F [r] :=
  (falsified_iff_forall_exists_bad_reading F [r]).mpr
    (fun θ hp => ⟨r, List.mem_singleton_self r, h θ hp⟩)

/-- **Falsification is a property of the family, not of a parameter.**  If the
family is falsified then in particular no parameter is admissible, so there is
no "best" surviving value to report. -/
theorem falsified_no_survivor (F : ParamFamily Θ) (E : List Reading)
    (hfail : FamilyFalsified F E) (θ : Θ) : θ ∉ Compatible F E := by
  rw [hfail]; exact notMem_empty θ

/-! ## §5 The region is an interval

The results above hold for any parameter type.  For a real parameter with
continuous, monotone dependence the surviving region has the shape one wants to
report: closed, order-connected, and (with a compact prior) mapping to a closed
interval under a continuous consumer. -/

section RealParameter

variable (F : ParamFamily ℝ)

/-- Each reading cuts out a closed set when the prediction is continuous in the
parameter. -/
theorem constraint_isClosed {r : Reading} (hc : Continuous fun θ => F.predict θ r.time) :
    IsClosed {θ : ℝ | Fits F θ r} := by
  have : {θ : ℝ | Fits F θ r} = (fun θ => |r.value - F.predict θ r.time|) ⁻¹' Iic r.tol := rfl
  rw [this]
  exact IsClosed.preimage (by fun_prop) isClosed_Iic

/-- **The surviving region is closed** when the prior region is closed and every
reading time has continuous parameter dependence. -/
theorem compatible_isClosed (E : List Reading) (hprior : IsClosed F.prior)
    (hc : ∀ r ∈ E, Continuous fun θ => F.predict θ r.time) :
    IsClosed (Compatible F E) := by
  have : Compatible F E = F.prior ∩ ⋂ r ∈ E, {θ : ℝ | Fits F θ r} := by
    ext θ; simp [Compatible]
  rw [this]
  refine hprior.inter (isClosed_biInter fun r hr => constraint_isClosed F (hc r hr))

/-- A reading whose prediction is monotone in the parameter cuts out an
order-connected set. -/
theorem constraint_ordConnected {r : Reading}
    (hm : Monotone fun θ => F.predict θ r.time) :
    {θ : ℝ | Fits F θ r}.OrdConnected := by
  constructor
  intro a ha b hb θ hθ
  have h1 : F.predict a r.time ≤ F.predict θ r.time := hm hθ.1
  have h2 : F.predict θ r.time ≤ F.predict b r.time := hm hθ.2
  have ha' := abs_le.mp (show |r.value - F.predict a r.time| ≤ r.tol from ha)
  have hb' := abs_le.mp (show |r.value - F.predict b r.time| ≤ r.tol from hb)
  show |r.value - F.predict θ r.time| ≤ r.tol
  exact abs_le.mpr ⟨by linarith [hb'.1], by linarith [ha'.2]⟩

/-- Likewise for an antitone dependence. -/
theorem constraint_ordConnected_of_antitone {r : Reading}
    (hm : Antitone fun θ => F.predict θ r.time) :
    {θ : ℝ | Fits F θ r}.OrdConnected := by
  constructor
  intro a ha b hb θ hθ
  have h1 : F.predict θ r.time ≤ F.predict a r.time := hm hθ.1
  have h2 : F.predict b r.time ≤ F.predict θ r.time := hm hθ.2
  have ha' := abs_le.mp (show |r.value - F.predict a r.time| ≤ r.tol from ha)
  have hb' := abs_le.mp (show |r.value - F.predict b r.time| ≤ r.tol from hb)
  show |r.value - F.predict θ r.time| ≤ r.tol
  exact abs_le.mpr ⟨by linarith [ha'.1], by linarith [hb'.2]⟩

/-- **The surviving region is an interval** when the prior is and every reading
depends monotonically (each in its own direction) on the parameter. -/
theorem compatible_ordConnected (E : List Reading) (hprior : F.prior.OrdConnected)
    (hm : ∀ r ∈ E, Monotone (fun θ => F.predict θ r.time) ∨
      Antitone (fun θ => F.predict θ r.time)) :
    (Compatible F E).OrdConnected := by
  have hrepr : Compatible F E = F.prior ∩ ⋂ r ∈ E, {θ : ℝ | Fits F θ r} := by
    ext θ; simp [Compatible]
  rw [hrepr]
  refine hprior.inter (Set.ordConnected_iInter fun r => Set.ordConnected_iInter fun hr => ?_)
  rcases hm r hr with h | h
  · exact constraint_ordConnected F h
  · exact constraint_ordConnected_of_antitone F h

/-- The version needed when the parameter dependence is only monotone *on the
prior region* — the usual situation for a physical parameter that must stay
positive. -/
theorem compatible_ordConnected_of_monotoneOn (E : List Reading) (hprior : F.prior.OrdConnected)
    (hm : ∀ r ∈ E, MonotoneOn (fun θ => F.predict θ r.time) F.prior ∨
      AntitoneOn (fun θ => F.predict θ r.time) F.prior) :
    (Compatible F E).OrdConnected := by
  constructor
  rintro a ⟨hap, haf⟩ b ⟨hbp, hbf⟩ θ hθ
  have hθp : θ ∈ F.prior := hprior.out hap hbp hθ
  refine ⟨hθp, fun r hr => ?_⟩
  have ha' := abs_le.mp (show |r.value - F.predict a r.time| ≤ r.tol from haf r hr)
  have hb' := abs_le.mp (show |r.value - F.predict b r.time| ≤ r.tol from hbf r hr)
  show |r.value - F.predict θ r.time| ≤ r.tol
  rcases hm r hr with h | h
  · have h1 : F.predict a r.time ≤ F.predict θ r.time := h hap hθp hθ.1
    have h2 : F.predict θ r.time ≤ F.predict b r.time := h hθp hbp hθ.2
    exact abs_le.mpr ⟨by linarith [hb'.1], by linarith [ha'.2]⟩
  · have h1 : F.predict θ r.time ≤ F.predict a r.time := h hap hθp hθ.1
    have h2 : F.predict b r.time ≤ F.predict θ r.time := h hθp hbp hθ.2
    exact abs_le.mpr ⟨by linarith [ha'.1], by linarith [hb'.2]⟩

/-- Likewise, the closedness statement with continuity assumed only on the prior
region. -/
theorem compatible_isClosed_of_continuousOn (E : List Reading) (hprior : IsClosed F.prior)
    (hc : ∀ r ∈ E, ContinuousOn (fun θ => F.predict θ r.time) F.prior) :
    IsClosed (Compatible F E) := by
  have hrepr : Compatible F E =
      F.prior ∩ ⋂ r ∈ E, (F.prior ∩ (fun θ => |r.value - F.predict θ r.time|) ⁻¹' Iic r.tol) := by
    ext θ
    constructor
    · rintro ⟨hp, hf⟩
      refine ⟨hp, ?_⟩
      simp only [Set.mem_iInter]
      exact fun r hr => ⟨hp, hf r hr⟩
    · rintro ⟨hp, h⟩
      simp only [Set.mem_iInter] at h
      exact ⟨hp, fun r hr => (h r hr).2⟩
  rw [hrepr]
  refine hprior.inter (isClosed_biInter fun r hr => ?_)
  refine ContinuousOn.preimage_isClosed_of_isClosed ?_ hprior isClosed_Iic
  exact (continuousOn_const.sub (hc r hr)).abs

/-- **The prediction envelope of a continuous consumer is a closed interval.**
If the surviving region is nonempty, compact and order-connected — the situation
of `compatible_isClosed` and `compatible_ordConnected` inside a bounded prior —
then the envelope is `[lo, hi]`, so a continuous parameter family reports the
same shape of answer as the finite Stage-3 one. -/
theorem envelope_eq_Icc (E : List Reading) (C : ℝ → ℝ)
    (hne : (Compatible F E).Nonempty) (hk : IsCompact (Compatible F E))
    (hoc : (Compatible F E).OrdConnected) (hC : ContinuousOn C (Compatible F E)) :
    envelope F E C = Icc (sInf (envelope F E C)) (sSup (envelope F E C)) := by
  refine eq_Icc_of_connected_compact ?_ (hk.image_of_continuousOn hC)
  exact ⟨hne.image C, (isPreconnected_iff_ordConnected.mpr hoc).image C hC⟩

end RealParameter

/-! ## §6 Discrimination: which measurement contracts the region most?

For a family affine in the parameter, one reading cuts out an interval whose
half-width is `tol / |slope|`.  Of two readings generated by the same true
parameter, the one with the steeper parameter dependence therefore leaves the
smaller region: this is the quantitative, continuous replacement for the counted
sensor ranking of Lane 5. -/

section Affine

/-- The family `predict θ t = base t + slope t * θ`. -/
def affineFamily (prior : Set ℝ) (base slope : ℝ → ℝ) : ParamFamily ℝ where
  prior := prior
  predict := fun θ t => base t + slope t * θ

@[simp] theorem affineFamily_predict (prior : Set ℝ) (base slope : ℝ → ℝ) (θ t : ℝ) :
    (affineFamily prior base slope).predict θ t = base t + slope t * θ := rfl

/-- **One reading of an affine family cuts out an interval** centred on the
parameter the reading points at, of half-width `tol / |slope|`. -/
theorem affineConstraint_eq_Icc (prior : Set ℝ) (base slope : ℝ → ℝ) (r : Reading)
    (hs : slope r.time ≠ 0) :
    {θ : ℝ | Fits (affineFamily prior base slope) θ r} =
      Icc ((r.value - base r.time) / slope r.time - r.tol / |slope r.time|)
          ((r.value - base r.time) / slope r.time + r.tol / |slope r.time|) := by
  have habs : 0 < |slope r.time| := abs_pos.mpr hs
  ext θ
  have key : |r.value - (base r.time + slope r.time * θ)|
      = |slope r.time| * |(r.value - base r.time) / slope r.time - θ| := by
    rw [← abs_mul]
    congr 1
    field_simp
    ring
  simp only [Fits, affineFamily_predict, mem_setOf_eq, mem_Icc, key]
  rw [mul_comm, ← le_div_iff₀ habs, abs_le]
  constructor
  · rintro ⟨h1, h2⟩; constructor <;> linarith
  · rintro ⟨h1, h2⟩; constructor <;> linarith


/-- **A steeper reading contracts more.**  Two readings of an affine family are
taken, both generated exactly by the same true parameter `θ*`, with the same
declared tolerance; the second's prediction depends more steeply on the
parameter.  Then every parameter surviving the second also survives the first:
the steeper measurement is at least as discriminating.

This is the continuous analogue of the Lane-5 `bestSensor` ranking, and like it,
it is a statement about *this* declared comparison, not about instruments in
general. -/
theorem steeper_reading_contracts_more (prior : Set ℝ) (base slope : ℝ → ℝ)
    (r₁ r₂ : Reading) (θstar : ℝ)
    (hgen₁ : r₁.value = base r₁.time + slope r₁.time * θstar)
    (hgen₂ : r₂.value = base r₂.time + slope r₂.time * θstar)
    (htol : r₁.tol = r₂.tol)
    (hsteep : |slope r₁.time| ≤ |slope r₂.time|) :
    {θ : ℝ | Fits (affineFamily prior base slope) θ r₂} ⊆
      {θ : ℝ | Fits (affineFamily prior base slope) θ r₁} := by
  intro θ hθ
  have h2 : |r₂.value - (base r₂.time + slope r₂.time * θ)| ≤ r₂.tol := hθ
  rw [hgen₂] at h2
  have h2' : |slope r₂.time| * |θstar - θ| ≤ r₂.tol := by
    calc |slope r₂.time| * |θstar - θ| = |slope r₂.time * (θstar - θ)| := (abs_mul _ _).symm
      _ = |base r₂.time + slope r₂.time * θstar - (base r₂.time + slope r₂.time * θ)| := by
          ring_nf
      _ ≤ r₂.tol := h2
  show |r₁.value - (base r₁.time + slope r₁.time * θ)| ≤ r₁.tol
  rw [hgen₁, htol]
  have : |base r₁.time + slope r₁.time * θstar - (base r₁.time + slope r₁.time * θ)|
      = |slope r₁.time| * |θstar - θ| := by
    rw [← abs_mul]; ring_nf
  rw [this]
  calc |slope r₁.time| * |θstar - θ| ≤ |slope r₂.time| * |θstar - θ| := by
        exact mul_le_mul_of_nonneg_right hsteep (abs_nonneg _)
    _ ≤ r₂.tol := h2'

/-- The consequence for the surviving region: adding the steeper reading to the
evidence leaves no more parameters than adding the shallower one. -/
theorem steeper_reading_leaves_smaller_region (prior : Set ℝ) (base slope : ℝ → ℝ)
    (E : List Reading) (r₁ r₂ : Reading) (θstar : ℝ)
    (hgen₁ : r₁.value = base r₁.time + slope r₁.time * θstar)
    (hgen₂ : r₂.value = base r₂.time + slope r₂.time * θstar)
    (htol : r₁.tol = r₂.tol)
    (hsteep : |slope r₁.time| ≤ |slope r₂.time|) :
    Compatible (affineFamily prior base slope) (r₂ :: E) ⊆
      Compatible (affineFamily prior base slope) (r₁ :: E) := by
  rintro θ ⟨hp, hf⟩
  refine ⟨hp, fun r hr => ?_⟩
  rcases List.mem_cons.mp hr with rfl | hr
  · exact steeper_reading_contracts_more prior base slope r r₂ θstar hgen₁ hgen₂ htol
      hsteep (hf r₂ (List.mem_cons_self ..))
  · exact hf r (List.mem_cons_of_mem _ hr)

end Affine

end Integration.Experiment.ParameterRegion
