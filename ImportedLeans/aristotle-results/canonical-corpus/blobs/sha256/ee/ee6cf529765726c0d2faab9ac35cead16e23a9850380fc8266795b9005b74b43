      φ : W → pullback f g
      φ = induced-map-to-pullback w₁ (h ∘ w₂) η

      {-
      apply cancelling to the lower rectangle

       W
       |\
       | φ->P--> A
       |    |⌟   |
       w₂   p₂   f
