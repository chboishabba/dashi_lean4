name = "RequestProject"
defaultTargets = ["monster", "ClayClosure", "AgdaMirror"]

[[require]]
name = "mathlib"
git = "https://github.com/leanprover-community/mathlib4.git"
rev = "v4.28.0"

[[lean_lib]]
name = "monster"
globs = ["monster.+"]

# Genuine, self-contained analytic cores of the Yang–Mills and Navier–Stokes
# "closure receipts" (see YangMillsClosure.lean, NavierStokesClosure.lean,
# SpectralClosure.lean and Main.lean).  These are honest sub-lemmas: the deep
# open inputs (mass gap m > 0, enstrophy depletion, Beale–Kato–Majda) are taken
# as explicit hypotheses, and everything stated is proved with no `sorry` and no
# extra axioms.
[[lean_lib]]
name = "ClayClosure"
srcDir = "."
roots = ["YangMillsClosure", "NavierStokesClosure", "SpectralClosure", "YangMillsContinuumGap", "ClosureEndToEnd", "Main"]

# Faithful Lean mirrors of the repository's non-NS/YM root Agda modules.
# Genuine lemmas are proved (no `sorry`, axiom-clean); structural scaffolding is
# transcribed with its honesty boundaries preserved (postulates become explicit
# hypotheses, never axioms).  See AgdaMirror.lean for the survey/classification.
[[lean_lib]]
name = "AgdaMirror"
srcDir = "."
roots = ["AgdaMirror"]
