namespace Sparql

/-! ## Elementary steps -/

/-- An elementary step of a property path: forward along a property, or backward
along it (SPARQL's `^p`). -/
inductive Step1
  | fwd (p : Pid)
  | bwd (p : Pid)
  deriving DecidableEq, Repr, Inhabited

/-- The items an elementary step leads to, over the truthy projection. -/
def stepTargets (kb : KB) : Step1 → Qid → List Qid
  | Step1.fwd p, x =>
      (truthyStatements kb).filterMap
        (fun st => if st.subject = x ∧ st.property = p then some st.value else none)
  | Step1.bwd p, x =>
      (truthyStatements kb).filterMap
        (fun st => if st.value = x ∧ st.property = p then some st.subject else none)

theorem mem_stepTargets_fwd_iff (kb : KB) (p : Pid) (x y : Qid) :
    y ∈ stepTargets kb (Step1.fwd p) x ↔
      ∃ st ∈ truthyStatements kb, st.subject = x ∧ st.property = p ∧ st.value = y := by
  simp only [stepTargets, List.mem_filterMap]
  constructor
  · rintro ⟨st, hst, hmatch⟩
    by_cases h : st.subject = x ∧ st.property = p
    · rw [if_pos h] at hmatch
      exact ⟨st, hst, h.1, h.2, Option.some.inj hmatch⟩
    · simp [h] at hmatch
  · rintro ⟨st, hst, h1, h2, h3⟩
    exact ⟨st, hst, by simp [h1, h2, h3]⟩

theorem mem_stepTargets_bwd_iff (kb : KB) (p : Pid) (x y : Qid) :
    y ∈ stepTargets kb (Step1.bwd p) x ↔
      ∃ st ∈ truthyStatements kb, st.value = x ∧ st.property = p ∧ st.subject = y := by
  simp only [stepTargets, List.mem_filterMap]
  constructor
  · rintro ⟨st, hst, hmatch⟩
    by_cases h : st.value = x ∧ st.property = p
    · rw [if_pos h] at hmatch
      exact ⟨st, hst, h.1, h.2, Option.some.inj hmatch⟩
    · simp [h] at hmatch
  · rintro ⟨st, hst, h1, h2, h3⟩
    exact ⟨st, hst, by simp [h1, h2, h3]⟩

/-- Every item an elementary step can reach: the subjects and the values of the
statements.  This is the finite carrier the bounded search runs over. -/
def pathNodes (kb : KB) : List Qid :=
  kb.statements.map Statement.subject ++ kb.statements.map Statement.value

theorem stepTargets_subset_pathNodes (kb : KB) (s : Step1) (x y : Qid)
    (h : y ∈ stepTargets kb s x) : y ∈ pathNodes kb := by
  cases s with
  | fwd p =>
      rw [mem_stepTargets_fwd_iff] at h
      obtain ⟨st, hst, _, _, hval⟩ := h
      rw [mem_truthyStatements_iff] at hst
      exact List.mem_append_right _ (List.mem_map.2 ⟨st, hst.1, hval⟩)
  | bwd p =>
      rw [mem_stepTargets_bwd_iff] at h
      obtain ⟨st, hst, _, _, hsub⟩ := h
      rw [mem_truthyStatements_iff] at hst
      exact List.mem_append_left _ (List.mem_map.2 ⟨st, hst.1, hsub⟩)

/-! ## Paths -/

/-- A SPARQL property path over elementary steps. -/
inductive Path
  | one (s : Step1)
  | eps
  | seq (a b : Path)
  | alt (a b : Path)
  | star (s : Step1)
  deriving DecidableEq, Repr, Inhabited

/-- `p+`, one or more steps. -/
def Path.plus (s : Step1) : Path := Path.seq (Path.one s) (Path.star s)

/-- `p?`, zero or one traversal of a path. -/
def Path.zeroOrOne (a : Path) : Path := Path.alt Path.eps a

/-- The declarative semantics of a property path. -/
def Holds (kb : KB) : Path → Qid → Qid → Prop
  | Path.one s, x, y => y ∈ stepTargets kb s x
  | Path.eps, x, y => y = x
  | Path.seq a b, x, y => ∃ z, Holds kb a x z ∧ Holds kb b z y
  | Path.alt a b, x, y => Holds kb a x y ∨ Holds kb b x y
  | Path.star s, x, y => Relation.ReflTransGen (Reach.Step (stepTargets kb s)) x y

/-- The executable evaluator: the items a path leads to from a given item.  The
list may repeat an answer — SPARQL's own semantics is a bag — so `countTargets`
below removes duplicates before counting. -/
def targets (kb : KB) : Path → Qid → List Qid
  | Path.one s, x => stepTargets kb s x
  | Path.eps, x => [x]
  | Path.seq a b, x => (targets kb a x).flatMap (fun z => targets kb b z)
  | Path.alt a b, x => targets kb a x ++ targets kb b x
  | Path.star s, x =>
      (x :: pathNodes kb).filter
        (fun y => Reach.reachIn (stepTargets kb s) (pathNodes kb).length x y)

theorem reachIn_stepTargets_iff (kb : KB) (s : Step1) (x y : Qid) :
    Reach.reachIn (stepTargets kb s) (pathNodes kb).length x y = true ↔
      Relation.ReflTransGen (Reach.Step (stepTargets kb s)) x y :=
  Reach.reachIn_iff (stepTargets kb s) (pathNodes kb)
    (fun u v hv => stepTargets_subset_pathNodes kb s u v hv) x y

theorem star_endpoint_mem (kb : KB) (s : Step1) {x y : Qid}
    (h : Relation.ReflTransGen (Reach.Step (stepTargets kb s)) x y) :
    y ∈ x :: pathNodes kb := by
  rcases Relation.ReflTransGen.cases_tail h with h' | ⟨z, _, hstep⟩
  · exact h' ▸ List.mem_cons_self ..
  · exact List.mem_cons_of_mem _ (stepTargets_subset_pathNodes kb s z y hstep)

/-- **Exactness of path evaluation.**  The evaluator returns exactly the items the
declarative semantics relates. -/
theorem mem_targets_iff (kb : KB) : ∀ (pa : Path) (x y : Qid),
    y ∈ targets kb pa x ↔ Holds kb pa x y := by
  intro pa
  induction pa with
  | one s => intro x y; simp [targets, Holds]
  | eps => intro x y; simp [targets, Holds]
  | seq a b iha ihb =>
      intro x y
      simp only [targets, List.mem_flatMap, Holds]
      constructor
      · rintro ⟨z, hz, hy⟩; exact ⟨z, (iha x z).1 hz, (ihb z y).1 hy⟩
      · rintro ⟨z, hz, hy⟩; exact ⟨z, (iha x z).2 hz, (ihb z y).2 hy⟩
  | alt a b iha ihb =>
      intro x y
      simp only [targets, List.mem_append, Holds]
      exact or_congr (iha x y) (ihb x y)
  | star s =>
      intro x y
      simp only [targets, List.mem_filter, Holds]
      constructor
      · rintro ⟨_, hreach⟩
        exact (reachIn_stepTargets_iff kb s x y).1 hreach
      · intro h
        exact ⟨star_endpoint_mem kb s h, (reachIn_stepTargets_iff kb s x y).2 h⟩

instance (kb : KB) (pa : Path) (x y : Qid) : Decidable (Holds kb pa x y) :=
  decidable_of_iff _ (mem_targets_iff kb pa x y)

/-! ## The path recovers the class order -/

theorem mem_stepTargets_P279_iff (kb : KB) (a b : Qid) :
    b ∈ stepTargets kb (Step1.fwd P279) a ↔ DirectSubclass kb a b := by
  rw [mem_stepTargets_fwd_iff]
  constructor
  · rintro ⟨st, hst, hsub, hprop, hval⟩
    rw [mem_truthyStatements_iff] at hst
    refine List.mem_map.2 ⟨st, ?_, by rw [hsub, hval]⟩
    exact List.mem_filter.2 ⟨hst.1, by simp [hprop, hst.2]⟩
  · intro h
    obtain ⟨st, hst, heq⟩ := List.mem_map.1 h
    rw [List.mem_filter] at hst
    have h2 : st.property = P279 ∧ IsTruthy kb st = true := by
      simpa using hst.2
    refine ⟨st, (mem_truthyStatements_iff kb st).2 ⟨hst.1, h2.2⟩, ?_, h2.1, ?_⟩
    · exact congrArg Prod.fst heq
    · exact congrArg Prod.snd heq

theorem mem_stepTargets_P31_iff (kb : KB) (x c : Qid) :
    c ∈ stepTargets kb (Step1.fwd P31) x ↔ (x, c) ∈ instanceEdges kb := by
  rw [mem_stepTargets_fwd_iff]
  constructor
  · rintro ⟨st, hst, hsub, hprop, hval⟩
    rw [mem_truthyStatements_iff] at hst
    refine List.mem_map.2 ⟨st, ?_, by rw [hsub, hval]⟩
    exact List.mem_filter.2 ⟨hst.1, by simp [hprop, hst.2]⟩
  · intro h
    obtain ⟨st, hst, heq⟩ := List.mem_map.1 h
    rw [List.mem_filter] at hst
    have h2 : st.property = P31 ∧ IsTruthy kb st = true := by
      simpa using hst.2
    refine ⟨st, (mem_truthyStatements_iff kb st).2 ⟨hst.1, h2.2⟩, ?_, h2.1, ?_⟩
    · exact congrArg Prod.fst heq
    · exact congrArg Prod.snd heq

/-- **`P279*` is the subclass relation.**  The star of the elementary `P279` step
and the project's declarative subclass order are the same relation. -/
theorem star_P279_iff_subclassOf (kb : KB) (a b : Qid) :
    Holds kb (Path.star (Step1.fwd P279)) a b ↔ SubclassOf kb a b := by
  have hrel : Reach.Step (stepTargets kb (Step1.fwd P279)) = DirectSubclass kb := by
    funext u v
    exact propext (mem_stepTargets_P279_iff kb u v)
  simp [Holds, SubclassOf, hrel]

/-- The Wikidata idiom `wdt:P31/wdt:P279*`. -/
def instancePath : Path := Path.seq (Path.one (Step1.fwd P31)) (Path.star (Step1.fwd P279))

/-- **`P31/P279*` is the instance relation.**  The property path that Wikidata
queries use to ask for instances of a class computes exactly the project's
declarative instance relation — so the closure a triple pattern cannot see
(`query_does_not_close_over_subclasses`) is recovered by the path, provably. -/
theorem instancePath_iff_instanceOf (kb : KB) (x c : Qid) :
    Holds kb instancePath x c ↔ InstanceOf kb x c := by
  constructor
  · rintro ⟨c₀, h₁, h₂⟩
    exact ⟨c₀, (mem_stepTargets_P31_iff kb x c₀).1 h₁,
      (star_P279_iff_subclassOf kb c₀ c).1 h₂⟩
  · rintro ⟨c₀, h₁, h₂⟩
    exact ⟨c₀, (mem_stepTargets_P31_iff kb x c₀).2 h₁,
      (star_P279_iff_subclassOf kb c₀ c).2 h₂⟩

/-! ## The path fragment is positive -/

theorem stepTargets_mono {kb₁ kb₂ : KB} (hsub : kb₁.statements ⊆ kb₂.statements)
    (h₂ : AllNormal kb₂) (s : Step1) {x y : Qid} (h : y ∈ stepTargets kb₁ s x) :
    y ∈ stepTargets kb₂ s x := by
  have hst : ∀ st ∈ truthyStatements kb₁, st ∈ truthyStatements kb₂ := by
    intro st hst
    rw [mem_truthyStatements_iff] at hst ⊢
    exact ⟨hsub hst.1, isTruthy_of_allNormal h₂ (hsub hst.1)⟩
  cases s with
  | fwd p =>
      rw [mem_stepTargets_fwd_iff] at h ⊢
      obtain ⟨st, hmem, h1, h2, h3⟩ := h
      exact ⟨st, hst st hmem, h1, h2, h3⟩
  | bwd p =>
      rw [mem_stepTargets_bwd_iff] at h ⊢
      obtain ⟨st, hmem, h1, h2, h3⟩ := h
      exact ⟨st, hst st hmem, h1, h2, h3⟩

/-- **Every property path is monotone.**  An answer over a knowledge base is an
answer over any larger one: unlike `OPTIONAL` and `!bound`, a path never withdraws
an answer when data arrives. -/
theorem holds_mono {kb₁ kb₂ : KB} (hsub : kb₁.statements ⊆ kb₂.statements)
    (h₂ : AllNormal kb₂) : ∀ (pa : Path) {x y : Qid},
    Holds kb₁ pa x y → Holds kb₂ pa x y := by
  intro pa
  induction pa with
  | one s => intro x y h; exact stepTargets_mono hsub h₂ s h
  | eps => intro x y h; exact h
  | seq a b iha ihb =>
      rintro x y ⟨z, h1, h2⟩
      exact ⟨z, iha h1, ihb h2⟩
  | alt a b iha ihb =>
      rintro x y (h | h)
      · exact Or.inl (iha h)
      · exact Or.inr (ihb h)
  | star s =>
      intro x y h
      refine Relation.ReflTransGen.mono ?_ h
      intro u v huv
      exact stepTargets_mono hsub h₂ s huv

/-! ## What a path answer is not

The worked base has a two-step subclass chain and one instance statement:
`Q1` is an instance of `Q2`, `Q2` is a subclass of `Q3`, `Q3` a subclass of `Q4`. -/

/-- The worked base. -/
def chainKB : KB :=
  ⟨[⟨1⟩, ⟨2⟩, ⟨3⟩, ⟨4⟩],
   [⟨⟨1⟩, P31, ⟨2⟩, Rank.normal⟩, ⟨⟨2⟩, P279, ⟨3⟩, Rank.normal⟩,
    ⟨⟨3⟩, P279, ⟨4⟩, Rank.normal⟩]⟩

/-- The path finds the transitive superclass that no single statement records. -/
theorem star_traverses_the_chain :
    Holds chainKB (Path.star (Step1.fwd P279)) ⟨2⟩ ⟨4⟩ := by decide

/-- The instance path answers the query a triple pattern cannot: `Q1` is an
instance of `Q4`, through two subclass edges. -/
theorem instancePath_finds_the_derived_instance :
    Holds chainKB instancePath ⟨1⟩ ⟨4⟩ ∧
      [("x", (⟨1⟩ : Qid))] ∉ eval chainKB (Query.pattern ⟨Term.var "x", P31, Term.item ⟨4⟩⟩) := by
  refine ⟨by decide, by decide⟩

/-- **`p*` is not `p+`.**  The star relates every item to itself; that answer is
not evidence of a statement, and the same query with `p+` returns nothing. -/
theorem star_is_not_plus :
    Holds chainKB (Path.star (Step1.fwd P279)) ⟨2⟩ ⟨2⟩ ∧
      ¬ Holds chainKB (Path.plus (Step1.fwd P279)) ⟨2⟩ ⟨2⟩ := by
  refine ⟨by decide, by decide⟩

/-- **`^p` is not `p`.**  The inverse step is a different path on the same base. -/
theorem inverse_is_not_forward :
    Holds chainKB (Path.one (Step1.bwd P279)) ⟨3⟩ ⟨2⟩ ∧
      ¬ Holds chainKB (Path.one (Step1.fwd P279)) ⟨3⟩ ⟨2⟩ := by
  refine ⟨by decide, by decide⟩

/-- **A path answer is derived, not recorded.**  `Q2` is a subclass of `Q4` along
the path and no statement of the base says so. -/
theorem path_answer_is_derived_not_recorded :
    Holds chainKB (Path.star (Step1.fwd P279)) ⟨2⟩ ⟨4⟩ ∧
      (⟨⟨2⟩, P279, ⟨4⟩, Rank.normal⟩ : Statement) ∉ chainKB.statements := by
  refine ⟨by decide, by decide⟩

/-- A base in which the `P279` edge out of `Q2` is rank-shadowed: the normal
statement to `Q3` is invisible because a preferred statement to `Q5` exists. -/
def shadowedKB : KB :=
  ⟨[⟨1⟩, ⟨2⟩, ⟨3⟩, ⟨5⟩],
   [⟨⟨2⟩, P279, ⟨3⟩, Rank.normal⟩, ⟨⟨2⟩, P279, ⟨5⟩, Rank.preferred⟩]⟩

/-- **A path reads the truthy layer.**  The shadowed statement is in the base and
the path does not traverse it. -/
theorem path_reads_the_truthy_layer :
    (⟨⟨2⟩, P279, ⟨3⟩, Rank.normal⟩ : Statement) ∈ shadowedKB.statements ∧
      ¬ Holds shadowedKB (Path.one (Step1.fwd P279)) ⟨2⟩ ⟨3⟩ ∧
      Holds shadowedKB (Path.one (Step1.fwd P279)) ⟨2⟩ ⟨5⟩ := by
  refine ⟨by decide, by decide, by decide⟩

/-- A base whose only subclass statement is deprecated. -/
def deprecatedPathKB : KB :=
  ⟨[⟨2⟩, ⟨3⟩], [⟨⟨2⟩, P279, ⟨3⟩, Rank.deprecated⟩]⟩

/-- **Deprecated data is not traversed**, so an empty path answer does not even
mean the base is silent. -/
theorem path_does_not_traverse_deprecated :
    (⟨⟨2⟩, P279, ⟨3⟩, Rank.deprecated⟩ : Statement) ∈ deprecatedPathKB.statements ∧
      ¬ Holds deprecatedPathKB (Path.plus (Step1.fwd P279)) ⟨2⟩ ⟨3⟩ := by
  refine ⟨by decide, by decide⟩

/-! ## Counting a path answer -/

/-- The number of *distinct* items a path leads to: SPARQL's
`COUNT(DISTINCT ?y)`. -/
def countTargets (kb : KB) (pa : Path) (x : Qid) : Nat := (targets kb pa x).dedup.length

/-- The count is a count of the answers: an item is counted exactly when the path
relates it to the subject. -/
theorem mem_dedup_targets_iff (kb : KB) (pa : Path) (x y : Qid) :
    y ∈ (targets kb pa x).dedup ↔ Holds kb pa x y := by
  rw [List.mem_dedup]
  exact mem_targets_iff kb pa x y

theorem countTargets_eq_zero_iff (kb : KB) (pa : Path) (x : Qid) :
    countTargets kb pa x = 0 ↔ ∀ y, ¬ Holds kb pa x y := by
  simp only [countTargets, List.length_eq_zero_iff]
  constructor
  · intro h y hy
    have := (mem_dedup_targets_iff kb pa x y).2 hy
    rw [h] at this
    exact absurd this (List.not_mem_nil)
  · intro h
    apply List.eq_nil_iff_forall_not_mem.2
    intro y hy
    exact h y ((mem_dedup_targets_iff kb pa x y).1 hy)

/-- The larger base: the same chain with one more instance statement. -/
def chainKB' : KB :=
  ⟨[⟨1⟩, ⟨2⟩, ⟨3⟩, ⟨4⟩],
   [⟨⟨1⟩, P31, ⟨2⟩, Rank.normal⟩, ⟨⟨2⟩, P279, ⟨3⟩, Rank.normal⟩,
    ⟨⟨3⟩, P279, ⟨4⟩, Rank.normal⟩, ⟨⟨1⟩, P31, ⟨4⟩, Rank.normal⟩]⟩

theorem chainKB_subset_chainKB' : chainKB.statements ⊆ chainKB'.statements := by decide

theorem chainKB'_allNormal : AllNormal chainKB' := by
  intro st hst
  simp only [chainKB', List.mem_cons, List.not_mem_nil, or_false] at hst
  rcases hst with h | h | h | h <;> subst h <;> rfl

/-- **An aggregate is a count of the record.**  Every answer over the smaller base
is still an answer over the larger one — the path fragment is monotone — and yet
the count changes, so a `COUNT` reports what the base holds when it is asked and
not a quantity in the world. -/
theorem count_is_not_stable_under_growth :
    (∀ y, Holds chainKB (Path.one (Step1.fwd P31)) ⟨1⟩ y →
        Holds chainKB' (Path.one (Step1.fwd P31)) ⟨1⟩ y) ∧
      countTargets chainKB (Path.one (Step1.fwd P31)) ⟨1⟩ = 1 ∧
      countTargets chainKB' (Path.one (Step1.fwd P31)) ⟨1⟩ = 2 := by
  refine ⟨?_, by decide, by decide⟩
  intro y hy
  exact holds_mono chainKB_subset_chainKB' chainKB'_allNormal (Path.one (Step1.fwd P31)) hy

