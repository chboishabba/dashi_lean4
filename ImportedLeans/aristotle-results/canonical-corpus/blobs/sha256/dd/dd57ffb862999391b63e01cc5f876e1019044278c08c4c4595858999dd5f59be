------------------------------------------------------------------------
-- What is actually machine-checked in this repository today, and is
-- therefore NOT a separate research row
------------------------------------------------------------------------

-- Row A's arithmetic reduction: two-sided Gaussian shell bounds plus a
-- uniformly bounded small-coupling history budget that does not consume the
-- margin give the uniform positive cumulative margin the downstream chain
-- consumes.  Open: b- > 0 for the actual constrained Gaussian normalisation
-- (identity-background Hessian including Q-constraint dependence), and the
-- uniform nonlinear interaction Hessian estimate producing C and rho.
rowAReductionChecked :
  (H : CumulativeBetaHypotheses) → ∀ k n →
  (bStar H * natToℚ (suc n)) ≤ prefixSum (beta H) k (suc n)
rowAReductionChecked = cumulativeBetaMargin

-- The sharp form: row A's four constants close the entire prefix inequality
-- as soon as  C * B < b_-,  with uniform downstream constant b_* = b_- - C*B.
-- This is the single numerical target that the constrained Gaussian Hessian
-- and the nonlinear interaction Hessian estimate must meet, and the only way
-- row A can be numerically falsified.
rowAClosureCriterionChecked :
  (betaZseq betaIntseq : Nat → ℚ) (hist : ContractingShellFamily)
  (C bM bP : ℚ) →
  0ℚ ≤ C →
  (∀ j → bM ≤ betaZseq j) →
  (∀ j → betaZseq j ≤ bP) →
  (∀ k n → prefixSum betaIntseq k n ≤ C * prefixSum (shell hist) k n) →
  (∀ k n → (ℚ.- (C * prefixSum (shell hist) k n)) ≤ prefixSum betaIntseq k n) →
  0ℚ < (bM ℚ.- C * budget hist) →
  ∀ k n →
  ((bM ℚ.- C * budget hist) * natToℚ (suc n))
    ≤ prefixSum (λ j → betaZseq j + betaIntseq j) k (suc n)
rowAClosureCriterionChecked = closureCriterionMargin

-- The hypotheses of that reduction are consistent (explicit inhabitant with
-- a nonzero geometric interaction history).
rowAReductionNonVacuous : CumulativeBetaHypotheses
rowAReductionNonVacuous = WitnessA.witness

-- Row A's shell-local sign mechanism: with the CMP109-supported linear
-- interaction estimate, only the small-coupling tube is needed (no summability
-- of the marginal history), and the sign condition reduces to  C*gamma < b-.
rowAShellMarginChecked :
  (d : ShellMargin.ShellLinearInteractionData) → ∀ j →
  ShellMargin.Shell.shellMargin d
    ≤ ShellMargin.ShellLinearInteractionData.beta d j
rowAShellMarginChecked d = ShellMargin.Shell.shellBetaLower d

-- Row A's cutoff-independent summability mechanism: a positive inverse-square
-- (beta) margin telescopes into a bounded sum of cubes of the coupling.
rowACubicTelescopeChecked :
  ∀ {cutoff} (flow : CubicDrift.InverseSquareMarginFlow cutoff) →
  ∀ {tubeWidth} →
  (∀ K → CubicDrift.InverseSquareMarginFlow.coupling flow K
           ℚ.- CubicDrift.InverseSquareMarginFlow.coupling flow 0 ≤ tubeWidth) →
  ∀ K → K NatOrder.≤ cutoff →
  CubicDrift.InverseSquareMarginFlow.marginConstant flow
    * CubicDrift.sumCubes (CubicDrift.InverseSquareMarginFlow.coupling flow) K
    ≤ CubicDrift.twoℚ * tubeWidth
rowACubicTelescopeChecked flow = CubicDrift.Flow.cubicSumInTube flow

-- Row A's tuning gate: L*gamma < b_* makes the cumulative shooting
-- sensitivity strictly below one, uniformly in the cutoff.
rowAContractionGateChecked :
  ∀ {cutoff} (d : Shooting.CumulativeSensitivityData cutoff) →
  ∀ K → K NatOrder.≤ cutoff →
  ShellMargin.sum₀ (Shooting.CumulativeSensitivityData.sensitivity d) K < 1ℚ
rowAContractionGateChecked d = Shooting.Sensitivity.cumulativeSensitivityBelowOne d

-- Row A's group-theoretic sign arithmetic for SU(2): once the regular
-- four-orbit contribution is enclosed in [-1/2,1/2], beta_Z >= 5/12 > 0.
rowASU2FloorChecked :
  (enclosure : SU2Floor.SU2RegularOrbitEnclosure) →
  SU2Floor.su2BetaFloor ≤ SU2Floor.betaGauss enclosure
rowASU2FloorChecked = SU2Floor.su2GaussianBetaFloor

-- Row A's completion contract cannot be met by the slope condition alone.
rowASlopeInsufficientChecked :
  Contract.SlopeInsufficiency
rowASlopeInsufficientChecked = Contract.slopeAndTubeDoNotImplyWindow

-- Row B's declared downstream consequence, machine-checked, so that it can
-- never be recounted as a research lemma:  E_d <= E_0 r^d with r < 1 gives a
-- single constant bounding every partial sum of the differentiated source
-- energies, at every starting scale.
rowBEnergySummabilityChecked :
  (E : Nat → ℚ) (E₀ r Bud : ℚ) →
  0ℚ ≤ E₀ → 0ℚ ≤ r → r ≤ 1ℚ → 0ℚ ≤ Bud → (E₀ + r * Bud) ≤ Bud →
  (∀ d → 0ℚ ≤ E d) → (∀ d → E d ≤ E₀ * pow r d) →
  ∀ k n → prefixSum E k n ≤ Bud
rowBEnergySummabilityChecked = geometricEnergyPrefixBound

-- Row C's completion contract may not be met by the covariance-weighted
-- (BBD) inequality in place of the group Heat/Doob hypothesis: already in the
-- pointwise scalar reduction neither of the two criteria implies the other.
rowCCriteriaIndependentChecked :
  (∀ eta →
    Σ RowC.ScalarCurvatureDatum
      (λ d → RowC.BBDCondition d × ¬ (RowC.HessianDebtFloor eta d)))
  ×
  Σ RowC.ScalarCurvatureDatum
    (λ d →
      (∀ eta → 0ℚ ≤ eta → RowC.HessianDebtFloor eta d)
        × ¬ (RowC.BBDCondition d))
rowCCriteriaIndependentChecked =
  RowC.bbdDoesNotImplyHessianFloor , RowC.hessianFloorDoesNotImplyBBD

-- Row A's analytic compression: ONE package for the literal interaction
-- correction, beta_Int(g) = g F(g) with sup|F| <= M0 and sup|F'| <= M1 on the
-- tube plus a Gaussian derivative bound L_Z, produces BOTH row-A constants,
-- C = M0 and L = L_Z + M0 + gamma M1.  A2 and A3 are therefore one analytic
-- estimate, not two.
rowAUniformDerivativePackageChecked :
  (pkg : DerivPackage.UniformDerivativePackage) →
  ∀ g → 0ℚ ≤ g → g ≤ DerivPackage.UniformDerivativePackage.tubeCap pkg →
  (ℚ.∣ DerivPackage.Package.interactionBeta pkg g ∣
      ≤ DerivPackage.Package.interactionSlope pkg * g)
  × (ℚ.∣ DerivPackage.Package.betaDerivative pkg g ∣
      ≤ DerivPackage.Package.uniformDerivativeConstant pkg)
rowAUniformDerivativePackageChecked pkg g 0≤g g≤γ =
  DerivPackage.Package.interactionAbsLinear pkg g 0≤g g≤γ ,
  DerivPackage.Package.totalDerivativeBounded pkg g 0≤g g≤γ

-- Row A's Cauchy input: a single coefficient bound |a_n| R^n <= M0 on a disc
-- slightly larger than the tube caps every truncation of the function
-- majorant, uniformly in the truncation.
rowACauchyTubeSupChecked :
  (pkg : CauchyTube.CauchyTubePackage) →
  ∀ {g} → 0ℚ ≤ g →
  g ≤ CauchyTube.CauchyTubePackage.tubeRadius pkg →
  ∀ N →
  CauchyTube.Tube.seriesMajorant pkg g N ≤ CauchyTube.Tube.functionSup pkg
rowACauchyTubeSupChecked pkg = CauchyTube.Tube.seriesMajorantBound pkg

-- Row A's second producer route: bounds on the normalized interaction factor
-- (Z >= z0 > 0, |Z'| <= A g, |Z''| <= B g) give the linear interaction
-- constant C = B/z0 + A^2 gamma/z0^2 for the logarithmic second derivative.
rowALogHessianConstantChecked :
  (d : LogHessian.NormalizedInteractionData) →
  ∀ g → (0≤g : 0ℚ ≤ g) →
  (g≤γ : g ≤ LogHessian.NormalizedInteractionData.tubeCap d) →
  ℚ.∣ LogHessian.LogHessian.logHessian d g ∣
    ≤ LogHessian.NormalizedInteractionData.hessianConstant d * g
rowALogHessianConstantChecked d g 0≤g g≤γ =
  LogHessian.LogHessian.Point.logHessianBound d g 0≤g g≤γ

-- Row A in canonical form: the analytic package plus the two numerical gates
-- give a cutoff-uniform strict contraction of the shooting map.
rowAAnalyticGateClosureChecked :
  ∀ {cutoff} (t : AnalyticGates.AnalyticGateTrajectory cutoff) →
  ∀ K → K NatOrder.≤ cutoff →
  ShellMargin.sum₀ (AnalyticGates.Closure.sensitivity t) K < 1ℚ
rowAAnalyticGateClosureChecked t = AnalyticGates.Closure.contractionBelowOne t

-- Row A scoping: for ANY nonnegative analytic constants the two gates are
-- jointly satisfiable as soon as b_- > 0, so no numerical accident in M0, M1
-- or L_Z can obstruct row A; the obstruction is A1 (a positive Gaussian
-- floor) together with the literal trajectory's drift fitting the region.
rowAGatesSatisfiableChecked :
  ∀ b₋ M0 M1 LZ → 0ℚ < b₋ → 0ℚ ≤ M0 → 0ℚ ≤ M1 → 0ℚ ≤ LZ →
  Σ ℚ (λ γ → Σ ℚ (λ γt →
    (0ℚ < γ) × (0ℚ < γt)
    × (M0 * γ < b₋)
    × ((LZ + (M0 + γ * M1)) * γt < b₋ ℚ.- M0 * γ)))
rowAGatesSatisfiableChecked = GateRegion.gatesSatisfiable

