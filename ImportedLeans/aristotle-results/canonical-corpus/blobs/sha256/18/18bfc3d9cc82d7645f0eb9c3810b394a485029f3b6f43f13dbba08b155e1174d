negRestore0 = zer ∷ zer ∷ zer ∷ neg ∷ []

negRestore1 : ShiftContractState
negRestore1 = zer ∷ zer ∷ neg ∷ zer ∷ []

negRestore2 : ShiftContractState
negRestore2 = zer ∷ neg ∷ zer ∷ zer ∷ []

