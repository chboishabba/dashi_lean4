import Synthesis.MillenniumBSDCMSplitJacobiRealTrace
import Mathlib.NumberTheory.Zsqrtd.GaussianInt
import Mathlib.NumberTheory.JacobiSum.Basic
import Mathlib.Tactic

/-!
# The split mixed Jacobi sum is an actual Gaussian integer of norm p

For p ≡ 1 mod 4 the exact mixed Jacobi sum

  J = J(χ, χ²)

lies in the Z-algebra generated by i.  We avoid building a general equivalence
between that subalgebra and GaussianInt: a direct adjoin induction proves that
every element has the form a + b i with a,b ∈ Z.

The inverse-Jacobi identity and the already-proved conjugacy
`J(χ⁻¹,χ²)=conj J` then give J * conj J = p.  Hence a²+b²=p.

This pays the Gaussian-coordinate/norm part of the split-prime CM theorem.
The remaining sign information is exactly the primary-associate congruence.
-/

namespace Synthesis.Millennium.BSD

open Complex Algebra

theorem splitQuarticCharacter_pow_four_eq_one
    {p : ℕ} [Fact hp : p.Prime] (hmod : p % 4 = 1) :
    splitQuarticCharacter p hmod ^ 4 = 1 := by
  have h := pow_orderOf_eq_one (splitQuarticCharacter p hmod)
  simpa [splitQuarticCharacter_orderOf hmod] using h

theorem splitQuadraticShadow_pow_two_eq_one
    {p : ℕ} [Fact hp : p.Prime] (hmod : p % 4 = 1) :
    splitQuadraticShadow p hmod ^ 2 = 1 := by
  unfold splitQuadraticShadow
  rw [← pow_mul]
  simpa using splitQuarticCharacter_pow_four_eq_one hmod

theorem splitQuadraticShadow_pow_four_eq_one
    {p : ℕ} [Fact hp : p.Prime] (hmod : p % 4 = 1) :
    splitQuadraticShadow p hmod ^ 4 = 1 := by
  rw [show (4 : ℕ) = 2 * 2 by norm_num, pow_mul,
    splitQuadraticShadow_pow_two_eq_one hmod, one_pow]

theorem splitQuadraticShadow_inv_eq_self
    {p : ℕ} [Fact hp : p.Prime] (hmod : p % 4 = 1) :
    (splitQuadraticShadow p hmod)⁻¹ = splitQuadraticShadow p hmod := by
  apply inv_eq_iff_eq_inv.mpr
  apply eq_inv_of_mul_eq_one_right
  simpa [pow_two] using splitQuadraticShadow_pow_two_eq_one hmod

theorem splitQuadraticShadow_ne_one
    {p : ℕ} [Fact hp : p.Prime] (hmod : p % 4 = 1) :
    splitQuadraticShadow p hmod ≠ 1 := by
  rw [splitQuadraticShadow_eq_complexQuadraticChar hmod]
  apply complexQuadraticChar_ne_one
  omega

theorem splitQuartic_mul_shadow_ne_one
    {p : ℕ} [Fact hp : p.Prime] (hmod : p % 4 = 1) :
    splitQuarticCharacter p hmod * splitQuadraticShadow p hmod ≠ 1 := by
  rw [show splitQuadraticShadow p hmod = splitQuarticCharacter p hmod ^ 2 by rfl,
    ← pow_succ']
  simpa [splitQuarticCharacter_cube_eq_inv hmod] using
    splitQuarticCharacter_inv_ne_one hmod

theorem splitJacobiPlus_mul_star
    {p : ℕ} [Fact hp : p.Prime] (hmod : p % 4 = 1) :
    splitJacobiPlus p hmod * star (splitJacobiPlus p hmod) = (p : ℂ) := by
  have hchar : ringChar ℂ ≠ ringChar (ZMod p) := by
    simp [hp.out.ne_zero]
  have hprod := jacobiSum_mul_jacobiSum_inv
    (F := ZMod p) (F' := ℂ)
    hchar
    (splitQuarticCharacter_ne_one hmod)
    (splitQuadraticShadow_ne_one hmod)
    (splitQuartic_mul_shadow_ne_one hmod)
  change splitJacobiPlus p hmod *
      jacobiSum (splitQuarticCharacter p hmod)⁻¹
        (splitQuadraticShadow p hmod)⁻¹ = (p : ℂ) at hprod
  rw [splitQuadraticShadow_inv_eq_self hmod] at hprod
  rw [← splitJacobiMinus_eq_star_plus hmod]
  exact hprod

theorem normSq_splitJacobiPlus
    {p : ℕ} [Fact hp : p.Prime] (hmod : p % 4 = 1) :
    Complex.normSq (splitJacobiPlus p hmod) = p := by
  have h := splitJacobiPlus_mul_star hmod
  rw [Complex.mul_conj] at h
  exact_mod_cast congrArg Complex.re h

theorem exists_int_coords_of_mem_adjoin_I
    {z : ℂ} (hz : z ∈ Algebra.adjoin ℤ ({Complex.I} : Set ℂ)) :
    ∃ a b : ℤ, z = (a : ℂ) + (b : ℂ) * Complex.I := by
  induction hz using Algebra.adjoin_induction with
  | mem x hx =>
      have hxI : x = Complex.I := by simpa using hx
      subst x
      exact ⟨0, 1, by simp⟩
  | algebraMap r =>
      exact ⟨r, 0, by simp⟩
  | add x y hx hy ihx ihy =>
      rcases ihx with ⟨a,b,rfl⟩
      rcases ihy with ⟨c,d,rfl⟩
      exact ⟨a+c, b+d, by push_cast; ring⟩
  | mul x y hx hy ihx ihy =>
      rcases ihx with ⟨a,b,rfl⟩
      rcases ihy with ⟨c,d,rfl⟩
      exact ⟨a*c-b*d, a*d+b*c, by push_cast; rw [Complex.I_mul_I]; ring⟩

theorem splitJacobiPlus_mem_gaussian_adjoin
    {p : ℕ} [Fact hp : p.Prime] (hmod : p % 4 = 1) :
    splitJacobiPlus p hmod ∈
      Algebra.adjoin ℤ ({Complex.I} : Set ℂ) := by
  unfold splitJacobiPlus
  apply jacobiSum_mem_algebraAdjoin_of_pow_eq_one
    (n := 4)
    (splitQuarticCharacter_pow_four_eq_one hmod)
    (splitQuadraticShadow_pow_four_eq_one hmod)
    (four_dvd_prime_sub_one_of_mod_four_eq_one hmod)
    Complex.isPrimitiveRoot_I

theorem splitJacobiPlus_gaussian_coordinates
    {p : ℕ} [Fact hp : p.Prime] (hmod : p % 4 = 1) :
    ∃ a b : ℤ,
      splitJacobiPlus p hmod = (a : ℂ) + (b : ℂ) * Complex.I := by
  exact exists_int_coords_of_mem_adjoin_I
    (splitJacobiPlus_mem_gaussian_adjoin hmod)

theorem splitJacobiPlus_gaussian_norm_witness
    {p : ℕ} [Fact hp : p.Prime] (hmod : p % 4 = 1) :
    ∃ a b : ℤ,
      a ^ 2 + b ^ 2 = (p : ℤ) ∧
      splitJacobiPlus p hmod = (a : ℂ) + (b : ℂ) * Complex.I := by
  rcases splitJacobiPlus_gaussian_coordinates hmod with ⟨a,b,hJ⟩
  refine ⟨a,b,?_,hJ⟩
  have hnorm := normSq_splitJacobiPlus hmod
  rw [hJ] at hnorm
  have hre : (((a ^ 2 + b ^ 2 : ℤ) : ℝ)) = p := by
    simpa [Complex.normSq_apply] using hnorm
  exact_mod_cast hre

theorem split_frobeniusCoefficient_eq_neg_two_gaussian_re
    {p : ℕ} [Fact hp : p.Prime] (hmod : p % 4 = 1) :
    ∃ a b : ℤ,
      a ^ 2 + b ^ 2 = (p : ℤ) ∧
      frobeniusCoefficient p = -2 * a ∧
      splitJacobiPlus p hmod = (a : ℂ) + (b : ℂ) * Complex.I := by
  rcases splitJacobiPlus_gaussian_norm_witness hmod with ⟨a,b,hnorm,hJ⟩
  refine ⟨a,b,hnorm,?_,hJ⟩
  have htrace := split_frobeniusCoefficient_eq_neg_plus_star hmod
  rw [hJ] at htrace
  apply_fun Complex.re at htrace
  norm_num at htrace
  exact_mod_cast htrace

end Synthesis.Millennium.BSD
