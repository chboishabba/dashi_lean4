import Mathlib
import YangMills.CountableObservableDetermining
import YangMills.WilsonCountableToL2Density

open MeasureTheory

/-!
# Unified D/F2 Wilson source

One countable family of continuous Wilson/cylinder observables with injective
joint coordinate map now pays both sides of the merged D/F2 frontier:

* coordinatewise `tanh` gives the bounded measurable determining source used by
  the projective continuum-measure machinery;
* the unital algebra generated by the original Wilson functions is uniformly
  dense by Stone--Weierstrass and therefore dense in L2 of every finite weakly
  regular continuum law.

No second density or measure-determining hypothesis is introduced.
-/

namespace RequestProject.YangMills

namespace CountableWilsonDF2Source

/-- Continuity of every selected Wilson coordinate gives the measurable family required by D. -/
theorem wilson_measurable
    {Ω : Type*} [TopologicalSpace Ω] [MeasurableSpace Ω]
    [BorelSpace Ω]
    (source : CountableWilsonDF2Source Ω) :
    ∀ i, Measurable (fun x => source.wilson i x) := by
  intro i
  exact (source.wilson i).continuous.measurable

/-- The same countable injective Wilson family constructs the bounded determining D source. -/
noncomputable def determiningSource
    {Ω : Type*} [TopologicalSpace Ω] [MeasurableSpace Ω]
    [BorelSpace Ω] [StandardBorelSpace Ω]
    (source : CountableWilsonDF2Source Ω)
    (cutoffLaw : ℕ → ProbabilityMeasure Ω) :
    RealCountableObservableDeterminingSource Ω :=
  tanhDeterminingObservableSource
    cutoffLaw
    (fun i x => source.wilson i x)
    source.wilson_measurable
    source.coordinateMapInjective

/-- Exact D producer theorem for the transformed bounded Wilson coordinates. -/
theorem determining_producer_exists
    {Ω : Type*} [TopologicalSpace Ω] [MeasurableSpace Ω]
    [BorelSpace Ω] [StandardBorelSpace Ω]
    (source : CountableWilsonDF2Source Ω)
    (cutoffLaw : ℕ → ProbabilityMeasure Ω) :
    RealCountableObservableDeterminingSource.ProducerExists
      cutoffLaw (fun i x => Real.tanh (source.wilson i x)) := by
  exact tanh_determining_observable_producer_exists
    cutoffLaw
    (fun i x => source.wilson i x)
    source.wilson_measurable
    source.coordinateMapInjective

end CountableWilsonDF2Source

/--
Single physical existence proposition replacing the former separate D and F2
producer assumptions: choose a compact cylinder state space and a countable
continuous Wilson family whose coordinate map is injective.
-/
def UnifiedWilsonDF2ProducerExists
    (Ω : Type*) [TopologicalSpace Ω] : Prop :=
  Nonempty (CountableWilsonDF2Source Ω)

end RequestProject.YangMills
