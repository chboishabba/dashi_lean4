    mainAssoc : (n m l : ℕ) → assL n m l ≡ assR n m l
    mainAssoc zero m l = mainAssoc₀ₘₗ m l
    mainAssoc (suc n) zero l = assocₙ₀ₗ n l (mainAssoc n zero l)
    mainAssoc (suc n) (suc m) zero = assocₙₘ₀ n m (mainAssoc n (suc m) zero)
