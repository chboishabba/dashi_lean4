import Mathlib

/-!
# Hecke eigenvalues at 2 and 3

For a normalised Hecke eigenform of weight `k`, the eigenvalues `a n` of the Hecke operators
`T n` satisfy

* `a 1 = 1`,
* `a (m * n) = a m * a n` whenever `gcd m n = 1`,
* `a (p ^ (j + 2)) = a p * a (p ^ (j + 1)) - p ^ (k - 1) * a (p ^ j)` for every prime `p`.

We axiomatise exactly this data as `HeckeSystem` — no analysis, just the multiplicative
structure — and prove the "two operators are already a lot of information" statement: the two
eigenvalues `a 2` and `a 3` determine `a n` for every `3`-smooth `n = 2 ^ i * 3 ^ j`, i.e. on the
whole multiplicative semigroup generated by the first two primes, which contains
`1, 2, 3, 4, 6, 8, 9, 12, 16, 18, 24, 27, 36, …`.

The explicit low-degree formulas `a 6 = a 2 * a 3`, `a 4 = a 2 ^ 2 - 2 ^ (k-1)` and
`a 9 = a 3 ^ 2 - 3 ^ (k-1)` are recorded as well: `6` and `9`, the companions of `3`, are the
first two values that `T 2` and `T 3` produce for free.
-/

namespace Hecke23

variable {R : Type*} [CommRing R]

/-- The multiplicative structure of the Hecke eigenvalue system of a normalised eigenform of
weight `k`, over a commutative ring `R`. -/
structure HeckeSystem (k : ℕ) (a : ℕ → R) : Prop where
  /-- normalisation -/
  one : a 1 = 1
  /-- multiplicativity on coprime arguments -/
  mul_coprime : ∀ m n : ℕ, Nat.Coprime m n → a (m * n) = a m * a n
  /-- the recursion at prime powers -/
  prime_pow : ∀ p : ℕ, p.Prime → ∀ j : ℕ,
    a (p ^ (j + 2)) = a p * a (p ^ (j + 1)) - (p : R) ^ (k - 1) * a (p ^ j)

variable {k : ℕ} {a b : ℕ → R}

/-- The eigenvalue at `p ^ j` is a polynomial in the single eigenvalue `a p`: two systems that
agree at `p` agree at all powers of `p`. -/
theorem eq_on_prime_pow (ha : HeckeSystem k a) (hb : HeckeSystem k b)
    {p : ℕ} (hp : p.Prime) (hab : a p = b p) : ∀ j : ℕ, a (p ^ j) = b (p ^ j) := by
  intro j
  induction j using Nat.strong_induction_on with
  | _ j ih =>
    match j with
    | 0 => simpa using (ha.one.trans hb.one.symm)
    | 1 => simpa using hab
    | (n + 2) =>
        rw [ha.prime_pow p hp n, hb.prime_pow p hp n, hab,
          ih (n + 1) (by omega), ih n (by omega)]

/-- **`T 2` and `T 3` pin down the whole `3`-smooth part.**  Two Hecke systems of the same weight
with the same eigenvalues at `2` and at `3` agree at every `n = 2 ^ i * 3 ^ j`. -/
theorem eq_on_smooth (ha : HeckeSystem k a) (hb : HeckeSystem k b)
    (h2 : a 2 = b 2) (h3 : a 3 = b 3) (i j : ℕ) :
    a (2 ^ i * 3 ^ j) = b (2 ^ i * 3 ^ j) := by
  have hcop : Nat.Coprime (2 ^ i) (3 ^ j) :=
    Nat.Coprime.pow i j (by norm_num)
  rw [ha.mul_coprime _ _ hcop, hb.mul_coprime _ _ hcop,
    eq_on_prime_pow ha hb Nat.prime_two h2 i, eq_on_prime_pow ha hb Nat.prime_three h3 j]

/-- The `3`-smooth numbers: the multiplicative semigroup generated by the primes `2` and `3`. -/
def Smooth3 : Set ℕ := {n | ∃ i j : ℕ, n = 2 ^ i * 3 ^ j}

theorem eq_on_Smooth3 (ha : HeckeSystem k a) (hb : HeckeSystem k b)
    (h2 : a 2 = b 2) (h3 : a 3 = b 3) : Set.EqOn a b Smooth3 := by
  rintro n ⟨i, j, rfl⟩
  exact eq_on_smooth ha hb h2 h3 i j

/-- `6 = 2 · 3`: the eigenvalue at six is the product of the eigenvalues at two and three. -/
theorem a_six (ha : HeckeSystem k a) : a 6 = a 2 * a 3 := by
  have : (6 : ℕ) = 2 * 3 := by norm_num
  rw [this, ha.mul_coprime 2 3 (by decide)]

/-- `4 = 2 ^ 2`. -/
theorem a_four (ha : HeckeSystem k a) : a 4 = a 2 ^ 2 - (2 : R) ^ (k - 1) := by
  have h := ha.prime_pow 2 Nat.prime_two 0
  norm_num at h
  rw [h, ha.one]
  ring

/-- `9 = 3 ^ 2`: the third member of the trinity is already determined by `T 3`. -/
theorem a_nine (ha : HeckeSystem k a) : a 9 = a 3 ^ 2 - (3 : R) ^ (k - 1) := by
  have h := ha.prime_pow 3 Nat.prime_three 0
  norm_num at h
  rw [h, ha.one]
  ring

/-- **The axioms are not vacuous.**  The divisor-counting function `n ↦ d(n)` is a Hecke system
of weight `1` over any commutative ring (it is the eigenvalue system of the weight-`2` Eisenstein
family in disguise). -/
theorem heckeSystem_cardDivisors :
    HeckeSystem (R := R) 1 (fun n => (n.divisors.card : R)) := by
  have hcard : ∀ (p i : ℕ), p.Prime → (p ^ i).divisors.card = i + 1 := by
    intro p i hp
    rw [Nat.divisors_prime_pow hp, Finset.card_map, Finset.card_range]
  refine ⟨by simp, ?_, ?_⟩
  · intro m n h
    push_cast [h.card_divisors_mul]
    ring
  · intro p hp j
    have h1 : p.divisors.card = 2 := by simpa using hcard p 1 hp
    simp only [hcard p _ hp, h1, pow_zero, Nat.sub_self, one_mul]
    push_cast
    ring

/-- Every element of the trinity `{3, 6, 9}` is `3`-smooth, so `a 3, a 6, a 9` are all
determined by `a 2` and `a 3`. -/
theorem trinity_smooth : (3 : ℕ) ∈ Smooth3 ∧ (6 : ℕ) ∈ Smooth3 ∧ (9 : ℕ) ∈ Smooth3 :=
  ⟨⟨0, 1, by norm_num⟩, ⟨1, 1, by norm_num⟩, ⟨0, 2, by norm_num⟩⟩

end Hecke23
