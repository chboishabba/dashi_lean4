  = ·sucℤ (pos (suc x)) (min (pos y) (pos z)) ∙
    cong (_+ pos (suc x)) (·DistPosRMin (suc x) (pos y) (pos z)) ∙
    +DistLMin (pos (suc x) · pos y) (pos (suc x) · pos z) (pos (suc x)) ∙
    cong₂ min (sym (·sucℤ (pos (suc x)) (pos y)))
