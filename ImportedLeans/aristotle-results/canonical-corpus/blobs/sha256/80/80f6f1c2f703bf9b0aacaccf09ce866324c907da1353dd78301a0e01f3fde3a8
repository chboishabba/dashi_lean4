      CKMPredictionObservable

    authorityLabel :
      String

    recordedAsComparisonOnly :
      Bool

    recordedAsComparisonOnlyIsTrue :
      recordedAsComparisonOnly ≡ true

    derivedByCarrier :
      Bool

    derivedByCarrierIsFalse :
      derivedByCarrier ≡ false

open CKMComparisonTarget public

