namespace Wikidata
namespace BFO

/-! ## Two roots with one label -/

/-- The two Wikidata items labelled `entity` in the BFO mapping discussion. -/
inductive EntityRoot
  /-- `Q35120`, the broad Wikidata/OWL-root-facing item. -/
  | wikidataEntityQ35120
  /-- `Q136433660`, the BFO `Entity`-facing item. -/
  | bfoEntityQ136433660
  deriving DecidableEq, Repr, Inhabited

/-- The scope a root ranges over. -/
inductive RootScope
  /-- Everything Wikidata may describe. -/
  | wikidataUniverse
  /-- The BFO upper ontology. -/
  | bfoUpperOntology
  deriving DecidableEq, Repr, Inhabited

/-- The English label of a root: both are `entity`. -/
def rootLabel : EntityRoot → String
  | .wikidataEntityQ35120 => "entity"
  | .bfoEntityQ136433660 => "entity"

/-- The scope of a root. -/
def rootScope : EntityRoot → RootScope
  | .wikidataEntityQ35120 => .wikidataUniverse
  | .bfoEntityQ136433660 => .bfoUpperOntology

/-- The two roots carry the same label. -/
theorem labels_coincide :
    rootLabel .wikidataEntityQ35120 = rootLabel .bfoEntityQ136433660 := rfl

/-- The two roots carry different scopes. -/
theorem scopes_differ :
    rootScope .wikidataEntityQ35120 ≠ rootScope .bfoEntityQ136433660 := by decide

/-- **Labels do not determine scope.** No function of the English label alone
returns the scope of the root it labels. -/
theorem no_labelOnly_scope_decoder :
    ¬ ∃ decode : String → RootScope, ∀ r : EntityRoot, decode (rootLabel r) = rootScope r := by
  rintro ⟨decode, h⟩
  exact scopes_differ ((h .wikidataEntityQ35120).symm.trans
    (congrArg decode labels_coincide |>.trans (h .bfoEntityQ136433660)))

/-- The Qid of `Q35120`. -/
def q35120 : Qid := ⟨35120⟩
/-- The Qid of `Q136433660`. -/
def q136433660 : Qid := ⟨136433660⟩

/-! ## Mapping strength -/

/-- The link kinds the Wikidata BFO mapping surface keeps as separate columns. -/
inductive LinkKind
  /-- `P12602`, BFO class ID. -/
  | p12602BFOClassIdentifier
  /-- `P2888`, exact match. -/
  | p2888ExactMatch
  /-- `P1709`, equivalent class. -/
  | p1709EquivalentClass
  /-- `P279`, subclass of. -/
  | p279Subclass
  deriving DecidableEq, Repr, Inhabited

/-- Every link kind. -/
def allLinkKinds : List LinkKind :=
  [.p12602BFOClassIdentifier, .p2888ExactMatch, .p1709EquivalentClass, .p279Subclass]

theorem mem_allLinkKinds (k : LinkKind) : k ∈ allLinkKinds := by
  cases k <;> decide

/-- The inference languages a mapping edge might be asked to license. -/
inductive InferenceLanguage
  /-- Look the external identifier up. -/
  | identifierLookup
  /-- Exchange the item with another system as the same thing. -/
  | semanticInterchange
  /-- Treat the two classes as having the same extension. -/
  | classEquivalence
  /-- Reason along the subclass edge. -/
  | subclassReasoning
  /-- Carry a BFO disjointness axiom across the mapping. -/
  | disjointnessTransport
  deriving DecidableEq, Repr, Inhabited

/-- The inference language a link kind licenses on its own. -/
def language : LinkKind → InferenceLanguage
  | .p12602BFOClassIdentifier => .identifierLookup
  | .p2888ExactMatch => .semanticInterchange
  | .p1709EquivalentClass => .classEquivalence
  | .p279Subclass => .subclassReasoning

/-- Does this link kind license this inference language? -/
def licenses (k : LinkKind) (l : InferenceLanguage) : Bool := language k == l

/-- A link kind licenses exactly the language it is for. -/
theorem licenses_iff_language (k : LinkKind) (l : InferenceLanguage) :
    licenses k l = true ↔ language k = l := by
  simp [licenses]

/-- The BFO class identifier licenses an identifier lookup. -/
theorem p12602_licenses_identifierLookup :
    licenses .p12602BFOClassIdentifier .identifierLookup = true := rfl

/-- …and no semantic interchange. -/
theorem p12602_not_licenses_semanticInterchange :
    licenses .p12602BFOClassIdentifier .semanticInterchange = false := rfl

/-- An exact match is not an equivalent-class claim. -/
theorem p2888_not_licenses_classEquivalence :
    licenses .p2888ExactMatch .classEquivalence = false := rfl

/-- A subclass edge is not an exact match. -/
theorem p279_not_licenses_semanticInterchange :
    licenses .p279Subclass .semanticInterchange = false := rfl

/-- **No single link licenses disjointness transport.** -/
theorem no_link_licenses_disjointnessTransport (k : LinkKind) :
    licenses k .disjointnessTransport = false := by
  cases k <;> rfl

/-! ## The licence order -/

/-- `k` is at most as strong as `k'` when it licenses no more. -/
def LicenceLE (k k' : LinkKind) : Prop :=
  ∀ l : InferenceLanguage, licenses k l = true → licenses k' l = true

instance : DecidablePred (fun p : LinkKind × LinkKind => LicenceLE p.1 p.2) := fun p =>
  decidable_of_iff (∀ l ∈ [InferenceLanguage.identifierLookup, .semanticInterchange,
      .classEquivalence, .subclassReasoning, .disjointnessTransport],
        licenses p.1 l = true → licenses p.2 l = true) <| by
    constructor
    · intro h l hl; exact h l (by cases l <;> decide) hl
    · intro h l _ hl; exact h l hl

theorem licenceLE_refl (k : LinkKind) : LicenceLE k k := fun _ h => h

theorem licenceLE_trans {k k' k'' : LinkKind} (h₁ : LicenceLE k k') (h₂ : LicenceLE k' k'') :
    LicenceLE k k'' := fun l h => h₂ l (h₁ l h)

/-- **The licence order is equality**: a link kind is below another only if it
is that kind, so mapping strength is not one total order but a set of
incomparable, query-indexed columns. -/
theorem licenceLE_iff_eq (k k' : LinkKind) : LicenceLE k k' ↔ k = k' := by
  constructor
  · intro h
    have := h (language k) (by simp [licenses])
    rw [licenses_iff_language] at this
    cases k <;> cases k' <;> simp_all [language]
  · rintro rfl; exact licenceLE_refl k

/-- `P2888` and `P1709` are incomparable: the exact match supplies semantic
interchange and the equivalent class supplies class equivalence. -/
theorem incomparable_p2888_p1709 :
    ¬ LicenceLE .p2888ExactMatch .p1709EquivalentClass ∧
    ¬ LicenceLE .p1709EquivalentClass .p2888ExactMatch := by
  constructor <;> rw [licenceLE_iff_eq] <;> decide

/-- No link kind is a strongest one. -/
theorem no_top_link : ¬ ∃ k : LinkKind, ∀ k' : LinkKind, LicenceLE k' k := by
  rintro ⟨k, h⟩
  have h1 := (licenceLE_iff_eq _ k).1 (h .p2888ExactMatch)
  have h2 := (licenceLE_iff_eq _ k).1 (h .p1709EquivalentClass)
  rw [← h1] at h2
  exact absurd h2 (by decide)

/-! ## Composite mappings -/

/-- The languages licensed by a composite mapping — a list of the mapping edges
an item actually carries. -/
def compositeLicenses (ks : List LinkKind) (l : InferenceLanguage) : Bool :=
  ks.any (fun k => licenses k l)

/-- **Accumulating mapping edges accumulates licences.** Adding an edge never
withdraws an inference licence. -/
theorem compositeLicenses_mono {ks ks' : List LinkKind} (h : ∀ k ∈ ks, k ∈ ks')
    {l : InferenceLanguage} (hl : compositeLicenses ks l = true) :
    compositeLicenses ks' l = true := by
  simp only [compositeLicenses, List.any_eq_true] at hl ⊢
  obtain ⟨k, hk, hkl⟩ := hl
  exact ⟨k, h k hk, hkl⟩

/-- A composite licenses a language exactly when one of its edges does. -/
theorem compositeLicenses_iff (ks : List LinkKind) (l : InferenceLanguage) :
    compositeLicenses ks l = true ↔ ∃ k ∈ ks, language k = l := by
  simp [compositeLicenses, List.any_eq_true, licenses]

/-- **No composite of mapping edges licenses disjointness transport**, however
many edges it carries. -/
theorem composite_never_licenses_disjointnessTransport (ks : List LinkKind) :
    compositeLicenses ks .disjointnessTransport = false := by
  simp only [compositeLicenses, List.any_eq_false]
  intro k _
  simp [no_link_licenses_disjointnessTransport k]

/-- Even the full structural packet — all four mapping edges at once — is not a
full class-algebra licence. -/
theorem full_packet_not_full_licence :
    ¬ ∀ l : InferenceLanguage, compositeLicenses allLinkKinds l = true := by
  intro h
  have hd := h .disjointnessTransport
  rw [composite_never_licenses_disjointnessTransport] at hd
  exact Bool.noConfusion hd

/-- …though it does license every other language in the contract. -/
theorem full_packet_licenses_the_rest (l : InferenceLanguage)
    (h : l ≠ .disjointnessTransport) : compositeLicenses allLinkKinds l = true := by
  cases l <;> first | rfl | exact absurd rfl h

/-! ## What the graph engine reads

The licence above is a statement about property *types*.  The engine of
`RequestProject.Wikidata.Core` bears it out: in a knowledge base that carries a
`P279` edge and a `P2888` edge between the same pair of items, only the `P279`
edge produces a subclass entailment. -/

/-- `P2888`, exact match. -/
def P2888 : Pid := ⟨2888⟩
/-- `P1709`, equivalent class. -/
def P1709 : Pid := ⟨1709⟩
/-- `P12602`, BFO class ID. -/
def P12602 : Pid := ⟨12602⟩

/-- An illustrative pair of classes joined by an exact match rather than a
subclass edge. -/
def qLocalClass : Qid := ⟨1000001⟩
/-- The BFO class the local class is exact-matched to. -/
def qBFOClass : Qid := ⟨1000002⟩

/-- A knowledge base with the BFO root beneath the Wikidata root, and a local
class exact-matched (and equivalent-class linked) to a BFO class. -/
def bfoKB : KB where
  entities := [q35120, q136433660, qLocalClass, qBFOClass]
  statements :=
    [ { subject := q136433660, property := P279, value := q35120 },
      { subject := qLocalClass, property := P2888, value := qBFOClass },
      { subject := qLocalClass, property := P1709, value := qBFOClass } ]

/-- The subclass edge is read by the engine. -/
theorem bfoRoot_subclass_wikidataRoot : isSubclassOf bfoKB q136433660 q35120 = true := by
  decide

/-- **An exact match licenses no subclass entailment**: the engine does not
place the local class under the BFO class it is exact-matched to. -/
theorem exactMatch_gives_no_subclass_entailment :
    isSubclassOf bfoKB qLocalClass qBFOClass = false := by
  decide

/-- Nor does the equivalent-class edge make the two classes interchangeable for
the subclass engine in the other direction. -/
theorem equivalentClass_gives_no_subclass_entailment :
    isSubclassOf bfoKB qBFOClass qLocalClass = false := by
  decide

/-! ## BFO applicability as a fibre -/

/-- The level at which a membership question is being asked. -/
inductive InspectionLevel
  /-- Is it a Wikidata item at all? -/
  | wikidataEntityLevel
  /-- Is it a BFO `Entity`? -/
  | bfoEntityLevel
  /-- Which side of BFO's continuant/occurrent partition is it on? -/
  | bfoContinuantOccurrentLevel
  deriving DecidableEq, Repr, Inhabited

/-- The evaluation of a membership claim.  Refusing to answer, having no
derivation, and being out of scope are three different answers. -/
inductive ClaimEvaluation
  /-- A derivation supports the claim. -/
  | supportedYes
  /-- A derivation refutes the claim. -/
  | supportedNo
  /-- Nothing is derived either way. -/
  | notEstablished
  /-- The question is outside the ontology currently committed to. -/
  | outsideCommittedScope
  /-- Derivations disagree. -/
  | conflictingDerivations
  deriving DecidableEq, Repr, Inhabited

/-- The Boolean checker surface: only an affirmative derivation passes. -/
def checkerBit : ClaimEvaluation → Bool
  | .supportedYes => true
  | _ => false

/-- The four non-affirmative evaluations are pairwise distinct. -/
theorem negatives_pairwise_distinct :
    ClaimEvaluation.supportedNo ≠ .notEstablished ∧
    ClaimEvaluation.notEstablished ≠ .outsideCommittedScope ∧
    ClaimEvaluation.outsideCommittedScope ≠ .conflictingDerivations ∧
    ClaimEvaluation.supportedNo ≠ .conflictingDerivations := by
  refine ⟨by decide, by decide, by decide, by decide⟩

/-- …and they all present the same failing bit. -/
theorem negatives_share_the_bit (e : ClaimEvaluation) (h : e ≠ .supportedYes) :
    checkerBit e = false := by
  cases e <;> first | rfl | exact absurd rfl h

/-- **The checker bit has no exact decoder**: no function of the pass/fail bit
recovers the evaluation, so a Boolean checker cannot say why a BFO applicability
question failed. -/
theorem no_exact_evaluation_decoder :
    ¬ ∃ decode : Bool → ClaimEvaluation, ∀ e : ClaimEvaluation, decode (checkerBit e) = e := by
  rintro ⟨decode, h⟩
  have h₁ := h .supportedNo
  have h₂ := h .notEstablished
  rw [show checkerBit .supportedNo = checkerBit .notEstablished from rfl] at h₁
  exact absurd (h₁.symm.trans h₂) (by decide)

/-- An inspection of a referent at a level. -/
structure Inspection where
  /-- The thing being asked about. -/
  referent : String
  /-- The question being asked of it. -/
  level : InspectionLevel
  /-- The answer at that level. -/
  evaluation : ClaimEvaluation
  /-- Where the answer comes from. -/
  provenance : String
  deriving DecidableEq, Repr, Inhabited

/-- An illustrative referent inspected at the Wikidata level: it is an item. -/
def frodoAtWikidataLevel : Inspection where
  referent := "Frodo"
  level := .wikidataEntityLevel
  evaluation := .supportedYes
  provenance := "Wikidata-level membership question"

/-- The same referent at the BFO `Entity` level: nothing is derived. -/
def frodoAtBFOEntityLevel : Inspection where
  referent := "Frodo"
  level := .bfoEntityLevel
  evaluation := .notEstablished
  provenance := "BFO Entity interpretation left open"

/-- The same referent at BFO's continuant/occurrent partition: out of the
scope currently committed to. -/
def frodoAtPartitionLevel : Inspection where
  referent := "Frodo"
  level := .bfoContinuantOccurrentLevel
  evaluation := .outsideCommittedScope
  provenance := "partition question not committed to for this referent"

/-- The three inspections are of one referent. -/
theorem frodo_one_referent :
    frodoAtWikidataLevel.referent = frodoAtBFOEntityLevel.referent ∧
    frodoAtBFOEntityLevel.referent = frodoAtPartitionLevel.referent :=
  ⟨rfl, rfl⟩

/-- **An evaluation is not a function of the referent.** The same referent has
three different evaluations at three different levels, so BFO applicability is
a fibre over the Wikidata carrier rather than a property of the item. -/
theorem evaluation_not_function_of_referent :
    ¬ ∃ f : String → ClaimEvaluation,
        ∀ i : Inspection, i ∈ [frodoAtWikidataLevel, frodoAtBFOEntityLevel,
          frodoAtPartitionLevel] → f i.referent = i.evaluation := by
  rintro ⟨f, h⟩
  have h₁ := h frodoAtWikidataLevel (by simp)
  have h₂ := h frodoAtBFOEntityLevel (by simp)
  rw [show frodoAtWikidataLevel.referent = frodoAtBFOEntityLevel.referent from rfl] at h₁
  exact absurd (h₁.symm.trans h₂) (by decide)

/-- The level is recoverable from the inspection, and the three levels are
distinct, which is what makes the fibre non-trivial. -/
theorem frodo_levels_distinct :
    frodoAtWikidataLevel.level ≠ frodoAtBFOEntityLevel.level ∧
    frodoAtBFOEntityLevel.level ≠ frodoAtPartitionLevel.level := by
  refine ⟨by decide, by decide⟩

end BFO
end Wikidata
