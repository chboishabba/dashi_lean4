            have buf : String := ""
            have wc : Nat := 0
            if filesWritten ≥ budget then
                have truncated := true;
                pure (ForInStep.done ⟨buf, filesWritten, report, truncated, wc⟩)
              else do
                let y ← pure PUnit.unit
                __do_jp buf filesWritten report truncated wc y
          else do
            let y ← pure PUnit.unit
            __do_jp buf filesWritten report truncated wc y
    match r with
      | ⟨buf, filesWritten, report, truncated, wc⟩ =>
        have __do_jp := fun filesWritten report y =>
          have __do_jp := fun report y => pure (report, filesWritten);
          if truncated = true then
            have report :=
              report ++
                (toString "  WARNING: reached file budget for '" ++ toString filePrefix ++
                  toString "'; remaining blocks truncated.\n");
            do
            let y ← pure PUnit.unit
            __do_jp report y
          else do
            let y ← pure PUnit.unit
            __do_jp report y;
        if (!truncated && !buf.isEmpty && decide (filesWritten < budget)) = true then
