/-
# Hypercubic (finite Euclidean) symmetry of the Wilson–Gibbs measure

`RequestProject.YangMills.Lattice.Wilson` constructs the literal Wilson–Gibbs
probability measure of a four-dimensional periodic lattice gauge theory and
proves that it is invariant under gauge transformations and under lattice
translations.  This file completes the finite Euclidean symmetry group of the
lattice: the *hypercubic point group*, generated by

* permutations of the four coordinate axes (`rotate`), and
* reflections in a coordinate hyperplane (`reflect`),

together with the translations already available.  For each of them we prove,
with no extra hypothesis beyond conjugation invariance of the character,

* invariance of the literal Wilson action (`wilsonAction_rotate`,
  `wilsonAction_reflect`),
* preservation of the product Haar measure on configurations
  (`measurePreserving_rotate`, `measurePreserving_reflectConf`), and hence
* preservation of the Wilson–Gibbs measure itself
  (`measurePreserving_rotate_gibbs`, `measurePreserving_reflect_gibbs`),
* invariance of every finite-volume expectation
  (`integral_rotate_gibbs`, `integral_reflect_gibbs`,
  `integral_translate_gibbs`).

Two points deserve emphasis.

*Reflections are not a relabelling of the links.*  A reflection reverses every
link pointing in the reflected direction, so the configuration must be
transported by the group inverse on those links.  That the product Haar measure
survives this is the inverse invariance of Haar measure on a compact group,
proved here (`haarProb.isInvInvariant`) from uniqueness of the Haar probability
measure rather than assumed.

*No reality assumption on the character is used.*  Under a reflection a
plaquette in a plane containing the reflected direction is mapped to the
*conjugate of the oppositely oriented plaquette* in the same plane.  Since the
Wilson action sums over ordered pairs of directions, the two orientations occur
together, and the reflected sum is a permutation of the original one; this is
the involution `orientationSwap`.  Consequently only conjugation invariance of
the character is needed, exactly as for gauge invariance.

Finally `expectation_bosonic_permutation` records the finite bosonic
(permutation) symmetry of the Schwinger functions of the lattice theory.
-/
import Mathlib
import RequestProject.YangMills.Lattice.Wilson

namespace RequestProject.YangMills.Lattice

open MeasureTheory

/-! ## Inverse invariance of the normalised Haar measure -/

instance haarProb.isInvInvariant (G : Type*) [Group G] [TopologicalSpace G]
    [IsTopologicalGroup G] [CompactSpace G] [T2Space G] [MeasurableSpace G] [BorelSpace G] :
    (haarProb G).IsInvInvariant := by
  constructor
  haveI : IsProbabilityMeasure ((haarProb G).inv) := by
    constructor
    rw [Measure.inv, Measure.map_apply measurable_inv MeasurableSet.univ]
    simp
  haveI : ((haarProb G).inv).IsHaarMeasure := by constructor
  exact Measure.isHaarMeasure_eq_of_isProbabilityMeasure _ _

variable {G : Type*} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
  [CompactSpace G] [T2Space G] [MeasurableSpace G] [BorelSpace G]
  [SecondCountableTopology G]

variable {n : ℕ}

/-! ## Permutations of the coordinate axes -/

/-- Relabelling of the coordinate axes of the lattice by a permutation. -/
def rotSite (sig : Equiv.Perm (Fin 4)) (x : Site n) : Site n := fun d => x (sig.symm d)

omit [TopologicalSpace G] [IsTopologicalGroup G] [CompactSpace G] [T2Space G]
  [MeasurableSpace G] [BorelSpace G] [SecondCountableTopology G] in
theorem rotSite_add (sig : Equiv.Perm (Fin 4)) (x y : Site n) :
    rotSite sig (x + y) = rotSite sig x + rotSite sig y := rfl

theorem rotSite_unitVec (sig : Equiv.Perm (Fin 4)) (d : Fin 4) :
    rotSite sig (unitVec n d) = unitVec n (sig d) := by
  funext e
  simp only [rotSite, unitVec, Pi.single_apply]
  by_cases h : e = sig d
  · subst h; simp
  · have h2 : ¬ (sig.symm e = d) := fun hh => h (by rw [← hh]; simp)
    simp [h, h2]

theorem rotSite_leftInverse (sig : Equiv.Perm (Fin 4)) (x : Site n) :
    rotSite sig.symm (rotSite sig x) = x := by funext d; simp [rotSite]

/-- The axis permutation `sig` acting on lattice sites, as an equivalence. -/
def rotSiteEquiv (sig : Equiv.Perm (Fin 4)) : Equiv.Perm (Site n) where
  toFun := rotSite sig
  invFun := rotSite sig.symm
  left_inv := rotSite_leftInverse sig
  right_inv := fun x => by simpa using rotSite_leftInverse sig.symm x

/-- The action of an axis permutation on gauge configurations. -/
def rotate (sig : Equiv.Perm (Fin 4)) (U : Conf n G) : Conf n G :=
  fun l => U (rotSite sig.symm l.1, sig.symm l.2)

omit [TopologicalSpace G] [IsTopologicalGroup G] [CompactSpace G] [T2Space G]
  [MeasurableSpace G] [BorelSpace G] [SecondCountableTopology G] in
/-- An axis permutation carries plaquettes to plaquettes. -/
theorem plaqHol_rotate (sig : Equiv.Perm (Fin 4)) (U : Conf n G) (x : Site n) (mu nu : Fin 4) :
    plaqHol (rotate sig U) x mu nu
      = plaqHol U (rotSite sig.symm x) (sig.symm mu) (sig.symm nu) := by
  simp only [plaqHol, rotate, rotSite_add, rotSite_unitVec]

omit [TopologicalSpace G] [IsTopologicalGroup G] [CompactSpace G] [T2Space G]
  [MeasurableSpace G] [BorelSpace G] [SecondCountableTopology G] in
/-- **Invariance of the Wilson action under permutations of the coordinate
axes.** -/
theorem wilsonAction_rotate (beta : ℝ) (chi : G → ℝ) (sig : Equiv.Perm (Fin 4)) (U : Conf n G) :
    wilsonAction beta chi (rotate sig U) = wilsonAction beta chi U := by
  unfold wilsonAction
  congr 1
  calc ∑ x : Site n, ∑ mu : Fin 4, ∑ nu : Fin 4, chi (plaqHol (rotate sig U) x mu nu)
      = ∑ x : Site n, ∑ mu : Fin 4, ∑ nu : Fin 4,
          chi (plaqHol U (rotSite sig.symm x) (sig.symm mu) (sig.symm nu)) := by
        refine Finset.sum_congr rfl fun x _ => Finset.sum_congr rfl fun mu _ =>
          Finset.sum_congr rfl fun nu _ => ?_
        rw [plaqHol_rotate]
    _ = ∑ x : Site n, ∑ mu : Fin 4, ∑ nu : Fin 4,
          chi (plaqHol U (rotSite sig.symm x) (sig.symm mu) nu) :=
        Finset.sum_congr rfl fun x _ => Finset.sum_congr rfl fun mu _ =>
          Equiv.sum_comp sig.symm fun nu => chi (plaqHol U (rotSite sig.symm x) (sig.symm mu) nu)
    _ = ∑ x : Site n, ∑ mu : Fin 4, ∑ nu : Fin 4,
          chi (plaqHol U (rotSite sig.symm x) mu nu) :=
        Finset.sum_congr rfl fun x _ =>
          Equiv.sum_comp sig.symm fun mu =>
            ∑ nu : Fin 4, chi (plaqHol U (rotSite sig.symm x) mu nu)
    _ = ∑ x : Site n, ∑ mu : Fin 4, ∑ nu : Fin 4, chi (plaqHol U x mu nu) :=
        Equiv.sum_comp (rotSiteEquiv (n := n) sig.symm)
          fun x => ∑ mu : Fin 4, ∑ nu : Fin 4, chi (plaqHol U x mu nu)

omit [SecondCountableTopology G] in
/-- Axis permutations preserve the product Haar measure on configurations. -/
theorem measurePreserving_rotate (sig : Equiv.Perm (Fin 4)) :
    MeasurePreserving (rotate (G := G) (n := n) sig) (prodHaar (Link n) G)
      (prodHaar (Link n) G) :=
  measurePreserving_reindex (G := G)
    (e := (Equiv.prodCongr (rotSiteEquiv (n := n) sig.symm) sig.symm : Equiv.Perm (Link n)))

/-- **The Wilson–Gibbs measure is invariant under permutations of the coordinate
axes.** -/
theorem measurePreserving_rotate_gibbs {chi : G → ℝ} (hchi : Continuous chi) (beta : ℝ)
    (sig : Equiv.Perm (Fin 4)) :
    MeasurePreserving (rotate (G := G) (n := n) sig) (gibbs n G beta chi) (gibbs n G beta chi) :=
  measurePreserving_scaled
    (measurePreserving_withDensity (measurePreserving_rotate sig)
      (measurable_gibbsDensity hchi beta)
      (fun U => by simp [gibbsDensity, wilsonAction_rotate beta chi sig U])) _

/-! ## Two elementary facts about plaquettes -/

omit [TopologicalSpace G] [IsTopologicalGroup G] [CompactSpace G] [T2Space G]
  [MeasurableSpace G] [BorelSpace G] [SecondCountableTopology G] in
/-- A degenerate plaquette is trivial. -/
theorem plaqHol_self (U : Conf n G) (x : Site n) (mu : Fin 4) : plaqHol U x mu mu = 1 := by
  simp [plaqHol]

omit [TopologicalSpace G] [IsTopologicalGroup G] [CompactSpace G] [T2Space G]
  [MeasurableSpace G] [BorelSpace G] [SecondCountableTopology G] in
/-- Reversing the orientation of a plaquette inverts its holonomy. -/
theorem plaqHol_swap (U : Conf n G) (x : Site n) (mu nu : Fin 4) :
    plaqHol U x nu mu = (plaqHol U x mu nu)⁻¹ := by
  simp only [plaqHol, mul_inv_rev, inv_inv]
  group

/-! ## Reflections in a coordinate hyperplane -/

/-- Reflection of a lattice site in the hyperplane orthogonal to `d0`. -/
def refSite (d0 : Fin 4) (x : Site n) : Site n := Function.update x d0 (-(x d0))

theorem refSite_refSite (d0 : Fin 4) (x : Site n) : refSite d0 (refSite d0 x) = x := by
  funext d; by_cases h : d = d0 <;> simp [refSite, Function.update_apply, h]

/-- The reflection of sites as an involutive equivalence. -/
def refSiteEquiv (d0 : Fin 4) : Equiv.Perm (Site n) :=
  Function.Involutive.toPerm (refSite d0) (refSite_refSite d0)

theorem refSite_add (d0 : Fin 4) (x y : Site n) :
    refSite d0 (x + y) = refSite d0 x + refSite d0 y := by
  funext d
  by_cases h : d = d0
  · subst h; simp only [refSite, Function.update_self, Pi.add_apply]; ring
  · simp [refSite, h]

theorem refSite_neg (d0 : Fin 4) (x : Site n) : refSite d0 (-x) = -(refSite d0 x) := by
  funext d
  by_cases h : d = d0
  · subst h; simp [refSite]
  · simp [refSite, h]

theorem refSite_sub (d0 : Fin 4) (x y : Site n) :
    refSite d0 (x - y) = refSite d0 x - refSite d0 y := by
  rw [sub_eq_add_neg, refSite_add, refSite_neg, ← sub_eq_add_neg]

theorem refSite_unitVec_ne {d0 d : Fin 4} (h : d ≠ d0) :
    refSite d0 (unitVec n d) = unitVec n d := by
  funext e
  by_cases he : e = d0
  · subst he; simp [refSite, unitVec, Ne.symm h]
  · simp [refSite, he]

theorem refSite_unitVec_self (d0 : Fin 4) :
    refSite d0 (unitVec n d0) = -unitVec n d0 := by
  funext e
  by_cases he : e = d0
  · subst he; simp [refSite, unitVec]
  · simp [refSite, he, unitVec]

theorem refSite_add_unitVec_ne {d0 d : Fin 4} (h : d ≠ d0) (x : Site n) :
    refSite d0 (x + unitVec n d) = refSite d0 x + unitVec n d := by
  rw [refSite_add, refSite_unitVec_ne h]

theorem refSite_add_unitVec_self (d0 : Fin 4) (x : Site n) :
    refSite d0 (x + unitVec n d0) = refSite d0 x - unitVec n d0 := by
  rw [refSite_add, refSite_unitVec_self]; ring

/-- The site map `x ↦ refSite d0 x - d̂0` appearing in the reflection of a link
pointing in the reflected direction, as an equivalence. -/
def refShiftEquiv (d0 : Fin 4) : Equiv.Perm (Site n) :=
  (refSiteEquiv d0).trans (Equiv.subRight (unitVec n d0))

/-- The action of the reflection in the hyperplane orthogonal to `d0` on gauge
configurations: links transverse to `d0` are relabelled, while a link in the
direction `d0` is reversed, so its parallel transport is inverted. -/
def reflect (d0 : Fin 4) (U : Conf n G) : Conf n G :=
  fun l => if l.2 = d0 then (U (refSite d0 l.1 - unitVec n d0, d0))⁻¹
           else U (refSite d0 l.1, l.2)

omit [TopologicalSpace G] [IsTopologicalGroup G] [CompactSpace G] [T2Space G]
  [MeasurableSpace G] [BorelSpace G] [SecondCountableTopology G] in
/-- A plaquette in a plane transverse to the reflected direction is carried to
the reflected plaquette. -/
theorem plaqHol_reflect_transverse {d0 mu nu : Fin 4} (hmu : mu ≠ d0) (hnu : nu ≠ d0)
    (U : Conf n G) (x : Site n) :
    plaqHol (reflect d0 U) x mu nu = plaqHol U (refSite d0 x) mu nu := by
  simp only [plaqHol, reflect, if_neg hmu, if_neg hnu, refSite_add_unitVec_ne hmu,
    refSite_add_unitVec_ne hnu]

omit [TopologicalSpace G] [IsTopologicalGroup G] [CompactSpace G] [T2Space G]
  [MeasurableSpace G] [BorelSpace G] [SecondCountableTopology G] in
/-- A plaquette in a plane containing the reflected direction is carried to a
conjugate of the *oppositely oriented* reflected plaquette. -/
theorem plaqHol_reflect_right {d0 mu : Fin 4} (hmu : mu ≠ d0) (U : Conf n G) (x : Site n) :
    plaqHol (reflect d0 U) x mu d0
      = (U (refSite d0 x - unitVec n d0, d0))⁻¹
        * plaqHol U (refSite d0 x - unitVec n d0) d0 mu
        * U (refSite d0 x - unitVec n d0, d0) := by
  have h1 : refSite d0 (x + unitVec n mu) - unitVec n d0
      = (refSite d0 x - unitVec n d0) + unitVec n mu := by
    rw [refSite_add_unitVec_ne hmu]; ring
  have h2 : refSite d0 (x + unitVec n d0) = refSite d0 x - unitVec n d0 :=
    refSite_add_unitVec_self d0 x
  have h3 : refSite d0 x - unitVec n d0 + unitVec n d0 = refSite d0 x := by ring
  simp only [plaqHol, reflect, if_neg hmu, h1, h2, h3, if_true]
  group

omit [TopologicalSpace G] [IsTopologicalGroup G] [CompactSpace G] [T2Space G]
  [MeasurableSpace G] [BorelSpace G] [SecondCountableTopology G] in
theorem plaqHol_reflect_left {d0 nu : Fin 4} (hnu : nu ≠ d0) (U : Conf n G) (x : Site n) :
    plaqHol (reflect d0 U) x d0 nu
      = (U (refSite d0 x - unitVec n d0, d0))⁻¹
        * plaqHol U (refSite d0 x - unitVec n d0) nu d0
        * U (refSite d0 x - unitVec n d0, d0) := by
  rw [plaqHol_swap, plaqHol_reflect_right hnu, mul_inv_rev, mul_inv_rev, inv_inv,
    ← plaqHol_swap]
  group

/-- The involution of ordered pairs of directions which swaps the two
orientations of a plane exactly when the plane contains the reflected
direction. -/
def orientationSwap (d0 : Fin 4) (p : Fin 4 × Fin 4) : Fin 4 × Fin 4 :=
  if p.1 = d0 then (if p.2 = d0 then p else (p.2, p.1))
  else (if p.2 = d0 then (p.2, p.1) else p)

theorem orientationSwap_involutive (d0 : Fin 4) :
    Function.Involutive (orientationSwap d0) := by
  rintro ⟨a, b⟩
  by_cases h1 : a = d0 <;> by_cases h2 : b = d0 <;> simp [orientationSwap, h1, h2]

/-- The orientation swap as a permutation of ordered pairs of directions. -/
def orientationSwapEquiv (d0 : Fin 4) : Equiv.Perm (Fin 4 × Fin 4) :=
  Function.Involutive.toPerm _ (orientationSwap_involutive d0)

omit [TopologicalSpace G] [IsTopologicalGroup G] [CompactSpace G] [T2Space G]
  [MeasurableSpace G] [BorelSpace G] [SecondCountableTopology G] in
/-- For each ordered pair of directions the reflected plaquette sum over the
lattice equals the original plaquette sum for the pair produced by the
orientation swap. -/
theorem sum_chi_plaqHol_reflect {chi : G → ℝ} (hconj : ∀ a g : G, chi (a * g * a⁻¹) = chi g)
    (d0 : Fin 4) (U : Conf n G) (p : Fin 4 × Fin 4) :
    ∑ x : Site n, chi (plaqHol (reflect d0 U) x p.1 p.2)
      = ∑ x : Site n, chi (plaqHol U x (orientationSwap d0 p).1 (orientationSwap d0 p).2) := by
  obtain ⟨mu, nu⟩ := p
  have hconj' : ∀ (a g : G), chi (a⁻¹ * g * a) = chi g := by
    intro a g
    simpa using hconj a⁻¹ g
  show ∑ x : Site n, chi (plaqHol (reflect d0 U) x mu nu)
      = ∑ x : Site n, chi (plaqHol U x (orientationSwap d0 (mu, nu)).1
          (orientationSwap d0 (mu, nu)).2)
  rcases eq_or_ne mu d0 with hmu | hmu
  · rcases eq_or_ne nu d0 with hnu | hnu
    · have hos : orientationSwap d0 (mu, nu) = (mu, nu) := by
        simp [orientationSwap, hmu, hnu]
      rw [hos]
      refine Finset.sum_congr rfl fun x _ => ?_
      rw [hmu, hnu, plaqHol_self, plaqHol_self]
    · have hos : orientationSwap d0 (mu, nu) = (nu, mu) := by
        simp [orientationSwap, hmu, hnu]
      rw [hos, hmu]
      refine Fintype.sum_equiv (refShiftEquiv (n := n) d0) _ _ fun x => ?_
      rw [plaqHol_reflect_left hnu, hconj']
      simp [refShiftEquiv, refSiteEquiv]
  · rcases eq_or_ne nu d0 with hnu | hnu
    · have hos : orientationSwap d0 (mu, nu) = (nu, mu) := by
        simp [orientationSwap, hmu, hnu]
      rw [hos, hnu]
      refine Fintype.sum_equiv (refShiftEquiv (n := n) d0) _ _ fun x => ?_
      rw [plaqHol_reflect_right hmu, hconj']
      simp [refShiftEquiv, refSiteEquiv]
    · have hos : orientationSwap d0 (mu, nu) = (mu, nu) := by
        simp [orientationSwap, hmu, hnu]
      rw [hos]
      refine Fintype.sum_equiv (refSiteEquiv (n := n) d0) _ _ fun x => ?_
      rw [plaqHol_reflect_transverse hmu hnu]
      simp [refSiteEquiv]

omit [TopologicalSpace G] [IsTopologicalGroup G] [CompactSpace G] [T2Space G]
  [MeasurableSpace G] [BorelSpace G] [SecondCountableTopology G] in
/-- **Invariance of the Wilson action under a reflection in a coordinate
hyperplane**, for any conjugation-invariant character. -/
theorem wilsonAction_reflect {chi : G → ℝ} (hconj : ∀ a g : G, chi (a * g * a⁻¹) = chi g)
    (beta : ℝ) (d0 : Fin 4) (U : Conf n G) :
    wilsonAction beta chi (reflect d0 U) = wilsonAction beta chi U := by
  unfold wilsonAction
  congr 1
  have hcomm : ∀ V : Conf n G,
      ∑ x : Site n, ∑ mu : Fin 4, ∑ nu : Fin 4, chi (plaqHol V x mu nu)
        = ∑ p : Fin 4 × Fin 4, ∑ x : Site n, chi (plaqHol V x p.1 p.2) := by
    intro V
    rw [Fintype.sum_prod_type]
    rw [Finset.sum_comm]
    exact Finset.sum_congr rfl fun mu _ => Finset.sum_comm
  rw [hcomm, hcomm]
  calc ∑ p : Fin 4 × Fin 4, ∑ x : Site n, chi (plaqHol (reflect d0 U) x p.1 p.2)
      = ∑ p : Fin 4 × Fin 4, ∑ x : Site n,
          chi (plaqHol U x (orientationSwap d0 p).1 (orientationSwap d0 p).2) :=
        Finset.sum_congr rfl fun p _ => sum_chi_plaqHol_reflect hconj d0 U p
    _ = ∑ p : Fin 4 × Fin 4, ∑ x : Site n, chi (plaqHol U x p.1 p.2) :=
        Equiv.sum_comp (orientationSwapEquiv d0)
          fun p => ∑ x : Site n, chi (plaqHol U x p.1 p.2)

omit [SecondCountableTopology G] in
/-- Reflections preserve the product Haar measure on configurations: the link
relabelling is a permutation of the links, and the inversion of the reversed
link variables preserves the Haar measure of the gauge group. -/
theorem measurePreserving_reflectConf (d0 : Fin 4) :
    MeasurePreserving (reflect (G := G) (n := n) d0) (prodHaar (Link n) G)
      (prodHaar (Link n) G) := by
  -- the relabelling of the links
  have hinvol : Function.Involutive
      (fun l : Link n => ((if l.2 = d0 then refSite d0 l.1 - unitVec n d0 else refSite d0 l.1),
        l.2)) := by
    rintro ⟨y, mu⟩
    have key : refSite d0 (refSite d0 y - unitVec n d0) - unitVec n d0 = y := by
      rw [refSite_sub, refSite_refSite, refSite_unitVec_self]
      ring
    by_cases h : mu = d0
    · simp [h, key]
    · simp [h, refSite_refSite]
  set e : Equiv.Perm (Link n) := Function.Involutive.toPerm _ hinvol with he
  have hreindex : MeasurePreserving (fun (U : Conf n G) => fun l => U (e l))
      (prodHaar (Link n) G) (prodHaar (Link n) G) := measurePreserving_reindex (G := G) e
  -- the inversion of the reversed link variables
  have hinv : MeasurePreserving
      (fun (V : Conf n G) => fun l => (if l.2 = d0 then (V l)⁻¹ else V l))
      (prodHaar (Link n) G) (prodHaar (Link n) G) := by
    have := measurePreserving_pi (fun _ : Link n => haarProb G) (fun _ : Link n => haarProb G)
      (f := fun l : Link n => fun u : G => if l.2 = d0 then u⁻¹ else u)
      (fun l => by
        by_cases h : l.2 = d0
        · simpa [h] using Measure.measurePreserving_inv (haarProb G)
        · simpa [h] using MeasurePreserving.id (haarProb G))
    exact this
  have hcomp := hinv.comp hreindex
  have : (fun (V : Conf n G) => fun l => (if l.2 = d0 then (V l)⁻¹ else V l)) ∘
      (fun (U : Conf n G) => fun l => U (e l)) = reflect (G := G) (n := n) d0 := by
    funext U l
    by_cases h : l.2 = d0
    · simp [reflect, h, he, Function.Involutive.toPerm]
    · simp [reflect, h, he, Function.Involutive.toPerm]
  rwa [this] at hcomp

/-- **The Wilson–Gibbs measure is invariant under reflections in a coordinate
hyperplane.** -/
theorem measurePreserving_reflect_gibbs {chi : G → ℝ} (hchi : Continuous chi)
    (hconj : ∀ a g : G, chi (a * g * a⁻¹) = chi g) (beta : ℝ) (d0 : Fin 4) :
    MeasurePreserving (reflect (G := G) (n := n) d0) (gibbs n G beta chi) (gibbs n G beta chi) :=
  measurePreserving_scaled
    (measurePreserving_withDensity (measurePreserving_reflectConf d0)
      (measurable_gibbsDensity hchi beta)
      (fun U => by simp [gibbsDensity, wilsonAction_reflect hconj beta d0 U])) _

/-! ## Invariance of the finite-volume expectations -/

/-- A measure-preserving self-map leaves every expectation unchanged. -/
theorem integral_comp_measurePreserving {X : Type*} [MeasurableSpace X] {E : Type*}
    [NormedAddCommGroup E] [NormedSpace ℝ E] {mu : Measure X}
    {Phi : X → X} (hPhi : MeasurePreserving Phi mu mu) {f : X → E}
    (hf : AEStronglyMeasurable f mu) :
    ∫ x, f (Phi x) ∂mu = ∫ x, f x ∂mu := by
  conv_rhs => rw [← hPhi.map_eq]
  exact (integral_map hPhi.measurable.aemeasurable (by rwa [hPhi.map_eq])).symm

/-- **OS1 at finite volume, rotations**: every integrable observable has the
same Wilson expectation as its rotate. -/
theorem integral_rotate_gibbs {chi : G → ℝ} (hchi : Continuous chi) (beta : ℝ)
    (sig : Equiv.Perm (Fin 4)) {f : Conf n G → ℝ}
    (hf : AEStronglyMeasurable f (gibbs n G beta chi)) :
    ∫ U, f (rotate sig U) ∂(gibbs n G beta chi) = ∫ U, f U ∂(gibbs n G beta chi) :=
  integral_comp_measurePreserving (measurePreserving_rotate_gibbs hchi beta sig) hf

/-- **OS1 at finite volume, reflections**: every integrable observable has the
same Wilson expectation as its reflection. -/
theorem integral_reflect_gibbs {chi : G → ℝ} (hchi : Continuous chi)
    (hconj : ∀ a g : G, chi (a * g * a⁻¹) = chi g) (beta : ℝ) (d0 : Fin 4)
    {f : Conf n G → ℝ} (hf : AEStronglyMeasurable f (gibbs n G beta chi)) :
    ∫ U, f (reflect d0 U) ∂(gibbs n G beta chi) = ∫ U, f U ∂(gibbs n G beta chi) :=
  integral_comp_measurePreserving (measurePreserving_reflect_gibbs hchi hconj beta d0) hf

/-- **OS1 at finite volume, translations**. -/
theorem integral_translate_gibbs {chi : G → ℝ} (hchi : Continuous chi) (beta : ℝ)
    (v : Site n) {f : Conf n G → ℝ} (hf : AEStronglyMeasurable f (gibbs n G beta chi)) :
    ∫ U, f (translate v U) ∂(gibbs n G beta chi) = ∫ U, f U ∂(gibbs n G beta chi) :=
  integral_comp_measurePreserving (measurePreserving_translate_gibbs hchi beta v) hf

/-- **Finite bosonic (permutation) symmetry of the lattice Schwinger
functions**: the expectation of a product of observables does not depend on the
order in which they are listed. -/
theorem expectation_bosonic_permutation {chi : G → ℝ} (beta : ℝ) {m : ℕ}
    (obs : Fin m → Conf n G → ℝ) (pi : Equiv.Perm (Fin m)) :
    ∫ U, (∏ i, obs (pi i) U) ∂(gibbs n G beta chi)
      = ∫ U, (∏ i, obs i U) ∂(gibbs n G beta chi) := by
  congr 1
  funext U
  exact Equiv.prod_comp pi fun i => obs i U

