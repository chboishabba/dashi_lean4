  (board : W7ClaimGovernanceCurrentGateBoard) : Set where
  field
    w9Closed :
      GateReport.status (W7ClaimGovernanceCurrentGateBoard.w9 board)
      ≡
      gateClosed

    w2Closed :
      GateReport.status (W7ClaimGovernanceCurrentGateBoard.w2 board)
      ≡
      gateClosed

