import RequestProject.Wikidata.ClassAlgebra

/-!
# Cross-ontology alignment

A (partial) mapping of the classes of one knowledge base into another, with
executable checks for *subclass preservation* and *disjointness reflection*, and
exactness theorems for both.

Alignment is the surface on which cross-ontology comparison happens.  A failed
alignment check is a certified negative fact about the mapping (`alignOk = false`
is decidable and provable), which is exactly what distinguishes it from a merely
missing mapping — see `RequestProject.Epistemic.Bridge`.
-/

/-! ### Provenance (generated by `tools/provenance.py`)

Source mix of this module's 10 declarations: 2 traced to the DASHI Agda
bridge (`chboishabba/dashi_agda` PR #555 / #581), 6 rendering the Wikidata
data model, 2 original to this port.  The bridge-traced declarations are
marked with `-- @source` below.  Full ledger: `docs/status/PROVENANCE.md`.
-/

namespace Wikidata

-- @source DASHI Agda bridge (PR #555/#581): cross-ontology alignment as comparison evidence
/-- A partial class mapping between two knowledge bases. -/
structure Alignment where
  src : KB
  tgt : KB
  links : List (Qid × Qid)
  deriving Repr, Inhabited

namespace Alignment

/-- The image of a source class, if the alignment maps it. -/
def image (al : Alignment) (a : Qid) : Option Qid :=
  (al.links.find? (fun e => e.1 = a)).map Prod.snd

/-- The mapped image of one subclass edge is required to hold in the target,
whenever both endpoints are mapped. -/
def EdgeOk (al : Alignment) (a b : Qid) : Prop :=
  ∀ a' b', al.image a = some a' → al.image b = some b' → SubclassOf al.tgt a' b'

/-- Executable version of `EdgeOk`. -/
def edgeOk (al : Alignment) (a b : Qid) : Bool :=
  match al.image a, al.image b with
  | some a', some b' => isSubclassOf al.tgt a' b'
  | _, _ => true

theorem edgeOk_iff (al : Alignment) (a b : Qid) : edgeOk al a b = true ↔ EdgeOk al a b := by
  unfold edgeOk EdgeOk
  cases ha : al.image a with
  | none => simp
  | some a' =>
      cases hb : al.image b with
      | none => simp
      | some b' =>
          simp only [isSubclassOf_iff]
          constructor
          · rintro h x y hx hy
            simp only [Option.some.injEq] at hx hy
            subst hx
            subst hy
            exact h
          · intro h
            exact h a' b' rfl rfl

/-- The alignment preserves the subclass relation between mapped classes. -/
def PreservesSubclass (al : Alignment) : Prop :=
  ∀ a ∈ al.src.entities, ∀ b ∈ al.src.entities, SubclassOf al.src a b → EdgeOk al a b

/-- Executable subclass-preservation check. -/
def alignOk (al : Alignment) : Bool :=
  al.src.entities.all (fun a =>
    al.src.entities.all (fun b => !isSubclassOf al.src a b || edgeOk al a b))

-- @source DASHI Agda bridge (PR #555/#581): cross-ontology alignment as comparison evidence
theorem alignOk_iff (al : Alignment) : alignOk al = true ↔ PreservesSubclass al := by
  simp only [alignOk, List.all_eq_true, Bool.or_eq_true, Bool.not_eq_true', PreservesSubclass]
  constructor
  · intro h a ha b hb hsub
    rcases h a ha b hb with h' | h'
    · rw [(isSubclassOf_iff al.src a b).2 hsub] at h'
      exact absurd h' (by simp)
    · exact (edgeOk_iff al a b).1 h'
  · intro h a ha b hb
    by_cases hsub : isSubclassOf al.src a b = true
    · exact Or.inr ((edgeOk_iff al a b).2 (h a ha b hb ((isSubclassOf_iff al.src a b).1 hsub)))
    · exact Or.inl (by simpa using hsub)

/-- Soundness of the alignment checker, in the shape used by the bridge layer. -/
theorem subclassOf_of_alignOk {al : Alignment} (hok : alignOk al = true) {a b a' b' : Qid}
    (ha : a ∈ al.src.entities) (hb : b ∈ al.src.entities) (hsub : SubclassOf al.src a b)
    (hma : al.image a = some a') (hmb : al.image b = some b') : SubclassOf al.tgt a' b' :=
  (alignOk_iff al).1 hok a ha b hb hsub a' b' hma hmb

/-- Disjointness in the target reflects back to the source along the alignment,
provided instances are transported. -/
theorem disjoint_reflect {al : Alignment} {c d c' d' : Qid}
    (htransport : ∀ x ∈ al.src.entities, ∃ x' ∈ al.tgt.entities,
      (InstanceOf al.src x c → InstanceOf al.tgt x' c') ∧
      (InstanceOf al.src x d → InstanceOf al.tgt x' d'))
    (hdisj : DisjointOn al.tgt c' d') : DisjointOn al.src c d := by
  intro x hx ⟨h1, h2⟩
  obtain ⟨x', hx', hc1, hd1⟩ := htransport x hx
  exact hdisj x' hx' ⟨hc1 h1, hd1 h2⟩

end Alignment

end Wikidata
