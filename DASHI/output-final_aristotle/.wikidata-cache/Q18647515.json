alue":{"value":{"text":"\u0435\u0441\u043b\u0438 \u044d\u043b\u0435\u043c\u0435\u043d\u0442 \u0410 \u043d\u0430\u0445\u043e\u0434\u0438\u0442\u0441\u044f \u0432 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0438 P \u043a \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u0443 \u0411, \u0430 \u0442\u0430\u043a\u0436\u0435 \u044d\u043b\u0435\u043c\u0435\u043d\u0442 \u0411 \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0441\u044f \u043a\u0430\u043a P \u043a \u0412, \u0442\u043e \u044d\u043b\u0435\u043c\u0435\u043d\u0442 \u0410 \u043d\u0430\u0445\u043e\u0434\u0438\u0442\u0441\u044f \u0432 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0438 P \u043a \u0412. \u041d\u0435\u0442 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438 \u0443\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u0435 P:B \u0432 \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u0435 \u0410","language":"ru"},"type":"monolingualtext"},"datatype":"monolingualtext"},"type":"statement","id":"Q18647515$bbeb8e9f-47be-f9bf-6725-eedcdc83ef4f","rank":"normal"},{"mainsnak":{"snaktype":"value","property":"P2559","hash":"1c1e67817e631b265f43e465e5f424c1f93bbf13","datavalue":{"value":{"text":"\u044f\u043a\u0449\u043e \u0435\u043b\u0435\u043c\u0435\u043d\u0442 \u0410 \u043f\u0435\u0440\u0435\u0431\u0443\u0432\u0430\u0454 \u0443 \u0432\u0456\u0434\u043d\u043e\u0448\u0435\u043d\u043d\u0456 P \u0434\u043e \u0435\u043b\u0435\u043c\u0435\u043d\u0442\u0430 \u0411, \u0430 \u0442\u0430\u043a\u043e\u0436 \u0435\u043b\u0435\u043c\u0435\u043d\u0442 \u0411 \u0432\u0456\u0434\u043d\u043e\u0441\u0438\u0442\u044c\u0441\u044f \u044f\u043a P \u0434\u043e \u0412, \u0442\u043e \u0435\u043b\u0435\u043c\u0435\u043d\u0442 \u0410 \u043f\u0435\u0440\u0435\u0431\u0443\u0432\u0430\u0454 \u0443 \u0432\u0456\u0434\u043d\u043e\u0448\u0435\u043d\u043d\u0456 P \u0434\u043e \u0412. \u041d\u0435 \u0442\u0440\u0435\u0431\u0430 \u0432\u043a\u0430\u0437\u0443\u0432\u0430\u0442\u0438 \u0442\u0432\u0435\u0440\u0434\u0436\u0435\u043d\u043d\u044f P:B \u0432 \u0435\u043b\u0435\u043c\u0435\u043d\u0442\u0456 \u0410","language":"uk"},"type":"monolingualtext"},"datatype":"monolingualtext"},"type":"statement","id":"Q18647515$af6a7a9b-467a-d0e0-99b4-48a512263ec0","rank":"normal"},{"mainsnak":{"snaktype":"value","property":"P2559","hash":"921cea26293caaddcfb24fcd403a86f19df732d1","datavalue":{"value":{"text":"Si un elemento A est\u00e1 en relaci\u00f3n P a B, y el elemento B est\u00e1 en relaci\u00f3n P a C, entonces el elemento A est\u00e1 impl\u00edcitamente tambi\u00e9n en relaci\u00f3n P a C. Entonces, no hay necesidad general de agregar un enunciado P: C en el elemento A.","language":"es"},"type":"monolingualtext"},"datatype":"monolingualtext"},"type":"statement","id":"Q18647515$4b51bb7c-43a9-21e1-b229-d9ae196e12b3","rank":"normal"},{"mainsnak":{"snaktype":"value","property":"P2559","hash":"e2a819fdd856bc3c23935869211c2bc9d38e1dcc","datavalue":{"value":{"text":"\u82e5\u67d0\u9879\u76ee\u7532\u548c\u4e59\u5177\u8f9b\u5173\u7cfb\uff0c\u800c\u9879\u76ee\u4e59\u548c\u4e19\u5177\u8f9b\u5173\u7cfb\uff0c\u5219\u6697\u793a\u9879\u76ee\u7532\u548c\u4e19\u4ea6\u5177\u8f9b\u5173\u7cfb\u3002\u901a\u5e38\u65e0\u9700\u5728\u9879\u76ee\u7532\u4e2d\u8ffd\u52a0\u58f0\u660e\u8f9b\uff1a\u4e19\u3002","language":"zh-hans"},"type":"monolingualtext"},"datatype":"monolingualtext"},"type":"statement","id":"Q18647515$154641b7-4238-48c2-69aa-ced0e820ae00","rank":"normal"},{"mainsnak":{"snaktype":"value","property":"P2559","hash":"0c03dc2ea7c3029f458b9168e07c7b1dcddac8f8","datavalue":{"value":{"text":"Wenn ein Objekt A in der Beziehung P zu Objekt B steht, und Objekt B steht in der Beziehung P zu Objekt C, dann steht Objekt A implizit auch in Beziehung P zu C. Es ist dann nicht notwendig, P:C in Objekt A zu erg\u00e4nzen.","language":"de"},"type":"monolingualtext"},"datatype":"monolingualtext"},"type":"statement","id":"Q18647515$467941c2-4f1f-f60b-0a43-0786c4b0c57e","rank":"normal"},{"mainsnak":{"snaktype":"value","property":"P2559","hash":"931c4e5bfa84e7ca21620a38c8058b46e7b5b602","datavalue":{"value":{"text":"'A' \ud56d\ubaa9\uc774 'P'\ub77c\ub294 \ud2b9\uc815 \uad00\uacc4\uc5d0 \uc758\ud574 'B' \ud56d\ubaa9\uacfc \uc5f0\uacb0\ub418\uc5b4 \uc788\uace0(A\u2192B), 'B' \ud56d\ubaa9\uc774 'P'\ub77c\ub294 \ud2b9\uc815 \uad00\uacc4\uc5d0 \uc758\ud574 'C' \ud56d\ubaa9\uacfc \uc5f0\uacb0\ub418\uc5b4 \uc788\uc73c\uba74(B\u2192C), 'A' \ud56d\ubaa9\uc740 \ub530\ub85c \uc5b8\uae09\ud558\uc9c0 \uc54a\uc544\ub3c4 'P'\ub77c\ub294 \ud2b9\uc815 \uad00\uacc4\uc5d0 \uc758\ud574 'C' \ud56d\ubaa9\uacfc\ub3c4 \uc5f0\uacb0\ub418\uc5b4 \uc788\ub2e4\uace0 \ubcfc \uc218 \uc788\uc2b5\ub2c8\ub2e4(\u2234 A\u2192C). \uadf8\ub7ec\ubbc0\ub85c 'A' \ud56d\ubaa9\uc5d0 \uc774\ubbf8 'P'\ub77c\ub294 \ud2b9\uc815 \uad00\uacc4\uc5d0 \uc758\ud574 'B' \ud56d\ubaa9\uacfc \uc5f0\uacb0\ub418\uc5b4 \uc788\ub2e4(P:B)\ub294 \ub0b4\uc6a9\uc758 \uc11c\uc220\uc774 \uae30\uc7ac\ub418\uc5b4 \uc788\ub2e4\uba74, 'P'\ub77c\ub294 \ud2b9\uc815 \uad00\uacc4\uc5d0 \uc758\ud574 'C' \ud56d\ubaa9\uacfc \uc5f0\uacb0\ub418\uc5b4 \uc788\ub2e4\ub294 \ub0b4\uc6a9\uc758 \uc11c\uc220(P:C)\uc744 \ubcc4\ub3c4\ub85c \ucd94\uac00\ud558\uc9c0 \uc54a\uc544\ub3c4 \ub429\ub2c8\ub2e4.","language":"ko"},"type":"monolingualtext"},"datatype":"monolingualtext"},"type":"statement","id":"Q18647515$ebbf6b18-48ba-f87f-7e0a-5cb43ab173ea","rank":"normal"},{"mainsnak":{"snaktype":"value","property":"P2559","hash":"38fb79902ff0377e1e889a7d525f5f3f04bfb443","datavalue":{"value":{"text":"e\u011fer A \u00f6gesi P ile B aras\u0131nda ise ve B \u00f6gesi P ile C aras\u0131nda ise bu halde A \u00f6gesi dolayl\u0131 olarak P ile C aras\u0131nda g\u00f6z\u00fck\u00fcr. A \u00f6gesine P:C ifadesini eklemeye genel olarak ihtiya\u00e7 yoktur.","language":"tr"},"type":"monolingualtext"},"datatype":"monolingualtext"},"type":"statement","id":"Q18647515$e36b7d6f-40e3-a6bc-5ca0-be1ba9254f46","rank":"normal"},{"mainsnak":{"snaktype":"value","property":"P2559","hash":"c95f3c2c081e891793ecd61034767123f0aeb2ef","datavalue":{"value":{"text":"if an item A is in relation P to B, and item B is in relation P to C, then item A is implicitly also in relation P to C. There is no general need to add a statement P:C in item A","language":"en"},"type":"monolingualtext"},"datatype":"monolingualtext"},"type":"statement","id":"Q18647515$01a11723-46db-cd7e-308d-c15a7b689c75","rank":"normal"}],"P279":[{"mainsnak":{"snaktype":"value","property":"P279","hash":"1a952545db6cc83d57ac8eea1c41b755d861d2aa","datavalue":{"value":{"entity-type":"item","numeric-id":18616576,"id":"Q18616576"},"type":"wikibase-entityid"},"datatype":"wikibase-item"},"type":"statement","id":"Q18647515$7d0d2d40-4081-71fc-16bf-b7273d1ead6f","rank":"normal"}],"P1269":[{"mainsnak":{"snaktype":"value","property":"P1269","hash":"70b65962709e615ffab6bdeff76b508e75ad35fb","datavalue":{"value":{"entity-type":"item","numeric-id":64861,"id":"Q64861"},"type":"wikibase-entityid"},"datatype":"wikibase-item"},"type":"statement","id":"Q18647515$42e7f0ec-41fc-873a-ffac-091b91f19e0f","rank":"normal"}],"P31":[{"mainsnak":{"snaktype":"value","property":"P31","hash":"5eae155c22dddc193da84409266be00dfe450c01","datavalue":{"value":{"entity-type":"item","numeric-id":107649491,"id":"Q107649491"},"type":"wikibase-entityid"},"datatype":"wikibase-item"},"type":"statement","id":"Q18647515$87ABDC66-C9AB-4EC8-8C80-3EE4D35DF748","rank":"normal"},{"mainsnak":{"snaktype":"value","property":"P31","hash":"6a1ce9ae71fb11dc537666d1101a19f9c9c00f1d","datavalue":{"value":{"entity-type":"item","numeric-id":115490628,"id":"Q115490628"},"type":"wikibase-entityid"},"datatype":"wikibase-item"},"type":"statement","id":"Q18647515$2dbcc35d-44dd-1a06-6287-40cfa2892366","rank":"normal"}]},"sitelinks":{}}}}