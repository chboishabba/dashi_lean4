                        ; (push a j) → main a f (funExt⁻ p) j})))
       (Iso.fun PathIdTrunc₀Iso p)
    where
    pth : (a : E) (f : EP∙ →∙ EM∙ RR (suc i))
       (p : (b : fst B) → fst f (inr b) ≡ 0ₖ (suc i))
     → fst (Ω (EMR∙ (suc i)))
    pth a f p = sym (snd f) ∙ cong (fst f) (sym (push (* , P*)))
             ∙∙ cong (fst f) (push a)
