mod71 : Nat → Nat
mod71 n = n % 71

-- Interpret a Fin 71 as Nat in [0..70]
fin71→Nat : Fin 71 → Nat
fin71→Nat = toℕ

-- A fixed weight vector in Fin 71 (deterministic placeholder).
w : Vec (Fin 71) 15
w = replicate 15 zero

dotNat : EV → Vec (Fin 71) 15 → Nat
