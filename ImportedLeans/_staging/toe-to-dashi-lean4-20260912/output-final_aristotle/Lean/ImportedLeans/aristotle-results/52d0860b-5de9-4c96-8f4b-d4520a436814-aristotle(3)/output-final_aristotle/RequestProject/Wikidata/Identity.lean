namespace Wikidata

namespace Identity

/-- A partial correspondence, presented as a list of pairs. -/
structure Matching (α β : Type) where
  pairs : List (α × β)
  deriving Repr, Inhabited

namespace Matching

variable {α β : Type} [DecidableEq α] [DecidableEq β]

/-- The forward partial map. -/
def toFun (m : Matching α β) (a : α) : Option β :=
  (m.pairs.find? (fun q => q.1 = a)).map Prod.snd

/-- The backward partial map. -/
def invFun (m : Matching α β) (b : β) : Option α :=
  (m.pairs.find? (fun q => q.2 = b)).map Prod.fst

/-- At most one partner on the right. -/
def Functional (m : Matching α β) : Prop :=
  ∀ p ∈ m.pairs, ∀ q ∈ m.pairs, p.1 = q.1 → p.2 = q.2

/-- At most one partner on the left. -/
def Injective (m : Matching α β) : Prop :=
  ∀ p ∈ m.pairs, ∀ q ∈ m.pairs, p.2 = q.2 → p.1 = q.1

omit [DecidableEq β] in
theorem toFun_eq_some_iff {m : Matching α β} (hfun : m.Functional) {a : α} {b : β} :
    m.toFun a = some b ↔ (a, b) ∈ m.pairs := by
  constructor
  · intro h
    simp only [toFun, Option.map_eq_some_iff] at h
    obtain ⟨q, hq, rfl⟩ := h
    have hmem := List.mem_of_find?_eq_some hq
    have hq1 : q.1 = a := by simpa using List.find?_some hq
    have : q = (a, q.2) := by
      cases q with
      | mk x y => simp_all
    exact this ▸ hmem
  · intro h
    have hne : m.pairs.find? (fun q => q.1 = a) ≠ none := by
      intro hnone
      have := List.find?_eq_none.1 hnone (a, b) h
      simp at this
    obtain ⟨q, hq⟩ := Option.ne_none_iff_exists'.1 hne
    have hmem := List.mem_of_find?_eq_some hq
    have hq1 : q.1 = a := by simpa using List.find?_some hq
    have : q.2 = b := hfun q hmem (a, b) h hq1
    simp [toFun, hq, this]

omit [DecidableEq α] in
theorem invFun_eq_some_iff {m : Matching α β} (hinj : m.Injective) {a : α} {b : β} :
    m.invFun b = some a ↔ (a, b) ∈ m.pairs := by
  constructor
  · intro h
    simp only [invFun, Option.map_eq_some_iff] at h
    obtain ⟨q, hq, rfl⟩ := h
    have hmem := List.mem_of_find?_eq_some hq
    have hq2 : q.2 = b := by simpa using List.find?_some hq
    have : q = (q.1, b) := by
      cases q with
      | mk x y => simp_all
    exact this ▸ hmem
  · intro h
    have hne : m.pairs.find? (fun q => q.2 = b) ≠ none := by
      intro hnone
      have := List.find?_eq_none.1 hnone (a, b) h
      simp at this
    obtain ⟨q, hq⟩ := Option.ne_none_iff_exists'.1 hne
    have hmem := List.mem_of_find?_eq_some hq
    have hq2 : q.2 = b := by simpa using List.find?_some hq
    have : q.1 = a := hinj q hmem (a, b) h hq2
    simp [invFun, hq, this]

/-- **Partial bijection, one way.** -/
theorem invFun_of_toFun {m : Matching α β} (hfun : m.Functional) (hinj : m.Injective) {a : α}
    {b : β} (h : m.toFun a = some b) : m.invFun b = some a :=
  (invFun_eq_some_iff hinj).2 ((toFun_eq_some_iff hfun).1 h)

/-- **Partial bijection, the other way.** -/
theorem toFun_of_invFun {m : Matching α β} (hfun : m.Functional) (hinj : m.Injective) {a : α}
    {b : β} (h : m.invFun b = some a) : m.toFun a = some b :=
  (toFun_eq_some_iff hfun).2 ((invFun_eq_some_iff hinj).1 h)

/-- A functional, injective matching is injective as a partial map. -/
theorem toFun_inj {m : Matching α β} (hfun : m.Functional) (hinj : m.Injective) {a₁ a₂ : α}
    {b : β} (h₁ : m.toFun a₁ = some b) (h₂ : m.toFun a₂ = some b) : a₁ = a₂ := by
  have := invFun_of_toFun hfun hinj h₁
  have := invFun_of_toFun hfun hinj h₂
  simp_all

end Matching

/-! ## Identifier properties induce matchings -/

/-- The matching cut out by the truthy statements of an identifier property. -/
def idMatching (kb : KB) (p : Pid) : Matching Qid Qid :=
  ⟨(truthyStatementsFor kb p).map (fun st => (st.subject, st.value))⟩

theorem mem_idMatching_iff (kb : KB) (p : Pid) (a b : Qid) :
    (a, b) ∈ (idMatching kb p).pairs ↔
      ∃ st ∈ truthyStatementsFor kb p, st.subject = a ∧ st.value = b := by
  simp only [idMatching, List.mem_map]
  constructor
  · rintro ⟨st, hst, heq⟩
    injection heq with h1 h2
    exact ⟨st, hst, h1, h2⟩
  · rintro ⟨st, hst, rfl, rfl⟩
    exact ⟨st, hst, rfl⟩

-- @source DASHI Agda bridge (PR #555/#581/#582): invariant 7: Identity / external-ID / sitelink / lexeme results stay candidate evidence
/-- **The single-value constraint is exactly functionality.** -/
theorem functional_of_singleValue {kb : KB} {p : Pid} (h : SingleValue kb p) :
    (idMatching kb p).Functional := by
  rintro ⟨a₁, b₁⟩ h₁ ⟨a₂, b₂⟩ h₂ heq
  rw [mem_idMatching_iff] at h₁ h₂
  obtain ⟨st₁, hst₁, rfl, rfl⟩ := h₁
  obtain ⟨st₂, hst₂, rfl, rfl⟩ := h₂
  exact h st₁ hst₁ st₂ hst₂ heq

-- @source DASHI Agda bridge (PR #555/#581/#582): invariant 7: Identity / external-ID / sitelink / lexeme results stay candidate evidence
/-- **The distinct-value constraint is exactly injectivity.** -/
theorem injective_of_distinctValue {kb : KB} {p : Pid} (h : DistinctValue kb p) :
    (idMatching kb p).Injective := by
  rintro ⟨a₁, b₁⟩ h₁ ⟨a₂, b₂⟩ h₂ heq
  rw [mem_idMatching_iff] at h₁ h₂
  obtain ⟨st₁, hst₁, rfl, rfl⟩ := h₁
  obtain ⟨st₂, hst₂, rfl, rfl⟩ := h₂
  exact h st₁ hst₁ st₂ hst₂ heq

/-- Under both constraints, an identifier property is a partial bijection. -/
theorem idMatching_partial_bijection {kb : KB} {p : Pid} (hs : SingleValue kb p)
    (hd : DistinctValue kb p) (a b : Qid) :
    (idMatching kb p).toFun a = some b ↔ (idMatching kb p).invFun b = some a := by
  constructor
  · exact Matching.invFun_of_toFun (functional_of_singleValue hs) (injective_of_distinctValue hd)
  · exact Matching.toFun_of_invFun (functional_of_singleValue hs) (injective_of_distinctValue hd)

/-! ## Sitelinks and external identifiers -/

/-- A site/title pair. -/
structure SiteLink where
  site : String
  title : String
  deriving DecidableEq, Repr, Inhabited

/-- A sitelink table. -/
abbrev Sitelinks := Matching Qid SiteLink

/-- An external identifier table for one identifier property. -/
abbrev ExternalIds := Matching Qid String

/-- Sitelinks resolve uniquely in both directions when the table is functional
and injective: one item per site/title, one title per item and site. -/
theorem sitelink_round_trip {s : Sitelinks} (hfun : s.Functional) (hinj : s.Injective)
    {q : Qid} {link : SiteLink} (h : s.toFun q = some link) : s.invFun link = some q :=
  Matching.invFun_of_toFun hfun hinj h

/-- Two items with the same external identifier are the same item. -/
theorem externalId_identifies {e : ExternalIds} (hfun : e.Functional) (hinj : e.Injective)
    {q₁ q₂ : Qid} {ident : String} (h₁ : e.toFun q₁ = some ident)
    (h₂ : e.toFun q₂ = some ident) : q₁ = q₂ :=
  Matching.toFun_inj hfun hinj h₁ h₂

/-! ## Lexemes -/

/-- A lexeme: a lemma in a language, with senses that denote items. -/
structure Lexeme where
  lemmaText : String
  language : String
  senses : List Qid
  deriving DecidableEq, Repr, Inhabited

/-- The items denoted by a lexeme's senses. -/
def Lexeme.denotations (l : Lexeme) : List Qid := l.senses

/-- Two lexemes translate each other when they share a denotation. -/
def Translates (l₁ l₂ : Lexeme) : Prop := ∃ q, q ∈ l₁.denotations ∧ q ∈ l₂.denotations

theorem translates_symm {l₁ l₂ : Lexeme} (h : Translates l₁ l₂) : Translates l₂ l₁ := by
  obtain ⟨q, h₁, h₂⟩ := h
  exact ⟨q, h₂, h₁⟩

theorem translates_refl {l : Lexeme} (h : l.denotations ≠ []) : Translates l l := by
  obtain ⟨q, hq⟩ := List.exists_mem_of_ne_nil _ h
  exact ⟨q, hq, hq⟩

/-- Translation by shared denotation is **not** transitive: a polysemous lexeme
links two lexemes with nothing in common. -/
theorem translates_not_transitive :
    ∃ l₁ l₂ l₃ : Lexeme, Translates l₁ l₂ ∧ Translates l₂ l₃ ∧ ¬ Translates l₁ l₃ := by
  refine ⟨⟨"a", "en", [⟨1⟩]⟩, ⟨"b", "fr", [⟨1⟩, ⟨2⟩]⟩, ⟨"c", "de", [⟨2⟩]⟩,
    ⟨⟨1⟩, by simp [Lexeme.denotations], by simp [Lexeme.denotations]⟩,
    ⟨⟨2⟩, by simp [Lexeme.denotations], by simp [Lexeme.denotations]⟩, ?_⟩
  rintro ⟨q, hq₁, hq₃⟩
  simp only [Lexeme.denotations, List.mem_cons, List.not_mem_nil, or_false] at hq₁ hq₃
  subst hq₁
  exact absurd hq₃ (by decide)

/-! ## Identity evidence is candidate-only -/

-- @source DASHI Agda bridge (PR #555/#581/#582): invariant 7: Identity / external-ID / sitelink / lexeme results stay candidate evidence
/-- Having an identifier says nothing about class membership: here an item is
matched to an external identifier while the knowledge base derives no instance
fact about it whatsoever. -/
theorem identity_does_not_entail_instance :
    ∃ (kb : KB) (e : ExternalIds) (q : Qid),
      e.toFun q = some "ext-1" ∧ ∀ c : Qid, ¬ InstanceOf kb q c := by
  refine ⟨⟨[⟨1⟩], []⟩, ⟨[(⟨1⟩, "ext-1")]⟩, ⟨1⟩, by decide, ?_⟩
  rintro c ⟨c₀, hc₀, -⟩
  simp [instanceEdges] at hc₀

end Identity

end Wikidata
