import Synthesis.MillenniumBSDOddPrimeGoodReduction\nimport Mathlib.Algebra.Order.GroupWithZero.Canonical\nimport Mathlib.Tactic\n\n/-!\n# The bad prime 2: minimal additive reduction\n\nFor E : y^2 = x^3 - x we have Δ = 64 = 2^6 and c4 = 48 = 3*2^4.\nIn multiplicative DVR notation their valuations at 2 are exp(-6) and exp(-4).\n\nThe discriminant exponent 6 is strictly below 12.  If an integral variable\nchange improved the discriminant valuation, discreteness would force the\nu^{-1}-valuation to jump by at least exp(1); the transformed discriminant\nwould then have valuation at least exp(6) > 1, contradicting integrality.\n\nHence the displayed equation is minimal at 2.  Since both Δ and c4 have\nvaluation < 1, reduction is additive and the local polynomial is 1.\n-/\n\nnamespace Synthesis.Millennium.BSD\n\nopen WeierstrassCurve\nopen IsDiscreteValuationRing\nopen IsDedekindDomain.HeightOneSpectrum\nopen WithZero Multiplicative\nopen Polynomial\n\nprivate instance : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩\n\ntheorem cmPadicWeierstrass_c4_two :\n    (cmPadicWeierstrass 2).c₄ = 48 := by\n  simp [cmPadicWeierstrass, cmWeierstrass,\n    WeierstrassCurve.c₄, WeierstrassCurve.b₂, WeierstrassCurve.b₄]\n\ntheorem padicIntTwo_irreducible : Irreducible (2 : ℤ_[2]) := by\n  simpa using (PadicInt.irreducible_p (p := 2))\n\ntheorem twoAdic_intValuation_two_pow (n : ℕ) :\n    (maximalIdeal ℤ_[2]).intValuation ((2 : ℤ_[2]) ^ n)\n      = WithZero.exp (-(n : ℤ)) := by\n  rw [IsDiscreteValuationRing.intValuation_maximalIdeal]\n  rw [padicIntTwo_irreducible.addVal_pow]\n  simp [← WithZero.exp_eq_coe_ofAdd]\n\ntheorem twoAdic_valuation_two_pow (n : ℕ) :\n    valuation ℚ_[2] (maximalIdeal ℤ_[2])\n      (algebraMap ℤ_[2] ℚ_[2] ((2 : ℤ_[2]) ^ n))\n      = WithZero.exp (-(n : ℤ)) := by\n  rw [IsDedekindDomain.HeightOneSpectrum.valuation_of_algebraMap]\n  exact twoAdic_intValuation_two_pow n\n\ntheorem cmPadicTwo_discriminant_valuation :\n    valuation ℚ_[2] (maximalIdeal ℤ_[2])\n      (cmPadicWeierstrass 2).Δ = WithZero.exp (-6 : ℤ) := by\n  rw [cmPadicWeierstrass_discriminant]\n  change valuation ℚ_[2] (maximalIdeal ℤ_[2])\n    (algebraMap ℤ_[2] ℚ_[2] (64 : ℤ_[2])) = _\n  have h64 : (64 : ℤ_[2]) = (2 : ℤ_[2]) ^ 6 := by norm_num\n  rw [h64, twoAdic_valuation_two_pow]\n  norm_num\n\ntheorem three_isUnit_padicInt_two : IsUnit (3 : ℤ_[2]) := by\n  rw [PadicInt.isUnit_iff, PadicInt.norm_natCast_eq_one_iff]\n  norm_num\n\ntheorem three_twoAdic_valuation_eq_one :\n    valuation ℚ_[2] (maximalIdeal ℤ_[2])\n      (algebraMap ℤ_[2] ℚ_[2] (3 : ℤ_[2])) = 1 := by\n  rw [valuation_eq_one_iff_notMem]\n  simpa [IsDiscreteValuationRing.maximalIdeal,\n    IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]\n    using three_isUnit_padicInt_two\n\ntheorem cmPadicTwo_c4_valuation :\n    valuation ℚ_[2] (maximalIdeal ℤ_[2])\n      (cmPadicWeierstrass 2).c₄ = WithZero.exp (-4 : ℤ) := by\n  rw [cmPadicWeierstrass_c4_two]\n  change valuation ℚ_[2] (maximalIdeal ℤ_[2])\n    (algebraMap ℤ_[2] ℚ_[2] (48 : ℤ_[2])) = _\n  have h48 : (48 : ℤ_[2]) = 3 * (2 : ℤ_[2]) ^ 4 := by norm_num\n  rw [h48, map_mul, three_twoAdic_valuation_eq_one,\n    twoAdic_valuation_two_pow]\n  norm_num [WithZero.exp_add]\n\ntheorem exp_neg_six_lt_one :\n    WithZero.exp (-6 : ℤ) < (1 : ℤᵐ⁰) := by\n  rw [← WithZero.exp_zero, WithZero.exp_lt_exp]\n  norm_num\n\ntheorem exp_neg_four_lt_one :\n    WithZero.exp (-4 : ℤ) < (1 : ℤᵐ⁰) := by\n  rw [← WithZero.exp_zero, WithZero.exp_lt_exp]\n  norm_num\n\n/-- Discreteness of ℤᵐ⁰: anything strictly above 1 is at least exp(1). -/\ntheorem one_mul_exp_one_le_of_one_lt {x : ℤᵐ⁰}\n    (hx0 : x ≠ 0) (hx : 1 < x) :\n    WithZero.exp (1 : ℤ) ≤ x := by\n  lift x to Multiplicative ℤ using hx0\n  rw [← WithZero.coe_one, ← WithZero.coe_le_coe]\n  change Multiplicative.ofAdd (1 : ℤ) ≤ x\n  change (1 : ℤ) ≤ x.toAdd\n  have hxi : (0 : ℤ) < x.toAdd := by\n    simpa [← WithZero.coe_one, Multiplicative.toAdd_lt] using hx\n  omega\n\ntheorem twelve_power_jump_mul_exp_neg_six_gt_one\n    {x : ℤᵐ⁰} (hx0 : x ≠ 0) (hx : 1 < x) :\n    1 < x ^ 12 * WithZero.exp (-6 : ℤ) := by\n  have hstep := one_mul_exp_one_le_of_one_lt hx0 hx\n  have hp : (WithZero.exp (1 : ℤ)) ^ 12 ≤ x ^ 12 :=\n    pow_le_pow_left₀ (by simp) hstep\n  calc\n    1 = WithZero.exp (6 : ℤ) * WithZero.exp (-6 : ℤ) := by\n      rw [← WithZero.exp_add]\n      norm_num\n    _ < (WithZero.exp (12 : ℤ)) * WithZero.exp (-6 : ℤ) := by\n      gcongr\n      rw [WithZero.exp_lt_exp]\n      norm_num\n    _ = (WithZero.exp (1 : ℤ)) ^ 12 * WithZero.exp (-6 : ℤ) := by\n      rw [← WithZero.exp_nsmul]\n      norm_num\n    _ ≤ x ^ 12 * WithZero.exp (-6 : ℤ) := by gcongr\n\ninstance cmPadicTwo_isMinimal :\n    WeierstrassCurve.IsMinimal ℤ_[2] (cmPadicWeierstrass 2) where\n  val_Δ_maximal := by\n    constructor\n    · infer_instance\n    · intro C hC hle\n      have hcur :\n          WeierstrassCurve.valuation_Δ_aux ℤ_[2]\n            ((1 : VariableChange ℚ_[2]) • cmPadicWeierstrass 2)\n          = ⟨WithZero.exp (-6 : ℤ), exp_neg_six_lt_one.le⟩ := by\n        apply Subtype.ext\n        simp only [one_smul]\n        rw [WeierstrassCurve.valuation_Δ_aux_eq_of_isIntegral]\n        exact cmPadicTwo_discriminant_valuation\n      rw [hcur] at hle ⊢\n      by_contra hnot\n      have hstrict :\n          WithZero.exp (-6 : ℤ) <\n            (WeierstrassCurve.valuation_Δ_aux ℤ_[2]\n              (C • cmPadicWeierstrass 2) : ℤᵐ⁰) :=\n        lt_of_le_of_ne hle (Ne.symm hnot)\n      have hInt : IsIntegral ℤ_[2] (C • cmPadicWeierstrass 2) := hC\n      rw [WeierstrassCurve.valuation_Δ_aux_eq_of_isIntegral] at hstrict\n      rw [WeierstrassCurve.variableChange_Δ, map_mul, map_pow,\n        cmPadicTwo_discriminant_valuation] at hstrict\n      let x : ℤᵐ⁰ := valuation ℚ_[2] (maximalIdeal ℤ_[2])\n        ((C.u⁻¹ : ℚ_[2]))\n      have hx0 : x ≠ 0 := by\n        dsimp [x]\n        simp\n      have hx : 1 < x := by\n        by_contra hx'\n        have hxle : x ≤ 1 := le_of_not_gt hx'\n        have hpow : x ^ 12 ≤ 1 := by simpa using pow_le_one₀ (by simp) hxle\n        have : x ^ 12 * WithZero.exp (-6 : ℤ)\n            ≤ WithZero.exp (-6 : ℤ) := by simpa using mul_le_mul_right' hpow _\n        exact (not_lt_of_ge this) hstrict\n      have hgt := twelve_power_jump_mul_exp_neg_six_gt_one hx0 hx\n      have hleOne :\n          valuation ℚ_[2] (maximalIdeal ℤ_[2])\n            (C • cmPadicWeierstrass 2).Δ ≤ 1 := by\n        choose d hd using Δ_integral_of_isIntegral ℤ_[2]\n          (C • cmPadicWeierstrass 2)\n        rw [← hd]\n        exact valuation_le_one (maximalIdeal ℤ_[2]) d\n      rw [WeierstrassCurve.variableChange_Δ, map_mul, map_pow,\n        cmPadicTwo_discriminant_valuation] at hleOne\n      exact (not_lt_of_ge hleOne) hgt\n\ninstance cmPadicTwo_hasAdditiveReduction :\n    WeierstrassCurve.HasAdditiveReduction ℤ_[2]\n      (cmPadicWeierstrass 2) where\n  toIsMinimal := cmPadicTwo_isMinimal\n  badReduction := by\n    rw [cmPadicTwo_discriminant_valuation]\n    exact exp_neg_six_lt_one\n  additiveReduction := by\n    rw [cmPadicTwo_c4_valuation]\n    exact exp_neg_four_lt_one\n\ntheorem cmPadicTwo_localPolynomial_eq_one :\n    (cmPadicWeierstrass 2).localPolynomial ℤ_[2] = 1 := by\n  rw [WeierstrassCurve.localPolynomial]\n  dsimp only\n  rw [if_neg cmPadicTwo_hasAdditiveReduction.not_hasGoodReduction]\n  rw [if_neg (fun hsplit =>\n    cmPadicTwo_hasAdditiveReduction.not_hasMultiplicativeReduction\n      hsplit.toHasMultiplicativeReduction)]\n  rw [if_neg cmPadicTwo_hasAdditiveReduction.not_hasMultiplicativeReduction]\n\ntheorem cmPadicTwo_localPowerSeries_eq_one :\n    (cmPadicWeierstrass 2).localPowerSeries ℤ_[2] = 1 := by\n  unfold WeierstrassCurve.localPowerSeries\n  rw [cmPadicTwo_localPolynomial_eq_one]\n  simp\n\ntheorem cmPadicTwo_localEulerFactor_twoPower (k : ℕ) :\n    (cmPadicWeierstrass 2).localEulerFactor ℤ_[2] (2 ^ k)\n      = if k = 0 then 1 else 0 := by\n  unfold WeierstrassCurve.localEulerFactor\n  rw [padicResidueField_natCard]\n  rw [cmPadicTwo_localPowerSeries_eq_one]\n  rw [ArithmeticFunction.ofPowerSeries_apply Nat.prime_two.one_lt]\n  rw [Function.extend_apply]\n  simp\n\nend Synthesis.Millennium.BSD\n