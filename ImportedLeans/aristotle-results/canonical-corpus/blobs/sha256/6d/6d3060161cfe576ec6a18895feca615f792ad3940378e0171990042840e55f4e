  animalexicReceiptLayer : EmbodiedIntegrationLayer

data EmbodiedNonPromotionGuard : Set where
  NoIntentRecoveryClaim : EmbodiedNonPromotionGuard
  NoPainQualiaIdentityClaim : EmbodiedNonPromotionGuard
