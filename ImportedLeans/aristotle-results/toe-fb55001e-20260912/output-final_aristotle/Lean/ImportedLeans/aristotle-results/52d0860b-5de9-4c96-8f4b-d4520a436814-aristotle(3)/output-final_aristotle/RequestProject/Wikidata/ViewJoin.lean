import RequestProject.Wikidata.Layers
import RequestProject.Epistemic.ObserverJoin

/-!
# The layer and the slice are transverse observers of a knowledge base

`Epistemic/Views.lean` indexes evidence by a *view* — a statement layer and a
data slice — and shows the two coordinates behave differently.  The observer
calculus makes the underlying geometric fact precise, in the same shape the
upstream tranche uses for its two projections of the ternary carrier: the layer
projection and the slice projection of a knowledge base are **incomparable**,
and the view is their join.

* `Wikidata.layerObs_incomparable_sliceObs` — neither projection is a function
  of the other: the truthy layer erases a deprecated subclass statement that the
  slice keeps, and the subclass slice erases an instance statement that the
  layer keeps;
* `Wikidata.viewObs_universal` — the view (layer, slice) is the least common
  refinement: any reading that recovers both recovers the view;
* `Wikidata.viewObs_not_separating` — and the view is still not the knowledge
  base: a deprecated instance statement is invisible to both coordinates, so
  reading a base through its views is a genuine loss.
-/

/-! ### Provenance (generated by `tools/provenance.py`)

Source mix of this module's 20 declarations: 6 traced to the DASHI Agda
bridge (`chboishabba/dashi_agda` PR #555 / #581 / #582), 11 rendering the Wikidata
data model, 3 original to this port.  The bridge-traced declarations are
marked with `-- @source` below.  Full ledger: `docs/status/PROVENANCE.md`.
-/

namespace Wikidata

open Epistemic

/-! ## The two projections -/

-- @source DASHI Agda bridge (PR #555/#581/#582): two transverse readings of one base
/-- The layer projection: the statements the truthy query layer sees. -/
def layerObs (kb : KB) : List Statement := (truthyLayer kb).statements

/-- The subclass slice: the statements about the class hierarchy. -/
def classFilter : StatementFilter := fun st => decide (st.property = P279)

-- @source DASHI Agda bridge (PR #555/#581/#582): two transverse readings of one base
/-- The slice projection: the statements a reader restricted to the class
hierarchy sees. -/
def sliceObs (kb : KB) : List Statement := (restrict kb classFilter).statements

/-! ## Four small knowledge bases -/

private def a : Qid := ⟨1⟩
private def b : Qid := ⟨2⟩
private def x : Qid := ⟨3⟩

/-- A base carrying one preferred subclass statement. -/
def baseKB : KB where
  entities := [a, b, x]
  statements := [⟨a, P279, b, Rank.preferred⟩]

/-- The same base with an extra *deprecated* subclass statement. -/
def deprecatedSubclassKB : KB where
  entities := [a, b, x]
  statements := [⟨a, P279, b, Rank.preferred⟩, ⟨b, P279, a, Rank.deprecated⟩]

/-- The same base with an extra instance statement. -/
def instanceKB : KB where
  entities := [a, b, x]
  statements := [⟨a, P279, b, Rank.preferred⟩, ⟨x, P31, a, Rank.normal⟩]

/-- The same base with an extra *deprecated* instance statement. -/
def deprecatedInstanceKB : KB where
  entities := [a, b, x]
  statements := [⟨a, P279, b, Rank.preferred⟩, ⟨x, P31, a, Rank.deprecated⟩]

/-! ## The layer erases what the slice keeps, and conversely -/

/-- The truthy layer drops the deprecated subclass statement… -/
theorem layerObs_collision : layerObs baseKB = layerObs deprecatedSubclassKB := by decide

/-- …which the class slice keeps. -/
theorem sliceObs_separates : sliceObs baseKB ≠ sliceObs deprecatedSubclassKB := by decide

/-- The class slice drops the instance statement… -/
theorem sliceObs_collision : sliceObs baseKB = sliceObs instanceKB := by decide

/-- …which the truthy layer keeps. -/
theorem layerObs_separates : layerObs baseKB ≠ layerObs instanceKB := by decide

-- @source DASHI Agda bridge (PR #555/#581/#582): two transverse readings of one base
/-- **The layer and the slice are transverse.**  Neither coordinate of a view is
a function of the other. -/
theorem layerObs_incomparable_sliceObs : Incomparable layerObs sliceObs :=
  incomparable_of_cross_collisions layerObs_collision sliceObs_separates
    sliceObs_collision layerObs_separates

/-! ## The view is their join -/

-- @source DASHI Agda bridge (PR #555/#581/#582): two transverse readings of one base
/-- The view: both coordinates at once. -/
def viewObs : KB → List Statement × List Statement := pairObserver layerObs sliceObs

theorem viewObs_carries_layer : FactorsThrough viewObs layerObs :=
  pairObserver_carries_left _ _

theorem viewObs_carries_slice : FactorsThrough viewObs sliceObs :=
  pairObserver_carries_right _ _

-- @source DASHI Agda bridge (PR #555/#581/#582): two transverse readings of one base
/-- **The view is the least common refinement of the two coordinates.** -/
theorem viewObs_universal {Common : Type} {common : KB → Common}
    (hlayer : FactorsThrough common layerObs) (hslice : FactorsThrough common sliceObs) :
    FactorsThrough common viewObs :=
  factorsThrough_pairObserver hlayer hslice

-- @source DASHI Agda bridge (PR #555/#581/#582): two transverse readings of one base
/-- **Reading a base through its views is still lossy.**  A deprecated instance
statement is invisible to the layer (which drops deprecated statements) and to
the slice (which drops instance statements), so the view cannot see it. -/
theorem viewObs_not_separating : ¬ Separating viewObs :=
  not_separating_pairObserver_of_common_collision
    (show layerObs baseKB = layerObs deprecatedInstanceKB by decide)
    (show sliceObs baseKB = sliceObs deprecatedInstanceKB by decide)
    (by
      intro h
      have hst := congrArg KB.statements h
      simp [baseKB, deprecatedInstanceKB] at hst)

end Wikidata
