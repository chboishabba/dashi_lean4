  cong-subst-lem : (n m : ℕ) (q' : n ≡ m) (q : suc n ≡ suc m)
        (A : ℕ → Pointed ℓ)
        (F : (x : ℕ) → fst (A x) → fst (Ω (A (suc x))))
        (F∙ : (x : ℕ) → F x (pt (A x)) ≡ refl)
     → (x : fst (A n))
