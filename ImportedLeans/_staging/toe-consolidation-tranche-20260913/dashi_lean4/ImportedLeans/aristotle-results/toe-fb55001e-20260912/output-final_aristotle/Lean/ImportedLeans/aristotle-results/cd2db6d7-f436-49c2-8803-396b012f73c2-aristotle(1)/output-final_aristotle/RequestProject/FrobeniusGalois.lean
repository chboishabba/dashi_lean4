import RequestProject.FrobeniusOrbit

/-!
# The Frobenius endomorphism has order exactly `n`

For a finite field `K` with `p ^ n` elements the Frobenius map `x ↦ x ^ p` is an automorphism,
and its iterates `x ↦ x ^ (p ^ k)` are the elements of the Galois group of `K` over its prime
subfield `𝔽_p`.  This file pins down the order of Frobenius:

* `pow_pow_char_eq_self_forall_iff` : the `k`-th iterate is the identity **iff `n ∣ k`**;
* `orderOf_frobeniusEquiv` : consequently the Frobenius automorphism has order exactly `n`;
* `frobeniusEquiv_pow_injOn` : the `n` iterates `k < n` are pairwise distinct, so the group
  they generate is cyclic of order `n`;
* `exists_pow_pow_char_ne` : concretely, for `i < j < n` some element of `K` satisfies
  `x ^ (p ^ i) ≠ x ^ (p ^ j)`.
-/

namespace FrobeniusPrimeSubfield

variable {K : Type*} [Field K] {p : ℕ} [hp : Fact p.Prime] [CharP K p] [Fintype K] {n : ℕ}

/-- **The `k`-th Frobenius iterate is the identity exactly when `n ∣ k`.** -/
theorem pow_pow_char_eq_self_forall_iff (hK : Nat.card K = p ^ n) (hn : n ≠ 0) (k : ℕ) :
    (∀ x : K, x ^ p ^ k = x) ↔ n ∣ k := by
  constructor
  · intro hfix
    have htop : Nat.card (fixedSubfield K p k) = Nat.card K := by
      have hsub : fixedSubfield K p k = ⊤ := by
        ext x
        simpa [mem_fixedSubfield] using hfix x
      rw [hsub]
      exact Nat.card_congr (Subfield.topEquiv.toEquiv)
    rw [card_fixedSubfield hK hn k, hK] at htop
    have hgcd : Nat.gcd k n = n := Nat.pow_right_injective hp.out.two_le htop
    exact Nat.gcd_eq_right_iff_dvd.mp hgcd
  · rintro ⟨m, rfl⟩
    intro x
    exact pow_pow_char_of_mul (pow_card_pow_eq_self hK x) m

/-- For `i < j < n` the `i`-th and `j`-th Frobenius iterates differ. -/
theorem exists_pow_pow_char_ne (hK : Nat.card K = p ^ n) (hn : n ≠ 0) {i j : ℕ} (hij : i < j)
    (hjn : j < n) : ∃ x : K, x ^ p ^ i ≠ x ^ p ^ j := by
  by_contra hcon
  push_neg at hcon
  have hfix : ∀ x : K, x ^ p ^ (j - i) = x := by
    intro x
    have hxi : (x ^ p ^ (j - i)) ^ p ^ i = x ^ p ^ i := by
      rw [← pow_mul, ← pow_add, Nat.sub_add_cancel hij.le]
      exact (hcon x).symm
    exact pow_pow_char_inj K p i hxi
  have hdvd : n ∣ (j - i) := (pow_pow_char_eq_self_forall_iff hK hn _).1 hfix
  have := Nat.le_of_dvd (by omega) hdvd
  omega

theorem frobeniusEquiv_pow_apply (k : ℕ) (x : K) :
    (frobeniusEquiv K p ^ k) x = x ^ p ^ k := by
  induction k with
  | zero => simp
  | succ m _ =>
      rw [pow_succ]
      simp [← pow_succ, iterate_frobenius]

/-- **The Frobenius automorphism of a field with `p ^ n` elements has order exactly `n`.** -/
theorem orderOf_frobeniusEquiv (hK : Nat.card K = p ^ n) (hn : n ≠ 0) :
    orderOf (frobeniusEquiv K p) = n := by
  have hone : ∀ k : ℕ, (frobeniusEquiv K p ^ k = 1) ↔ n ∣ k := by
    intro k
    rw [← pow_pow_char_eq_self_forall_iff hK hn k]
    constructor
    · intro h x
      have h2 : (frobeniusEquiv K p ^ k) x = x := by rw [h]; rfl
      rwa [frobeniusEquiv_pow_apply] at h2
    · intro h
      refine RingEquiv.ext fun x => ?_
      rw [frobeniusEquiv_pow_apply]
      simpa using h x
  refine Nat.dvd_antisymm ?_ ?_
  · exact orderOf_dvd_of_pow_eq_one ((hone n).2 dvd_rfl)
  · exact (hone _).1 (pow_orderOf_eq_one _)

/-- The `n` Frobenius iterates with exponent `k < n` are pairwise distinct: the Galois group
of `K` over `𝔽_p` generated by Frobenius is cyclic of order `n`. -/
theorem frobeniusEquiv_pow_injOn (hK : Nat.card K = p ^ n) (hn : n ≠ 0) :
    Set.InjOn (fun k : ℕ => frobeniusEquiv K p ^ k) (Set.Iio n) := by
  have := pow_injOn_Iio_orderOf (G := K ≃+* K) (x := frobeniusEquiv K p)
  rwa [orderOf_frobeniusEquiv hK hn] at this

end FrobeniusPrimeSubfield
