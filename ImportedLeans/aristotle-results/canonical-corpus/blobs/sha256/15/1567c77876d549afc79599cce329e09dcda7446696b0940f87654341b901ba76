open import Agda.Builtin.Equality using (_≡_; refl)
open import Agda.Builtin.Nat using (Nat; zero)
open import Data.Nat using (_≤_; _*_; z≤n; s≤s)
open import Data.Nat.Properties as NatP using (≤-refl)

