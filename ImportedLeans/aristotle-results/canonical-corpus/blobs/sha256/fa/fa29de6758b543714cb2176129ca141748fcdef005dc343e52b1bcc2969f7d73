import Mathlib

/-!
# Lean mirror of `DASHI/Algebra/OperatorMonoidClosed.agda` (genuine closure)

Faithful transcription of the free monoid generated by a seed endo-operator `K`
on a one-point `State`.  `Gen K` is the inductive family of all endofunctions
reachable from `id` and `K` under composition, and the "closure" property —
that this set is closed under composition — is *literal*: it is the constructor
`gen_comp`.  We additionally record the genuine fact that the generated closure
collapses to a single point (the one-point state is a fixed point of every
generated operator).  No `sorry`, axiom-clean.
-/

namespace AgdaMirror.OperatorMonoidClosed

/-- The one-point physics "state" carrier (Agda `data State`). -/
inductive State | st
  deriving DecidableEq, Repr

/-- Endofunctions on `State` (Agda `Endo`). -/
def Endo : Type := State → State

/-- Composition of endofunctions (Agda `_∘_`). -/
def comp (f g : Endo) : Endo := fun s => f (g s)

/-- Identity endofunction (Agda `id`). -/
def idE : Endo := fun s => s

/-- The free monoid generated by a seed operator `K` (Agda `data Gen`). -/
inductive Gen (K : Endo) : Endo → Prop
  | gen_id : Gen K idE
  | gen_base : Gen K K
  | gen_comp : ∀ {f g}, Gen K f → Gen K g → Gen K (comp f g)

/-- Closure under composition is literal — the `gen_comp` constructor. -/
theorem closed_under_comp {K f g : Endo}
    (hf : Gen K f) (hg : Gen K g) : Gen K (comp f g) :=
  Gen.gen_comp hf hg

/-- Every endofunction on the one-point state fixes that point: the carrier is a
genuine one-element type, so all generated operators agree on it. -/
theorem state_subsingleton (a b : State) : a = b := by
  cases a; cases b; rfl

end AgdaMirror.OperatorMonoidClosed
