import RequestProject.Epistemic.Quotient

/-!
# Update order does not descend through a surface it leaves fixed

Two operations on a fine carrier may each leave a public surface unchanged and
still fail to commute upstairs.  When that happens the *order* in which they
were applied is invisible: the two ordered endpoints share a surface value but
are different states, so no reader of the surface can say which composite
produced the state in front of it.

The module proves this in three steps:

* surface invariance composes (`surfaceInvariant_comp`), so both ordered
  composites sit on the surface value of the input
  (`orderedSurface_eq_of_invariant`);
* a non-commuting point is therefore a collision of the surface observer on
  which the endpoint differs, which rules out *every* reconstruction of the
  endpoint from the surface (`not_factorsThrough_orderedEndpoint`);
* coarsening cannot repair the loss.  A distinction already lost at one
  projection stays lost after any further projection
  (`not_factorsThrough_postcomp`), and the converse fails
  (`exists_factorsThrough_not_factorsThrough_postcomp`): a later observer may
  destroy information the first one kept, never restore it.

The Wikidata instance — two redundancy-preserving edits whose order the derived
class relation cannot see — is `RequestProject.Wikidata.EditOrder`.
-/

/-! ### Provenance (generated by `tools/provenance.py`)

Source mix of this module's 12 declarations: 2 traced to the DASHI Agda
bridge (`chboishabba/dashi_agda` PR #555 / #581 / #582), 0 rendering the Wikidata
data model, 10 original to this port.  The bridge-traced declarations are
marked with `-- @source` below.  Full ledger: `docs/status/PROVENANCE.md`.
-/

namespace Epistemic

variable {Carrier Surface Public Outcome : Type}

/-! ## Coarsening cannot repair a lost distinction -/

/-- **Factoring through a coarsening is harder.**  If a route is already
determined by `post ∘ proj`, it is determined by `proj` alone: post-composition
only throws more away. -/
theorem factorsThrough_of_factorsThrough_postcomp {proj : Carrier → Surface}
    {post : Surface → Public} {route : Carrier → Outcome}
    (h : FactorsThrough (fun x => post (proj x)) route) : FactorsThrough proj route := by
  obtain ⟨interpret, hint⟩ := h
  exact ⟨fun s => interpret (post s), hint⟩

-- @source DASHI Agda bridge (PR #555/#581/#582): non-factorability survives further coarsening
/-- **Post-composition cannot repair an erased distinction.**  A phenomenon that
does not factor through a projection does not factor through that projection
followed by any further observer. -/
theorem not_factorsThrough_postcomp {proj : Carrier → Surface} {post : Surface → Public}
    {route : Carrier → Outcome} (h : ¬ FactorsThrough proj route) :
    ¬ FactorsThrough (fun x => post (proj x)) route :=
  fun hpost => h (factorsThrough_of_factorsThrough_postcomp hpost)

/-- The implication is strictly one-way: a route can factor through a projection
and fail to factor through a coarsening of it. -/
theorem exists_factorsThrough_not_factorsThrough_postcomp :
    ∃ (proj : Bool → Bool) (post : Bool → Unit) (route : Bool → Bool),
      FactorsThrough proj route ∧ ¬ FactorsThrough (fun x => post (proj x)) route := by
  refine ⟨id, fun _ => (), id, ⟨id, fun _ => rfl⟩, ?_⟩
  rintro ⟨interpret, h⟩
  have h₁ := h true
  have h₂ := h false
  simp only [id] at h₁ h₂
  exact absurd (h₁.trans h₂.symm) (by simp)

/-! ## Ordered endpoints

Surface invariance (`Epistemic.SurfaceInvariant`) and its closure under
composition come from `RequestProject.Epistemic.Observer`. -/

/-- Which of two operations was applied last. -/
inductive UpdateOrder
  | firstAfterSecond
  | secondAfterFirst
  deriving DecidableEq, Repr, Inhabited

/-- The carrier state reached by applying two operations in the given order. -/
def orderedEndpoint (f g : Carrier → Carrier) (x : Carrier) : UpdateOrder → Carrier
  | UpdateOrder.firstAfterSecond => f (g x)
  | UpdateOrder.secondAfterFirst => g (f x)

/-- The surface reading of the ordered endpoint. -/
def orderedSurface (proj : Carrier → Surface) (f g : Carrier → Carrier) (x : Carrier)
    (o : UpdateOrder) : Surface :=
  proj (orderedEndpoint f g x o)

/-- **Both orders land on the same surface value** when each operation is
surface invariant. -/
theorem orderedSurface_eq_of_invariant {proj : Carrier → Surface} {f g : Carrier → Carrier}
    (hf : SurfaceInvariant proj f) (hg : SurfaceInvariant proj g) (x : Carrier) :
    orderedSurface proj f g x UpdateOrder.firstAfterSecond =
      orderedSurface proj f g x UpdateOrder.secondAfterFirst :=
  (surfaceInvariant_comp hf hg x).trans (surfaceInvariant_comp hg hf x).symm

/-- **Non-commuting hidden updates make the order undecodable.**  Stated at a
single point: if the two ordered endpoints share a surface value and differ as
states, no reading of the surface reconstructs the endpoint. -/
theorem not_factorsThrough_orderedEndpoint_of_surface_eq {proj : Carrier → Surface}
    {f g : Carrier → Carrier} {x : Carrier}
    (hsurf : orderedSurface proj f g x UpdateOrder.firstAfterSecond =
      orderedSurface proj f g x UpdateOrder.secondAfterFirst)
    (hne : f (g x) ≠ g (f x)) :
    ¬ FactorsThrough (orderedSurface proj f g x) (orderedEndpoint f g x) :=
  not_factorsThrough hsurf hne

-- @source DASHI Agda bridge (PR #555/#581/#582): hidden update order does not descend through a surface it leaves fixed
/-- **The surface cannot decode the ordered endpoint** of two surface-invariant
operations that do not commute at `x`. -/
theorem not_factorsThrough_orderedEndpoint {proj : Carrier → Surface}
    {f g : Carrier → Carrier} (hf : SurfaceInvariant proj f) (hg : SurfaceInvariant proj g)
    {x : Carrier} (hne : f (g x) ≠ g (f x)) :
    ¬ FactorsThrough (orderedSurface proj f g x) (orderedEndpoint f g x) :=
  not_factorsThrough_orderedEndpoint_of_surface_eq
    (orderedSurface_eq_of_invariant hf hg x) hne

/-- **A two-stage observer is no stronger than its first stage** for an order
already invisible at that first stage. -/
theorem not_factorsThrough_orderedEndpoint_postcomp {proj : Carrier → Surface}
    {post : Surface → Public} {f g : Carrier → Carrier}
    (hf : SurfaceInvariant proj f) (hg : SurfaceInvariant proj g)
    {x : Carrier} (hne : f (g x) ≠ g (f x)) :
    ¬ FactorsThrough (fun o => post (orderedSurface proj f g x o)) (orderedEndpoint f g x) :=
  not_factorsThrough_postcomp (not_factorsThrough_orderedEndpoint hf hg hne)

/-- What *does* descend is the surface content itself: the surface reading of
the endpoint is order independent, hence trivially reconstructible. -/
theorem factorsThrough_orderedSurface {proj : Carrier → Surface} {f g : Carrier → Carrier}
    (x : Carrier) :
    FactorsThrough (orderedSurface proj f g x) (orderedSurface proj f g x) :=
  ⟨id, fun _ => rfl⟩

/-- Commuting operations are the only escape: if the endpoints agree, the order
carries no information about the state at all. -/
theorem orderedEndpoint_const_of_commute {f g : Carrier → Carrier} {x : Carrier}
    (h : f (g x) = g (f x)) (o o' : UpdateOrder) :
    orderedEndpoint f g x o = orderedEndpoint f g x o' := by
  cases o <;> cases o' <;> simp [orderedEndpoint, h]

end Epistemic
