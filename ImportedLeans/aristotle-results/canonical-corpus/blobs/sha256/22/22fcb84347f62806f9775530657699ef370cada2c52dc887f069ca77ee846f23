  record
    { level3-start = cascade0
    ; level3-next = cascade1
    ; level2-next = cascade2
    ; level1-next = cascade3
    ; step01 = cascadeStep01
    ; step12 = cascadeStep12
    ; step23 = cascadeStep23
    ; step34 = cascadeStep34
    ; sameDenseFibre = cascadeDenseFibre
