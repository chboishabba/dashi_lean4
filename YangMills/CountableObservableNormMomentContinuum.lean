import Mathlib
import YangMills.CountableObservableMarginals
import YangMills.CanonicalMarginalMomentSource
import YangMills.ProjectiveMarginalDiagonalTightness
import YangMills.ProjectiveFinIicBridge

/-!
# Selected countable observable moments -> actual continuum probability law

Choose one countable real scalar observable family on the literal cutoff law.
For the first `m` observables use the canonical finite-dimensional sup norm as
the coercive cost.  Its finite-dimensional sublevels are compact automatically.
Thus the physical D3 input is reduced to one source-native uniform norm-moment
bound for every finite prefix (plus elementary ENNReal threshold arithmetic).

The existing tightness, simultaneous-subsequence, Fin/Iic bridge, regular
conditional, and Ionescu--Tulcea theorems then construct one probability law on
`ℕ → ℝ` with exactly the selected subsequential finite marginals.
-/

open Filter Set MeasureTheory Preorder

namespace RequestProject.YangMills

/-- Canonical finite-dimensional coercive cost for a selected scalar prefix. -/
def realFinitePrefixNormCost
    (m : ℕ) (x : Fin m → ℝ) : ENNReal :=
  ENNReal.ofReal ‖x‖

/-- The canonical prefix norm cost is measurable. -/
theorem real_finite_prefix_norm_cost_measurable
    (m : ℕ) : Measurable (realFinitePrefixNormCost m) := by
  unfold realFinitePrefixNormCost
  fun_prop

/-- Every finite prefix norm sublevel is compact. -/
theorem real_finite_prefix_norm_cost_compact_sublevel
    (m : ℕ) (R : ENNReal) (hR : R ≠ ⊤) :
    IsCompact {x : Fin m → ℝ | realFinitePrefixNormCost m x ≤ R} := by
  have hEq :
      {x : Fin m → ℝ | realFinitePrefixNormCost m x ≤ R} =
        Metric.closedBall (0 : Fin m → ℝ) R.toReal := by
    ext x
    simp only [realFinitePrefixNormCost, Set.mem_setOf_eq,
      Metric.mem_closedBall, dist_zero_right]
    rw [ENNReal.ofReal_le_iff_le_toReal hR]
    simp
  rw [hEq]
  exact ProperSpace.isCompact_closedBall _ _

/--
Physical D3 source after choosing one countable scalar observable family.
`sourceUniformNormMoment` is the actual Yang--Mills estimate still to be paid.
-/
structure RealCountableObservableNormMomentSource
    (Ω : Type*) [MeasurableSpace Ω] where
  cutoffLaw : ℕ → ProbabilityMeasure Ω
  observable : ℕ → Ω → ℝ
  observableMeasurable : ∀ i, Measurable (observable i)
  momentBound : ℕ → ENNReal
  sourceUniformNormMoment :
    ∀ (m k : ℕ),
      (∫⁻ x : Ω,
        realFinitePrefixNormCost m (countableObservablePrefix observable m x)
        ∂((cutoffLaw k : ProbabilityMeasure Ω) : Measure Ω)) ≤
      momentBound m
  threshold :
    ∀ (m : ℕ) (ε : ENNReal), 0 < ε →
      ∃ R : ENNReal,
        R ≠ 0 ∧ R ≠ ⊤ ∧ momentBound m / R ≤ ε

namespace RealCountableObservableNormMomentSource

/-- The canonical projective marginal family generated by the selected observables. -/
noncomputable def family
    {Ω : Type*} [MeasurableSpace Ω]
    (source : RealCountableObservableNormMomentSource Ω) :
    RealCanonicalProjectiveMarginalFamily Ω :=
  countableObservableMarginalFamily
    source.cutoffLaw source.observable source.observableMeasurable

/-- Compile native prefix moments into the existing same-source D3 moment interface. -/
noncomputable def toCanonicalMarginalMomentSource
    {Ω : Type*} [MeasurableSpace Ω]
    (source : RealCountableObservableNormMomentSource Ω) :
    RealCanonicalMarginalMomentSource Ω where
  family := source.family
  cost := realFinitePrefixNormCost
  costMeasurable := real_finite_prefix_norm_cost_measurable
  momentBound := source.momentBound
  sourceUniformMoment := by
    intro m k
    exact source.sourceUniformNormMoment m k
  compactSublevel := real_finite_prefix_norm_cost_compact_sublevel
  threshold := source.threshold

/-- Every selected finite-dimensional marginal family is tight. -/
theorem marginal_tight
    {Ω : Type*} [MeasurableSpace Ω]
    (source : RealCountableObservableNormMomentSource Ω)
    (m : ℕ) :
    IsTightMeasureSet
      {ν : Measure (Fin m → ℝ) |
        ∃ p ∈ Set.range (source.family.marginal m),
          ((p : ProbabilityMeasure (Fin m → ℝ)) : Measure (Fin m → ℝ)) = ν} :=
  source.toCanonicalMarginalMomentSource.marginal_tight m

/-- Coordinatewise tightness supplies one simultaneous finite-marginal subsequence. -/
theorem exists_simultaneous_subsequence
    {Ω : Type*} [MeasurableSpace Ω]
    (source : RealCountableObservableNormMomentSource Ω) :
    Nonempty (RealSimultaneousMarginalSubsequence source.family) :=
  exists_simultaneous_marginal_subsequence_of_tight
    source.family source.marginal_tight

/-- Fix one canonical simultaneous subsequence by classical choice. -/
noncomputable def diagonal
    {Ω : Type*} [MeasurableSpace Ω]
    (source : RealCountableObservableNormMomentSource Ω) :
    RealSimultaneousMarginalSubsequence source.family :=
  Classical.choice source.exists_simultaneous_subsequence

/-- The actual continuum probability law on the countable selected observables. -/
noncomputable def globalMeasure
    {Ω : Type*} [MeasurableSpace Ω]
    (source : RealCountableObservableNormMomentSource Ω) :
    Measure (ℕ → ℝ) :=
  source.diagonal.conditionalGlobalMeasure

instance globalMeasureIsProbability
    {Ω : Type*} [MeasurableSpace Ω]
    (source : RealCountableObservableNormMomentSource Ω) :
    IsProbabilityMeasure source.globalMeasure := by
  unfold globalMeasure
  infer_instance

/-- Every sequential prefix is exactly the corresponding simultaneous weak limit. -/
theorem globalMeasure_prefix
    {Ω : Type*} [MeasurableSpace Ω]
    (source : RealCountableObservableNormMomentSource Ω)
    (n : ℕ) :
    source.globalMeasure.map (frestrictLe n) =
      (realFinSuccLawToIic n (source.diagonal.limit (n + 1)) :
        Measure ((i : Set.Iic n) → ℝ)) := by
  exact source.diagonal.conditionalGlobalMeasure_prefix n

/-- The chosen cutoff subsequence is strict and works for every selected finite marginal. -/
theorem diagonal_converges
    {Ω : Type*} [MeasurableSpace Ω]
    (source : RealCountableObservableNormMomentSource Ω)
    (m : ℕ) :
    Tendsto
      (source.family.marginal m ∘ source.diagonal.subsequence)
      atTop (𝓝 (source.diagonal.limit m)) :=
  source.diagonal.converges m

end RealCountableObservableNormMomentSource

end RequestProject.YangMills
