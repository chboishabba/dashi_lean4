import Mathlib
import Integration.Experiment.ParameterRegion

/-!
# Stage 4, lane 1b — choosing the best next measurement in the continuous lane

`Integration.Experiment.ParameterRegion` proves a *pairwise* discrimination
result: of two readings of a parameter-affine family, generated by the same
parameter and carrying the same declared tolerance, the steeper one leaves the
smaller surviving region (`steeper_reading_contracts_more`).  That is a
comparison, not a choice.

This file turns it into an **optimisation over a finite candidate set**: given a
list of candidate readings, `steepest` selects one of maximal parameter
sensitivity `|slope t|`, and the selected reading is proved to contract the
surviving region — and therefore the prediction and risk envelopes — at least as
much as *every* candidate in the list.

## What is proved

* `steepest_mem` — the selection is one of the offered candidates (it never
  invents a measurement);
* `le_steepest`, `steepest_maximal` — it attains the maximal `|slope|` over the
  candidate list;
* `steepest_contracts_most` — the surviving region after the selected reading is
  contained in the surviving region after any candidate;
* `steepest_envelope_smallest`, `steepest_riskEnvelope_smallest` — hence its
  prediction and risk envelopes are the smallest offered;
* `steepest_of_flat_candidates_is_no_better` — the honest negative: when every
  candidate has the same sensitivity the "best" choice contracts no more than
  any other, so the ranking is a statement about *these declared comparisons*
  and not a claim that some measurement is intrinsically better.

## Claim boundary

`|slope t|` is the parameter sensitivity of a *declared* affine family, the
tolerance is declared, and the hypotheses require the candidates to be generated
by one common parameter value with a common tolerance — exactly the setting of
`steeper_reading_contracts_more`.  Nothing here is probabilistic: no candidate is
assigned an information content, and no optimality is claimed beyond set
inclusion of the surviving regions.
-/

namespace Integration.Experiment.BestReading

open Integration.Experiment.ParameterRegion

variable (slope : ℝ → ℝ)

/-- Select, from `r :: cs`, a reading whose prediction depends most steeply on
the parameter. -/
noncomputable def steepest : Reading → List Reading → Reading
  | r, [] => r
  | r, c :: cs => if |slope r.time| ≤ |slope c.time| then steepest c cs else steepest r cs

@[simp] theorem steepest_nil (r : Reading) : steepest slope r [] = r := rfl

/-- The selection is always one of the offered candidates. -/
theorem steepest_mem : ∀ (cs : List Reading) (r : Reading), steepest slope r cs ∈ r :: cs := by
  intro cs
  induction cs with
  | nil => intro r; simp
  | cons c cs ih =>
      intro r
      rw [steepest]
      by_cases h : |slope r.time| ≤ |slope c.time|
      · rw [if_pos h]
        rcases List.mem_cons.mp (ih c) with h' | h'
        · exact List.mem_cons_of_mem _ (by rw [h']; exact List.mem_cons_self ..)
        · exact List.mem_cons_of_mem _ (List.mem_cons_of_mem _ h')
      · rw [if_neg h]
        rcases List.mem_cons.mp (ih r) with h' | h'
        · rw [h']; exact List.mem_cons_self ..
        · exact List.mem_cons_of_mem _ (List.mem_cons_of_mem _ h')

/-- The selection is at least as steep as the reading it started from. -/
theorem le_steepest : ∀ (cs : List Reading) (r : Reading),
    |slope r.time| ≤ |slope (steepest slope r cs).time| := by
  intro cs
  induction cs with
  | nil => intro r; simp
  | cons c cs ih =>
      intro r
      rw [steepest]
      by_cases h : |slope r.time| ≤ |slope c.time|
      · rw [if_pos h]; exact h.trans (ih c)
      · rw [if_neg h]; exact ih r

/-- The selection attains the maximal sensitivity over the whole candidate
list. -/
theorem steepest_maximal : ∀ (cs : List Reading) (r : Reading), ∀ c ∈ r :: cs,
    |slope c.time| ≤ |slope (steepest slope r cs).time| := by
  intro cs
  induction cs with
  | nil =>
      intro r c hc
      rcases List.mem_cons.mp hc with rfl | hc
      · simp
      · simp at hc
  | cons d ds ih =>
      intro r c hc
      rw [steepest]
      by_cases h : |slope r.time| ≤ |slope d.time|
      · rw [if_pos h]
        rcases List.mem_cons.mp hc with rfl | hc
        · exact h.trans (le_steepest slope ds d)
        · exact ih d c hc
      · rw [if_neg h]
        rcases List.mem_cons.mp hc with rfl | hc
        · exact le_steepest slope ds c
        · rcases List.mem_cons.mp hc with rfl | hc
          · exact (le_of_not_ge h).trans (le_steepest slope ds r)
          · exact ih r c (List.mem_cons_of_mem _ hc)

section Contraction

variable (prior : Set ℝ) (base : ℝ → ℝ) (E : List Reading) (θstar : ℝ)

/-- **The selected reading contracts the surviving region most.**  Every
candidate is generated by the common parameter `θstar` and carries the common
tolerance `tol`; then adding the selected reading to the evidence leaves no more
parameters alive than adding any other candidate. -/
theorem steepest_contracts_most (r : Reading) (cs : List Reading) (tol : ℝ)
    (hgen : ∀ c ∈ r :: cs, c.value = base c.time + slope c.time * θstar)
    (htol : ∀ c ∈ r :: cs, c.tol = tol) (c : Reading) (hc : c ∈ r :: cs) :
    Compatible (affineFamily prior base slope) (steepest slope r cs :: E) ⊆
      Compatible (affineFamily prior base slope) (c :: E) :=
  steeper_reading_leaves_smaller_region prior base slope E c (steepest slope r cs) θstar
    (hgen c hc) (hgen _ (steepest_mem slope cs r))
    ((htol c hc).trans (htol _ (steepest_mem slope cs r)).symm)
    (steepest_maximal slope cs r c hc)

/-- Hence the prediction envelope after the selected reading is the smallest
offered. -/
theorem steepest_envelope_smallest (r : Reading) (cs : List Reading) (tol : ℝ)
    (hgen : ∀ c ∈ r :: cs, c.value = base c.time + slope c.time * θstar)
    (htol : ∀ c ∈ r :: cs, c.tol = tol) (C : ℝ → ℝ) (c : Reading) (hc : c ∈ r :: cs) :
    envelope (affineFamily prior base slope) (steepest slope r cs :: E) C ⊆
      envelope (affineFamily prior base slope) (c :: E) C :=
  Set.image_mono
    (steepest_contracts_most slope prior base E θstar r cs tol hgen htol c hc)

/-- And so is the risk envelope. -/
theorem steepest_riskEnvelope_smallest {Z : Type*} (r : Reading) (cs : List Reading) (tol : ℝ)
    (hgen : ∀ c ∈ r :: cs, c.value = base c.time + slope c.time * θstar)
    (htol : ∀ c ∈ r :: cs, c.tol = tol) (R : ℝ → Z) (c : Reading) (hc : c ∈ r :: cs) :
    riskEnvelope (affineFamily prior base slope) (steepest slope r cs :: E) R ⊆
      riskEnvelope (affineFamily prior base slope) (c :: E) R :=
  Set.image_mono
    (steepest_contracts_most slope prior base E θstar r cs tol hgen htol c hc)

end Contraction

/-- **The honest negative.**  When every candidate has the same parameter
sensitivity, the selection is not better than any other candidate: the surviving
regions coincide.  So the ranking above is a consequence of the declared
sensitivities, not a claim that measurement choice always helps. -/
theorem steepest_of_flat_candidates_is_no_better (prior : Set ℝ) (base : ℝ → ℝ)
    (E : List Reading) (θstar : ℝ) (r : Reading) (cs : List Reading) (tol : ℝ)
    (hgen : ∀ c ∈ r :: cs, c.value = base c.time + slope c.time * θstar)
    (htol : ∀ c ∈ r :: cs, c.tol = tol)
    (hflat : ∀ c ∈ r :: cs, |slope c.time| = |slope r.time|)
    (c : Reading) (hc : c ∈ r :: cs) :
    Compatible (affineFamily prior base slope) (c :: E) =
      Compatible (affineFamily prior base slope) (steepest slope r cs :: E) := by
  refine Set.Subset.antisymm ?_
    (steepest_contracts_most slope prior base E θstar r cs tol hgen htol c hc)
  refine steeper_reading_leaves_smaller_region prior base slope E
    (steepest slope r cs) c θstar (hgen _ (steepest_mem slope cs r)) (hgen c hc)
    ((htol _ (steepest_mem slope cs r)).trans (htol c hc).symm) ?_
  rw [hflat _ (steepest_mem slope cs r), hflat c hc]

end Integration.Experiment.BestReading
