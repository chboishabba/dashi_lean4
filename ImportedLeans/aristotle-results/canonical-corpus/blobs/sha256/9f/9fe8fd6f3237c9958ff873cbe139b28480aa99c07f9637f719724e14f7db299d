    ; distanceToFixedPoint = shiftFlowDistanceToFixedPoint
    ; horizon = shiftFlowHorizon
    ; fixedPointStable = PGFSI.shiftFlowHeldStableWitness
    ; horizonLands = shiftFlowHorizonLands
