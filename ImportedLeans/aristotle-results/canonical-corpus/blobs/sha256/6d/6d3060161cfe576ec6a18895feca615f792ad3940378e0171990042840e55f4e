record InvertibleNat (S : Set) : Set where
  field
    step  : S → S
    inv   : S → S
    left  : ∀ s → inv (step s) ≡ s
    right : ∀ s → step (inv s) ≡ s
    H     : S → Nat

-- Invertible step implies you can “walk backwards forever”,
-- contradicting strict descent everywhere.
invertible-no-strict-descent :
  ∀ {S} (U : InvertibleNat S) →
