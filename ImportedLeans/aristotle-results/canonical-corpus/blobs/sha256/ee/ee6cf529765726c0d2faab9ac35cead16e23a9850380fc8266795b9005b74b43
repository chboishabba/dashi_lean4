                 (cup∙ (suc n) (suc m) (EM-raw→EM _ _ a) .fst
                   (EM-raw'→EM H' (suc m) y)) (EM-raw'→EM L' (suc l) z))
        ∙∙ cong (EM→ΩEM+1 (suc (suc (suc (n + m + l)))))
