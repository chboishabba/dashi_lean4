namespace Wikidata

/-- `P361`, "part of". -/
def P361 : Pid := ⟨361⟩

/-- The truthy statements of `kb` using property `p`. -/
def truthyStatementsFor (kb : KB) (p : Pid) : List Statement :=
  kb.statements.filter (fun st => st.property = p ∧ IsTruthy kb st = true)

theorem mem_truthyStatementsFor (kb : KB) (p : Pid) (st : Statement) :
    st ∈ truthyStatementsFor kb p ↔
      st ∈ kb.statements ∧ st.property = p ∧ IsTruthy kb st = true := by
  simp [truthyStatementsFor, List.mem_filter]

/-! ## The constraints -/

/-- Single value: a subject has at most one truthy value for `p`. -/
def SingleValue (kb : KB) (p : Pid) : Prop :=
  ∀ st₁ ∈ truthyStatementsFor kb p, ∀ st₂ ∈ truthyStatementsFor kb p,
    st₁.subject = st₂.subject → st₁.value = st₂.value

/-- Distinct value: a value is used by at most one subject for `p`. -/
def DistinctValue (kb : KB) (p : Pid) : Prop :=
  ∀ st₁ ∈ truthyStatementsFor kb p, ∀ st₂ ∈ truthyStatementsFor kb p,
    st₁.value = st₂.value → st₁.subject = st₂.subject

/-- Subject type: every subject of a truthy `p`-statement instantiates one of `cs`. -/
def SubjectType (kb : KB) (p : Pid) (cs : List Qid) : Prop :=
  ∀ st ∈ truthyStatementsFor kb p, ∃ c ∈ cs, InstanceOf kb st.subject c

/-- Value type: every value of a truthy `p`-statement instantiates one of `cs`. -/
def ValueType (kb : KB) (p : Pid) (cs : List Qid) : Prop :=
  ∀ st ∈ truthyStatementsFor kb p, ∃ c ∈ cs, InstanceOf kb st.value c

/-- Schema profile: every known instance of `c` carries a truthy statement for
each property in `ps`. -/
def ProfileComplete (kb : KB) (c : Qid) (ps : List Pid) : Prop :=
  ∀ x ∈ kb.entities, InstanceOf kb x c →
    ∀ p ∈ ps, ∃ st ∈ truthyStatementsFor kb p, st.subject = x

/-! ## Executable checkers -/

def singleValueOk (kb : KB) (p : Pid) : Bool :=
  (truthyStatementsFor kb p).all fun st₁ =>
    (truthyStatementsFor kb p).all fun st₂ => st₁.subject = st₂.subject → st₁.value = st₂.value

def distinctValueOk (kb : KB) (p : Pid) : Bool :=
  (truthyStatementsFor kb p).all fun st₁ =>
    (truthyStatementsFor kb p).all fun st₂ => st₁.value = st₂.value → st₁.subject = st₂.subject

def subjectTypeOk (kb : KB) (p : Pid) (cs : List Qid) : Bool :=
  (truthyStatementsFor kb p).all fun st => cs.any fun c => isInstanceOf kb st.subject c

def valueTypeOk (kb : KB) (p : Pid) (cs : List Qid) : Bool :=
  (truthyStatementsFor kb p).all fun st => cs.any fun c => isInstanceOf kb st.value c

def profileCompleteOk (kb : KB) (c : Qid) (ps : List Pid) : Bool :=
  kb.entities.all fun x => !isInstanceOf kb x c ||
    ps.all fun p => (truthyStatementsFor kb p).any fun st => st.subject = x

theorem singleValueOk_iff (kb : KB) (p : Pid) : singleValueOk kb p = true ↔ SingleValue kb p := by
  simp [singleValueOk, SingleValue, List.all_eq_true, imp_iff_not_or]

theorem distinctValueOk_iff (kb : KB) (p : Pid) :
    distinctValueOk kb p = true ↔ DistinctValue kb p := by
  simp [distinctValueOk, DistinctValue, List.all_eq_true, imp_iff_not_or]

theorem subjectTypeOk_iff (kb : KB) (p : Pid) (cs : List Qid) :
    subjectTypeOk kb p cs = true ↔ SubjectType kb p cs := by
  simp only [subjectTypeOk, SubjectType, List.all_eq_true, List.any_eq_true, isInstanceOf_iff]

theorem valueTypeOk_iff (kb : KB) (p : Pid) (cs : List Qid) :
    valueTypeOk kb p cs = true ↔ ValueType kb p cs := by
  simp only [valueTypeOk, ValueType, List.all_eq_true, List.any_eq_true, isInstanceOf_iff]

theorem profileCompleteOk_iff (kb : KB) (c : Qid) (ps : List Pid) :
    profileCompleteOk kb c ps = true ↔ ProfileComplete kb c ps := by
  simp only [profileCompleteOk, ProfileComplete, List.all_eq_true, List.any_eq_true,
    Bool.or_eq_true, Bool.not_eq_true', decide_eq_true_eq]
  constructor
  · intro h x hx hinst p hp
    rcases h x hx with hfalse | hall
    · rw [(isInstanceOf_iff kb x c).2 hinst] at hfalse
      exact absurd hfalse (by simp)
    · exact hall p hp
  · intro h x hx
    by_cases hinst : isInstanceOf kb x c = true
    · exact Or.inr (h x hx ((isInstanceOf_iff kb x c).1 hinst))
    · exact Or.inl (by simpa using hinst)

/-! ## The constraint report -/

/-- A constraint that can be checked against a knowledge base. -/
inductive Constraint
  | singleValue (p : Pid)
  | distinctValue (p : Pid)
  | subjectType (p : Pid) (cs : List Qid)
  | valueType (p : Pid) (cs : List Qid)
  | profile (c : Qid) (ps : List Pid)
  deriving DecidableEq, Repr, Inhabited

namespace Constraint

/-- What a constraint asserts. -/
def Holds (kb : KB) : Constraint → Prop
  | singleValue p => SingleValue kb p
  | distinctValue p => DistinctValue kb p
  | subjectType p cs => SubjectType kb p cs
  | valueType p cs => ValueType kb p cs
  | profile c ps => ProfileComplete kb c ps

/-- The executable check for a constraint. -/
def check (kb : KB) : Constraint → Bool
  | singleValue p => singleValueOk kb p
  | distinctValue p => distinctValueOk kb p
  | subjectType p cs => subjectTypeOk kb p cs
  | valueType p cs => valueTypeOk kb p cs
  | profile c ps => profileCompleteOk kb c ps

/-- **Constraint checker exactness.** -/
theorem check_iff (kb : KB) (con : Constraint) : con.check kb = true ↔ con.Holds kb := by
  cases con with
  | singleValue p => exact singleValueOk_iff kb p
  | distinctValue p => exact distinctValueOk_iff kb p
  | subjectType p cs => exact subjectTypeOk_iff kb p cs
  | valueType p cs => exact valueTypeOk_iff kb p cs
  | profile c ps => exact profileCompleteOk_iff kb c ps

theorem not_holds_of_check_false {kb : KB} {con : Constraint} (h : con.check kb = false) :
    ¬ con.Holds kb := by
  intro hc
  rw [(check_iff kb con).2 hc] at h
  exact Bool.noConfusion h

end Constraint

/-- The constraints from `cons` that fail on `kb`. -/
def violations (kb : KB) (cons : List Constraint) : List Constraint :=
  cons.filter (fun con => !con.check kb)

/-- **Report exactness**: no violations exactly when every constraint holds. -/
theorem violations_eq_nil_iff (kb : KB) (cons : List Constraint) :
    violations kb cons = [] ↔ ∀ con ∈ cons, con.Holds kb := by
  simp only [violations, List.filter_eq_nil_iff, Bool.not_eq_true']
  exact forall₂_congr fun con _ => by rw [← Constraint.check_iff kb con]; simp

theorem mem_violations_iff (kb : KB) (cons : List Constraint) (con : Constraint) :
    con ∈ violations kb cons ↔ con ∈ cons ∧ ¬ con.Holds kb := by
  simp only [violations, List.mem_filter, Bool.not_eq_true', ← Constraint.check_iff kb con]
  exact and_congr_right fun _ => by simp

/-! ## The mereology / class-order separation -/

/-- The knowledge base with one more statement. -/
def addStatement (kb : KB) (st : Statement) : KB :=
  { kb with statements := kb.statements ++ [st] }

@[simp] theorem addStatement_entities (kb : KB) (st : Statement) :
    (addStatement kb st).entities = kb.entities := rfl

theorem hasPreferred_addStatement {kb : KB} {st : Statement} (hrank : st.rank ≠ Rank.preferred)
    (s : Qid) (p : Pid) : hasPreferred (addStatement kb st) s p = hasPreferred kb s p := by
  simp only [hasPreferred, statementsFor, addStatement, List.filter_append, List.any_append,
    List.any_filter]
  simp [hrank]

theorem isTruthy_addStatement {kb : KB} {st : Statement} (hrank : st.rank ≠ Rank.preferred)
    (st' : Statement) : IsTruthy (addStatement kb st) st' = IsTruthy kb st' := by
  simp [IsTruthy, hasPreferred_addStatement hrank]

/-- Adding a non-preferred statement whose property is not `P279` leaves the
subclass graph alone. -/
theorem subclassEdges_addStatement {kb : KB} {st : Statement} (hrank : st.rank ≠ Rank.preferred)
    (hp : st.property ≠ P279) :
    subclassEdges (addStatement kb st) = subclassEdges kb := by
  have hf : IsTruthy (addStatement kb st) = IsTruthy kb :=
    funext (isTruthy_addStatement hrank)
  have hst : (addStatement kb st).statements = kb.statements ++ [st] := rfl
  simp only [subclassEdges, hf, hst, List.filter_append, List.map_append]
  simp [hp]

/-- Adding a non-preferred statement whose property is not `P31` leaves the
instance graph alone. -/
theorem instanceEdges_addStatement {kb : KB} {st : Statement} (hrank : st.rank ≠ Rank.preferred)
    (hp : st.property ≠ P31) :
    instanceEdges (addStatement kb st) = instanceEdges kb := by
  have hf : IsTruthy (addStatement kb st) = IsTruthy kb :=
    funext (isTruthy_addStatement hrank)
  have hst : (addStatement kb st).statements = kb.statements ++ [st] := rfl
  simp only [instanceEdges, hf, hst, List.filter_append, List.map_append]
  simp [hp]

/-- **Inertness for the subclass relation.** -/
theorem subclassOf_append_inert_iff {kb : KB} {st : Statement} (hrank : st.rank ≠ Rank.preferred)
    (hp : st.property ≠ P279) (a b : Qid) :
    SubclassOf (addStatement kb st) a b ↔ SubclassOf kb a b := by
  have h : DirectSubclass (addStatement kb st) = DirectSubclass kb := by
    funext x y
    simp [DirectSubclass, subclassEdges_addStatement hrank hp]
  simp [SubclassOf, h]

/-- **Inertness for the instance relation.** -/
theorem instanceOf_append_inert_iff {kb : KB} {st : Statement} (hrank : st.rank ≠ Rank.preferred)
    (hp279 : st.property ≠ P279) (hp31 : st.property ≠ P31) (x c : Qid) :
    InstanceOf (addStatement kb st) x c ↔ InstanceOf kb x c := by
  simp only [InstanceOf, instanceEdges_addStatement hrank hp31]
  exact exists_congr fun c₀ => and_congr_right fun _ =>
    subclassOf_append_inert_iff hrank hp279 c₀ c

theorem p361_ne_p279 : P361 ≠ P279 := by decide
theorem p361_ne_p31 : P361 ≠ P31 := by decide

/-- **Parthood does not touch the class order**: recording that one item is part
of another changes neither the subclass nor the instance relation. -/
theorem partOf_inert {kb : KB} {x y : Qid} {r : Rank} (hrank : r ≠ Rank.preferred) :
    (∀ a b, SubclassOf (addStatement kb ⟨x, P361, y, r⟩) a b ↔ SubclassOf kb a b) ∧
      (∀ a c, InstanceOf (addStatement kb ⟨x, P361, y, r⟩) a c ↔ InstanceOf kb a c) :=
  ⟨fun a b => subclassOf_append_inert_iff hrank p361_ne_p279 a b,
   fun a c => instanceOf_append_inert_iff hrank p361_ne_p279 p361_ne_p31 a c⟩

/-! ## Parthood in its own right -/

/-- The truthy `P361` edges. -/
def partEdges (kb : KB) : List (Qid × Qid) :=
  (truthyStatementsFor kb P361).map (fun st => (st.subject, st.value))

/-- Direct parthood. -/
def DirectPartOf (kb : KB) (x y : Qid) : Prop := (x, y) ∈ partEdges kb

/-- Parthood: the transitive closure of the direct part-of edges.  It is *not*
reflexive, unlike the subclass relation. -/
def PartOf (kb : KB) (x y : Qid) : Prop := Relation.TransGen (DirectPartOf kb) x y

theorem partOf_trans {kb : KB} {x y z : Qid} (h₁ : PartOf kb x y) (h₂ : PartOf kb y z) :
    PartOf kb x z := Relation.TransGen.trans h₁ h₂

theorem partOf_of_direct {kb : KB} {x y : Qid} (h : DirectPartOf kb x y) : PartOf kb x y :=
  Relation.TransGen.single h

/-- The direct parts-of successors of an item. -/
def partSuccessors (kb : KB) (x : Qid) : List Qid :=
  (partEdges kb).filterMap (fun e => if e.1 = x then some e.2 else none)

theorem mem_partSuccessors_iff (kb : KB) (x y : Qid) :
    y ∈ partSuccessors kb x ↔ (x, y) ∈ partEdges kb := by
  constructor
  · intro h
    simp only [partSuccessors, List.mem_filterMap] at h
    obtain ⟨e, he, heq⟩ := h
    by_cases h1 : e.1 = x
    · simp only [h1] at heq
      have : e = (x, y) := by
        cases e with
        | mk u v => simp_all
      exact this ▸ he
    · simp [h1] at heq
  · intro h
    simp only [partSuccessors, List.mem_filterMap]
    exact ⟨(x, y), h, by simp⟩

/-- The reflexive-transitive parthood checker. -/
def isPartOfRefl (kb : KB) (x y : Qid) : Bool :=
  Wikidata.Reach.reachIn (partSuccessors kb) (partEdges kb).length x y

theorem isPartOfRefl_iff (kb : KB) (x y : Qid) :
    isPartOfRefl kb x y = true ↔ Relation.ReflTransGen (DirectPartOf kb) x y := by
  have hstep : Wikidata.Reach.Step (partSuccessors kb) = DirectPartOf kb := by
    funext u v
    exact propext (mem_partSuccessors_iff kb u v)
  have hlen : ((partEdges kb).map Prod.snd).length = (partEdges kb).length := by simp
  have := Wikidata.Reach.reachIn_iff (succ := partSuccessors kb)
    (objs := (partEdges kb).map Prod.snd)
    (by
      intro u v hv
      rw [mem_partSuccessors_iff] at hv
      exact List.mem_map.2 ⟨(u, v), hv, rfl⟩) x y
  rw [hlen] at this
  rw [isPartOfRefl, this, hstep]

/-- The executable parthood checker. -/
def isPartOf (kb : KB) (x y : Qid) : Bool :=
  (partSuccessors kb x).any (fun z => isPartOfRefl kb z y)

/-- **Exactness of the parthood engine.** -/
theorem isPartOf_iff (kb : KB) (x y : Qid) : isPartOf kb x y = true ↔ PartOf kb x y := by
  simp only [isPartOf, List.any_eq_true, PartOf, Relation.TransGen.head'_iff,
    isPartOfRefl_iff, mem_partSuccessors_iff]
  rfl

instance (kb : KB) (x y : Qid) : Decidable (PartOf kb x y) :=
  decidable_of_iff _ (isPartOf_iff kb x y)

end Wikidata
