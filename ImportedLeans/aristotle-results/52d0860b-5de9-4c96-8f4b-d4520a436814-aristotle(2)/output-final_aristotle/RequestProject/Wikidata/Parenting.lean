namespace Wikidata

/-! ## Parent properties -/

/-- `P22`, "father". -/
def P22 : Pid := ⟨22⟩
/-- `P25`, "mother". -/
def P25 : Pid := ⟨25⟩
/-- `P8810`, "parent" (generic, unspecified). -/
def P8810 : Pid := ⟨8810⟩
/-- `P1531`, "parent of this hybrid, breed, or cultivar". -/
def P1531 : Pid := ⟨1531⟩

/-- The slots that record parenthood of an individual. -/
def parentSlots : List Pid := [P22, P25, P8810]

/-- The two *typed* slots, the only ones that assert a genetic parent. -/
def geneticSlots : List Pid := [P22, P25]

/-! ## A reachability engine for an arbitrary edge list

The subclass engine of `RequestProject.Wikidata.Core` is specific to `P279`.
Parenthood needs the same construction over a different edge set, so it is done
once and for all here. -/

namespace Edges

variable (edges : List (Qid × Qid))

/-- Successors of a node in an edge list. -/
def succ (a : Qid) : List Qid :=
  edges.filterMap (fun e => if e.1 = a then some e.2 else none)

theorem mem_succ_iff (a b : Qid) : b ∈ succ edges a ↔ (a, b) ∈ edges := by
  constructor
  · intro h
    simp only [succ, List.mem_filterMap] at h
    obtain ⟨e, he, heq⟩ := h
    by_cases h1 : e.1 = a
    · simp only [h1, if_true] at heq
      have : e = (a, b) := by
        cases e with
        | mk x y => simp_all
      exact this ▸ he
    · simp [h1] at heq
  · intro h
    simp only [succ, List.mem_filterMap]
    exact ⟨(a, b), h, by simp⟩

/-- The declarative one-step relation of an edge list. -/
def Direct (a b : Qid) : Prop := (a, b) ∈ edges

instance (a b : Qid) : Decidable (Direct edges a b) :=
  inferInstanceAs (Decidable ((a, b) ∈ edges))

/-- The reflexive transitive closure of an edge list. -/
def Reach (a b : Qid) : Prop := Relation.ReflTransGen (Direct edges) a b

/-- The executable closure checker for an edge list. -/
def reach (a b : Qid) : Bool :=
  Wikidata.Reach.reachIn (succ edges) edges.length a b

/-- **Exactness of the edge-list reachability engine.** -/
theorem reach_iff (a b : Qid) : reach edges a b = true ↔ Reach edges a b := by
  have hstep : Wikidata.Reach.Step (succ edges) = Direct edges := by
    funext x y
    exact propext (mem_succ_iff edges x y)
  have hlen : (edges.map Prod.snd).length = edges.length := by simp
  have := Wikidata.Reach.reachIn_iff (succ := succ edges) (objs := edges.map Prod.snd)
    (by
      intro x y hy
      rw [mem_succ_iff] at hy
      exact List.mem_map.2 ⟨(x, y), hy, rfl⟩) a b
  rw [hlen] at this
  rw [reach, this, hstep]
  rfl

instance (a b : Qid) : Decidable (Reach edges a b) :=
  decidable_of_iff _ (reach_iff edges a b)

/-- Reachability is monotone in the edge list. -/
theorem reach_mono {edges' : List (Qid × Qid)} (h : ∀ e ∈ edges, e ∈ edges') {a b : Qid}
    (hr : Reach edges a b) : Reach edges' a b := by
  induction hr with
  | refl => exact Relation.ReflTransGen.refl
  | tail _ hstep ih => exact Relation.ReflTransGen.tail ih (h _ hstep)

end Edges

/-! ## The parent engine -/

/-- The truthy recorded-parent edges: child to recorded parent, over `P22`, `P25`
and `P8810`. -/
def parentEdges (kb : KB) : List (Qid × Qid) :=
  (kb.statements.filter (fun st => st.property ∈ parentSlots ∧ IsTruthy kb st = true)).map
    (fun st => (st.subject, st.value))

/-- The truthy edges recorded in the two typed genetic slots. -/
def geneticEdges (kb : KB) : List (Qid × Qid) :=
  (kb.statements.filter (fun st => st.property ∈ geneticSlots ∧ IsTruthy kb st = true)).map
    (fun st => (st.subject, st.value))

/-- The recorded parents of an entity. -/
def parentsOf (kb : KB) (a : Qid) : List Qid := Edges.succ (parentEdges kb) a

/-- The declarative descent relation: the reflexive transitive closure of the
recorded parent edges. -/
def DescendsFrom (kb : KB) (a b : Qid) : Prop := Edges.Reach (parentEdges kb) a b

/-- The executable descent checker. -/
def descendsFrom (kb : KB) (a b : Qid) : Bool := Edges.reach (parentEdges kb) a b

/-- **Exactness of the descent engine.** -/
theorem descendsFrom_iff (kb : KB) (a b : Qid) :
    descendsFrom kb a b = true ↔ DescendsFrom kb a b := Edges.reach_iff _ a b

instance (kb : KB) (a b : Qid) : Decidable (DescendsFrom kb a b) :=
  decidable_of_iff _ (descendsFrom_iff kb a b)

/-- The declarative genetic descent relation. -/
def GeneticDescendsFrom (kb : KB) (a b : Qid) : Prop := Edges.Reach (geneticEdges kb) a b

/-- The executable genetic descent checker. -/
def geneticDescendsFrom (kb : KB) (a b : Qid) : Bool := Edges.reach (geneticEdges kb) a b

/-- **Exactness of the genetic descent engine.** -/
theorem geneticDescendsFrom_iff (kb : KB) (a b : Qid) :
    geneticDescendsFrom kb a b = true ↔ GeneticDescendsFrom kb a b := Edges.reach_iff _ a b

instance (kb : KB) (a b : Qid) : Decidable (GeneticDescendsFrom kb a b) :=
  decidable_of_iff _ (geneticDescendsFrom_iff kb a b)

theorem geneticEdges_subset_parentEdges (kb : KB) :
    ∀ e ∈ geneticEdges kb, e ∈ parentEdges kb := by
  intro e he
  simp only [geneticEdges, parentEdges, List.mem_map, List.mem_filter] at he ⊢
  obtain ⟨st, ⟨hst, hp⟩, heq⟩ := he
  refine ⟨st, ⟨hst, ?_⟩, heq⟩
  simp only [decide_eq_true_eq] at hp ⊢
  refine ⟨?_, hp.2⟩
  have := hp.1
  simp only [geneticSlots, List.mem_cons, List.not_mem_nil, or_false] at this
  simp only [parentSlots, List.mem_cons, List.not_mem_nil, or_false]
  tauto

/-- Genetic descent is recorded descent. -/
theorem descendsFrom_of_geneticDescendsFrom {kb : KB} {a b : Qid}
    (h : GeneticDescendsFrom kb a b) : DescendsFrom kb a b :=
  Edges.reach_mono (edges := geneticEdges kb) (geneticEdges_subset_parentEdges kb) h

/-! ## The genetic cardinality cap -/

/-- The truthy values of one slot of one subject. -/
def truthyValues (kb : KB) (x : Qid) (p : Pid) : List Qid :=
  (kb.statements.filter (fun st => st.subject = x ∧ st.property = p ∧ IsTruthy kb st = true)).map
    (fun st => st.value)

/-- The genetic parents of `x` as recorded in the two typed slots. -/
def geneticParentsF (kb : KB) (x : Qid) : List Qid :=
  truthyValues kb x P22 ++ truthyValues kb x P25

-- @source DASHI Agda bridge (PR #555/#581): genetic-parent cap scoped to the two typed slots
/-- Each typed genetic slot carries at most one truthy value for `x`. -/
def SingleGeneticSlots (kb : KB) (x : Qid) : Prop :=
  (truthyValues kb x P22).length ≤ 1 ∧ (truthyValues kb x P25).length ≤ 1

-- @source DASHI Agda bridge (PR #555/#581): genetic-parent cap scoped to the two typed slots
/-- **The cardinality cap**, scoped exactly to the single-value profile of the two
typed slots: an entity then has at most two recorded genetic parents. -/
theorem card_geneticParentsF_le_two {kb : KB} {x : Qid} (h : SingleGeneticSlots kb x) :
    (geneticParentsF kb x).length ≤ 2 := by
  obtain ⟨h22, h25⟩ := h
  simp only [geneticParentsF, List.length_append]
  omega

theorem mem_geneticParentsF_iff (kb : KB) (x b : Qid) :
    b ∈ geneticParentsF kb x ↔ (x, b) ∈ geneticEdges kb := by
  simp only [geneticParentsF, geneticEdges, truthyValues, List.mem_append, List.mem_map,
    List.mem_filter, decide_eq_true_eq, Prod.mk.injEq]
  constructor
  · rintro (⟨st, ⟨hst, hx, hp, ht⟩, rfl⟩ | ⟨st, ⟨hst, hx, hp, ht⟩, rfl⟩) <;>
      exact ⟨st, ⟨hst, by simp [geneticSlots, hp], ht⟩, by simp [hx]⟩
  · rintro ⟨st, ⟨hst, hp, ht⟩, hx, hv⟩
    have hp' : st.property = P22 ∨ st.property = P25 := by
      simpa [geneticSlots] using hp
    cases hp' with
    | inl h => exact Or.inl ⟨st, ⟨hst, hx.symm ▸ rfl, h, ht⟩, hv⟩
    | inr h => exact Or.inr ⟨st, ⟨hst, hx.symm ▸ rfl, h, ht⟩, hv⟩

/-! ## Generation events and progeniture

The recorded slots are a *representation*.  Underneath sits the generative event
itself, whose progenitors are an arbitrary finite list: the exact-two profile is
one possibility among others, not a law. -/

/-- The mode of a progenitor's contribution. -/
inductive ProgenitorMode
  | genericLineage
  | gametic
  | nuclear
  | mitochondrial
  deriving DecidableEq, Repr, Inhabited

/-- One progenitor's contribution to a generation event. -/
structure ProgenitorContribution where
  /-- The contributing entity. -/
  entity : Qid
  /-- How it contributed. -/
  mode : ProgenitorMode
  deriving DecidableEq, Repr, Inhabited

/-- The reproductive profile assumed of a generation event. -/
inductive ReproductiveProfile
  | unrestricted
  | ordinaryBiparentalNuclear
  deriving DecidableEq, Repr, Inhabited

/-- Whether the generated node is an individual or a lineage. -/
inductive NodeLevel
  | individual
  | lineage
  deriving DecidableEq, Repr, Inhabited

-- @source DASHI Agda bridge (PR #555/#581): `GenerationEvent` with arbitrary finite `progenitors`
/-- A generation event: an entity, the level at which it is generated, its
progenitors, and the reproductive profile assumed. -/
structure GenerationEvent where
  /-- The entity that was generated. -/
  generated : Qid
  /-- Individual or lineage. -/
  level : NodeLevel
  /-- The lineage-bearing contributors. -/
  progenitors : List ProgenitorContribution
  /-- The profile assumed of the event. -/
  profile : ReproductiveProfile
  deriving Repr, Inhabited

-- @source DASHI Agda bridge (PR #555/#581): `GenerationEvent` with arbitrary finite `progenitors`
/-- The number of progenitors of a generation event. -/
def GenerationEvent.progenitorCount (e : GenerationEvent) : Nat := e.progenitors.length

/-- A merely causal input to a generation event, which may or may not bear
lineage. -/
structure CausalInput where
  /-- The contributing entity. -/
  entity : Qid
  /-- It took part in the causal process. -/
  participatesCausally : Bool
  /-- It carries lineage. -/
  lineageBearing : Bool
  deriving DecidableEq, Repr, Inhabited

/-- An incubator: causally involved, carries no lineage. -/
def incubatorInput : CausalInput := ⟨⟨0⟩, true, false⟩

/-- **Causal participation does not make a progenitor.** -/
theorem causal_input_is_not_progenitor :
    incubatorInput.participatesCausally = true ∧ incubatorInput.lineageBearing = false := by
  decide

-- @source DASHI Agda bridge (PR #555/#581): exact-two cardinality stays behind `BiparentalNuclearWitness`
/-- The exact-two claim, as an explicit hypothesis rather than an axiom. -/
structure BiparentalNuclearWitness (e : GenerationEvent) : Prop where
  /-- The event is assumed to follow the ordinary biparental nuclear profile. -/
  profile_eq : e.profile = ReproductiveProfile.ordinaryBiparentalNuclear
  /-- Under that profile the event has exactly two progenitors. -/
  count_eq : e.progenitorCount = 2

-- @source DASHI Agda bridge (PR #555/#581): exact-two cardinality stays behind `BiparentalNuclearWitness`
/-- **Exactly two progenitors remains behind its witness.** -/
theorem exactly_two_requires_biparental_witness (e : GenerationEvent)
    (w : BiparentalNuclearWitness e) : e.progenitorCount = 2 := w.count_eq

/-- Triparental *Arabidopsis*: selective egg-cell polyspermy produces a plant with
three gametic contributors. -/
def triparentalPlant : GenerationEvent :=
  ⟨⟨1⟩, NodeLevel.individual,
    [⟨⟨2⟩, ProgenitorMode.gametic⟩, ⟨⟨3⟩, ProgenitorMode.gametic⟩,
      ⟨⟨4⟩, ProgenitorMode.gametic⟩],
    ReproductiveProfile.unrestricted⟩

-- @source DASHI Agda bridge (PR #555/#581): `GenerationEvent` with arbitrary finite `progenitors`
/-- **A countermodel to exact-two progeniture.** -/
theorem triparental_has_three_progenitors : triparentalPlant.progenitorCount = 3 := by decide

/-- Mitochondrial replacement: nuclear contributions from two parties plus a
mitochondrial contribution from a third. -/
def mitochondrialReplacement : GenerationEvent :=
  ⟨⟨5⟩, NodeLevel.individual,
    [⟨⟨6⟩, ProgenitorMode.nuclear⟩, ⟨⟨7⟩, ProgenitorMode.nuclear⟩,
      ⟨⟨8⟩, ProgenitorMode.mitochondrial⟩],
    ReproductiveProfile.unrestricted⟩

-- @source DASHI Agda bridge (PR #555/#581): `GenerationEvent` with arbitrary finite `progenitors`
theorem mitochondrialReplacement_has_three_progenitors :
    mitochondrialReplacement.progenitorCount = 3 := by decide

/-- A single recorded genetic contributor: the cap is satisfied and exact-two
fails. -/
def singleContributorEvent : GenerationEvent :=
  ⟨⟨9⟩, NodeLevel.individual, [⟨⟨10⟩, ProgenitorMode.gametic⟩],
    ReproductiveProfile.unrestricted⟩

-- @source DASHI Agda bridge (PR #555/#581): genetic-parent cap scoped to the two typed slots
/-- **The cap does not mean exactly two.** -/
theorem cap_does_not_mean_exactly_two :
    singleContributorEvent.progenitorCount ≤ 2 ∧ singleContributorEvent.progenitorCount ≠ 2 := by
  decide

/-! ## The relationship carrier

Twelve independent coordinates.  Nothing here is derived from anything else. -/

-- @source DASHI Agda bridge (PR #555/#581): twelve orthogonal relationship coordinates
/-- The orthogonal coordinates of one party's relationship to a generated entity. -/
structure RelationVector where
  /-- Stands in the progenitor (lineage-origin) relation. -/
  progenitor : Bool
  /-- Contributed genetic material. -/
  genetic : Bool
  /-- Contributed a gamete. -/
  gamete : Bool
  /-- Contributed mitochondria. -/
  mitochondrial : Bool
  /-- Gestated the entity. -/
  gestational : Bool
  /-- Is a genealogical parent. -/
  genealogical : Bool
  /-- Is an intended parent. -/
  intended : Bool
  /-- Is a legal parent. -/
  legal : Bool
  /-- Is a social parent. -/
  social : Bool
  /-- Provides care. -/
  caregiver : Bool
  /-- The identity is known to someone. -/
  identityKnown : Bool
  /-- The identity may be disclosed. -/
  identityDisclosable : Bool
  deriving DecidableEq, Repr, Inhabited

namespace RelationVector

/-- The all-false vector: no relationship at all. -/
def none : RelationVector :=
  ⟨false, false, false, false, false, false, false, false, false, false, false, false⟩

/-- An anonymous gamete donor: genetic and gametic contributor, no parenthood, no
disclosable identity. -/
def anonymousDonor : RelationVector :=
  { none with progenitor := true, genetic := true, gamete := true }

/-- The same donor after the identity becomes known and disclosable. -/
def disclosableDonor : RelationVector :=
  { anonymousDonor with identityKnown := true, identityDisclosable := true }

/-- A gestational, genetic and legal parent. -/
def geneticGestationalParent : RelationVector :=
  ⟨true, true, true, false, true, true, true, true, true, true, true, true⟩

/-- The same parent before legal parenthood is finalised. -/
def preFinalizationParent : RelationVector :=
  { geneticGestationalParent with legal := false }

/-- An adoptive parent: genealogical, intended, legal and social parent with no
genetic contribution. -/
def adoptiveParent : RelationVector :=
  { none with genealogical := true, intended := true, legal := true, social := true,
              caregiver := true, identityKnown := true, identityDisclosable := true }

/-- A mitochondrial donor. -/
def mitochondrialDonor : RelationVector :=
  { none with progenitor := true, genetic := true, mitochondrial := true,
              identityKnown := true, identityDisclosable := true }

/-- A gestational surrogate who is not a genetic or genealogical parent. -/
def gestationalSurrogate : RelationVector :=
  { none with gestational := true, identityKnown := true, identityDisclosable := true }

/-- A cultivar's parent line: progeniture without personhood-level parenthood. -/
def cultivarLine : RelationVector :=
  { none with progenitor := true, identityKnown := true, identityDisclosable := true }

end RelationVector

/-! ### The coordinates really are independent -/

open RelationVector in
-- @source DASHI Agda bridge (PR #555/#581): twelve orthogonal relationship coordinates
/-- **Genetic contribution does not confer parenthood.** -/
theorem genetic_does_not_confer_parenthood :
    anonymousDonor.genetic = true ∧ anonymousDonor.genealogical = false := by decide

open RelationVector in
-- @source DASHI Agda bridge (PR #555/#581): twelve orthogonal relationship coordinates
/-- **Parenthood does not require genetic contribution.** -/
theorem parenthood_does_not_require_genetics :
    adoptiveParent.genealogical = true ∧ adoptiveParent.genetic = false := by decide

open RelationVector in
-- @source DASHI Agda bridge (PR #555/#581): twelve orthogonal relationship coordinates
/-- **Gestation is its own coordinate.** -/
theorem gestation_does_not_confer_parenthood :
    gestationalSurrogate.gestational = true ∧ gestationalSurrogate.genealogical = false := by
  decide

open RelationVector in
-- @source DASHI Agda bridge (PR #555/#581): twelve orthogonal relationship coordinates
/-- **Mitochondrial contribution is its own coordinate.** -/
theorem mitochondrial_does_not_confer_parenthood :
    mitochondrialDonor.mitochondrial = true ∧ mitochondrialDonor.genealogical = false := by decide

open RelationVector in
-- @source DASHI Agda bridge (PR #555/#581): twelve orthogonal relationship coordinates
/-- **Disclosure does not follow from the identity being known**, and being a
contributor does not make the identity known. -/
theorem disclosure_is_independent :
    anonymousDonor.genetic = true ∧ anonymousDonor.identityKnown = false ∧
      anonymousDonor.identityDisclosable = false := by decide

open RelationVector in
-- @source DASHI Agda bridge (PR #555/#581): twelve orthogonal relationship coordinates
/-- **Progeniture does not collapse into parenthood**: a cultivar's parent line is
a progenitor and not a genealogical parent. -/
theorem progeniture_is_not_parenthood :
    cultivarLine.progenitor = true ∧ cultivarLine.genealogical = false := by decide

open RelationVector in
/-- Donor conception, counted: one genealogical parent and two genetic
contributors. -/
def donorConception : List RelationVector := [geneticGestationalParent, anonymousDonor]

open RelationVector in
-- @source DASHI Agda bridge (PR #555/#581): donor conception computes to one genealogical parent, two genetic contributors
/-- **The concrete donor-conception fragment computes to one genealogical parent
and two genetic contributors.** -/
theorem donorConception_counts :
    (donorConception.filter (fun r => r.genealogical)).length = 1 ∧
      (donorConception.filter (fun r => r.genetic)).length = 2 := by decide

/-! ## Carriers and their Wikidata slot -/

/-- A parent-relationship carrier: at which level the relation lives, and the full
relation vector. -/
structure ParentCarrier where
  /-- Individual or lineage. -/
  level : NodeLevel
  /-- The twelve coordinates. -/
  relation : RelationVector
  deriving DecidableEq, Repr, Inhabited

/-- The generic slot recommended for a level: `P8810` for individuals, `P1531` for
lineages. -/
def recommendedSlot : NodeLevel → Pid
  | NodeLevel.individual => P8810
  | NodeLevel.lineage => P1531

/-- The public projection of a carrier: the Wikidata slot that would represent it. -/
def ParentCarrier.projectSlot (c : ParentCarrier) : Pid := recommendedSlot c.level

/-- An anonymous donor, recorded at individual level. -/
def anonymousDonorCarrier : ParentCarrier :=
  ⟨NodeLevel.individual, RelationVector.anonymousDonor⟩

/-- The same donor once the identity is disclosable. -/
def disclosableDonorCarrier : ParentCarrier :=
  ⟨NodeLevel.individual, RelationVector.disclosableDonor⟩

/-- An adoptive parent, recorded at individual level. -/
def adoptiveCarrier : ParentCarrier := ⟨NodeLevel.individual, RelationVector.adoptiveParent⟩

/-- A parent before legal finalisation. -/
def preFinalizationCarrier : ParentCarrier :=
  ⟨NodeLevel.individual, RelationVector.preFinalizationParent⟩

/-- A cultivar parent line, recorded at lineage level. -/
def cultivarCarrier : ParentCarrier := ⟨NodeLevel.lineage, RelationVector.cultivarLine⟩

theorem individual_projects_to_P8810 : anonymousDonorCarrier.projectSlot = P8810 := rfl

theorem lineage_projects_to_P1531 : cultivarCarrier.projectSlot = P1531 := rfl

-- @source DASHI Agda bridge (PR #555/#581): slot does not determine semantics
/-- **The slot does not determine the semantics**: the donor and the adoptive
parent share the `P8810` projection and disagree on every semantic coordinate
that matters. -/
theorem slot_does_not_determine_semantics :
    anonymousDonorCarrier.projectSlot = adoptiveCarrier.projectSlot ∧
      anonymousDonorCarrier.relation.genetic = true ∧
      adoptiveCarrier.relation.genetic = false ∧
      anonymousDonorCarrier.relation.genealogical = false ∧
      adoptiveCarrier.relation.genealogical = true := by decide

/-! ## What the knowledge base actually records -/

/-- The statement a carrier gives rise to: subject, its slot, and the related
party. -/
def recordedStatement (child parent : Qid) (c : ParentCarrier) : Statement :=
  ⟨child, c.projectSlot, parent, Rank.normal⟩

-- @source DASHI Agda bridge (PR #555/#581): slot does not determine semantics
/-- **The recorded statement forgets the relation vector.** -/
theorem recorded_statement_forgets_relation (child parent : Qid) :
    recordedStatement child parent anonymousDonorCarrier =
      recordedStatement child parent adoptiveCarrier ∧
    anonymousDonorCarrier ≠ adoptiveCarrier := by
  refine ⟨rfl, ?_⟩
  decide

/-- A knowledge base recording one `P8810` parent statement. -/
def recordedKB (child parent : Qid) (c : ParentCarrier) : KB :=
  ⟨[child, parent], [recordedStatement child parent c]⟩

-- @source DASHI Agda bridge (PR #555/#581): slot does not determine semantics
/-- **Two carriers with opposite semantics generate the same knowledge base**, so
the whole derived parent layer is the same for both. -/
theorem recordedKB_eq (child parent : Qid) :
    (recordedKB child parent anonymousDonorCarrier).statements =
      (recordedKB child parent adoptiveCarrier).statements := rfl

/-- A worked donor-conception knowledge base: the child `Q100` records a generic
parent `Q101` (the recipient parent) and nothing about the donor `Q102`. -/
def donorKB : KB :=
  ⟨[⟨100⟩, ⟨101⟩, ⟨102⟩],
    [⟨⟨100⟩, P8810, ⟨101⟩, Rank.normal⟩, ⟨⟨101⟩, P25, ⟨103⟩, Rank.normal⟩]⟩

/-- The recorded parent chain is found by the engine. -/
theorem donor_descent : descendsFrom donorKB ⟨100⟩ ⟨103⟩ = true := by decide

/-- **Recorded descent does not entail genetic descent**: the `P8810` link carries
no genetic claim, so the genetic engine stops short. -/
theorem recorded_descent_not_genetic :
    descendsFrom donorKB ⟨100⟩ ⟨103⟩ = true ∧
      geneticDescendsFrom donorKB ⟨100⟩ ⟨103⟩ = false := by decide

/-- **The genetic cap is satisfied here**, with one genetic parent rather than
two. -/
theorem donorKB_cap : SingleGeneticSlots donorKB ⟨101⟩ ∧
    (geneticParentsF donorKB ⟨101⟩).length = 1 := by
  refine ⟨⟨?_, ?_⟩, ?_⟩ <;> decide

end Wikidata
