namespace Wikidata.DisjointUnion

open Wikidata

variable (kb : KB) (c : Qid) (ms : List Qid)

/-! ## The three coordinates -/

/-- Coordinate 1: every member is a subclass of the holder class. -/
def componentsSubclass (kb : KB) (c : Qid) (ms : List Qid) : Bool :=
  ms.all (fun m => isSubclassOf kb m c)

/-- Coordinate 2: every known instance of the holder is an instance of some
member.  Scoped to the known entity carrier. -/
def coverage (kb : KB) (c : Qid) (ms : List Qid) : Bool :=
  kb.entities.all (fun x => !isInstanceOf kb x c || ms.any (fun m => isInstanceOf kb x m))

/-- Coordinate 3: distinct members share no known instance. -/
def pairwiseDisjoint (kb : KB) (ms : List Qid) : Bool :=
  ms.all (fun m₁ => ms.all (fun m₂ => (m₁ = m₂) || disjointOk kb m₁ m₂))

/-- **The checker factors into the three coordinates.** -/
theorem dunOk_iff_three :
    dunOk kb c ms = true ↔
      componentsSubclass kb c ms = true ∧ coverage kb c ms = true ∧
        pairwiseDisjoint kb ms = true := by
  simp [dunOk, unionOk, componentsSubclass, coverage, pairwiseDisjoint, Bool.and_eq_true,
    and_assoc]

/-- The same factorisation on the declarative side. -/
theorem isDisjointUnion_iff_three :
    IsDisjointUnionOn kb c ms ↔
      componentsSubclass kb c ms = true ∧ coverage kb c ms = true ∧
        pairwiseDisjoint kb ms = true := by
  rw [← dunOk_iff, dunOk_iff_three]

/-! ## Witnesses that the coordinates are independent

Throughout: the holder class is `Q100` and the members are `Q101`, `Q102`. -/

/-- Only `Q101` is declared a subclass of the holder, so the components
coordinate fails while the other two hold vacuously. -/
def missingSubclassEdge : KB :=
  { entities := [⟨100⟩, ⟨101⟩, ⟨102⟩]
    statements := [⟨⟨101⟩, P279, ⟨100⟩, Rank.normal⟩] }

/-- Both members are subclasses of the holder, and `Q1` is a known instance of
the holder that belongs to neither member, so coverage fails. -/
def nonExhaustive : KB :=
  { entities := [⟨1⟩, ⟨100⟩, ⟨101⟩, ⟨102⟩]
    statements :=
      [⟨⟨101⟩, P279, ⟨100⟩, Rank.normal⟩,
       ⟨⟨102⟩, P279, ⟨100⟩, Rank.normal⟩,
       ⟨⟨1⟩, P31, ⟨100⟩, Rank.normal⟩] }

/-- Both members are subclasses of the holder and cover it, but `Q1` instantiates
both members, so pairwise disjointness fails. -/
def overlappingMembers : KB :=
  { entities := [⟨1⟩, ⟨100⟩, ⟨101⟩, ⟨102⟩]
    statements :=
      [⟨⟨101⟩, P279, ⟨100⟩, Rank.normal⟩,
       ⟨⟨102⟩, P279, ⟨100⟩, Rank.normal⟩,
       ⟨⟨1⟩, P31, ⟨101⟩, Rank.normal⟩,
       ⟨⟨1⟩, P31, ⟨102⟩, Rank.normal⟩] }

/-- A knowledge base on which all three coordinates hold. -/
def completeDisjointUnion : KB :=
  { entities := [⟨1⟩, ⟨100⟩, ⟨101⟩, ⟨102⟩]
    statements :=
      [⟨⟨101⟩, P279, ⟨100⟩, Rank.normal⟩,
       ⟨⟨102⟩, P279, ⟨100⟩, Rank.normal⟩,
       ⟨⟨1⟩, P31, ⟨101⟩, Rank.normal⟩] }

/-- The members of every witness. -/
def members : List Qid := [⟨101⟩, ⟨102⟩]

/-- The holder class of every witness. -/
def holder : Qid := ⟨100⟩

theorem completeDisjointUnion_passes : dunOk completeDisjointUnion holder members = true := by
  decide

/-- **The three coordinates are independent.**  Each witness fails exactly one of
them, so no two coordinates entail the third and a bare `dunOk = false` does not
say which obligation to repair. -/
theorem three_coordinates_independent :
    (componentsSubclass missingSubclassEdge holder members = false ∧
        coverage missingSubclassEdge holder members = true ∧
        pairwiseDisjoint missingSubclassEdge members = true) ∧
      (componentsSubclass nonExhaustive holder members = true ∧
        coverage nonExhaustive holder members = false ∧
        pairwiseDisjoint nonExhaustive members = true) ∧
      (componentsSubclass overlappingMembers holder members = true ∧
        coverage overlappingMembers holder members = true ∧
        pairwiseDisjoint overlappingMembers members = false) := by
  refine ⟨⟨by decide, by decide, by decide⟩, ⟨by decide, by decide, by decide⟩,
    ⟨by decide, by decide, by decide⟩⟩

/-- Each witness is rejected by the checker, for a different reason. -/
theorem witnesses_all_fail :
    dunOk missingSubclassEdge holder members = false ∧
      dunOk nonExhaustive holder members = false ∧
      dunOk overlappingMembers holder members = false := by
  refine ⟨by decide, by decide, by decide⟩

/-- Coverage plus disjointness without the subclass edges is not a disjoint
union: the holder may be unrelated to its supposed members. -/
theorem coverage_and_disjointness_insufficient :
    coverage missingSubclassEdge holder members = true ∧
      pairwiseDisjoint missingSubclassEdge members = true ∧
      ¬ IsDisjointUnionOn missingSubclassEdge holder members := by
  refine ⟨by decide, by decide, fun h => ?_⟩
  have := (dunOk_iff missingSubclassEdge holder members).2 h
  exact absurd this (by decide)

/-- Subclass edges plus coverage without disjointness is an ordinary union, not
a disjoint one. -/
theorem union_without_disjointness :
    IsUnionOn overlappingMembers holder members ∧
      ¬ IsDisjointUnionOn overlappingMembers holder members := by
  refine ⟨(unionOk_iff overlappingMembers holder members).1 (by decide), fun h => ?_⟩
  have := (dunOk_iff overlappingMembers holder members).2 h
  exact absurd this (by decide)

/-! ## Coverage is scoped to the known carrier -/

/-- `completeDisjointUnion` with one more known entity: `Q2`, an instance of the
holder class belonging to neither member. -/
def grownBase : KB :=
  { entities := completeDisjointUnion.entities ++ [⟨2⟩]
    statements := completeDisjointUnion.statements ++ [⟨⟨2⟩, P31, ⟨100⟩, Rank.normal⟩] }

/-- **Coverage is open-world, and therefore not monotone.**  Learning about a new
instance of the holder class turns a passing disjoint union into a failing one,
while the components and disjointness coordinates are untouched.  This is why
`IsUnionOn` quantifies over the *known* entities: the checker certifies the base
it was run on, not the world. -/
theorem coverage_not_monotone_under_growth :
    dunOk completeDisjointUnion holder members = true ∧
      dunOk grownBase holder members = false ∧
      coverage grownBase holder members = false ∧
      componentsSubclass grownBase holder members = true ∧
      pairwiseDisjoint grownBase members = true := by
  refine ⟨by decide, by decide, by decide, by decide, by decide⟩

/-- The growth really is growth: every entity and statement of the smaller base
survives in the larger one. -/
theorem grownBase_extends :
    (∀ x ∈ completeDisjointUnion.entities, x ∈ grownBase.entities) ∧
      (∀ st ∈ completeDisjointUnion.statements, st ∈ grownBase.statements) := by
  constructor <;> intro x hx <;> simp [grownBase] <;> exact Or.inl hx

end Wikidata.DisjointUnion
