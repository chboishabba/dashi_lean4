/-
# From a dense observable algebra to the full `L²₀` two-slice estimate

`Lattice/CorrelationCriterion.lean` reduces the finite side of the mass gap to a
bound on the connected two-slice correlation of the literal Wilson–Gibbs measure
*for every vacuum-orthogonal element of the slice `L²` space*.  Constructive
field theory does not produce estimates in that form: it produces estimates for
*observables* — continuous, local, Wilson-loop-polynomial functions of the gauge
field — and those form a dense subspace of `L²`, not all of it.

This file supplies the missing extension compiler, and the density theorem it
consumes.

* `decorrelation_of_mem_closure` — the two-slice estimate is a **closed**
  condition on the wavefunction, so it extends from any set of observables to
  the closure of that set.  Nothing is assumed about the two maps beyond
  continuity and linearity.
* `dense_meanZero_of_dense_submodule` — the abstract normalisation step: if a
  subspace `M` of a Hilbert space is dense and contains the unit vector `Ω`,
  then its **mean-zero part** `{v ∈ M : ⟪Ω,v⟫ = 0}` is dense in the whole vacuum
  complement `Ω^⊥`.  Subtracting the mean costs at most the approximation error
  again, so no extra hypothesis is needed.
* `meanZero_toLp_mem_closure` — the same statement for `L²` of a probability
  measure on a compact space, with `M` the image of any sup-norm dense subspace
  of continuous functions, and `Ω` the constant function.
* `dense_of_separatesPoints` — via Stone–Weierstrass, a star subalgebra of
  continuous functions which separates points is such a subspace.  So the
  estimate need only be checked on, say, the algebra generated by Wilson loops.
* `decorrelation_of_dense_continuous_correlation` — the payoff on the literal
  lattice objects: a bound on the connected two-slice correlation
  `|∫ conj(f∘p₀)·(f∘p₁) dμ_Wilson| ≤ c ∫ |f|² dν` for the **mean-zero elements
  of a dense algebra of continuous observables** implies the same bound for
  every vacuum-orthogonal wavefunction in `L²`, hence the finite-spacing gap.
* `ym_uniform_gap_of_dense_continuous_mixing` — the trajectory form, feeding the
  existing continuum weld.

What is *not* proved here is any such correlation estimate for the interacting
Wilson measure: the input remains an explicitly displayed hypothesis in every
statement.  What changes is its shape — it is now an estimate on a dense algebra
of observables, which is the form a cluster or polymer expansion produces, and
no longer an estimate uniform over all of `L²`.  `zero_coupling_dense_bound`
records that the hypothesis holds with constant `0` at zero coupling, so it is
not vacuous.
-/
import Mathlib
import RequestProject.YangMills.Lattice.CorrelationCriterion

namespace RequestProject.YangMills.Lattice

open MeasureTheory
open scoped InnerProductSpace ENNReal

/-! ## 1. The two-slice estimate is a closed condition -/

section Abstract

variable {H H' : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
  [NormedAddCommGroup H'] [InnerProductSpace ℂ H']

/-- The set of vectors satisfying the two-slice estimate with constant `c` is
closed: the estimate is a non-strict inequality between continuous functions of
the wavefunction. -/
theorem isClosed_setOf_decorrelation (P₀ P₁ : H →L[ℂ] H') (c : ℝ) :
    IsClosed {ψ : H | ‖⟪P₀ ψ, P₁ ψ⟫_ℂ‖ ≤ c * ‖ψ‖ ^ 2} := by
  have h1 : Continuous fun ψ : H => ‖⟪P₀ ψ, P₁ ψ⟫_ℂ‖ :=
    (continuous_inner.comp (P₀.continuous.prodMk P₁.continuous)).norm
  have h2 : Continuous fun ψ : H => c * ‖ψ‖ ^ 2 := by fun_prop
  exact isClosed_le h1 h2

/-- **The extension compiler.**  A two-slice estimate valid on a set of vectors
is valid on its closure.  This is what turns an estimate proved for a dense
algebra of observables into an estimate for every state. -/
theorem decorrelation_of_mem_closure {P₀ P₁ : H →L[ℂ] H'} {c : ℝ} {D : Set H}
    (hD : ∀ φ ∈ D, ‖⟪P₀ φ, P₁ φ⟫_ℂ‖ ≤ c * ‖φ‖ ^ 2) {ψ : H} (hψ : ψ ∈ closure D) :
    ‖⟪P₀ ψ, P₁ ψ⟫_ℂ‖ ≤ c * ‖ψ‖ ^ 2 :=
  (isClosed_setOf_decorrelation P₀ P₁ c).closure_subset_iff.2 hD hψ

/-! ## 2. Mean-zero vectors of a dense subspace are dense in the vacuum complement -/

/-- **The normalisation step.**  If a subspace `M` of a Hilbert space is dense
and contains the unit vector `Ω`, then the vectors of `M` orthogonal to `Ω` are
dense in the orthogonal complement of `Ω`.  Subtracting the mean of an
approximant at most doubles the error, because the mean of the approximant is
the inner product of `Ω` with the approximation error. -/
theorem dense_meanZero_of_dense_submodule {Ω : H} (hΩ : ‖Ω‖ = 1) {M : Submodule ℂ H}
    (hM : Dense (M : Set H)) (hΩM : Ω ∈ M) {ψ : H} (hψ : ⟪Ω, ψ⟫_ℂ = 0) :
    ψ ∈ closure {v : H | v ∈ M ∧ ⟪Ω, v⟫_ℂ = 0} := by
  rw [Metric.mem_closure_iff]
  intro ε hε
  obtain ⟨v, hvM, hv⟩ := Metric.mem_closure_iff.1 (hM ψ) (ε / 2) (by linarith)
  set m : ℂ := ⟪Ω, v⟫_ℂ with hm
  have hvψ : ‖v - ψ‖ < ε / 2 := by
    rw [← dist_eq_norm, dist_comm]; exact hv
  have hmval : m = ⟪Ω, v - ψ⟫_ℂ := by
    rw [inner_sub_right, hψ, sub_zero]
  have hmle : ‖m‖ ≤ ‖v - ψ‖ := by
    rw [hmval]
    calc ‖⟪Ω, v - ψ⟫_ℂ‖ ≤ ‖Ω‖ * ‖v - ψ‖ := norm_inner_le_norm _ _
      _ = ‖v - ψ‖ := by rw [hΩ, one_mul]
  refine ⟨v - m • Ω, ⟨M.sub_mem hvM (M.smul_mem _ hΩM), ?_⟩, ?_⟩
  · rw [inner_sub_right, inner_smul_right, inner_self_eq_norm_sq_to_K (𝕜 := ℂ), hΩ]
    simp [hm]
  · have hbound : dist (v - m • Ω) ψ ≤ ‖v - ψ‖ + ‖m‖ := by
      rw [dist_eq_norm]
      have hrw : v - m • Ω - ψ = (v - ψ) - m • Ω := by abel
      rw [hrw]
      refine (norm_sub_le _ _).trans ?_
      rw [norm_smul, hΩ, mul_one]
    rw [dist_comm]
    calc dist (v - m • Ω) ψ ≤ ‖v - ψ‖ + ‖m‖ := hbound
      _ < ε / 2 + ε / 2 := by have := hmle.trans_lt hvψ; linarith
      _ = ε := by ring

end Abstract

/-! ## 3. Dense algebras of continuous observables -/

section Continuous

variable {X : Type*} [TopologicalSpace X] [CompactSpace X] [T2Space X] [MeasurableSpace X]
  [BorelSpace X] [SecondCountableTopologyEither X ℂ] (μ : Measure X) [IsProbabilityMeasure μ]
  [μ.WeaklyRegular]

/-- The image in `L²` of a sup-norm dense subspace of continuous functions is
dense: continuous functions are dense in `L²` of a finite Borel measure on a
compact space, and the image of a dense set under a continuous map is dense in
the image of the closure. -/
theorem dense_image_toLp {S : Submodule ℂ C(X, ℂ)} (hS : Dense (S : Set C(X, ℂ))) :
    Dense ((S.map (ContinuousMap.toLp (E := ℂ) 2 μ ℂ).toLinearMap : Submodule ℂ (Lp ℂ 2 μ)) :
      Set (Lp ℂ 2 μ)) := by
  have hrange : Dense (Set.range (ContinuousMap.toLp (E := ℂ) 2 μ ℂ)) :=
    ContinuousMap.toLp_denseRange (E := ℂ) (μ := μ) (p := 2) (α := X) ℂ (by simp)
  have himg : Set.range (ContinuousMap.toLp (E := ℂ) 2 μ ℂ)
      ⊆ closure ((ContinuousMap.toLp (E := ℂ) 2 μ ℂ) '' (S : Set C(X, ℂ))) := by
    intro y hy
    obtain ⟨f, rfl⟩ := hy
    have hf : f ∈ closure (S : Set C(X, ℂ)) := by rw [hS.closure_eq]; trivial
    exact image_closure_subset_closure_image
      (ContinuousMap.toLp (E := ℂ) 2 μ ℂ).continuous ⟨f, hf, rfl⟩
  have hsub : (Set.univ : Set (Lp ℂ 2 μ))
      ⊆ closure ((ContinuousMap.toLp (E := ℂ) 2 μ ℂ) '' (S : Set C(X, ℂ))) := by
    rw [← hrange.closure_eq]
    exact closure_minimal himg isClosed_closure
  have hdense : Dense ((ContinuousMap.toLp (E := ℂ) 2 μ ℂ) '' (S : Set C(X, ℂ))) := by
    rw [dense_iff_closure_eq]
    exact Set.eq_univ_of_univ_subset hsub
  simpa [Submodule.map_coe] using hdense

omit [T2Space X] [μ.WeaklyRegular] in
/-- The constant function `1`, viewed in `L²`, is the image of the continuous
constant function. -/
theorem const_eq_toLp_one :
    Lp.const 2 μ (1 : ℂ) = ContinuousMap.toLp (E := ℂ) 2 μ ℂ (1 : C(X, ℂ)) := by
  refine Lp.ext ?_
  filter_upwards [Lp.coeFn_const (p := 2) (μ := μ) (1 : ℂ),
    ContinuousMap.coeFn_toLp (p := 2) (μ := μ) (𝕜 := ℂ) (1 : C(X, ℂ))] with x h1 h2
  rw [h1, h2]
  rfl

/-- **Mean-zero observables of a dense algebra are dense in the vacuum
complement of `L²`.**  This is the density statement the `F1` route needs: the
constant function is the vacuum, and every state orthogonal to it is an `L²`
limit of mean-zero continuous observables drawn from any sup-norm dense
subspace. -/
theorem meanZero_toLp_mem_closure {S : Submodule ℂ C(X, ℂ)} (hS : Dense (S : Set C(X, ℂ)))
    (hone : (1 : C(X, ℂ)) ∈ S) {F : Lp ℂ 2 μ} (hF : ⟪Lp.const 2 μ (1 : ℂ), F⟫_ℂ = 0) :
    F ∈ closure {v : Lp ℂ 2 μ |
      v ∈ S.map (ContinuousMap.toLp (E := ℂ) 2 μ ℂ).toLinearMap
        ∧ ⟪Lp.const 2 μ (1 : ℂ), v⟫_ℂ = 0} := by
  refine dense_meanZero_of_dense_submodule (Ω := Lp.const 2 μ (1 : ℂ)) ?_
    (dense_image_toLp μ hS) ?_ hF
  · rw [Lp.norm_const] <;> simp
  · rw [const_eq_toLp_one]
    exact ⟨1, hone, rfl⟩

omit [MeasurableSpace X] [BorelSpace X] [SecondCountableTopologyEither X ℂ] in
/-- **Stone–Weierstrass**: a star subalgebra of continuous complex functions on a
compact Hausdorff space which separates points is sup-norm dense.  Applied to
the algebra generated by Wilson observables, this is what makes
`meanZero_toLp_mem_closure` usable in practice. -/
theorem dense_of_separatesPoints (A : StarSubalgebra ℂ C(X, ℂ))
    (hA : A.SeparatesPoints) : Dense (A : Set C(X, ℂ)) := by
  have htop := ContinuousMap.starSubalgebra_topologicalClosure_eq_top_of_separatesPoints A hA
  rw [dense_iff_closure_eq]
  have hcoe : ((A.topologicalClosure : StarSubalgebra ℂ C(X, ℂ)) : Set C(X, ℂ))
      = ((⊤ : StarSubalgebra ℂ C(X, ℂ)) : Set C(X, ℂ)) := by rw [htop]
  simpa [StarSubalgebra.topologicalClosure_coe] using hcoe

end Continuous

/-! ## 4. The literal lattice objects -/

section Slice

variable {G : Type*} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
  [CompactSpace G] [T2Space G] [MeasurableSpace G] [BorelSpace G]
  [SecondCountableTopology G] {n : ℕ} {chi : G → ℝ}

open RequestProject.YangMills.VacuumSectorSpectralGap

/-- A continuous observable of the gauge field on a time slice, viewed as an
element of the physical `L²` space of the literal Wilson slice measure. -/
noncomputable def obsToL2 (hchi : Continuous chi) (beta : ℝ) :
    C(SliceIdx n → G, ℂ) →L[ℂ] SliceL2 n G beta chi :=
  letI := isProbabilityMeasure_sliceMeasure (n := n) hchi beta
  ContinuousMap.toLp (E := ℂ) 2 (sliceMeasure n G beta chi) ℂ

/-- The `L²` class of a continuous observable is represented by that observable. -/
theorem coeFn_obsToL2 (hchi : Continuous chi) (beta : ℝ) (f : C(SliceIdx n → G, ℂ)) :
    (obsToL2 hchi beta f : _ → ℂ) =ᵐ[sliceMeasure n G beta chi] fun u => f u := by
  haveI := isProbabilityMeasure_sliceMeasure (n := n) hchi beta
  exact ContinuousMap.coeFn_toLp (p := 2) (μ := sliceMeasure n G beta chi) (𝕜 := ℂ) f

/-- The vacuum of the literal lattice theory is the `L²` class of the constant
observable `1`. -/
theorem vacuum_eq_obsToL2_one (hchi : Continuous chi) (beta : ℝ) :
    vacuum (n := n) hchi beta = obsToL2 hchi beta (1 : C(SliceIdx n → G, ℂ)) := by
  haveI := isProbabilityMeasure_sliceMeasure (n := n) hchi beta
  exact const_eq_toLp_one (sliceMeasure n G beta chi)

/-- The image in the physical `L²` space of a sup-norm dense space of continuous
observables is dense. -/
theorem dense_obsToL2_image (hchi : Continuous chi) (beta : ℝ)
    {S : Submodule ℂ C(SliceIdx n → G, ℂ)} (hS : Dense (S : Set C(SliceIdx n → G, ℂ))) :
    Dense ((S.map (obsToL2 hchi beta).toLinearMap : Submodule ℂ (SliceL2 n G beta chi)) :
      Set (SliceL2 n G beta chi)) := by
  haveI := isProbabilityMeasure_sliceMeasure (n := n) hchi beta
  exact dense_image_toLp (sliceMeasure n G beta chi) hS

/-- The inner product of the vacuum with a continuous observable is its mean. -/
theorem inner_vacuum_obsToL2 (hchi : Continuous chi) (beta : ℝ)
    (f : C(SliceIdx n → G, ℂ)) :
    ⟪vacuum (n := n) hchi beta, obsToL2 hchi beta f⟫_ℂ
      = ∫ u, f u ∂(sliceMeasure n G beta chi) := by
  rw [inner_vacuum_eq_integral hchi beta]
  exact integral_congr_ae (coeFn_obsToL2 hchi beta f)

/-- The squared `L²` norm of a continuous observable is the integral of its
squared modulus against the literal Wilson slice measure. -/
theorem norm_obsToL2_sq (hchi : Continuous chi) (beta : ℝ) (f : C(SliceIdx n → G, ℂ)) :
    ‖obsToL2 hchi beta f‖ ^ 2 = ∫ u, ‖f u‖ ^ 2 ∂(sliceMeasure n G beta chi) := by
  rw [← integral_norm_sq_slice hchi beta (obsToL2 hchi beta f)]
  refine integral_congr_ae ?_
  filter_upwards [coeFn_obsToL2 hchi beta f] with u hu
  rw [hu]

/-- The two-slice pairing of a continuous observable with itself is the literal
two-slice correlation integral of the Wilson–Gibbs measure. -/
theorem inner_embed_obsToL2 (hchi : Continuous chi) (beta : ℝ) (f : C(SliceIdx n → G, ℂ)) :
    ⟪embed0 n G beta chi (obsToL2 hchi beta f), embed1 hchi beta (obsToL2 hchi beta f)⟫_ℂ
      = ∫ U, (starRingEnd ℂ) (f (slice0 U)) * f (slice1 U) ∂(gibbs n G beta chi) := by
  rw [inner_embed_eq_integral hchi beta]
  refine integral_congr_ae ?_
  have h0 := (measurePreserving_slice0 (n := n) (G := G) beta chi).quasiMeasurePreserving.ae
    (coeFn_obsToL2 hchi beta f)
  have h1 := (measurePreserving_slice1 (n := n) (G := G) hchi beta).quasiMeasurePreserving.ae
    (coeFn_obsToL2 hchi beta f)
  filter_upwards [h0, h1] with U hU0 hU1
  rw [hU0, hU1]

/-- **Mean-zero observables of a dense space are dense in the vacuum complement
of the physical `L²` space.** -/
theorem meanZero_obs_mem_closure (hchi : Continuous chi) (beta : ℝ)
    {S : Submodule ℂ C(SliceIdx n → G, ℂ)} (hS : Dense (S : Set C(SliceIdx n → G, ℂ)))
    (hone : (1 : C(SliceIdx n → G, ℂ)) ∈ S) (ψ : SliceL2 n G beta chi)
    (hψ : ⟪vacuum hchi beta, ψ⟫_ℂ = 0) :
    ψ ∈ closure {v : SliceL2 n G beta chi |
      v ∈ S.map (obsToL2 hchi beta).toLinearMap ∧ ⟪vacuum hchi beta, v⟫_ℂ = 0} :=
  dense_meanZero_of_dense_submodule (norm_vacuum hchi beta) (dense_obsToL2_image hchi beta hS)
    (⟨1, hone, (vacuum_eq_obsToL2_one hchi beta).symm⟩) hψ

/-- **From a dense algebra of observables to the full two-slice estimate.**
Suppose the connected two-slice correlation of the literal Wilson–Gibbs measure
is bounded by `c` times the `L²` norm squared, for every *mean-zero* observable
in some sup-norm dense subspace `S` of continuous functions containing the
constants — for instance the algebra generated by Wilson loops.  Then the same
bound holds for *every* vacuum-orthogonal wavefunction in the slice `L²` space,
which is exactly the hypothesis the finite-spacing gap consumes.

No estimate is proved here: the correlation bound is a hypothesis.  What the
theorem removes is the need to prove it for arbitrary square-integrable states. -/
theorem decorrelation_of_dense_continuous_correlation (hchi : Continuous chi) (beta : ℝ)
    {c : ℝ} {S : Submodule ℂ C(SliceIdx n → G, ℂ)} (hS : Dense (S : Set C(SliceIdx n → G, ℂ)))
    (hone : (1 : C(SliceIdx n → G, ℂ)) ∈ S)
    (hbound : ∀ f ∈ S, (∫ u, f u ∂(sliceMeasure n G beta chi)) = 0 →
      ‖∫ U, (starRingEnd ℂ) (f (slice0 U)) * f (slice1 U) ∂(gibbs n G beta chi)‖
        ≤ c * ∫ u, ‖f u‖ ^ 2 ∂(sliceMeasure n G beta chi))
    (ψ : SliceL2 n G beta chi) (hψ : ⟪vacuum hchi beta, ψ⟫_ℂ = 0) :
    ‖⟪embed0 n G beta chi ψ, embed1 hchi beta ψ⟫_ℂ‖ ≤ c * ‖ψ‖ ^ 2 := by
  have hD : ∀ v ∈ {v : SliceL2 n G beta chi |
        v ∈ S.map (obsToL2 hchi beta).toLinearMap ∧ ⟪vacuum hchi beta, v⟫_ℂ = 0},
      ‖⟪(embed0 n G beta chi).toContinuousLinearMap v,
          (embed1 hchi beta).toContinuousLinearMap v⟫_ℂ‖ ≤ c * ‖v‖ ^ 2 := by
    rintro v ⟨⟨f, hfS, rfl⟩, hmean⟩
    have hmean' : (∫ u, f u ∂(sliceMeasure n G beta chi)) = 0 := by
      rw [← inner_vacuum_obsToL2 hchi beta f]
      exact hmean
    have hcorr := hbound f hfS hmean'
    simp only [LinearIsometry.coe_toContinuousLinearMap, ContinuousLinearMap.coe_coe]
    rw [inner_embed_obsToL2 hchi beta f, norm_obsToL2_sq hchi beta f]
    exact hcorr
  have hmem := meanZero_obs_mem_closure hchi beta hS hone ψ hψ
  have := decorrelation_of_mem_closure hD hmem
  simpa only [LinearIsometry.coe_toContinuousLinearMap] using this

/-- **Non-vacuity.**  At zero coupling the two slices are independent, so the
connected correlation of every mean-zero continuous observable vanishes and the
hypothesis of `decorrelation_of_dense_continuous_correlation` holds with `c = 0`,
at every lattice volume. -/
theorem zero_coupling_dense_bound (h01 : (0 : ZMod (n + 1)) ≠ 1) (hchi : Continuous chi)
    (f : C(SliceIdx n → G, ℂ)) (hmean : (∫ u, f u ∂(sliceMeasure n G 0 chi)) = 0) :
    ‖∫ U, (starRingEnd ℂ) (f (slice0 U)) * f (slice1 U) ∂(gibbs n G 0 chi)‖
      ≤ 0 * ∫ u, ‖f u‖ ^ 2 ∂(sliceMeasure n G 0 chi) := by
  have hvac : ⟪vacuum hchi (0 : ℝ), obsToL2 hchi (0 : ℝ) f⟫_ℂ = 0 := by
    rw [inner_vacuum_obsToL2 hchi (0 : ℝ) f]; exact hmean
  have h := inner_embed_eq_zero h01 hchi (obsToL2 hchi (0 : ℝ) f) hvac
  rw [inner_embed_obsToL2 hchi (0 : ℝ) f] at h
  rw [h]
  simp

/-- **The trajectory form.**  If along the trajectory the connected two-slice
correlation of the literal four-dimensional `SU(2)` Wilson measure obeys
`|Corr_c(f,f)| ≤ c_k ‖f‖²` for the mean-zero elements of a dense space of
continuous observables, and the spectral defect condition `Δ·a_k ≤ 1 − c_k`
holds, then the literal physical Hamiltonians have the uniform vacuum form gap
`Δ` required by the continuum weld. -/
theorem ym_uniform_gap_of_dense_continuous_mixing (vol : ℕ → ℕ) (beta a : ℕ → ℝ)
    (hapos : ∀ k, 0 < a k) {cs : ℕ → ℝ} {Δ : ℝ}
    (S : ∀ k, Submodule ℂ C(SliceIdx (vol k) → SU2, ℂ))
    (hS : ∀ k, Dense ((S k : Set C(SliceIdx (vol k) → SU2, ℂ))))
    (hone : ∀ k, (1 : C(SliceIdx (vol k) → SU2, ℂ)) ∈ S k)
    (hbound : ∀ k, ∀ f ∈ S k,
      (∫ u, f u ∂(sliceMeasure (vol k) SU2 (beta k) chiSU2)) = 0 →
        ‖∫ U, (starRingEnd ℂ) (f (slice0 U)) * f (slice1 U)
            ∂(gibbs (vol k) SU2 (beta k) chiSU2)‖
          ≤ cs k * ∫ u, ‖f u‖ ^ 2 ∂(sliceMeasure (vol k) SU2 (beta k) chiSU2))
    (hdefect : ∀ k, Δ * a k ≤ 1 - cs k) :
    ∀ k, HasVacuumFormGap (ymTrajectoryHam vol beta a (fun k => (hapos k).le) k)
      (ymTrajectoryVacuum vol beta k) Δ :=
  ym_uniform_gap_of_trajectory_decorrelation vol beta a (fun k => (hapos k).le)
    (fun k ψ hψ =>
      decorrelation_of_dense_continuous_correlation (G := SU2) continuous_chiSU2 (beta k)
        (hS k) (hone k) (hbound k) (ψ : SliceL2 (vol k) SU2 (beta k) chiSU2) hψ)
    (trajectory_gap_bound_of_defect hapos hdefect)

end Slice

end RequestProject.YangMills.Lattice

