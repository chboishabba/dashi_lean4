  module sum-of-free-path-at-a-point-is-contractible (A : 𝒰₀) (a₀ : A) where

    center : ∑ (λ (a : A) → a ≈ a₀)
    center = (a₀ , refl)

    contraction : (x : ∑ (λ (a : A) → a ≈ a₀)) → x ≈ center
