    promotionsAreEmpty :
      promotions ≡ []

    noPromotionPossibleHere :
      NSToEV5ActualPromotion →
      ⊥

open NSToEV5ForwardSimulationActualReceipt public

canonicalNSToEV5ForwardSimulationActualReceipt :
  NSToEV5ForwardSimulationActualReceipt
