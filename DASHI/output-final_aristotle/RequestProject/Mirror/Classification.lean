namespace Mirror.Classification

/-! ## Modes -/

/-- How an Agda declaration may be carried into Lean. -/
inductive MappingMode : Type
  | «exact»
  | encoded
  | reconstruct
  | quarantined
  | unsupported
  deriving DecidableEq, Repr, Fintype

namespace MappingMode

/-- The tabulated severity: the policy is defined through this and not through
the constructor order. -/
def severity : MappingMode → ℕ
  | .exact => 0
  | .encoded => 1
  | .reconstruct => 2
  | .quarantined => 3
  | .unsupported => 4

theorem severity_injective : Function.Injective severity := by decide

/-- The stricter of two modes. -/
def stricter (a b : MappingMode) : MappingMode :=
  if b.severity ≤ a.severity then a else b

theorem stricter_eq_max (a b : MappingMode) :
    (stricter a b).severity = max a.severity b.severity := by
  revert a b; decide

theorem stricter_comm (a b : MappingMode) : stricter a b = stricter b a := by
  revert a b; decide

theorem stricter_assoc (a b c : MappingMode) :
    stricter (stricter a b) c = stricter a (stricter b c) := by
  revert a b c; decide

theorem stricter_idem (a : MappingMode) : stricter a a = a := by revert a; decide

theorem stricter_exact_left (a : MappingMode) : stricter .exact a = a := by
  revert a; decide

theorem stricter_exact_right (a : MappingMode) : stricter a .exact = a := by
  revert a; decide

theorem le_stricter_left (a b : MappingMode) : a.severity ≤ (stricter a b).severity := by
  revert a b; decide

theorem le_stricter_right (a b : MappingMode) : b.severity ≤ (stricter a b).severity := by
  revert a b; decide

/-- `stricter` is the *least* upper bound, not merely an upper bound. -/
theorem stricter_le {a b c : MappingMode} (ha : a.severity ≤ c.severity)
    (hb : b.severity ≤ c.severity) : (stricter a b).severity ≤ c.severity := by
  revert a b c; decide

theorem stricter_mono {a a' b b' : MappingMode} (ha : a.severity ≤ a'.severity)
    (hb : b.severity ≤ b'.severity) :
    (stricter a b).severity ≤ (stricter a' b').severity := by
  revert a a' b b'; decide

instance : Std.Commutative stricter := ⟨stricter_comm⟩
instance : Std.Associative stricter := ⟨stricter_assoc⟩

end MappingMode

/-! ## Features -/

/-- The features of an elaborated Agda term that bear on translatability. -/
inductive Feature : Type
  | ordinaryEquality
  | structuralRecursion
  | wellFoundedRecursion
  | cubical
  | rewriteRule
  | coinduction
  | unsafeUniverse
  deriving DecidableEq, Repr, Fintype

/-- The mode a single feature forces on its own. -/
def featureMode : Feature → MappingMode
  | .ordinaryEquality => .exact
  | .structuralRecursion => .exact
  | .wellFoundedRecursion => .encoded
  | .cubical => .quarantined
  | .rewriteRule => .reconstruct
  | .coinduction => .reconstruct
  | .unsafeUniverse => .unsupported

/-- The classifier as written: a priority chain of tests. -/
def requiredMode (fs : Finset Feature) : MappingMode :=
  if Feature.unsafeUniverse ∈ fs then .unsupported
  else if Feature.cubical ∈ fs then .quarantined
  else if Feature.coinduction ∈ fs then .reconstruct
  else if Feature.rewriteRule ∈ fs then .reconstruct
  else if Feature.wellFoundedRecursion ∈ fs then .encoded
  else .exact

/-- The classifier read as a join: the strictest mode any present feature forces. -/
def requiredModeSup (fs : Finset Feature) : MappingMode :=
  fs.fold MappingMode.stricter .exact featureMode

set_option maxRecDepth 100000 in
/-- **The priority chain is the join.**  Checked over every one of the `2^7`
feature sets, so no branch of the chain can mask a later one. -/
theorem requiredMode_eq_sup (fs : Finset Feature) : requiredMode fs = requiredModeSup fs := by
  revert fs; decide

theorem requiredMode_empty : requiredMode ∅ = .exact := by decide

set_option maxRecDepth 100000 in
/-- A present feature always forces at least its own mode. -/
theorem featureMode_le_requiredMode {f : Feature} {fs : Finset Feature} (h : f ∈ fs) :
    (featureMode f).severity ≤ (requiredMode fs).severity := by
  revert h; revert f; revert fs; decide

set_option maxRecDepth 100000 in
/-- The mode a feature set forces is the mode of one of its own features. -/
theorem requiredMode_attained (fs : Finset Feature) :
    requiredMode fs = .exact ∨ ∃ f ∈ fs, requiredMode fs = featureMode f := by
  revert fs; decide

/-- More features can only mean a stricter mode. -/
theorem requiredMode_monotone {fs gs : Finset Feature} (h : fs ⊆ gs) :
    (requiredMode fs).severity ≤ (requiredMode gs).severity := by
  rcases requiredMode_attained fs with h0 | ⟨f, hf, hfe⟩
  · rw [h0]; exact Nat.zero_le _
  · rw [hfe]; exact featureMode_le_requiredMode (h hf)

/-! ## Declarations -/

/-- The three inputs to the per-declaration decision. -/
structure Decl : Type where
  declared : MappingMode
  features : Finset Feature
  definitionMode : MappingMode

/-- The strictest of the three inputs. -/
def classify (d : Decl) : MappingMode :=
  MappingMode.stricter d.declared
    (MappingMode.stricter (requiredMode d.features) d.definitionMode)

theorem classify_ge_declared (d : Decl) :
    d.declared.severity ≤ (classify d).severity :=
  MappingMode.le_stricter_left _ _

theorem classify_ge_required (d : Decl) :
    (requiredMode d.features).severity ≤ (classify d).severity :=
  le_trans (MappingMode.le_stricter_left _ _) (MappingMode.le_stricter_right _ _)

theorem classify_ge_definition (d : Decl) :
    d.definitionMode.severity ≤ (classify d).severity :=
  le_trans (MappingMode.le_stricter_right _ _) (MappingMode.le_stricter_right _ _)

/-- Emission is fail-closed: only `exact` and `encoded` declarations are written. -/
def emits (m : MappingMode) : Bool := m.severity ≤ 1

/-- A declaration is emitted exactly when all three of its inputs permit it. -/
theorem emits_classify_iff (d : Decl) :
    emits (classify d) = true ↔
      emits d.declared = true ∧ emits (requiredMode d.features) = true ∧
        emits d.definitionMode = true := by
  simp only [emits, classify, decide_eq_true_eq, MappingMode.stricter_eq_max,
    max_le_iff]

/-- **Fail-closed.**  Discovering another feature can block a declaration; it can
never unblock one. -/
theorem emits_antitone {d d' : Decl} (hdec : d.declared = d'.declared)
    (hdef : d.definitionMode = d'.definitionMode) (h : d.features ⊆ d'.features)
    (hemit : emits (classify d') = true) : emits (classify d) = true := by
  rw [emits_classify_iff] at hemit ⊢
  refine ⟨by rw [hdec]; exact hemit.1, ?_, by rw [hdef]; exact hemit.2.2⟩
  have := requiredMode_monotone h
  have h2 := hemit.2.1
  simp only [emits, decide_eq_true_eq] at h2 ⊢
  omega

/-- Cubical primitives always block emission. -/
theorem cubical_blocks {d : Decl} (h : Feature.cubical ∈ d.features) :
    emits (classify d) = false := by
  have hle := featureMode_le_requiredMode h
  have hf : (featureMode Feature.cubical).severity = 3 := rfl
  rw [hf] at hle
  have hc := classify_ge_required d
  simp only [emits, decide_eq_false_iff_not, not_le]
  omega

/-- An unsafe universe always blocks emission. -/
theorem unsafeUniverse_blocks {d : Decl} (h : Feature.unsafeUniverse ∈ d.features) :
    emits (classify d) = false := by
  have hle := featureMode_le_requiredMode h
  have hf : (featureMode Feature.unsafeUniverse).severity = 4 := rfl
  rw [hf] at hle
  have hc := classify_ge_required d
  simp only [emits, decide_eq_false_iff_not, not_le]
  omega

/-- Nothing a declaration can declare about itself relaxes the decision. -/
theorem declared_cannot_relax (d : Decl) (m : MappingMode) :
    (classify d).severity ≤ (classify { d with declared := MappingMode.stricter d.declared m }).severity := by
  simp only [classify, MappingMode.stricter_eq_max]
  have := MappingMode.le_stricter_left d.declared m
  omega

end Mirror.Classification
