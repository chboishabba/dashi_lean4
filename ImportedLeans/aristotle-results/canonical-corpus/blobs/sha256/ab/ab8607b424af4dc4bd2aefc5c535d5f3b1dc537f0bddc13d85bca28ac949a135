                                         (to++ConeSquare _ _ square) i 𝕚) i0 singCaseAuxL
            where
            singCaseAuxL : h ⋆⟨ C ⟩ ((pbPr₂ ⋁Pullback) ★ (restCone β β∈L')) .coneOut (sing i)
