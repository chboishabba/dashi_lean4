  (surj : ∀ g → Σ (SpinData.Spin D) (λ s → SpinData.toSO D s ≡ g)) →
  SpinDoubleCover D
spinDoubleCover-witness D ker ker⊆±1 surj =
  record { hom = SpinData.toSO D ; kernel = ker ; kernel⊆±1 = ker⊆±1 ; surjective = surj }

