-- Negative fallback:
-- even the explicit packaged sector histograms collapse on the current scope.

postulate
  all-current-sector-histograms-collapse :
    ∀ c₁ c₂ →
      sectorHistogramsAt c₁ ≡ sectorHistogramsAt c₂

