     λ { north → refl
       ; south i → ∣ merid north i ∣
       ; (merid a i) j →
          hcomp (λ r → λ {(i = i0) → ∣ north ∣
                         ; (i = i1) → ∣ merid north (j ∧ r) ∣
                         ; (j = i0) → EM→ΩEM+1-sym (suc (suc n)) ∣ a ∣ₕ r i
                         ; (j = i1) → ∣ compPath-filler (merid a)
