      (e : Support.Link) →
      ResidualActionTerm t →
      TermUsesLink t e →
      Support.TemporalLink e →
      ⊥

open ResidualTermHasNoTemporalSupportEvidence public

residualTermHasNoTemporalSupportFromAbsorption :
