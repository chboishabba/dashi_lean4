      rgObservableExprEval n rel# (rgClassOf (fused k n x)) ≡
      rgObservableExprEval (k + n) rel# (rgClassOf x)
    irr-observable-monotone :
      ∀ k n (x : RGState (k + n)) →
      rgObservableExprEval n irr# (rgClassOf (fused k n x)) ≤
