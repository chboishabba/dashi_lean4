      YMObs.canonicalYMSFGCStrictSelectedHodgeVariationPairingFiniteClosure

    boundaryClosedAt :
      YMObs.YMSFGCUserSuppliedNonFlatConnectionCarrier →
      YMObs.YMSFGCUserSuppliedVariationCarrier →
      Set

