      maxCrossTermRecorded ≡ true

    rowSumStrictlyBelowOne :
      Bool

    rowSumStrictlyBelowOneIsTrue :
      rowSumStrictlyBelowOne ≡ true

    finiteLowerBoundConditional :
      Bool

