namespace Wikidata

namespace Sparql

/-! ## Values and environments -/

/-- The kinds of RDF term a SPARQL expression can see: an entity, a string
literal, a numeric literal, or a boolean.  Wikidata's other value types
(`Values.lean`) reach expressions through their numeric or string components. -/
inductive Value
  | item (q : Qid)
  | str (s : String)
  | num (x : ℚ)
  | bool (b : Bool)
  deriving DecidableEq, Repr, Inhabited

/-- A solution as the expression language sees it: variables bound to values. -/
abbrev Env := List (Var × Value)

/-- The value an environment gives a variable, if any. -/
def lookupEnv : Env → Var → Option Value
  | [], _ => none
  | (w, c) :: r, v => if w = v then some c else lookupEnv r v

@[simp] theorem lookupEnv_nil (v : Var) : lookupEnv [] v = none := rfl

@[simp] theorem lookupEnv_cons_self (v : Var) (c : Value) (r : Env) :
    lookupEnv ((v, c) :: r) v = some c := by simp [lookupEnv]

/-! ## Expressions -/

/-- The fragment of the SPARQL expression language modelled here: variables and
literals, arithmetic, numeric and term comparison, the string functions, the
logical connectives, and `BOUND`. -/
inductive Expr
  | var (v : Var)
  | lit (c : Value)
  | add (a b : Expr)
  | sub (a b : Expr)
  | lt (a b : Expr)
  | eq (a b : Expr)
  | strlen (a : Expr)
  | concat (a b : Expr)
  | contains (a b : Expr)
  | neg (a : Expr)
  | conj (a b : Expr)
  | disj (a b : Expr)
  | bound (v : Var)
  deriving DecidableEq, Repr, Inhabited

/-- The result of evaluating an expression: a value, or a type error.  SPARQL
calls the second outcome "a type error", and it is not `false`. -/
inductive Res
  | ok (c : Value)
  | err
  deriving DecidableEq, Repr, Inhabited

/-- `ok true`. -/
def rtrue : Res := Res.ok (Value.bool true)

/-- `ok false`. -/
def rfalse : Res := Res.ok (Value.bool false)

/-- The boolean a result denotes, when it denotes one. -/
def asBool : Res → Option Bool
  | Res.ok (Value.bool b) => some b
  | _ => none

/-- Numeric extraction: only a numeric literal is a number. -/
def asNum : Res → Option ℚ
  | Res.ok (Value.num x) => some x
  | _ => none

/-- String extraction: only a string literal is a string. -/
def asStr : Res → Option String
  | Res.ok (Value.str s) => some s
  | _ => none

/-- Evaluation of an expression in an environment.

Two points of the specification are what make this interesting.  First, no
value is coerced: an operation applied to the wrong kind of term is an error,
not a silent conversion.  Second, `&&` and `||` are *not* strict: an error on
one side is absorbed when the other side already settles the answer, which is
what keeps them commutative. -/
def evalExpr (e : Env) : Expr → Res
  | Expr.var v => match lookupEnv e v with
      | some c => Res.ok c
      | none => Res.err
  | Expr.lit c => Res.ok c
  | Expr.add a b => match asNum (evalExpr e a), asNum (evalExpr e b) with
      | some x, some y => Res.ok (Value.num (x + y))
      | _, _ => Res.err
  | Expr.sub a b => match asNum (evalExpr e a), asNum (evalExpr e b) with
      | some x, some y => Res.ok (Value.num (x - y))
      | _, _ => Res.err
  | Expr.lt a b => match asNum (evalExpr e a), asNum (evalExpr e b) with
      | some x, some y => Res.ok (Value.bool (decide (x < y)))
      | _, _ => Res.err
  | Expr.eq a b => match evalExpr e a, evalExpr e b with
      | Res.ok c, Res.ok d => Res.ok (Value.bool (decide (c = d)))
      | _, _ => Res.err
  | Expr.strlen a => match asStr (evalExpr e a) with
      | some s => Res.ok (Value.num (s.length : ℚ))
      | none => Res.err
  | Expr.concat a b => match asStr (evalExpr e a), asStr (evalExpr e b) with
      | some s, some t => Res.ok (Value.str (s ++ t))
      | _, _ => Res.err
  | Expr.contains a b => match asStr (evalExpr e a), asStr (evalExpr e b) with
      | some s, some t => Res.ok (Value.bool (t.isPrefixOf s))
      | _, _ => Res.err
  | Expr.neg a => match asBool (evalExpr e a) with
      | some b => Res.ok (Value.bool (!b))
      | none => Res.err
  | Expr.conj a b => match asBool (evalExpr e a), asBool (evalExpr e b) with
      | some false, _ => rfalse
      | _, some false => rfalse
      | some true, some true => rtrue
      | _, _ => Res.err
  | Expr.disj a b => match asBool (evalExpr e a), asBool (evalExpr e b) with
      | some true, _ => rtrue
      | _, some true => rtrue
      | some false, some false => rfalse
      | _, _ => Res.err
  | Expr.bound v => Res.ok (Value.bool (lookupEnv e v).isSome)

/-- A `FILTER` keeps a solution when its expression evaluates to `true`.  An
error is not `false`: it is simply not `true`, and the solution goes. -/
def keeps (e : Env) (x : Expr) : Bool := asBool (evalExpr e x) == some true

/-- Filter a list of solutions by an expression. -/
def filterExpr (x : Expr) (l : List Env) : List Env := l.filter (fun e => keeps e x)

@[simp] theorem mem_filterExpr_iff (x : Expr) (l : List Env) (e : Env) :
    e ∈ filterExpr x l ↔ e ∈ l ∧ keeps e x = true := by
  simp [filterExpr, List.mem_filter]

/-! ## Errors are not `false` -/

/-- Some sample data to state the negative results on. -/
def envNum : Env := [("x", Value.num 5)]

/-- An environment in which `?x` is bound to an *item*, which is the normal
situation on Wikidata: the object of a statement is an entity. -/
def envItem : Env := [("x", Value.item ⟨42⟩)]

/-- `?x > 3`, written as SPARQL writes it. -/
def gtThree : Expr := Expr.lt (Expr.lit (Value.num 3)) (Expr.var "x")

theorem gtThree_on_num : evalExpr envNum gtThree = rtrue := by decide

/-- Comparing an item numerically is a type error, not `false`. -/
theorem gtThree_on_item : evalExpr envItem gtThree = Res.err := by decide

/-- Comparing an unbound variable numerically is a type error too. -/
theorem gtThree_on_unbound : evalExpr [] gtThree = Res.err := by decide

/-- **A filter and its negation do not partition the solutions.**  There is a
solution that `FILTER(e)` rejects and `FILTER(!e)` rejects as well, so the two
answer sets do not cover the input.  Absence from the answers of `FILTER(!e)`
is not evidence for `e`. -/
theorem filter_and_negation_do_not_partition :
    ∃ (x : Expr) (l : List Env) (e : Env),
      e ∈ l ∧ e ∉ filterExpr x l ∧ e ∉ filterExpr (Expr.neg x) l := by
  refine ⟨gtThree, [envItem], envItem, by simp, ?_, ?_⟩ <;> decide

/-- The same fact stated positively: the two filters together lose a solution. -/
theorem filterExpr_neg_length :
    (filterExpr gtThree [envItem]).length + (filterExpr (Expr.neg gtThree) [envItem]).length
      < ([envItem] : List Env).length := by decide

/-- Negating an error gives an error: `!` propagates rather than deciding. -/
theorem neg_error {e : Env} {x : Expr} (h : evalExpr e x = Res.err) :
    evalExpr e (Expr.neg x) = Res.err := by
  simp [evalExpr, h, asBool]

/-! ## The connectives are Kleene, not classical -/

/-- An expression that always errors. -/
def bad : Expr := Expr.strlen (Expr.lit (Value.num 1))

theorem bad_errs (e : Env) : evalExpr e bad = Res.err := by
  simp [bad, evalExpr, asStr]

/-- `error && false` is `false`: `&&` does not propagate the error when the
other side already settles the conjunction. -/
theorem and_error_false (e : Env) :
    evalExpr e (Expr.conj bad (Expr.lit (Value.bool false))) = rfalse := by
  simp [evalExpr, bad_errs e, asBool]

/-- `error && true` is an error. -/
theorem and_error_true (e : Env) :
    evalExpr e (Expr.conj bad (Expr.lit (Value.bool true))) = Res.err := by
  simp [evalExpr, bad_errs e, asBool]

/-- `error || true` is `true`. -/
theorem or_error_true (e : Env) :
    evalExpr e (Expr.disj bad (Expr.lit (Value.bool true))) = rtrue := by
  simp [evalExpr, bad_errs e, asBool]

/-- `error || false` is an error. -/
theorem or_error_false (e : Env) :
    evalExpr e (Expr.disj bad (Expr.lit (Value.bool false))) = Res.err := by
  simp [evalExpr, bad_errs e, asBool]

/-- Despite the third outcome, `&&` is commutative. -/
theorem and_comm_eval (e : Env) (a b : Expr) :
    evalExpr e (Expr.conj a b) = evalExpr e (Expr.conj b a) := by
  show (match asBool (evalExpr e a), asBool (evalExpr e b) with
        | some false, _ => rfalse | _, some false => rfalse
        | some true, some true => rtrue | _, _ => Res.err)
      = (match asBool (evalExpr e b), asBool (evalExpr e a) with
        | some false, _ => rfalse | _, some false => rfalse
        | some true, some true => rtrue | _, _ => Res.err)
  cases asBool (evalExpr e a) with
  | none => cases asBool (evalExpr e b) with
      | none => rfl
      | some y => cases y <;> rfl
  | some x => cases asBool (evalExpr e b) with
      | none => cases x <;> rfl
      | some y => cases x <;> cases y <;> rfl

/-- And so is `||`. -/
theorem or_comm_eval (e : Env) (a b : Expr) :
    evalExpr e (Expr.disj a b) = evalExpr e (Expr.disj b a) := by
  show (match asBool (evalExpr e a), asBool (evalExpr e b) with
        | some true, _ => rtrue | _, some true => rtrue
        | some false, some false => rfalse | _, _ => Res.err)
      = (match asBool (evalExpr e b), asBool (evalExpr e a) with
        | some true, _ => rtrue | _, some true => rtrue
        | some false, some false => rfalse | _, _ => Res.err)
  cases asBool (evalExpr e a) with
  | none => cases asBool (evalExpr e b) with
      | none => rfl
      | some y => cases y <;> rfl
  | some x => cases asBool (evalExpr e b) with
      | none => cases x <;> rfl
      | some y => cases x <;> cases y <;> rfl

/-- **Excluded middle fails.**  `e || !e` is not a tautology of the expression
language: when `e` errors, so does the disjunction, and a `FILTER` on it
rejects every solution. -/
theorem excluded_middle_fails :
    ∃ (x : Expr) (e : Env), evalExpr e (Expr.disj x (Expr.neg x)) = Res.err := by
  exact ⟨gtThree, envItem, by decide⟩

/-! ## Nothing is coerced -/

/-- `"3" + 1` is a type error, not `4`. -/
theorem no_string_to_number_coercion (e : Env) :
    evalExpr e (Expr.add (Expr.lit (Value.str "3")) (Expr.lit (Value.num 1))) = Res.err := by
  simp [evalExpr, asNum]

/-- An item is not a string: `STRLEN` of an entity is an error. -/
theorem strlen_of_item_errors (e : Env) (q : Qid) :
    evalExpr e (Expr.strlen (Expr.lit (Value.item q))) = Res.err := by
  simp [evalExpr, asStr]

/-- A number is not a string either. -/
theorem concat_of_num_errors (e : Env) (x : ℚ) (s : String) :
    evalExpr e (Expr.concat (Expr.lit (Value.num x)) (Expr.lit (Value.str s))) = Res.err := by
  simp [evalExpr, asStr]

/-- `BOUND` is the one construct that never errors: it is a question about the
solution mapping rather than about a value. -/
theorem bound_never_errs (e : Env) (v : Var) :
    ∃ b, evalExpr e (Expr.bound v) = Res.ok (Value.bool b) :=
  ⟨(lookupEnv e v).isSome, rfl⟩

/-! ## The bridge to the pattern language -/

/-- A core-fragment solution mapping, read as an environment: every variable is
bound to an entity. -/
def envOfBinding (b : Binding) : Env := b.map (fun p => (p.1, Value.item p.2))

theorem lookupEnv_envOfBinding : ∀ (b : Binding) (v : Var),
    lookupEnv (envOfBinding b) v = (lookupVar b v).map Value.item
  | [], _ => rfl
  | (w, q) :: r, v => by
      simp only [envOfBinding, List.map_cons, lookupEnv, lookupVar]
      by_cases h : w = v
      · simp [h]
      · simp only [h, if_false]
        exact lookupEnv_envOfBinding r v

/-- On a solution of the core fragment every value is an entity, so nothing in
it is a number. -/
theorem asNum_var_envOfBinding (b : Binding) (v : Var) :
    asNum (evalExpr (envOfBinding b) (Expr.var v)) = none := by
  simp only [evalExpr, lookupEnv_envOfBinding]
  cases lookupVar b v <;> simp [asNum]

/-- **A numeric FILTER over entity bindings deletes everything.**  Because an
item is not a number and nothing is coerced, `FILTER(?x > 3)` applied to
solutions of the core fragment — whose values are all entities — evaluates to
an error on every one of them, and the answer set is empty.  The query reports
no fault: it reports no answers. -/
theorem numeric_filter_on_item_bindings_is_empty (l : List Binding) (v : Var) :
    filterExpr (Expr.lt (Expr.lit (Value.num 3)) (Expr.var v)) (l.map envOfBinding) = [] := by
  apply List.eq_nil_iff_forall_not_mem.2
  intro e he
  rw [mem_filterExpr_iff] at he
  obtain ⟨hmem, hkeep⟩ := he
  obtain ⟨b, _, rfl⟩ := List.mem_map.1 hmem
  revert hkeep
  simp only [keeps, evalExpr, lookupEnv_envOfBinding]
  cases lookupVar b v <;> simp [asNum, asBool]

/-! ## Filtering is monotone, `LIMIT` is not -/

/-- **A FILTER is monotone.**  It is a pure function of the solution, so it
neither creates answers nor withdraws answers that survive in a larger input:
what a FILTER keeps of a sublist is a sublist of what it keeps. -/
theorem filterExpr_mono {l₁ l₂ : List Env} (hsub : ∀ e ∈ l₁, e ∈ l₂) (x : Expr) :
    ∀ e ∈ filterExpr x l₁, e ∈ filterExpr x l₂ := by
  intro e he
  rw [mem_filterExpr_iff] at he ⊢
  exact ⟨hsub e he.1, he.2⟩

/-- A subquery's `LIMIT`. -/
def limit (n : Nat) (l : List Env) : List Env := l.take n

/-- **`LIMIT` is not monotone.**  A solution that a subquery returned can be
pushed out of the window by a solution the larger base supplies first, so a
`LIMIT`ed subquery withdraws an answer on the arrival of data even though every
part of it below the `LIMIT` is monotone. -/
theorem limit_not_monotone :
    ∃ (l₁ l₂ : List Env) (e : Env),
      (∀ c ∈ l₁, c ∈ l₂) ∧ e ∈ limit 1 l₁ ∧ e ∉ limit 1 l₂ := by
  refine ⟨[envNum], [envItem, envNum], envNum, ?_, by decide, by decide⟩
  intro c hc
  simp at hc
  simp [hc]

/-- `LIMIT` also breaks the equality of answer sets that `DISTINCT` and the
positive fragment enjoy: it depends on the *order* the solutions arrive in, and
so on the order of the statements in the base. -/
theorem limit_depends_on_order :
    ∃ l₁ l₂ : List Env,
      (∀ e, e ∈ l₁ ↔ e ∈ l₂) ∧ limit 1 l₁ ≠ limit 1 l₂ := by
  refine ⟨[envNum, envItem], [envItem, envNum], fun e => ?_, by decide⟩
  simp only [List.mem_cons, List.not_mem_nil, or_false]
  tauto

/-! ## Federation -/

/-- A `SERVICE` clause, modelled as what it is from the base's point of view:
an opaque source of solutions that the local knowledge base does not determine. -/
structure Endpoint where
  /-- The solutions the endpoint returns for a query, as an abstract function of
  the query. -/
  answers : Query → List Env

/-- Two endpoints that answer the same query differently. -/
def endpointA : Endpoint := ⟨fun _ => [envNum]⟩

/-- The other one. -/
def endpointB : Endpoint := ⟨fun _ => [envItem]⟩

/-- **A federated answer is not a fact about the local base.**  No function of
the knowledge base recovers what a `SERVICE` clause contributes: the two
endpoints above are consulted against the very same base and return different
solutions.  So a `SERVICE` answer enters the development as imported evidence,
not as a consequence of the base. -/
theorem no_service_decoder :
    ¬ ∃ decode : KB → Query → List Env,
        ∀ (kb : KB) (q : Query) (ep : Endpoint),
          ep ∈ [endpointA, endpointB] → decode kb q = ep.answers q := by
  rintro ⟨decode, h⟩
  have h₁ := h ⟨[], []⟩ (Query.pattern ⟨Term.var "x", P31, Term.var "y"⟩) endpointA (by simp)
  have h₂ := h ⟨[], []⟩ (Query.pattern ⟨Term.var "x", P31, Term.var "y"⟩) endpointB (by simp)
  rw [h₁] at h₂
  exact absurd h₂ (by decide)

/-- **A federated answer is not sound for the local base.**  An endpoint can
return a solution that the local evaluation of the very same query does not:
unlike `evalPattern_sound`, there is no statement of the base behind it. -/
theorem service_answer_need_not_be_a_local_answer :
    ∃ (ep : Endpoint) (kb : KB) (q : Query) (e : Env),
      e ∈ ep.answers q ∧ eval kb q = [] := by
  refine ⟨endpointA, ⟨[], []⟩, Query.pattern ⟨Term.var "x", P31, Term.var "y"⟩, envNum,
    by simp [endpointA], ?_⟩
  rfl

end Sparql

end Wikidata
