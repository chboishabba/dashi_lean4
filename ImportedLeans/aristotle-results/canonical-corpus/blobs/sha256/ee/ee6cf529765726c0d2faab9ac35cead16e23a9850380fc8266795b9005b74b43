  brainSummaryPacketView
    (BrainCoarseSummary.width summary)
    (BrainCoarseSummary.layer summary)
    (BrainCoarseSummary.activeFlag summary)
    lineMajor

summaryStatePacketView : ∀ {n} → BrainState n → BrainSummaryPacketView
