      assocₙₘₗ₊ n m l (mainAssoc n (suc m) (suc l))

  main : (n m l : ℕ) (x : EM G' n) (y : EM H' m) (z : EM L' l)
       → ((x ⌣ₖ y) ⌣ₖ z)
        ≡ subst (EM ((G' ⨂ H') ⨂ L')) (+'-assoc n m l)
          (Iso.fun (Iso→EMIso ⨂assoc (n +' (m +' l)))
            (x ⌣ₖ (y ⌣ₖ z)))
