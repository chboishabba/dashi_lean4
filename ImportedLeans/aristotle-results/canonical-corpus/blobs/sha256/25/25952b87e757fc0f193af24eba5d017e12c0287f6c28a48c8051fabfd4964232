/-
# Row A — non-vacuity of the history-free package

`RowAHistoryFreeBeta.rowA_history_free_small_bare_coupling` drops the whole
memory sector from the Row-A package under the hypothesis that the Gaussian
shell coefficient and the five channel data are attached to the scale rather
than to the bare inverse coupling.  A conditional theorem with *more*
hypotheses than its parent is worthless if the added freeness hypotheses are
incompatible with the rest, so this file exhibits an explicit instance and
derives the conclusion.

The data are those of `RowACubicDriveWitness` with the memory sector switched
off at the level of the *coefficients*: one genuinely nonzero interaction Taylor
coefficient `a_I = 10⁻³`, no determinant or gauge modes, and a Gaussian shell
coefficient `β_{Z,j} ≡ 1` that does not see the bare coupling.  The shell
coefficient is then

    β_j(p) = 1 + 10⁻³ g_j(p)⁴,

a genuinely `p`-dependent function of the *running* coupling, generated by the
shooting recursion — the marginal coordinate is fully active, only the *history*
is inert.

This certifies consistency of the history-free package; it does **not** close
Row A.
-/
import RequestProject.YangMills.RowAHistoryFreeBeta

namespace YangMills
namespace HistoryFreeWitness

open Finset

/-! ## 1. The concrete data -/

/-- No determinant modes. -/
noncomputable def lamD : ℕ → ℝ → Fin 0 → ℝ := fun _ _ i => i.elim0

/-- No gauge-determinant modes. -/
noncomputable def lamG : ℕ → ℝ → Fin 0 → ℝ := fun _ _ i => i.elim0

/-- A single, genuinely nonzero interaction Taylor coefficient, attached to the
scale and not to the bare coupling. -/
noncomputable def aI : ℕ → ℝ → ℕ → ℝ := fun _ _ _ => 1 / 1000

/-- The chart and localisation channels are switched off. -/
def aZero : ℕ → ℝ → ℕ → ℝ := fun _ _ _ => 0

/-- The Gaussian shell coefficient of the witness: history-free. -/
noncomputable def betaZ : ℕ → ℝ → ℝ := fun _ _ => 1

/-- The shell coefficient as a function of the running coupling. -/
noncomputable def shellVal (g : ℝ) : ℝ := 1 + (1 / 1000) * g ^ 4

/-- The generated trajectory. -/
noncomputable def traj (p : ℝ) : ℕ → ℝ
  | 0 => p
  | (j + 1) => traj p j + shellVal (couplingOf (traj p j))

/-- The shell coefficient of the witness. -/
noncomputable def bet (j : ℕ) (p : ℝ) : ℝ := shellVal (couplingOf (traj p j))

theorem traj_succ (p : ℝ) (j : ℕ) : traj p (j + 1) = traj p j + bet j p := rfl

theorem bet_nonneg (j : ℕ) (p : ℝ) : 0 ≤ bet j p := by
  have : (0 : ℝ) ≤ couplingOf (traj p j) ^ 4 := by positivity
  rw [bet, shellVal]; linarith

/-- The trajectory never falls below its starting point. -/
theorem traj_ge_start (p : ℝ) (j : ℕ) : p ≤ traj p j := by
  induction j with
  | zero => exact le_refl p
  | succ k ih =>
      have hb := bet_nonneg k p
      rw [traj_succ]; linarith

theorem shootingTrajectory_eq (p : ℝ) (j : ℕ) : shootingTrajectory bet p j = traj p j := by
  induction j with
  | zero => simp [traj]
  | succ j ih => rw [shootingTrajectory_step, ih, traj_succ]

/-! ## 2. The witness satisfies the literal-shell structure -/

theorem literalShellAt_eq (j : ℕ) (p g : ℝ) :
    literalShellAt betaZ lamD lamG aI aZero aZero 1 j p g = 1 + (1 / 1000) * g ^ 4 := by
  simp [literalShellAt, frozenShellInteraction, logDetChannel, tailPolyChannel,
    betaZ, aI, aZero]

theorem frozenShellInteraction_eq (j : ℕ) (p g : ℝ) :
    frozenShellInteraction (lamD j p) (lamG j p) (aI j p) (aZero j p) (aZero j p) 1 g
      = (1 / 1000) * g ^ 4 := by
  simp [frozenShellInteraction, logDetChannel, tailPolyChannel, aI, aZero]

theorem bet_eq_literalShellAt (j : ℕ) (p : ℝ) :
    bet j p = literalShellAt betaZ lamD lamG aI aZero aZero 1 j p
      (couplingOf (shootingTrajectory bet p j)) := by
  rw [shootingTrajectory_eq, literalShellAt_eq, bet, shellVal]

theorem cdir_value :
    analyticDirectSensitivityBound (Fintype.card (Fin 0)) (Fintype.card (Fin 0))
      0 0 (1 / 2) (1 / 1000) 0 0 1 (1 / 2) ≤ 1 / 100 := by
  simp [analyticDirectSensitivityBound]
  norm_num

theorem hIntQ_witness (j : ℕ) (p : ℝ) (hp : (1 : ℝ) ≤ p) :
    |frozenShellInteraction (lamD j p) (lamG j p) (aI j p) (aZero j p) (aZero j p) 1
        (couplingOf (shootingTrajectory bet p j))|
      ≤ (1 / 1000 : ℝ) * couplingOf p ^ 4 := by
  rw [frozenShellInteraction_eq]
  have hp0 : (0 : ℝ) < p := lt_of_lt_of_le one_pos hp
  have hcoup : couplingOf (traj p j) ≤ couplingOf p :=
    couplingOf_le hp0 (traj_ge_start p j)
  have h4 : couplingOf (shootingTrajectory bet p j) ^ 4 ≤ couplingOf p ^ 4 := by
    rw [shootingTrajectory_eq]
    exact pow_le_pow_left₀ (couplingOf_nonneg _) hcoup 4
  rw [abs_of_nonneg (by positivity : (0 : ℝ) ≤ (1 / 1000 : ℝ)
    * couplingOf (shootingTrajectory bet p j) ^ 4)]
  linarith

/-! ## 3. The package is inhabited -/

/-- **The history-free Row-A package is inhabited.**  For an explicit
scale-attached channel family with a nonzero interaction coefficient and a
constant Gaussian shell coefficient, there is a threshold `U` such that every
bare inverse coupling above it produces the Row-A completion predicate at every
cutoff and every admissible observation target — with no memory hypothesis
anywhere. -/
theorem historyFree_package_inhabited :
    ∃ U : ℝ, 1 ≤ U ∧
      ∀ u₀ : ℝ, U ≤ u₀ → ∀ (K : ℕ) (target : ℝ),
        u₀ + (1 + quarticDebtTolerance (1 / 1000) u₀) * K ≤ target →
        RowACompletion bet K target
          (1 - quarticDebtTolerance (1 / 1000) u₀)
          (1 + quarticDebtTolerance (1 / 1000) u₀)
          (target - (1 + quarticDebtTolerance (1 / 1000) u₀) * K)⁻¹ := by
  obtain ⟨U, -, hU1, hall⟩ := rowA_history_free_small_bare_coupling
    (bet := bet) (betaZ := betaZ) (lamD := lamD) (lamG := lamG)
    (aI := aI) (aC := aZero) (aL := aZero) (N := 1)
    (LamDet := 0) (LamGauge := 0) (theta := 1 / 2)
    (AI := 1 / 1000) (AC := 0) (AL := 0) (Kmaj := 1) (rho := 1 / 2)
    (Cdir := 1 / 100) (bZm := 1) (bZp := 1) (Cint := 1 / 1000) (ubase := 1)
    (fun _ _ _ => rfl) (fun _ _ _ => rfl) (fun _ _ _ => rfl)
    (fun _ _ _ => rfl) (fun _ _ _ => rfl) (fun _ _ _ => rfl)
    (fun j p _ => bet_eq_literalShellAt j p)
    (fun _ _ i => i.elim0) (fun _ _ i => i.elim0) le_rfl le_rfl
    (fun _ _ _ => by simp [aI]) (fun _ _ _ => by simp [aZero])
    (fun _ _ _ => by simp [aZero])
    (by norm_num) le_rfl le_rfl (by norm_num)
    (by norm_num) (by norm_num) (by norm_num) (by norm_num) cdir_value
    (fun _ _ _ => le_rfl) (fun _ _ _ => le_rfl)
    (fun j p hp => hIntQ_witness j p hp)
    (by norm_num) (by norm_num) (by norm_num)
  exact ⟨U, hU1, hall⟩

theorem bet_ge_one (j : ℕ) (p : ℝ) : (1 : ℝ) ≤ bet j p := by
  have : (0 : ℝ) ≤ couplingOf (traj p j) ^ 4 := by positivity
  rw [bet, shellVal]; linarith

/-- **The boxed inequality, for the witness.**  The literal cumulative beta map
of the witness is a genuine contraction on the tube `p ≥ u₀` for every
`u₀ ≥ 4`. -/
theorem historyFree_contraction_witness {u₀ : ℝ} (hu₀ : (4 : ℝ) ≤ u₀) :
    (∀ (K : ℕ) (p q : ℝ), u₀ ≤ p → u₀ ≤ q →
        |∑ j ∈ range K, bet j p - ∑ j ∈ range K, bet j q|
          ≤ (literalKernelMass (1 / 100) 0 0 u₀ 1
              / (1 - literalKernelMass (1 / 100) 0 0 u₀ 1)) * |p - q|)
      ∧ literalKernelMass (1 / 100) 0 0 u₀ 1
          / (1 - literalKernelMass (1 / 100) 0 0 u₀ 1) < 1 := by
  have hg : couplingOf u₀ ≤ 1 / 2 :=
    couplingOf_le_of_inv_sq (by norm_num) (by norm_num; linarith)
  exact literal_cumulative_beta_contraction_history_free
    (betaZ := betaZ) (lamD := lamD) (lamG := lamG) (aI := aI) (aC := aZero) (aL := aZero)
    (N := 1) (LamDet := 0) (LamGauge := 0) (theta := 1 / 2)
    (AI := 1 / 1000) (AC := 0) (AL := 0) (Kmaj := 1) (rho := 1 / 2)
    (Cdir := 1 / 100) (bl := 1)
    (fun _ _ _ => rfl) (fun _ _ _ => rfl) (fun _ _ _ => rfl)
    (fun _ _ _ => rfl) (fun _ _ _ => rfl) (fun _ _ _ => rfl)
    (fun j p _ => bet_eq_literalShellAt j p)
    (fun _ _ i => i.elim0) (fun _ _ i => i.elim0) le_rfl le_rfl
    (fun _ _ _ => by simp [aI]) (fun _ _ _ => by simp [aZero]) (fun _ _ _ => by simp [aZero])
    (by norm_num) le_rfl le_rfl (by norm_num)
    (by norm_num) (by norm_num) (by norm_num)
    (by simpa using hg) (by norm_num) (by norm_num)
    cdir_value (by linarith) one_pos (fun j p _ => bet_ge_one j p) (by nlinarith)

end HistoryFreeWitness

