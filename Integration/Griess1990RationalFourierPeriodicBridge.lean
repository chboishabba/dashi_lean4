def fourierInverse : Matrix (Fin 27) (Fin 27) ℚ :=
  ((1/81 : ℚ) • (rationalFourier.transpose * sourceTraceGram))

theorem rational_fourier_metric :
    rationalFourier.transpose * sourceTraceGram * rationalFourier =
      (81 : ℚ) • (1 : Matrix (Fin 27) (Fin 27) ℚ) := by
  native_decide

theorem rational_fourier_inverse_left :
    fourierInverse * rationalFourier = 1 := by native_decide

theorem rational_fourier_inverse_right :
    rationalFourier * fourierInverse = 1 := by native_decide

/-- ALL THREE true source-selected rational phase generators, but only
the PERIODIC C3³ translations. -/
theorem source_periodic_intertwiners :
    sourceGenerator0 * rationalFourier =
      rationalFourier * periodicTranslation0 ∧
    sourceGenerator1 * rationalFourier =
      rationalFourier * periodicTranslation1 ∧
    sourceGenerator2 * rationalFourier =
      rationalFourier * periodicTranslation2 := by
  native_decide

def spatialConstant : Fin 27 → ℚ := fun _ => 1
def spatialOriginDelta : Fin 27 → ℚ := fun i => if i = 0 then 1 else 0

theorem constant_maps_to_albert_unit :
    ∀ i, applyWitness rationalFourier spatialConstant i =
      (if i = 0 then 27 else 0) := by
  native_decide

theorem origin_delta_not_albert_identity :
    applyWitness rationalFourier spatialOriginDelta ≠ sourceOne := by
  native_decide

/-- Same concrete native octonionic Albert carrier after the verified
source→native 27×27 map: no artificial extra copy of J₃(O). -/
def periodicToNative : Matrix (Fin 27) (Fin 27) ℚ :=
  sourceToNative * rationalFourier

theorem native_constant_is_identity :
    ∀ i, applyWitness periodicToNative (fun _ => (1/27 : ℚ)) i =
      nativeOne i := by
  native_decide

end Integration.Griess1990RationalFourierPeriodicBridge
