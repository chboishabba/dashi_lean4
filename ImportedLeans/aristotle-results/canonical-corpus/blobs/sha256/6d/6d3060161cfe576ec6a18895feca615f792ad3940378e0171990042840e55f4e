      String

    reducerProfileScope :
      String

    evidenceOnly :
      Bool

    evidenceOnlyIsTrue :
      evidenceOnly ≡ true

    runtimePhenomenalRecovery :
      Bool

    runtimePhenomenalRecoveryIsFalse :
      runtimePhenomenalRecovery ≡ false

