  Im-E↑⊂Ker-j* : (i : ℕ) (x : _)
    → isInIm (E↑ i) x
    → isInKer (j* (suc i)) x
  Im-E↑⊂Ker-j* i = ST.elim
      (λ f → isSetΠ λ _ → isSetPathImplicit)
      λ f → PT.rec (squash₂ _ _)
         (uncurry (ST.elim (λ _ → isSetΠ
          λ _ → isSetPathImplicit)
          λ g p → PT.rec (squash₂ _ _)
            (J (λ f _ → isInKer (j* (suc i)) ∣ f ∣₂) refl)
            (Iso.fun PathIdTrunc₀Iso p)))

  Ker-j*⊂Im-E↑ : (i : ℕ) (x : _)
    → isInKer (j* (suc i)) x
    → isInIm (E↑ i) x
