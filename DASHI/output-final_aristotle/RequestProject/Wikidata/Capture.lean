namespace Wikidata

open Epistemic

/-! ## The two gates -/

/-- Which of the two gates a community keeps closed. -/
structure GateProfile where
  /-- May an arbitrary contributor add a statement? -/
  productionRestricted : Bool
  /-- May an arbitrary contributor rank a statement? -/
  validationRestricted : Bool
  deriving DecidableEq, Repr

/-- A closed wiki: both gates held. -/
def closedProfile : GateProfile := ⟨true, true⟩

/-- An open wiki: anyone may submit, ranks are still curated. -/
def openSubmissionProfile : GateProfile := ⟨false, true⟩

/-- **The production barrier can fall while the validation barrier stands.**
The two coordinates are independent. -/
theorem production_falls_validation_stands :
    closedProfile.productionRestricted = true ∧
      openSubmissionProfile.productionRestricted = false ∧
      closedProfile.validationRestricted = true ∧
      openSubmissionProfile.validationRestricted = true := by
  refine ⟨rfl, rfl, rfl, rfl⟩

/-! ## Submission is inert under a preferred statement -/

/-- Anyone's contribution: prepend a statement. -/
def submit (st : Statement) (kb : KB) : KB :=
  { kb with statements := st :: kb.statements }

/-- Submitting a statement that is not preferred cannot create a preferred
statement. -/
theorem hasPreferred_submit {st : Statement} (hst : st.rank ≠ Rank.preferred) (kb : KB)
    (s : Qid) (p : Pid) : hasPreferred (submit st kb) s p = hasPreferred kb s p := by
  by_cases h : st.subject = s ∧ st.property = p
  · simp [hasPreferred, statementsFor, submit, h, hst]
  · simp [hasPreferred, statementsFor, submit, h]

/-- Submitting a non-preferred statement does not change which statements are
truthy. -/
theorem isTruthy_submit {st : Statement} (hst : st.rank ≠ Rank.preferred) (kb : KB)
    (t : Statement) : IsTruthy (submit st kb) t = IsTruthy kb t := by
  simp [IsTruthy, hasPreferred_submit hst kb]

/-- **Submission is inert where a preferred statement already stands.**  A
normal statement submitted for a subject/property pair that already carries a
preferred statement leaves the truthy `P279` edges exactly as they were. -/
theorem subclassEdges_submit_shadowed {st : Statement} (hnorm : st.rank = Rank.normal)
    (kb : KB) (hpref : hasPreferred kb st.subject st.property = true) :
    subclassEdges (submit st kb) = subclassEdges kb := by
  have hne : st.rank ≠ Rank.preferred := by simp [hnorm]
  have hst : IsTruthy kb st = false := by simp [IsTruthy, hnorm, hpref]
  have hsts : (submit st kb).statements = st :: kb.statements := rfl
  simp [subclassEdges, hsts, isTruthy_submit hne kb, hst]

-- @source DASHI Agda bridge (PR #555/#581/#582): capture without secrecy: a public rule surface with held interpretation
/-- **The derived subclass relation does not move.**  Consequently the whole
class engine is blind to shadowed submissions. -/
theorem isSubclassOf_submit_shadowed {st : Statement} (hnorm : st.rank = Rank.normal)
    (kb : KB) (hpref : hasPreferred kb st.subject st.property = true) (a b : Qid) :
    isSubclassOf (submit st kb) a b = isSubclassOf kb a b := by
  have hedges := subclassEdges_submit_shadowed hnorm kb hpref
  have hsup : superclasses (submit st kb) = superclasses kb := by
    funext c; simp [superclasses, hedges]
  simp [isSubclassOf, hsup, hedges]

/-! ## Publicity is not descent -/

/-- The public submitted record: every statement, with its rank stripped. -/
def unranked (kb : KB) : List (Qid × Pid × Qid) :=
  kb.statements.map (fun st => (st.subject, st.property, st.value))

/-- Sculptor. -/
def sculptor : Qid := ⟨1281618⟩
/-- Artist, as used in this module. -/
def artistQ : Qid := ⟨483501⟩

/-- The submission, accepted at normal rank. -/
def acceptedKB : KB :=
  ⟨[sculptor, artistQ],
    [{ subject := sculptor, property := P279, value := artistQ, rank := Rank.normal }]⟩

/-- The very same submission, deprecated by the validation seat. -/
def deprecatedKB : KB :=
  ⟨[sculptor, artistQ],
    [{ subject := sculptor, property := P279, value := artistQ, rank := Rank.deprecated }]⟩

/-- The two knowledge bases are the same public submitted record. -/
theorem unranked_eq : unranked acceptedKB = unranked deprecatedKB := by decide

/-- They answer the class query differently. -/
theorem answer_ne :
    isSubclassOf acceptedKB sculptor artistQ ≠ isSubclassOf deprecatedKB sculptor artistQ := by
  decide

-- @source DASHI Agda bridge (PR #555/#581/#582): capture without secrecy: a public rule surface with held interpretation
/-- **A fully public submission record does not determine the answers.**  No
reading of the unranked contributions reconstructs the derived class relation:
the interpretive act — ranking — is not in the record. -/
theorem answer_not_factorsThrough_unranked :
    ¬ FactorsThrough unranked (fun kb => isSubclassOf kb sculptor artistQ) :=
  not_factorsThrough unranked_eq answer_ne

/-- **Nor does any summary of it.**  Publishing the submissions in some further
digested form cannot recover what stripping the ranks destroyed. -/
theorem no_summary_of_submissions_decides {Public : Type} (report : List (Qid × Pid × Qid) → Public) :
    ¬ FactorsThrough (fun kb => report (unranked kb))
      (fun kb => isSubclassOf kb sculptor artistQ) :=
  not_factorsThrough_postcomp answer_not_factorsThrough_unranked

/-- **Publishing the ranked record restores descent.**  What the interpretive
seat contributes is exactly the ranks. -/
theorem answer_factorsThrough_ranked :
    FactorsThrough (fun kb => kb.statements) (fun kb => isSubclassOf kb sculptor artistQ) := by
  exact ⟨fun sts => isSubclassOf ⟨[], sts⟩ sculptor artistQ, fun _ => rfl⟩

end Wikidata
