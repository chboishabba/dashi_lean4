        GRNF.canonicalGRSelectedFourChartLeviCivitaBianchiEinsteinStagingReceipt
    ; riemannTensorComponent =
        GRNF.grSelectedFiniteRCurvatureAction
    ; riemannTensorComponentIsCanonicalZeroTable =
