namespace Epistemic

open Wikidata Wikidata.Sparql

/-- An imported property-path answer. -/
structure PathCertificate where
  /-- The knowledge base the path was evaluated against. -/
  kb : KB
  /-- The property path. -/
  path : Path
  /-- The subject the path was followed from. -/
  subject : Qid
  /-- The item the answer reports. -/
  target : Qid
  /-- Did the source check out? -/
  sourceMatched : Bool
  /-- The references carried with the import. -/
  references : List String

namespace PathCertificate

/-- Does the path really relate the reported items over this base? -/
def accepted (cert : PathCertificate) : Bool :=
  decide (Holds cert.kb cert.path cert.subject cert.target)

/-- Fail-closed evidence state. -/
def state (cert : PathCertificate) : Trit := receiptState cert.sourceMatched cert.accepted

theorem state_eq_supported_iff (cert : PathCertificate) :
    cert.state = Trit.supported ↔
      cert.sourceMatched = true ∧ Holds cert.kb cert.path cert.subject cert.target := by
  rw [state, receiptState_eq_supported_iff]
  exact and_congr_right fun _ => decide_eq_true_iff

/-- **Supported evidence really is a path answer.** -/
theorem holds_of_supported {cert : PathCertificate} (h : cert.state = Trit.supported) :
    Holds cert.kb cert.path cert.subject cert.target :=
  ((state_eq_supported_iff cert).1 h).2

/-- **Fail-closed import**: a path that does not relate the reported items leaves
the state `unresolved`, never a refutation. -/
theorem state_ne_contradicted (cert : PathCertificate) : cert.state ≠ Trit.contradicted :=
  receiptState_ne_contradicted _ _

theorem state_of_checker_failure {cert : PathCertificate} (h : cert.accepted = false) :
    cert.state = Trit.unresolved := by
  rw [state, h, receiptState_of_checker_failure]

end PathCertificate

/-- **A path answer is stable under growth.**  Every property path is positive, so
support obtained over one base is support over any larger one. -/
theorem path_support_is_stable {kb₁ kb₂ : KB} {pa : Path} {x y : Qid} {refs : List String}
    (hsub : kb₁.statements ⊆ kb₂.statements) (hnormal : AllNormal kb₂)
    (h : (⟨kb₁, pa, x, y, true, refs⟩ : PathCertificate).state = Trit.supported) :
    (⟨kb₂, pa, x, y, true, refs⟩ : PathCertificate).state = Trit.supported := by
  rw [PathCertificate.state_eq_supported_iff] at h ⊢
  exact ⟨rfl, holds_mono hsub hnormal pa h.2⟩

/-- **Support inside a named graph transfers to the dataset.**  A named graph is a
sub-base of the union, so this is the stable direction. -/
theorem graph_support_transfers_up {d : Dataset} {g : GraphName} {pa : Path} {x y : Qid}
    {refs : List String} (hnormal : AllNormal d.union)
    (h : (⟨d.graph g, pa, x, y, true, refs⟩ : PathCertificate).state = Trit.supported) :
    (⟨d.union, pa, x, y, true, refs⟩ : PathCertificate).state = Trit.supported :=
  path_support_is_stable (Dataset.graph_subset_union d g) hnormal h

/-- **Support over the dataset is not support in any of its graphs.**  The
transitive answer of the two-source dataset is supported over the union and
unresolved over each named graph, so a derived answer cannot be attributed to the
source it came through. -/
theorem dataset_support_is_not_graph_support :
    (⟨twoSources.union, Path.star (Step1.fwd P279), ⟨2⟩, ⟨4⟩, true, ["dump"]⟩ :
        PathCertificate).state = Trit.supported ∧
      (⟨twoSources.graph "a", Path.star (Step1.fwd P279), ⟨2⟩, ⟨4⟩, true, ["dump"]⟩ :
        PathCertificate).state = Trit.unresolved ∧
      (⟨twoSources.graph "b", Path.star (Step1.fwd P279), ⟨2⟩, ⟨4⟩, true, ["dump"]⟩ :
        PathCertificate).state = Trit.unresolved := by
  refine ⟨?_, PathCertificate.state_of_checker_failure (by decide),
    PathCertificate.state_of_checker_failure (by decide)⟩
  rw [PathCertificate.state_eq_supported_iff]
  exact ⟨rfl, by decide⟩

end Epistemic
