import RequestProject.CategoryOfOntologies

/-!
# Grothendieck topology: covering families of ontologies, stable under pullback

*Wikidata: Grothendieck topology (Q1062242), category theory (Q217413), topology
(Q42989), pullback (Q1397439), surjective function (Q229102).*

A Grothendieck topology is what turns a category into a space: instead of open
sets one declares which *families of morphisms* `Yᵢ ⟶ X` count as **covers** of
`X`, subject to one crucial axiom — a cover must remain a cover after **base
change**, i.e. after pulling it back along any morphism into `X`.

For ontologies there is an obvious candidate: a family of alignments covers the
reference ontology when every one of its items is named by at least one of them
(`Ontology.IsJointlySurjective`).  This file proves that this really is a
Grothendieck topology:

* `Ontology.surjectivePretopology` — jointly surjective families form a
  `CategoryTheory.Pretopology` on the category `Ont`.  The pullback-stability
  axiom is `Ontology.pbSnd_surjective_of_surjective` of
  `RequestProject.CategoryOfOntologies`: if the items of `Z` are all named by
  `X`, then after aligning with any `Y` the items of `Y` are all named by the
  fibre product.  So the pullback of `RequestProject.Reflection` is exactly what
  makes covers of ontologies behave like open covers of a space;
* `Ontology.ontologyTopology` — the Grothendieck topology it generates, and
  `Ontology.mem_ontologyTopology_iff`: a sieve covers when it contains a jointly
  surjective family;
* `Ontology.ontologyTopology_pullback_stable` — the pullback stability of
  covering sieves, spelled out;
* `Ontology.jointlySurjective_of_surjective` and
  `Ontology.singleton_mem_ontologyTopology` — a single surjective alignment is a
  cover, so an ontology is covered by any ontology that names all of its items.
-/

open CategoryTheory CategoryTheory.Limits

namespace Wikidata
namespace Ontology

universe u

/-- **A covering family of ontologies**: every item of `X` is named by at least
one member of the family. -/
def IsJointlySurjective {X : Ont.{u}} (S : Presieve X) : Prop :=
  ∀ x : X.carrier, ∃ (Y : Ont.{u}) (f : Y ⟶ X), S f ∧ ∃ y : Y.carrier, f.map y = x

/-- A single surjective alignment is a covering family. -/
theorem jointlySurjective_of_surjective {X Y : Ont.{u}} (f : Y ⟶ X)
    (hf : Function.Surjective f.map) : IsJointlySurjective (Presieve.singleton f) := by
  intro x
  obtain ⟨y, hy⟩ := hf x
  exact ⟨Y, f, Presieve.singleton_self f, y, hy⟩

/-- The covering families are stable under enlarging the family. -/
theorem IsJointlySurjective.mono {X : Ont.{u}} {S T : Presieve X} (h : S ≤ T)
    (hS : IsJointlySurjective S) : IsJointlySurjective T := by
  intro x
  obtain ⟨Y, f, hf, y, hy⟩ := hS x
  exact ⟨Y, f, h _ hf, y, hy⟩

/-- **Jointly surjective families are stable under base change.** This is the
pullback of `RequestProject.Reflection` doing the work: a matched pair over an
item `y` of `Y` exists because the covering family names the image of `y`. -/
theorem isJointlySurjective_pullbackArrows {X Y : Ont.{u}} (f : Y ⟶ X) (S : Presieve X)
    (hS : IsJointlySurjective S) : IsJointlySurjective (Presieve.pullbackArrows f S) := by
  intro y
  obtain ⟨W, h, hh, w, hw⟩ := hS (f.map y)
  refine ⟨Limits.pullback h f, Limits.pullback.snd h f, Presieve.pullbackArrows.mk W h hh, ?_⟩
  -- the matched pair `(w, y)` of the concrete fibre product, transported along
  -- the isomorphism with the chosen categorical pullback
  set iso := (isPullback_pbOnt h f).isoPullback with hiso
  refine ⟨iso.hom.map ⟨(w, y), hw⟩, ?_⟩
  have hsnd : iso.hom ≫ Limits.pullback.snd h f = pbSnd h f :=
    (isPullback_pbOnt h f).isoPullback_hom_snd
  exact congrFun (congrArg Morphism.map hsnd) ⟨(w, y), hw⟩

/-- **The pretopology of covering families.** Jointly surjective families of
alignments form a Grothendieck pretopology on the category of ontologies. -/
def surjectivePretopology : Pretopology Ont.{u} where
  coverings X := {S | IsJointlySurjective S}
  has_isos {X Y} f _ :=
    jointlySurjective_of_surjective f (bijective_of_isIso f).2
  pullbacks {X Y} f S hS := isJointlySurjective_pullbackArrows f S hS
  transitive {X} S Ti hS hTi := by
    intro x
    obtain ⟨Y, f, hf, y, hy⟩ := hS x
    obtain ⟨W, g, hg, w, hw⟩ := hTi f hf y
    refine ⟨W, g ≫ f, ⟨Y, g, f, hf, hg, rfl⟩, w, ?_⟩
    show f.map (g.map w) = x
    rw [hw, hy]

@[simp] theorem mem_surjectivePretopology {X : Ont.{u}} (S : Presieve X) :
    S ∈ surjectivePretopology.coverings X ↔ IsJointlySurjective S := Iff.rfl

/-- **The Grothendieck topology of ontologies**: the topology generated by the
jointly surjective families. -/
def ontologyTopology : GrothendieckTopology Ont.{u} :=
  surjectivePretopology.toGrothendieck

/-- A sieve covers exactly when it contains a jointly surjective family. -/
theorem mem_ontologyTopology_iff {X : Ont.{u}} (S : Sieve X) :
    S ∈ ontologyTopology X ↔ ∃ R : Presieve X, IsJointlySurjective R ∧ R ≤ (S : Presieve X) :=
  Iff.rfl

/-- The sieve generated by a surjective alignment covers. -/
theorem singleton_mem_ontologyTopology {X Y : Ont.{u}} (f : Y ⟶ X)
    (hf : Function.Surjective f.map) : Sieve.generate (Presieve.singleton f) ∈ ontologyTopology X :=
  ⟨Presieve.singleton f, jointlySurjective_of_surjective f hf, Sieve.le_generate _⟩

/-- **Covering sieves are stable under pullback** — the defining axiom of a
Grothendieck topology, here for ontologies. -/
theorem ontologyTopology_pullback_stable {X Y : Ont.{u}} (f : Y ⟶ X) {S : Sieve X}
    (hS : S ∈ ontologyTopology X) : S.pullback f ∈ ontologyTopology Y :=
  ontologyTopology.pullback_stable f hS

/-- Every ontology is covered by itself. -/
theorem top_mem_ontologyTopology (X : Ont.{u}) : (⊤ : Sieve X) ∈ ontologyTopology X :=
  ontologyTopology.top_mem X

end Ontology
end Wikidata
