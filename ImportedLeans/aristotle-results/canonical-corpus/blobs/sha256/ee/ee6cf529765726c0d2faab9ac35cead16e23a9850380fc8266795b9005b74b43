    (⋆IdL    : {l : Idx} → (b : G l) → _≡_ {A = Σ[ k ∈ Idx ] G k} ( ε · l , 1⋆ ⋆ b ) (l , b))
    (⋆DistR+ : {k l : Idx} → (a : G k) → (b c : G l) →
