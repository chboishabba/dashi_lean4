namespace Mirror.CRTJFixedPointBridge

open Mirror.CRTPeriod Mirror.JFixedPoint

/-- The Agda theorem `period-plus-one`. -/
theorem period_plus_one : period + 1 = 196884 := period_add_one

/-- The Agda theorem `unit-contract-period-plus-one`. -/
theorem unit_contract_period_plus_one : contract unitObs = period + 1 := rfl

/-- The Agda theorem `stack-contract-period-plus-one`. -/
theorem stack_contract_period_plus_one (n : ℕ) : contract (stack n) = period + 1 := by
  rw [stack_converges n, period_add_one]

/-- The Agda theorem `crt-periodicity-at-moonshine-minus-one`. -/
theorem crt_periodicity_at_moonshine_minus_one (k : ℕ) :
    d (period + k * period) = d period := period_thm period k

/-! ## The bridge as data -/

/-- The Agda `record CRTJFixedPointBridge`. -/
structure Bridge : Type where
  crtPeriodPlusOne : period + 1 = 196884
  unitContractMatchesPeriodPlusOne : contract unitObs = period + 1
  stackContractMatchesPeriodPlusOne : ∀ n : ℕ, contract (stack n) = period + 1
  moonshineMinusOnePeriodicity : ∀ k : ℕ, d (period + k * period) = d period

/-- The Agda `crtJFixedPointBridgeSurface`. -/
def crtJFixedPointBridgeSurface : Bridge where
  crtPeriodPlusOne := period_plus_one
  unitContractMatchesPeriodPlusOne := unit_contract_period_plus_one
  stackContractMatchesPeriodPlusOne := stack_contract_period_plus_one
  moonshineMinusOnePeriodicity := crt_periodicity_at_moonshine_minus_one

/-! ## The strengthening -/

/-- Every contraction is one more than a multiple of the period. -/
theorem contract_sub_one (o : Observation) :
    contract o - 1 = period * (o.e47 * o.e59 * o.e71) := by
  rw [contract_eq]
  simp only [Mirror.Moonshine.repDim, Mirror.Moonshine.trivectorProduct,
    Mirror.Moonshine.p47, Mirror.Moonshine.p59, Mirror.Moonshine.p71, period]
  omega

/-- **The bridge, in general.**  For every observation, `contract o - 1` is a
period of the digit function. -/
theorem isPeriod_contract_sub_one (o : Observation) : IsPeriod (contract o - 1) := by
  rw [contract_sub_one]
  exact (isPeriod_iff _).mpr ⟨_, rfl⟩

/-- Conversely, `contract o` itself is a period only in the degenerate case
where the observation is empty, since a contraction is never divisible by the
period. -/
theorem not_isPeriod_contract (o : Observation) : ¬ IsPeriod (contract o) := by
  intro h
  have hdvd := (isPeriod_iff _).mp h
  have hrp : period = Mirror.Moonshine.repDim := by
    norm_num [period, Mirror.Moonshine.repDim, Mirror.Moonshine.trivectorProduct,
      Mirror.Moonshine.p47, Mirror.Moonshine.p59, Mirror.Moonshine.p71]
  have hmod : contract o % period = 1 := by rw [hrp]; exact contract_mod o
  have hzero : contract o % period = 0 := Nat.dvd_iff_mod_eq_zero.mp hdvd
  omega

/-- The digit function vanishes at every multiple of the period, in particular at
`196883` itself and at `contract o - 1` for every observation. -/
theorem d_contract_sub_one (o : Observation) : d (contract o - 1) = 0 := by
  have h := isPeriod_contract_sub_one o 0
  rw [Nat.zero_add] at h
  rw [h]
  norm_num [d]

end Mirror.CRTJFixedPointBridge
