       {gfx=0 : ∀ (x : X) → g $cr (f x) ≡ CommRingStr.0r (snd S)} →
       inducedHom R f g gfx=0 ∘cr quotientImageHom R f ≡ g
  evalInduce R = CommRingHom≡ refl


