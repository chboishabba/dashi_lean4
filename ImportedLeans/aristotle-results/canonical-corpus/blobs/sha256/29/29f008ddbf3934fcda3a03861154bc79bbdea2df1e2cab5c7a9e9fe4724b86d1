namespace Epistemic

/-- Independent evidence for a proposition and for its negation. -/
structure SupportSquare where
  /-- Is there evidence supporting the proposition? -/
  forPos : Bool
  /-- Is there evidence supporting its negation? -/
  against : Bool
  deriving DecidableEq, Repr, Inhabited

/-- The four corners of the support square. -/
inductive Corner
  | neitherEstablished
  | positionOnly
  | counterOnly
  | bothSupported
  deriving DecidableEq, Repr, Inhabited

namespace SupportSquare

/-- No evidence at all. -/
def empty : SupportSquare := ⟨false, false⟩

/-- Exchange the two coordinates: the square of the negated proposition. -/
def swap (s : SupportSquare) : SupportSquare := ⟨s.against, s.forPos⟩

@[simp] theorem swap_swap (s : SupportSquare) : s.swap.swap = s := rfl

/-- Pooling two sources: evidence is kept from either side. -/
def merge (s t : SupportSquare) : SupportSquare :=
  ⟨s.forPos || t.forPos, s.against || t.against⟩

@[simp] theorem merge_empty_left (s : SupportSquare) : merge empty s = s := by
  cases s; rfl

@[simp] theorem merge_empty_right (s : SupportSquare) : merge s empty = s := by
  obtain ⟨a, b⟩ := s
  simp [merge, empty]

theorem merge_comm (s t : SupportSquare) : merge s t = merge t s := by
  obtain ⟨a, b⟩ := s; obtain ⟨c, d⟩ := t
  simp [merge, Bool.or_comm]

theorem merge_assoc (r s t : SupportSquare) :
    merge (merge r s) t = merge r (merge s t) := by
  obtain ⟨a, b⟩ := r; obtain ⟨c, d⟩ := s; obtain ⟨e, f⟩ := t
  simp [merge, Bool.or_assoc]

@[simp] theorem merge_self (s : SupportSquare) : merge s s = s := by
  obtain ⟨a, b⟩ := s
  simp [merge]

/-- The knowledge order: `s ⊑ t` when `t` records at least as many observations. -/
def Knows (s t : SupportSquare) : Prop :=
  (s.forPos = true → t.forPos = true) ∧ (s.against = true → t.against = true)

theorem knows_refl (s : SupportSquare) : Knows s s := ⟨id, id⟩

theorem knows_trans {r s t : SupportSquare} (h₁ : Knows r s) (h₂ : Knows s t) : Knows r t :=
  ⟨fun h => h₂.1 (h₁.1 h), fun h => h₂.2 (h₁.2 h)⟩

theorem knows_antisymm {s t : SupportSquare} (h₁ : Knows s t) (h₂ : Knows t s) : s = t := by
  obtain ⟨a, b⟩ := s; obtain ⟨c, d⟩ := t
  obtain ⟨h₁a, h₁b⟩ := h₁
  obtain ⟨h₂a, h₂b⟩ := h₂
  cases a <;> cases b <;> cases c <;> cases d <;> simp_all

/-- Ignorance is the bottom of the knowledge order. -/
theorem knows_empty (s : SupportSquare) : Knows empty s := by
  simp [Knows, empty]

/-- Merging only ever adds knowledge. -/
theorem knows_merge_left (s t : SupportSquare) : Knows s (merge s t) := by
  constructor <;> intro h <;> simp [merge, h]

theorem knows_merge_right (s t : SupportSquare) : Knows t (merge s t) := by
  constructor <;> intro h <;> simp [merge, h]

/-- `merge` is the least upper bound in the knowledge order. -/
theorem merge_knows_of_knows {s t u : SupportSquare} (h₁ : Knows s u) (h₂ : Knows t u) :
    Knows (merge s t) u := by
  obtain ⟨a, b⟩ := s; obtain ⟨c, d⟩ := t
  constructor <;> intro h <;> simp only [merge, Bool.or_eq_true] at h <;>
    rcases h with h | h
  · exact h₁.1 h
  · exact h₂.1 h
  · exact h₁.2 h
  · exact h₂.2 h

end SupportSquare

/-- The corner of the square a pair of observations lands in. -/
def classify (s : SupportSquare) : Corner :=
  match s.forPos, s.against with
  | false, false => Corner.neitherEstablished
  | true, false => Corner.positionOnly
  | false, true => Corner.counterOnly
  | true, true => Corner.bothSupported

/-- The square a corner comes from. -/
def cornerSquare : Corner → SupportSquare
  | Corner.neitherEstablished => ⟨false, false⟩
  | Corner.positionOnly => ⟨true, false⟩
  | Corner.counterOnly => ⟨false, true⟩
  | Corner.bothSupported => ⟨true, true⟩

@[simp] theorem classify_cornerSquare (c : Corner) : classify (cornerSquare c) = c := by
  cases c <;> rfl

@[simp] theorem cornerSquare_classify (s : SupportSquare) : cornerSquare (classify s) = s := by
  obtain ⟨a, b⟩ := s
  cases a <;> cases b <;> rfl

/-- The corner determines the observations: nothing is lost by naming corners. -/
theorem classify_injective {s t : SupportSquare} (h : classify s = classify t) : s = t := by
  rw [← cornerSquare_classify s, ← cornerSquare_classify t, h]

@[simp] theorem classify_eq_both_iff (s : SupportSquare) :
    classify s = Corner.bothSupported ↔ s.forPos = true ∧ s.against = true := by
  obtain ⟨a, b⟩ := s
  cases a <;> cases b <;> simp [classify]

@[simp] theorem classify_eq_neither_iff (s : SupportSquare) :
    classify s = Corner.neitherEstablished ↔ s.forPos = false ∧ s.against = false := by
  obtain ⟨a, b⟩ := s
  cases a <;> cases b <;> simp [classify]

theorem classify_swap (s : SupportSquare) :
    classify s.swap =
      match classify s with
      | Corner.positionOnly => Corner.counterOnly
      | Corner.counterOnly => Corner.positionOnly
      | c => c := by
  obtain ⟨a, b⟩ := s
  cases a <;> cases b <;> rfl

/-! ## Collapsing to a single evidence state -/

/-- The three-valued reading of a corner.  Both indeterminate corners — nothing
observed, and both sides observed — become `unresolved`. -/
def collapse : Corner → Trit
  | Corner.positionOnly => Trit.supported
  | Corner.counterOnly => Trit.contradicted
  | Corner.neitherEstablished => Trit.unresolved
  | Corner.bothSupported => Trit.unresolved

/-- A corner is *resolved* when exactly one side has evidence. -/
def Corner.Resolved : Corner → Prop
  | Corner.positionOnly => True
  | Corner.counterOnly => True
  | _ => False

instance : DecidablePred Corner.Resolved := by
  intro c; cases c <;> unfold Corner.Resolved <;> infer_instance

/-- **The collapse loses information**, and loses it exactly by identifying the
two indeterminate corners: a conflict of certified sources and a total absence of
sources become the same evidence state. -/
theorem collapse_not_injective :
    Corner.bothSupported ≠ Corner.neitherEstablished ∧
      collapse Corner.bothSupported = collapse Corner.neitherEstablished :=
  ⟨by decide, rfl⟩

/-- On the resolved corners the collapse loses nothing. -/
theorem collapse_inj_of_resolved {c d : Corner} (hc : c.Resolved) (hd : d.Resolved)
    (h : collapse c = collapse d) : c = d := by
  cases c <;> cases d <;> simp_all [Corner.Resolved, collapse]

/-- The two corners the collapse identifies are the only ones it identifies. -/
theorem eq_of_collapse_eq_of_ne {c d : Corner} (hne : c ≠ d) (h : collapse c = collapse d) :
    (c = Corner.bothSupported ∧ d = Corner.neitherEstablished) ∨
      (c = Corner.neitherEstablished ∧ d = Corner.bothSupported) := by
  cases c <;> cases d <;> simp_all [collapse]

/-- Negation of the proposition corresponds to Kleene negation after collapse. -/
theorem collapse_classify_swap (s : SupportSquare) :
    collapse (classify s.swap) = Trit.neg (collapse (classify s)) := by
  obtain ⟨a, b⟩ := s
  cases a <;> cases b <;> rfl

/-! ## Import and cross-source merge -/

/-- The square produced by importing one source verdict.  A single source can
support at most one side, so the top corner is unreachable from one import. -/
def importSquare (sourceMatched accepted : Bool) : ObjectVerdict → SupportSquare
  | ObjectVerdict.certifiedHolds => ⟨sourceMatched && accepted, false⟩
  | ObjectVerdict.certifiedRefuted => ⟨false, sourceMatched && accepted⟩
  | ObjectVerdict.notObserved => SupportSquare.empty

-- @source DASHI Agda bridge (PR #555/#581/#582): the square refines the trit: collapsing a single
/-- **The square refines the trit**: collapsing an imported square reproduces the
evidence state of `verdictState`. -/
theorem collapse_importSquare (m a : Bool) (v : ObjectVerdict) :
    collapse (classify (importSquare m a v)) = verdictState m a v := by
  cases v <;> cases m <;> cases a <;> rfl

-- @source DASHI Agda bridge (PR #555/#581/#582): and a single source can never reach the top corner on
/-- **One source never conflicts with itself.** -/
theorem importSquare_ne_both (m a : Bool) (v : ObjectVerdict) :
    classify (importSquare m a v) ≠ Corner.bothSupported := by
  cases v <;> cases m <;> cases a <;> decide

/-- An unobserved source contributes nothing to a merge. -/
theorem merge_importSquare_notObserved (m a : Bool) (s : SupportSquare) :
    SupportSquare.merge (importSquare m a ObjectVerdict.notObserved) s = s := by
  cases s; rfl

/-- The square of a single evidence state. -/
def tritSquare : Trit → SupportSquare
  | Trit.supported => ⟨true, false⟩
  | Trit.contradicted => ⟨false, true⟩
  | Trit.unresolved => SupportSquare.empty

@[simp] theorem collapse_classify_tritSquare (t : Trit) : collapse (classify (tritSquare t)) = t := by
  cases t <;> rfl

-- @source DASHI Agda bridge (PR #555/#581/#582): the cross-source comparison we already
/-- **Conflict is exactly the top corner.**  The cross-source comparison of
`Trit.lean` is the merge of the two support squares: two sources conflict
precisely when the pooled square has evidence on both sides. -/
theorem conflicting_iff_merge_bothSupported (s t : Trit) :
    compareStates s t = Disposition.conflicting ↔
      classify (SupportSquare.merge (tritSquare s) (tritSquare t)) = Corner.bothSupported := by
  cases s <;> cases t <;> simp [compareStates, SupportSquare.merge, tritSquare,
    SupportSquare.empty, classify]

/-- Replication is a resolved corner: agreeing sources pool to one side only. -/
theorem replicated_imp_resolved {s t : Trit} (h : compareStates s t = Disposition.replicated) :
    (classify (SupportSquare.merge (tritSquare s) (tritSquare t))).Resolved := by
  cases s <;> cases t <;> simp_all [compareStates, SupportSquare.merge, tritSquare,
    classify, Corner.Resolved]

-- @source DASHI Agda bridge (PR #555/#581/#582): hence the order of operations
/-- **Merging before collapsing is not the same as collapsing before merging.**
Two sources that certify opposite verdicts pool into the top corner, which the
collapse cannot distinguish from having heard nothing — so the merge has to
happen on squares. -/
theorem merge_then_collapse_ne_collapse_then_merge :
    ∃ s t : Trit,
      collapse (classify (SupportSquare.merge (tritSquare s) (tritSquare t))) = Trit.unresolved ∧
        compareStates s t = Disposition.conflicting ∧
        compareStates Trit.unresolved Trit.unresolved = Disposition.comparisonUnresolved := by
  exact ⟨Trit.supported, Trit.contradicted, rfl, rfl, rfl⟩

/-! ## Meta-status: why a claim is indeterminate

The corner says *what* was observed.  It does not say *why* a claim failed to
resolve, and the two must not be confused: a claim outside the scope of the
sources is not a refuted claim. -/

/-- Why a claim is not resolved. -/
inductive MetaStatus
  | settled
  | underdetermined
  | inexpressible
  | scopeExceeded
  deriving DecidableEq, Repr, Inhabited

/-- A corner together with the reason it is where it is. -/
structure Qualified where
  corner : Corner
  status : MetaStatus
  deriving DecidableEq, Repr, Inhabited

/-- Adding a meta-status leaves the underlying corner untouched. -/
@[simp] theorem Qualified.corner_mk (c : Corner) (m : MetaStatus) :
    (Qualified.mk c m).corner = c := rfl

/-- The evidence state reported for a qualified claim: only a settled claim
reports its corner; every other meta-status reports ignorance. -/
def Qualified.state (q : Qualified) : Trit :=
  if q.status = MetaStatus.settled then collapse q.corner else Trit.unresolved

/-- **Out-of-scope is not refutation.**  No meta-status other than `settled` can
report a determinate state, whatever the corner says. -/
theorem Qualified.state_of_unsettled {q : Qualified} (h : q.status ≠ MetaStatus.settled) :
    q.state = Trit.unresolved := by
  simp [Qualified.state, h]

theorem Qualified.scopeExceeded_ne_contradicted (c : Corner) :
    (Qualified.mk c MetaStatus.scopeExceeded).state ≠ Trit.contradicted := by
  simp [Qualified.state]

end Epistemic
