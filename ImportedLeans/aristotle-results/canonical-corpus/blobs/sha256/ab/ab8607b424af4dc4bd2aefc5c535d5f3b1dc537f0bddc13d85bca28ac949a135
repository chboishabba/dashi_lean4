        (funExt λ _ → transportRefl _)
      ∙ₑ joinPushout≃join _ _

  fiber⋁↪≃ : fiber fun (x₀ , y₀) ≃ join (typ (Ω Y∙)) (typ (Ω X∙))
  fiber⋁↪≃ = Σ-cong-equiv-snd (λ a → pathToEquiv (sym (E≡ a)))
