    nf-uR _ _ (IsNormalised[x] (true , a))
     (NF.isNormalisedWord nfa) (⇊1g++comm _ [ false , a ] (≡ε u)))
      (Iso.fun (≡→red _ _) (isoInvInjective (fst (GroupIso-FG-L/↘↙))
