namespace Mirror.Moonshine

/-! ## §1 The trivector primes -/

def p47 : ℕ := 47
def p59 : ℕ := 59
def p71 : ℕ := 71

theorem p47_prime : Nat.Prime p47 := by norm_num [p47]
theorem p59_prime : Nat.Prime p59 := by norm_num [p59]
theorem p71_prime : Nat.Prime p71 := by norm_num [p71]

/-! ## §2 The moonshine equation `47 × 59 × 71 + 1 = 196884` -/

def trivectorProduct : ℕ := p47 * p59 * p71

/-- The `+1`: the witness, the observer, the act of measurement. -/
def observer : ℕ := 1

def jCoefficient : ℕ := trivectorProduct + observer

/-- The Agda theorem `moonshine`. -/
theorem moonshine : jCoefficient = 196884 := rfl

/-! ## §3 The representation dimension -/

def repDim : ℕ := trivectorProduct

/-- The Agda theorem `rep-dim-check`. -/
theorem rep_dim_check : repDim = 196883 := rfl

/-- The Agda theorem `mckay`: McKay's observation `196884 = 196883 + 1`. -/
theorem mckay : repDim + 1 = jCoefficient := rfl

/-- The Agda theorem `embedding`. -/
theorem embedding : trivectorProduct + observer = 196884 := rfl

/-! ## §4 `j`-fixed witnesses -/

/-- The Agda `data Witness : Set` with its single constructor. -/
inductive Witness : Type
  | witness (c47 c59 c71 : ℕ) : Witness
  deriving DecidableEq

/-- The Agda `is-j-fixed`, together with its `where`-bound conjunction. -/
def isJFixed : Witness → Bool
  | .witness c47 c59 c71 => decide (0 < c47) && (decide (0 < c59) && decide (0 < c71))

/-- The minimal witness: each trivector prime appears exactly once. -/
def theObserver : Witness := .witness 1 1 1

/-- The Agda theorem `observer-is-j-fixed`. -/
theorem observer_is_j_fixed : isJFixed theObserver = true := rfl

/-- A witness is `j`-fixed exactly when all three trivector primes occur. -/
theorem isJFixed_iff {c47 c59 c71 : ℕ} :
    isJFixed (.witness c47 c59 c71) = true ↔ 0 < c47 ∧ 0 < c59 ∧ 0 < c71 := by
  simp [isJFixed]

/-! ## §5 The Monster's largest prime divisors

The Agda's prose claim, checked.
-/

/-- The prime factorisation of the order of the Monster, as a list of
`(prime, exponent)` pairs. -/
def monsterFactors : List (ℕ × ℕ) :=
  [(2, 46), (3, 20), (5, 9), (7, 6), (11, 2), (13, 3), (17, 1), (19, 1),
   (23, 1), (29, 1), (31, 1), (41, 1), (47, 1), (59, 1), (71, 1)]

/-- The order of the Monster sporadic simple group, defined by its
factorisation. -/
def monsterOrder : ℕ := (monsterFactors.map fun pe => pe.1 ^ pe.2).prod

theorem monsterOrder_eq :
    monsterOrder = 808017424794512875886459904961710757005754368000000000 := by
  norm_num [monsterOrder, monsterFactors]

/-- Every entry of `monsterFactors` is a prime with a positive exponent. -/
theorem monsterFactors_prime :
    ∀ pe ∈ monsterFactors, Nat.Prime pe.1 ∧ 0 < pe.2 := by
  decide

/-- If a prime divides a product of prime powers it divides one of the bases. -/
theorem prime_dvd_prod_pow {q : ℕ} (hq : Nat.Prime q) :
    ∀ l : List (ℕ × ℕ), q ∣ (l.map fun pe => pe.1 ^ pe.2).prod → ∃ pe ∈ l, q ∣ pe.1
  | [], h => by
      simp only [List.map_nil, List.prod_nil] at h
      exact absurd (Nat.dvd_one.mp h) hq.ne_one
  | pe :: l, h => by
      simp only [List.map_cons, List.prod_cons] at h
      rcases (Nat.Prime.dvd_mul hq).mp h with h' | h'
      · exact ⟨pe, List.mem_cons_self, hq.dvd_of_dvd_pow h'⟩
      · obtain ⟨pe', hmem, hdvd⟩ := prime_dvd_prod_pow hq l h'
        exact ⟨pe', List.mem_cons_of_mem _ hmem, hdvd⟩

/-- The primes dividing the order of the Monster are exactly the fifteen
supersingular primes listed in `monsterFactors`. -/
theorem prime_dvd_monsterOrder_iff {q : ℕ} (hq : Nat.Prime q) :
    q ∣ monsterOrder ↔ q ∈ monsterFactors.map Prod.fst := by
  constructor
  · intro h
    obtain ⟨pe, hmem, hdvd⟩ := prime_dvd_prod_pow hq monsterFactors h
    have hp : Nat.Prime pe.1 := (monsterFactors_prime pe hmem).1
    have : q = pe.1 := ((Nat.prime_dvd_prime_iff_eq hq hp).mp hdvd)
    exact this ▸ List.mem_map_of_mem hmem
  · intro h
    obtain ⟨pe, hmem, rfl⟩ := List.mem_map.mp h
    have hpos : 0 < pe.2 := (monsterFactors_prime pe hmem).2
    have h1 : pe.1 ∣ pe.1 ^ pe.2 := dvd_pow_self _ hpos.ne'
    refine h1.trans (List.dvd_prod ?_)
    exact List.mem_map_of_mem hmem

/-- Every prime divisor of the order of the Monster is at most `71`. -/
theorem prime_dvd_monsterOrder_le {q : ℕ} (hq : Nat.Prime q) (h : q ∣ monsterOrder) :
    q ≤ 71 := by
  have := (prime_dvd_monsterOrder_iff hq).mp h
  revert this
  simp only [monsterFactors, List.map_cons, List.map_nil, List.mem_cons,
    List.not_mem_nil, or_false]
  rintro (rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl |
    rfl | rfl | rfl) <;> norm_num

/-- **The three largest primes dividing the order of the Monster are `47`, `59`
and `71`**: they divide it, and every other prime divisor is at most `41`. -/
theorem largest_prime_divisors :
    p47 ∣ monsterOrder ∧ p59 ∣ monsterOrder ∧ p71 ∣ monsterOrder ∧
      ∀ q, Nat.Prime q → q ∣ monsterOrder → q ≠ p47 → q ≠ p59 → q ≠ p71 → q ≤ 41 := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · exact (prime_dvd_monsterOrder_iff p47_prime).mpr (by decide)
  · exact (prime_dvd_monsterOrder_iff p59_prime).mpr (by decide)
  · exact (prime_dvd_monsterOrder_iff p71_prime).mpr (by decide)
  · intro q hq h h47 h59 h71
    have := (prime_dvd_monsterOrder_iff hq).mp h
    simp only [monsterFactors, List.map_cons, List.map_nil, List.mem_cons,
      List.not_mem_nil, or_false] at this
    simp only [p47, p59, p71] at h47 h59 h71
    rcases this with (rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl |
      rfl | rfl | rfl | rfl | rfl) <;> omega

/-- `47 · 59 · 71 = 196883`. -/
theorem trivector_product_eq_repDim : trivectorProduct = 196883 := rfl

end Mirror.Moonshine
