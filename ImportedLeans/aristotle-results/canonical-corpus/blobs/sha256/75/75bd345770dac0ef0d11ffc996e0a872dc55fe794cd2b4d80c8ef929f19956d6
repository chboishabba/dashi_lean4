      forIn blocks ⟨buf, filesWritten, report, truncated, wc⟩ fun block r =>
          have buf := r.fst;
          have x := r.snd;
          have filesWritten := x.fst;
          have x := x.snd;
          have report := x.fst;
          have x := x.snd;
          have truncated := x.fst;
          have wc := x.snd;
          have cw := AristotleExporter.estimateWords block;
          have __do_jp := fun buf filesWritten report truncated wc y =>
            have buf := buf ++ block;
            have wc := wc + cw;
            do
            pure PUnit.unit
            pure (ForInStep.yield ⟨buf, filesWritten, report, truncated, wc⟩);
          if (decide (wc > 0) && decide (wc + cw > cfg.maxWordsPerFile)) = true then
            have fname :=
              cfg.outputDir /
                {
