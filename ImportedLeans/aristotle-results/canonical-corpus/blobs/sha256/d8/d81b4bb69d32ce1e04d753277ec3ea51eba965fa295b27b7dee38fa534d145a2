data BTDepthIndex : Set where
  finiteDepthBTBuildingDepth : BTDepthIndex

data BTCellComplexCarrier : Set where
  finiteDepthBTBuildingCellComplex : BTCellComplexCarrier

data BTPrimalCellCarrier : Set where
