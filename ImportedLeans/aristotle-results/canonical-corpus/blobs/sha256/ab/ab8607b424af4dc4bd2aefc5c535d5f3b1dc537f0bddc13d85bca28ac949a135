    → ((x : _) → isProp (B x))
    → (a* : A)
    → ((l1 : a* ≡ a*) (sq : l1 ≡ sym l1)
         → B (RP²Fun a* l1 sq))
    → (x : _) → B x
  elim₁  conA pr a* ind f =
    TR.rec (pr _)
      (λ p → J (λ a* _ → ((l1 : a* ≡ a*) (sq : l1 ≡ sym l1)
                        → B (RP²Fun a* l1 sq)) → B f)
                (λ ind → subst B (characRP²Fun f) (ind _ _))
                p ind)
      (isConnectedPath 1 conA (f point) a* .fst)

  elim₂ : isConnected 3 A
    → ((x : _) → isProp (B x))
    → (a* : A)
    → ((sq : refl {x = a*} ≡ refl)
         → B (RP²Fun a* refl sq))
    → (x : _) → B x
