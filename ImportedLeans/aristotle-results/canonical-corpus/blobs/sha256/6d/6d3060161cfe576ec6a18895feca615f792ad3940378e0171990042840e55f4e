PDA-71 A = record
  { observe = λ s → shardEV A (extractEV A s)
  ; admissible = λ _ → ⊤
  ; costPDA = 71  -- “limit to 71” lens price placeholder
  }

-- IID71 model turned into an ObsModel
obsModel71 : IID71 → ObsModel Bucket
obsModel71 M = record
  { Lmodel = Lmodel71 M
  ; Ldata| = λ bs → Ldata|71 M (bs)
  }

