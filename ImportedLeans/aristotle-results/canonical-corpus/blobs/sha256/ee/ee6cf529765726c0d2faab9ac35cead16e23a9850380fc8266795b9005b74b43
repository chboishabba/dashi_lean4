    (⋆DistL+ : {k l : Idx} → (a b : G k) → (c : G l) →
               ((Gstr k) ._+_ a b) ⋆ c ≡ Gstr (k · l) ._+_ (a ⋆ c) (b ⋆ c))
    where


-----------------------------------------------------------------------------
-- Ring Properties

    _prod_ : ⊕G → ⊕G → ⊕G
    _prod_ = DS-Rec-Set.f _ _ _ _ (isSetΠ λ _ → isSet⊕G)
             (λ _ → 0⊕)
