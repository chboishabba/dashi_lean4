closestFromFejer :
  ∀ {ℓx ℓs} {X : Set ℓx} {P : Preorder {ℓs}}
  (ES : EnergySpace X P) (Pj : Projection X)
  (Ax : FejerClosestAxioms ES Pj) →
  ClosestPoint ES Pj
