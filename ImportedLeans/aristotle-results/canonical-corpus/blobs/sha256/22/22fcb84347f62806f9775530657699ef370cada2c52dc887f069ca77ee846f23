  record
    { prequotientEvolution =
        E
    ; quotientEvolution =
        QS.quotientRec Q
          _
          (λ ψ →
            QS.quotientClass Q
              (QS.SetoidUnaryOperationSurface.unaryOperation E ψ))
          (λ ψ χ ψ≈χ →
            QS.quotientSound Q
              (QS.SetoidUnaryOperationSurface.unaryOperationRespects≈
                E
                ψ≈χ))
    ; quotientEvolution-β =
        λ ψ →
          QS.quotientRec-β Q
            _
            (λ χ →
              QS.quotientClass Q
                (QS.SetoidUnaryOperationSurface.unaryOperation E χ))
            (λ χ χ′ χ≈χ′ →
              QS.quotientSound Q
                (QS.SetoidUnaryOperationSurface.unaryOperationRespects≈
                  E
                  χ≈χ′))
            ψ
    ; kernelPreservation =
        λ ψ≈χ →
          QS.SetoidUnaryOperationSurface.unaryOperationRespects≈
            E
            ψ≈χ
