                           (EM-raw→EM G' (suc n) a) .fst
                            (cup∙ (suc m) (suc l)
                             (EM-raw'→EM H' (suc m) y) .fst
                              (EM-raw'→EM L' (suc l) z))))) ) j))
          ∙ cong (cong (substFun (suc (suc n)) (suc m) (suc l)))
