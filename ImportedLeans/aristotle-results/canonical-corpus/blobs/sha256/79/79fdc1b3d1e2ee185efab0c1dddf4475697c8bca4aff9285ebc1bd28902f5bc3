    ; shell2BoundaryNotIdentical =
        B4OC.B4ObservableComparison.rawShiftShell2Mismatch
          B4OC.canonicalB4ObservableComparison
    ; signaturePreserved = refl
    }

canonicalLiftedShiftObservable :
  COW.ClosureObservableWitness
canonicalLiftedShiftObservable =
