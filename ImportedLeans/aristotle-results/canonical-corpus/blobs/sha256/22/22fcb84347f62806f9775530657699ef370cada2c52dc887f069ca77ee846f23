setoidKernelPreservingEvolutionDescent :
  {ℓw ℓr ℓq : Level} →
  {S : QS.SetoidSurface ℓw ℓr} →
  (Q : QS.SetoidQuotientSurface S ℓq) →
  (E : QS.SetoidUnaryOperationSurface S) →
  KernelPreservingEvolutionDescent Q
