  ∀ {n t} → (dt : BrainDt) → BrainRegionThemeAt n t → Nat
regionDynamicSemanticDrift dt theme =
  semanticDistance
    (regionThemeSemantic theme)
    (regionThemeSemantic (TdynRegion dt theme))

