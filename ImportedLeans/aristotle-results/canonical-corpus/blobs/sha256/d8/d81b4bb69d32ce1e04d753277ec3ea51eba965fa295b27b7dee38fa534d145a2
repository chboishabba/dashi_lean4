canonicalNSAdjacentDissipationIngredients =
  adjacentOnlyStretchingEstimate
  ∷ highFrequencyDissipationIdentity
  ∷ correctedExponentDominanceCalculation
  ∷ thresholdSobolevIndexScope
  ∷ []

