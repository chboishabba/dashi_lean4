------------------------------------------------------------------------
-- A concrete nontrivial element of SU(2): the imaginary unit i.
------------------------------------------------------------------------

imaginaryUnitQ : Quaternion
imaginaryUnitQ = quat zeroR oneR zeroR zeroR

imaginaryUnitNorm : normSquaredQ imaginaryUnitQ ≡ oneR
imaginaryUnitNorm =
  trans
    (normSquaredExpand imaginaryUnitQ)
    (trans
      (cong₂ _+R_
        (cong₂ _+R_
          (cong₂ _+R_
            (zeroˡ zeroR)
            (*-identityˡ oneR))
          (zeroˡ zeroR))
        (zeroˡ zeroR))
      (trans
        (+-identityʳ ((zeroR +R oneR) +R zeroR))
        (trans
          (+-identityʳ (zeroR +R oneR))
          (+-identityˡ oneR))))

su2ImaginaryUnit : SU2Quaternion
su2ImaginaryUnit = su2q imaginaryUnitQ imaginaryUnitNorm

------------------------------------------------------------------------
-- The SU(2) instance of the Eq. (119) realization.
------------------------------------------------------------------------

module SU2Equation119 {N : Nat} {{nz : NonZero N}} where

  open R146.Equation119 {N = N} su2QuaternionGroup su2ScalarAdjointLinearModule
    public

  SU2Inputs : Set
  SU2Inputs = Equation119Inputs

  -- The instance is assembled from actual SU(2) lattice data.  Only the two
  -- ad-functional-calculus operators remain to be produced from CMP98 Sect. A.
  su2Inputs :
    (blockSide : Nat) →
    (axis : Axis4) →
    (V0 : DirectedGaugeField4 N su2QuaternionGroup) →
    (inverseBlockVolume : ℝ) →
    (expY : Cube4 N → Cube4 N → SU2Quaternion) →
    (expYCoarse : Cube4 N → SU2Quaternion) →
    (gCalculus : Cube4 N → SU2LieAlgebra → SU2LieAlgebra) →
    (gInverseCalculus : Cube4 N → Cube4 N → SU2LieAlgebra → SU2LieAlgebra) →
    SU2Inputs
  su2Inputs blockSide axis V0 inverseBlockVolume expY expYCoarse
    gCalculus gInverseCalculus = record
    { blockLength = blockSide
    ; coarseAxis = axis
    ; background = V0
    ; inverseVolumeWeight = inverseBlockVolume
    ; expBlockY = expY
    ; expCoarseY = expYCoarse
    ; gOp = gCalculus
    ; gInvOp = gInverseCalculus
    }

  -- Gauge covariance of the SU(2) instance: a specialization of the Round146
  -- theorem, with the adjoint action being the literal quaternion conjugation.
  su2Equation119GaugeCovariant :
    (I : SU2Inputs)
    (h : GaugeFunction4 N su2QuaternionGroup)
    (A : DirectedAdjointBondField4 N su2QuaternionGroup
           (linear su2ScalarAdjointLinearModule))
    (root : Cube4 N) →
    equation119QPrime (gaugeTransformInputs h I)
      (transformAdjointBondField su2QuaternionGroup
        (linear su2ScalarAdjointLinearModule) h A)
      root
    ≡ action (additive (linear su2ScalarAdjointLinearModule)) (h root)
        (equation119QPrime I A root)
  su2Equation119GaugeCovariant = equation119GaugeCovariant

  -- A nontrivial SU(2) background: every bond carries the imaginary unit, so
  -- the transports appearing in (119) are not the identity.
  imaginaryBackground : DirectedGaugeField4 N su2QuaternionGroup
  imaginaryBackground _ = su2ImaginaryUnit

  trivialBackground : DirectedGaugeField4 N su2QuaternionGroup
  trivialBackground _ = su2Identity

cmp98Equation119SU2InstanceRound149Level : ProofLevel
cmp98Equation119SU2InstanceRound149Level = machineChecked

