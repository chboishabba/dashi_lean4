    CompatibleFamilySurface-v :
      CompatibleFamilySurface
      ≡
      ProCompatibleFamily P

    pointToFamily :
      PointSurface →
      CompatibleFamilySurface

    familyToPoint :
      CompatibleFamilySurface →
