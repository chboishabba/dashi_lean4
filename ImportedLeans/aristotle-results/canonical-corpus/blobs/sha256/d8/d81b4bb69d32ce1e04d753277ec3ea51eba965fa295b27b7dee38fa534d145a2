module DASHI.Physics.Closure.PhysicsClosureFull where

open import Agda.Builtin.Sigma using (Σ; _,_)
open import Agda.Primitive using (Setω)
open import Agda.Builtin.Nat using (Nat) renaming (_+_ to _+N_)
