/-- **Provenance coverage.**  Every consumed mirror names the source file it was
transcribed from: there is no anonymous mirror in the Level-II/III spine. -/
theorem every_consumed_mirror_has_provenance :
    consumedMirrors.all (fun r => !r.source.isEmpty && !r.mirror.isEmpty) = true := rfl

/-- A row claiming a present source carries a digest. -/
theorem present_rows_have_a_digest :
    consumedMirrors.all (fun r =>
      match r.status with
      | .present => !r.digest.isEmpty
      | .sourceAbsent => true) = true := rfl

/-- And a row with no source carries no digest, so an absent source cannot
masquerade as a pinned one. -/
theorem absent_rows_have_no_digest :
    consumedMirrors.all (fun r =>
      match r.status with
      | .present => true
      | .sourceAbsent => r.digest.isEmpty) = true := rfl

/-- **The coverage metric.**  Sixteen consumed pairs; fifteen pinned; one
recorded as absent. -/
theorem drift_coverage :
    consumedMirrors.length = 16 ∧
    (consumedMirrors.filter (fun r => decide (r.status = SourceState.present))).length = 15 ∧
    (consumedMirrors.filter (fun r => decide (r.status = SourceState.sourceAbsent))).length = 1 :=
  ⟨rfl, rfl, rfl⟩

/-- **The absent citation is the declared one.**  The single row with no source
in this cutset is the claim-transport geometry citation, matching
`Integration.ClaimTransportGeometry.cited_source_absent`. -/
theorem absent_source_is_recorded :
    (consumedMirrors.filter (fun r =>
      decide (r.status = SourceState.sourceAbsent))).map (fun r => r.source) =
      ["FormalClaimTransportGeometryExact.agda"] := rfl

/-- Digests are pairwise consistent with their sources: no two distinct sources
in the table share a pinned digest, so a copy-paste error in the table would
show up here. -/
theorem digests_distinct :
    ((consumedMirrors.filter (fun r => decide (r.status = SourceState.present))).map
      (fun r => r.digest)).Nodup := by decide

end Integration.MirrorDrift
