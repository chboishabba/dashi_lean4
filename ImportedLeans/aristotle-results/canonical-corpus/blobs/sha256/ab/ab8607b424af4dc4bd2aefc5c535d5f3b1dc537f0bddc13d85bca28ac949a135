0ₕ∙ : (n : ℕ) {G : AbGroup ℓ} {A : Pointed ℓ'} → coHomRed n G A
0ₕ∙ n = ∣ (λ _ → 0ₖ n) , refl ∣₂

-- operations
module _ {n : ℕ} {G : AbGroup ℓ} {A : Pointed ℓ'} where
  _+ₕ∙_ : coHomRed n G A → coHomRed n G A → coHomRed n G A
  _+ₕ∙_ = ST.rec2 squash₂
