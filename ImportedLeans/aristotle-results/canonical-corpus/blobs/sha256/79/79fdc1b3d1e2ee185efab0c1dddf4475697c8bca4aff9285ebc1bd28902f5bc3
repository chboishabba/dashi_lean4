encodeActualNSProjection :
  NSThetaProjectionState →
  FractranCOL.EV5
encodeActualNSProjection s =
  Vec._∷_
    (dangerShellK s)
    (Vec._∷_
      (diagnosticFluxV3 s)
      (Vec._∷_
        (stretchingProxyV5 s)
        (Vec._∷_
          (tailEnergyLane7 s)
          (Vec._∷_
            (phaseMetadataV11 s)
            Vec.[]))))

encodedLane2TracksDangerShell :
