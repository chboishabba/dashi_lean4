-- pointwise addition (useful for sufficient statistics)
_⊞_ : ∀ {n} → Vec Nat n → Vec Nat n → Vec Nat n
_⊞_ {zero} [] [] = []
_⊞_ {suc n} (x ∷ xs) (y ∷ ys) = add x y ∷ (_⊞_ {n} xs ys)

