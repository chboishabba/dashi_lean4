module DASHI.Physics.YangMills.BalabanYM4MarkedTransverseDecayFromOneStepRGExact where

------------------------------------------------------------------------
-- ROW B, WELD:  THE TRANSVERSE GEOMETRIC DECAY IS NOT AN EXTRA POSTULATE.
--   IT IS THE ITERATE OF THE EXISTING ONE-STEP RG OWNERS.
--
-- WHY THIS MODULE EXISTS.  `BalabanYM4MarkedSourceMarginalTransverseSplitExact`
-- reformulated row B as
--
--     H_d = H_d^marginal + H_d^transverse ,
--     finitely many retained marginal coordinates, no decay demanded of them;
--     geometric decay  |H_d^transverse| <= E_0 r^d  demanded of the transverse
--     (irrelevant) kernel only,
--
-- and `BalabanYM4MarkedSourceSplitToCauchyConsumersExact` showed that the split
-- still feeds every Cauchy consumer.  Both modules take `transverseDecay` as a
-- FIELD of `MarkedSourceSplit`: an assumption.  Creating yet another record
-- that assumes it in a different notation would be bookkeeping.
--
-- The repository already owns the object that is supposed to PRODUCE that
-- decay, in two independent places:
--
--   * `DASHI.Physics.YangMills.BalabanSU2OneStepRGTheorem`, whose
--     `OneStepRGTheorem` carries the source-native relevant(coupling) /
--     irrelevant coordinate split and the one-step recursion
--
--         irrelevant(output) = irrelevantLinearStep(irrelevant(input))
--                              + irrelevantRemainder(coupling, irrelevant) ;
--
--   * `DASHI.Physics.YangMills.BalabanCorrectedSmallPolymerExtractionContractionExact`,
--     whose `CorrectedSmallLargePolymerExtraction` carries the finite
--     small-polymer relevant/marginal extraction and the contraction
--
--         norm(irrelevantRemainder(P)) <= smallContraction * norm(activity(P)).
--
-- This module WELDS the split's transverse channel onto those owners: it proves
-- that the scale-indexed iterate of either owner satisfies exactly the
-- geometric bound the split asks for, and then BUILDS a `MarkedSourceSplit`
-- whose `transverseDecay` field is a derived theorem rather than a hypothesis.
--
-- CONTENT.
--
--   * `affineContractionGeometric` — the analytic core.  If a nonnegative
--     scale family obeys the affine recursion
--
--         e_{j+1} <= rho * e_j + S * sigma^j ,
--
--     with sigma <= r and a head constant A closing the division-free budget
--     inequality  rho*A + S <= r*A , then  e_j <= A r^j  for every j.  This is
--     the exact-rational replacement for "solve the linear recursion and
--     dominate by the larger root": no division, no supremum, no limit.
--
--   * `Weld.transverseGeometricDecay` — for any scale-indexed chain of
--     `OneStepRGTheorem`s whose consecutive endpoints agree (`input_{j+1} =
--     output_j`: this is what makes it ONE trajectory and not a family of
--     unrelated one-step statements), a scalar norm on the irrelevant
--     coordinate with a contractive linear step and a geometrically small
--     remainder gives  |irrelevant_j| <= A r^j .
--
--   * `Weld.weldedSplit`, `Weld.weldedPrefixBound` — the resulting
--     `MarkedSourceSplit` and its uniform prefix bound, i.e. the row B
--     consumer interface, driven by the owner's own constants.
--
--   * `Extraction.smallChainDecay` — the same conclusion from the other owner:
--     iterating the small-polymer extraction along a chain of small polymers
--     gives  norm(activity_j) <= smallContraction^j * norm(activity_0) .
--
--   * `witnessDecay` — a numeric non-vacuity witness for the analytic core.
--
-- WHAT THIS IS NOT.  This does not close row B.  What it does is name exactly
-- what the physical CMP116/CMP119 analysis must still deliver, on the literal
-- differentiated marked source family and uniformly in cutoff, volume and
-- scale: (i) a scalar mark norm, (ii) a contraction factor `rho` for the
-- linearized irrelevant step, and (iii) a remainder bound `S sigma^j` with
-- `sigma <= r`, plus (iv) the identification of the chain with the physical
-- trajectory.  Everything downstream of those four is now machine-checked.
-- No row becomes proved; the frozen research count stays at 4.
--
-- Exact rational arithmetic; no postulate, no hole, no receipt, no pragma.
-- Checked with `agda --safe`.
------------------------------------------------------------------------

open import Agda.Builtin.Nat as Nat using (Nat; zero; suc)
open import Agda.Builtin.Equality using (_≡_; refl)
open import Data.Integer.Base using (+_)
import Data.Nat.Base as ℕ
open import Data.Nat.Base using (z≤n; s≤s)
open import Data.Rational.Base as ℚ using (ℚ; 0ℚ; 1ℚ; ∣_∣; _+_; _*_; _≤_; _/_)
import Data.Rational.Properties as ℚP
open import Relation.Binary.PropositionalEquality using (sym; trans; cong; subst)
open import Relation.Nullary.Decidable using (toWitness)

open import DASHI.Physics.YangMills.YMGeometricPrefixBudgetExact
  using (natToℚ; nonNegProduct; 0≤1ℚ; prefixSum; pow; pow-nonneg)

import DASHI.Physics.YangMills.BalabanYM4MarkedSourceMarginalTransverseSplitExact
