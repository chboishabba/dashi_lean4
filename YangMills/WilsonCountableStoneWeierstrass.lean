import Mathlib

/-!
# Countable Wilson separation pays uniform density

For the cylinder-first continuum route, the strongest Pareto cut is to ask for
one countable family of continuous Wilson/cylinder coordinates whose joint map
is injective.  The unital real algebra generated by that same family then
separates points, so real Stone--Weierstrass makes it uniformly dense.

Thus one physical theorem -- countable continuous point separation -- can feed
both the bounded determining-family construction and the Wilson/cylinder
cyclicity lane.  No independent uniform-density axiom is required on a compact
Hausdorff cylinder state space.
-/

namespace RequestProject.YangMills

/-- The unital real continuous-function algebra generated by a countable Wilson family. -/
def wilsonGeneratedAlgebra
    {Ω : Type*} [TopologicalSpace Ω]
    (wilson : ℕ → C(Ω, ℝ)) : Subalgebra ℝ C(Ω, ℝ) :=
  Algebra.adjoin ℝ (Set.range wilson)

/--
Joint injectivity of the countable Wilson coordinate map implies that its
unital generated algebra separates points.
-/
theorem wilson_generated_algebra_separatesPoints
    {Ω : Type*} [TopologicalSpace Ω]
    (wilson : ℕ → C(Ω, ℝ))
    (hInjective : Function.Injective (fun x i => wilson i x)) :
    (wilsonGeneratedAlgebra wilson).SeparatesPoints := by
  classical
  intro x y hxy
  have hCoordinateMaps :
      (fun i => wilson i x) ≠ (fun i => wilson i y) := by
    intro h
    exact hxy (hInjective h)
  obtain ⟨i, hi⟩ := Function.ne_iff.mp hCoordinateMaps
  refine ⟨wilson i, ?_, hi⟩
  exact Algebra.subset_adjoin ⟨i, rfl⟩

/--
Countable continuous point separation is enough for uniform density of the
Wilson/cylinder algebra on a compact cylinder state space.
-/
theorem wilson_generated_algebra_dense
    {Ω : Type*} [TopologicalSpace Ω] [CompactSpace Ω]
    (wilson : ℕ → C(Ω, ℝ))
    (hInjective : Function.Injective (fun x i => wilson i x)) :
    (wilsonGeneratedAlgebra wilson).topologicalClosure = ⊤ :=
  ContinuousMap.subalgebra_topologicalClosure_eq_top_of_separatesPoints
    (wilsonGeneratedAlgebra wilson)
    (wilson_generated_algebra_separatesPoints wilson hInjective)

/--
Exact merged D/F2 physical producer on the compact cylinder state space:
continuity plus injectivity of one countable Wilson coordinate family.
-/
structure CountableWilsonSeparatingSource
    (Ω : Type*) [TopologicalSpace Ω] where
  wilson : ℕ → C(Ω, ℝ)
  coordinateMapInjective : Function.Injective (fun x i => wilson i x)

namespace CountableWilsonSeparatingSource

/-- Every such source automatically owns a uniformly dense generated algebra. -/
theorem generated_algebra_dense
    {Ω : Type*} [TopologicalSpace Ω] [CompactSpace Ω]
    (source : CountableWilsonSeparatingSource Ω) :
    (wilsonGeneratedAlgebra source.wilson).topologicalClosure = ⊤ :=
  wilson_generated_algebra_dense source.wilson source.coordinateMapInjective

end CountableWilsonSeparatingSource

end RequestProject.YangMills
