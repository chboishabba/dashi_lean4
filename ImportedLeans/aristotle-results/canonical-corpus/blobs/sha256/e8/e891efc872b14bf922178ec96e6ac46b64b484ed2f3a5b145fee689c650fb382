namespace Epistemic.FourView

open Epistemic

/-! ## The matrix -/

/-- The two parties to a disagreement. -/
inductive Party
  | a
  | b
  deriving DecidableEq, Repr, Inhabited

/-- First-order views sit on the diagonal, second-order attributions off it. -/
inductive ViewOrder
  | firstOrder
  | secondOrder
  deriving DecidableEq, Repr, Inhabited

/-- Two parties' own views and their models of each other. -/
structure Matrix (View : Type) where
  /-- What A holds. -/
  aOwn : View
  /-- What B holds. -/
  bOwn : View
  /-- What A takes B to hold. -/
  aModelsB : View
  /-- What B takes A to hold. -/
  bModelsA : View
  deriving DecidableEq, Repr, Inhabited

/-- The entry of the matrix: the view `holder` attributes to `subject`. -/
def viewAt {View : Type} (m : Matrix View) : Party → Party → View
  | Party.a, Party.a => m.aOwn
  | Party.a, Party.b => m.aModelsB
  | Party.b, Party.a => m.bModelsA
  | Party.b, Party.b => m.bOwn

/-- Whether an entry is a first-order view or a second-order attribution. -/
def viewOrder : Party → Party → ViewOrder
  | Party.a, Party.a => ViewOrder.firstOrder
  | Party.b, Party.b => ViewOrder.firstOrder
  | _, _ => ViewOrder.secondOrder

/-- **The diagonal is exactly the first-order part.** -/
theorem viewOrder_eq_first_iff (p q : Party) :
    viewOrder p q = ViewOrder.firstOrder ↔ p = q := by
  cases p <;> cases q <;> simp [viewOrder]

/-! ## The matrix does not embed in the support square -/

/-- Coordinates of a four-view matrix over `Bool`. -/
def matrixEquiv : Matrix Bool ≃ Bool × Bool × Bool × Bool where
  toFun m := (m.aOwn, m.bOwn, m.aModelsB, m.bModelsA)
  invFun p := ⟨p.1, p.2.1, p.2.2.1, p.2.2.2⟩
  left_inv m := by cases m; rfl
  right_inv p := by obtain ⟨_, _, _, _⟩ := p; rfl

instance : Fintype (Matrix Bool) := Fintype.ofEquiv _ matrixEquiv.symm

/-- Coordinates of the support square. -/
def squareEquiv : SupportSquare ≃ Bool × Bool where
  toFun s := (s.forPos, s.against)
  invFun p := ⟨p.1, p.2⟩
  left_inv s := by cases s; rfl
  right_inv p := by obtain ⟨_, _⟩ := p; rfl

instance : Fintype SupportSquare := Fintype.ofEquiv _ squareEquiv.symm

theorem card_matrix_bool : Fintype.card (Matrix Bool) = 16 := by
  rw [Fintype.card_congr matrixEquiv]
  decide

theorem card_supportSquare : Fintype.card SupportSquare = 4 := by
  rw [Fintype.card_congr squareEquiv]
  decide

/-- **The four-view matrix is not a tetralemma.**  Even over the two-element view
type there is no injection of four-view matrices into support squares: the
matrix carries strictly more structure, and any translation into the square
identifies two genuinely different disagreements. -/
theorem fourView_not_supportSquare (f : Matrix Bool → SupportSquare) :
    ¬ Function.Injective f := by
  intro h
  have hle := Fintype.card_le_of_injective f h
  rw [card_matrix_bool, card_supportSquare] at hle
  omega

/-- Concretely: agreement in first-order views with a mistaken model of the other
party is not a corner of any support square, because it is not even a fact about
one proposition's evidence. -/
theorem mutual_misreading_distinct :
    (⟨true, true, false, false⟩ : Matrix Bool) ≠ ⟨true, true, true, true⟩ := by decide

/-! ## Logical appraisal and practical force are independent -/

/-- The inferential appraisal of a speech act. -/
inductive InferentialStatus
  | valid
  | invalid
  | underdetermined
  deriving DecidableEq, Repr, Inhabited

/-- Whether the act remains in force. -/
inductive OperativeStatus
  | inert
  | operative
  deriving DecidableEq, Repr, Inhabited

/-- A speech act carries both coordinates, independently. -/
structure SpeechAct where
  inference : InferentialStatus
  force : OperativeStatus
  deriving DecidableEq, Repr, Inhabited

/-- An invalid argument whose act is still in force: the classic case of winning
the point and losing the outcome. -/
def invalidYetOperative : SpeechAct := ⟨InferentialStatus.invalid, OperativeStatus.operative⟩

/-- A valid argument nobody acts on. -/
def validYetInert : SpeechAct := ⟨InferentialStatus.valid, OperativeStatus.inert⟩

theorem inference_does_not_determine_force :
    ∃ s t : SpeechAct, s.inference = t.inference ∧ s.force ≠ t.force :=
  ⟨⟨InferentialStatus.invalid, OperativeStatus.operative⟩,
    ⟨InferentialStatus.invalid, OperativeStatus.inert⟩, rfl, by decide⟩

theorem force_does_not_determine_inference :
    ∃ s t : SpeechAct, s.force = t.force ∧ s.inference ≠ t.inference :=
  ⟨invalidYetOperative, ⟨InferentialStatus.valid, OperativeStatus.operative⟩, rfl, by decide⟩

/-- **No function computes practical force from inferential status.**  Exposing a
contradiction does not, in itself, make anything inoperative. -/
theorem no_force_from_inference (g : InferentialStatus → OperativeStatus) :
    ¬ ∀ s : SpeechAct, s.force = g s.inference := by
  intro h
  have h1 := h ⟨InferentialStatus.invalid, OperativeStatus.operative⟩
  have h2 := h ⟨InferentialStatus.invalid, OperativeStatus.inert⟩
  simp only at h1 h2
  rw [← h1] at h2
  exact absurd h2 (by decide)

/-- All four combinations of appraisal and force are realised. -/
theorem logic_force_independence :
    ∀ i : InferentialStatus, ∀ o : OperativeStatus, ∃ s : SpeechAct,
      s.inference = i ∧ s.force = o := fun i o => ⟨⟨i, o⟩, rfl, rfl⟩

/-! ## Grounds and commitment discipline -/

/-- What is actually moving the party. -/
inductive GroundKind
  | propositional
  | preference
  | affective
  | authority
  | unarticulated
  deriving DecidableEq, Repr, Inhabited

/-- How the party handles their premises under pressure. -/
inductive CommitmentDiscipline
  | stable
  | revisable
  | evasive
  deriving DecidableEq, Repr, Inhabited

/-- The full state of a disagreement: who thinks what about whom, the polarity
of the evidence on the proposition at issue, the speech act's two coordinates,
what is grounding the position, and how premises are being handled. -/
structure DisagreementState (View : Type) where
  views : Matrix View
  polarity : SupportSquare
  act : SpeechAct
  ground : GroundKind
  discipline : CommitmentDiscipline

/-- **A cause is not an argument.**  No function recovers inferential status from
the kind of ground in play: an authority-grounded and a propositionally grounded
position may be equally valid or equally invalid. -/
theorem no_inference_from_ground (g : GroundKind → InferentialStatus) :
    ¬ ∀ s : DisagreementState Bool, s.act.inference = g s.ground := by
  intro h
  have h1 := h ⟨default, default, ⟨InferentialStatus.valid, default⟩, GroundKind.authority, default⟩
  have h2 := h ⟨default, default, ⟨InferentialStatus.invalid, default⟩, GroundKind.authority, default⟩
  simp only at h1 h2
  rw [← h1] at h2
  exact absurd h2 (by decide)

/-- **Exposure does not compel agreement.**  How a party revises their premises is
not determined by the inferential status of the exchange: evasive revision is
available at every appraisal. -/
theorem no_discipline_from_inference (g : InferentialStatus → CommitmentDiscipline) :
    ¬ ∀ s : DisagreementState Bool, s.discipline = g s.act.inference := by
  intro h
  have h1 := h ⟨default, default, default, default, CommitmentDiscipline.stable⟩
  have h2 := h ⟨default, default, default, default, CommitmentDiscipline.evasive⟩
  simp only at h1 h2
  rw [← h1] at h2
  exact absurd h2 (by decide)

/-- The non-identification boundary in words.  Each clause is discharged by a
theorem above: the first two by `fourView_not_supportSquare` and
`viewOrder_eq_first_iff`, the fourth by `no_force_from_inference`, the fifth by
`no_inference_from_ground`, the last by `no_discipline_from_inference`. -/
def nonIdentificationBoundary : List String :=
  ["The four-view matrix is a 2x2 epistemic object, not a tetralemma",
   "A tetralemma classifies support for one proposition and its negation",
   "Objective events, first-order reports and attributed reports remain distinct",
   "Inferential invalidity does not entail practical ineffectiveness",
   "Causal or motivational structure does not entail propositional consistency",
   "Bad-faith premise revision can be modelled without pretending that exposure compels agreement"]

end Epistemic.FourView
