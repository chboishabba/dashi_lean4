namespace Epistemic

/-! ## Independent support -/

/-- A piece of evidence, tagged with the source episode it came from. -/
structure Evidence (Root Payload : Type) where
  /-- The source episode this item was derived from. -/
  root : Root
  /-- What the item says. -/
  payload : Payload
  deriving DecidableEq, Repr

variable {Root Payload : Type}

/-- Two items are provenance independent when they come from different source
episodes. -/
def ProvenanceIndependent (l r : Evidence Root Payload) : Prop := l.root ≠ r.root

theorem provenanceIndependent_iff_root_ne (l r : Evidence Root Payload) :
    ProvenanceIndependent l r ↔ l.root ≠ r.root := Iff.rfl

/-- **A second item from the same episode is not independent confirmation.** -/
theorem same_root_not_independent {l r : Evidence Root Payload} (h : l.root = r.root) :
    ¬ ProvenanceIndependent l r := fun hind => hind h

/-- The distinct source episodes behind a body of evidence. -/
def independentRoots [DecidableEq Root] (items : List (Evidence Root Payload)) : List Root :=
  (items.map (·.root)).dedup

/-- How many independent confirmations a body of evidence really carries. -/
def independentSupport [DecidableEq Root] (items : List (Evidence Root Payload)) : Nat :=
  (independentRoots items).length

/-- **Independent support never exceeds the number of items.** -/
theorem independentSupport_le_length [DecidableEq Root]
    (items : List (Evidence Root Payload)) : independentSupport items ≤ items.length := by
  have h : (items.map (·.root)).dedup.length ≤ (items.map (·.root)).length :=
    List.Sublist.length_le (List.dedup_sublist _)
  simpa [independentSupport, independentRoots] using h

/-- **Two items from one episode are one confirmation.** -/
theorem independentSupport_shared_root [DecidableEq Root] (r : Root) (p q : Payload) :
    independentSupport [(⟨r, p⟩ : Evidence Root Payload), ⟨r, q⟩] = 1 := by
  simp [independentSupport, independentRoots, List.dedup]

/-- Two items from different episodes are two confirmations. -/
theorem independentSupport_distinct_roots [DecidableEq Root] {r s : Root} (h : r ≠ s)
    (p q : Payload) :
    independentSupport [(⟨r, p⟩ : Evidence Root Payload), ⟨s, q⟩] = 2 := by
  simp [independentSupport, independentRoots, List.dedup, h]

/-! ## The overstatement can decide an action -/

/-- A tally built by counting items, capped at `cap`. -/
def naiveTally [DecidableEq Root] (cap : Nat) (items : List (Evidence Root Payload)) : Tally :=
  ⟨cap, min cap items.length, Nat.min_le_left _ _⟩

/-- A tally built by counting source episodes, capped at `cap`. -/
def independentTally [DecidableEq Root] (cap : Nat) (items : List (Evidence Root Payload)) :
    Tally :=
  ⟨cap, min cap (independentSupport items), Nat.min_le_left _ _⟩

/-- The honest tally is never the larger of the two. -/
theorem independentTally_le_naiveTally [DecidableEq Root] (cap : Nat)
    (items : List (Evidence Root Payload)) :
    (independentTally cap items).count ≤ (naiveTally cap items).count := by
  simp only [independentTally, naiveTally]
  exact min_le_min (le_refl cap) (independentSupport_le_length items)

/-- Two citations to the same import. -/
def duplicatedImport : List (Evidence Nat Nat) := [⟨0, 0⟩, ⟨0, 1⟩]

/-- **Counting citations commits; counting sources does not.**  The difference
between the two tallies is not bookkeeping: at threshold 2 it is the difference
between acting and continuing to look. -/
theorem naive_counting_commits_independent_does_not :
    commit 2 (naiveTally 2 duplicatedImport) = Commitment.committed ∧
      commit 2 (independentTally 2 duplicatedImport) = Commitment.deliberating := by
  refine ⟨by decide, ?_⟩
  have h : independentSupport duplicatedImport = 1 := by decide
  simp [commit, independentTally, h]

/-! ## The same import behind two statements -/

open Wikidata in
/-- Two recorded statements, both derived from source episode `0`: one import,
re-tabulated. -/
def oneImportTwoStatements : List (Evidence Nat Statement) :=
  [⟨0, { subject := ⟨1028181⟩, property := P279, value := ⟨483501⟩, rank := Rank.normal }⟩,
   ⟨0, { subject := ⟨1281618⟩, property := P279, value := ⟨483501⟩, rank := Rank.normal }⟩]

/-- **Two statements, one source.**  The knowledge base has grown by a
statement; the evidence has not grown by a confirmation. -/
theorem oneImportTwoStatements_support :
    oneImportTwoStatements.length = 2 ∧ independentSupport oneImportTwoStatements = 1 := by
  refine ⟨rfl, ?_⟩
  simp [independentSupport, independentRoots, oneImportTwoStatements, List.dedup]

/-! ## Reopening obligations -/

variable {Artifact : Type}

/-- A change at `changed` reopens `derived`: there is a chain of dependencies
from the changed artefact to the derived one. -/
def Reopens (dependsOn : Artifact → Artifact → Prop) (changed derived : Artifact) : Prop :=
  Relation.TransGen dependsOn changed derived

/-- A direct dependent is reopened. -/
theorem reopens_of_dependsOn {dependsOn : Artifact → Artifact → Prop} {a b : Artifact}
    (h : dependsOn a b) : Reopens dependsOn a b := Relation.TransGen.single h

/-- **Reopening is transitive**: an obligation propagates along the whole
dependency chain, not one step. -/
theorem reopens_trans {dependsOn : Artifact → Artifact → Prop} {a b c : Artifact}
    (hab : Reopens dependsOn a b) (hbc : Reopens dependsOn b c) : Reopens dependsOn a c :=
  Relation.TransGen.trans hab hbc

/-- **What a change reopens is exactly the transitive closure of dependence.**
Nothing else is reopened, and nothing in it is spared. -/
theorem reopens_iff_transGen (dependsOn : Artifact → Artifact → Prop) (a b : Artifact) :
    Reopens dependsOn a b ↔ Relation.TransGen dependsOn a b := Iff.rfl

/-- **Independence bounds the obligation.**  If nothing depends on the changed
artefact, the change reopens nothing. -/
theorem not_reopens_of_independent {dependsOn : Artifact → Artifact → Prop} {a : Artifact}
    (h : ∀ b, ¬ dependsOn a b) (b : Artifact) : ¬ Reopens dependsOn a b := by
  intro hr
  induction hr with
  | single hab => exact h _ hab
  | tail _ _ ih => exact ih

end Epistemic
