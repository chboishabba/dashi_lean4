private
  variable
    ℓ ℓ' ℓ'' : Level

module _
  {A : Type ℓ}
  {R : Rel A A ℓ'}
  where

  open BinaryRelation

  isLoset→isStrictOrder : IsLoset R → IsStrictOrder R
  isLoset→isStrictOrder loset = isstrictorder
                          (IsLoset.is-set loset)
                          (IsLoset.is-prop-valued loset)
                          (IsLoset.is-irrefl loset)
