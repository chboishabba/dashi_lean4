  H⁰Red-⋁ : GroupIso (coHomRedGrDir 0 (A ⋁ B , inl (pt A)))
                      (DirProd (coHomRedGrDir 0 A) (coHomRedGrDir 0 B))
  fun (fst H⁰Red-⋁) =
