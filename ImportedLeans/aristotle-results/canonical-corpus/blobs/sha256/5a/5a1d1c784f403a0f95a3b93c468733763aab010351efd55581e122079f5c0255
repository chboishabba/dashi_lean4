jointSupGateReductionLevel : ProofLevel
jointSupGateReductionLevel = machineChecked

exactGateThresholdsLevel : ProofLevel
exactGateThresholdsLevel = machineChecked

-- STILL OPEN (Row A physical leaf).  The literal momentum-space joint
-- Wilson + reduced Faddeev-Popov + Haar density of the CMP109 background-field
-- vacuum polarisation, its Euclidean symmetry (5.6),(5.7), and a value of
-- `epsilon` for it below the gate threshold, uniformly in cutoff, volume and
-- scale.
literalJointDensitySupNormLevel : ProofLevel
literalJointDensitySupNormLevel = conditional
