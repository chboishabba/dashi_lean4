    sec isoλF b = Functor≡ (λ _ → Functor≡ (λ _ → refl)
      λ _ → cong (seq' D _) (congS (flip N-ob _) (F-id b)) ∙ D .⋆IdR _)
      λ _ → makeNatTransPathP _ _
