fst (fst (snd finCWskel⊥)) _ = 0
fst (snd (fst (snd finCWskel⊥))) _ (x , _) = ¬Fin0 x
fst (snd (snd (fst (snd finCWskel⊥)))) ()
snd (snd (snd (fst (snd finCWskel⊥)))) n =
  uninhabEquiv (λ())
    (Iso.inv (PushoutEmptyFam (λ x → ¬Fin0 (fst x)) ¬Fin0))
