{-# OPTIONS --without-K --safe #-}

------------------------------------------------------------------------
-- Invariance of the Haar integral of the 2-torus under the shear
-- (transvection) automorphisms
--
--     (x , y) ↦ (x + y , y)      and      (x , y) ↦ (x , y + x).
--
-- Translation invariance alone only expresses invariance under the group
-- acting on itself.  A Haar integral is additionally invariant under every
-- *automorphism of finite determinant one* of the group; for the torus
-- these are the elements of SL(n,ℤ), and that group is generated by the
-- two shears above.  This is the first genuinely non-translational
-- change-of-variables theorem for the constructed integral, and it is the
-- pattern on which a change of variables for a non-abelian compact group
-- has to be built (item 4 of the "what is still missing" list in
-- `docs/ym/YangMillsClayObstructionReport.md`).
--
-- The first shear needs only the one-dimensional real-translation
-- invariance `integral-realShift`, applied inside the inner integral with
-- the outer variable frozen.  The second shear needs, in addition, the
-- interchange theorem `fubini`, because the shifted variable is the outer
-- one.
--
-- Postulate-free, over the constructed Bishop reals.
------------------------------------------------------------------------

module DASHI.Analysis.BishopTorusShear where

open import Data.Nat as ℕ using (ℕ; zero; suc; s≤s)
import Data.Nat.Properties as ℕP
open import Data.Integer as ℤ using (ℤ; +_)
open import Data.Integer.Solver as ℤSolver
open import Data.Rational.Unnormalised as ℚ using (ℚᵘ)
open import Relation.Binary.PropositionalEquality.Core using (_≡_; refl)

open import Real
open import RealProperties
open import ExtraProperties
open import Sequence
open import DASHI.Analysis.BishopRiemannIntegral
open import DASHI.Analysis.BishopCircleInvariance using (shiftModulus)
open import DASHI.Analysis.BishopIntegralComparison
open import DASHI.Analysis.BishopCircleHaar using (integral-realShift)
open import DASHI.Analysis.BishopFubini

private
  dbl : ℕ → ℕ
  dbl j = ℕ.pred (2 ℕ.* suc j)

  halves₂ : ∀ j →
    (+ 1 ℚ./ (2 ℕ.* suc j)) ⋆ + (+ 1 ℚ./ (2 ℕ.* suc j)) ⋆ ≤ (+ 1 ℚ./ suc j) ⋆
  halves₂ j = ≤-reflexive (≃-trans
    (≃-symm (⋆-distrib-+ (+ 1 ℚ./ (2 ℕ.* suc j)) (+ 1 ℚ./ (2 ℕ.* suc j))))
    (⋆-cong (ℚ.*≡* (solve 1 (λ z →
      (con (+ 1) :* (con (+ 2) :* z) :+ con (+ 1) :* (con (+ 2) :* z)) :* z
        := con (+ 1) :* (con (+ 2) :* z :* (con (+ 2) :* z)))
      refl (+ suc j)))))
    where open ℤSolver.+-*-Solver

  -- half a cell is at most a whole cell
  half≤whole : ∀ j → (+ 1 ℚ./ (2 ℕ.* suc j)) ⋆ ≤ (+ 1 ℚ./ suc j) ⋆
  half≤whole j = p≤q⇒p⋆≤q⋆ _ _
    (q≤r⇒+p/r≤+p/q 1 (suc j) (2 ℕ.* suc j)
      (ℕP.m≤m+n (suc j) (suc j ℕ.+ 0)))

------------------------------------------------------------------------
-- Moduli of continuity for the two sheared functions.

shearModulus₁ : ∀ (f : ℝ → ℝ → ℝ) → UniformModulus₂ f →
  UniformModulus₂ (λ x y → f (x + y) y)
shearModulus₁ f mf = record { δ = λ j → dbl (δ j) ; δ-cont = cont }
  where
  open UniformModulus₂ mf

  cont : ∀ (j : ℕ) (x₁ y₁ x₂ y₂ : ℝ) →
    ∣ x₁ - x₂ ∣ ≤ (+ 1 ℚ./ suc (dbl (δ j))) ⋆ →
    ∣ y₁ - y₂ ∣ ≤ (+ 1 ℚ./ suc (dbl (δ j))) ⋆ →
    ∣ f (x₁ + y₁) y₁ - f (x₂ + y₂) y₂ ∣ ≤ (+ 1 ℚ./ suc j) ⋆
  cont j x₁ y₁ x₂ y₂ hx hy = δ-cont j (x₁ + y₁) y₁ (x₂ + y₂) y₂ sumClose
                                      (≤-trans hy (half≤whole (δ j)))
    where
    open ℝ-Solver

    regroup : (x₁ + y₁) - (x₂ + y₂) ≃ (x₁ - x₂) + (y₁ - y₂)
    regroup = ℝ-Solver.solve 4
      (λ a b c d → (a ⊕ c) ⊖ (b ⊕ d) ⊜ (a ⊖ b) ⊕ (c ⊖ d))
      ≃-refl x₁ x₂ y₁ y₂

    sumClose : ∣ (x₁ + y₁) - (x₂ + y₂) ∣ ≤ (+ 1 ℚ./ suc (δ j)) ⋆
    sumClose = ≤-trans (≤-reflexive (∣-∣-cong regroup))
      (≤-trans (∣x+y∣≤∣x∣+∣y∣ (x₁ - x₂) (y₁ - y₂))
      (≤-trans (+-mono-≤ hx hy) (halves₂ (δ j))))

shearModulus₂ : ∀ (f : ℝ → ℝ → ℝ) → UniformModulus₂ f →
  UniformModulus₂ (λ x y → f x (y + x))
shearModulus₂ f mf = record { δ = λ j → dbl (δ j) ; δ-cont = cont }
  where
  open UniformModulus₂ mf

  cont : ∀ (j : ℕ) (x₁ y₁ x₂ y₂ : ℝ) →
    ∣ x₁ - x₂ ∣ ≤ (+ 1 ℚ./ suc (dbl (δ j))) ⋆ →
    ∣ y₁ - y₂ ∣ ≤ (+ 1 ℚ./ suc (dbl (δ j))) ⋆ →
    ∣ f x₁ (y₁ + x₁) - f x₂ (y₂ + x₂) ∣ ≤ (+ 1 ℚ./ suc j) ⋆
  cont j x₁ y₁ x₂ y₂ hx hy = δ-cont j x₁ (y₁ + x₁) x₂ (y₂ + x₂)
                                      (≤-trans hx (half≤whole (δ j))) sumClose
    where
    open ℝ-Solver

    regroup : (y₁ + x₁) - (y₂ + x₂) ≃ (y₁ - y₂) + (x₁ - x₂)
    regroup = ℝ-Solver.solve 4
      (λ a b c d → (c ⊕ a) ⊖ (d ⊕ b) ⊜ (c ⊖ d) ⊕ (a ⊖ b))
      ≃-refl x₁ x₂ y₁ y₂

    sumClose : ∣ (y₁ + x₁) - (y₂ + x₂) ∣ ≤ (+ 1 ℚ./ suc (δ j)) ⋆
    sumClose = ≤-trans (≤-reflexive (∣-∣-cong regroup))
      (≤-trans (∣x+y∣≤∣x∣+∣y∣ (y₁ - y₂) (x₁ - x₂))
      (≤-trans (+-mono-≤ hy hx) (halves₂ (δ j))))

------------------------------------------------------------------------
-- The first shear: the inner (x) variable is translated by the frozen
-- outer variable, so one-dimensional translation invariance suffices.

module _ (f : ℝ → ℝ → ℝ) (mf : UniformModulus₂ f)
         (perX : ∀ x y → f (x + 1ℝ) y ≃ f x y) where

  private
    g : ℝ → ℝ → ℝ
    g x y = f (x + y) y

    mg : UniformModulus₂ g
    mg = shearModulus₁ f mf

    rowShift : ∀ y → rowIntegral g mg y ≃ rowIntegral f mf y
    rowShift y = ≃-trans reMod (integral-realShift (λ x → f x y) (rowMod f mf y)
                                                   (λ x → perX x y) y)
      where
      reMod : integral (λ x → f (x + y) y) (rowMod g mg y)
                ≃ integral (λ x → f (x + y) y)
                    (shiftModulus (λ x → f x y) (rowMod f mf y) y)
      reMod = integral-cong (λ x → f (x + y) y) (λ x → f (x + y) y)
        (rowMod g mg y) (shiftModulus (λ x → f x y) (rowMod f mf y) y)
        (λ x → ≃-refl)

  shear₁-invariant : iteratedXY g mg ≃ iteratedXY f mf
  shear₁-invariant = integral-cong
    (rowIntegral g mg) (rowIntegral f mf)
    (rowIntMod g mg) (rowIntMod f mf) rowShift

------------------------------------------------------------------------
-- The second shear: now the *outer* variable is the one being used as a
-- translation, so the order of integration has to be exchanged first.

module _ (f : ℝ → ℝ → ℝ) (mf : UniformModulus₂ f)
         (perY : ∀ x y → f x (y + 1ℝ) ≃ f x y) where

  private
    h : ℝ → ℝ → ℝ
    h x y = f x (y + x)

    mh : UniformModulus₂ h
    mh = shearModulus₂ f mf

    colShift : ∀ x → colIntegral h mh x ≃ colIntegral f mf x
    colShift x = ≃-trans reMod (integral-realShift (λ y → f x y) (colMod f mf x)
                                                   (λ y → perY x y) x)
      where
      reMod : integral (λ y → f x (y + x)) (colMod h mh x)
                ≃ integral (λ y → f x (y + x))
                    (shiftModulus (λ y → f x y) (colMod f mf x) x)
      reMod = integral-cong (λ y → f x (y + x)) (λ y → f x (y + x))
        (colMod h mh x) (shiftModulus (λ y → f x y) (colMod f mf x) x)
        (λ y → ≃-refl)

    colInvariant : iteratedYX h mh ≃ iteratedYX f mf
    colInvariant = integral-cong
      (colIntegral h mh) (colIntegral f mf)
      (colIntMod h mh) (colIntMod f mf) colShift

  shear₂-invariant : iteratedXY h mh ≃ iteratedXY f mf
  shear₂-invariant = ≃-trans (fubini h mh)
                     (≃-trans colInvariant (≃-symm (fubini f mf)))
