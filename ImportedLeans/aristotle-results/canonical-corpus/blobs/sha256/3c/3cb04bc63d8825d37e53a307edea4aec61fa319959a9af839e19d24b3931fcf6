namespace Wikidata.Attribution

open Epistemic Wikidata.Fibres

/-! ## The four layers -/

/-- The four places a cross-ontology problem can originate. -/
inductive Layer
  | sourceOntology
  | transcription
  | alignment
  | targetGraph
  deriving DecidableEq, Repr, Inhabited

/-- All four layers, for quantifying over them by `decide`. -/
def allLayers : List Layer :=
  [Layer.sourceOntology, Layer.transcription, Layer.alignment, Layer.targetGraph]

@[simp] theorem mem_allLayers (l : Layer) : l ∈ allLayers := by
  cases l <;> simp [allLayers]

/-- A human-readable name for a layer. -/
def layerLabel : Layer → String
  | Layer.sourceOntology => "source ontology"
  | Layer.transcription => "source-to-concrete transcription"
  | Layer.alignment => "cross-ontology alignment"
  | Layer.targetGraph => "target graph"

/-- The ontology axis a layer's derivations travel through. -/
def layerAxis : Layer → OntologyAxis
  | Layer.sourceOntology => OntologyAxis.external "source-ontology"
  | Layer.transcription => OntologyAxis.external "transcription"
  | Layer.alignment => OntologyAxis.external "alignment"
  | Layer.targetGraph => OntologyAxis.external "target-graph"

/-- Distinct layers select distinct subfibres. -/
theorem layerAxis_injective {l m : Layer} (h : layerAxis l = layerAxis m) : l = m := by
  cases l <;> cases m <;> simp_all [layerAxis]

/-! ## Layer-indexed evidence -/

/-- The polarity a layer contributes, read as a corner of the support square. -/
def squareOfPolarity : Polarity → SupportSquare
  | Polarity.supporting => ⟨true, false⟩
  | Polarity.contradicting => ⟨false, true⟩
  | Polarity.unresolved => ⟨false, false⟩

@[simp] theorem classify_squareOfPolarity_supporting :
    classify (squareOfPolarity Polarity.supporting) = Corner.positionOnly := rfl

@[simp] theorem classify_squareOfPolarity_contradicting :
    classify (squareOfPolarity Polarity.contradicting) = Corner.counterOnly := rfl

/-- **A missing derivation is not a refutation**: an unresolved layer sits in the
`neitherEstablished` corner. -/
@[simp] theorem classify_squareOfPolarity_unresolved :
    classify (squareOfPolarity Polarity.unresolved) = Corner.neitherEstablished := rfl

/-- The evidence attributed to each of the four layers for one claim. -/
structure Attributed where
  claim : ClaimBase
  source : Polarity
  transcription : Polarity
  alignment : Polarity
  target : Polarity
  deriving DecidableEq, Repr, Inhabited

namespace Attributed

/-- The polarity contributed by a given layer. -/
def polarityOf (a : Attributed) : Layer → Polarity
  | Layer.sourceOntology => a.source
  | Layer.transcription => a.transcription
  | Layer.alignment => a.alignment
  | Layer.targetGraph => a.target

/-- The support square of a single layer. -/
def layerSquare (a : Attributed) (l : Layer) : SupportSquare :=
  squareOfPolarity (a.polarityOf l)

/-- The derivation a layer contributes, tagged with the layer's own axis, so
that the layer-local evidence is a genuine subfibre of the claim's fibre. -/
def layerDerivation (a : Attributed) (l : Layer) : Derivation :=
  { derivationId := layerLabel l
    polarity := a.polarityOf l
    axes := [layerAxis l]
    evidence := layerLabel l
    provenance := a.claim.claimId
    obligations := [] }

/-- The whole fibre: one derivation per layer. -/
def fibre (a : Attributed) : Fibre := allLayers.map a.layerDerivation

/-- Each layer's subfibre of the attributed fibre is exactly that layer's own
derivation: the four layers do not contaminate each other. -/
theorem subfibre_layerAxis (a : Attributed) (l : Layer) :
    subfibre (layerAxis l) a.fibre = [a.layerDerivation l] := by
  cases l <;>
    simp [Attributed.fibre, allLayers, subfibre, Attributed.layerDerivation, layerAxis,
      List.filter]

/-- Pooling the four layers. -/
def pooled (a : Attributed) : SupportSquare :=
  SupportSquare.merge (a.layerSquare Layer.sourceOntology)
    (SupportSquare.merge (a.layerSquare Layer.transcription)
      (SupportSquare.merge (a.layerSquare Layer.alignment)
        (a.layerSquare Layer.targetGraph)))

/-- The three-valued reading of the pooled square. -/
def pooledTrit (a : Attributed) : Trit := collapse (classify a.pooled)

/-- The layer being blamed: the first layer, in the canonical order, carrying a
refuting derivation. -/
def blamed (a : Attributed) : Option Layer :=
  allLayers.find? (fun l => decide (a.polarityOf l = Polarity.contradicting))

end Attributed

open Attributed

/-! ## What pooling preserves, and what it destroys -/

/-- The pooled square's positive coordinate, spelled out. -/
theorem pooled_forPos_eq (a : Attributed) :
    a.pooled.forPos =
      (decide (a.source = Polarity.supporting) ||
        decide (a.transcription = Polarity.supporting) ||
        decide (a.alignment = Polarity.supporting) ||
        decide (a.target = Polarity.supporting)) := by
  obtain ⟨_, s, t, al, tg⟩ := a
  cases s <;> cases t <;> cases al <;> cases tg <;> rfl

/-- The pooled square's negative coordinate, spelled out. -/
theorem pooled_against_eq (a : Attributed) :
    a.pooled.against =
      (decide (a.source = Polarity.contradicting) ||
        decide (a.transcription = Polarity.contradicting) ||
        decide (a.alignment = Polarity.contradicting) ||
        decide (a.target = Polarity.contradicting)) := by
  obtain ⟨_, s, t, al, tg⟩ := a
  cases s <;> cases t <;> cases al <;> cases tg <;> rfl

/-- The pooled square records that *some* layer supports. -/
theorem pooled_forPos_iff (a : Attributed) :
    a.pooled.forPos = true ↔ ∃ l, a.polarityOf l = Polarity.supporting := by
  rw [pooled_forPos_eq]
  constructor
  · intro h
    by_cases h1 : a.source = Polarity.supporting
    · exact ⟨Layer.sourceOntology, h1⟩
    by_cases h2 : a.transcription = Polarity.supporting
    · exact ⟨Layer.transcription, h2⟩
    by_cases h3 : a.alignment = Polarity.supporting
    · exact ⟨Layer.alignment, h3⟩
    refine ⟨Layer.targetGraph, ?_⟩
    simpa [h1, h2, h3] using h
  · rintro ⟨l, hl⟩
    revert hl
    cases l <;> intro hl <;> simp only [Attributed.polarityOf] at hl <;> simp [hl]

/-- The pooled square records that *some* layer refutes — and nothing more. -/
theorem pooled_against_iff (a : Attributed) :
    a.pooled.against = true ↔ ∃ l, a.polarityOf l = Polarity.contradicting := by
  rw [pooled_against_eq]
  constructor
  · intro h
    by_cases h1 : a.source = Polarity.contradicting
    · exact ⟨Layer.sourceOntology, h1⟩
    by_cases h2 : a.transcription = Polarity.contradicting
    · exact ⟨Layer.transcription, h2⟩
    by_cases h3 : a.alignment = Polarity.contradicting
    · exact ⟨Layer.alignment, h3⟩
    refine ⟨Layer.targetGraph, ?_⟩
    simpa [h1, h2, h3] using h
  · rintro ⟨l, hl⟩
    revert hl
    cases l <;> intro hl <;> simp only [Attributed.polarityOf] at hl <;> simp [hl]

/-- **An obligation is not a refutation.**  If no layer carries a contradicting
derivation then the pooled square has no counter-evidence, however much is
merely unresolved. -/
theorem pooled_against_eq_false_of_no_refutation (a : Attributed)
    (h : ∀ l, a.polarityOf l ≠ Polarity.contradicting) : a.pooled.against = false := by
  by_contra hc
  obtain ⟨l, hl⟩ := (pooled_against_iff a).1 (by simpa using hc)
  exact h l hl

/-- The layer vector determines the pooled square. -/
theorem pooled_eq_of_layers_eq {a b : Attributed}
    (h : ∀ l, a.polarityOf l = b.polarityOf l) : a.pooled = b.pooled := by
  simp [Attributed.pooled, Attributed.layerSquare, h Layer.sourceOntology,
    h Layer.transcription, h Layer.alignment, h Layer.targetGraph]

/-- Pooling does not depend on the order the layers are consulted in. -/
theorem pooled_perm_invariant (a : Attributed) :
    a.pooled =
      SupportSquare.merge (a.layerSquare Layer.targetGraph)
        (SupportSquare.merge (a.layerSquare Layer.alignment)
          (SupportSquare.merge (a.layerSquare Layer.transcription)
            (a.layerSquare Layer.sourceOntology))) := by
  obtain ⟨_, s, t, al, tg⟩ := a
  cases s <;> cases t <;> cases al <;> cases tg <;> rfl

/-! ### Blame is not a function of the pooled square -/

/-- A conflict blamed on the alignment layer. -/
def blameAlignment : Attributed :=
  { claim :=
      { claimId := "fixture:blame-alignment"
        surface := "the mapped structural relation is preserved"
        kind := ClaimKind.external "cross-ontology alignment"
        role := StatementRole.candidateLink
        graphSnapshot := "fixture:v1" }
    source := Polarity.supporting
    transcription := Polarity.supporting
    alignment := Polarity.contradicting
    target := Polarity.supporting }

/-- The same pooled evidence, blamed on the source ontology instead. -/
def blameSource : Attributed :=
  { blameAlignment with
    source := Polarity.contradicting
    alignment := Polarity.supporting }

/-- **Blame is not recoverable from the pooled square.**  Two attributions of the
same claim have identical pooled squares — and hence identical corners and
identical three-valued readings — while blaming different layers. -/
theorem blame_not_recoverable_from_pooled :
    blameAlignment.pooled = blameSource.pooled ∧
      classify blameAlignment.pooled = classify blameSource.pooled ∧
      blameAlignment.pooledTrit = blameSource.pooledTrit ∧
      blameAlignment.blamed ≠ blameSource.blamed := by
  refine ⟨rfl, rfl, rfl, ?_⟩
  decide

/-! ## Fixture: alignment-local stress -/

/-- Source, transcription and target support the scoped relation; the declared
alignment refutes it. -/
def alignmentLocalStress : Attributed := blameAlignment

theorem alignmentLocalStress_layers :
    classify (alignmentLocalStress.layerSquare Layer.sourceOntology) = Corner.positionOnly ∧
      classify (alignmentLocalStress.layerSquare Layer.transcription) = Corner.positionOnly ∧
      classify (alignmentLocalStress.layerSquare Layer.alignment) = Corner.counterOnly ∧
      classify (alignmentLocalStress.layerSquare Layer.targetGraph) = Corner.positionOnly :=
  ⟨rfl, rfl, rfl, rfl⟩

/-- Pooling lands on the conflict corner: the disagreement is not silently
resolved in favour of the three supporting layers. -/
theorem alignmentLocalStress_pools_to_conflict :
    classify alignmentLocalStress.pooled = Corner.bothSupported := rfl

/-- …and the three-valued reading of that conflict is `unresolved`, which is the
same value a total absence of evidence would produce.  The layer vector, not the
trit, is what carries the diagnosis. -/
theorem alignmentLocalStress_trit_is_lossy :
    alignmentLocalStress.pooledTrit = Trit.unresolved ∧
      alignmentLocalStress.blamed = some Layer.alignment := ⟨rfl, rfl⟩

/-! ## Fixture: BFO continuant/occurrent against Wikidata -/

/-- The pinned identifiers of the BFO 2020 → Wikidata mapping surface this
fixture is about. -/
structure PinnedCase where
  sourceCommit : String
  sourceEntityId : String
  sourceContinuantId : String
  sourceOccurrentId : String
  targetEntityQid : String
  targetContinuantQid : String
  targetOccurrentQid : String
  targetIdentifierProperty : String
  projectRevision : String
  deriving DecidableEq, Repr, Inhabited

/-- BFO 2020 states `continuant ⊑ entity` and `continuant` disjoint from
`occurrent`; Wikidata carries the three classes with P12602 identifiers. -/
def bfoContinuantOccurrentCase : PinnedCase :=
  { sourceCommit := "0900316ea9d330f599bd110f7f6504ed33a87fc8"
    sourceEntityId := "BFO_0000001"
    sourceContinuantId := "BFO_0000002"
    sourceOccurrentId := "BFO_0000003"
    targetEntityQid := "Q35120"
    targetContinuantQid := "Q103940464"
    targetOccurrentQid := "Q67518978"
    targetIdentifierProperty := "P12602"
    projectRevision := "Wikidata:WikiProject_Ontology/Mapping_Wikidata_To_BFO oldid=2412374796" }

/-- The claim under attribution: that BFO's continuant/occurrent disjointness may
be transported through the declared Wikidata alignment. -/
def bfoDisjointnessTransportClaim : ClaimBase :=
  { claimId := "bfo-wikidata:continuant-occurrent-disjointness"
    surface :=
      "BFO continuant/occurrent disjointness is licensed for transport through " ++
        "the declared Wikidata alignment"
    kind := ClaimKind.external "BFO-Wikidata alignment"
    role := StatementRole.candidateLink
    graphSnapshot := "bfo:0900316e|wikidata:bfo-mapping:2412374796" }

/-- Source and transcription are supported; alignment and target graph are open
obligations, not counter-evidence. -/
def bfoAttribution : Attributed :=
  { claim := bfoDisjointnessTransportClaim
    source := Polarity.supporting
    transcription := Polarity.supporting
    alignment := Polarity.unresolved
    target := Polarity.unresolved }

theorem bfo_source_and_transcription_supported :
    classify (bfoAttribution.layerSquare Layer.sourceOntology) = Corner.positionOnly ∧
      classify (bfoAttribution.layerSquare Layer.transcription) = Corner.positionOnly :=
  ⟨rfl, rfl⟩

/-- The alignment and target layers sit in the `neitherEstablished` corner: no
instance-transport witness has been supplied, and the target-side disjointness
constraint is still a project work item. -/
theorem bfo_alignment_and_target_unresolved :
    classify (bfoAttribution.layerSquare Layer.alignment) = Corner.neitherEstablished ∧
      classify (bfoAttribution.layerSquare Layer.targetGraph) = Corner.neitherEstablished :=
  ⟨rfl, rfl⟩

/-- **The certificate is not "Wikidata contradicts BFO".**  No layer of the case
carries a refuting derivation, so the pooled square records no counter-evidence
at all. -/
theorem bfo_no_layer_refutes :
    (∀ l, bfoAttribution.polarityOf l ≠ Polarity.contradicting) ∧
      bfoAttribution.pooled.against = false ∧ bfoAttribution.blamed = none := by
  refine ⟨fun l => ?_, ?_, rfl⟩
  · cases l <;> decide
  · exact pooled_against_eq_false_of_no_refutation _ (fun l => by cases l <;> decide)

/-- What the case *does* establish is a required subfibre with nothing in it:
the transport obligation is undetermined, which is the fifth-pass reading of
`Wikidata.Fibres.missing_subfibre_is_undetermined`. -/
theorem bfo_transport_obligation_undetermined :
    validate AxisRequirement.required (layerAxis Layer.alignment) bfoAttribution.fibre =
      ValidationOutcome.fibreShape FibreOutcome.undetermined := by
  decide +kernel

end Wikidata.Attribution
