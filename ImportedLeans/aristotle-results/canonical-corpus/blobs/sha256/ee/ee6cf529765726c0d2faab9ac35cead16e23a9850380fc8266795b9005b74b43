-- specialised lemmas
private
  -- elim rule for ℕ to help convince termination checker
  ⌣-ℕ-elim2 : {A : ℕ → ℕ → Type ℓ}
    → ((n : ℕ) → A zero n)
    → ((n : ℕ) → A (suc n) zero)
    → ((n m : ℕ) → A (suc n) m × A n (suc m) × A n m → A (suc n) (suc m))
    → (n m : ℕ) → A n m
  ⌣-ℕ-elim2 l r ind zero m = l m
