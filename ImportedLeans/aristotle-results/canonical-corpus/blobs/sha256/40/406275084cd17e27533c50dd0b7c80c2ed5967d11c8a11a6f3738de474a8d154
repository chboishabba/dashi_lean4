/-! ## 1. The general-window Riemann–von Mangoldt count -/

set_option maxHeartbeats 1000000 in
/-- **A translated window count for the ζ zeros, with the true density.**  For every
window `(a,b]` above an explicit height, the zero count agrees with `∫_a^b μ` up to
`O(log b)`.  This is the arbitrary-window form of the Riemann–von Mangoldt theorem, built
directly from the checked contour machinery of `Zeta23`. -/
theorem zeta_window_count_data :
    ∃ C T₀ : ℝ, 0 ≤ C ∧ 4 ≤ T₀ ∧ ∀ a b : ℝ, T₀ ≤ a → a ≤ b →
      |((zetaZeroConfig).N a b : ℝ) - ∫ τ in a..b, Zeta23.mu τ| ≤ C * Real.log b := by
  classical
  obtain ⟨CB, TB, hB⟩ := Zeta23.RvM.backlund_horizontal
  obtain ⟨A₀, hA₀1, hA₀⟩ := Zeta23.RvM.zeta_local_zero_count
  obtain ⟨CM, hCM0, hCM⟩ := Zeta23.RvM.mu_le_log Zeta23.gammaFacts
  have hμc : Continuous Zeta23.mu := Zeta23.RvM.mu_continuous Zeta23.gammaFacts
  have hA₀0 : (0 : ℝ) ≤ A₀ := by linarith
  have hCB0 : (0 : ℝ) ≤ |CB| := abs_nonneg CB
  have hπ0 : (0 : ℝ) < π := Real.pi_pos
  have hπ3 : (3 : ℝ) < π := Real.pi_gt_three
  refine ⟨20 * A₀ + 20 * CM + 8 * |CB| + 8, max (TB + 1) 4, by linarith, le_max_right _ _, ?_⟩
  intro a b ha hab
  have hTB : TB + 1 ≤ a := le_trans (le_max_left _ _) ha
  have h4a : (4 : ℝ) ≤ a := le_trans (le_max_right _ _) ha
  have h4b : (4 : ℝ) ≤ b := le_trans h4a hab
  have hlogb1 : (1 : ℝ) ≤ Real.log b := by
    have h : Real.log (Real.exp 1) ≤ Real.log b :=
      Real.log_le_log (Real.exp_pos 1) (by linarith [Real.exp_one_lt_d9])
    rwa [Real.log_exp] at h
  have hlogb0 : (0 : ℝ) ≤ Real.log b := by linarith
  -- `log (b+6) ≤ 2 log b`
  have hlogb6 : Real.log (b + 6) ≤ 2 * Real.log b := by
    have hsq : b + 6 ≤ b ^ 2 := by nlinarith
    have h : Real.log (b + 6) ≤ Real.log (b ^ 2) := Real.log_le_log (by linarith) hsq
    rwa [Real.log_pow, Nat.cast_ofNat] at h
  -- good heights straddling the window
  obtain ⟨a', ha'mem, hga'⟩ := Zeta23.RvM.exists_goodHeight a
  obtain ⟨b', hb'mem, hgb'⟩ := Zeta23.RvM.exists_goodHeight (b + 2)
  have ha'1 : a ≤ a' := ha'mem.1
  have ha'2 : a' ≤ a + 1 := ha'mem.2
  have hb'1 : b + 2 ≤ b' := hb'mem.1
  have hb'2 : b' ≤ b + 3 := by have h := hb'mem.2; linarith
  have h1a' : (1 : ℝ) ≤ a' := by linarith
  have hab' : a' < b' := by linarith
  -- the contour identity, with the Γ-side evaluated exactly
  have hN := Zeta23.RvM.N_eq_halfContour_completedZeta h1a' hab' hga' hgb'
  have hsplit := Zeta23.RvM.halfContour_completedZeta_split h1a' hab' hga' hgb'
  have hgam := Zeta23.RvM.gamma_side (T₁ := a') (T₂ := b') (by linarith) (by linarith)
  have hkey : (Zeta23.Ncount a' b' : ℝ) - (∫ τ in a'..b', Zeta23.mu τ)
      = (1 / π) * (Zeta23.RvM.halfContour (logDeriv riemannZeta) a' b').im := by
    rw [hN, hsplit, Complex.add_im]
    linarith [hgam]
  -- the ζ half-contour is `O(log)`
  have hζbound : |(Zeta23.RvM.halfContour (logDeriv riemannZeta) a' b').im|
      ≤ |CB| * Real.log a' + π + |CB| * Real.log b' := by
    have hbk1 := hB a' (by linarith) hga'
    have hbk2 := hB b' (by linarith) hgb'
    have hvert := Zeta23.RvM.vertical_two a' b'
    have hlog₁0 : 0 ≤ Real.log a' := Real.log_nonneg h1a'
    have hlog₂0 : 0 ≤ Real.log b' := Real.log_nonneg (by linarith)
    unfold Zeta23.RvM.halfContour
    have eim : ((∫ σ in (1/2:ℝ)..2, logDeriv riemannZeta (σ + a' * I))
        + (∫ t in a'..b', logDeriv riemannZeta (2 + t * I)) * I
        - ∫ σ in (1/2:ℝ)..2, logDeriv riemannZeta (σ + b' * I)).im
        = (∫ σ in (1/2:ℝ)..2, logDeriv riemannZeta (σ + a' * I)).im
          + ((∫ t in a'..b', logDeriv riemannZeta (2 + t * I)) * I).im
          - (∫ σ in (1/2:ℝ)..2, logDeriv riemannZeta (σ + b' * I)).im := by
      simp [Complex.add_im, Complex.sub_im]
    rw [eim]
    have hmulI : ((∫ t in a'..b', logDeriv riemannZeta (2 + t * I)) * I).im
        = (∫ t in a'..b', logDeriv riemannZeta (2 + t * I) * I).im :=
      congrArg Complex.im (intervalIntegral.integral_mul_const (μ := MeasureTheory.volume) I
        (fun t : ℝ => logDeriv riemannZeta (2 + t * I))).symm
    have h1 : |(∫ σ in (1/2:ℝ)..2, logDeriv riemannZeta (σ + a' * I)).im| ≤ |CB| * Real.log a' :=
      hbk1.trans (mul_le_mul_of_nonneg_right (le_abs_self CB) hlog₁0)
    have h2 : |(∫ σ in (1/2:ℝ)..2, logDeriv riemannZeta (σ + b' * I)).im| ≤ |CB| * Real.log b' :=
      hbk2.trans (mul_le_mul_of_nonneg_right (le_abs_self CB) hlog₂0)
    calc |(∫ σ in (1/2:ℝ)..2, logDeriv riemannZeta (σ + a' * I)).im
          + ((∫ t in a'..b', logDeriv riemannZeta (2 + t * I)) * I).im
          - (∫ σ in (1/2:ℝ)..2, logDeriv riemannZeta (σ + b' * I)).im|
        ≤ |(∫ σ in (1/2:ℝ)..2, logDeriv riemannZeta (σ + a' * I)).im|
          + |((∫ t in a'..b', logDeriv riemannZeta (2 + t * I)) * I).im|
          + |(∫ σ in (1/2:ℝ)..2, logDeriv riemannZeta (σ + b' * I)).im| :=
          (abs_sub _ _).trans (add_le_add (abs_add_le _ _) le_rfl)
      _ ≤ |CB| * Real.log a' + π + |CB| * Real.log b' := by
          rw [hmulI]
          linarith [hvert]
  -- short windows of length at most three
  have hNshort : ∀ x y : ℝ, 1 ≤ x → x ≤ y → y ≤ x + 3 →
      (Zeta23.Ncount x y : ℝ) ≤ 3 * (A₀ * Real.log (x + 6)) := by
    intro x y hx hxy hy
    have hmono : Zeta23.Ncount x y ≤ Zeta23.Ncount x (x + 3) := Zeta23.Ncount_mono le_rfl hy
    have e1 : Zeta23.Ncount x (x + 3)
        = Zeta23.Ncount x (x + 1) + Zeta23.Ncount (x + 1) (x + 2)
          + Zeta23.Ncount (x + 2) (x + 3) := by
      have h1 := Zeta23.Ncount_add (a := x) (b := x + 1) (c := x + 3)
        (by linarith) (by linarith)
      have h2 := Zeta23.Ncount_add (a := x + 1) (b := x + 2) (c := x + 3)
        (by linarith) (by linarith)
      rw [h1, h2]
      ring
    have hunit : ∀ k : ℝ, 0 ≤ k → k ≤ 2 →
        (Zeta23.Ncount (x + k) (x + k + 1) : ℝ) ≤ A₀ * Real.log (x + 6) := by
      intro k hk0 hk2
      have hb := hA₀ (x + k)
      have habs : |x + k| = x + k := abs_of_pos (by linarith)
      have hlog : Real.log (|x + k| + 3) ≤ Real.log (x + 6) := by
        rw [habs]
        exact Real.log_le_log (by linarith) (by linarith)
      calc (Zeta23.Ncount (x + k) (x + k + 1) : ℝ)
          ≤ A₀ * Real.log (|x + k| + 3) := hb
        _ ≤ A₀ * Real.log (x + 6) := mul_le_mul_of_nonneg_left hlog hA₀0
    have u0 := hunit 0 le_rfl (by norm_num)
    simp only [add_zero] at u0
    have u1 := hunit 1 (by norm_num) (by norm_num)
    have u2 := hunit 2 (by norm_num) le_rfl
    have e1' : x + (1 : ℝ) + 1 = x + 2 := by ring
    have e2' : x + (2 : ℝ) + 1 = x + 3 := by ring
    rw [e1'] at u1
    rw [e2'] at u2
    have hcast : (Zeta23.Ncount x y : ℝ) ≤ (Zeta23.Ncount x (x + 3) : ℝ) := by
      exact_mod_cast hmono
    have hsum : ((Zeta23.Ncount x (x + 3) : ℕ) : ℝ)
        = (Zeta23.Ncount x (x + 1) : ℝ) + (Zeta23.Ncount (x + 1) (x + 2) : ℝ)
          + (Zeta23.Ncount (x + 2) (x + 3) : ℝ) := by
      rw [e1]; push_cast; ring
    rw [hsum] at hcast
    linarith only [hcast, u0, u1, u2]
  have hμshort : ∀ x y : ℝ, 1 ≤ x → x ≤ y → y ≤ x + 3 →
      |∫ τ in x..y, Zeta23.mu τ| ≤ 3 * (CM * Real.log (x + 6)) := by
    intro x y hx hxy hy
    have hbd : ∀ τ ∈ Set.uIoc x y, ‖Zeta23.mu τ‖ ≤ CM * Real.log (x + 6) := by
      intro τ hτ
      rw [Set.uIoc_of_le hxy] at hτ
      have h1 : (1 : ℝ) ≤ τ := le_trans hx hτ.1.le
      have hb := hCM τ h1
      have hlog : Real.log (τ + 3) ≤ Real.log (x + 6) :=
        Real.log_le_log (by linarith) (by linarith [hτ.2])
      calc ‖Zeta23.mu τ‖ = |Zeta23.mu τ| := rfl
        _ ≤ CM * Real.log (τ + 3) := hb
        _ ≤ CM * Real.log (x + 6) := mul_le_mul_of_nonneg_left hlog hCM0.le
    have h := intervalIntegral.norm_integral_le_of_norm_le_const hbd
    have habs : |y - x| ≤ 3 := by rw [abs_of_nonneg (by linarith)]; linarith
    have hC0 : (0 : ℝ) ≤ CM * Real.log (x + 6) :=
      mul_nonneg hCM0.le (Real.log_nonneg (by linarith))
    calc |∫ τ in x..y, Zeta23.mu τ| = ‖∫ τ in x..y, Zeta23.mu τ‖ := rfl
      _ ≤ CM * Real.log (x + 6) * |y - x| := h
      _ ≤ CM * Real.log (x + 6) * 3 := mul_le_mul_of_nonneg_left habs hC0
      _ = 3 * (CM * Real.log (x + 6)) := by ring
  -- window arithmetic for the counts
  have hNsplit : (Zeta23.Ncount a b : ℝ)
      = (Zeta23.Ncount a a' : ℝ) + (Zeta23.Ncount a' b' : ℝ) - (Zeta23.Ncount b b' : ℝ) := by
    have e1 := Zeta23.Ncount_add (a := a) (b := a') (c := b') ha'1 (by linarith)
    have e2 := Zeta23.Ncount_add (a := a) (b := b) (c := b') hab (by linarith)
    have : (Zeta23.Ncount a b' : ℝ) = (Zeta23.Ncount a a' : ℝ) + (Zeta23.Ncount a' b' : ℝ) := by
      rw [e1]; push_cast; ring
    have h2 : (Zeta23.Ncount a b' : ℝ) = (Zeta23.Ncount a b : ℝ) + (Zeta23.Ncount b b' : ℝ) := by
      rw [e2]; push_cast; ring
    linarith
  -- window arithmetic for the μ integral
  have hμint : ∀ u v : ℝ, IntervalIntegrable Zeta23.mu volume u v :=
    fun u v => hμc.intervalIntegrable u v
  have hμsplit : (∫ τ in a..b, Zeta23.mu τ)
      = (∫ τ in a..a', Zeta23.mu τ) + (∫ τ in a'..b', Zeta23.mu τ)
        - ∫ τ in b..b', Zeta23.mu τ := by
    have e1 : (∫ τ in a..b', Zeta23.mu τ)
        = (∫ τ in a..a', Zeta23.mu τ) + ∫ τ in a'..b', Zeta23.mu τ :=
      (intervalIntegral.integral_add_adjacent_intervals (hμint a a') (hμint a' b')).symm
    have e2 : (∫ τ in a..b', Zeta23.mu τ)
        = (∫ τ in a..b, Zeta23.mu τ) + ∫ τ in b..b', Zeta23.mu τ :=
      (intervalIntegral.integral_add_adjacent_intervals (hμint a b) (hμint b b')).symm
    linarith
  -- assemble
  have hNa : (Zeta23.Ncount a a' : ℝ) ≤ 3 * (A₀ * Real.log (a + 6)) :=
    hNshort a a' (by linarith) ha'1 (by linarith)
  have hNb : (Zeta23.Ncount b b' : ℝ) ≤ 3 * (A₀ * Real.log (b + 6)) :=
    hNshort b b' (by linarith) (by linarith) hb'2
  have hμa : |∫ τ in a..a', Zeta23.mu τ| ≤ 3 * (CM * Real.log (a + 6)) :=
    hμshort a a' (by linarith) ha'1 (by linarith)
  have hμb : |∫ τ in b..b', Zeta23.mu τ| ≤ 3 * (CM * Real.log (b + 6)) :=
    hμshort b b' (by linarith) (by linarith) hb'2
  have hNa0 : (0 : ℝ) ≤ (Zeta23.Ncount a a' : ℝ) := Nat.cast_nonneg _
  have hNb0 : (0 : ℝ) ≤ (Zeta23.Ncount b b' : ℝ) := Nat.cast_nonneg _
  -- every logarithm in sight is at most `2 log b`
  have hloga6 : Real.log (a + 6) ≤ 2 * Real.log b :=
    le_trans (Real.log_le_log (by linarith) (by linarith)) hlogb6
  have hloga' : Real.log a' ≤ 2 * Real.log b :=
    le_trans (Real.log_le_log (by linarith) (by linarith : a' ≤ b + 6)) hlogb6
  have hlogb' : Real.log b' ≤ 2 * Real.log b :=
    le_trans (Real.log_le_log (by linarith) (by linarith : b' ≤ b + 6)) hlogb6
  have hπ1 : (1 / π) * π = 1 := by field_simp
  have hζ' : |(1 / π) * (Zeta23.RvM.halfContour (logDeriv riemannZeta) a' b').im|
      ≤ (1 / π) * (|CB| * Real.log a' + π + |CB| * Real.log b') := by
    rw [abs_mul, abs_of_pos (by positivity : (0 : ℝ) < 1 / π)]
    exact mul_le_mul_of_nonneg_left hζbound (by positivity)
  have hπle : (1 / π) ≤ 1 := by
    rw [div_le_one hπ0]; linarith
  have hζ'' : |(1 / π) * (Zeta23.RvM.halfContour (logDeriv riemannZeta) a' b').im|
      ≤ 4 * |CB| * Real.log b + 1 := by
    have hpos : (0 : ℝ) ≤ |CB| * Real.log a' + |CB| * Real.log b' := by
      have h1 : (0 : ℝ) ≤ Real.log a' := Real.log_nonneg h1a'
      have h2 : (0 : ℝ) ≤ Real.log b' := Real.log_nonneg (by linarith)
      positivity
    have hstep : (1 / π) * (|CB| * Real.log a' + π + |CB| * Real.log b')
        ≤ (|CB| * Real.log a' + |CB| * Real.log b') + 1 := by
      have h := mul_le_mul_of_nonneg_right hπle hpos
      nlinarith [hπ1]
    have hlin : |CB| * Real.log a' + |CB| * Real.log b' ≤ 4 * |CB| * Real.log b := by
      nlinarith [hloga', hlogb', hCB0]
    linarith [hζ']
  have hdiff : ((zetaZeroConfig).N a b : ℝ) - ∫ τ in a..b, Zeta23.mu τ
      = ((1 / π) * (Zeta23.RvM.halfContour (logDeriv riemannZeta) a' b').im)
        + ((Zeta23.Ncount a a' : ℝ) - ∫ τ in a..a', Zeta23.mu τ)
        - ((Zeta23.Ncount b b' : ℝ) - ∫ τ in b..b', Zeta23.mu τ) := by
    rw [Zeta23.zetaZeroConfig_N, hNsplit, hμsplit]
    linarith [hkey]
  rw [hdiff]
  have htri := abs_sub
    (((1 / π) * (Zeta23.RvM.halfContour (logDeriv riemannZeta) a' b').im)
      + ((Zeta23.Ncount a a' : ℝ) - ∫ τ in a..a', Zeta23.mu τ))
    ((Zeta23.Ncount b b' : ℝ) - ∫ τ in b..b', Zeta23.mu τ)
  have htri2 := abs_add_le
    ((1 / π) * (Zeta23.RvM.halfContour (logDeriv riemannZeta) a' b').im)
    ((Zeta23.Ncount a a' : ℝ) - ∫ τ in a..a', Zeta23.mu τ)
  have hAa : |(Zeta23.Ncount a a' : ℝ) - ∫ τ in a..a', Zeta23.mu τ|
      ≤ 3 * (A₀ * Real.log (a + 6)) + 3 * (CM * Real.log (a + 6)) := by
    have h := abs_sub (Zeta23.Ncount a a' : ℝ) (∫ τ in a..a', Zeta23.mu τ)
    have habsN : |(Zeta23.Ncount a a' : ℝ)| = (Zeta23.Ncount a a' : ℝ) := abs_of_nonneg hNa0
    rw [habsN] at h
    linarith
  have hBb : |(Zeta23.Ncount b b' : ℝ) - ∫ τ in b..b', Zeta23.mu τ|
      ≤ 3 * (A₀ * Real.log (b + 6)) + 3 * (CM * Real.log (b + 6)) := by
    have h := abs_sub (Zeta23.Ncount b b' : ℝ) (∫ τ in b..b', Zeta23.mu τ)
    have habsN : |(Zeta23.Ncount b b' : ℝ)| = (Zeta23.Ncount b b' : ℝ) := abs_of_nonneg hNb0
    rw [habsN] at h
    linarith
  have hCM0' : (0 : ℝ) ≤ CM := hCM0.le
  have hsum0 : (0 : ℝ) ≤ 3 * (A₀ + CM) := by linarith
  have hAa' : |(Zeta23.Ncount a a' : ℝ) - ∫ τ in a..a', Zeta23.mu τ|
      ≤ 6 * (A₀ + CM) * Real.log b := by
    have h := mul_le_mul_of_nonneg_left hloga6 hsum0
    linarith only [hAa, h]
  have hBb' : |(Zeta23.Ncount b b' : ℝ) - ∫ τ in b..b', Zeta23.mu τ|
      ≤ 6 * (A₀ + CM) * Real.log b := by
    have h := mul_le_mul_of_nonneg_left hlogb6 hsum0
    linarith only [hBb, h]
  have p1 : (0 : ℝ) ≤ A₀ * (Real.log b - 1) := mul_nonneg hA₀0 (by linarith)
  have p2 : (0 : ℝ) ≤ CM * (Real.log b - 1) := mul_nonneg hCM0' (by linarith)
  have p3 : (0 : ℝ) ≤ |CB| * (Real.log b - 1) := mul_nonneg hCB0 (by linarith)
  linarith only [htri, htri2, hAa', hBb', hζ'', p1, p2, p3, hlogb1, hA₀0, hCM0', hCB0]

/-- The error constant of the translated window count. -/
def windowCountConst : ℝ := Classical.choose zeta_window_count_data

/-- The height from which the translated window count is valid. -/
def windowCountHeight : ℝ := Classical.choose (Classical.choose_spec zeta_window_count_data)

theorem windowCountConst_nonneg : 0 ≤ windowCountConst :=
  (Classical.choose_spec (Classical.choose_spec zeta_window_count_data)).1

theorem four_le_windowCountHeight : 4 ≤ windowCountHeight :=
  (Classical.choose_spec (Classical.choose_spec zeta_window_count_data)).2.1

theorem zeta_window_count_approx {a b : ℝ} (ha : windowCountHeight ≤ a) (hab : a ≤ b) :
    |((zetaZeroConfig).N a b : ℝ) - ∫ τ in a..b, Zeta23.mu τ|
      ≤ windowCountConst * Real.log b :=
  (Classical.choose_spec (Classical.choose_spec zeta_window_count_data)).2.2 a b ha hab

/-! ## 2. Sharp two-sided counts, from the monotonicity of μ -/

theorem mu_integral_le {a b : ℝ} (ha : 0 ≤ a) (hab : a ≤ b) :
    (∫ τ in a..b, Zeta23.mu τ) ≤ (b - a) * Zeta23.mu b := by
  have hμc : Continuous Zeta23.mu := Zeta23.RvM.mu_continuous Zeta23.gammaFacts
  have hmono := Zeta23.MuFields.mu_monotoneOn
  have hle : ∀ τ ∈ Set.Icc a b, Zeta23.mu τ ≤ Zeta23.mu b := by
    intro τ hτ
    exact hmono (Set.mem_Ici.2 (le_trans ha hτ.1)) (Set.mem_Ici.2 (le_trans ha hab)) hτ.2
  have h := intervalIntegral.integral_mono_on hab (hμc.intervalIntegrable a b)
    (intervalIntegrable_const (μ := volume) (c := Zeta23.mu b)) hle
  simpa [mul_comm] using h

theorem mu_integral_ge {a b : ℝ} (ha : 0 ≤ a) (hab : a ≤ b) :
    (b - a) * Zeta23.mu a ≤ ∫ τ in a..b, Zeta23.mu τ := by
  have hμc : Continuous Zeta23.mu := Zeta23.RvM.mu_continuous Zeta23.gammaFacts
  have hmono := Zeta23.MuFields.mu_monotoneOn
  have hle : ∀ τ ∈ Set.Icc a b, Zeta23.mu a ≤ Zeta23.mu τ := by
    intro τ hτ
    exact hmono (Set.mem_Ici.2 ha) (Set.mem_Ici.2 (le_trans ha hτ.1)) hτ.1
  have h := intervalIntegral.integral_mono_on hab
    (intervalIntegrable_const (μ := volume) (c := Zeta23.mu a)) (hμc.intervalIntegrable a b) hle
  simpa [mul_comm] using h

/-- **Sharp upper count for an arbitrary window.** -/
theorem zeta_window_count_le {a b : ℝ} (ha : windowCountHeight ≤ a) (hab : a ≤ b) :
    ((zetaZeroConfig).N a b : ℝ) ≤ (b - a) * Zeta23.mu b + windowCountConst * Real.log b := by
  have h0 : (0 : ℝ) ≤ a := by linarith [four_le_windowCountHeight]
  have h := abs_le.1 (zeta_window_count_approx ha hab)
  have hint := mu_integral_le h0 hab
  linarith [h.2]

/-- **Sharp lower count for an arbitrary window.** -/
theorem zeta_window_count_ge {a b : ℝ} (ha : windowCountHeight ≤ a) (hab : a ≤ b) :
    (b - a) * Zeta23.mu a - windowCountConst * Real.log b ≤ ((zetaZeroConfig).N a b : ℝ) := by
  have h0 : (0 : ℝ) ≤ a := by linarith [four_le_windowCountHeight]
  have h := abs_le.1 (zeta_window_count_approx ha hab)
  have hint := mu_integral_ge h0 hab
  linarith [h.1]

/-! ## 3. The near-core gap split with the true, matched local density -/

/-- The short counting window of §36, with the **true** local density. -/
theorem zeta_short_window_count_sharp {t D : ℝ} (hD : 0 ≤ D)
    (ht : windowCountHeight ≤ t - D - 1) :
    ((zetaZeroConfig).N (t - D - 1) (t + D) : ℝ)
      ≤ (2 * D + 1) * Zeta23.mu (t + D) + windowCountConst * Real.log (t + D) := by
  have h := zeta_window_count_le (a := t - D - 1) (b := t + D) ht (by linarith)
  have he : t + D - (t - D - 1) = 2 * D + 1 := by ring
  rw [he] at h
  exact h

/-- The long counting window of §36, with the **true** local density. -/
theorem zeta_long_window_count_sharp {t D : ℝ} {J : ℕ}
    (ht : windowCountHeight ≤ t + D) (hJ : t + D ≤ t + (J : ℝ) - 1) :
    ((J : ℝ) - 1 - D) * Zeta23.mu (t + D)
        - windowCountConst * Real.log (t + (J : ℝ) - 1)
      ≤ ((zetaZeroConfig).N (t + D) (t + (J : ℝ) - 1) : ℝ) := by
  have h := zeta_window_count_ge (a := t + D) (b := t + (J : ℝ) - 1) ht hJ
  have he : t + (J : ℝ) - 1 - (t + D) = (J : ℝ) - 1 - D := by ring
  rw [he] at h
  exact h

/-- **The gap-split cutoff bound with matched true densities, unconditionally.**  Both
counting inputs are now the same number `μ(t+D)` — the matched-constant situation that
§37 could only assume — and no density hypothesis is carried. -/
theorem zeta_gap_split_sharp_cutoff_bound {g : Fin 3 → (ℝ → ℝ)}
    (hg : ∀ j, ContDiff ℝ 2 (g j)) (hgc : ∀ j, HasCompactSupport (g j))
    {n₁ n₂ : Fin 3 → ℝ} {t r Λ D C : ℝ} {J : ℕ} (hΛ : 0 ≤ Λ) (hD : 0 < D)
    (hDΛ : D * Λ ≤ π / 2)
    (hq0 : ∀ u, 0 ≤ detTaper n₁ n₂ g r u)
    (hsupp : ∀ u, Λ < |u| → detTaper n₁ n₂ g r u = 0)
    (hCbase : detWeightCurvature n₁ n₂ g r 0 ≤ C)
    (hheight : windowCountHeight ≤ t - D - 1) (hJ : t + D ≤ t + (J : ℝ) - 1)
    (hpos : 0 < lowGapMass t J D * (Real.cos (D * Λ) * (∫ u : ℝ, detTaper n₁ n₂ g r u))
      - highGapMass t J D * (C / D ^ 2)) :
    ((J : ℝ) - 1 - D) * Zeta23.mu (t + D)
      < π ^ 2 / 4 * ((2 * D + 1) * Zeta23.mu (t + D))
        + (π ^ 2 / 4 + 1) * (windowCountConst * Real.log (t + (J : ℝ) - 1)) := by
  have hπ2 : (0 : ℝ) < π ^ 2 := by positivity
  have hht : windowCountHeight ≤ t + D := le_trans hheight (by linarith)
  have hprop := gap_split_pos_requires_low_gap_proportion hg hgc hΛ hD hDΛ hq0 hsupp hCbase hpos
  have hlow : lowGapMass t J D
      ≤ (2 * D + 1) * Zeta23.mu (t + D) + windowCountConst * Real.log (t + D) :=
    le_trans (lowGapMass_le_N t J D) (zeta_short_window_count_sharp hD.le hheight)
  have hhigh : ((J : ℝ) - 1 - D) * Zeta23.mu (t + D)
      - windowCountConst * Real.log (t + (J : ℝ) - 1) ≤ highGapMass t J D :=
    le_trans (zeta_long_window_count_sharp hht hJ) (N_le_highGapMass t J hD.le)
  have hCw : 0 ≤ windowCountConst := windowCountConst_nonneg
  have hlogmono : Real.log (t + D) ≤ Real.log (t + (J : ℝ) - 1) := by
    have h4 : (4 : ℝ) ≤ windowCountHeight := four_le_windowCountHeight
    exact Real.log_le_log (by linarith) hJ
  have hCwlog : windowCountConst * Real.log (t + D)
      ≤ windowCountConst * Real.log (t + (J : ℝ) - 1) :=
    mul_le_mul_of_nonneg_left hlogmono hCw
  -- the proportion, transported to the two sharp counts
  have hstep : 4 / π ^ 2 * (((J : ℝ) - 1 - D) * Zeta23.mu (t + D)
        - windowCountConst * Real.log (t + (J : ℝ) - 1))
      ≤ 4 / π ^ 2 * highGapMass t J D :=
    mul_le_mul_of_nonneg_left hhigh (by positivity)
  have hchain : 4 / π ^ 2 * (((J : ℝ) - 1 - D) * Zeta23.mu (t + D)
        - windowCountConst * Real.log (t + (J : ℝ) - 1))
      < (2 * D + 1) * Zeta23.mu (t + D) + windowCountConst * Real.log (t + D) := by
    linarith only [hstep, hprop, hlow]
  -- clear the factor `4/π²`
  have hmul := mul_lt_mul_of_pos_left hchain (by positivity : (0 : ℝ) < π ^ 2 / 4)
  have hleft : π ^ 2 / 4 * (4 / π ^ 2 * (((J : ℝ) - 1 - D) * Zeta23.mu (t + D)
        - windowCountConst * Real.log (t + (J : ℝ) - 1)))
      = ((J : ℝ) - 1 - D) * Zeta23.mu (t + D)
        - windowCountConst * Real.log (t + (J : ℝ) - 1) := by
    field_simp
  rw [hleft] at hmul
  have hCwlog2 : π ^ 2 / 4 * (windowCountConst * Real.log (t + D))
      ≤ π ^ 2 / 4 * (windowCountConst * Real.log (t + (J : ℝ) - 1)) :=
    mul_le_mul_of_nonneg_left hCwlog (by positivity)
  linarith only [hmul, hCwlog2]

/-- **The cutoff cap in explicit form.**  Where the Γ-density is positive, gap-split
positivity caps the cutoff at `1 + D + (π²/4)(2D+1)` plus an `O(log/μ)` term: with the
true matched densities the surviving cutoff window is `O(D)`, not `O(|t|)`. -/
theorem zeta_gap_split_sharp_cutoff_lt {g : Fin 3 → (ℝ → ℝ)}
    (hg : ∀ j, ContDiff ℝ 2 (g j)) (hgc : ∀ j, HasCompactSupport (g j))
    {n₁ n₂ : Fin 3 → ℝ} {t r Λ D C : ℝ} {J : ℕ} (hΛ : 0 ≤ Λ) (hD : 0 < D)
    (hDΛ : D * Λ ≤ π / 2)
    (hq0 : ∀ u, 0 ≤ detTaper n₁ n₂ g r u)
    (hsupp : ∀ u, Λ < |u| → detTaper n₁ n₂ g r u = 0)
    (hCbase : detWeightCurvature n₁ n₂ g r 0 ≤ C)
    (hheight : windowCountHeight ≤ t - D - 1) (hJ : t + D ≤ t + (J : ℝ) - 1)
    (hmu : 0 < Zeta23.mu (t + D))
    (hpos : 0 < lowGapMass t J D * (Real.cos (D * Λ) * (∫ u : ℝ, detTaper n₁ n₂ g r u))
      - highGapMass t J D * (C / D ^ 2)) :
    (J : ℝ) < 1 + D + π ^ 2 / 4 * (2 * D + 1)
      + (π ^ 2 / 4 + 1) * (windowCountConst * Real.log (t + (J : ℝ) - 1))
          / Zeta23.mu (t + D) := by
  have h := zeta_gap_split_sharp_cutoff_bound hg hgc hΛ hD hDΛ hq0 hsupp hCbase hheight hJ hpos
  have hkey : ((J : ℝ) - 1 - D - π ^ 2 / 4 * (2 * D + 1)) * Zeta23.mu (t + D)
      < (π ^ 2 / 4 + 1) * (windowCountConst * Real.log (t + (J : ℝ) - 1)) := by
    linarith only [h]
  have hlt : (J : ℝ) - 1 - D - π ^ 2 / 4 * (2 * D + 1)
      < (π ^ 2 / 4 + 1) * (windowCountConst * Real.log (t + (J : ℝ) - 1))
          / Zeta23.mu (t + D) := by
    rw [lt_div_iff₀ hmu]
    exact hkey
  linarith only [hlt]

