namespace Wikidata

/-! ## Quantities

A Wikidata quantity is an amount, a unit and (optionally) a lower and an upper
bound.  We keep the bounds always present: an exact quantity is the degenerate
interval `[a, a]`.
-/

/-- The item `Q199` ("1"), Wikidata's unit for dimensionless quantities. -/
def unitOne : Qid := ⟨199⟩

/-- A Wikidata quantity: an amount with bounds, in a unit. -/
structure Quantity where
  amount : ℚ
  lowerBound : ℚ
  upperBound : ℚ
  unit : Qid
  deriving DecidableEq, Repr, Inhabited

namespace Quantity

/-- An exact quantity: the amount with degenerate bounds. -/
def exact (a : ℚ) (u : Qid) : Quantity := ⟨a, a, a, u⟩

/-- A quantity is well formed when its amount lies inside its bounds. -/
def WellFormed (q : Quantity) : Prop := q.lowerBound ≤ q.amount ∧ q.amount ≤ q.upperBound

instance (q : Quantity) : Decidable (WellFormed q) := inferInstanceAs (Decidable (_ ∧ _))

theorem wellFormed_exact (a : ℚ) (u : Qid) : WellFormed (exact a u) := ⟨le_refl a, le_refl a⟩

/-- The interval denoted by a quantity. -/
def Mem (q : Quantity) (x : ℚ) : Prop := q.lowerBound ≤ x ∧ x ≤ q.upperBound

instance (q : Quantity) (x : ℚ) : Decidable (Mem q x) := inferInstanceAs (Decidable (_ ∧ _))

theorem mem_amount {q : Quantity} (h : WellFormed q) : Mem q q.amount := h

@[simp] theorem mem_exact_iff (a x : ℚ) (u : Qid) : Mem (exact a u) x ↔ x = a := by
  constructor
  · rintro ⟨h₁, h₂⟩; exact le_antisymm h₂ h₁
  · rintro rfl; exact ⟨le_refl _, le_refl _⟩

/-- Two quantities are comparable only when they are stated in the same unit. -/
def SameUnit (q r : Quantity) : Prop := q.unit = r.unit

instance (q r : Quantity) : Decidable (SameUnit q r) := inferInstanceAs (Decidable (_ = _))

/-- The executable agreement test: same unit and overlapping intervals. -/
def overlaps (q r : Quantity) : Bool :=
  q.unit = r.unit && decide (max q.lowerBound r.lowerBound ≤ min q.upperBound r.upperBound)

/-- Exactness: the checker decides "same unit, and some value satisfies both". -/
theorem overlaps_iff (q r : Quantity) :
    overlaps q r = true ↔ SameUnit q r ∧ ∃ x : ℚ, Mem q x ∧ Mem r x := by
  simp only [overlaps, Bool.and_eq_true, decide_eq_true_eq, SameUnit, Mem]
  constructor
  · rintro ⟨hu, hle⟩
    refine ⟨hu, max q.lowerBound r.lowerBound, ⟨le_max_left _ _, ?_⟩, le_max_right _ _, ?_⟩
    · exact le_trans hle (min_le_left _ _)
    · exact le_trans hle (min_le_right _ _)
  · rintro ⟨hu, x, ⟨h₁, h₂⟩, h₃, h₄⟩
    exact ⟨hu, le_trans (max_le h₁ h₃) (le_min h₂ h₄)⟩

theorem overlaps_symm (q r : Quantity) : overlaps q r = overlaps r q := by
  simp only [overlaps, max_comm q.lowerBound r.lowerBound, min_comm q.upperBound r.upperBound]
  by_cases h : q.unit = r.unit
  · simp [h]
  · simp [h, Ne.symm h]

theorem overlaps_self {q : Quantity} (h : WellFormed q) : overlaps q q = true :=
  (overlaps_iff q q).2 ⟨rfl, q.amount, mem_amount h, mem_amount h⟩

/-- Two exact quantities agree exactly when they are the same quantity. -/
theorem overlaps_exact_iff (a b : ℚ) (u v : Qid) :
    overlaps (exact a u) (exact b v) = true ↔ (u = v ∧ a = b) := by
  rw [overlaps_iff]
  constructor
  · rintro ⟨hu, x, hx, hy⟩
    rw [mem_exact_iff] at hx hy
    exact ⟨hu, hx ▸ hy ▸ rfl⟩
  · rintro ⟨rfl, rfl⟩
    exact ⟨rfl, a, by simp, by simp⟩

/-- The metre, `Q11573`, and the mile, `Q253276` — two units for the same dimension. -/
def metre : Qid := ⟨11573⟩
/-- The mile, `Q253276`. -/
def mile : Qid := ⟨253276⟩

-- @source DASHI Agda bridge (PR #555/#581/#582): quantity: amount, unit, lower and upper bound
/-- **A bare amount is not a quantity.**  The same number in two units is not the
same quantity, and the checker refuses to compare them. -/
theorem amount_equality_is_not_quantity_agreement :
    (exact 1 metre).amount = (exact 1 mile).amount ∧
      overlaps (exact 1 metre) (exact 1 mile) = false := by
  refine ⟨rfl, ?_⟩
  simp [overlaps, Quantity.exact, metre, mile]

-- @source DASHI Agda bridge (PR #555/#581/#582): quantity: amount, unit, lower and upper bound
/-- **Interval agreement is not transitive.**  Uncertainty is not an equivalence:
`[0,1]` meets `[1,2]` and `[1,2]` meets `[2,3]`, but `[0,1]` misses `[2,3]`. -/
theorem overlaps_not_transitive :
    ∃ q r s : Quantity,
      overlaps q r = true ∧ overlaps r s = true ∧ overlaps q s = false := by
  refine ⟨⟨0, 0, 1, unitOne⟩, ⟨1, 1, 2, unitOne⟩, ⟨3, 2, 3, unitOne⟩, ?_, ?_, ?_⟩ <;>
    norm_num [overlaps]

/-- Agreement is coarser than equality: distinct quantities can agree. -/
theorem overlaps_does_not_imply_eq :
    ∃ q r : Quantity, overlaps q r = true ∧ q ≠ r := by
  refine ⟨⟨0, 0, 1, unitOne⟩, ⟨1, 0, 2, unitOne⟩, ?_, ?_⟩
  · norm_num [overlaps]
  · intro h; simpa using congrArg Quantity.amount h

end Quantity

/-! ## Times

A Wikidata time value is a timestamp together with a *precision* and a *calendar
model*.  The fields below the stated precision are padded with zeros and carry no
information; comparison is therefore always comparison *at a precision*.
-/

/-- Time precision, restricted to the levels this development uses. -/
inductive TimePrecision
  | century
  | decade
  | year
  | month
  | day
  deriving DecidableEq, Repr, Inhabited

namespace TimePrecision

/-- How fine a precision is: bigger is finer. -/
def level : TimePrecision → Nat
  | century => 0
  | decade => 1
  | year => 2
  | month => 3
  | day => 4

end TimePrecision

/-- The Gregorian calendar model, `Q1985727`. -/
def gregorian : Qid := ⟨1985727⟩
/-- The Julian calendar model, `Q1985786`. -/
def julian : Qid := ⟨1985786⟩

/-- A Wikidata time value. -/
structure TimeValue where
  year : Int
  month : Nat := 0
  day : Nat := 0
  precision : TimePrecision := TimePrecision.day
  calendar : Qid := gregorian
  deriving DecidableEq, Repr, Inhabited

namespace TimeValue

/-- The information a time value carries at a given precision. -/
def keyAt (t : TimeValue) : TimePrecision → Int × Nat × Nat
  | TimePrecision.century => (t.year / 100, 0, 0)
  | TimePrecision.decade => (t.year / 10, 0, 0)
  | TimePrecision.year => (t.year, 0, 0)
  | TimePrecision.month => (t.year, t.month, 0)
  | TimePrecision.day => (t.year, t.month, t.day)

/-- Two time values agree at a precision when they use the same calendar model and
carry the same information at that precision. -/
def AgreeAt (p : TimePrecision) (t u : TimeValue) : Prop :=
  t.calendar = u.calendar ∧ t.keyAt p = u.keyAt p

instance (p : TimePrecision) (t u : TimeValue) : Decidable (AgreeAt p t u) :=
  inferInstanceAs (Decidable (_ ∧ _))

theorem agreeAt_refl (p : TimePrecision) (t : TimeValue) : AgreeAt p t t := ⟨rfl, rfl⟩

theorem agreeAt_symm {p : TimePrecision} {t u : TimeValue} (h : AgreeAt p t u) :
    AgreeAt p u t := ⟨h.1.symm, h.2.symm⟩

theorem agreeAt_trans {p : TimePrecision} {t u v : TimeValue}
    (h₁ : AgreeAt p t u) (h₂ : AgreeAt p u v) : AgreeAt p t v :=
  ⟨h₁.1.trans h₂.1, h₁.2.trans h₂.2⟩

/-! ### The precision tower

Agreement at a finer precision implies agreement at a coarser one, and not
conversely.
-/

theorem agreeAt_day_iff (t u : TimeValue) :
    AgreeAt TimePrecision.day t u ↔
      t.calendar = u.calendar ∧ t.year = u.year ∧ t.month = u.month ∧ t.day = u.day := by
  simp [AgreeAt, keyAt]

theorem agreeAt_month_iff (t u : TimeValue) :
    AgreeAt TimePrecision.month t u ↔
      t.calendar = u.calendar ∧ t.year = u.year ∧ t.month = u.month := by
  simp [AgreeAt, keyAt]

theorem agreeAt_year_iff (t u : TimeValue) :
    AgreeAt TimePrecision.year t u ↔ t.calendar = u.calendar ∧ t.year = u.year := by
  simp [AgreeAt, keyAt]

theorem agreeAt_decade_iff (t u : TimeValue) :
    AgreeAt TimePrecision.decade t u ↔ t.calendar = u.calendar ∧ t.year / 10 = u.year / 10 := by
  simp [AgreeAt, keyAt]

theorem agreeAt_century_iff (t u : TimeValue) :
    AgreeAt TimePrecision.century t u ↔ t.calendar = u.calendar ∧ t.year / 100 = u.year / 100 := by
  simp [AgreeAt, keyAt]

theorem agreeAt_month_of_day {t u : TimeValue} (h : AgreeAt TimePrecision.day t u) :
    AgreeAt TimePrecision.month t u := by
  rw [agreeAt_day_iff] at h
  rw [agreeAt_month_iff]
  exact ⟨h.1, h.2.1, h.2.2.1⟩

theorem agreeAt_year_of_month {t u : TimeValue} (h : AgreeAt TimePrecision.month t u) :
    AgreeAt TimePrecision.year t u := by
  rw [agreeAt_month_iff] at h
  rw [agreeAt_year_iff]
  exact ⟨h.1, h.2.1⟩

theorem agreeAt_decade_of_year {t u : TimeValue} (h : AgreeAt TimePrecision.year t u) :
    AgreeAt TimePrecision.decade t u := by
  rw [agreeAt_year_iff] at h
  rw [agreeAt_decade_iff]
  exact ⟨h.1, by rw [h.2]⟩

theorem agreeAt_century_of_decade {t u : TimeValue} (h : AgreeAt TimePrecision.decade t u) :
    AgreeAt TimePrecision.century t u := by
  rw [agreeAt_decade_iff] at h
  rw [agreeAt_century_iff]
  refine ⟨h.1, ?_⟩
  have hy : t.year / 10 = u.year / 10 := h.2
  omega

theorem agreeAt_year_of_day {t u : TimeValue} (h : AgreeAt TimePrecision.day t u) :
    AgreeAt TimePrecision.year t u :=
  agreeAt_year_of_month (agreeAt_month_of_day h)

theorem agreeAt_century_of_day {t u : TimeValue} (h : AgreeAt TimePrecision.day t u) :
    AgreeAt TimePrecision.century t u :=
  agreeAt_century_of_decade (agreeAt_decade_of_year (agreeAt_year_of_day h))

-- @source DASHI Agda bridge (PR #555/#581/#582): time: timestamp, precision, calendar model
/-- **A coarse record is not a claim about the finer fields.**  A value recorded at
year precision agrees, at that precision, with two different days — so reading the
padded fields as data invents information the source never carried. -/
theorem year_precision_does_not_determine_the_day :
    ∃ t u v : TimeValue,
      t.precision = TimePrecision.year ∧
      u ≠ v ∧
      AgreeAt TimePrecision.year t u ∧ AgreeAt TimePrecision.year t v ∧
      ¬ AgreeAt TimePrecision.day u v := by
  refine ⟨⟨1503, 0, 0, TimePrecision.year, gregorian⟩,
          ⟨1503, 1, 1, TimePrecision.day, gregorian⟩,
          ⟨1503, 6, 15, TimePrecision.day, gregorian⟩, rfl, by decide, ?_, ?_, ?_⟩ <;> decide

/-- Agreement at a coarse precision does not give agreement at a fine one. -/
theorem agreeAt_year_not_agreeAt_day :
    ∃ t u : TimeValue, AgreeAt TimePrecision.year t u ∧ ¬ AgreeAt TimePrecision.day t u := by
  refine ⟨⟨1503, 1, 1, TimePrecision.day, gregorian⟩,
          ⟨1503, 6, 15, TimePrecision.day, gregorian⟩, ?_, ?_⟩ <;> decide

-- @source DASHI Agda bridge (PR #555/#581/#582): time: timestamp, precision, calendar model
/-- **The calendar model is part of the value.**  The same numerals in the Julian
and the Gregorian calendar denote different days, and the comparison says so. -/
theorem numeric_equality_is_not_time_agreement :
    ∃ t u : TimeValue,
      t.year = u.year ∧ t.month = u.month ∧ t.day = u.day ∧
      ¬ AgreeAt TimePrecision.day t u := by
  refine ⟨⟨1582, 10, 5, TimePrecision.day, gregorian⟩,
          ⟨1582, 10, 5, TimePrecision.day, julian⟩, rfl, rfl, rfl, ?_⟩
  decide

/-! ### Ordering time values

Comparison is by the padded timestamp; it is meaningful only within one calendar
model, which the `sameCalendar` side condition of the results below records.
-/

/-- A numeric stamp for a time value, for month and day fields below `100`. -/
def stamp (t : TimeValue) : Int := t.year * 10000 + (t.month : Int) * 100 + (t.day : Int)

/-- The chronological order on time values. -/
def Le (t u : TimeValue) : Prop := t.stamp ≤ u.stamp

instance (t u : TimeValue) : Decidable (Le t u) := inferInstanceAs (Decidable (_ ≤ _))

theorem le_refl' (t : TimeValue) : Le t t := le_refl _

theorem le_trans' {t u v : TimeValue} (h₁ : Le t u) (h₂ : Le u v) : Le t v := le_trans h₁ h₂

theorem le_total' (t u : TimeValue) : Le t u ∨ Le u t := le_total _ _

/-- Day-precision agreement in one calendar pins the stamp. -/
theorem stamp_eq_of_agreeAt_day {t u : TimeValue} (h : AgreeAt TimePrecision.day t u) :
    t.stamp = u.stamp := by
  have := h.2
  simp only [keyAt, Prod.mk.injEq] at this
  simp [stamp, this.1, this.2.1, this.2.2]

-- @source DASHI Agda bridge (PR #555/#581/#582): time: timestamp, precision, calendar model
/-- **The order forgets the calendar model.**  Two values with different calendars
compare as simultaneous even though they are different days. -/
theorem order_is_calendar_blind :
    ∃ t u : TimeValue, Le t u ∧ Le u t ∧ ¬ AgreeAt TimePrecision.day t u := by
  refine ⟨⟨1582, 10, 5, TimePrecision.day, gregorian⟩,
          ⟨1582, 10, 5, TimePrecision.day, julian⟩, ?_, ?_, ?_⟩ <;> decide

end TimeValue

/-! ## Globe coordinates -/

/-- The Earth, `Q2`. -/
def earth : Qid := ⟨2⟩
/-- Mars, `Q111`. -/
def mars : Qid := ⟨111⟩

/-- A Wikidata globe coordinate: latitude and longitude in degrees, a precision in
degrees, and the globe the coordinates are taken on. -/
structure Coordinate where
  latitude : ℚ
  longitude : ℚ
  precision : ℚ := 0
  globe : Qid := earth
  deriving DecidableEq, Repr, Inhabited

namespace Coordinate

/-- Is the coordinate within the range of legal latitudes and longitudes? -/
def WellFormed (c : Coordinate) : Prop :=
  -90 ≤ c.latitude ∧ c.latitude ≤ 90 ∧ -180 ≤ c.longitude ∧ c.longitude ≤ 180 ∧ 0 ≤ c.precision

instance (c : Coordinate) : Decidable (WellFormed c) :=
  inferInstanceAs (Decidable (_ ∧ _ ∧ _ ∧ _ ∧ _))

/-- Does `d` fall inside the stated precision of `c`, on the same globe?  Note the
asymmetry: the tolerance is the one `c` states. -/
def covers (c d : Coordinate) : Bool :=
  c.globe = d.globe &&
    decide (|c.latitude - d.latitude| ≤ c.precision) &&
    decide (|c.longitude - d.longitude| ≤ c.precision)

theorem covers_iff (c d : Coordinate) :
    covers c d = true ↔
      c.globe = d.globe ∧ |c.latitude - d.latitude| ≤ c.precision ∧
        |c.longitude - d.longitude| ≤ c.precision := by
  simp [covers, and_assoc]

theorem covers_self {c : Coordinate} (h : 0 ≤ c.precision) : covers c c = true := by
  rw [covers_iff]
  refine ⟨rfl, ?_, ?_⟩ <;> simpa using h

-- @source DASHI Agda bridge (PR #555/#581/#582): globe coordinate: latitude, longitude, precision, globe
/-- **Coverage is not symmetric.**  A coarse record covers a precise one, and not
conversely: precision is a property of the record, not of the place. -/
theorem covers_not_symmetric :
    ∃ c d : Coordinate, covers c d = true ∧ covers d c = false := by
  refine ⟨⟨0, 0, 1, earth⟩, ⟨(1 : ℚ)/2, 0, 0, earth⟩, ?_, ?_⟩ <;>
    norm_num [covers, abs_le]

-- @source DASHI Agda bridge (PR #555/#581/#582): globe coordinate: latitude, longitude, precision, globe
/-- **Coverage is not transitive**, so it is not an identification of places. -/
theorem covers_not_transitive :
    ∃ c d e : Coordinate, covers c d = true ∧ covers d e = true ∧ covers c e = false := by
  refine ⟨⟨0, 0, 1, earth⟩, ⟨1, 0, 1, earth⟩, ⟨2, 0, 0, earth⟩, ?_, ?_, ?_⟩ <;>
    norm_num [covers, abs_le]

-- @source DASHI Agda bridge (PR #555/#581/#582): globe coordinate: latitude, longitude, precision, globe
/-- **The globe is part of the value.**  The same numbers on Earth and on Mars are
different places, and the comparison refuses to identify them. -/
theorem same_numbers_different_globe_do_not_match :
    ∃ c d : Coordinate,
      c.latitude = d.latitude ∧ c.longitude = d.longitude ∧ covers c d = false := by
  refine ⟨⟨10, 20, 1, earth⟩, ⟨10, 20, 1, mars⟩, rfl, rfl, ?_⟩
  simp [covers, earth, mars]

end Coordinate

end Wikidata
