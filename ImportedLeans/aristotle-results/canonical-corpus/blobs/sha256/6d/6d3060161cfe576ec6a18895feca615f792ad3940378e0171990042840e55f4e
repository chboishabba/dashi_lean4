  ∷ dogOntology
  ∷ octopusOntology
  ∷ alienOntology
  ∷ rendererOntology
  ∷ machineOntology
  ∷ []

------------------------------------------------------------------------
-- Bounded bidirectional bridge.

record OntologyTransportSurface : Set₁ where
  field
    sourceDomain : AggregateOntologyDomain
    targetDomain : AggregateOntologyDomain

    SourceCarrier : Set
    TargetCarrier : Set
    SourceQuotient : Set
    TargetQuotient : Set
    TransportResidual : Set
    ProjectionDefect : Set
    Epsilon : Set

    sourceObserve :
      SourceCarrier →
      SourceQuotient

    targetObserve :
      TargetCarrier →
      TargetQuotient

    forwardTransport :
      SourceQuotient →
      TargetQuotient

    backwardTransport :
      TargetQuotient →
      SourceQuotient

