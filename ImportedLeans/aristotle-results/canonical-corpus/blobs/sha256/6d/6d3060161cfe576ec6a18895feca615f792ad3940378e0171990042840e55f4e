    ∷ []
    )
    ( "enthalpy and entropy authority"
    ∷ "activity model and standard-state convention"
    ∷ "thermochemistry authority and uncertainty"
    ∷ []
    )
    "symbolic thermochemistry slot only; measured values remain authority-gated"
  ∷ []

