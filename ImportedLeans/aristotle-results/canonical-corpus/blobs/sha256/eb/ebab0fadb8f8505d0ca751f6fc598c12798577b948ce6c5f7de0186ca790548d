/-! ## Evidence states are not balanced digits -/

-- @source DASHI Agda bridge (PR #555/#581/#582): three-element carriers are not canonically identified
/-- An encoding of the evidence states into balanced digits.  The two resolved
states have forced images; `unresolved` is a free parameter. -/
def encodeWithPolicy (z : Trit) : Epistemic.Trit → Trit
  | .supported => Trit.pos
  | .unresolved => z
  | .contradicted => Trit.neg

theorem encodeWithPolicy_supported (z : Trit) :
    encodeWithPolicy z Epistemic.Trit.supported = Trit.pos := rfl

theorem encodeWithPolicy_contradicted (z : Trit) :
    encodeWithPolicy z Epistemic.Trit.contradicted = Trit.neg := rfl

-- @source DASHI Agda bridge (PR #555/#581/#582): three-element carriers are not canonically identified
/-- **Where `unresolved` goes is a policy, not a fact.**  Three encodings agree
on both resolved states and disagree on `unresolved`, so the coincidence of
cardinalities does not identify the evidence carrier with the geometric one. -/
theorem encoding_of_unresolved_is_policy :
    encodeWithPolicy Trit.zer Epistemic.Trit.unresolved = Trit.zer ∧
      encodeWithPolicy Trit.neg Epistemic.Trit.unresolved = Trit.neg ∧
      encodeWithPolicy Trit.pos Epistemic.Trit.unresolved = Trit.pos ∧
      (∀ z z' : Trit, ∀ s : Epistemic.Trit, s ≠ Epistemic.Trit.unresolved →
        encodeWithPolicy z s = encodeWithPolicy z' s) := by
  refine ⟨rfl, rfl, rfl, ?_⟩
  rintro z z' (_ | _ | _) hs
  · rfl
  · exact absurd rfl hs
  · rfl

/-! ## A Boolean decision on a balanced digit is a policy -/

/-- Accept only the positive pole. -/
def positiveOnly (t : Trit) : Bool := decide (t = Trit.pos)

/-- Accept anything off the centre. -/
def nonzero (t : Trit) : Bool := decide (t ≠ Trit.zer)

/-- The two policies disagree exactly at the negative pole. -/
theorem decision_policies_differ :
    positiveOnly Trit.neg ≠ nonzero Trit.neg ∧
      positiveOnly Trit.zer = nonzero Trit.zer ∧
      positiveOnly Trit.pos = nonzero Trit.pos := by
  refine ⟨by decide, by decide, by decide⟩

-- @source DASHI Agda bridge (PR #555/#581/#582): three-element carriers are not canonically identified
/-- **No Boolean projection is canonical**: both policies agree on the centre
and the positive pole, so nothing in the carrier decides the negative one. -/
theorem no_canonical_binary_decision :
    ∃ p q : Trit → Bool, (∀ t, t ≠ Trit.neg → p t = q t) ∧ p Trit.neg ≠ q Trit.neg := by
  refine ⟨positiveOnly, nonzero, ?_, by decide⟩
  intro t ht
  cases t
  · exact absurd rfl ht
  · rfl
  · rfl

/-! ## The `9 → 4 → 3` collapse -/

/-- A ternary comparison of two positions: nine states. -/
abbrev Comparison := Trit × Trit

-- @source DASHI Agda bridge (PR #555/#581/#582): the binary/balanced aggregate loss `9 → 4 → 3`
/-- Project a comparison to a pair of Boolean decisions. -/
def binaryProject (c : Comparison) : Bool × Bool := (positiveOnly c.1, positiveOnly c.2)

-- @source DASHI Agda bridge (PR #555/#581/#582): the binary/balanced aggregate loss `9 → 4 → 3`
/-- Count the accepted sides. -/
def acceptCount (b : Bool × Bool) : ℕ := (if b.1 then 1 else 0) + (if b.2 then 1 else 0)

theorem card_comparison : Fintype.card Comparison = 9 := by decide

theorem card_binary : Fintype.card (Bool × Bool) = 4 := by decide

/-- A disagreement, and the same disagreement the other way round. -/
def forwardDisagreement : Comparison := (Trit.pos, Trit.neg)

/-- The reverse disagreement. -/
def reverseDisagreement : Comparison := (Trit.neg, Trit.pos)

theorem binary_direction_still_distinct :
    binaryProject forwardDisagreement ≠ binaryProject reverseDisagreement := by decide

-- @source DASHI Agda bridge (PR #555/#581/#582): the binary/balanced aggregate loss `9 → 4 → 3`
/-- **The count erases the direction of a disagreement.** -/
theorem acceptCount_erases_direction :
    acceptCount (binaryProject forwardDisagreement)
      = acceptCount (binaryProject reverseDisagreement) := by decide

-- @source DASHI Agda bridge (PR #555/#581/#582): the binary/balanced aggregate loss `9 → 4 → 3`
/-- **…and no decoding can put it back.**  The Boolean decisions do not factor
through the count. -/
theorem direction_not_factorsThrough_acceptCount :
    ¬ Epistemic.FactorsThrough (fun c : Comparison => acceptCount (binaryProject c))
      binaryProject :=
  Epistemic.not_factorsThrough acceptCount_erases_direction binary_direction_still_distinct

/-- The first step is lossy too: the Boolean decisions identify comparisons that
the balanced comparison keeps apart. -/
theorem comparison_not_factorsThrough_binaryProject :
    ¬ Epistemic.FactorsThrough binaryProject (id : Comparison → Comparison) :=
  Epistemic.not_factorsThrough
    (show binaryProject (Trit.neg, Trit.neg) = binaryProject (Trit.zer, Trit.zer) by decide)
    (by decide)

-- @source DASHI Agda bridge (PR #555/#581/#582): the binary/balanced aggregate loss `9 → 4 → 3`
/-- Neither projection separates the comparison. -/
theorem binaryProject_not_separating : ¬ Epistemic.Separating binaryProject :=
  Epistemic.not_separating_of_collision
    ⟨(Trit.neg, Trit.neg), (Trit.zer, Trit.zer), by decide, by decide⟩

/-! ## Complement and antipode -/

-- @source DASHI Agda bridge (PR #555/#581/#582): centring a Bernoulli position onto a balanced digit
/-- The three distinguished Bernoulli positions. -/
inductive BernoulliPoint
  | zero
  | half
  | one
  deriving DecidableEq, Repr, Inhabited

/-- Complementing a probability. -/
def BernoulliPoint.complement : BernoulliPoint → BernoulliPoint
  | zero => one
  | half => half
  | one => zero

/-- Centring a probability onto the balanced digits. -/
def BernoulliPoint.centred : BernoulliPoint → Trit
  | zero => Trit.neg
  | half => Trit.zer
  | one => Trit.pos

-- @source DASHI Agda bridge (PR #555/#581/#582): centring a Bernoulli position onto a balanced digit
/-- **The half point is the fixed point of complementation** — matching the
centre being the fixed point of the antipode. -/
theorem half_complement_fixed :
    BernoulliPoint.complement BernoulliPoint.half = BernoulliPoint.half := rfl

-- @source DASHI Agda bridge (PR #555/#581/#582): centring a Bernoulli position onto a balanced digit
/-- **Centring is equivariant**: the complement of a probability centres to the
antipode of its centred digit. -/
theorem centred_complement (p : BernoulliPoint) :
    BernoulliPoint.centred p.complement = Trit.antipode (BernoulliPoint.centred p) := by
  cases p <;> rfl

-- @source DASHI Agda bridge (PR #555/#581/#582): centring a Bernoulli position onto a balanced digit
/-- Centring loses nothing: the three positions are three distinct digits. -/
theorem centred_injective : Function.Injective BernoulliPoint.centred := by
  intro p q h
  cases p <;> cases q <;> simp_all [BernoulliPoint.centred]

end Ternary
