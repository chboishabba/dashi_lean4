factorVecEquivalence : HQ.EquivalenceOn FactorVec
factorVecEquivalence = record
  { _≈_   = _≡_
  ; refl  = λ x → refl
  ; sym   = sym
  ; trans = trans
  }

factorVecQuotient : HQ.QuotientInterfaceOn FactorVec FactorVec
factorVecQuotient = record
  { equiv         = factorVecEquivalence
