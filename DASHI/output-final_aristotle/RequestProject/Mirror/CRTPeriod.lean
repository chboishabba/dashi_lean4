namespace Mirror.CRTPeriod

/-- The repo-defined digit function of `CRTPeriod.agda`. -/
def d (N : ℕ) : ℕ := ((N % 71) + (N % 59) + (N % 47)) % 10

/-- `period = 71 * 59 * 47 = 196883`. -/
def period : ℕ := 71 * 59 * 47

theorem period_eq : period = 196883 := by norm_num [period]

/-- The moonshine link: the digit function's period is one less than the first
non-trivial Fourier coefficient of the `j`-invariant. -/
theorem period_add_one : period + 1 = 196884 := by norm_num [period]

/-- `d` only reads its argument through the three residues. -/
theorem d_congr {M N : ℕ} (h71 : M % 71 = N % 71) (h59 : M % 59 = N % 59)
    (h47 : M % 47 = N % 47) : d M = d N := by
  unfold d; rw [h71, h59, h47]

private theorem shift_mod {c p : ℕ} (h : period = c * p) (N k : ℕ) :
    (N + k * period) % p = N % p := by
  rw [h, show k * (c * p) = k * c * p by ring, Nat.add_mul_mod_self_right]

/-- The Agda theorem `period-thm`. -/
theorem period_thm (N k : ℕ) : d (N + k * period) = d N :=
  d_congr (shift_mod (c := 2773) (by norm_num [period]) N k)
    (shift_mod (c := 3337) (by norm_num [period]) N k)
    (shift_mod (c := 4189) (by norm_num [period]) N k)

/-- `p` is a period of the digit function. -/
def IsPeriod (p : ℕ) : Prop := ∀ N, d (N + p) = d N

theorem isPeriod_period : IsPeriod period := fun N => by
  simpa using period_thm N 1

theorem isPeriod_zero : IsPeriod 0 := fun N => by simp

theorem isPeriod_add {p q : ℕ} (hp : IsPeriod p) (hq : IsPeriod q) :
    IsPeriod (p + q) := fun N => by
  rw [← Nat.add_assoc, hq, hp]

theorem isPeriod_nsmul {p : ℕ} (hp : IsPeriod p) : ∀ k, IsPeriod (k * p)
  | 0 => by simpa using isPeriod_zero
  | k + 1 => by
      have := isPeriod_add (isPeriod_nsmul hp k) hp
      simpa [Nat.succ_mul] using this

/-- Any multiple of a period is a period. -/
theorem isPeriod_of_dvd {p q : ℕ} (h : p ∣ q) (hp : IsPeriod p) : IsPeriod q := by
  obtain ⟨k, rfl⟩ := h
  simpa [Nat.mul_comm] using isPeriod_nsmul hp k

theorem isPeriod_sub {p q : ℕ} (hp : IsPeriod p) (hq : IsPeriod q) (h : q ≤ p) :
    IsPeriod (p - q) := fun N => by
  have key : d (N + (p - q) + q) = d (N + (p - q)) := hq _
  rw [Nat.add_assoc, Nat.sub_add_cancel h] at key
  rw [← key, hp]

theorem isPeriod_mod {m n : ℕ} (hm : IsPeriod m) (hn : IsPeriod n) :
    IsPeriod (n % m) := by
  rcases Nat.eq_zero_or_pos m with rfl | hpos
  · simpa using hn
  · have hle : n / m * m ≤ n := Nat.div_mul_le_self n m
    have hsub := isPeriod_sub hn (isPeriod_nsmul hm (n / m)) hle
    have hmod : n % m + n / m * m = n := by
      rw [Nat.mul_comm]; exact Nat.mod_add_div n m
    have hEq : n - n / m * m = n % m := by omega
    rwa [hEq] at hsub

/-- The periods are closed under `gcd`: this is the subgroup argument, in `ℕ`. -/
theorem isPeriod_gcd {a b : ℕ} (ha : IsPeriod a) (hb : IsPeriod b) :
    IsPeriod (Nat.gcd a b) := by
  induction a, b using Nat.gcd.induction with
  | H0 n => simpa using hb
  | H1 m n _ ih =>
      rw [Nat.gcd_rec]
      exact ih (isPeriod_mod ha hb) ha

theorem not_isPeriod_4189 : ¬ IsPeriod 4189 := by
  intro h
  have := h 0
  norm_num [d] at this

theorem not_isPeriod_3337 : ¬ IsPeriod 3337 := by
  intro h
  have := h 0
  norm_num [d] at this

theorem not_isPeriod_2773 : ¬ IsPeriod 2773 := by
  intro h
  have := h 0
  norm_num [d] at this

private theorem dvd_of_gcd_period {g : ℕ} (hg : IsPeriod g) (hdvd : g ∣ period) :
    period ∣ g := by
  have h47 : (47 : ℕ) ∣ g := by
    by_contra hc
    have hco : Nat.Coprime 47 g :=
      (Nat.Prime.coprime_iff_not_dvd (by norm_num)).mpr hc
    have hd : g ∣ 47 * 4189 := by
      have hper : period = 47 * 4189 := by norm_num [period]
      rwa [hper] at hdvd
    exact not_isPeriod_4189 (isPeriod_of_dvd (hco.symm.dvd_of_dvd_mul_left hd) hg)
  have h59 : (59 : ℕ) ∣ g := by
    by_contra hc
    have hco : Nat.Coprime 59 g :=
      (Nat.Prime.coprime_iff_not_dvd (by norm_num)).mpr hc
    have hd : g ∣ 59 * 3337 := by
      have hper : period = 59 * 3337 := by norm_num [period]
      rwa [hper] at hdvd
    exact not_isPeriod_3337 (isPeriod_of_dvd (hco.symm.dvd_of_dvd_mul_left hd) hg)
  have h71 : (71 : ℕ) ∣ g := by
    by_contra hc
    have hco : Nat.Coprime 71 g :=
      (Nat.Prime.coprime_iff_not_dvd (by norm_num)).mpr hc
    have hd : g ∣ 71 * 2773 := by
      have hper : period = 71 * 2773 := by norm_num [period]
      rwa [hper] at hdvd
    exact not_isPeriod_2773 (isPeriod_of_dvd (hco.symm.dvd_of_dvd_mul_left hd) hg)
  have h4759 : (47 * 59 : ℕ) ∣ g :=
    Nat.Coprime.mul_dvd_of_dvd_of_dvd (by decide) h47 h59
  have hall : (47 * 59 * 71 : ℕ) ∣ g :=
    Nat.Coprime.mul_dvd_of_dvd_of_dvd (by decide) h4759 h71
  have hper : period = 47 * 59 * 71 := by norm_num [period]
  rwa [hper]

/-- **The periods of the digit function are exactly the multiples of `196883`.**
The `←` direction is the Agda theorem `period-thm`; the `→` direction is new. -/
theorem isPeriod_iff (p : ℕ) : IsPeriod p ↔ period ∣ p := by
  constructor
  · intro hp
    have hg : IsPeriod (Nat.gcd p period) := isPeriod_gcd hp isPeriod_period
    have hdvd : Nat.gcd p period ∣ period := Nat.gcd_dvd_right _ _
    exact (dvd_of_gcd_period hg hdvd).trans (Nat.gcd_dvd_left _ _)
  · intro h; exact isPeriod_of_dvd h isPeriod_period

/-- `196883` is the *minimal* positive period of the digit function. -/
theorem minimal_period {p : ℕ} (hpos : 0 < p) (hp : IsPeriod p) : 196883 ≤ p := by
  have hle := Nat.le_of_dvd hpos ((isPeriod_iff p).mp hp)
  rw [period_eq] at hle
  exact hle

/-- No proper divisor of `196883` is a period. -/
theorem no_proper_divisor_is_a_period {p : ℕ} (hdvd : p ∣ period) (hne : p ≠ period) :
    ¬ IsPeriod p := fun hp => hne (Nat.dvd_antisymm hdvd ((isPeriod_iff p).mp hp))

end Mirror.CRTPeriod
