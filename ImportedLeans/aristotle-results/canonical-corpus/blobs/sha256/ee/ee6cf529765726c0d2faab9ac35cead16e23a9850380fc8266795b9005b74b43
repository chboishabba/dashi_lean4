-- CommRing extension

    module _
      (⋆Comm : {k l : ℕ} → (a : G k) → (b : G l) →
               _≡_ {A = Σ[ k ∈ ℕ ] G k} ((k +n l) , (a ⋆ b)) ((l +n k) , (b ⋆ a)))
      where

      open ExtensionCommRing ⋆Comm

