namespace Wikidata

namespace Sparql

/-- The name of a named graph. -/
abbrev GraphName := String

/-- An RDF dataset: statements, each labelled with the graph it was loaded into. -/
structure Dataset where
  /-- The entities of the dataset. -/
  entities : List Qid
  /-- The labelled statements. -/
  entries : List (GraphName × Statement)
  deriving Repr, Inhabited

namespace Dataset

/-- The whole dataset, read as one knowledge base. -/
def union (d : Dataset) : KB := ⟨d.entities, d.entries.map Prod.snd⟩

/-- One named graph, read as a knowledge base. -/
def graph (d : Dataset) (g : GraphName) : KB :=
  ⟨d.entities, (d.entries.filter (fun e => e.1 = g)).map Prod.snd⟩

@[simp] theorem union_statements (d : Dataset) :
    d.union.statements = d.entries.map Prod.snd := rfl

@[simp] theorem graph_statements (d : Dataset) (g : GraphName) :
    (d.graph g).statements = (d.entries.filter (fun e => e.1 = g)).map Prod.snd := rfl

theorem mem_graph_iff (d : Dataset) (g : GraphName) (st : Statement) :
    st ∈ (d.graph g).statements ↔ ∃ e ∈ d.entries, e.1 = g ∧ e.2 = st := by
  simp only [graph_statements, List.mem_map, List.mem_filter, decide_eq_true_eq]
  constructor
  · rintro ⟨e, ⟨he, hg⟩, hst⟩; exact ⟨e, he, hg, hst⟩
  · rintro ⟨e, he, hg, hst⟩; exact ⟨e, ⟨he, by simp [hg]⟩, hst⟩

theorem graph_subset_union (d : Dataset) (g : GraphName) :
    (d.graph g).statements ⊆ d.union.statements := by
  intro st hst
  rw [mem_graph_iff] at hst
  obtain ⟨e, he, _, hst⟩ := hst
  exact List.mem_map.2 ⟨e, he, hst⟩

/-! ## A named graph is a slice of the union -/

/-- The slice criterion of a graph name: the statements labelled with it. -/
def keep (d : Dataset) (g : GraphName) : StatementFilter :=
  fun st => d.entries.any (fun e => e.1 = g && e.2 == st)

/-- A dataset labels *functionally* when no statement is recorded in two graphs. -/
def Functional (d : Dataset) : Prop :=
  ∀ e ∈ d.entries, ∀ e' ∈ d.entries, e.2 = e'.2 → e.1 = e'.1

/-- **A named graph is a slice.**  A statement belongs to the named graph exactly
when it belongs to the slice of the union cut out by the label, so every result
about slices — composition, refinement, transfer of derived facts, preservation
of validity — applies to named graphs unchanged. -/
theorem mem_graph_iff_mem_restrict (d : Dataset) (g : GraphName) (st : Statement) :
    st ∈ (d.graph g).statements ↔ st ∈ (restrict d.union (d.keep g)).statements := by
  rw [mem_graph_iff, mem_restrict_iff]
  constructor
  · rintro ⟨e, he, hg, hst⟩
    refine ⟨List.mem_map.2 ⟨e, he, hst⟩, ?_⟩
    simp only [keep, List.any_eq_true]
    exact ⟨e, he, by simp [hg, hst]⟩
  · rintro ⟨_, hkeep⟩
    simp only [keep, List.any_eq_true, Bool.and_eq_true, decide_eq_true_eq, beq_iff_eq] at hkeep
    obtain ⟨e, he, hg, hst⟩ := hkeep
    exact ⟨e, he, hg, hst⟩

/-- On a functionally labelled dataset the two are the same knowledge base, not
merely the same statements: the slice keeps each labelled entry exactly once. -/
theorem graph_eq_restrict_of_functional {d : Dataset} (hf : Functional d) (g : GraphName) :
    d.graph g = restrict d.union (d.keep g) := by
  have hfilter : d.entries.filter (fun e => e.1 = g) =
      d.entries.filter (fun e => d.keep g e.2) := by
    refine List.filter_congr ?_
    intro e he
    by_cases hg : e.1 = g
    · have : d.keep g e.2 = true := by
        simp only [keep, List.any_eq_true]
        exact ⟨e, he, by simp [hg]⟩
      simp [hg, this]
    · have : d.keep g e.2 = false := by
        by_contra hcon
        simp only [keep, Bool.not_eq_false, List.any_eq_true, Bool.and_eq_true,
          decide_eq_true_eq, beq_iff_eq] at hcon
        obtain ⟨e', he', hg', hst'⟩ := hcon
        exact hg (by rw [hf e he e' he' hst'.symm, hg'])
      simp [hg, this]
  cases d with
  | mk ents entries =>
      simp only [graph, restrict, union, KB.mk.injEq, true_and]
      rw [List.filter_map]
      exact congrArg (List.map Prod.snd) hfilter

/-- Without functional labelling the two part company as *lists*: a statement
loaded into two graphs is kept twice by the slice and once by the named graph.
So the label is a property of the record, not of the statement. -/
theorem graph_ne_restrict_of_duplicate :
    let d : Dataset :=
      ⟨[⟨1⟩, ⟨2⟩],
       [("a", ⟨⟨1⟩, P279, ⟨2⟩, Rank.normal⟩), ("b", ⟨⟨1⟩, P279, ⟨2⟩, Rank.normal⟩)]⟩
    (d.graph "a").statements ≠ (restrict d.union (d.keep "a")).statements := by
  decide

/-! ## What a named graph derives, the dataset derives -/

theorem subclassOf_of_graph (d : Dataset) (g : GraphName) (hnormal : AllNormal d.union)
    {a b : Qid} (h : SubclassOf (d.graph g) a b) : SubclassOf d.union a b :=
  subclassOf_mono (graph_subset_union d g) hnormal h

theorem instanceOf_of_graph (d : Dataset) (g : GraphName) (hnormal : AllNormal d.union)
    {x c : Qid} (h : InstanceOf (d.graph g) x c) : InstanceOf d.union x c :=
  instanceOf_mono (graph_subset_union d g) hnormal h

/-- A path answer inside a named graph is a path answer over the dataset. -/
theorem holds_of_graph (d : Dataset) (g : GraphName) (hnormal : AllNormal d.union)
    (pa : Path) {x y : Qid} (h : Holds (d.graph g) pa x y) : Holds d.union pa x y :=
  holds_mono (graph_subset_union d g) hnormal pa h

end Dataset

/-! ## The union derives what no graph derives

Two sources, each contributing one edge of a subclass chain: `"a"` records that
`Q2` is a subclass of `Q3`, `"b"` that `Q3` is a subclass of `Q4`. -/

/-- The two-source dataset. -/
def twoSources : Dataset :=
  ⟨[⟨2⟩, ⟨3⟩, ⟨4⟩],
   [("a", ⟨⟨2⟩, P279, ⟨3⟩, Rank.normal⟩), ("b", ⟨⟨3⟩, P279, ⟨4⟩, Rank.normal⟩)]⟩

theorem twoSources_allNormal : AllNormal twoSources.union := by
  intro st hst
  simp only [Dataset.union_statements, twoSources, List.map_cons, List.map_nil,
    List.mem_cons, List.not_mem_nil, or_false] at hst
  rcases hst with h | h <;> subst h <;> rfl

/-- **A derived fact need not hold in any named graph.**  The union derives that
`Q2` is a subclass of `Q4`; neither source does, because each holds one edge of
the chain.  So a derived answer over a dataset is not attributable to a source:
what crossed the boundary between the graphs is the derivation, not a datum. -/
theorem derived_fact_need_not_hold_in_any_graph :
    SubclassOf twoSources.union ⟨2⟩ ⟨4⟩ ∧
      ¬ SubclassOf (twoSources.graph "a") ⟨2⟩ ⟨4⟩ ∧
      ¬ SubclassOf (twoSources.graph "b") ⟨2⟩ ⟨4⟩ := by
  refine ⟨(isSubclassOf_iff _ _ _).1 (by decide), ?_, ?_⟩
  · intro h
    exact absurd ((isSubclassOf_iff _ _ _).2 h) (by decide)
  · intro h
    exact absurd ((isSubclassOf_iff _ _ _).2 h) (by decide)

/-- The same statement at the level of the query: the property path `P279*`
answers over the dataset and over neither of the two named graphs. -/
theorem union_answer_is_not_a_graph_answer :
    Holds twoSources.union (Path.star (Step1.fwd P279)) ⟨2⟩ ⟨4⟩ ∧
      ¬ Holds (twoSources.graph "a") (Path.star (Step1.fwd P279)) ⟨2⟩ ⟨4⟩ ∧
      ¬ Holds (twoSources.graph "b") (Path.star (Step1.fwd P279)) ⟨2⟩ ⟨4⟩ := by
  refine ⟨by decide, by decide, by decide⟩

/-- Each named graph does derive its own edge, and the dataset agrees with it —
the transfer only fails in the direction that would attribute a derivation. -/
theorem graph_answer_transfers_up :
    Holds (twoSources.graph "a") (Path.one (Step1.fwd P279)) ⟨2⟩ ⟨3⟩ ∧
      Holds twoSources.union (Path.one (Step1.fwd P279)) ⟨2⟩ ⟨3⟩ := by
  refine ⟨by decide, ?_⟩
  exact Dataset.holds_of_graph twoSources "a" twoSources_allNormal
    (Path.one (Step1.fwd P279)) (by decide)

end Sparql

end Wikidata
