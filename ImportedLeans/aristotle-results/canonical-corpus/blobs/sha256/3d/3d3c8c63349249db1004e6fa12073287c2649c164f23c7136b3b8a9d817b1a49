module DASHI.Analysis.FastCauchyOrder where

open import Agda.Builtin.Nat using (Nat)
open import Agda.Builtin.Sigma using (Σ; _,_)
open import Data.Empty using (⊥)
open import Data.Nat.Base using (_≤_)

open import DASHI.Analysis.FastCauchyReals

------------------------------------------------------------------------
-- Constructive order cannot be decided from one approximation.  Strict order
-- carries one persistent positive gap; non-strict order permits every requested
-- dyadic tolerance after a common cutoff.

record StrictFastCauchyWitness
  {A : RationalMetricAuthority}
  (x y : FastCauchyReal A) : Set₁ where
  field
    precision : Nat
    cutoff : Nat
    separated : ∀ m n →
      cutoff ≤ m →
      cutoff ≤ n →
      _≤Q_ A
        (_+Q_ A (approximate x m) (dyadicError A precision))
        (approximate y n)

open StrictFastCauchyWitness public

_<R_ :
  ∀ {A : RationalMetricAuthority} →
  FastCauchyReal A → FastCauchyReal A → Set₁
x <R y = StrictFastCauchyWitness x y

_≤R_ :
  ∀ {A : RationalMetricAuthority} →
  FastCauchyReal A → FastCauchyReal A → Set
_≤R_ {A} x y =
  ∀ precision →
  Σ Nat
    (λ cutoff →
      ∀ m n →
      cutoff ≤ m →
      cutoff ≤ n →
      _≤Q_ A
        (approximate x m)
        (_+Q_ A (approximate y n) (dyadicError A precision)))

record FastCauchyOrderLaws
  (A : RationalMetricAuthority) : Set₁ where
  field
    lessIrreflexive : ∀ (x : FastCauchyReal A) → _<R_ {A} x x → ⊥
    lessTransitive : ∀ {x y z : FastCauchyReal A} → _<R_ {A} x y → _<R_ {A} y z → _<R_ {A} x z
    lessRespectsEquality : ∀ {x x′ y y′ : FastCauchyReal A} →
      _≈R_ {A} x x′ → _≈R_ {A} y y′ → _<R_ {A} x y → _<R_ {A} x′ y′

    lessEqualReflexive : ∀ (x : FastCauchyReal A) → _≤R_ {A} x x
    lessEqualTransitive : ∀ {x y z : FastCauchyReal A} → _≤R_ {A} x y → _≤R_ {A} y z → _≤R_ {A} x z
    lessEqualRespectsEquality : ∀ {x x′ y y′ : FastCauchyReal A} →
      _≈R_ {A} x x′ → _≈R_ {A} y y′ → _≤R_ {A} x y → _≤R_ {A} x′ y′

    strictImpliesNonStrict : ∀ {x y : FastCauchyReal A} → _<R_ {A} x y → _≤R_ {A} x y

open FastCauchyOrderLaws public

record ArchimedeanFastCauchyOrder
  (A : RationalMetricAuthority) : Set₁ where
  field
    embedNatural : Nat → FastCauchyReal A
    eventuallyAbove : ∀ (x : FastCauchyReal A) → Σ Nat (λ n → _<R_ {A} x (embedNatural n))

    DyadicBelowWitnessGap : ∀ {x y : FastCauchyReal A} → _<R_ {A} x y → Nat → Set
    dyadicEventuallyBelowGap : ∀ {x y : FastCauchyReal A} (w : _<R_ {A} x y) →
      Σ Nat (λ n → DyadicBelowWitnessGap w n)

open ArchimedeanFastCauchyOrder public
