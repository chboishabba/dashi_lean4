  makeIsGroupHom λ x y
    → IsGroupHom.pres· (snd (Hom/ {G' = G'} {H' = H'}
        (GroupIso→GroupHom ϕ) ϕ')) x y

Hom/ImIso : ∀ {ℓ ℓ'} {G H : Group ℓ'} (ϕ : GroupHom G H)
                     {G' H' : Group ℓ} (ψ : GroupHom G' H')
