        where
        pp : (a : _)
          → EM→ΩEM+1 (suc (suc (n + m)))
              (ind (suc m) (EM-raw→EM G' (suc n) a) .fst (snd (EM∙ H' (suc m))))
          ≡ refl
        pp a = cong (EM→ΩEM+1 (suc (suc (n + m)))) (ind (suc m) (EM-raw→EM G' (suc n) a) .snd)
