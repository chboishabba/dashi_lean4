    evolve0 : State → State
    coarse0 : State → State
    observe0 : State → Observable
    invariant0 :
      ∀ x →
      admissible0 x →
      observe0 (coarse0 (evolve0 x)) ≡ observe0 (evolve0 (coarse0 x))

