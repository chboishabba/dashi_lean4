/-! ## Provenance helpers -/

/-- Provenance for a surface that lives in the tracked tree, mirrored into Lean,
with no Agda checker result. -/
def tracked (path : String) (ancestry : List String) (boundary : String) : Provenance where
  modulePath := path
  prRef := none
  ancestry := ancestry
  surface := .agdaMirror
  agda := .agdaNotChecked
  lean := .leanBuilt
  claimBoundary := boundary

/-- Provenance for Lean text *about* an Agda surface that it does not
transcribe (a finite model, say). -/
def about (path : String) (ancestry : List String) (boundary : String) : Provenance where
  modulePath := path
  prRef := none
  ancestry := ancestry
  surface := .leanAboutAgda
  agda := .agdaNotChecked
  lean := .leanBuilt
  claimBoundary := boundary

