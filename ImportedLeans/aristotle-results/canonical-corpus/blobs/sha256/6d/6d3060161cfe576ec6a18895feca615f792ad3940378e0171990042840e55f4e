    baseRetinalYield : RetinalSignal surface
    perturbedRetinalYield : RetinalSignal surface

    fieldAngleChanged :
      angleDistinguishable surface
        rfBaseField
        rfPerturbedField
        rfBaseAngle
        rfPerturbedAngle

