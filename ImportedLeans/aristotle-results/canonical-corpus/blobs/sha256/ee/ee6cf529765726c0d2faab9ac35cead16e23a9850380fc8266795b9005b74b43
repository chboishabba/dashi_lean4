-- Ring morphism

  Poly1→Poly:-pres1 : Poly1→Poly: (1r PAstr) ≡ 1r PA:str
  Poly1→Poly:-pres1 = refl

  trad-base-prod : (v v' : Vec ℕ 1) → (a a' : A) → trad-base (v +n-vec v') (Astr ._·_ a a') ≡
