module DASHI.Physics.YangMills.BalabanYM4FiveChannelQuarticBetaAdapterExact where

------------------------------------------------------------------------
-- PRIMARY SOURCES
--
-- Tadeusz Bałaban,
-- "Renormalization Group Approach to Lattice Gauge Field Theories. I.",
-- Communications in Mathematical Physics 109 (1987), 249--301.
-- DOI: 10.1007/BF01215223.
--
-- Tadeusz Bałaban,
-- "Renormalization Group Approach to Lattice Gauge Field Theories. II.
-- Cluster Expansions", Communications in Mathematical Physics 116 (1988),
-- 1--22. DOI: 10.1007/BF01239022.
--
-- Tadeusz Bałaban,
-- "Convergent Renormalization Expansions for Lattice Gauge Field Theories",
-- Communications in Mathematical Physics 119 (1988), 243--285.
-- DOI: 10.1007/BF01217741.
--
-- DASHI CONTRIBUTION
--
-- Tie the repository's five physical H-R_beta channels directly to the finite
-- quartic beta enclosure consumed by the source-normalized coupling history.
-- The five channels are determinant, interaction, chart, gauge and
-- localization.  A physical proof now only has to establish, cell-by-cell,
--
--     - c_{cell,channel} g^4 <= r_{cell,channel},
--     0 <= c_{cell,channel}.
--
-- This module constructs the finite interaction atom family itself and proves
-- that its betaInt is definitionally the nested physical five-channel sum.
------------------------------------------------------------------------

open import Agda.Builtin.Equality using (_≡_; refl)
open import Agda.Builtin.List using (List; []; _∷_)
open import Data.Rational.Base as ℚ using (ℚ; 0ℚ; _+_; -_; _*_; _≤_)
import Data.Rational.Properties as ℚP
import Data.Rational.Tactic.RingSolver as ℚRing
open import Relation.Binary.PropositionalEquality using (cong; trans; subst)

open import DASHI.Physics.YangMills.CompactLieProofLevel
import DASHI.Physics.YangMills.BalabanPhysicalBlockFibreSumsExact as Sums
import DASHI.Physics.YangMills.BalabanYM4FiniteModeBetaLowerRemainderExact as Beta

dataSet PhysicalBetaChannel : Set where
  determinant interaction chart gauge localization : PhysicalBetaChannel

channels : List PhysicalBetaChannel
channels = determinant ∷ interaction ∷ chart ∷ gauge ∷ localization ∷ []

record FiveChannelQuarticBetaData (Cell : Set) : Set₁ where
  field
    cells : List Cell
    coupling : ℚ

    determinantRemainder interactionRemainder chartRemainder
      gaugeRemainder localizationRemainder : Cell → ℚ

    determinantCoefficient interactionCoefficient chartCoefficient
      gaugeCoefficient localizationCoefficient : Cell → ℚ

    determinantCoefficientNN : ∀ cell → 0ℚ ≤ determinantCoefficient cell
    interactionCoefficientNN : ∀ cell → 0ℚ ≤ interactionCoefficient cell
    chartCoefficientNN : ∀ cell → 0ℚ ≤ chartCoefficient cell
    gaugeCoefficientNN : ∀ cell → 0ℚ ≤ gaugeCoefficient cell
    localizationCoefficientNN : ∀ cell → 0ℚ ≤ localizationCoefficient cell

    determinantLower : ∀ cell →
      - (determinantCoefficient cell * Beta.power4 coupling)
      ≤ determinantRemainder cell
    interactionLower : ∀ cell →
      - (interactionCoefficient cell * Beta.power4 coupling)
      ≤ interactionRemainder cell
    chartLower : ∀ cell →
      - (chartCoefficient cell * Beta.power4 coupling)
      ≤ chartRemainder cell
    gaugeLower : ∀ cell →
      - (gaugeCoefficient cell * Beta.power4 coupling)
      ≤ gaugeRemainder cell
    localizationLower : ∀ cell →
      - (localizationCoefficient cell * Beta.power4 coupling)
      ≤ localizationRemainder cell

open FiveChannelQuarticBetaData public

channelRemainder :
  ∀ {Cell} → FiveChannelQuarticBetaData Cell →
  Cell → PhysicalBetaChannel → ℚ
channelRemainder dataSet cell determinant = determinantRemainder dataSet cell
channelRemainder dataSet cell interaction = interactionRemainder dataSet cell
channelRemainder dataSet cell chart = chartRemainder dataSet cell
channelRemainder dataSet cell gauge = gaugeRemainder dataSet cell
channelRemainder dataSet cell localization = localizationRemainder dataSet cell

channelCoefficient :
  ∀ {Cell} → FiveChannelQuarticBetaData Cell →
  Cell → PhysicalBetaChannel → ℚ
channelCoefficient dataSet cell determinant = determinantCoefficient dataSet cell
channelCoefficient dataSet cell interaction = interactionCoefficient dataSet cell
channelCoefficient dataSet cell chart = chartCoefficient dataSet cell
channelCoefficient dataSet cell gauge = gaugeCoefficient dataSet cell
channelCoefficient dataSet cell localization = localizationCoefficient dataSet cell

channelCoefficientNN :
  ∀ {Cell} (dataSet : FiveChannelQuarticBetaData Cell) cell channel →
  0ℚ ≤ channelCoefficient dataSet cell channel
channelCoefficientNN dataSet cell determinant = determinantCoefficientNN dataSet cell
channelCoefficientNN dataSet cell interaction = interactionCoefficientNN dataSet cell
channelCoefficientNN dataSet cell chart = chartCoefficientNN dataSet cell
channelCoefficientNN dataSet cell gauge = gaugeCoefficientNN dataSet cell
channelCoefficientNN dataSet cell localization = localizationCoefficientNN dataSet cell

channelLower :
  ∀ {Cell} (dataSet : FiveChannelQuarticBetaData Cell) cell channel →
  - (channelCoefficient dataSet cell channel * Beta.power4 (coupling dataSet))
  ≤ channelRemainder dataSet cell channel
channelLower dataSet cell determinant = determinantLower dataSet cell
channelLower dataSet cell interaction = interactionLower dataSet cell
channelLower dataSet cell chart = chartLower dataSet cell
channelLower dataSet cell gauge = gaugeLower dataSet cell
channelLower dataSet cell localization = localizationLower dataSet cell

localRemainder :
  ∀ {Cell} → FiveChannelQuarticBetaData Cell → Cell → ℚ
localRemainder dataSet cell =
  Sums.sumRational channels (channelRemainder dataSet cell)

localCoefficient :
  ∀ {Cell} → FiveChannelQuarticBetaData Cell → Cell → ℚ
localCoefficient dataSet cell =
  Sums.sumRational channels (channelCoefficient dataSet cell)

betaInt : ∀ {Cell} → FiveChannelQuarticBetaData Cell → ℚ
betaInt dataSet = Sums.sumRational (cells dataSet) (localRemainder dataSet)

coefficientTotal : ∀ {Cell} → FiveChannelQuarticBetaData Cell → ℚ
coefficientTotal dataSet = Sums.sumRational (cells dataSet) (localCoefficient dataSet)

sumNonnegative :
  ∀ {A : Set} (indices : List A) (value : A → ℚ) →
  (∀ index → 0ℚ ≤ value index) →
  0ℚ ≤ Sums.sumRational indices value
sumNonnegative [] value pointwise = ℚP.≤-refl
sumNonnegative (x ∷ xs) value pointwise =
  ℚP.+-mono-≤ (pointwise x) (sumNonnegative xs value pointwise)

localCoefficientNN :
  ∀ {Cell} (dataSet : FiveChannelQuarticBetaData Cell) cell →
  0ℚ ≤ localCoefficient dataSet cell
localCoefficientNN dataSet cell =
  sumNonnegative channels (channelCoefficient dataSet cell)
    (channelCoefficientNN dataSet cell)

coefficientTotalNN :
  ∀ {Cell} (dataSet : FiveChannelQuarticBetaData Cell) →
  0ℚ ≤ coefficientTotal dataSet
coefficientTotalNN dataSet =
  sumNonnegative (cells dataSet) (localCoefficient dataSet)
    (localCoefficientNN dataSet)

localQuarticLower :
  ∀ {Cell} (dataSet : FiveChannelQuarticBetaData Cell) cell →
  - (localCoefficient dataSet cell * Beta.power4 (coupling dataSet))
  ≤ localRemainder dataSet cell
localQuarticLower dataSet cell =
  let
    fourth = Beta.power4 (coupling dataSet)
    pointwiseSum :
      Sums.sumRational channels
        (λ channel → - (channelCoefficient dataSet cell channel * fourth))
      ≤ localRemainder dataSet cell
    pointwiseSum = Beta.sumMonotone
      channels
      (λ channel → - (channelCoefficient dataSet cell channel * fourth))
      (channelRemainder dataSet cell)
      (channelLower dataSet cell)

    identify :
      Sums.sumRational channels
        (λ channel → - (channelCoefficient dataSet cell channel * fourth))
      ≡ - (localCoefficient dataSet cell * fourth)
    identify = trans
      (Sums.sumRationalNegate channels
        (λ channel → channelCoefficient dataSet cell channel * fourth))
      (cong -_
        (trans
          (Sums.sumRationalCong channels
            (λ channel → channelCoefficient dataSet cell channel * fourth)
            (λ channel → fourth * channelCoefficient dataSet cell channel)
            (λ channel → ℚRing.solve-∀
              (channelCoefficient dataSet cell channel) fourth))
          (trans
            (Sums.sumRationalScale fourth channels
              (channelCoefficient dataSet cell))
            (ℚRing.solve-∀ fourth (localCoefficient dataSet cell)))))
  in
  subst (λ lower → lower ≤ localRemainder dataSet cell)
    identify pointwiseSum

globalQuarticLower :
  ∀ {Cell} (dataSet : FiveChannelQuarticBetaData Cell) →
  - (coefficientTotal dataSet * Beta.power4 (coupling dataSet))
  ≤ betaInt dataSet
globalQuarticLower dataSet =
  let
    fourth = Beta.power4 (coupling dataSet)
    pointwiseSum :
      Sums.sumRational (cells dataSet)
        (λ cell → - (localCoefficient dataSet cell * fourth))
      ≤ betaInt dataSet
    pointwiseSum = Beta.sumMonotone
      (cells dataSet)
      (λ cell → - (localCoefficient dataSet cell * fourth))
      (localRemainder dataSet)
      (localQuarticLower dataSet)

    identify :
      Sums.sumRational (cells dataSet)
        (λ cell → - (localCoefficient dataSet cell * fourth))
      ≡ - (coefficientTotal dataSet * fourth)
    identify = trans
      (Sums.sumRationalNegate (cells dataSet)
        (λ cell → localCoefficient dataSet cell * fourth))
      (cong -_
        (trans
          (Sums.sumRationalCong (cells dataSet)
            (λ cell → localCoefficient dataSet cell * fourth)
            (λ cell → fourth * localCoefficient dataSet cell)
            (λ cell → ℚRing.solve-∀ (localCoefficient dataSet cell) fourth))
          (trans
            (Sums.sumRationalScale fourth (cells dataSet) (localCoefficient dataSet))
            (ℚRing.solve-∀ fourth (coefficientTotal dataSet)))))
  in
  subst (λ lower → lower ≤ betaInt dataSet)
    identify pointwiseSum

asFiniteInteractionAtomEnclosure :
  ∀ {Cell} (dataSet : FiveChannelQuarticBetaData Cell) →
  Beta.FiniteInteractionAtomEnclosure Cell
asFiniteInteractionAtomEnclosure dataSet = record
  { Beta.FiniteInteractionAtomEnclosure.atoms = cells dataSet
  ; Beta.FiniteInteractionAtomEnclosure.coupling = coupling dataSet
  ; Beta.FiniteInteractionAtomEnclosure.betaInt = betaInt dataSet
  ; Beta.FiniteInteractionAtomEnclosure.interactionAtom = localRemainder dataSet
  ; Beta.FiniteInteractionAtomEnclosure.coefficient = localCoefficient dataSet
  ; Beta.FiniteInteractionAtomEnclosure.betaIntExact = refl
  ; Beta.FiniteInteractionAtomEnclosure.coefficientNonnegative = localCoefficientNN dataSet
  ; Beta.FiniteInteractionAtomEnclosure.atomLower = localQuarticLower dataSet
  }

yM4FiveChannelQuarticBetaAdapterLevel : ProofLevel
yM4FiveChannelQuarticBetaAdapterLevel = machineChecked

yM4FiveChannelPhysicalEstimatesLevel : ProofLevel
yM4FiveChannelPhysicalEstimatesLevel = conditional
