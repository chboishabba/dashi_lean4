    L-residual : Carrier → Nat
    H-baseline : Carrier → Nat
    PE         : Carrier → Nat

    postEntropyLaw :
      ∀ x → PE x + H-baseline x ≡ L-model (π x) + L-residual x

    Step : Carrier → Carrier
    L    : Carrier → Nat

    Admissible    : Set
    Stable        : Set
    ReceiptBound  : Set
    MDLDescending : Set

    mdlDescendingLaw :
      MDLDescending → ∀ x → L (Step x) ≤ L x

    PostEntropyAttractor : Basin → Set

    attractorWitness :
      Admissible →
      Stable →
      ReceiptBound →
      MDLDescending →
      Σ Basin PostEntropyAttractor

