  SES.EncoderState.hamiltonianState
    (SES.stateOf
      (Payload.BrainCodecPayloadRecoveryProfile.sourcePayload
        (codecPayloadRecoveryProfileOf st)))
consumerHamiltonianChecksumCanonical st = refl

