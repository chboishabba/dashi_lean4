import RequestProject.FrobeniusGalois

/-!
# Every endomorphism of a finite field is a Frobenius iterate

`FrobeniusGalois.lean` showed that the `n` Frobenius iterates `x ↦ x ^ (p ^ k)`, `k < n`, of a
field `K` with `p ^ n` elements are pairwise distinct and that the Frobenius automorphism has
order exactly `n`.  This file closes the circle: there are *no other* endomorphisms.

* `exists_pow_pow_char_eq_of_ringHom` : every ring homomorphism `σ : K →+* K` is `x ↦ x ^ (p ^ k)`
  for some `k < n`, and (`exists_unique_pow_pow_char_eq_of_ringHom`) this `k` is unique;
* `ringEquiv_eq_frobeniusEquiv_pow` : every ring automorphism of `K` is a power of the Frobenius
  automorphism, so `zpowers_frobeniusEquiv_eq_top` : the automorphism group is generated by
  Frobenius;
* `isCyclic_ringAut` and `card_ringAut` : **the automorphism group of a field with `p ^ n`
  elements is cyclic of order exactly `n`, generated by the Frobenius** — the Galois
  correspondence of `SubfieldLattice.lean` is thus the divisor lattice of `n`.
-/

open FiniteField

namespace FrobeniusPrimeSubfield

variable {K : Type*} [Field K] {p : ℕ} [hp : Fact p.Prime] [CharP K p] [Fintype K] {n : ℕ}

/-- **Every ring endomorphism of a finite field with `p ^ n` elements is a Frobenius iterate.**
(A ring homomorphism of a finite field is automatically bijective and fixes the prime subfield,
so it is an element of the Galois group of `K` over `𝔽_p`.) -/
theorem exists_pow_pow_char_eq_of_ringHom (hK : Nat.card K = p ^ n) (σ : K →+* K) :
    ∃ k < n, ∀ x : K, σ x = x ^ p ^ k := by
  letI : Algebra (ZMod p) K := ZMod.algebra K p
  have hcardZ : Fintype.card (ZMod p) = p := ZMod.card p
  have hfr : Module.finrank (ZMod p) K = n := by
    have h := Module.card_eq_pow_finrank (K := ZMod p) (V := K)
    rw [hcardZ, ← Nat.card_eq_fintype_card, hK] at h
    exact (Nat.pow_right_injective hp.out.two_le h).symm
  have hcomm : ∀ r : ZMod p, σ (algebraMap (ZMod p) K r) = algebraMap (ZMod p) K r := fun r =>
    RingHom.congr_fun (Subsingleton.elim (σ.comp (algebraMap (ZMod p) K))
      (algebraMap (ZMod p) K)) r
  let f : K →ₐ[ZMod p] K := { σ with commutes' := hcomm }
  have hbij : Function.Bijective f := (Finite.injective_iff_bijective).1 f.toRingHom.injective
  let e : K ≃ₐ[ZMod p] K := AlgEquiv.ofBijective f hbij
  obtain ⟨k, hk⟩ := (bijective_frobeniusAlgEquivOfAlgebraic_pow (ZMod p) K).2 e
  refine ⟨(k : ℕ), by simpa [hfr] using k.2, fun x => ?_⟩
  have hx : (frobeniusAlgEquivOfAlgebraic (ZMod p) K ^ (k : ℕ)) x = e x := by
    rw [show (frobeniusAlgEquivOfAlgebraic (ZMod p) K ^ (k : ℕ)) = e from hk]
  rw [AlgEquiv.coe_pow, coe_frobeniusAlgEquivOfAlgebraic_iterate, hcardZ] at hx
  exact hx.symm

/-- The exponent `k < n` representing an endomorphism as a Frobenius iterate is unique. -/
theorem exists_unique_pow_pow_char_eq_of_ringHom (hK : Nat.card K = p ^ n) (hn : n ≠ 0)
    (σ : K →+* K) : ∃! k, k < n ∧ ∀ x : K, σ x = x ^ p ^ k := by
  obtain ⟨k, hkn, hk⟩ := exists_pow_pow_char_eq_of_ringHom hK σ
  refine ⟨k, ⟨hkn, hk⟩, ?_⟩
  rintro j ⟨hjn, hj⟩
  by_contra hne
  have hall : ∀ x : K, x ^ p ^ j = x ^ p ^ k := fun x => by rw [← hj x, hk x]
  rcases lt_or_gt_of_ne hne with h | h
  · obtain ⟨x, hx⟩ := exists_pow_pow_char_ne hK hn h hkn
    exact hx (hall x)
  · obtain ⟨x, hx⟩ := exists_pow_pow_char_ne hK hn h hjn
    exact hx (hall x).symm

/-- **Every automorphism of a finite field is a power of the Frobenius automorphism.** -/
theorem ringEquiv_eq_frobeniusEquiv_pow (hK : Nat.card K = p ^ n) (e : K ≃+* K) :
    ∃ k < n, e = frobeniusEquiv K p ^ k := by
  obtain ⟨k, hkn, hk⟩ := exists_pow_pow_char_eq_of_ringHom hK (e : K →+* K)
  exact ⟨k, hkn, RingEquiv.ext fun x => by rw [frobeniusEquiv_pow_apply]; exact hk x⟩

/-- The automorphism group of a finite field is generated by the Frobenius automorphism. -/
theorem zpowers_frobeniusEquiv_eq_top (hK : Nat.card K = p ^ n) :
    Subgroup.zpowers (frobeniusEquiv K p) = ⊤ := by
  refine eq_top_iff.2 fun e _ => ?_
  obtain ⟨k, -, rfl⟩ := ringEquiv_eq_frobeniusEquiv_pow hK e
  exact ⟨(k : ℤ), by simp⟩

/-- The automorphism group of a finite field is cyclic. -/
theorem isCyclic_ringAut (hK : Nat.card K = p ^ n) : IsCyclic (K ≃+* K) :=
  ⟨⟨frobeniusEquiv K p, fun e => by
    obtain ⟨k, -, rfl⟩ := ringEquiv_eq_frobeniusEquiv_pow hK e
    exact ⟨(k : ℤ), by simp⟩⟩⟩

/-- **The automorphism group of a field with `p ^ n` elements has exactly `n` elements**, and is
cyclic, generated by the Frobenius. -/
theorem card_ringAut (hK : Nat.card K = p ^ n) (hn : n ≠ 0) : Nat.card (K ≃+* K) = n := by
  have h1 : Nat.card (Subgroup.zpowers (frobeniusEquiv K p)) = n := by
    rw [Nat.card_zpowers, orderOf_frobeniusEquiv hK hn]
  rw [zpowers_frobeniusEquiv_eq_top hK] at h1
  rwa [Nat.card_congr (Subgroup.topEquiv.toEquiv).symm]

end FrobeniusPrimeSubfield
