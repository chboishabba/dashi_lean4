                ∙ sym (rUnit refl))
              ∙ sym (rUnit refl) ))
        (cong₃ _∙∙_∙∙_ refl refl
          (sym (lUnit _) ∙ ∙∙lCancel _))
          ∙ cong₃ _∙∙_∙∙_ refl refl (sym (rUnit refl))
          ∙ sym (rUnit refl)
         where
