def nativeGenerator0 : Matrix (Fin 27) (Fin 27) ℚ :=
  sourceToNative * sourceGenerator0 * nativeToSource
def nativeGenerator1 : Matrix (Fin 27) (Fin 27) ℚ :=
  sourceToNative * sourceGenerator1 * nativeToSource
def nativeGenerator2 : Matrix (Fin 27) (Fin 27) ℚ :=
  sourceToNative * sourceGenerator2 * nativeToSource

theorem source_generator_orders :
    sourceGenerator0 ^ 3 = 1 ∧
    sourceGenerator1 ^ 3 = 1 ∧
    sourceGenerator2 ^ 3 = 1 := by native_decide

theorem source_generators_commute :
    sourceGenerator0 * sourceGenerator1 = sourceGenerator1 * sourceGenerator0 ∧
    sourceGenerator0 * sourceGenerator2 = sourceGenerator2 * sourceGenerator0 ∧
    sourceGenerator1 * sourceGenerator2 = sourceGenerator2 * sourceGenerator1 := by
  native_decide

theorem native_generator_orders :
    nativeGenerator0 ^ 3 = 1 ∧ nativeGenerator1 ^ 3 = 1 ∧
    nativeGenerator2 ^ 3 = 1 := by native_decide

theorem native_generator_gram :
    nativeGenerator0.transpose * nativeTraceGram * nativeGenerator0 = nativeTraceGram ∧
    nativeGenerator1.transpose * nativeTraceGram * nativeGenerator1 = nativeTraceGram ∧
    nativeGenerator2.transpose * nativeTraceGram * nativeGenerator2 = nativeTraceGram := by
  native_decide

theorem native_generator_unit :
    (∀ i, applyWitness nativeGenerator0 nativeOne i = nativeOne i) ∧
    (∀ i, applyWitness nativeGenerator1 nativeOne i = nativeOne i) ∧
    (∀ i, applyWitness nativeGenerator2 nativeOne i = nativeOne i) := by
  native_decide

def nativeCoordinates (x : RationalAlbertNative.RationalAlbert) : Fin 27 → ℚ :=
  ![
    x.diagonal0, x.diagonal1, x.diagonal2,
    x.off12.first.q0, x.off12.first.q1, x.off12.first.q2, x.off12.first.q3,
    x.off12.second.q0, x.off12.second.q1, x.off12.second.q2, x.off12.second.q3,
    x.off20.first.q0, x.off20.first.q1, x.off20.first.q2, x.off20.first.q3,
    x.off20.second.q0, x.off20.second.q1, x.off20.second.q2, x.off20.second.q3,
    x.off01.first.q0, x.off01.first.q1, x.off01.first.q2, x.off01.first.q3,
    x.off01.second.q0, x.off01.second.q1, x.off01.second.q2, x.off01.second.q3
  ]
def asNative (x : Fin 27 → ℚ) : RationalAlbertNative.RationalAlbert := toNative x

/-- Native algebra generator 0: verify 729 genuine Jordan basis products.
The action is transported FROM Griess's source grading rather than selected
from an arbitrary 27D rotation or cube graph. -/
theorem generator0_jordan_basis :
    ∀ a b : Fin 27,
      asNative (applyWitness nativeGenerator0
        (nativeCoordinates
          (RationalAlbertNative.RationalAlbert.jordanProduct
            (sourceBasisInNative a) (sourceBasisInNative b)))) =
      RationalAlbertNative.RationalAlbert.jordanProduct
        (asNative (applyWitness nativeGenerator0 (nativeCoordinates (sourceBasisInNative a))))
        (asNative (applyWitness nativeGenerator0 (nativeCoordinates (sourceBasisInNative b)))) := by
  native_decide
