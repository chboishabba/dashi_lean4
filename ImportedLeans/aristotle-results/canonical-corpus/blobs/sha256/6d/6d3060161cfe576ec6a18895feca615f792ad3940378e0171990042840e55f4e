max : Nat → Nat → Nat
max zero    n       = n
max (suc m) zero    = suc m
max (suc m) (suc n) = suc (max m n)

_⊔v_ : EV → EV → EV
_⊔v_ = zipWith max

sumEV : EV → Nat
