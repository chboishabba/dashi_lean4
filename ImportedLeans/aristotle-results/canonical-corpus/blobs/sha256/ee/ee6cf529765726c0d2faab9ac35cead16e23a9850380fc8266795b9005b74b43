summaryRepresentative6x3 : Summary.BrainSummaryPacketView → DNA6x3
summaryRepresentative6x3 view =
  let line = summaryRepresentative3 view in
  line ∷ line ∷ line ∷ line ∷ line ∷ line ∷ []

