-/

namespace Wikidata

namespace Polarity

open Epistemic Wikidata.Example

/-! ## Claims read against a knowledge base -/

/-- A claim together with the knowledge base it is read against. -/
abbrev ScopedClaim := KB × ClassClaim

/-- A scoped claim holds when its claim holds in its knowledge base. -/
def scopedHolds : Interpretation ScopedClaim := fun p => p.2.Holds p.1

/-! ## The converse of a subclass claim -/

/-- The converse of a subclass claim; other claims are left alone. -/
def converseClaim : ClassClaim → ClassClaim
  | .subclass a b => .subclass b a
  | cl => cl

/-- The converse of a scoped subclass claim, declared as an orientation
reversal. -/
def converseOpposition (kb : KB) (a b : Qid) : Opposition ScopedClaim :=
  ⟨(kb, .subclass a b), fun p => (p.1, converseClaim p.2),
    OperatorRole.orientationReversal, (kb, .subclass b a), rfl⟩

theorem painter_subclass_painter : SubclassOf artistKB painter painter :=
  (isSubclassOf_iff artistKB painter painter).1 (by decide)

/-- For `Q1028181 ⊑ Q483501` the converse really does fail, so *for this pair*
the converse opposition happens to be a negation. -/
theorem converse_opposes_painter_artist :
    Opposes scopedHolds (converseOpposition artistKB painter artist) := by
  constructor
  · intro h
    exact absurd ((isSubclassOf_iff artistKB artist painter).2 h) (by decide)
  · intro h
    exact absurd painter_subclass_artist h

/-- For a reflexive claim it plainly is not: a class is a subclass of itself in
both directions. -/
theorem converse_not_opposes_reflexive :
    ¬ Opposes scopedHolds (converseOpposition artistKB painter painter) := by
  intro h
  exact h.1 painter_subclass_painter painter_subclass_painter

-- @source DASHI Agda bridge (PR #555/#581/#582): the polarity discipline on an ontology surface
/-- **The orientation-reversal tag decides nothing.**  Two subclass claims carry
the same declared opposition, and only one of them has a converse that is its
negation, so no reading of the tag can license a refutation. -/
theorem converse_opposition_not_uniform :
    (converseOpposition artistKB painter artist).role
        = (converseOpposition artistKB painter painter).role ∧
      Opposes scopedHolds (converseOpposition artistKB painter artist) ∧
      ¬ Opposes scopedHolds (converseOpposition artistKB painter painter) :=
  ⟨rfl, converse_opposes_painter_artist, converse_not_opposes_reflexive⟩

/-! ## Reading the same claim against another knowledge base -/

-- @source DASHI Agda bridge (PR #555/#581/#582): the polarity discipline on an ontology surface
/-- The same claim, read against a second knowledge base: a contextual
counterposition. -/
def counterposition (kb kb' : KB) (cl : ClassClaim) : Opposition ScopedClaim :=
  ⟨(kb, cl), fun p => (kb', p.2), OperatorRole.contextualCounterposition, (kb', cl), rfl⟩

theorem sculptor_subclass_artist_partial : SubclassOf partialKB sculptor artist :=
  (isSubclassOf_iff partialKB sculptor artist).1 (by decide)

theorem sculptor_subclass_artist_full : SubclassOf artistKB sculptor artist :=
  (isSubclassOf_iff artistKB sculptor artist).1 (by decide)

-- @source DASHI Agda bridge (PR #555/#581/#582): the polarity discipline on an ontology surface
/-- **A second knowledge base is not a negation.**  `Q1281618 ⊑ Q483501` holds
in both bases, so the counterposed reading is not the failure of the base
reading. -/
theorem counterposition_not_opposes :
    ¬ Opposes scopedHolds (counterposition artistKB partialKB (.subclass sculptor artist)) := by
  intro h
  exact h.1 sculptor_subclass_artist_partial sculptor_subclass_artist_full

-- @source DASHI Agda bridge (PR #555/#581/#582): the polarity discipline on an ontology surface
/-- **Pooling the two readings manufactures a conflict.**  Each report is sound
about its own knowledge base — the claim really does hold in both — and the
merged square nevertheless lands in the conflict corner. -/
theorem crossBase_pool_manufactures_conflict :
    ∃ e f : FibreEvidence ScopedClaim Unit
        (counterposition artistKB partialKB (.subclass sculptor artist)) (),
      e.Sound scopedHolds ∧ f.Sound scopedHolds ∧
      classify (SupportSquare.merge e.square f.square) = Corner.bothSupported := by
  refine ⟨⟨⟨true, false⟩, []⟩, ⟨⟨false, true⟩, []⟩, ⟨?_, ?_⟩, ⟨?_, ?_⟩, rfl⟩
  · intro _; exact sculptor_subclass_artist_full
  · intro h; exact absurd h (by simp [FibreEvidence.supportsOpposing])
  · intro h; exact absurd h (by simp [FibreEvidence.supportsBase])
  · intro _; exact sculptor_subclass_artist_partial

-- @source DASHI Agda bridge (PR #555/#581/#582): the polarity discipline on an ontology surface
/-- **The closed-world square is unsound.**  `Q1028181 ⊑ Q483501` fails in
`partialKB`, and recording that failure as counter-support claims something the
counterposed reading does not support. -/
theorem closedWorld_counterSupport_unsound :
    ¬ (FibreEvidence.Sound (Ctx := Unit)
        (o := counterposition artistKB partialKB (.subclass painter artist)) (c := ())
        scopedHolds ⟨⟨false, true⟩, []⟩) := by
  rintro ⟨-, hopp⟩
  have hholds : SubclassOf partialKB painter artist := hopp rfl
  exact absurd ((isSubclassOf_iff partialKB painter artist).2 hholds) (by decide)

-- @source DASHI Agda bridge (PR #555/#581/#582): the polarity discipline on an ontology surface
/-- **Recording the absence as silence is sound, and pools to affirmation.**
The open-world reading of the same pair of sources reaches `positionOnly`, not
the conflict corner. -/
theorem openWorld_pool_is_affirmation :
    ∃ e f : FibreEvidence ScopedClaim Unit
        (counterposition artistKB partialKB (.subclass painter artist)) (),
      e.Sound scopedHolds ∧ f.Sound scopedHolds ∧
      classify (SupportSquare.merge e.square f.square) = Corner.positionOnly := by
  refine ⟨⟨⟨true, false⟩, []⟩, ⟨SupportSquare.empty, []⟩, ⟨?_, ?_⟩, ⟨?_, ?_⟩, rfl⟩
  · intro _; exact painter_subclass_artist
  · intro h; exact absurd h (by simp [FibreEvidence.supportsOpposing])
  · intro h; exact absurd h (by simp [FibreEvidence.supportsBase, SupportSquare.empty])
  · intro h; exact absurd h (by simp [FibreEvidence.supportsOpposing, SupportSquare.empty])

/-! ## The axes an import has to resolve -/

/-- The axes a class-fact import is required to resolve. -/
inductive ImportAxis
  | classFact
  | constraint
  | provenance
  deriving DecidableEq, Repr, Inhabited

-- @source DASHI Agda bridge (PR #555/#581/#582): required axes on an import
/-- All three axes are required. -/
def requiredImportAxes : List ImportAxis :=
  [ImportAxis.classFact, ImportAxis.constraint, ImportAxis.provenance]

-- @source DASHI Agda bridge (PR #555/#581/#582): required axes on an import
/-- The `Q1028181 ⊑ Q483501` statement carries no reference in the worked
provenance record. -/
theorem painterArtist_has_no_references :
    artistProvenance.refs ⟨painter, P279, artist, Rank.normal⟩ = [] := by decide

/-- The evidence about importing `Q1028181 ⊑ Q483501`: the class fact is
affirmed by the exact checker, the constraint axis is affirmed, and the
provenance axis is silent because the statement has no reference. -/
def painterArtistAxes : AxisEvidenceFamily ImportAxis
  | .classFact => ⟨ClassClaim.check artistKB (.subclass painter artist), false⟩
  | .constraint => ⟨true, false⟩
  | .provenance => SupportSquare.empty

theorem classFact_axis_resolved : AxisResolved (painterArtistAxes .classFact) := by decide

/-- The class fact really does hold: the affirmative axis is backed. -/
theorem classFact_axis_backed : ClassClaim.Holds artistKB (.subclass painter artist) :=
  painter_subclass_artist

theorem painterArtist_axes_missing_provenance :
    MissingRequiredAxis requiredImportAxes painterArtistAxes ImportAxis.provenance :=
  ⟨by decide, by simp [painterArtistAxes, SupportSquare.empty]⟩

-- @source DASHI Agda bridge (PR #555/#581/#582): required axes on an import
/-- **The import is not resolved.**  Two of the three required axes are affirmed
and unconflicted — including the one backed by a proof — and the unreferenced
statement still leaves the import unresolved. -/
theorem painterArtist_import_not_resolved :
    ¬ RequiredAxesResolved requiredImportAxes painterArtistAxes :=
  not_resolved_of_missing painterArtist_axes_missing_provenance

end Polarity

end Wikidata
