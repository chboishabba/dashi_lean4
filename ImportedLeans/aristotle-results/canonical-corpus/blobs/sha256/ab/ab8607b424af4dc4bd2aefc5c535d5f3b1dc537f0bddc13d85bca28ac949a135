                                                    (λ i₁ → a (loop i₁) -K a base)
                                                    rP

         loop-helper2 : PathP (λ i → P.rUnitK _ (a base) i ≡ P.rUnitK _ (a base) i)
                       (cong (a base +K_) (Kn→ΩKn+1 1 (ΩKn+1→Kn 1 ((sym (P.rCancelK 2 (a base))
                             ∙ (λ i → a (loop i) -K (a (base)))
                             ∙ P.rCancelK 2 (a base))))))
