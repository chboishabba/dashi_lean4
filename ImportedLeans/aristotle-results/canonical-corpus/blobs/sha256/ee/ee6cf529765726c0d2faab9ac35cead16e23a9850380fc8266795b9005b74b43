    ℑ : ∀ {i} → 𝒰 i → 𝒰 i
    ℑ-unit : ∀ {i} {A : 𝒰 i} → A → ℑ A


  ℑ-unit-at :
    ∀ {i} → (A : 𝒰 i)
    → (A → ℑ A)
  ℑ-unit-at A = ℑ-unit {_} {A}

  ι : ∀ {i} {A : 𝒰 i}
    → A → ℑ A
  ι = ℑ-unit

  _is-coreduced : ∀ {i} → 𝒰 i → 𝒰 i
  A is-coreduced = ℑ-unit {_} {A} is-an-equivalence

  ℑ𝒰₀ : 𝒰₁
