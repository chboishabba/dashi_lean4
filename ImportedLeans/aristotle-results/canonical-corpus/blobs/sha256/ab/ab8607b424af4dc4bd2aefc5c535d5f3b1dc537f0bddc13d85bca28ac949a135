numerator0→0 (a , b) p = eq/ ((a , b)) ((0 , 1)) q
  where
  q : a ℤ.· (ℕ₊₁→ℤ 1) ≡ 0 ℤ.· (ℕ₊₁→ℤ b)
  q =
    a ℤ.· (ℕ₊₁→ℤ 1)
      ≡⟨ ℤ.·IdR a ⟩
    a
      ≡⟨ p ⟩
    0
      ≡⟨ sym (ℤ.·AnnihilL (ℕ₊₁→ℤ b)) ⟩
    0 ℤ.· (ℕ₊₁→ℤ b) ∎

