namespace Epistemic

variable {State A B C : Type}

/-! ## Factoring is refinement -/

-- @source DASHI Agda bridge (PR #555/#581/#582): factoring and refinement are the same relation
/-- If an observer factors through another, the second refines the first. -/
theorem refines_of_factorsThrough {o₁ : Observer State A} {o₂ : Observer State B}
    (h : FactorsThrough o₁ o₂) : Refines o₂ o₁ := by
  obtain ⟨interpret, hi⟩ := h
  intro x y hxy
  rw [hi x, hi y, hxy]

-- @source DASHI Agda bridge (PR #555/#581/#582): factoring and refinement are the same relation
/-- **Refinement is factoring.**  Whenever the coarse observer's value type is
inhabited, "every distinction the coarse observer makes is made by the fine one"
is the same statement as "the coarse observer is a function of the fine one". -/
theorem factorsThrough_iff_refines [Nonempty B] {o₁ : Observer State A}
    {o₂ : Observer State B} : FactorsThrough o₁ o₂ ↔ Refines o₂ o₁ := by
  classical
  refine ⟨refines_of_factorsThrough, fun h => ?_⟩
  refine ⟨fun a => if hx : ∃ x, o₁ x = a then o₂ hx.choose else Classical.arbitrary B, ?_⟩
  intro x
  have hx : ∃ z, o₁ z = o₁ x := ⟨x, rfl⟩
  simp only [hx, dif_pos]
  exact (h _ _ hx.choose_spec).symm

/-! ## Incomparable observers -/

-- @source DASHI Agda bridge (PR #555/#581/#582): transverse observers and their universal property in general
/-- Two observers are *incomparable* when neither is a function of the other. -/
def Incomparable (o₁ : Observer State A) (o₂ : Observer State B) : Prop :=
  ¬ FactorsThrough o₁ o₂ ∧ ¬ FactorsThrough o₂ o₁

-- @source DASHI Agda bridge (PR #555/#581/#582): transverse observers and their universal property in general
/-- **One collision each way makes two observers incomparable.** -/
theorem incomparable_of_cross_collisions {o₁ : Observer State A} {o₂ : Observer State B}
    {x y z w : State} (h₁ : o₁ x = o₁ y) (h₂ : o₂ x ≠ o₂ y)
    (h₃ : o₂ z = o₂ w) (h₄ : o₁ z ≠ o₁ w) :
    Incomparable o₁ o₂ :=
  ⟨not_factorsThrough h₁ h₂, not_factorsThrough h₃ h₄⟩

theorem incomparable_symm {o₁ : Observer State A} {o₂ : Observer State B}
    (h : Incomparable o₁ o₂) : Incomparable o₂ o₁ := ⟨h.2, h.1⟩

/-! ## The join of two observers -/

theorem pairObserver_carries_left (o₁ : Observer State A) (o₂ : Observer State B) :
    FactorsThrough (pairObserver o₁ o₂) o₁ := ⟨Prod.fst, fun _ => rfl⟩

theorem pairObserver_carries_right (o₁ : Observer State A) (o₂ : Observer State B) :
    FactorsThrough (pairObserver o₁ o₂) o₂ := ⟨Prod.snd, fun _ => rfl⟩

-- @source DASHI Agda bridge (PR #555/#581/#582): transverse observers and their universal property in general
/-- **The universal property of the join.**  Any observer through which both
coordinates factor also carries the pair. -/
theorem factorsThrough_pairObserver {common : Observer State C} {o₁ : Observer State A}
    {o₂ : Observer State B} (h₁ : FactorsThrough common o₁) (h₂ : FactorsThrough common o₂) :
    FactorsThrough common (pairObserver o₁ o₂) := by
  obtain ⟨d₁, hd₁⟩ := h₁
  obtain ⟨d₂, hd₂⟩ := h₂
  exact ⟨fun c => (d₁ c, d₂ c), fun x => by simp [pairObserver, hd₁ x, hd₂ x]⟩

-- @source DASHI Agda bridge (PR #555/#581/#582): transverse observers and their universal property in general
/-- **The pair is the least common refinement.**  Anything refining both
coordinates refines the pair. -/
theorem pairObserver_least {common : Observer State C} {o₁ : Observer State A}
    {o₂ : Observer State B} (h₁ : Refines o₁ common) (h₂ : Refines o₂ common) :
    Refines (pairObserver o₁ o₂) common := by
  intro x y hxy
  simp [pairObserver, h₁ x y hxy, h₂ x y hxy]

-- @source DASHI Agda bridge (PR #555/#581/#582): transverse observers and their universal property in general
/-- **The join is not automatically world-complete.**  Two observers that share
a collision have a pair that still misses the distinction. -/
theorem not_separating_pairObserver_of_common_collision {o₁ : Observer State A}
    {o₂ : Observer State B} {x y : State} (h₁ : o₁ x = o₁ y) (h₂ : o₂ x = o₂ y) (hne : x ≠ y) :
    ¬ Separating (pairObserver o₁ o₂) :=
  not_separating_of_collision ⟨x, y, by simp [pairObserver, h₁, h₂], hne⟩

end Epistemic
