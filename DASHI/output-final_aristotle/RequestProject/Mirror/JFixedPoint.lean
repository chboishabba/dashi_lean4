import RequestProject.Mirror.Moonshine

/-!
# `JFixedPoint.agda`, mirrored and strengthened

Lean mirror of the upstream Agda module `JFixedPoint.agda`, the `pilot`-tier
fixture of the `agda2lean` mirror registry.

The Agda module contracts an *observation* — a triple of exponent counts at the
three trivector primes — to a scalar,

  `contract o = e47 o * 47 * (e59 o * 59) * (e71 o * 71) + 1`,

and then checks `contract (stack n) ≡ 196884` at four sample layers
`n = 0, 1, 2, 100`.  The mirror registry maps all four of those onto a single
Lean declaration, `stack_converges`, as a *semantic* rather than exact mapping.
That delegation is only sound if the Lean statement implies each Agda one, and
that is exactly what `fixed_0`, `fixed_1`, `fixed_2` and `fixed_100` below
witness: each is derived from `stack_converges`, not proved again.

Two results here go beyond the Agda.

* `contract_eq` factors the contraction: `contract o = 196883 * (e47 · e59 · e71) + 1`.
  So the contraction is not a coincidence of the three primes appearing —
  it is the Monster representation dimension times the product of the exponents,
  offset by the observer's `+1`.
* `contract_eq_jCoefficient_iff` is the uniqueness the four finite checks only
  sample: `contract o = 196884` **iff** `o` is the unit observation.  The `j`-fixed
  point is not merely reached by the tower, it is the only fixed point there is.
-/

/-! ### Provenance (generated by `tools/provenance.py`)

Source mix of this module's 21 declarations: 0 traced to the DASHI Agda
bridge (`chboishabba/dashi_agda` PR #555 / #581 / #582), 0 rendering the Wikidata
data model, 21 original to this port.  The bridge-traced declarations are
marked with `-- @source` below.  Full ledger: `docs/status/PROVENANCE.md`.
-/

namespace Mirror.JFixedPoint

open Mirror.Moonshine (jCoefficient repDim)

/-- The Agda `record Observation`. -/
structure Observation where
  e47 : ℕ
  e59 : ℕ
  e71 : ℕ
  deriving DecidableEq

/-- The Agda `contract`: project an observation to a scalar via the moonshine map. -/
def contract (o : Observation) : ℕ :=
  o.e47 * 47 * (o.e59 * 59) * (o.e71 * 71) + 1

/-- The Agda `unit-obs`: the minimal observation, the observer itself. -/
def unitObs : Observation := ⟨1, 1, 1⟩

/-- The Agda theorem `unit-converges`. -/
theorem unit_converges : contract unitObs = 196884 := rfl

/-- The Agda `stack`: at every layer the trivector exponents stay `1`. -/
def stack : ℕ → Observation
  | 0 => unitObs
  | _ + 1 => unitObs

/-- **The target-only strengthening.**  The Agda checks four layers; this covers
every layer at once, and the mirror registry delegates all four to it. -/
theorem stack_converges (n : ℕ) : contract (stack n) = 196884 := by
  cases n
  · rfl
  · show contract unitObs = 196884
    rfl

/-- The Agda theorem `fixed-0`, delegated to `stack_converges`. -/
theorem fixed_0 : contract (stack 0) = 196884 := stack_converges 0

/-- The Agda theorem `fixed-1`, delegated to `stack_converges`. -/
theorem fixed_1 : contract (stack 1) = 196884 := stack_converges 1

/-- The Agda theorem `fixed-2`, delegated to `stack_converges`. -/
theorem fixed_2 : contract (stack 2) = 196884 := stack_converges 2

/-- The Agda theorem `fixed-100`, delegated to `stack_converges`. -/
theorem fixed_100 : contract (stack 100) = 196884 := stack_converges 100

/-! ## Towers -/

/-- The Agda `Tower`. -/
abbrev Tower : Type := List Observation

/-- The Agda `expand`: add a new observation layer. -/
def expand (t : Tower) : Tower := unitObs :: t

/-- The Agda `contract-all`. -/
def contractAll : Tower → List ℕ
  | [] => []
  | o :: os => contract o :: contractAll os

def tower1 : Tower := expand []
def tower3 : Tower := expand (expand (expand []))

/-- The Agda theorem `all-196884`. -/
theorem all_196884 : contractAll tower3 = [196884, 196884, 196884] := rfl

/-- The tower result at every height, not just three. -/
theorem contractAll_replicate (n : ℕ) :
    contractAll (List.replicate n unitObs) = List.replicate n 196884 := by
  induction n with
  | zero => rfl
  | succ n ih => simpa [List.replicate_succ, contractAll, unit_converges] using ih

/-- `expand` iterated `n` times from the empty tower is `n` unit observations. -/
theorem expand_iterate (n : ℕ) : expand^[n] [] = List.replicate n unitObs := by
  induction n with
  | zero => rfl
  | succ n ih =>
      rw [Function.iterate_succ_apply', ih, expand, ← List.replicate_succ]

/-! ## What the finite checks were sampling -/

/-- The contraction is the Monster representation dimension times the product of
the three exponents, plus the observer. -/
theorem contract_eq (o : Observation) :
    contract o = repDim * (o.e47 * o.e59 * o.e71) + 1 := by
  simp only [contract, repDim, Mirror.Moonshine.trivectorProduct, Mirror.Moonshine.p47,
    Mirror.Moonshine.p59, Mirror.Moonshine.p71]
  ring

/-- **Uniqueness of the `j`-fixed point.**  `196884` is contracted from one and
only one observation, the unit one. -/
theorem contract_eq_jCoefficient_iff {o : Observation} :
    contract o = jCoefficient ↔ o = unitObs := by
  constructor
  · intro h
    rw [contract_eq] at h
    have hj : jCoefficient = repDim * 1 + 1 := rfl
    have hrep : (0 : ℕ) < repDim := by norm_num [repDim, Mirror.Moonshine.trivectorProduct,
      Mirror.Moonshine.p47, Mirror.Moonshine.p59, Mirror.Moonshine.p71]
    have hprod : o.e47 * o.e59 * o.e71 = 1 := by
      rw [hj] at h
      exact Nat.eq_of_mul_eq_mul_left hrep (by omega)
    obtain ⟨h1, h2⟩ := mul_eq_one.mp hprod
    obtain ⟨h3, h4⟩ := mul_eq_one.mp h1
    cases o
    simp_all [unitObs]
  · rintro rfl; rfl

/-- Every contraction is congruent to `1` modulo the representation dimension:
the observer's `+1` is the residue that survives. -/
theorem contract_mod (o : Observation) : contract o % repDim = 1 := by
  rw [contract_eq, Nat.mul_add_mod]
  norm_num [repDim, Mirror.Moonshine.trivectorProduct, Mirror.Moonshine.p47,
    Mirror.Moonshine.p59, Mirror.Moonshine.p71]

end Mirror.JFixedPoint
