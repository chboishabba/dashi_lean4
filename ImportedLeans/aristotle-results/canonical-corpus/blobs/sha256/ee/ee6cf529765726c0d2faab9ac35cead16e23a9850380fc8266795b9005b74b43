      1≡0→isContr = 0a , λ a →
        0a      ≡⟨ solve! S ⟩
        a · 0a  ≡⟨ cong (λ b → a · b) (sym 1≡0) ⟩
        a · 1a  ≡⟨ solve! S ⟩
        a       ∎
          where S = CommAlgebra→CommRing A

      equivFrom1≡0 : CommAlgebraEquiv A UnitCommAlgebra
      equivFrom1≡0 = isContr→Equiv 1≡0→isContr isContrUnit*  ,
                     snd terminalMap

