pow : Nat → Nat → Nat
pow base zero =
  1
pow base (suc exponent) =
  base * pow base exponent

sphereCount : Nat → Nat → Nat
sphereCount q zero =
  1
sphereCount q (suc radius) =
  suc q * pow q radius

ballCount : Nat → Nat → Nat
ballCount q zero =
  1
ballCount q (suc radius) =
  ballCount q radius + sphereCount q (suc radius)

