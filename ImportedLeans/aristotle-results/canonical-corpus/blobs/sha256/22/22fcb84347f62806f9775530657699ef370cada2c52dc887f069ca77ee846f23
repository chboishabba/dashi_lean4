      plusZeroTorsion ≡ positiveTorsionHelicityOrientation

    minusZeroTorsion :
      TorsionOrientation

    minusZeroTorsionIsNegative :
      minusZeroTorsion ≡ negativeTorsionHelicityOrientation

    scalarDistinctionMade :
