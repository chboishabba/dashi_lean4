FinFinℕIso : Iso (Fin n) (Finℕ n)
FinFinℕIso {n} = iso
  (λ k → toℕ k , toℕ<ᵗn k)
  (uncurry (fromℕᵗ _))
  (λ (k , k<ᵗn) → Σ≡Prop (λ a → isProp<ᵗ {n = a} {m = n}) (toFromIdᵗ _ k k<ᵗn))
  (λ k → fromToIdᵗ _ k (toℕ<ᵗn k))

Fin≃Finℕ : Fin n ≃ Finℕ n
