  field
    primeList : List SSP
    thresholdMaskFn : Nat → Int → Int → Vec15 Nat
    thresholdCountFn : Nat → Int → Int → Nat
    thresholdSupportSubset :
      ∀ k x y →
      thresholdCountFn k x y ≤ supportPrimeCount x y
    listThresholdCount :
