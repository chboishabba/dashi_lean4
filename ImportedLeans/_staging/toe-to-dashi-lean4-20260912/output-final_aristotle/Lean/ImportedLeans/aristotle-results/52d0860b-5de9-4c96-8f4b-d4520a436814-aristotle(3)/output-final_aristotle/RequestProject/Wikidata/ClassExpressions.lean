namespace Wikidata


/-- OWL's class expressions, over the item-valued surface. -/
inductive ClassExpr
  | cls (c : Qid)
  | top
  | bot
  | inter (a b : ClassExpr)
  | union (a b : ClassExpr)
  | compl (a : ClassExpr)
  /-- `∃p.C`. -/
  | ex (p : Pid) (a : ClassExpr)
  /-- `∀p.C`. -/
  | all (p : Pid) (a : ClassExpr)
  deriving DecidableEq, Repr, Inhabited

/-- The truthy values an item carries for a property: the fillers a restriction
quantifies over. -/
def fillersOf (kb : KB) (x : Qid) (p : Pid) : List Qid :=
  (kb.statements.filter
    (fun st => decide (st.subject = x) && decide (st.property = p) && IsTruthy kb st)).map
      Statement.value

theorem mem_fillersOf_iff (kb : KB) (x : Qid) (p : Pid) (y : Qid) :
    y ∈ fillersOf kb x p ↔
      ∃ st ∈ kb.statements,
        st.subject = x ∧ st.property = p ∧ IsTruthy kb st = true ∧ st.value = y := by
  simp only [fillersOf, List.mem_map, List.mem_filter, Bool.and_eq_true, decide_eq_true_eq]
  constructor
  · rintro ⟨st, ⟨hst, ⟨hs, hp⟩, ht⟩, hv⟩
    exact ⟨st, hst, hs, hp, ht, hv⟩
  · rintro ⟨st, hst, hs, hp, ht, hv⟩
    exact ⟨st, ⟨hst, ⟨hs, hp⟩, ht⟩, hv⟩

/-- The fillers only grow: on a wholly normal larger base every truthy filler is
still a truthy filler. -/
theorem mem_fillersOf_mono {kb₁ kb₂ : KB} (hsub : kb₁.statements ⊆ kb₂.statements)
    (h₂ : AllNormal kb₂) {x : Qid} {p : Pid} {y : Qid} (h : y ∈ fillersOf kb₁ x p) :
    y ∈ fillersOf kb₂ x p := by
  rw [mem_fillersOf_iff] at h ⊢
  obtain ⟨st, hst, hs, hp, _, hv⟩ := h
  exact ⟨st, hsub hst, hs, hp, isTruthy_of_allNormal h₂ (hsub hst), hv⟩

/-- The declarative semantics of a class expression. -/
def Sat (kb : KB) : ClassExpr → Qid → Prop
  | ClassExpr.cls c, x => InstanceOf kb x c
  | ClassExpr.top, _ => True
  | ClassExpr.bot, _ => False
  | ClassExpr.inter a b, x => Sat kb a x ∧ Sat kb b x
  | ClassExpr.union a b, x => Sat kb a x ∨ Sat kb b x
  | ClassExpr.compl a, x => ¬ Sat kb a x
  | ClassExpr.ex p a, x => ∃ y ∈ fillersOf kb x p, Sat kb a y
  | ClassExpr.all p a, x => ∀ y ∈ fillersOf kb x p, Sat kb a y

/-- The executable semantics. -/
def sat (kb : KB) : ClassExpr → Qid → Bool
  | ClassExpr.cls c, x => isInstanceOf kb x c
  | ClassExpr.top, _ => true
  | ClassExpr.bot, _ => false
  | ClassExpr.inter a b, x => sat kb a x && sat kb b x
  | ClassExpr.union a b, x => sat kb a x || sat kb b x
  | ClassExpr.compl a, x => !sat kb a x
  | ClassExpr.ex p a, x => (fillersOf kb x p).any (fun y => sat kb a y)
  | ClassExpr.all p a, x => (fillersOf kb x p).all (fun y => sat kb a y)

/-- **Exactness of the class-expression checker.** -/
theorem sat_iff (kb : KB) : ∀ (e : ClassExpr) (x : Qid), sat kb e x = true ↔ Sat kb e x := by
  intro e
  induction e with
  | cls c => intro x; exact isInstanceOf_iff kb x c
  | top => intro x; simp [sat, Sat]
  | bot => intro x; simp [sat, Sat]
  | inter a b iha ihb => intro x; simp [sat, Sat, iha, ihb]
  | union a b iha ihb => intro x; simp [sat, Sat, iha, ihb]
  | compl a iha =>
      intro x
      simp only [sat, Sat, Bool.not_eq_true', Bool.eq_false_iff, ne_eq, iha x]
  | ex p a iha => intro x; simp [sat, Sat, List.any_eq_true, iha]
  | all p a iha => intro x; simp [sat, Sat, List.all_eq_true, iha]

instance (kb : KB) (e : ClassExpr) (x : Qid) : Decidable (Sat kb e x) :=
  decidable_of_iff _ (sat_iff kb e x)

/-! ## The positive fragment -/

/-- The fragment without complement and without the universal restriction. -/
def PositiveExpr : ClassExpr → Prop
  | ClassExpr.cls _ => True
  | ClassExpr.top => True
  | ClassExpr.bot => True
  | ClassExpr.inter a b => PositiveExpr a ∧ PositiveExpr b
  | ClassExpr.union a b => PositiveExpr a ∧ PositiveExpr b
  | ClassExpr.compl _ => False
  | ClassExpr.ex _ a => PositiveExpr a
  | ClassExpr.all _ _ => False

/-- **The positive fragment is monotone.**  Named classes, intersection, union and
the existential restriction never lose a member as the base grows. -/
theorem sat_mono {kb₁ kb₂ : KB} (hsub : kb₁.statements ⊆ kb₂.statements) (h₂ : AllNormal kb₂) :
    ∀ (e : ClassExpr), PositiveExpr e → ∀ (x : Qid), Sat kb₁ e x → Sat kb₂ e x := by
  intro e
  induction e with
  | cls c => intro _ x h; exact instanceOf_mono hsub h₂ h
  | top => intro _ x _; trivial
  | bot => intro _ x h; exact h.elim
  | inter a b iha ihb =>
      intro hpos x h
      exact ⟨iha hpos.1 x h.1, ihb hpos.2 x h.2⟩
  | union a b iha ihb =>
      intro hpos x h
      exact h.imp (iha hpos.1 x) (ihb hpos.2 x)
  | compl a _ => intro hpos; exact absurd hpos not_false
  | ex p a iha =>
      intro hpos x h
      obtain ⟨y, hy, hsat⟩ := h
      exact ⟨y, mem_fillersOf_mono hsub h₂ hy, iha hpos y hsat⟩
  | all p a _ => intro hpos; exact absurd hpos not_false

/-! ## Two bases, one contained in the other -/

/-- `Q1` has no recorded type. -/
def untypedKB : KB := ⟨[⟨1⟩, ⟨2⟩, ⟨3⟩], []⟩

/-- The same base with `Q1 P31 Q2` recorded. -/
def typedKB : KB := ⟨[⟨1⟩, ⟨2⟩, ⟨3⟩], [⟨⟨1⟩, P31, ⟨2⟩, Rank.normal⟩]⟩

theorem untyped_subset_typed : untypedKB.statements ⊆ typedKB.statements := by
  intro st hst; cases hst

theorem typedKB_allNormal : AllNormal typedKB := by
  intro st hst
  simp only [typedKB, List.mem_cons, List.not_mem_nil, or_false] at hst
  subst hst
  rfl

/-- The positive part behaves as `sat_mono` says it must. -/
theorem named_class_survives :
    Sat typedKB (ClassExpr.cls ⟨2⟩) ⟨1⟩ := by decide

/-- **Complement is not monotone.**  `¬(cls Q2)` holds of `Q1` exactly while
nothing has been recorded about it; the statement's arrival withdraws the answer.
So a complement here is an absence in the base that was consulted, never a
refutation. -/
theorem complement_is_not_monotone :
    Sat untypedKB (ClassExpr.compl (ClassExpr.cls ⟨2⟩)) ⟨1⟩ ∧
      ¬ Sat typedKB (ClassExpr.compl (ClassExpr.cls ⟨2⟩)) ⟨1⟩ := by
  refine ⟨by decide, by decide⟩

/-- **The universal restriction is vacuously true when the base is silent.**
`∀P31.⊥` — "every recorded type of `Q1` is absurd" — holds of `Q1` merely because
`Q1` has no recorded type. -/
theorem universal_restriction_is_vacuous :
    Sat untypedKB (ClassExpr.all P31 ClassExpr.bot) ⟨1⟩ := by decide

/-- **And so it is not monotone**: the same expression fails once a type is
recorded. -/
theorem universal_restriction_is_not_monotone :
    Sat untypedKB (ClassExpr.all P31 ClassExpr.bot) ⟨1⟩ ∧
      ¬ Sat typedKB (ClassExpr.all P31 ClassExpr.bot) ⟨1⟩ := by
  refine ⟨by decide, by decide⟩

/-- The existential restriction, by contrast, is gained and never lost. -/
theorem existential_restriction_is_gained :
    ¬ Sat untypedKB (ClassExpr.ex P31 ClassExpr.top) ⟨1⟩ ∧
      Sat typedKB (ClassExpr.ex P31 ClassExpr.top) ⟨1⟩ := by
  refine ⟨by decide, by decide⟩

/-! ## Restrictions read triples; the class order is read by `cls` -/

/-- `Q1` is an instance of `Q2`, and `Q2` is a subclass of `Q3`. -/
def subclassChainKB : KB :=
  ⟨[⟨1⟩, ⟨2⟩, ⟨3⟩],
   [⟨⟨1⟩, P31, ⟨2⟩, Rank.normal⟩, ⟨⟨2⟩, P279, ⟨3⟩, Rank.normal⟩]⟩

/-- **A restriction does not close over the class order.**  The named class `cls
Q3` holds of `Q1` — the instance engine follows the subclass edge — while
`∀P31.(cls Q3)` fails, because the recorded filler is `Q2` and `Q2` is a
*subclass* of `Q3`, not an instance of it.  The two constructors read different
layers, and conflating them is the standard modelling error. -/
theorem restriction_does_not_close_over_subclasses :
    Sat subclassChainKB (ClassExpr.cls ⟨3⟩) ⟨1⟩ ∧
      ¬ Sat subclassChainKB (ClassExpr.all P31 (ClassExpr.cls ⟨3⟩)) ⟨1⟩ := by
  refine ⟨by decide, by decide⟩

/-! ## The recorded class algebra is sound for this semantics -/

/-- The intersection of a list of named classes, as a class expression. -/
def interOf : List Qid → ClassExpr
  | [] => ClassExpr.top
  | m :: ms => ClassExpr.inter (ClassExpr.cls m) (interOf ms)

/-- The union of a list of named classes, as a class expression. -/
def unionOf : List Qid → ClassExpr
  | [] => ClassExpr.bot
  | m :: ms => ClassExpr.union (ClassExpr.cls m) (unionOf ms)

theorem sat_interOf_iff (kb : KB) (x : Qid) :
    ∀ (ms : List Qid), Sat kb (interOf ms) x ↔ ∀ m ∈ ms, InstanceOf kb x m := by
  intro ms
  induction ms with
  | nil => simp [interOf, Sat]
  | cons m ms ih => simp [interOf, Sat, ih]

theorem sat_unionOf_iff (kb : KB) (x : Qid) :
    ∀ (ms : List Qid), Sat kb (unionOf ms) x ↔ ∃ m ∈ ms, InstanceOf kb x m := by
  intro ms
  induction ms with
  | nil => simp [unionOf, Sat]
  | cons m ms ih => simp [unionOf, Sat, ih]

/-- **A recorded `intersection of` statement is sound for the class expression.**
If `kb` records that `c` is the intersection of `ms`, then every known entity
satisfying the intersection expression is an instance of `c`. -/
theorem class_algebra_intersection_sound {kb : KB} {c : Qid} {ms : List Qid}
    (h : IsIntersectionOn kb c ms) {x : Qid} (hx : x ∈ kb.entities)
    (hsat : Sat kb (interOf ms) x) : Sat kb (ClassExpr.cls c) x :=
  h.2 x hx ((sat_interOf_iff kb x ms).1 hsat)

/-- **A recorded `union of` statement is sound for the class expression.**  Every
known instance of `c` satisfies the union expression. -/
theorem class_algebra_union_sound {kb : KB} {c : Qid} {ms : List Qid}
    (h : IsUnionOn kb c ms) {x : Qid} (hx : x ∈ kb.entities)
    (hsat : Sat kb (ClassExpr.cls c) x) : Sat kb (unionOf ms) x :=
  (sat_unionOf_iff kb x ms).2 (h.2 x hx hsat)

/-- **Disjointness refutes the intersection expression**: no known entity
satisfies `cls c ⊓ cls d` when `c` and `d` are disjoint on `kb`. -/
theorem disjointness_refutes_the_intersection {kb : KB} {c d : Qid}
    (h : DisjointOn kb c d) {x : Qid} (hx : x ∈ kb.entities) :
    ¬ Sat kb (ClassExpr.inter (ClassExpr.cls c) (ClassExpr.cls d)) x :=
  fun hsat => h x hx ⟨hsat.1, hsat.2⟩

/-- **The soundness above needs the recorded statement.**  In `subclassChainKB`
`Q1` satisfies the intersection expression built from `[Q2]` and is not an
instance of `Q9`, because nothing records `Q9` as that intersection — and indeed
the recorded-intersection hypothesis fails there.  A class expression is a
question one may ask of a base; only a statement makes it a class of the base. -/
theorem intersection_expression_needs_the_recorded_class :
    Sat subclassChainKB (interOf [⟨2⟩]) ⟨1⟩ ∧
      ¬ Sat subclassChainKB (ClassExpr.cls ⟨9⟩) ⟨1⟩ ∧
      ¬ IsIntersectionOn subclassChainKB ⟨9⟩ [⟨2⟩] := by
  refine ⟨by decide, by decide, ?_⟩
  intro h
  exact absurd (h.2 ⟨1⟩ (by decide) (by decide)) (by decide)

end Wikidata
