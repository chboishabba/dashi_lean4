  nextChargeCurrentExtractionProof : NextMaxwellBlocker
  nextContinuityEquationProof : NextMaxwellBlocker
  nextEmpiricalObservableAuthority : NextMaxwellBlocker
  noMaxwellCalibrationBlocker : NextMaxwellBlocker

