                                         ((pbPr₂ ⋁Pullback) ★ (restCone β β∈L'))
                                         (to++ConeSquare _ _ (pbCommutes ⋁Pullback)) i 𝕚)
              ≡ ++Lemmas.toConeOutPathPL (f ★ (restCone γ γ∈L'))
