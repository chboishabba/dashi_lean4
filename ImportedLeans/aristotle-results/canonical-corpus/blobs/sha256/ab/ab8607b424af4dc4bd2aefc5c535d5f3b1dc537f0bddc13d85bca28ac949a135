    lem₂ {k = suc k} t x with (fst x ≟ᵗ fst t)
    ... | lt x₁ = refl
    ... | eq x₁ = refl
    ... | gt x₁ = refl

    main₁ : (t : _) (x : _)
      → ℤFinGenerator (cellMap↾₁ t) x
       ≡ S⁰×S⁰→ℤ true
          (pickPetal x
            (F (fst (e D 0) (f .fmap (1 , tt) (invEq (CW₁-discrete C) t)))))
