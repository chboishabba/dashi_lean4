module _ {ℓ : Level} (A : ⊥* {ℓ} → Type ℓ) where

  open Iso

  ΣEmpty*Iso : Iso (Σ ⊥* A) ⊥*
  fun ΣEmpty*Iso (* , _) = *

-- fiber of projection map

module _
  (A : Type ℓ)
  (B : A → Type ℓ') where

  private
    proj : Σ A B → A
    proj (a , b) = a

  module _
    (a : A) where

    open Iso

    fiberProjIso : Iso (B a) (fiber proj a)
    fiberProjIso .fun b = (a , b) , refl
    fiberProjIso .inv ((a' , b') , p) = subst B p b'
