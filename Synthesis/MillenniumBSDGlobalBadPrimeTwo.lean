import Synthesis.MillenniumBSDBadPrimeTwoReduction\nimport Synthesis.MillenniumBSDGlobalCompletionGoodReduction\nimport Mathlib.Algebra.Order.GroupWithZero.Canonical\nimport Mathlib.Tactic\n\n/-!\n# Additive reduction at the actual global height-one place above 2\n\nThis repeats the valuation argument inside the exact DVR/completion pair used\nby `WeierstrassCurve.LFunction`.  The canonical integer-ring equivalence to\n`Z_2` shows that 2 is a uniformizer, hence 2^n has valuation exp(-n).\n\nThus the literal global curve is already minimal and additive at the place\nabove 2, and its actual mathlib localPolynomial there is exactly 1.\n-/\n\nnamespace Synthesis.Millennium.BSD\n\nopen WeierstrassCurve\nopen IsDiscreteValuationRing\nopen IsDedekindDomain.HeightOneSpectrum\nopen WithZero Multiplicative\n\nprivate instance : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩\n\nabbrev RationalTwoCompletion := RationalPrimeCompletion 2\nabbrev RationalTwoIntegers := RationalPrimeIntegers 2\n\ntheorem rationalTwoIntegers_two_irreducible :\n    Irreducible (2 : RationalTwoIntegers) := by\n  have hz : Irreducible (2 : ℤ_[2]) := padicIntTwo_irreducible\n  rw [← (rationalPrimeIntegerEquiv 2).toMulEquiv.irreducible_iff]\n  simpa using hz\n\ntheorem rationalTwo_intValuation_two_pow (n : ℕ) :\n    (maximalIdeal RationalTwoIntegers).intValuation\n      ((2 : RationalTwoIntegers) ^ n)\n      = WithZero.exp (-(n : ℤ)) := by\n  rw [IsDiscreteValuationRing.intValuation_maximalIdeal]\n  rw [rationalTwoIntegers_two_irreducible.addVal_pow]\n  simp [← WithZero.exp_eq_coe_ofAdd]\n\ntheorem rationalTwo_valuation_two_pow (n : ℕ) :\n    valuation RationalTwoCompletion (maximalIdeal RationalTwoIntegers)\n      (algebraMap RationalTwoIntegers RationalTwoCompletion\n        ((2 : RationalTwoIntegers) ^ n))\n      = WithZero.exp (-(n : ℤ)) := by\n  rw [IsDedekindDomain.HeightOneSpectrum.valuation_of_algebraMap]\n  exact rationalTwo_intValuation_two_pow n\n\ntheorem cmGlobalTwo_discriminant_valuation :\n    valuation RationalTwoCompletion (maximalIdeal RationalTwoIntegers)\n      (cmGlobalPrimeCurve 2).Δ = WithZero.exp (-6 : ℤ) := by\n  rw [cmGlobalPrimeCurve_discriminant]\n  change valuation RationalTwoCompletion (maximalIdeal RationalTwoIntegers)\n    (algebraMap RationalTwoIntegers RationalTwoCompletion\n      (64 : RationalTwoIntegers)) = _\n  have h64 : (64 : RationalTwoIntegers) =\n      (2 : RationalTwoIntegers) ^ 6 := by norm_num\n  rw [h64, rationalTwo_valuation_two_pow]\n  norm_num\n\ntheorem cmGlobalPrimeCurve_c4_two :\n    (cmGlobalPrimeCurve 2).c₄ = 48 := by\n  simp [cmGlobalPrimeCurve, cmWeierstrass,\n    WeierstrassCurve.c₄, WeierstrassCurve.b₂, WeierstrassCurve.b₄]\n\ntheorem rationalTwo_three_isUnit :\n    IsUnit (3 : RationalTwoIntegers) := by\n  have hz : IsUnit (3 : ℤ_[2]) := three_isUnit_padicInt_two\n  have h := hz.map (rationalPrimeIntegerEquiv 2).symm.toRingHom\n  simpa using h\n\ntheorem rationalTwo_three_valuation_eq_one :\n    valuation RationalTwoCompletion (maximalIdeal RationalTwoIntegers)\n      (algebraMap RationalTwoIntegers RationalTwoCompletion\n        (3 : RationalTwoIntegers)) = 1 := by\n  rw [valuation_eq_one_iff_notMem]\n  simpa [IsDiscreteValuationRing.maximalIdeal,\n    IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]\n    using rationalTwo_three_isUnit\n\ntheorem cmGlobalTwo_c4_valuation :\n    valuation RationalTwoCompletion (maximalIdeal RationalTwoIntegers)\n      (cmGlobalPrimeCurve 2).c₄ = WithZero.exp (-4 : ℤ) := by\n  rw [cmGlobalPrimeCurve_c4_two]\n  change valuation RationalTwoCompletion (maximalIdeal RationalTwoIntegers)\n    (algebraMap RationalTwoIntegers RationalTwoCompletion\n      (48 : RationalTwoIntegers)) = _\n  have h48 : (48 : RationalTwoIntegers) =\n      3 * (2 : RationalTwoIntegers) ^ 4 := by norm_num\n  rw [h48, map_mul, rationalTwo_three_valuation_eq_one,\n    rationalTwo_valuation_two_pow]\n  norm_num [WithZero.exp_add]\n\ninstance cmGlobalTwo_isMinimal :\n    WeierstrassCurve.IsMinimal RationalTwoIntegers\n      (cmGlobalPrimeCurve 2) where\n  val_Δ_maximal := by\n    constructor\n    · infer_instance\n    · intro C hC hle\n      have hcur :\n          WeierstrassCurve.valuation_Δ_aux RationalTwoIntegers\n            ((1 : VariableChange RationalTwoCompletion) • cmGlobalPrimeCurve 2)\n          = ⟨WithZero.exp (-6 : ℤ), exp_neg_six_lt_one.le⟩ := by\n        apply Subtype.ext\n        simp only [one_smul]\n        rw [WeierstrassCurve.valuation_Δ_aux_eq_of_isIntegral]\n        exact cmGlobalTwo_discriminant_valuation\n      rw [hcur] at hle ⊢\n      by_contra hnot\n      have hstrict :\n          WithZero.exp (-6 : ℤ) <\n            (WeierstrassCurve.valuation_Δ_aux RationalTwoIntegers\n              (C • cmGlobalPrimeCurve 2) : ℤᵐ⁰) :=\n        lt_of_le_of_ne hle (Ne.symm hnot)\n      rw [WeierstrassCurve.valuation_Δ_aux_eq_of_isIntegral] at hstrict\n      rw [WeierstrassCurve.variableChange_Δ, map_mul, map_pow,\n        cmGlobalTwo_discriminant_valuation] at hstrict\n      let x : ℤᵐ⁰ :=\n        valuation RationalTwoCompletion (maximalIdeal RationalTwoIntegers)\n          ((C.u⁻¹ : RationalTwoCompletion))\n      have hx0 : x ≠ 0 := by dsimp [x]; simp\n      have hx : 1 < x := by\n        by_contra hx'\n        have hxle : x ≤ 1 := le_of_not_gt hx'\n        have hpow : x ^ 12 ≤ 1 := by simpa using pow_le_one₀ (by simp) hxle\n        have hmul : x ^ 12 * WithZero.exp (-6 : ℤ)\n            ≤ WithZero.exp (-6 : ℤ) := by\n          simpa using mul_le_mul_right' hpow (WithZero.exp (-6 : ℤ))\n        exact (not_lt_of_ge hmul) hstrict\n      have hgt := twelve_power_jump_mul_exp_neg_six_gt_one hx0 hx\n      have hleOne :\n          valuation RationalTwoCompletion (maximalIdeal RationalTwoIntegers)\n            (C • cmGlobalPrimeCurve 2).Δ ≤ 1 := by\n        choose d hd using Δ_integral_of_isIntegral RationalTwoIntegers\n          (C • cmGlobalPrimeCurve 2)\n        rw [← hd]\n        exact valuation_le_one (maximalIdeal RationalTwoIntegers) d\n      rw [WeierstrassCurve.variableChange_Δ, map_mul, map_pow,\n        cmGlobalTwo_discriminant_valuation] at hleOne\n      exact (not_lt_of_ge hleOne) hgt\n\ninstance cmGlobalTwo_hasAdditiveReduction :\n    WeierstrassCurve.HasAdditiveReduction RationalTwoIntegers\n      (cmGlobalPrimeCurve 2) where\n  toIsMinimal := cmGlobalTwo_isMinimal\n  badReduction := by\n    rw [cmGlobalTwo_discriminant_valuation]\n    exact exp_neg_six_lt_one\n  additiveReduction := by\n    rw [cmGlobalTwo_c4_valuation]\n    exact exp_neg_four_lt_one\n\ntheorem cmGlobalTwo_localPolynomial_eq_one :\n    (cmGlobalPrimeCurve 2).localPolynomial RationalTwoIntegers = 1 := by\n  rw [WeierstrassCurve.localPolynomial]\n  dsimp only\n  rw [if_neg cmGlobalTwo_hasAdditiveReduction.not_hasGoodReduction]\n  rw [if_neg (fun hsplit =>\n    cmGlobalTwo_hasAdditiveReduction.not_hasMultiplicativeReduction\n      hsplit.toHasMultiplicativeReduction)]\n  rw [if_neg cmGlobalTwo_hasAdditiveReduction.not_hasMultiplicativeReduction]\n\ntheorem globalHeightOne_localPolynomial_two_eq_one :\n    (cmWeierstrass.baseChange\n      ((rationalPrimePlace 2).adicCompletion ℚ)).localPolynomial\n      ((rationalPrimePlace 2).adicCompletionIntegers ℚ) = 1 := by\n  exact cmGlobalTwo_localPolynomial_eq_one\n\nend Synthesis.Millennium.BSD\n