/-
# Row A — a non-vacuity witness for the literal beta sensitivity package

`RowALiteralBetaSensitivity` proves the boxed Row-A estimate

    |𝓑_K(p) − 𝓑_K(q)| ≤ q·|p − q|,    q < 1,

for a shell coefficient of the literal source shape, under a package of
hypotheses (source majorants, small-field radius, coefficient response,
smallness of the bare coupling).  A conditional theorem is worthless if its
hypothesis package is contradictory, so this file exhibits an explicit,
completely concrete instance of that package and derives the Row-A completion
predicate from it.

The witness is deliberately *not* degenerate in the direction that matters:
the direct (marginal) channel sensitivity is genuinely nonzero — the shell
coefficient really is `1 + a·g⁴` with `a = 10⁻³ ≠ 0`, so `C_dir = 10⁻²` is a
strictly positive constant and the whole differentiated-majorant/Jacobian/
weighted-summation chain is exercised rather than evaded.  What *is* switched
off is the coefficient response (`C_mem = 0`): this realizes the "β_Z carries no
`u`-dependence at leading order" fork, and it is precisely the input that the
Bałaban source pack does not supply.  So this file certifies consistency of the
package; it does not close Row A.
-/
import RequestProject.YangMills.RowALiteralBetaSensitivity

namespace YangMills
namespace RowAWitness

open Finset

/-! ## 1. The concrete source data -/

/-- No determinant modes. -/
noncomputable def lamD : ℕ → ℝ → Fin 0 → ℝ := fun _ _ i => i.elim0

/-- No gauge-determinant modes. -/
noncomputable def lamG : ℕ → ℝ → Fin 0 → ℝ := fun _ _ i => i.elim0

/-- A single, genuinely nonzero interaction Taylor coefficient. -/
noncomputable def aI : ℕ → ℝ → ℕ → ℝ := fun _ _ _ => 1 / 1000

/-- The chart and localisation channels are switched off. -/
def aZero : ℕ → ℝ → ℕ → ℝ := fun _ _ _ => 0

/-- A normalised Gaussian shell coefficient. -/
def betaZ : ℕ → ℝ → ℝ := fun _ _ => 1

/-- The literal shell coefficient of the witness, as a function of the coupling. -/
noncomputable def shell (j : ℕ) (p g : ℝ) : ℝ :=
  literalShellAt betaZ lamD lamG aI aZero aZero 1 j p g

theorem shell_eq (j : ℕ) (p g : ℝ) : shell j p g = 1 + (1 / 1000) * g ^ 4 := by
  simp [shell, literalShellAt, frozenShellInteraction, logDetChannel, tailPolyChannel,
    betaZ, aI, aZero]

theorem frozenShellInteraction_eq (j : ℕ) (p g : ℝ) :
    frozenShellInteraction (lamD j p) (lamG j p) (aI j p) (aZero j p) (aZero j p) 1 g
      = (1 / 1000) * g ^ 4 := by
  simp [frozenShellInteraction, logDetChannel, tailPolyChannel, aI, aZero]

/-! ## 2. The generated trajectory and the self-consistent shell coefficient -/

/-- The trajectory generated by the witness shell coefficient, defined by the
recursion that the shooting map performs. -/
noncomputable def traj (p : ℝ) : ℕ → ℝ
  | 0 => p
  | (j + 1) => traj p j + shell j p (couplingOf (traj p j))

/-- The witness shell coefficient: the literal shell evaluated at the effective
coupling of the trajectory that it itself generates. -/
noncomputable def bet (j : ℕ) (p : ℝ) : ℝ := shell j p (couplingOf (traj p j))

theorem shootingTrajectory_eq (p : ℝ) (j : ℕ) : shootingTrajectory bet p j = traj p j := by
  induction j with
  | zero => simp [traj]
  | succ j ih => rw [shootingTrajectory_step, ih]; rfl

theorem bet_ge_one (j : ℕ) (p : ℝ) : 1 ≤ bet j p := by
  have : bet j p = 1 + (1 / 1000) * (couplingOf (traj p j)) ^ 4 := shell_eq _ _ _
  have h4 : (0 : ℝ) ≤ (couplingOf (traj p j)) ^ 4 := by positivity
  nlinarith

theorem traj_ge (p : ℝ) (hp : (100 : ℝ) ≤ p) (j : ℕ) : (100 : ℝ) ≤ traj p j := by
  induction j with
  | zero => simpa [traj] using hp
  | succ j ih =>
      have hb : 1 ≤ bet j p := bet_ge_one j p
      have : traj p (j + 1) = traj p j + bet j p := rfl
      rw [this]; linarith

/-! ## 3. The numeric facts of the witness -/

theorem couplingOf_hundred : couplingOf (100 : ℝ) = 1 / 10 := by
  have h : ((100 : ℝ))⁻¹ = (1 / 10 : ℝ) ^ 2 := by norm_num
  rw [couplingOf, h, Real.sqrt_sq (by norm_num : (0 : ℝ) ≤ 1 / 10)]

theorem coupling_small (p : ℝ) (hp : (100 : ℝ) ≤ p) (j : ℕ) :
    couplingOf (traj p j) ≤ 1 / 10 := by
  have h := couplingOf_le (u₀ := 100) (u := traj p j) (by norm_num) (traj_ge p hp j)
  rwa [couplingOf_hundred] at h

theorem cdir_value :
    analyticDirectSensitivityBound (Fintype.card (Fin 0)) (Fintype.card (Fin 0))
      0 0 (1 / 2) (1 / 1000) 0 0 1 (1 / 2) ≤ 1 / 100 := by
  simp [analyticDirectSensitivityBound]
  norm_num

/-! ## 4. The hypothesis package is inhabited -/

/-- **Non-vacuity of the Row-A literal sensitivity package.**  Every hypothesis
of `rowA_completion_of_literal_channels` holds for the explicit data above, and
the Row-A completion predicate follows.  In particular the package is
consistent, and the derived contraction constant is genuinely produced by a
nonzero direct channel sensitivity. -/
theorem rowA_completion_witness :
    RowACompletion bet 10 200 (1 - 1 / 1000) (1 + 1 / 1000)
      (200 - (1 + 1 / 1000) * ((10 : ℕ) : ℝ))⁻¹ := by
  have hstruct : ∀ (j : ℕ) (p : ℝ), (100 : ℝ) ≤ p → bet j p
      = literalShellAt betaZ lamD lamG aI aZero aZero 1 j p
          (couplingOf (shootingTrajectory bet p j)) := by
    intro j p _
    rw [shootingTrajectory_eq]
    rfl
  have hsig : literalKernelMass (1 / 100) 0 0 100 (1 - 1 / 1000) < 1 / 2 := by
    refine literal_sigma_lt_half (by norm_num) (by norm_num) (by norm_num)
      (by norm_num) (by norm_num) ?_
    norm_num
  refine rowA_completion_of_literal_channels
    (ι := Fin 0) (κ := Fin 0) (bet := bet) (betaZ := betaZ) (lamD := lamD) (lamG := lamG)
    (aI := aI) (aC := aZero) (aL := aZero) (N := 1)
    (LamDet := 0) (LamGauge := 0) (theta := 1 / 2)
    (AI := 1 / 1000) (AC := 0) (AL := 0) (Kmaj := 1) (rho := 1 / 2)
    (Cdir := 1 / 100) (Cmem := 0) (thmem := 0)
    (bZm := 1) (bZp := 1) (eps := 1 / 1000) (u₀ := 100) (target := 200) (K := 10)
    hstruct
    (fun _ _ i => i.elim0) (fun _ _ i => i.elim0) le_rfl le_rfl
    (fun _ _ n => by simp [aI])
    (fun _ _ n => by simp [aZero])
    (fun _ _ n => by simp [aZero])
    (by norm_num) le_rfl le_rfl (by norm_num)
    (by simp) (by simp) (by norm_num)
    (by rw [couplingOf_hundred]; norm_num) (by norm_num) (by norm_num)
    cdir_value
    (fun _ _ _ => le_rfl) (fun _ _ _ => le_rfl)
    ?_ ?_ (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num)
    hsig (by norm_num) (by norm_num)
  · -- the interaction remainder is below the tolerance on the tube
    intro j p hp
    rw [shootingTrajectory_eq, frozenShellInteraction_eq]
    have hg0 : 0 ≤ couplingOf (traj p j) := couplingOf_nonneg _
    have hg : couplingOf (traj p j) ≤ 1 / 10 := coupling_small p hp j
    have h4 : (couplingOf (traj p j)) ^ 4 ≤ (1 / 10 : ℝ) ^ 4 := by
      exact pow_le_pow_left₀ hg0 hg 4
    rw [abs_of_nonneg (by positivity)]
    nlinarith
  · -- the coefficient response vanishes: the coefficients carry no history
    intro j p q g _ _
    have hzero : literalShellAt betaZ lamD lamG aI aZero aZero 1 j p g
        - literalShellAt betaZ lamD lamG aI aZero aZero 1 j q g = 0 := by
      have h1 : literalShellAt betaZ lamD lamG aI aZero aZero 1 j p g = 1 + (1 / 1000) * g ^ 4 :=
        shell_eq j p g
      have h2 : literalShellAt betaZ lamD lamG aI aZero aZero 1 j q g = 1 + (1 / 1000) * g ^ 4 :=
        shell_eq j q g
      rw [h1, h2]; ring
    rw [hzero, abs_zero]
    exact Finset.sum_nonneg fun k _ => by
      simp

/-- The same data also witnesses the boxed cumulative-beta contraction with an
explicit contraction constant. -/
theorem cumulative_contraction_witness :
    (∀ (K : ℕ) (p q : ℝ), (100 : ℝ) ≤ p → (100 : ℝ) ≤ q →
        |∑ j ∈ range K, bet j p - ∑ j ∈ range K, bet j q|
          ≤ (literalKernelMass (1 / 100) 0 0 100 (1 - 1 / 1000)
              / (1 - literalKernelMass (1 / 100) 0 0 100 (1 - 1 / 1000))) * |p - q|)
      ∧ literalKernelMass (1 / 100) 0 0 100 (1 - 1 / 1000)
          / (1 - literalKernelMass (1 / 100) 0 0 100 (1 - 1 / 1000)) < 1 := by
  have hstruct : ∀ (j : ℕ) (p : ℝ), (100 : ℝ) ≤ p → bet j p
      = literalShellAt betaZ lamD lamG aI aZero aZero 1 j p
          (couplingOf (shootingTrajectory bet p j)) := by
    intro j p _
    rw [shootingTrajectory_eq]
    rfl
  have hsig : literalKernelMass (1 / 100) 0 0 100 (1 - 1 / 1000) < 1 / 2 := by
    refine literal_sigma_lt_half (by norm_num) (by norm_num) (by norm_num)
      (by norm_num) (by norm_num) ?_
    norm_num
  refine literal_cumulative_beta_contraction
    (ι := Fin 0) (κ := Fin 0) (bet := bet) (betaZ := betaZ) (lamD := lamD) (lamG := lamG)
    (aI := aI) (aC := aZero) (aL := aZero) (N := 1)
    (LamDet := 0) (LamGauge := 0) (theta := 1 / 2)
    (AI := 1 / 1000) (AC := 0) (AL := 0) (Kmaj := 1) (rho := 1 / 2)
    (Cdir := 1 / 100) (Cmem := 0) (thmem := 0) (u₀ := 100) (bl := 1 - 1 / 1000)
    hstruct
    (fun _ _ i => i.elim0) (fun _ _ i => i.elim0) le_rfl le_rfl
    (fun _ _ n => by simp [aI])
    (fun _ _ n => by simp [aZero])
    (fun _ _ n => by simp [aZero])
    (by norm_num) le_rfl le_rfl (by norm_num)
    (by simp) (by simp) (by norm_num)
    (by rw [couplingOf_hundred]; norm_num) (by norm_num) (by norm_num)
    cdir_value
    ?_ (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num)
    ?_ hsig
  · intro j p q g _ _
    have hzero : literalShellAt betaZ lamD lamG aI aZero aZero 1 j p g
        - literalShellAt betaZ lamD lamG aI aZero aZero 1 j q g = 0 := by
      have h1 : literalShellAt betaZ lamD lamG aI aZero aZero 1 j p g = 1 + (1 / 1000) * g ^ 4 :=
        shell_eq j p g
      have h2 : literalShellAt betaZ lamD lamG aI aZero aZero 1 j q g = 1 + (1 / 1000) * g ^ 4 :=
        shell_eq j q g
      rw [h1, h2]; ring
    rw [hzero, abs_zero]
    exact Finset.sum_nonneg fun k _ => by simp
  · intro j p _
    have := bet_ge_one j p
    linarith

end RowAWitness
end YangMills
