                                                          ∙ sym (·DistR+ PA:str _ _ _))
                        λ {U V} ind-U ind-V Q → (cong₂ (_+_ PA:str) (ind-U Q) (ind-V Q))
                                                 ∙ sym (·DistL+ PA:str _ _ _)



