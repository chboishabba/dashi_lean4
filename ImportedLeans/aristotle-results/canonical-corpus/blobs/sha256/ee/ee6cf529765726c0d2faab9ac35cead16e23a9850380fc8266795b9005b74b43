module Ontology.Hecke.FactorVecDefectCorrespondence where

open import Agda.Builtin.Nat using (Nat; zero; suc)

open import MonsterOntos using
  (SSP; p2; p3; p5; p7; p11; p13; p17; p19; p23; p29; p31; p41; p47; p59; p71)
