      ℝ →
      Carrier →
      Carrier

    ‖_‖ :
      Carrier →
      ℝ

    normNonnegative :
      (x : Carrier) →
      0ℝ ≤ℝ ‖ x ‖

    normZero :
      ‖ zero ‖ ≡ 0ℝ

    normZeroOnlyAtZero :
      (x : Carrier) →
      ‖ x ‖ ≡ 0ℝ →
      x ≡ zero

    normTriangle :
      (x y : Carrier) →
      ‖ x + y ‖ ≤ℝ (‖ x ‖ +ℝ ‖ y ‖)

