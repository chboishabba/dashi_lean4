        toConeMor f g square h  (tr₁ , tr₂) = isConeMorSingLemma
                                               (toCone f g square)
                                               (restCone (β ++Fin γ) (β++γ∈L' β∈L' γ∈L'))
                                                singCase
          where
          singCaseAux : ∀ (x : Fin n ⊎ Fin n')
