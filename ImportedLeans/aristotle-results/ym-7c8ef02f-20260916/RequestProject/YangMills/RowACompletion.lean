/-
# Row A — the completion predicate, on one and the same generated dynamics

The Row-A completion contract has two halves, and its point is that they must
hold for the **same** renormalised-coupling construction:

* **A-i** a bilateral, *defect-free* cumulative beta tube on the terminal tails,
  `b̃₋·n ≤ Σ_{j=k}^{K−1} β_j ≤ b̃₊·n` with `b̃₋ > 0`;
* **A-ii** a *tuned* bare coupling: every effective coupling stays in the
  small-field region and the coupling at the prescribed observation scale is
  nonzero and equal to a prescribed value.

`RowATerminalTube` supplies the analytic absorption behind A-i and `RowAShooting`
supplies the contraction behind A-ii.  This file welds them onto one trajectory —
the one generated by the tuned bare coupling.  `RowACompletion` is the
predicate, `rowA_completion_of_uniform_debt` inhabits it from the hypothesis
package, `quartic_debt_bootstrap` shows that the per-shell debt tolerance in
that package is a *consequence* of the quartic remainder bound on the physical
region (bare couplings above a floor) rather than an extra assumption, and
`rowA_completion_witness` exhibits an explicit numerical instance so that the
predicate is demonstrably inhabitable.

**What is proved and what is assumed.**  Proved: given (a) a per-shell two-sided
Gaussian bound, (b) a per-shell remainder tolerance `ε < b_Z⁻` — itself a
consequence of the quartic remainder bound, by `quartic_debt_bootstrap` — and
(c) a Lipschitz sensitivity of the shell coefficients to the bare coupling whose
cumulative value is `q < 1`, the tuned bare coupling exists, is unique, and its
trajectory satisfies the bilateral defect-free tube on every block together with
the physical observation window.

Assumed, i.e. *not* proved anywhere in this repository: item (c), the
quantitative sensitivity of Bałaban's shell coefficient to the bare coupling.
In Bałaban's own program the corresponding statement is CMP 109 Theorem 2
(`d = 4`, `G = SU(2)`, two-sided bounds (0.31) on `1/g_k²` and existence of the
tuned bare coupling `g₀(ε, g)`), whose proof that paper explicitly defers to a
separate publication; the deferred paper is not in the source pack.  Row A is
therefore **not** closed here; what is closed is the implication from a
quantitative sensitivity estimate to the completion predicate, which is exactly
the bridge the completion contract names as missing.
-/
import RequestProject.YangMills.RowAShooting

namespace YangMills

/-- **The Row-A completion predicate on a single generated trajectory.**
`shootingTrajectory bet bare` is the trajectory of inverse squared couplings
generated by the shell coefficients `bet · bare` from the bare coupling `bare`;
the fields are the tuning, the observation-scale value, the small-field window,
and the bilateral defect-free cumulative tube. -/
structure RowACompletionAt (bet : ℕ → ℝ → ℝ) (K : ℕ) (target bl bu winBound bare : ℝ) :
    Prop where
  /-- the trajectory generated by the tuned bare coupling hits the prescribed observation-scale value -/
  hits : shootingTrajectory bet bare K = target
  /-- the physical coupling at the observation scale is the prescribed nonzero one -/
  observation : couplingSq (shootingTrajectory bet bare) K = target⁻¹ ∧ 0 < target⁻¹
  /-- every effective coupling on the way stays in the small-field window -/
  window : ∀ j ≤ K, 0 < couplingSq (shootingTrajectory bet bare) j
      ∧ couplingSq (shootingTrajectory bet bare) j ≤ winBound
  /-- the lower slope of the tube is strictly positive -/
  slope_pos : 0 < bl
  /-- the bilateral defect-free cumulative tube on every block -/
  tube : ∀ k m : ℕ, k ≤ m →
      bl * (m - k : ℕ) ≤ ∑ j ∈ Finset.Ico k m, bet j bare
        ∧ ∑ j ∈ Finset.Ico k m, bet j bare ≤ bu * (m - k : ℕ)

/-- **Row A's completion predicate**: there exists a tuned bare coupling for
which the whole package holds. -/
def RowACompletion (bet : ℕ → ℝ → ℝ) (K : ℕ) (target bl bu winBound : ℝ) : Prop :=
  ∃ bare : ℝ, RowACompletionAt bet K target bl bu winBound bare

/-! ## 1. The debt tolerance is a consequence of the quartic bound -/

/-- **Bootstrap: a quartic remainder is below any prescribed tolerance on the
whole trajectory of a bare coupling above the floor.**  If the bare inverse
coupling is at least `v₀ > 0` and `C ≤ ε·v₀²` with `ε ≤ b_Z⁻`, then along the
generated trajectory the inverse coupling never drops below `v₀` and every
remainder is below `ε`.  Both statements are proved together by induction: the
lower bound on `u_j` bounds the remainder, and the bounded remainder keeps the
shell coefficient nonnegative, which propagates the lower bound. -/
theorem quartic_debt_bootstrap {bet betaZ betaInt : ℕ → ℝ → ℝ} {bZm C eps v₀ v : ℝ}
    (hdec : ∀ j w, bet j w = betaZ j w + betaInt j w)
    (hZl : ∀ j w, bZm ≤ betaZ j w)
    (hInt : ∀ j, |betaInt j v| ≤ C * couplingSq (shootingTrajectory bet v) j ^ 2)
    (hC : 0 ≤ C) (hv₀ : 0 < v₀) (hv : v₀ ≤ v)
    (hCsmall : C ≤ eps * v₀ ^ 2) (heps : eps ≤ bZm) :
    ∀ j, v₀ ≤ shootingTrajectory bet v j ∧ |betaInt j v| ≤ eps := by
  have key : ∀ j, v₀ ≤ shootingTrajectory bet v j := by
    intro j
    induction j with
    | zero => simpa using hv
    | succ n ih =>
        have hpos : 0 < shootingTrajectory bet v n := lt_of_lt_of_le hv₀ ih
        have hcs : couplingSq (shootingTrajectory bet v) n ≤ v₀⁻¹ := by
          simpa [couplingSq] using inv_anti₀ hv₀ ih
        have hcs0 : 0 ≤ couplingSq (shootingTrajectory bet v) n := by
          simpa [couplingSq] using hpos.le
        have hsq : couplingSq (shootingTrajectory bet v) n ^ 2 ≤ (v₀⁻¹) ^ 2 := by
          have := mul_le_mul hcs hcs hcs0 (le_trans hcs0 hcs)
          simpa [pow_two] using this
        have hdebt : |betaInt n v| ≤ eps := by
          have h1 : C * couplingSq (shootingTrajectory bet v) n ^ 2 ≤ C * (v₀⁻¹) ^ 2 :=
            mul_le_mul_of_nonneg_left hsq hC
          have h2 : C * (v₀⁻¹) ^ 2 ≤ eps := by
            have hv2 : 0 < v₀ ^ 2 := by positivity
            have : C * (v₀ ^ 2)⁻¹ ≤ eps := by
              rw [mul_inv_le_iff₀ hv2]; linarith [hCsmall]
            simpa [inv_pow] using this
          exact le_trans (hInt n) (le_trans h1 h2)
        have hbet : 0 ≤ bet n v := by
          have h3 := neg_abs_le (betaInt n v)
          have := hZl n v
          rw [hdec]
          linarith [abs_le.mp hdebt |>.1]
        rw [shootingTrajectory_step]
        linarith
  intro j
  refine ⟨key j, ?_⟩
  have hpos : 0 < shootingTrajectory bet v j := lt_of_lt_of_le hv₀ (key j)
  have hcs : couplingSq (shootingTrajectory bet v) j ≤ v₀⁻¹ := by
    simpa [couplingSq] using inv_anti₀ hv₀ (key j)
  have hcs0 : 0 ≤ couplingSq (shootingTrajectory bet v) j := by
    simpa [couplingSq] using hpos.le
  have hsq : couplingSq (shootingTrajectory bet v) j ^ 2 ≤ (v₀⁻¹) ^ 2 := by
    have := mul_le_mul hcs hcs hcs0 (le_trans hcs0 hcs)
    simpa [pow_two] using this
  have h1 : C * couplingSq (shootingTrajectory bet v) j ^ 2 ≤ C * (v₀⁻¹) ^ 2 :=
    mul_le_mul_of_nonneg_left hsq hC
  have h2 : C * (v₀⁻¹) ^ 2 ≤ eps := by
    have hv2 : 0 < v₀ ^ 2 := by positivity
    have : C * (v₀ ^ 2)⁻¹ ≤ eps := by
      rw [mul_inv_le_iff₀ hv2]; linarith [hCsmall]
    simpa [inv_pow] using this
  exact le_trans (hInt j) (le_trans h1 h2)

/-! ## 2. The completion predicate -/

/-- **Row A's completion predicate, from the sensitivity estimate.**

Hypotheses, in the order in which they are used:

* `hdec`, `hZl`, `hZu` — the shell coefficient splits into a Gaussian part
  trapped in `[b_Z⁻, b_Z⁺]` and a remainder;
* `hIntEps` — the remainder is below the tolerance `ε` (supplied by
  `quartic_debt_bootstrap` from the quartic bound);
* `hL`, `hq`, `hq0`, `hq1` — the cumulative sensitivity of the beta history to
  the bare coupling is `≤ q < 1`;
* `hwin`, `hepsm` — the observation scale is above the window floor and the
  tolerance is below the Gaussian floor. -/
theorem rowA_completion_of_uniform_debt
    {bet betaZ betaInt : ℕ → ℝ → ℝ} {L : ℕ → ℝ} {q target bZm bZp eps : ℝ} {K : ℕ}
    (hdec : ∀ j v, bet j v = betaZ j v + betaInt j v)
    (hZl : ∀ j v, bZm ≤ betaZ j v) (hZu : ∀ j v, betaZ j v ≤ bZp)
    (hIntEps : ∀ j v, |betaInt j v| ≤ eps)
    (hL : ∀ j v w, |bet j v - bet j w| ≤ L j * |v - w|)
    (hq : ∑ j ∈ Finset.range K, L j ≤ q) (hq0 : 0 ≤ q) (hq1 : q < 1)
    (hwin : 0 < target - (bZp + eps) * K) (hepsm : eps < bZm) :
    RowACompletion bet K target (bZm - eps) (bZp + eps) (target - (bZp + eps) * K)⁻¹ := by
  have hlow : ∀ j v, bZm - eps ≤ bet j v := by
    intro j v
    have h := abs_le.mp (hIntEps j v)
    rw [hdec]; linarith [hZl j v, h.1]
  have hup : ∀ j v, bet j v ≤ bZp + eps := by
    intro j v
    have h := abs_le.mp (hIntEps j v)
    rw [hdec]; linarith [hZu j v, h.2]
  have hslope : 0 < bZm - eps := by linarith
  obtain ⟨v, hK, -, hwindow, hobs⟩ :=
    tuned_bare_coupling_window (bet := bet) (L := L) (q := q) (target := target)
      (bZm := bZm - eps) (bZp := bZp + eps) (K := K) hL hq hq0 hq1
      hlow hup hslope.le hwin
  have htargetpos : 0 < target := by
    have : 0 ≤ (bZp + eps) * K := by
      have h1 : 0 ≤ bZp + eps := by linarith [hlow 0 0, hup 0 0]
      positivity
    linarith
  refine ⟨v, hK, ⟨hobs, by positivity⟩, hwindow, hslope, fun k m hkm => ?_⟩
  have hcard : (Finset.Ico k m).card = m - k := Nat.card_Ico k m
  constructor
  · calc (bZm - eps) * (m - k : ℕ) = ∑ _j ∈ Finset.Ico k m, (bZm - eps) := by
          rw [Finset.sum_const, hcard, nsmul_eq_mul]; ring
      _ ≤ ∑ j ∈ Finset.Ico k m, bet j v := Finset.sum_le_sum fun j _ => hlow j v
  · calc ∑ j ∈ Finset.Ico k m, bet j v ≤ ∑ _j ∈ Finset.Ico k m, (bZp + eps) :=
          Finset.sum_le_sum fun j _ => hup j v
      _ = (bZp + eps) * (m - k : ℕ) := by
          rw [Finset.sum_const, hcard, nsmul_eq_mul]; ring

/-! ## 3. Non-vacuity -/

/-- **The completion predicate is inhabitable.**  An explicit numerical instance
of the hypothesis package of `rowA_completion_of_uniform_debt`: a constant
Gaussian shell coefficient `1`, a remainder that is a genuinely nonconstant
`1/100`-small function of the bare coupling (so the sensitivity hypothesis is
used, not evaded), cutoff `K = 10` and observation-scale value `u⋆ = 100`. -/
theorem rowA_completion_witness :
    RowACompletion
      (fun _ v => 1 + (Real.cos v) / 100) 10 100 (1 - 1/50) (1 + 1/50)
      (100 - (1 + 1/50) * (10:ℕ))⁻¹ := by
  refine (rowA_completion_of_uniform_debt
    (bet := fun _ v => 1 + (Real.cos v) / 100)
    (betaZ := fun _ _ => 1) (betaInt := fun _ v => (Real.cos v) / 100)
    (L := fun _ => 1/100) (q := 1/10) (target := 100) (bZm := 1) (bZp := 1)
    (eps := 1/50) (K := 10)
    (fun _ _ => rfl) (fun _ _ => le_refl 1) (fun _ _ => le_refl 1) (fun _ v => ?_)
    (fun _ v w => ?_) ?_ (by norm_num) (by norm_num) (by norm_num) (by norm_num))
  · have h := Real.abs_cos_le_one v
    rw [abs_div]
    rw [abs_of_nonneg (by norm_num : (0:ℝ) ≤ (100:ℝ))]
    linarith [h]
  · have h : |Real.cos v - Real.cos w| ≤ |v - w| := by
      simpa using Real.abs_cos_sub_cos_le v w
    have : |(1 + Real.cos v / 100) - (1 + Real.cos w / 100)|
        = |Real.cos v - Real.cos w| / 100 := by
      rw [show (1 + Real.cos v / 100) - (1 + Real.cos w / 100)
        = (Real.cos v - Real.cos w) / 100 by ring, abs_div,
        abs_of_nonneg (by norm_num : (0:ℝ) ≤ (100:ℝ))]
    rw [this]
    linarith [h]
  · simp [Finset.sum_const, Finset.card_range]
    norm_num

end YangMills
