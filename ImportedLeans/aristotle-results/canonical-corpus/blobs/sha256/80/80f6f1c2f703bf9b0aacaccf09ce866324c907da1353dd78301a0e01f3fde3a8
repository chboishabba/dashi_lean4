  (plaquette c d)
  k
  (separatedByFinitePrimeLaneFactorisation
    (plaquette .a .b)
    (plaquette .c .d)
    .k
    disjoint)
  rewrite firstFirstDisjoint disjoint
        | firstSecondDisjoint disjoint
