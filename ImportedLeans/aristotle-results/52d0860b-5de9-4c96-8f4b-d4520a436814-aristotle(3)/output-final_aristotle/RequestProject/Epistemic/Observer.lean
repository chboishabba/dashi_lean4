namespace Epistemic

-- @source DASHI Agda bridge (PR #555/#581/#582): observer refinement lattice (`Separating`, `Refines`, residual fibres)
/-- An observer of `State` with values in `Value`. -/
abbrev Observer (State Value : Type) := State → Value

variable {State Value Coarse Fine : Type}

/-! ## Separation and refinement -/

-- @source DASHI Agda bridge (PR #555/#581/#582): observer refinement lattice (`Separating`, `Refines`, residual fibres)
/-- An observer is *separating* when it loses nothing: equal observations force
equal states. -/
def Separating (o : Observer State Value) : Prop := ∀ x y, o x = o y → x = y

/-- `coarse` is refined by `fine`: any distinction the coarse observer makes is
already made by the fine one. -/
def Refines (coarse : Observer State Coarse) (fine : Observer State Fine) : Prop :=
  ∀ x y, fine x = fine y → coarse x = coarse y

theorem refines_refl (o : Observer State Value) : Refines o o := fun _ _ h => h

theorem refines_trans {A B C : Type} {a : Observer State A} {b : Observer State B}
    {c : Observer State C} (hab : Refines a b) (hbc : Refines b c) : Refines a c :=
  fun x y h => hab x y (hbc x y h)

/-- Every observer is refined by any separating observer. -/
theorem refines_of_separating {o : Observer State Value} {s : Observer State Coarse}
    (hs : Separating s) : Refines o s := fun x y h => by rw [hs x y h]

-- @source DASHI Agda bridge (PR #555/#581/#582): observer refinement lattice (`Separating`, `Refines`, residual fibres)
/-- A *strict* refinement: the fine observer separates two states that the coarse
observer identifies. -/
def StrictlyRefines (coarse : Observer State Coarse) (fine : Observer State Fine) : Prop :=
  Refines coarse fine ∧ ∃ x y, coarse x = coarse y ∧ fine x ≠ fine y

theorem refines_of_strictlyRefines {coarse : Observer State Coarse}
    {fine : Observer State Fine} (h : StrictlyRefines coarse fine) : Refines coarse fine :=
  h.1

/-- A strictly refined observer is not separating. -/
theorem not_separating_of_strictlyRefines {coarse : Observer State Coarse}
    {fine : Observer State Fine} (h : StrictlyRefines coarse fine) : ¬ Separating coarse := by
  obtain ⟨_, x, y, hcoarse, hfine⟩ := h
  intro hsep
  exact hfine (by rw [hsep x y hcoarse])

/-- A collision: two distinct states that an observer identifies. -/
def Collision (o : Observer State Value) : Prop := ∃ x y, o x = o y ∧ x ≠ y

theorem not_separating_of_collision {o : Observer State Value} (h : Collision o) :
    ¬ Separating o := by
  obtain ⟨x, y, hobs, hne⟩ := h
  exact fun hsep => hne (hsep x y hobs)

theorem collision_of_not_separating {o : Observer State Value} (h : ¬ Separating o) :
    Collision o := by
  simp only [Separating, not_forall] at h
  obtain ⟨x, y, h⟩ := h
  exact ⟨x, y, by tauto, by tauto⟩

/-! ## Pairing observers -/

/-- Observing two coordinates at once. -/
def pairObserver (o₁ : Observer State Coarse) (o₂ : Observer State Fine) :
    Observer State (Coarse × Fine) := fun x => (o₁ x, o₂ x)

theorem pair_refines_left (o₁ : Observer State Coarse) (o₂ : Observer State Fine) :
    Refines o₁ (pairObserver o₁ o₂) := fun _ _ h => congrArg Prod.fst h

theorem pair_refines_right (o₁ : Observer State Coarse) (o₂ : Observer State Fine) :
    Refines o₂ (pairObserver o₁ o₂) := fun _ _ h => congrArg Prod.snd h

/-- Adding a coordinate that separates a coarse collision gives a strict
refinement. -/
theorem strictlyRefines_pair {o₁ : Observer State Coarse} {o₂ : Observer State Fine}
    {x y : State} (hcoarse : o₁ x = o₁ y) (hfine : o₂ x ≠ o₂ y) :
    StrictlyRefines o₁ (pairObserver o₁ o₂) :=
  ⟨pair_refines_left o₁ o₂, x, y, hcoarse, fun h => hfine (congrArg Prod.snd h)⟩

/-! ## Families of observers -/

-- @source DASHI Agda bridge (PR #555/#581/#582): observer refinement lattice (`Separating`, `Refines`, residual fibres)
/-- Two states agree on a whole family of observers. -/
def AgreeOn (family : List (Observer State Value)) (x y : State) : Prop :=
  ∀ o ∈ family, o x = o y

theorem agreeOn_refl (family : List (Observer State Value)) (x : State) :
    AgreeOn family x x := fun _ _ => rfl

theorem agreeOn_symm {family : List (Observer State Value)} {x y : State}
    (h : AgreeOn family x y) : AgreeOn family y x := fun o ho => (h o ho).symm

theorem agreeOn_trans {family : List (Observer State Value)} {x y z : State}
    (h₁ : AgreeOn family x y) (h₂ : AgreeOn family y z) : AgreeOn family x z :=
  fun o ho => (h₁ o ho).trans (h₂ o ho)

/-- A family separates when agreement across the whole family forces equality. -/
def SeparatingFamily (family : List (Observer State Value)) : Prop :=
  ∀ x y, AgreeOn family x y → x = y

/-- Refinement of families. -/
def FamilyRefines (coarse fine : List (Observer State Value)) : Prop :=
  ∀ x y, AgreeOn fine x y → AgreeOn coarse x y

/-- Adding an observer to a family refines it. -/
theorem familyRefines_cons (o : Observer State Value)
    (family : List (Observer State Value)) : FamilyRefines family (o :: family) :=
  fun _ _ h o' ho' => h o' (List.mem_cons_of_mem _ ho')

-- @source DASHI Agda bridge (PR #555/#581/#582): observer refinement lattice (`Separating`, `Refines`, residual fibres)
/-- The residual fibre of a family at a state: everything the family cannot tell
apart from it. -/
def ResidualFibre (family : List (Observer State Value)) (x : State) : Set State :=
  {y | AgreeOn family x y}

theorem mem_residualFibre_self (family : List (Observer State Value)) (x : State) :
    x ∈ ResidualFibre family x := agreeOn_refl family x

-- @source DASHI Agda bridge (PR #555/#581/#582): observer refinement lattice (`Separating`, `Refines`, residual fibres)
/-- **Adding an observer monotonically shrinks the residual fibre.** -/
theorem residualFibre_cons_subset (o : Observer State Value)
    (family : List (Observer State Value)) (x : State) :
    ResidualFibre (o :: family) x ⊆ ResidualFibre family x :=
  fun _ hy o' ho' => hy o' (List.mem_cons_of_mem _ ho')

-- @source DASHI Agda bridge (PR #555/#581/#582): observer refinement lattice (`Separating`, `Refines`, residual fibres)
/-- If the new observer really separates something in the old fibre, the shrinking
is strict. -/
theorem residualFibre_cons_ssubset {o : Observer State Value}
    {family : List (Observer State Value)} {x y : State}
    (hy : y ∈ ResidualFibre family x) (hsep : o x ≠ o y) :
    ResidualFibre (o :: family) x ⊂ ResidualFibre family x := by
  refine ⟨residualFibre_cons_subset o family x, ?_⟩
  intro hsub
  exact hsep (hsub hy o (List.mem_cons_self))

-- @source DASHI Agda bridge (PR #555/#581/#582): observer refinement lattice (`Separating`, `Refines`, residual fibres)
/-- A separating family is exactly one whose residual fibres are singletons. -/
theorem separatingFamily_iff_residualFibre_eq (family : List (Observer State Value)) :
    SeparatingFamily family ↔ ∀ x, ResidualFibre family x = {x} := by
  constructor
  · intro h x
    ext y
    exact ⟨fun hy => (h x y hy).symm, fun hy => by cases hy; exact agreeOn_refl family x⟩
  · intro h x y hxy
    have : y ∈ ({x} : Set State) := (h x) ▸ hxy
    exact this.symm

/-! ## Dynamics inside a fibre

Given a projection `proj : State → Coarse`, an operator on states is *surface
invariant* when it never moves the projection.  Such an operator can still move
the fine state: that is a hidden transition. -/

-- @source DASHI Agda bridge (PR #555/#581/#582): fibre-preserving dynamics, hidden transitions, deck symmetries
/-- The operator never changes the projected surface. -/
def SurfaceInvariant (proj : State → Coarse) (f : State → State) : Prop :=
  ∀ x, proj (f x) = proj x

theorem surfaceInvariant_id (proj : State → Coarse) : SurfaceInvariant proj id :=
  fun _ => rfl

theorem surfaceInvariant_comp {proj : State → Coarse} {f g : State → State}
    (hf : SurfaceInvariant proj f) (hg : SurfaceInvariant proj g) :
    SurfaceInvariant proj (f ∘ g) := fun x => (hf (g x)).trans (hg x)

-- @source DASHI Agda bridge (PR #555/#581/#582): fibre-preserving dynamics, hidden transitions, deck symmetries
/-- A hidden transition: the fine state really moves while the surface stays put. -/
def HiddenTransition (proj : State → Coarse) (f : State → State) (x : State) : Prop :=
  f x ≠ x ∧ proj (f x) = proj x

theorem hiddenTransition_of_surfaceInvariant {proj : State → Coarse} {f : State → State}
    (hf : SurfaceInvariant proj f) {x : State} (hx : f x ≠ x) :
    HiddenTransition proj f x := ⟨hx, hf x⟩

-- @source DASHI Agda bridge (PR #555/#581/#582): fibre-preserving dynamics, hidden transitions, deck symmetries
/-- **A hidden transition witnesses that the projection is not injective.** -/
theorem not_injective_of_hiddenTransition {proj : State → Coarse} {f : State → State}
    {x : State} (h : HiddenTransition proj f x) : ¬ Function.Injective proj :=
  fun hinj => h.1 (hinj h.2)

theorem collision_of_hiddenTransition {proj : State → Coarse} {f : State → State}
    {x : State} (h : HiddenTransition proj f x) : Collision proj :=
  ⟨f x, x, h.2, h.1⟩

-- @source DASHI Agda bridge (PR #555/#581/#582): fibre-preserving dynamics, hidden transitions, deck symmetries
/-- The operator's action is visible downstairs: it descends to an operator on the
surface. -/
def DescendsToSurface (proj : State → Coarse) (f : State → State) : Prop :=
  ∃ g : Coarse → Coarse, ∀ x, proj (f x) = g (proj x)

/-- A surface-invariant operator descends as the identity. -/
theorem descendsToSurface_of_surfaceInvariant {proj : State → Coarse} {f : State → State}
    (hf : SurfaceInvariant proj f) : DescendsToSurface proj f := ⟨id, hf⟩

/-- Descending is strictly weaker than being surface invariant. -/
theorem exists_descendsToSurface_not_surfaceInvariant :
    ∃ (proj : Bool → Bool) (f : Bool → Bool), DescendsToSurface proj f ∧
      ¬ SurfaceInvariant proj f :=
  ⟨id, not, ⟨not, fun _ => rfl⟩, fun h => by simpa using h true⟩

-- @source DASHI Agda bridge (PR #555/#581/#582): fibre-preserving dynamics, hidden transitions, deck symmetries
/-- A symmetry of the fibres: an invertible operator, both directions of which
leave the surface fixed. -/
structure FibreAutomorphism (proj : State → Coarse) where
  /-- The forward map. -/
  forward : State → State
  /-- Its inverse. -/
  backward : State → State
  /-- The forward map fixes the surface. -/
  forward_surface : SurfaceInvariant proj forward
  /-- The backward map fixes the surface. -/
  backward_surface : SurfaceInvariant proj backward
  /-- `backward` undoes `forward`. -/
  left_inv : ∀ x, backward (forward x) = x
  /-- `forward` undoes `backward`. -/
  right_inv : ∀ x, forward (backward x) = x

/-- A fibre automorphism that moves a point gives a hidden transition. -/
theorem hiddenTransition_of_fibreAutomorphism {proj : State → Coarse}
    (a : FibreAutomorphism proj) {x : State} (hx : a.forward x ≠ x) :
    HiddenTransition proj a.forward x :=
  hiddenTransition_of_surfaceInvariant a.forward_surface hx

/-- A nontrivial fibre symmetry blocks injectivity of the projection. -/
theorem not_injective_of_fibreAutomorphism {proj : State → Coarse}
    (a : FibreAutomorphism proj) {x : State} (hx : a.forward x ≠ x) :
    ¬ Function.Injective proj :=
  not_injective_of_hiddenTransition (hiddenTransition_of_fibreAutomorphism a hx)

end Epistemic
