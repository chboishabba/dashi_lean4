        → (κ′P : (γ : 𝔸 → ʃ A) → (p′ : (x : 𝔸) → P (γ x)) → P (κ′ γ))   
        → ((x : ʃ A) → (pₓ : P x) → transport P (p2 x) pₓ ≈ κ′P (const x) (const pₓ))
