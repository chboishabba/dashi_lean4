namespace Epistemic

open Wikidata

/-- Claims about value types and about a qualified knowledge base at an instant. -/
inductive ValueClaim
  | quantityAgrees (q r : Quantity)
  | timeAgrees (p : TimePrecision) (t u : TimeValue)
  | coordinateCovers (c d : Coordinate)
  | instanceInCore (x c : Qid)
  | instanceInForce (x c : Qid)
  deriving DecidableEq, Repr, Inhabited

namespace ValueClaim

/-- What a value claim means, relative to a qualified knowledge base and an
instant. -/
def Holds (fkb : FullKB) (now : TimeValue) : ValueClaim → Prop
  | quantityAgrees q r => Quantity.SameUnit q r ∧ ∃ x : ℚ, q.Mem x ∧ r.Mem x
  | timeAgrees p t u => TimeValue.AgreeAt p t u
  | coordinateCovers c d => Coordinate.covers c d = true
  | instanceInCore x c => InstanceOf fkb.core x c
  | instanceInForce x c => InstanceOf (fkb.temporalSlice now).core x c

/-- The executable checker. -/
def check (fkb : FullKB) (now : TimeValue) : ValueClaim → Bool
  | quantityAgrees q r => Quantity.overlaps q r
  | timeAgrees p t u => decide (TimeValue.AgreeAt p t u)
  | coordinateCovers c d => Coordinate.covers c d
  | instanceInCore x c => isInstanceOf fkb.core x c
  | instanceInForce x c => isInstanceOf (fkb.temporalSlice now).core x c

/-- **Checker exactness on the value surfaces.** -/
theorem check_iff (fkb : FullKB) (now : TimeValue) (cl : ValueClaim) :
    cl.check fkb now = true ↔ cl.Holds fkb now := by
  cases cl with
  | quantityAgrees q r => exact Quantity.overlaps_iff q r
  | timeAgrees p t u => exact decide_eq_true_iff
  | coordinateCovers c d => exact Iff.rfl
  | instanceInCore x c => exact isInstanceOf_iff fkb.core x c
  | instanceInForce x c => exact isInstanceOf_iff (fkb.temporalSlice now).core x c

theorem not_holds_of_check_false {fkb : FullKB} {now : TimeValue} {cl : ValueClaim}
    (h : cl.check fkb now = false) : ¬ cl.Holds fkb now := by
  intro hc
  rw [(check_iff fkb now cl).2 hc] at h
  exact Bool.noConfusion h

end ValueClaim

/-! ## Certificates -/

/-- An imported result about a qualified knowledge base, read at an instant. -/
structure ValueCertificate where
  fkb : FullKB
  now : TimeValue
  claim : ValueClaim
  sourceMatched : Bool
  references : List String

namespace ValueCertificate

/-- Did the checker accept? -/
def accepted (cert : ValueCertificate) : Bool := cert.claim.check cert.fkb cert.now

/-- Fail-closed evidence state. -/
def state (cert : ValueCertificate) : Trit := receiptState cert.sourceMatched cert.accepted

theorem state_eq_supported_iff (cert : ValueCertificate) :
    cert.state = Trit.supported ↔
      cert.sourceMatched = true ∧ cert.claim.Holds cert.fkb cert.now := by
  rw [state, receiptState_eq_supported_iff]
  exact and_congr_right fun _ => ValueClaim.check_iff cert.fkb cert.now cert.claim

/-- **Supported evidence is really backed** on the value surfaces too. -/
theorem holds_of_supported {cert : ValueCertificate} (h : cert.state = Trit.supported) :
    cert.claim.Holds cert.fkb cert.now :=
  ((state_eq_supported_iff cert).1 h).2

/-- **Fail-closed import**: a failed checker or an unmatched source is
`unresolved`, never a refutation. -/
theorem state_ne_contradicted (cert : ValueCertificate) : cert.state ≠ Trit.contradicted :=
  receiptState_ne_contradicted _ _

theorem state_of_checker_failure {cert : ValueCertificate} (h : cert.accepted = false) :
    cert.state = Trit.unresolved := by
  rw [state, h, receiptState_of_checker_failure]

/-- A checker failure is a certified negative about this base at this instant. -/
theorem not_holds_of_check_false {cert : ValueCertificate} (h : cert.accepted = false) :
    ¬ cert.claim.Holds cert.fkb cert.now :=
  ValueClaim.not_holds_of_check_false h

end ValueCertificate

/-! ## The temporal coordinate is directional -/

/-- **Support at an instant transfers to the whole base.**  The temporal slice cut
out by the qualifiers is a slice, so a fact in force is a fact of the base. -/
theorem inForce_supported_imp_core_supported {fkb : FullKB} {now : TimeValue} {x c : Qid}
    {refs : List String} (hnormal : AllNormal fkb.core)
    (h : (⟨fkb, now, ValueClaim.instanceInForce x c, true, refs⟩ : ValueCertificate).state
      = Trit.supported) :
    (⟨fkb, now, ValueClaim.instanceInCore x c, true, refs⟩ : ValueCertificate).state
      = Trit.supported := by
  rw [ValueCertificate.state_eq_supported_iff] at h ⊢
  exact ⟨rfl, FullKB.instanceOf_of_temporalSlice fkb now hnormal h.2⟩

/-- **Support does not transfer down to the instant.**  On the expired-claim base
the core fact is supported and the same fact at 2020 is not: a query answer is not
an answer about now. -/
theorem core_support_does_not_transfer_to_the_instant :
    (⟨expiredKB, y2020, ValueClaim.instanceInCore ceres planet, true, ["catalogue"]⟩ :
        ValueCertificate).state = Trit.supported ∧
      (⟨expiredKB, y2020, ValueClaim.instanceInForce ceres planet, true, ["catalogue"]⟩ :
        ValueCertificate).state = Trit.unresolved := by
  constructor
  · rw [ValueCertificate.state_eq_supported_iff]
    exact ⟨rfl, (isInstanceOf_iff _ ceres planet).1 (by decide)⟩
  · exact ValueCertificate.state_of_checker_failure (by decide)

/-- **A coarse time record is not fine support.**  Two values agreeing at year
precision give a supported year-precision claim and an unresolved day-precision
claim about the very same pair. -/
theorem time_support_does_not_refine :
    ∃ t u : TimeValue,
      (⟨⟨[], []⟩, t, ValueClaim.timeAgrees TimePrecision.year t u, true, []⟩ :
        ValueCertificate).state = Trit.supported ∧
      (⟨⟨[], []⟩, t, ValueClaim.timeAgrees TimePrecision.day t u, true, []⟩ :
        ValueCertificate).state = Trit.unresolved := by
  refine ⟨⟨1503, 1, 1, TimePrecision.day, gregorian⟩,
          ⟨1503, 6, 15, TimePrecision.day, gregorian⟩, ?_, ?_⟩
  · rw [ValueCertificate.state_eq_supported_iff]
    exact ⟨rfl, ⟨rfl, rfl⟩⟩
  · exact ValueCertificate.state_of_checker_failure (by decide)

/-- **A unit mismatch is a certified negative, not an ignorance.**  Comparing one
metre with one mile fails the checker, and the failure is exact. -/
theorem unit_mismatch_is_certified :
    ¬ (ValueClaim.quantityAgrees (Quantity.exact 1 Quantity.metre)
        (Quantity.exact 1 Quantity.mile)).Holds ⟨[], []⟩ (default : TimeValue) := by
  refine ValueClaim.not_holds_of_check_false ?_
  simp [ValueClaim.check, Quantity.overlaps, Quantity.exact, Quantity.metre, Quantity.mile]

end Epistemic
