  hasInverse : (x : ⟨ M ⟩) → Type ℓ
  hasInverse x = Σ[ -x ∈ ⟨ M ⟩ ] (-x · x ≡ ε) × (x · -x ≡ ε)

  isPropHasInverse : ∀ x → isProp (hasInverse x)
  isPropHasInverse x (y , invly , _) (z , _ , invrz)
    = Σ≡Prop (λ a → isProp× (is-set (a · x) ε)
                             (is-set (x · a) ε))
