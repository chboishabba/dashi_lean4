import RequestProject.OntologyTopology

/-!
# Comparing the two pullbacks: when is the fibre product of ontologies a fibre
product of spaces?

*Wikidata: pullback (Q1397439), homeomorphism (Q179700), specialization order
(Q7574764), Alexandrov topology (Q3532117), counterexample (Q490371).*

`RequestProject.OntologyTopology` produces, for a cospan `F : X ⟶ Z`,
`G : Y ⟶ Z` of ontologies, two spaces with the *same points*:

* `Ontology.ItemSpace (Ontology.pullback F G)` — the item space of the fibre
  product **ontology**, and
* `Ontology.PullbackSpace F G` — the fibre product of the two item **spaces**,
  taken in `TopCat`,

compared by the continuous bijection `Ontology.pbCompare`.  That file leaves
open whether the comparison is a homeomorphism.  It is not, and this file
settles the question in both directions.

* `Ontology.specializes_iff_subclassOf` — in an item space, specialization *is*
  the `subclass of` order.  This identifies the topology of the fibre product
  with the order generated by *simultaneous* subclass steps, and the subspace
  topology with the order of *componentwise* subclass steps.
* `Ontology.subclassOf_pullback_componentwise` — a subclass step in the fibre
  product is a subclass step in each component (the easy inclusion), and
* `Ontology.isHomeomorph_pbCompare_of_componentwise` — when the converse holds,
  `pbCompare` is a homeomorphism.
* `Ontology.exists_not_isHomeomorph_pbCompare` — the converse can fail, so the
  ontology-level fibre product is genuinely finer than the topological one.  The
  witness `Ontology.Refinement` is a three-item chain `2 ⊂ 1 ⊂ 0` mapped
  identically into a reference ontology, glued to a two-item ontology
  `true ⊂ false` sitting over `2` and `0`: the pair `(2, true)` is below
  `(0, false)` in each component, but reaching it needs *two* steps on the left
  and *one* on the right, and no simultaneous chain exists.
-/

open CategoryTheory CategoryTheory.Limits Topology

namespace Wikidata
namespace Ontology

universe u

variable {I J K : Type*}

/-! ## Specialization is the subclass order -/

/-- **Specialization in an item space is the `subclass of` order.** `b ⤳ a`
holds exactly when `b` is a subclass of `a`: every open set containing `a`
contains all of its subclasses, and `downSet O a` is the smallest open set
containing `a`. -/
theorem specializes_iff_subclassOf {O : Ontology I} {a b : I} :
    toItemSpace O b ⤳ toItemSpace O a ↔ O.SubclassOf b a := by
  constructor
  · intro h
    exact (specializes_iff_forall_open.1 h) (downSet O a) (isOpen_downSet O a)
      (self_mem_downSet O a)
  · intro h
    exact specializes_iff_forall_open.2 fun U hU ha =>
      (isOpen_itemSpace_iff U).1 hU ha h

/-! ## The easy inclusion -/

variable {X Y Z : Ont.{u}}

/-- The topological fibre product of two item spaces is again Alexandrov-discrete. -/
instance instAlexandrovDiscretePullbackSpace (F : X ⟶ Z) (G : Y ⟶ Z) :
    AlexandrovDiscrete (PullbackSpace F G) := Subtype.instAlexandrovDiscrete

/-- A subclass step in the fibre product is a subclass step in each component. -/
theorem subclassOf_pullback_componentwise (F : X ⟶ Z) (G : Y ⟶ Z)
    {p q : PullbackCarrier F G} (h : (pullback F G).SubclassOf p q) :
    X.str.SubclassOf p.1.1 q.1.1 ∧ Y.str.SubclassOf p.1.2 q.1.2 :=
  ⟨(pullback.fst F G).subclassOf h, (pullback.snd F G).subclassOf h⟩

/-- The property that makes the two pullbacks agree: a pair of subclass
relations, one in each component, is realised by a chain of *simultaneous*
subclass steps in the fibre product. -/
def PullbackComponentwise (F : X ⟶ Z) (G : Y ⟶ Z) : Prop :=
  ∀ p q : PullbackCarrier F G, X.str.SubclassOf p.1.1 q.1.1 →
    Y.str.SubclassOf p.1.2 q.1.2 → (pullback F G).SubclassOf p q

/-- **When simultaneous chains suffice, the comparison map is a homeomorphism**:
the item space of the fibre product ontology *is* the topological fibre
product. -/
theorem isHomeomorph_pbCompare_of_componentwise (F : X ⟶ Z) (G : Y ⟶ Z)
    (h : PullbackComponentwise F G) : IsHomeomorph (pbCompare F G) := by
  refine ⟨continuous_pbCompare F G, ?_, bijective_pbCompare F G⟩
  intro U hU
  rw [isOpen_iff_forall_specializes]
  rintro q' q hqq ⟨p, hp, rfl⟩
  obtain ⟨p', rfl⟩ := (bijective_pbCompare F G).surjective q'
  have hval : (pbCompare F G p').1 ⤳ (pbCompare F G p).1 :=
    (IsEmbedding.subtypeVal (p := fun r : ItemSpace X.str × ItemSpace Y.str =>
      F.map r.1 = G.map r.2)).isInducing.specializes_iff.2 hqq
  refine ⟨p', ?_, rfl⟩
  have h1 : X.str.SubclassOf p'.1.1 p.1.1 :=
    specializes_iff_subclassOf.1 hval.fst
  have h2 : Y.str.SubclassOf p'.1.2 p.1.2 :=
    specializes_iff_subclassOf.1 hval.snd
  exact (isOpen_itemSpace_iff U).1 hU hp (h p' p h1 h2)

/-! ## The comparison map is not always a homeomorphism -/

namespace Refinement

/-- A relation that strictly decreases a natural-number rank has no cycles. -/
theorem antisymm_of_rank {P : I → I → Prop} (r : I → ℕ)
    (hr : ∀ a b, P a b → r b < r a) {a b : I} (hab : Relation.ReflTransGen P a b)
    (hba : Relation.ReflTransGen P b a) : a = b := by
  have key : ∀ {x y : I}, Relation.ReflTransGen P x y → r y ≤ r x := by
    intro x y hxy
    induction hxy with
    | refl => exact le_rfl
    | tail _ hcd ih => exact le_trans (le_of_lt (hr _ _ hcd)) ih
  rcases Relation.ReflTransGen.cases_tail hab with hba' | ⟨c, hac, hcb⟩
  · exact hba'.symm
  · exact absurd (key hba) (not_le.2 (lt_of_lt_of_le (hr _ _ hcb) (key hac)))

/-- The left-hand ontology: the chain `2 ⊂ 1 ⊂ 0`, with only *single* steps
asserted. -/
def left : Ontology ℕ where
  P279 a b := a = b + 1 ∧ a ≤ 2
  P31 _ _ := False
  level _ := 1
  level_P31 h := h.elim
  level_P279 _ := rfl
  P279_isClass _ := Nat.zero_lt_one
  P279_antisymm := antisymm_of_rank (fun a => a)
    (fun _ b h => by obtain ⟨rfl, -⟩ := h; exact Nat.lt_succ_self b)

/-- The reference ontology: the same three items, but with the *transitive*
statement `2 ⊂ 0` asserted directly as well. -/
def base : Ontology ℕ where
  P279 a b := b < a ∧ a ≤ 2
  P31 _ _ := False
  level _ := 1
  level_P31 h := h.elim
  level_P279 _ := rfl
  P279_isClass _ := Nat.zero_lt_one
  P279_antisymm := antisymm_of_rank (fun a => a) (fun _ _ h => h.1)

/-- The right-hand ontology: two items, `true ⊂ false`, in a single step. -/
def right : Ontology Bool where
  P279 x y := x = true ∧ y = false
  P31 _ _ := False
  level _ := 1
  level_P31 h := h.elim
  level_P279 _ := rfl
  P279_isClass _ := Nat.zero_lt_one
  P279_antisymm := antisymm_of_rank (fun x => if x then 1 else 0)
    (fun _ _ h => by obtain ⟨rfl, rfl⟩ := h; exact Nat.zero_lt_one)

/-- The left-hand ontology as an object of `Ont`. -/
abbrev leftOnt : Ont.{0} := ⟨ℕ, left⟩
/-- The reference ontology as an object of `Ont`. -/
abbrev baseOnt : Ont.{0} := ⟨ℕ, base⟩
/-- The right-hand ontology as an object of `Ont`. -/
abbrev rightOnt : Ont.{0} := ⟨Bool, right⟩

/-- The left leg: the identity, which turns each single step into a step of the
reference ontology. -/
def leftMap : leftOnt ⟶ baseOnt where
  map (a : ℕ) := (a : ℕ)
  map_P279 := by rintro a b ⟨rfl, hle⟩; exact ⟨Nat.lt_succ_self b, hle⟩
  map_P31 h := h.elim

/-- The right leg: `true ↦ 2`, `false ↦ 0`, using the asserted statement
`2 ⊂ 0` of the reference ontology. -/
def rightMap : rightOnt ⟶ baseOnt where
  map (x : Bool) := if x then (2 : ℕ) else (0 : ℕ)
  map_P279 := by
    rintro a b ⟨rfl, rfl⟩
    exact ⟨by norm_num, by norm_num⟩
  map_P31 h := h.elim

/-- The matched pair `(0, false)`. -/
def bot : PullbackCarrier leftMap rightMap := ⟨((0 : ℕ), (false : Bool)), rfl⟩
/-- The matched pair `(2, true)`. -/
def top : PullbackCarrier leftMap rightMap := ⟨((2 : ℕ), (true : Bool)), rfl⟩

/-- `(0, false)` has no predecessor in the fibre product: a simultaneous step
into it would have to be `1` on the left and `true` on the right, and `(1, true)`
is not a matched pair. -/
theorem no_pred (q : PullbackCarrier leftMap rightMap) :
    ¬ (pullback leftMap rightMap).P279 q bot := by
  rintro ⟨h1, h2⟩
  obtain ⟨hq1, -⟩ := h1
  obtain ⟨hq2, -⟩ := h2
  have hone : (q.1.1 : ℕ) = 1 := hq1
  have h3 : (q.1.1 : ℕ) = rightMap.map q.1.2 := q.2
  rw [hq2] at h3
  have h4 : rightMap.map true = (2 : ℕ) := rfl
  rw [h4, hone] at h3
  simp at h3

/-- Hence `{(0, false)}` is open in the item space of the fibre product
ontology. -/
theorem isOpen_singleton_bot :
    IsOpen ({bot} : Set (ItemSpace (pullback leftMap rightMap))) := by
  rw [isOpen_itemSpace_iff]
  rintro a b ha hba
  simp only [Set.mem_singleton_iff] at ha ⊢
  subst ha
  rcases Relation.ReflTransGen.cases_tail hba with h | ⟨c, -, hc⟩
  · exact h.symm
  · exact absurd hc (no_pred c)

/-- In the topological fibre product, `(2, true)` specializes to `(0, false)`:
`2` is a subclass of `0` on the left and `true` of `false` on the right. -/
theorem specializes_top_bot :
    pbCompare leftMap rightMap top ⤳ pbCompare leftMap rightMap bot := by
  have hleft : left.SubclassOf 2 0 :=
    Relation.ReflTransGen.head (b := 1) ⟨rfl, by norm_num⟩
      (Relation.ReflTransGen.single ⟨rfl, by norm_num⟩)
  have hright : right.SubclassOf true false := Relation.ReflTransGen.single ⟨rfl, rfl⟩
  refine (IsEmbedding.subtypeVal
    (p := fun r : ItemSpace leftOnt.str × ItemSpace rightOnt.str =>
      leftMap.map r.1 = rightMap.map r.2)).isInducing.specializes_iff.1 ?_
  exact Specializes.prod (specializes_iff_subclassOf.2 hleft)
    (specializes_iff_subclassOf.2 hright)

/-- So `{(0, false)}` is **not** open in the topological fibre product: every
open set containing it contains `(2, true)`. -/
theorem not_isOpen_image_singleton_bot :
    ¬ IsOpen (pbCompare leftMap rightMap ''
      ({bot} : Set (ItemSpace (pullback leftMap rightMap)))) := by
  intro hU
  have hmem : pbCompare leftMap rightMap bot ∈
      pbCompare leftMap rightMap '' ({bot} : Set (ItemSpace (pullback leftMap rightMap))) :=
    ⟨bot, rfl, rfl⟩
  obtain ⟨x, hx, hx2⟩ := specializes_iff_forall_open.1 specializes_top_bot _ hU hmem
  simp only [Set.mem_singleton_iff] at hx
  subst hx
  have hbt : bot = top := (bijective_pbCompare leftMap rightMap).injective hx2
  have h0 : (0 : ℕ) = 2 := congrArg (fun p : PullbackCarrier leftMap rightMap => p.1.1) hbt
  omega

/-- **The comparison map of this cospan is not open**, hence not a
homeomorphism, even though it is a continuous bijection. -/
theorem not_isHomeomorph : ¬ IsHomeomorph (pbCompare leftMap rightMap) := fun h =>
  not_isOpen_image_singleton_bot (h.isOpenMap _ isOpen_singleton_bot)

end Refinement

/-- **The item space of a fibre product of ontologies is strictly finer than the
topological fibre product of the item spaces**, in general: there is a cospan of
ontologies whose comparison map `Ontology.pbCompare` is a continuous bijection
but not a homeomorphism. -/
theorem exists_not_isHomeomorph_pbCompare :
    ∃ (X Y Z : Ont.{0}) (F : X ⟶ Z) (G : Y ⟶ Z),
      Continuous (pbCompare F G) ∧ Function.Bijective (pbCompare F G) ∧
        ¬ IsHomeomorph (pbCompare F G) :=
  ⟨_, _, _, Refinement.leftMap, Refinement.rightMap,
    continuous_pbCompare _ _, bijective_pbCompare _ _, Refinement.not_isHomeomorph⟩

end Ontology
end Wikidata
