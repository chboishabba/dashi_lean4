/-
# Row A — the trajectory produced by the literal shell bound

`ZeroMassKernelVanishing` and `AveragingKernelNormalization` produce a *shell*
statement from kernel data,

    β_j ≥ 1/16777216 > 0    for every shell index and admissible history,

and `RunningCouplingWindow` shows what a uniformly positive shell coefficient
does to the trajectory `u_{j+1} = u_j + β_j`, `g_j² = u_j⁻¹`.  This file welds
the two: the running coupling of the literal one-loop shell coefficient built
from Bałaban-shaped kernel data is asymptotically free, stays strictly positive
at every finite scale, and has a summable quartic debt.

Main results:

* `A1_trajectory_from_kernels` — asymptotic freedom `g_j² → 0` and summability
  `Σ_j g_j⁴ < ∞`, from the literal kernel hypothesis package alone;
* `A1_trajectory_debt_summable` — with an interaction sector obeying
  `|β_{Int,j}| ≤ C·g_j⁴`, the total interaction debt of the whole trajectory is
  finite.

**Honest status.**  Row A is not closed.  This is the trajectory consequence of
the shell bound; the identification of the kernel family with Bałaban's printed
averaging / constrained-projection objects and the five remainder-channel
majorants remain hypotheses of the shell bound itself.
-/
import RequestProject.YangMills.AveragingKernelNormalization
import RequestProject.YangMills.RunningCouplingWindow

namespace YangMills

open Filter Topology

/-- **The trajectory generated by the literal kernel-based shell coefficient is
asymptotically free with summable quartic debt.**

The shell coefficients are the ones `A1_beta_pos_ward_from_kernels` bounds below;
the recursion `u_{j+1} = u_j + β_j` is the standard inverse-squared-coupling
recursion.  No new analytic input is used: the positivity of the shell
coefficient alone forces `g_j² ≤ (u₀ + j/16777216)⁻¹`. -/
theorem A1_trajectory_from_kernels
    {ι κ ξ ζ : Type*} [Fintype ι] [Fintype κ] [Fintype ξ] [Fintype ζ]
    {Adm : (ℕ → ℝ) → Prop} {g : ℕ → ℝ} {f R M MW : ℝ}
    {Kk : ℕ → (ℕ → ℝ) → Fin 4 → ξ → ℝ} {dd : ℕ → (ℕ → ℝ) → Fin 4 → ξ → (Fin 4 → ℝ)}
    {KW : ℕ → (ℕ → ℝ) → Fin 4 → Fin 4 → ζ → ℝ}
    {dW : ℕ → (ℕ → ℝ) → Fin 4 → Fin 4 → ζ → (Fin 4 → ℝ)}
    {lamDet : ℕ → (ℕ → ℝ) → ι → ℝ} {lamGauge : ℕ → (ℕ → ℝ) → κ → ℝ}
    {aInt aChart aLoc : ℕ → (ℕ → ℝ) → ℕ → ℝ}
    {AInt AChart ALoc : ℕ → ℝ} {N : ℕ} {LamDet LamGauge theta : ℝ}
    (hR : 0 ≤ R) (hM : 0 ≤ M) (hMW : 0 ≤ MW)
    (hzero : ∀ j h a, ∑ i, Kk j h a i = 0)
    (hd : ∀ j h a i mu, |dd j h a i mu| ≤ R)
    (hmass : ∀ j h a, kernelMass (Kk j h a) ≤ M)
    (hsmallK : linearVanishingConstant R M ≤ 1 / 2)
    (hmassW : ∀ j h a b, kernelMass (KW j h a b) ≤ MW)
    (hLd : ∀ j h i, |lamDet j h i| ≤ LamDet)
    (hLg : ∀ j h i, |lamGauge j h i| ≤ LamGauge)
    (hAInt : ∀ j h n, |aInt j h n| ≤ AInt n)
    (hAChart : ∀ j h n, |aChart j h n| ≤ AChart n)
    (hALoc : ∀ j h n, |aLoc j h n| ≤ ALoc n)
    (hsmall : ∀ j h, Adm h → 0 ≤ h j ∧ h j ≤ theta ∧
        h j * LamDet ≤ theta ∧ h j * LamGauge ≤ theta)
    (hth : theta < 1) (hth0 : 0 ≤ theta)
    (hadm : Adm g) (hg0 : ∀ j, 0 ≤ g j)
    (hgg : ∀ j, g j ≤ criticalCoupling (1 / 8388608 : ℝ)
      (Cbeta (sourceChannelCoefficient (Fintype.card ι) (Fintype.card κ)
        LamDet LamGauge theta AInt AChart ALoc N)))
    {u : ℕ → ℝ} (hu0 : 0 < u 0)
    (hstep : ∀ j, u (j + 1) = u j + shellBetaOfSources
      (fun j' h => literalOneLoopIntegrand
        (sourceVariationMatrix f 1 (diagCosSymbolMatrix (Kk j' h) (dd j' h)))
        (cosSymbolMatrix (KW j' h) (dW j' h)))
      lamDet lamGauge aInt aChart aLoc N j g) :
    Tendsto (couplingSq u) atTop (𝓝 0) ∧ Summable fun j => couplingSq u j ^ 2 := by
  have hb : ∀ j, (1 : ℝ) / 16777216 ≤ shellBetaOfSources
      (fun j' h => literalOneLoopIntegrand
        (sourceVariationMatrix f 1 (diagCosSymbolMatrix (Kk j' h) (dd j' h)))
        (cosSymbolMatrix (KW j' h) (dW j' h)))
      lamDet lamGauge aInt aChart aLoc N j g := fun j =>
    A1_beta_pos_ward_from_kernels hR hM hMW hzero hd hmass hsmallK hmassW hLd hLg
      hAInt hAChart hALoc hsmall hth hth0 hadm hg0 hgg j
  have hbm : (0 : ℝ) < 1 / 16777216 := by norm_num
  exact ⟨tendsto_couplingSq_zero hstep hb hbm hu0, summable_couplingSq_sq hstep hb hbm hu0⟩

/-- **The whole interaction debt of the trajectory is finite.**  Under the same
kernel hypothesis package, any interaction sector obeying the quartic bound
`|β_{Int,j}| ≤ C·g_j⁴` sums absolutely along the trajectory. -/
theorem A1_trajectory_debt_summable
    {ι κ ξ ζ : Type*} [Fintype ι] [Fintype κ] [Fintype ξ] [Fintype ζ]
    {Adm : (ℕ → ℝ) → Prop} {g : ℕ → ℝ} {f R M MW C : ℝ}
    {Kk : ℕ → (ℕ → ℝ) → Fin 4 → ξ → ℝ} {dd : ℕ → (ℕ → ℝ) → Fin 4 → ξ → (Fin 4 → ℝ)}
    {KW : ℕ → (ℕ → ℝ) → Fin 4 → Fin 4 → ζ → ℝ}
    {dW : ℕ → (ℕ → ℝ) → Fin 4 → Fin 4 → ζ → (Fin 4 → ℝ)}
    {lamDet : ℕ → (ℕ → ℝ) → ι → ℝ} {lamGauge : ℕ → (ℕ → ℝ) → κ → ℝ}
    {aInt aChart aLoc : ℕ → (ℕ → ℝ) → ℕ → ℝ}
    {AInt AChart ALoc : ℕ → ℝ} {N : ℕ} {LamDet LamGauge theta : ℝ}
    (hR : 0 ≤ R) (hM : 0 ≤ M) (hMW : 0 ≤ MW)
    (hzero : ∀ j h a, ∑ i, Kk j h a i = 0)
    (hd : ∀ j h a i mu, |dd j h a i mu| ≤ R)
    (hmass : ∀ j h a, kernelMass (Kk j h a) ≤ M)
    (hsmallK : linearVanishingConstant R M ≤ 1 / 2)
    (hmassW : ∀ j h a b, kernelMass (KW j h a b) ≤ MW)
    (hLd : ∀ j h i, |lamDet j h i| ≤ LamDet)
    (hLg : ∀ j h i, |lamGauge j h i| ≤ LamGauge)
    (hAInt : ∀ j h n, |aInt j h n| ≤ AInt n)
    (hAChart : ∀ j h n, |aChart j h n| ≤ AChart n)
    (hALoc : ∀ j h n, |aLoc j h n| ≤ ALoc n)
    (hsmall : ∀ j h, Adm h → 0 ≤ h j ∧ h j ≤ theta ∧
        h j * LamDet ≤ theta ∧ h j * LamGauge ≤ theta)
    (hth : theta < 1) (hth0 : 0 ≤ theta)
    (hadm : Adm g) (hg0 : ∀ j, 0 ≤ g j)
    (hgg : ∀ j, g j ≤ criticalCoupling (1 / 8388608 : ℝ)
      (Cbeta (sourceChannelCoefficient (Fintype.card ι) (Fintype.card κ)
        LamDet LamGauge theta AInt AChart ALoc N)))
    {u : ℕ → ℝ} (hu0 : 0 < u 0)
    (hstep : ∀ j, u (j + 1) = u j + shellBetaOfSources
      (fun j' h => literalOneLoopIntegrand
        (sourceVariationMatrix f 1 (diagCosSymbolMatrix (Kk j' h) (dd j' h)))
        (cosSymbolMatrix (KW j' h) (dW j' h)))
      lamDet lamGauge aInt aChart aLoc N j g)
    {betaInt : ℕ → ℝ} (hdebt : ∀ j, |betaInt j| ≤ C * couplingSq u j ^ 2) :
    Summable betaInt := by
  have hb : ∀ j, (1 : ℝ) / 16777216 ≤ shellBetaOfSources
      (fun j' h => literalOneLoopIntegrand
        (sourceVariationMatrix f 1 (diagCosSymbolMatrix (Kk j' h) (dd j' h)))
        (cosSymbolMatrix (KW j' h) (dW j' h)))
      lamDet lamGauge aInt aChart aLoc N j g := fun j =>
    A1_beta_pos_ward_from_kernels hR hM hMW hzero hd hmass hsmallK hmassW hLd hLg
      hAInt hAChart hALoc hsmall hth hth0 hadm hg0 hgg j
  exact summable_interactionDebt hstep hb (by norm_num) hu0 hdebt

end YangMills
