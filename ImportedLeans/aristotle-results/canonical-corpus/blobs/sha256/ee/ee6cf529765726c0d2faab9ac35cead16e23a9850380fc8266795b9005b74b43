      in has-left-inverse f⁻¹
           by (λ a → ι-fiber ⁎
                       contraction (proof-of-contractibility (f a))
                       (a is-in-the-fiber-by refl))
         and-right-inverse f⁻¹
           by (λ b → as-equality-in-the-codomain
                       (center (proof-of-contractibility b))
                       ⁻¹)


