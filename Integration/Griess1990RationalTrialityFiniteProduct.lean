/-- Actual native 27D rational Cayley-Dickson Albert carrier, in the
EXISTING Lean order diag0/1/2, off12, off20, off01. -/
def toNative (v : Fin 27 → ℚ) :
    RationalAlbertNative.RationalAlbert :=
  ⟨v 0, v 1, v 2,
   ⟨⟨v 3, v 4, v 5, v 6⟩, ⟨v 7, v 8, v 9, v 10⟩⟩,
   ⟨⟨v 11, v 12, v 13, v 14⟩, ⟨v 15, v 16, v 17, v 18⟩⟩,
   ⟨⟨v 19, v 20, v 21, v 22⟩, ⟨v 23, v 24, v 25, v 26⟩⟩⟩

/-- Pull out one actual column of the source-to-native matrix. -/
def sourceBasisInNative (i : Fin 27) :
    RationalAlbertNative.RationalAlbert :=
  toNative (fun k => sourceToNative k i)

/-- THE finite, source-specific A4 basis product obligation:
the original 27D Griess source tensor, not a toy cubic, against the
literal native Jordan product. Its finite arithmetic is executable by
`native_decide` at the exact committed source. -/
theorem source_native_all_basis_products :
    ∀ i j : Fin 27,
      toNative (applyWitness sourceToNative (sourceTensor i j)) =
        RationalAlbertNative.RationalAlbert.jordanProduct
          (sourceBasisInNative i) (sourceBasisInNative j) := by
  native_decide

end Integration.Griess1990RationalTrialityFiniteProduct
