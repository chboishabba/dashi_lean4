namespace Epistemic.ContextErasure

/-! ## Rates compared without division -/

/-- Successes out of a total. -/
structure OutcomeCounts where
  successes : Nat
  total : Nat
  deriving DecidableEq, Repr, Inhabited

/-- Pooling two strata. -/
def combine (x y : OutcomeCounts) : OutcomeCounts :=
  ⟨x.successes + y.successes, x.total + y.total⟩

/-- A strict rate advantage, cross-multiplied so that no division is needed. -/
def Better (x y : OutcomeCounts) : Prop :=
  y.successes * x.total < x.successes * y.total

instance (x y : OutcomeCounts) : Decidable (Better x y) := by
  unfold Better; infer_instance

theorem better_irrefl (x : OutcomeCounts) : ¬ Better x x := by
  simp [Better]

theorem better_asymm {x y : OutcomeCounts} (h : Better x y) : ¬ Better y x := by
  unfold Better at h ⊢
  omega

/-- On positive totals the cross-multiplied comparison is the comparison of the
rates: `Better x y` says `x.successes / x.total > y.successes / y.total`. -/
theorem better_iff_rate_gt {x y : OutcomeCounts} (hx : 0 < x.total) (hy : 0 < y.total) :
    Better x y ↔
      (x.successes : Rat) / (x.total : Rat) > (y.successes : Rat) / (y.total : Rat) := by
  have hx' : (0 : Rat) < (x.total : Rat) := by exact_mod_cast hx
  have hy' : (0 : Rat) < (y.total : Rat) := by exact_mod_cast hy
  rw [gt_iff_lt, div_lt_div_iff₀ hy' hx']
  unfold Better
  constructor
  · intro h; exact_mod_cast h
  · intro h; exact_mod_cast h

/-! ## The kidney-stone table -/

/-- The retained context: stone size. -/
inductive Context
  | smallerStone
  | largerStone
  deriving DecidableEq, Repr, Inhabited

/-- The two treatments. -/
inductive Method
  | a
  | b
  deriving DecidableEq, Repr, Inhabited

/-- A two-context, two-method study. -/
structure Study where
  aSmall : OutcomeCounts
  bSmall : OutcomeCounts
  aLarge : OutcomeCounts
  bLarge : OutcomeCounts
  deriving DecidableEq, Repr, Inhabited

/-- The counts of a study in a given context for a given method. -/
def Study.counts (s : Study) : Context → Method → OutcomeCounts
  | Context.smallerStone, Method.a => s.aSmall
  | Context.smallerStone, Method.b => s.bSmall
  | Context.largerStone, Method.a => s.aLarge
  | Context.largerStone, Method.b => s.bLarge

/-- The margin of a method: its counts with the context erased. -/
def Study.marginal (s : Study) (m : Method) : OutcomeCounts :=
  combine (s.counts Context.smallerStone m) (s.counts Context.largerStone m)

/-- The kidney-stone table reported by Julious and Mullee. -/
def kidneyStone : Study :=
  { aSmall := ⟨81, 87⟩
    bSmall := ⟨234, 270⟩
    aLarge := ⟨192, 263⟩
    bLarge := ⟨55, 80⟩ }

theorem kidneyStone_marginals :
    kidneyStone.marginal Method.a = ⟨273, 350⟩ ∧
      kidneyStone.marginal Method.b = ⟨289, 350⟩ := ⟨rfl, rfl⟩

/-- **The direction reverses when the context is erased.**  Method A is strictly
better in each stratum, and strictly worse in the pooled margin. -/
theorem context_erasure_reverses_direction :
    (∀ c : Context, Better (kidneyStone.counts c Method.a) (kidneyStone.counts c Method.b)) ∧
      Better (kidneyStone.marginal Method.b) (kidneyStone.marginal Method.a) := by
  refine ⟨fun c => ?_, by decide⟩
  cases c <;> decide

/-- In particular the pooled comparison is not merely weaker than the stratified
one: it points the other way. -/
theorem marginal_contradicts_conditional :
    ¬ Better (kidneyStone.marginal Method.a) (kidneyStone.marginal Method.b) :=
  better_asymm context_erasure_reverses_direction.2

/-! ## Marginals carry no information about the conditional direction -/

/-- A study with the same marginals as `kidneyStone`, in which Method B is
strictly better in *both* strata. -/
def reversedTwin : Study :=
  { aSmall := ⟨0, 1⟩
    bSmall := ⟨1, 1⟩
    aLarge := ⟨273, 349⟩
    bLarge := ⟨288, 349⟩ }

theorem reversedTwin_marginals :
    reversedTwin.marginal Method.a = ⟨273, 350⟩ ∧
      reversedTwin.marginal Method.b = ⟨289, 350⟩ := ⟨rfl, rfl⟩

/-- **The margins determine nothing about the direction inside the contexts.**
Two studies agree on both marginal arms, yet one favours Method A in every
stratum and the other favours Method B in every stratum.  Erasing the context
therefore does not merely lose precision; it loses the direction. -/
theorem marginals_do_not_determine_conditional_direction :
    (∀ m : Method, kidneyStone.marginal m = reversedTwin.marginal m) ∧
      (∀ c : Context, Better (kidneyStone.counts c Method.a) (kidneyStone.counts c Method.b)) ∧
      (∀ c : Context, Better (reversedTwin.counts c Method.b) (reversedTwin.counts c Method.a)) := by
  refine ⟨fun m => ?_, fun c => ?_, fun c => ?_⟩
  · cases m <;> rfl
  · cases c <;> decide
  · cases c <;> decide

/-- Consequently no function of the two marginal arms computes the stratified
direction. -/
theorem no_conditional_direction_from_marginals
    (g : OutcomeCounts → OutcomeCounts → Bool) :
    ¬ ∀ (s : Study) (c : Context),
        decide (Better (s.counts c Method.a) (s.counts c Method.b)) =
          g (s.marginal Method.a) (s.marginal Method.b) := by
  intro h
  have h1 := h kidneyStone Context.smallerStone
  have h2 := h reversedTwin Context.smallerStone
  rw [show reversedTwin.marginal Method.a = kidneyStone.marginal Method.a from rfl,
    show reversedTwin.marginal Method.b = kidneyStone.marginal Method.b from rfl] at h2
  rw [← h1] at h2
  revert h2
  decide

end Epistemic.ContextErasure
