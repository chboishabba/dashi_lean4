  isOfHLevelRetractFromIso 2 RingStrIsoΣ $
  isSetΣ (str .is-set) (λ _ →
  isSetΣ (str .is-set) (λ _ →
  isSetΣ (isSet→ (isSet→ (str .is-set))) λ _ →
  isSetΣ (isSet→ (isSet→ (str .is-set))) (λ _ →
  isSetΣSndProp (isSet→ (str .is-set)) (λ _ → isPropIsRing _ _ _ _ _))))

