  field
    lift                 : PhaseLift
    phaseAdvance²        : HexPhaseAdvance² lift
    cone                 : ConeInterior {X = PhaseLift.State lift}
    conePreserved-step²  : ConeInteriorPreserved (step² lift) cone
    defect               : PhaseLift.State lift → Nat
