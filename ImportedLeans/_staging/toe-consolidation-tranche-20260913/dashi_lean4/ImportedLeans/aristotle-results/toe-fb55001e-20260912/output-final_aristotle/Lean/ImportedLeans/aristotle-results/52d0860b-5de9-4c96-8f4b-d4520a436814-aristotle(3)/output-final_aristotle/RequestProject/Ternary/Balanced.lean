namespace Ternary

/-! ## Orbits of an involution -/

open Finset

/-- The orbit of `x` under an involution `A`, as a two-element (or singleton)
finite set. -/
def pairOrbit {α : Type} [DecidableEq α] (A : α → α) (x : α) : Finset α := {x, A x}

-- @source DASHI Agda bridge (PR #555/#581/#582): antipodal class counts `5`, `14`, `9842`
/-- **Orbit count of an involution with a unique fixed point.**  If `A` is an
involution on a finite type whose only fixed point is `x₀`, then twice the
number of orbits is the cardinality of the type plus one. -/
theorem two_mul_card_pairImage {α : Type} [Fintype α] [DecidableEq α] (A : α → α)
    (hinv : Function.Involutive A) (x₀ : α) (hfix : ∀ x, A x = x ↔ x = x₀) :
    2 * (Finset.univ.image (pairOrbit A)).card = Fintype.card α + 1 := by
  classical
  set f : α → Finset α := pairOrbit A with hf
  set I := Finset.univ.image f with hI
  have hfiber : ∀ v : α, (Finset.univ.filter fun x => f x = f v) = f v := by
    intro v
    ext x
    simp only [Finset.mem_filter, Finset.mem_univ, true_and, hf, pairOrbit]
    constructor
    · intro h
      have hx : x ∈ ({x, A x} : Finset α) := by simp
      rwa [h] at hx
    · intro h
      simp only [Finset.mem_insert, Finset.mem_singleton] at h
      rcases h with h | h
      · rw [h]
      · subst h
        rw [hinv v]
        exact Finset.pair_comm _ _
  have hcard : Fintype.card α = ∑ b ∈ I, b.card := by
    have hfw := Finset.card_eq_sum_card_fiberwise (f := f) (s := (Finset.univ : Finset α))
      (t := I) (fun x _ => Finset.mem_image_of_mem f (Finset.mem_univ x))
    rw [Finset.card_univ] at hfw
    rw [hfw]
    refine Finset.sum_congr rfl ?_
    intro b hb
    rw [hI, Finset.mem_image] at hb
    obtain ⟨v, -, rfl⟩ := hb
    rw [hfiber v]
  have hfx0 : f x₀ = {x₀} := by simp [hf, pairOrbit, (hfix x₀).2 rfl]
  have hx0 : ({x₀} : Finset α) ∈ I := by
    rw [hI, ← hfx0]
    exact Finset.mem_image_of_mem f (Finset.mem_univ x₀)
  have hrest : ∀ b ∈ I \ {({x₀} : Finset α)}, b.card = 2 := by
    intro b hb
    rw [Finset.mem_sdiff, hI, Finset.mem_image] at hb
    obtain ⟨⟨v, -, rfl⟩, hne⟩ := hb
    have hvne : v ≠ A v := by
      intro h
      apply hne
      have hv : v = x₀ := (hfix v).1 h.symm
      subst hv
      simp [hf, pairOrbit, (hfix v).2 rfl]
    exact Finset.card_pair (by simpa [hf, pairOrbit] using hvne)
  have hsplit : ∑ b ∈ I, b.card = (∑ b ∈ I \ {({x₀} : Finset α)}, b.card) + 1 := by
    rw [Finset.sum_eq_sum_diff_singleton_add hx0 (fun b => b.card)]
    simp
  have hinter : ({({x₀} : Finset α)} ∩ I) = {({x₀} : Finset α)} :=
    Finset.inter_eq_left.2 (by simpa using hx0)
  have hsum : ∑ b ∈ I \ {({x₀} : Finset α)}, b.card = 2 * (I.card - 1) := by
    rw [Finset.sum_congr rfl hrest, Finset.sum_const, smul_eq_mul, Finset.card_sdiff, hinter]
    simp [Nat.mul_comm]
  have hIpos : 1 ≤ I.card := Finset.card_pos.2 ⟨_, hx0⟩
  rw [hcard, hsplit, hsum]
  omega

/-! ## The balanced ternary digit -/

-- @source DASHI Agda bridge (PR #555/#581/#582): the `3 ^ 9` balanced-ternary interaction carrier, `19683` states
/-- A balanced ternary digit: the negative pole, the centre, the positive pole. -/
inductive Trit
  | neg
  | zer
  | pos
  deriving DecidableEq, Fintype, Repr, Inhabited

namespace Trit

/-- The integer value of a digit. -/
def val : Trit → ℤ
  | neg => -1
  | zer => 0
  | pos => 1

-- @source DASHI Agda bridge (PR #555/#581/#582): the antipode, and `0` is not a pole
/-- The strict antipode: it exchanges the poles and fixes the centre. -/
def antipode : Trit → Trit
  | neg => pos
  | zer => zer
  | pos => neg

@[simp] theorem antipode_antipode (t : Trit) : antipode (antipode t) = t := by
  cases t <;> rfl

theorem antipode_involutive : Function.Involutive antipode := antipode_antipode

@[simp] theorem val_antipode (t : Trit) : (antipode t).val = -t.val := by
  cases t <;> rfl

/-- The centre is the *only* digit fixed by the antipode: in particular the
centre is not a pole. -/
theorem antipode_eq_self_iff (t : Trit) : antipode t = t ↔ t = zer := by
  cases t <;> simp [antipode]

theorem card_trit : Fintype.card Trit = 3 := rfl

end Trit

/-! ## Words of balanced ternary digits -/

-- @source DASHI Agda bridge (PR #555/#581/#582): the `3 ^ 9` balanced-ternary interaction carrier, `19683` states
/-- A word of `n` balanced ternary coordinates. -/
abbrev Word (n : ℕ) := Fin n → Trit

namespace Word

/-- The all-centre word. -/
def zero (n : ℕ) : Word n := fun _ => Trit.zer

/-- The coordinatewise antipode of a word. -/
def antipode {n : ℕ} (v : Word n) : Word n := fun i => (v i).antipode

/-- The aggregate: the sum of the coordinate values. -/
def aggregate {n : ℕ} (v : Word n) : ℤ := ∑ i, (v i).val

@[simp] theorem antipode_antipode {n : ℕ} (v : Word n) : antipode (antipode v) = v := by
  funext i; simp [antipode]

theorem antipode_involutive {n : ℕ} : Function.Involutive (antipode (n := n)) :=
  antipode_antipode

@[simp] theorem aggregate_antipode {n : ℕ} (v : Word n) :
    aggregate (antipode v) = -aggregate v := by
  simp [aggregate, antipode, Finset.sum_neg_distrib]

-- @source DASHI Agda bridge (PR #555/#581/#582): the antipode, and `0` is not a pole
/-- The all-centre word is the unique word fixed by the antipode. -/
theorem antipode_eq_self_iff {n : ℕ} (v : Word n) : antipode v = v ↔ v = zero n := by
  constructor
  · intro h
    funext i
    exact (Trit.antipode_eq_self_iff (v i)).1 (congrFun h i)
  · rintro rfl
    funext i
    rfl

end Word

-- @source DASHI Agda bridge (PR #555/#581/#582): the `3 ^ 9` balanced-ternary interaction carrier, `19683` states
/-- The `n`-coordinate carrier has `3 ^ n` states. -/
theorem card_word (n : ℕ) : Fintype.card (Word n) = 3 ^ n := by
  simp [Word, Trit.card_trit]

-- @source DASHI Agda bridge (PR #555/#581/#582): the `3 ^ 9` balanced-ternary interaction carrier, `19683` states
/-- The nine-coordinate carrier — the flattened `27 ^ 3` interaction cube — has
`19683` states. -/
theorem card_word_nine : Fintype.card (Word 9) = 19683 := by
  rw [card_word]
  norm_num

/-! ## Counting words by aggregate -/

-- @source DASHI Agda bridge (PR #555/#581/#582): the convolution row of `(x⁻¹ + 1 + x)^n`, and the aggregate-zero fibre of size `3139`
/-- The coefficient row of `(x⁻¹ + 1 + x)^n`, as a function of the aggregate:
`rowCount n k` is defined by the convolution recurrence. -/
def rowCount : ℕ → ℤ → ℕ
  | 0, k => if k = 0 then 1 else 0
  | n + 1, k => rowCount n (k + 1) + rowCount n k + rowCount n (k - 1)

private theorem sum_trit (f : Trit → ℕ) :
    ∑ t : Trit, f t = f Trit.neg + f Trit.zer + f Trit.pos := by
  show ∑ t ∈ (Finset.univ : Finset Trit), f t = _
  have huniv : (Finset.univ : Finset Trit) = {Trit.neg, Trit.zer, Trit.pos} := by decide
  rw [huniv]
  simp [Finset.sum_insert, Finset.mem_insert]
  ring

open Finset in
-- @source DASHI Agda bridge (PR #555/#581/#582): the convolution row of `(x⁻¹ + 1 + x)^n`, and the aggregate-zero fibre of size `3139`
/-- **The convolution row counts words.**  The number of `n`-coordinate words
whose aggregate is `k` is exactly `rowCount n k`. -/
theorem card_sumFibre (n : ℕ) (k : ℤ) :
    (Finset.univ.filter (fun v : Word n => Word.aggregate v = k)).card = rowCount n k := by
  induction n generalizing k with
  | zero =>
      simp only [rowCount, Word.aggregate, Finset.univ_eq_empty, Finset.sum_empty]
      split
      · simp_all
      · simp_all
        omega
  | succ n ih =>
      rw [Finset.card_filter]
      rw [Fintype.sum_equiv (Fin.succFunEquiv Trit n) _
        (fun p : (Fin n → Trit) × Trit =>
          if (p.2).val + ∑ i, (p.1 i).val = k then 1 else 0)
        (by
          intro v
          have h1 : Fin.natAdd n (0 : Fin 1) = Fin.last n := by ext; simp
          have h2 : ∀ x : Fin n, Fin.castAdd 1 x = x.castSucc := by intro x; ext; simp
          simp [Fin.succFunEquiv, Word.aggregate, Fin.sum_univ_castSucc, add_comm, h1, h2])]
      rw [Fintype.sum_prod_type_right]
      have key : ∀ t : Trit,
          (∑ w : Word n, if t.val + ∑ i, (w i).val = k then 1 else 0)
            = rowCount n (k - t.val) := by
        intro t
        rw [← ih (k - t.val), Finset.card_filter]
        refine Finset.sum_congr rfl (fun w _ => ?_)
        congr 1
        simp [Word.aggregate, eq_sub_iff_add_eq, add_comm]
      rw [sum_trit (fun t => ∑ w : Word n, if t.val + ∑ i, (w i).val = k then 1 else 0)]
      rw [key, key, key]
      simp [Trit.val, rowCount]

-- @source DASHI Agda bridge (PR #555/#581/#582): the convolution row of `(x⁻¹ + 1 + x)^n`, and the aggregate-zero fibre of size `3139`
/-- **The aggregate-zero fibre of the nine-coordinate carrier has `3139`
elements** — the ninth central trinomial coefficient, here as the cardinality of
the set of words it is supposed to count. -/
theorem card_sumFibre_nine_zero :
    (Finset.univ.filter (fun v : Word 9 => Word.aggregate v = 0)).card = 3139 := by
  rw [card_sumFibre]
  rfl

/-- The aggregate-zero fibre is very far from a singleton: cancelling to the
neutral aggregate says nothing about the fine state. -/
theorem card_sumFibre_nine_zero_ne_one :
    (Finset.univ.filter (fun v : Word 9 => Word.aggregate v = 0)).card ≠ 1 := by
  rw [card_sumFibre_nine_zero]
  decide

/-! ## The row totals the carrier -/

theorem abs_aggregate_le {n : ℕ} (v : Word n) : |Word.aggregate v| ≤ (n : ℤ) := by
  have h : |Word.aggregate v| ≤ ∑ i, |(v i).val| := Finset.abs_sum_le_sum_abs _ _
  refine h.trans ?_
  have hone : ∀ i : Fin n, |(v i).val| ≤ 1 := by
    intro i; cases v i <;> simp [Trit.val]
  calc ∑ i, |(v i).val| ≤ ∑ _i : Fin n, (1 : ℤ) := Finset.sum_le_sum (fun i _ => hone i)
    _ = (n : ℤ) := by simp

open Finset in
-- @source DASHI Agda bridge (PR #555/#581/#582): the convolution row of `(x⁻¹ + 1 + x)^n`, and the aggregate-zero fibre of size `3139`
/-- **The coefficient row totals the whole carrier**: summing `rowCount n` over
the possible aggregates recovers `3 ^ n`. -/
theorem sum_rowCount (n : ℕ) :
    ∑ k ∈ Finset.Icc (-(n : ℤ)) (n : ℤ), rowCount n k = 3 ^ n := by
  have hmem : Set.MapsTo (Word.aggregate (n := n)) ↑(Finset.univ : Finset (Word n))
      ↑(Finset.Icc (-(n : ℤ)) (n : ℤ)) := by
    intro v _
    have hb := abs_aggregate_le v
    rw [abs_le] at hb
    simp [hb.1, hb.2]
  have hfw := Finset.card_eq_sum_card_fiberwise hmem
  rw [Finset.card_univ, card_word] at hfw
  rw [hfw]
  exact Finset.sum_congr rfl (fun k _ => (card_sumFibre n k).symm)

/-! ## Antipodal orbits -/

/-- The antipodal classes of the `n`-coordinate carrier. -/
def orbits (n : ℕ) : Finset (Finset (Word n)) :=
  Finset.univ.image (pairOrbit Word.antipode)

-- @source DASHI Agda bridge (PR #555/#581/#582): antipodal class counts `5`, `14`, `9842`
/-- **The antipodal quotient of the `n`-coordinate carrier**: twice the number
of classes is `3 ^ n + 1`, because the antipode is an involution whose only
fixed point is the centre. -/
theorem two_mul_card_orbits (n : ℕ) : 2 * (orbits n).card = 3 ^ n + 1 := by
  rw [orbits, two_mul_card_pairImage Word.antipode Word.antipode_involutive (Word.zero n)
    Word.antipode_eq_self_iff, card_word]

-- @source DASHI Agda bridge (PR #555/#581/#582): antipodal class counts `5`, `14`, `9842`
/-- Two ternary coordinates: `9` states, `5` antipodal classes. -/
theorem card_orbits_two : (orbits 2).card = 5 := by
  have := two_mul_card_orbits 2
  omega

-- @source DASHI Agda bridge (PR #555/#581/#582): antipodal class counts `5`, `14`, `9842`
/-- One ternary cube: `27` states, `14` antipodal classes. -/
theorem card_orbits_three : (orbits 3).card = 14 := by
  have := two_mul_card_orbits 3
  omega

-- @source DASHI Agda bridge (PR #555/#581/#582): antipodal class counts `5`, `14`, `9842`
/-- The nine-coordinate carrier: `19683` states, `9842` antipodal classes. -/
theorem card_orbits_nine : (orbits 9).card = 9842 := by
  have := two_mul_card_orbits 9
  omega

/-! ## Orbits are a genuine quotient -/

theorem mem_pairOrbit_self {n : ℕ} (v : Word n) : v ∈ pairOrbit Word.antipode v := by
  simp [pairOrbit]

/-- A word and its antipode have the same class, and only those two words do. -/
theorem pairOrbit_eq_iff {n : ℕ} (v w : Word n) :
    pairOrbit Word.antipode v = pairOrbit Word.antipode w ↔ w = v ∨ w = Word.antipode v := by
  constructor
  · intro h
    have hw : w ∈ pairOrbit Word.antipode v := by
      rw [h]; exact mem_pairOrbit_self w
    simpa [pairOrbit] using hw
  · rintro (rfl | rfl)
    · rfl
    · simp only [pairOrbit, Word.antipode_antipode]
      exact Finset.pair_comm _ _

end Ternary
