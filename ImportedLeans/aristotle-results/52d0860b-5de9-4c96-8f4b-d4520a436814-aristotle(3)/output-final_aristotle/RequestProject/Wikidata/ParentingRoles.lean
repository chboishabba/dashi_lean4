import RequestProject.Wikidata.Parenting

/-!
# A flat role vocabulary against the relationship carrier

Practical parenting vocabularies are *flat*: a fixed list of role names
(biological, donor, surrogate, adoptive, step, foster, guardian, godparent), each
with a few derived predicates (is it genetic? legal? social?) and each tagging a
recorded parent edge.

This module reifies such a vocabulary and compares it with the twelve-coordinate
carrier of `RequestProject.Wikidata.Parenting`.  The comparison is exact in both
directions:

* the refinement `ParentRole.refine` **preserves the three source predicates**
  (`refine_preserves_genetic`, `refine_preserves_legal`, `refine_preserves_social`),
  so nothing the vocabulary says is lost;
* the flat *recorded parent* tag is **lossy**: donor and adoptive roles carry the
  same tag and disagree on genealogical parenthood (`recorded_tag_is_lossy`), and
  the recorded Wikidata statement is literally the same for both
  (`roles_record_the_same_statement`);
* the vocabulary does **not cover** the carrier: no role refines to a
  mitochondrial donor (`role_vocabulary_incomplete`);
* and the carrier does not encode everything the vocabulary distinguishes either:
  step and foster parenthood have the same twelve coordinates
  (`step_and_foster_collide`).  Neither surface is a projection of the other, so
  a bridge between them has to be two-sided.
-/

/-! ### Provenance (generated by `tools/provenance.py`)

Source mix of this module's 16 declarations: 5 traced to the DASHI Agda
bridge (`chboishabba/dashi_agda` PR #555 / #581 / #582), 2 rendering the Wikidata
data model, 9 original to this port.  The bridge-traced declarations are
marked with `-- @source` below.  Full ledger: `docs/status/PROVENANCE.md`.
-/

namespace Wikidata

-- @source DASHI Agda bridge (PR #555/#581/#582): flat eight-role vocabulary reified and refined
/-- A flat parenting-role vocabulary. -/
inductive ParentRole
  | biological
  | donor
  | surrogate
  | adoptive
  | stepParent
  | foster
  | guardian
  | godparent
  deriving DecidableEq, Repr, Inhabited

namespace ParentRole

/-- All eight roles. -/
def all : List ParentRole :=
  [biological, donor, surrogate, adoptive, stepParent, foster, guardian, godparent]

theorem mem_all (r : ParentRole) : r ∈ all := by cases r <;> decide

/-- The vocabulary's genetic predicate. -/
def isGenetic : ParentRole → Bool
  | biological => true
  | donor => true
  | _ => false

/-- The vocabulary's legal predicate. -/
def isLegal : ParentRole → Bool
  | biological => true
  | adoptive => true
  | guardian => true
  | _ => false

/-- The vocabulary's social predicate. -/
def isSocial : ParentRole → Bool
  | biological => true
  | adoptive => true
  | stepParent => true
  | foster => true
  | guardian => true
  | _ => false

/-- Every role tags a recorded parent edge: that is what makes the tag flat. -/
def recordedAsParent : ParentRole → Bool := fun _ => true

/-- The refinement of a flat role into the twelve coordinates. -/
def refine : ParentRole → RelationVector
  | biological =>
      { RelationVector.none with progenitor := true, genetic := true, gamete := true,
                                 genealogical := true, intended := true, legal := true,
                                 social := true, caregiver := true, identityKnown := true,
                                 identityDisclosable := true }
  | donor => RelationVector.anonymousDonor
  | surrogate => RelationVector.gestationalSurrogate
  | adoptive => RelationVector.adoptiveParent
  | stepParent =>
      { RelationVector.none with social := true, caregiver := true, identityKnown := true,
                                 identityDisclosable := true }
  | foster =>
      { RelationVector.none with social := true, caregiver := true, identityKnown := true,
                                 identityDisclosable := true }
  | guardian =>
      { RelationVector.none with intended := true, legal := true, social := true,
                                 caregiver := true, identityKnown := true,
                                 identityDisclosable := true }
  | godparent =>
      { RelationVector.none with identityKnown := true, identityDisclosable := true }

-- @source DASHI Agda bridge (PR #555/#581/#582): flat eight-role vocabulary reified and refined
/-- **The refinement preserves the source genetic predicate.** -/
theorem refine_preserves_genetic (r : ParentRole) : r.isGenetic = (refine r).genetic := by
  cases r <;> decide

/-- **The refinement preserves the source legal predicate.** -/
theorem refine_preserves_legal (r : ParentRole) : r.isLegal = (refine r).legal := by
  cases r <;> decide

/-- **The refinement preserves the source social predicate.** -/
theorem refine_preserves_social (r : ParentRole) : r.isSocial = (refine r).social := by
  cases r <;> decide

-- @source DASHI Agda bridge (PR #555/#581/#582): flat eight-role vocabulary reified and refined
/-- **The flat recorded-parent tag is lossy.** -/
theorem recorded_tag_is_lossy :
    recordedAsParent donor = recordedAsParent adoptive ∧
      (refine donor).genealogical = false ∧ (refine adoptive).genealogical = true := by
  refine ⟨rfl, ?_, ?_⟩ <;> decide

-- @source DASHI Agda bridge (PR #555/#581/#582): flat eight-role vocabulary reified and refined
/-- **The role vocabulary does not cover the carrier**: nothing in it describes a
mitochondrial donor. -/
theorem role_vocabulary_incomplete (r : ParentRole) :
    refine r ≠ RelationVector.mitochondrialDonor := by
  cases r <;> decide

-- @source DASHI Agda bridge (PR #555/#581/#582): flat eight-role vocabulary reified and refined
/-- **The carrier does not encode everything the vocabulary distinguishes**: step
and foster parenthood refine to the same twelve coordinates. -/
theorem step_and_foster_collide :
    refine stepParent = refine foster ∧ stepParent ≠ foster := by
  refine ⟨rfl, ?_⟩
  decide

/-- The carrier of a role, at the individual level. -/
def carrier (r : ParentRole) : ParentCarrier := ⟨NodeLevel.individual, refine r⟩

/-- **Every role records the same Wikidata statement**: the public layer sees one
generic parent edge whichever role generated it. -/
theorem roles_record_the_same_statement (child parent : Qid) (r r' : ParentRole) :
    recordedStatement child parent (carrier r) = recordedStatement child parent (carrier r') :=
  rfl

end ParentRole

end Wikidata
