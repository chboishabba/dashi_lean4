namespace Wikidata.InformationOrder

open Wikidata Wikidata.Rdf

/-! ## The general no-section theorem -/

/-- An exact reconstruction of a projection: a map back that recovers every fine
state. -/
structure Reconstruction {Fine Coarse : Type} (proj : Fine → Coarse) where
  /-- The proposed inverse. -/
  rebuild : Coarse → Fine
  /-- It recovers every fine state on the nose. -/
  exact : ∀ x, rebuild (proj x) = x

/-- A reconstructible projection is injective. -/
theorem injective_of_reconstruction {Fine Coarse : Type} {proj : Fine → Coarse}
    (r : Reconstruction proj) : Function.Injective proj := by
  intro x y h
  rw [← r.exact x, ← r.exact y, h]

/-- **A projection that identifies two states has no reconstruction.**  This is
the whole content of "the coarse view forgets something": not that some chosen
inverse fails, but that none exists. -/
theorem no_reconstruction_of_identified {Fine Coarse : Type} {proj : Fine → Coarse}
    {x y : Fine} (hne : x ≠ y) (heq : proj x = proj y) : IsEmpty (Reconstruction proj) :=
  ⟨fun r => hne (injective_of_reconstruction r heq)⟩

/-- Conversely, an injective projection is reconstructible as soon as the fine
type is inhabited: information order and reconstructibility agree. -/
noncomputable def reconstructionOfInjective {Fine Coarse : Type} [Inhabited Fine]
    {proj : Fine → Coarse} (h : Function.Injective proj) : Reconstruction proj where
  rebuild c := open Classical in if hc : ∃ x, proj x = c then hc.choose else default
  exact x := by
    have hx : ∃ z, proj z = proj x := ⟨x, rfl⟩
    rw [dif_pos hx]
    exact h hx.choose_spec

/-! ## Forgetting a statement's rank -/

/-- The direct layer's reading of a statement: subject, property, value, with
the rank dropped. -/
def forgetRank (st : Statement) : Qid × Pid × Qid := (st.subject, st.property, st.value)

/-- The same triple, asserted at normal rank… -/
def normalRankStatement : Statement := ⟨⟨1⟩, P279, ⟨2⟩, Rank.normal⟩

/-- …and at preferred rank. -/
def preferredRankStatement : Statement := ⟨⟨1⟩, P279, ⟨2⟩, Rank.preferred⟩

theorem rank_witness :
    forgetRank normalRankStatement = forgetRank preferredRankStatement ∧
      normalRankStatement ≠ preferredRankStatement := ⟨rfl, by decide⟩

/-- **Rank cannot be reconstructed from the direct reading of a statement.** -/
theorem no_reconstruction_of_forgetRank : IsEmpty (Reconstruction forgetRank) :=
  no_reconstruction_of_identified rank_witness.2 rank_witness.1

/-! ## Forgetting reification in a whole knowledge base -/

/-- **The direct RDF projection of a knowledge base is not reconstructible.**
Two bases differing only in the rank of one statement have the same direct
triples, so no map from direct triples back to knowledge bases can be exact. -/
theorem no_reconstruction_of_directTriples : IsEmpty (Reconstruction directTriples) := by
  obtain ⟨kb₁, kb₂, hdir, hreify⟩ := direct_layer_forgets_rank
  refine no_reconstruction_of_identified (fun h => hreify ?_) hdir
  rw [h]

/-- The reified layer, by contrast, *is* reconstructible on statements: `reify`
is injective, so nothing is lost by reifying. -/
theorem reify_reconstructible {kb₁ kb₂ : KB} (h : Rdf.reify kb₁ = Rdf.reify kb₂) :
    kb₁.statements = kb₂.statements := Rdf.reify_injective h

/-- **Determination is not equivalence**, in one statement: the fine reified
state determines the direct projection (trivially, since the projection is a
function of it), while the direct projection admits no reconstruction of the
fine state. -/
theorem determination_without_reconstruction :
    (∀ kb₁ kb₂ : KB, Rdf.reify kb₁ = Rdf.reify kb₂ →
        directTriples kb₁ = directTriples kb₂) ∧
      IsEmpty (Reconstruction directTriples) :=
  ⟨fun _ _ h => directTriples_congr (Rdf.reify_injective h), no_reconstruction_of_directTriples⟩

end Wikidata.InformationOrder
