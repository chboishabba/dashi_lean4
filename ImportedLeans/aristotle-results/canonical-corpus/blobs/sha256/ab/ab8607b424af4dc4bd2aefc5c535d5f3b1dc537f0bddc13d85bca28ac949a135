      where
      is : Iso _ _
      Iso.fun is = G→H⁰
      Iso.inv is = H⁰→G
      Iso.sec is = H⁰→G→H⁰
      Iso.ret is = G→H⁰→G
    snd H⁰conn' = makeIsGroupHom λ _ _ → refl

