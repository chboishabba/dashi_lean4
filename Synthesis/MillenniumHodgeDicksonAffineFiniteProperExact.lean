import Synthesis.MillenniumHodgeDicksonGenericProjectionDegreeExact
import Mathlib.RingTheory.IntegralClosure.IsIntegral.Basic
import Mathlib.AlgebraicGeometry.Morphisms.Proper

/-! Finite (hence proper) projection on the actual folded affine chart.
The base ring already contains the surface coordinates a,x,s.
Adjoin the six rotation coordinates satisfying v²-xv+a=0. This
includes the degenerate fold v²=a, without deleting its branch.
The product address eta is a polynomial in these coordinates, and
the signed derivative delta is a polynomial in base coordinates.
Do not equate this affine proper projection with a completed global
projective cycle or with the primitive cohomological pairing.
Classical monic integrality / finite morphism theory. -/
namespace DASHI.Hodge.DicksonCoupled
open Polynomial AlgebraicGeometry CategoryTheory
open scoped BigOperators
noncomputable section

variable {R A : Type*} [CommRing R] [CommRing A] [Algebra R A]

def rotationChartRing (v : Address → A) : Subalgebra R A :=
  Algebra.adjoin R (Set.range v)

theorem rotation_fold_monic (a x : R) :
    (X^2-C x*X+C a : R[X]).Monic := by
  have h : (X^2-C x*X+C a : R[X]) = X^2 + (C (-x)*X+C a) := by ring
  rw [h]
  exact (Polynomial.monic_X_pow 2).add_of_left
    (lt_of_le_of_lt (Polynomial.natDegree_add_le _ _)
      (by
        have h₁ : (C (-x)*X : R[X]).natDegree≤1 := by
          calc
            _ ≤ (C (-x) : R[X]).natDegree+(X : R[X]).natDegree :=
              Polynomial.natDegree_mul_le
            _ = 1 := by simp
        have h₂ : (C a : R[X]).natDegree≤1 := by simp
        exact lt_of_le_of_lt (max_le h₁ h₂) (by decide)))

theorem rotation_fold_integral (a x : R) (v : A)
    (h : v^2-algebraMap R A x*v+algebraMap R A a=0) :
    IsIntegral R v := by
  refine ⟨X^2-C x*X+C a,rotation_fold_monic a x,?_⟩
  simpa using h

theorem rotationChart_finite (a x : Address → R) (v : Address → A)
    (h : ∀ i,v i^2-algebraMap R A (x i)*v i+algebraMap R A (a i)=0) :
    Module.Finite R (rotationChartRing (R:=R) v) := by
  apply Algebra.finite_adjoin_of_finite_of_isIntegral (Set.finite_range v)
  rintro _ ⟨i,rfl⟩
  exact rotation_fold_integral (a i) (x i) (v i) (h i)

theorem rotationChart_address_mem (v : Address → A) :
    (∏ i,v i) ∈ rotationChartRing (R:=R) v := by
  exact Subalgebra.prod_mem _ (fun i _=>Algebra.subset_adjoin ⟨i,rfl⟩)

theorem rotationChart_seventh_mem (v : Address → A) (i : Address) :
    v i^7 ∈ rotationChartRing (R:=R) v :=
  (rotationChartRing (R:=R) v).pow_mem (Algebra.subset_adjoin ⟨i,rfl⟩) 7

/-- On the chart where a is a unit, the original inverse rotation
coordinate is a polynomial in the finite algebra. No independent
localization of that algebra is required. -/
theorem rotationChart_inverse_mem (a x ai : Address → R) (v w : Address → A)
    (ha : ∀ i,a i*ai i=1) (hw : ∀ i,v i*w i=1)
    (hx : ∀ i,v i+algebraMap R A (a i)*w i=algebraMap R A (x i))
    (i : Address) :
    w i ∈ rotationChartRing (R:=R) v := by
  have he : w i=algebraMap R A (ai i)*(algebraMap R A (x i)-v i) := by
    rw [← hx i]
    have hh := congrArg (algebraMap R A) (ha i)
    rw [map_mul,map_one] at hh
    calc
      _ = (algebraMap R A (a i)*algebraMap R A (ai i))*w i := by rw [hh,one_mul]
      _ = _ := by ring
  rw [he]
  exact (rotationChartRing (R:=R) v).mul_mem
    (Subalgebra.algebraMap_mem _ _) ((rotationChartRing (R:=R) v).sub_mem
      (Subalgebra.algebraMap_mem _ _) (Algebra.subset_adjoin ⟨i,rfl⟩))

/-- Native scheme-theoretic properness of the finite affine fold.
Any actual coordinate algebra satisfying the monic equations and
generated by v is covered by this theorem, not just a chosen finite
set of geometric points. -/
def rotationChartProjection (v : Address → A) :=
  Spec.map (CommRingCat.ofHom (algebraMap R (rotationChartRing (R:=R) v)))

theorem rotationChart_projection_finite (a x : Address → R) (v : Address → A)
    (h : ∀ i,v i^2-algebraMap R A (x i)*v i+algebraMap R A (a i)=0) :
    IsFinite (rotationChartProjection (R:=R) v) := by
  apply (IsFinite.SpecMap_iff _).mpr
  exact RingHom.finite_algebraMap.mpr (rotationChart_finite a x v h)

theorem rotationChart_projection_proper (a x : Address → R) (v : Address → A)
    (h : ∀ i,v i^2-algebraMap R A (x i)*v i+algebraMap R A (a i)=0) :
    IsProper (rotationChartProjection (R:=R) v) := by
  letI := rotationChart_projection_finite a x v h
  infer_instance

variable {F : Type*} [Field F] [CharZero F]

theorem actual_fold_quadratic (a v : F) (hv : v≠0) :
    v^2-(v+a/v)*v+a=0 := by
  field_simp [hv] <;> ring

/-- Eliminate the seventh-power address without dividing by it.
The relation extends across the branch of the quadratic fold. -/
theorem actual_surface_address_quadratic (a v s : F) (hv : v≠0)
    (h : dickson7Field (v+a/v) a=Q0Field a s) :
    (v^7)^2-Q0Field a s*v^7+a^7=0 := by
  rw [dickson7Field_laurent _ _ hv] at h
  rw [← h]
  field_simp [hv] <;> ring

end
end DASHI.Hodge.DicksonCoupled
