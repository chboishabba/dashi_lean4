import Welds.PNPOriginalAnchoredPreterminalExternalObservationExact

/-!
Section39 — original visible anchored F3 residual forces a SAME-STEP
distinguishing observation between the actual paired executions,
strictly before terminal time k.

Unlike Section38's non-closed readout witness, this source proof
identifies an actual pairwise input-observation DISAGREEMENT.
The consumer divergence cannot be generated by a deterministic
transition starting from the SAME original A-syndrome retained state
if both executions see identical observations at every step j<k.

The statement retains the original legally reopened Boolean rival,
the TRUE F3 kernel A and faithful original terminal consumer B.
No forced number of reads, sharing-stable SAT work or polynomial
complexity claim is introduced. Native Lean checking pending.
-/
namespace PNPOriginalResidualClosedEventNoGo
open PNPResidualGeometryBridge PNPLinearConsumerCut
open PNPF3SyndromeBoundary

theorem anchored_original_visible_has_paired_observation_split_before_terminal
    {n w m : Nat} {S I : Type*}
    (A : Syndrome n →ₗ[ZMod 3] Syndrome w)
    (B : Syndrome n →ₗ[ZMod 3] Syndrome m)
    (state : (Fin n → Bool) → Nat → S)
    (observe : Nat → (Fin n → Bool) → I)
    (step : Nat → S → I → S)
    (accept : S → Bool)
    (terminal : Syndrome m → Bool)
    (x : Fin n → Bool) (d : Syndrome n) (k : Nat)
    (hlegal : LegalAt x d)
    (hkernel : A d = 0)
    (hinit : ∀ u v : Fin n → Bool,
      A (boolEmbed u) = A (boolEmbed v) →
        state u 0 = state v 0)
    (hstep : ∀ u j,
      state u (j+1) = step j (state u j) (observe j u))
    (hterminal : ∀ u,
      accept (state u k) = terminal (B (boolEmbed u)))
    (hvisible : terminal (B (boolEmbed x)) ≠
      terminal (B (boolEmbed (reopen x d)))) :
    ∃ j : Nat, j < k ∧
      observe j x ≠ observe j (reopen x d) := by
  classical
  let y := reopen x d
  have hdiff : boolEmbed x - boolEmbed y = d :=
    anchored_reopen x d hlegal
  have hretained : A (boolEmbed x) = A (boolEmbed y) := by
    apply sub_eq_zero.mp
    rw [← map_sub, hdiff, hkernel]
  have hzero : state x 0 = state y 0 := hinit x y hretained
  by_contra hn
  have hobs : ∀ j, j < k → observe j x = observe j y := by
    intro j hj
    by_contra hne
    exact hn ⟨j,hj,hne⟩
  have hsame : ∀ j, j ≤ k → state x j = state y j := by
    intro j
    induction j with
    | zero =>
        intro _
        exact hzero
    | succ j ih =>
        intro hj
        have hlt : j < k := Nat.lt_of_succ_le hj
        rw [hstep x j, hstep y j,
            ih (Nat.le_of_lt hlt), hobs j hlt]
  have hconsumerEq := congrArg accept (hsame k (Nat.le_refl k))
  apply hvisible
  exact (hterminal x).symm.trans
    (hconsumerEq.trans (hterminal y))

/-- Any original anchored visible terminal split requires at least
ONE positive physical transition. It cannot be charged at k=0. -/
theorem anchored_original_visible_needs_positive_terminal_clock
    {n w m : Nat} {S I : Type*}
    (A : Syndrome n →ₗ[ZMod 3] Syndrome w)
    (B : Syndrome n →ₗ[ZMod 3] Syndrome m)
    (state : (Fin n → Bool) → Nat → S)
    (observe : Nat → (Fin n → Bool) → I)
    (step : Nat → S → I → S)
    (accept : S → Bool)
    (terminal : Syndrome m → Bool)
    (x : Fin n → Bool) (d : Syndrome n) (k : Nat)
    (hlegal : LegalAt x d)
    (hkernel : A d = 0)
    (hinit : ∀ u v : Fin n → Bool,
      A (boolEmbed u) = A (boolEmbed v) →
        state u 0 = state v 0)
    (hstep : ∀ u j,
      state u (j+1) = step j (state u j) (observe j u))
    (hterminal : ∀ u,
      accept (state u k) = terminal (B (boolEmbed u)))
    (hvisible : terminal (B (boolEmbed x)) ≠
      terminal (B (boolEmbed (reopen x d)))) :
    0 < k := by
  obtain ⟨j,hjk,_⟩ :=
    anchored_original_visible_has_paired_observation_split_before_terminal
      A B state observe step accept terminal x d k
      hlegal hkernel hinit hstep hterminal hvisible
  exact lt_of_le_of_lt (Nat.zero_le j) hjk

end PNPOriginalResidualClosedEventNoGo
