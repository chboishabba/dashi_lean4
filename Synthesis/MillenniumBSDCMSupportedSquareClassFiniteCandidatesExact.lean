import Mathlib.Tactic

/-!
# Selected CM curve: finite square-class candidate enumeration at S={2,infinity}

The (conditional) standard 2-descent support theorem restricts each rational
square class to the subgroup generated by [-1] and [2] when all other finite
valuations are even. This file constructs and exhausts the *candidate encoding*
for that subgroup, not the unproved support theorem or the local Kummer
membership test.

Each coordinate has four representatives: 1,-1,2,-2, and a pair has
sixteen candidates. This is not an assertion that Sel^2 has dimension four;
the genuine local Selmer conditions are needed to cut this set down.

Source relation: Agda rational square-class / finite-seed owners, and the
Bishop zeta commuting square's separate same-object methodology. Neither
the Riemann zeta square nor this enumeration supplies elliptic L-values.
-/

namespace Synthesis.Millennium.BSD

/-- Two finite square-class generators: sign (-1) and valuation parity at 2. -/
abbrev CMSupportedSquareClassBits := Bool × Bool

/-- Selected full-rational-E[2] pair of square-class candidates. -/
abbrev CMSupportedSquareClassPairBits :=
  CMSupportedSquareClassBits × CMSupportedSquareClassBits

/-- Literal square-free rational representative of the selected candidate. -/
def cmSupportedSquareClassRepresentative
    (c : CMSupportedSquareClassBits) : ℚ :=
  (if c.1 then -1 else 1) * (if c.2 then 2 else 1)

/-- Four actual representatives, before quotienting by rational squares. -/
theorem cmSupportedSquareClassRepresentative_range
    (c : CMSupportedSquareClassBits) :
    cmSupportedSquareClassRepresentative c = 1 ∨
    cmSupportedSquareClassRepresentative c = -1 ∨
    cmSupportedSquareClassRepresentative c = 2 ∨
    cmSupportedSquareClassRepresentative c = -2 := by
  rcases c with ⟨s, t⟩
  cases s <;> cases t <;>
    simp [cmSupportedSquareClassRepresentative]

/-- Exactly four finite candidate codes for one square class. -/
theorem cmSupportedSquareClassBits_card :
    Fintype.card CMSupportedSquareClassBits = 4 := by
  decide

/-- Exactly sixteen candidate codes for a two-coordinate descent. -/
theorem cmSupportedSquareClassPairBits_card :
    Fintype.card CMSupportedSquareClassPairBits = 16 := by
  decide

/-- A real-sign negative control: the class -1 has a different sign from 1.
This does not yet identify the real elliptic Kummer image. -/
theorem cmSupportedSquareClassRepresentative_sign_negative :
    cmSupportedSquareClassRepresentative (true, false) < 0 := by
  norm_num [cmSupportedSquareClassRepresentative]

theorem cmSupportedSquareClassRepresentative_sign_positive :
    0 < cmSupportedSquareClassRepresentative (false, false) := by
  norm_num [cmSupportedSquareClassRepresentative]

/-- An arbitrary Boolean filter cannot be claimed to have the desired
two-dimensional Selmer size: the always-false filter selects no candidates. -/
theorem cmCandidateFilter_empty_negativeControl :
    (Finset.univ.filter
      (fun _ : CMSupportedSquareClassPairBits => False)).card = 0 := by
  simp

/-- The always-true filter retains all sixteen candidates, again showing
that encoding alone is not a Selmer computation. -/
theorem cmCandidateFilter_all_negativeControl :
    (Finset.univ.filter
      (fun _ : CMSupportedSquareClassPairBits => True)).card = 16 := by
  simpa using cmSupportedSquareClassPairBits_card


/-- Necessary real-sign filter for ordinary x-T coordinates, expressed
on the actual finite support candidate codes. The parity bits remain free.
Exceptional torsion conventions still require the global Kummer comparison
before this filter is claimed to be the full real local Kummer image. -/
def cmRealSignCompatibleCandidate
    (c : CMSupportedSquareClassPairBits) : Prop :=
  c.1.1 = c.2.1

instance (c : CMSupportedSquareClassPairBits) :
    Decidable (cmRealSignCompatibleCandidate c) := inferInstance

/-- The sign-compatible finite candidate subset is exactly half of the
sixteen support candidates. This is NOT the final Selmer order, because
the 2-adic and classical cohomological image tests remain unpaid. -/
theorem cmRealSignCompatibleCandidate_card :
    (Finset.univ.filter cmRealSignCompatibleCandidate).card = 8 := by
  decide

/-- Opposite-sign candidate (positive first, negative second) is rejected
by the necessary real-sign test. -/
theorem cmRealSignCompatibleCandidate_rejects_opposite :
    ¬ cmRealSignCompatibleCandidate
        ((false, false), (true, false)) := by
  decide

/-- Trivial Kummer candidate is accepted: any eventual local image must
include the identity. -/
theorem cmRealSignCompatibleCandidate_accepts_identity :
    cmRealSignCompatibleCandidate
      ((false, false), (false, false)) := by
  decide

end Synthesis.Millennium.BSD
