import RequestProject.FieldSizeScan
import RequestProject.SvgCore

/-!
# The picture of the scan `q = 2 … 97`

This file draws `RequestProject/FieldSizeScan.lean`'s scan into `svg/field-size-scan.svg`
(generated by `scripts/GenerateSvg.lean`).  Every candidate size `q = 2, …, 97` gets one
column:

* grey `×` below the axis — `q` is **not** a field size (no field has `q` elements,
  `FieldSizeScan.card_ne_of_gfData_eq_none`);
* green dot on the axis — `q = p ^ k` is a field size with **error `0`**: the Frobenius orbit
  product `N(x) = x · x^p · … · x^(p^(k-1))` is a retraction of `GF(q)` onto its prime subfield
  `𝔽ₚ` (`FieldSizeScan.retraction_iff_frobDefect_eq_zero`);
* red bar — `q = p ^ k` is a field size with a **nonzero error**: the bar height is
  `frobDefect p k`, the number of elements of `𝔽ₚ` that `N` moves
  (`FieldSizeScan.card_frobNorm_failures`), drawn against the pale bar `p - 1`, the largest
  error possible in characteristic `p`.

Pale reference bars are drawn only for the proper prime powers `k ≥ 2`; for a prime `q = p`
itself the degree is `k = 1`, `N` is the identity map and the error is `0` for trivial reasons.

The drawn data is `FieldSizeScan.fieldSizeScan` itself, whose classification is proved by
kernel computation in `FieldSizeScan.scan_no_field_sizes`, `FieldSizeScan.scan_retractive_sizes`
and `FieldSizeScan.scan_failing_sizes`; `errors_le_six` below checks that every plotted bar fits
under the axis maximum.
-/

namespace ScanViz

open SvgCore

/-! ### The plotted data -/

/-- The rows of the picture: the scan of `RequestProject/FieldSizeScan.lean`. -/
def rows : List (ℕ × Option (ℕ × ℕ × ℕ)) := FieldSizeScan.fieldSizeScan

/-- The picture has one column per candidate size `q = 2, …, 97`. -/
theorem rows_length : rows.length = 96 := by decide +kernel

/-- Every plotted error bar, and every pale reference bar of a proper prime power, fits under
the drawn axis maximum of `6`. -/
theorem errors_le_six :
    rows.all (fun r =>
      match r.2 with
      | some (p, k, d) => d ≤ 6 && (decide (k < 2) || decide (p - 1 ≤ 6))
      | none => true) = true := by
  decide +kernel

/-! ### Geometry -/

private def width : Float := 1240.0
private def height : Float := 600.0
private def leftX : Float := 78.0
private def rightX : Float := 1216.0
private def baseline : Float := 440.0
private def unitY : Float := 52.0
private def colw : Float := (rightX - leftX) / 96.0

private def xOf (q : ℕ) : Float := leftX + (Float.ofNat (q - 2) + 0.5) * colw
private def yOf (e : ℕ) : Float := baseline - Float.ofNat e * unitY

/-- Unicode superscript for the small exponents occurring in the picture. -/
private def sup (k : ℕ) : String :=
  match k with
  | 2 => "²"
  | 3 => "³"
  | 4 => "⁴"
  | 5 => "⁵"
  | 6 => "⁶"
  | 7 => "⁷"
  | _ => "^" ++ toString k

/-! ### The drawing -/

private def gridLines : List String :=
  (List.range 7).flatMap fun e =>
    [ line leftX (yOf e) rightX (yOf e) (if e == 0 then "#334155" else "#e2e8f0")
        (if e == 0 then 1.6 else 1.0) "" (if e == 0 then "" else "4 4"),
      text (leftX - 12.0) (yOf e + 4.5) (toString e) 12.0 "#475569" "end" ]

private def yAxisTitle : List String :=
  [ "  <text x=\"22\" y=\"" ++ num (yOf 3) ++
      "\" font-size=\"13\" fill=\"#0f172a\" text-anchor=\"middle\" transform=\"rotate(-90 22 " ++
      num (yOf 3) ++ ")\">error: # of elements of 𝔽ₚ moved by N</text>" ]

private def xTicks : List String :=
  rows.flatMap fun r =>
    let q := r.1
    if q % 5 == 0 || q == 2 || q == 97 then
      [ line (xOf q) baseline (xOf q) (baseline + 5.0) "#94a3b8" 1.0,
        text (xOf q) (baseline + 34.0) (toString q) 10.5 "#475569" "middle" ]
    else []

private def column (r : ℕ × Option (ℕ × ℕ × ℕ)) : List String :=
  let q := r.1
  let x := xOf q
  match r.2 with
  | none =>
      -- not a field size: no field has `q` elements
      [ line x (yOf 6) x baseline "#f8fafc" 1.0 "" "3 5",
        text x (baseline + 16.0) "×" 11.0 "#cbd5e1" "middle" ]
  | some (p, k, d) =>
      let barw := colw * 0.62
      let pale :=
        if 2 ≤ k then
          [ rect (x - barw / 2.0) (yOf (p - 1)) barw (Float.ofNat (p - 1) * unitY) 1.5
              "#fef3c7" "#fcd34d" 1.0 ]
        else []
      let bar :=
        if d == 0 then
          [ circle x baseline 3.8 "#10b981" "#047857" 1.2 "class=\"pop\"" ]
        else
          [ pulse x (yOf d) 9.0 "#f87171" 2.6 (Float.ofNat d * 0.3),
            rect (x - barw / 2.0) (yOf d) barw (Float.ofNat d * unitY) 2.0
              "url(#hot)" "#991b1b" 1.0 "" "class=\"pop\"",
            text x (yOf d - 12.0) (toString d) 11.5 "#991b1b" "middle" "bold" ]
      let label :=
        if 2 ≤ k then
          [ text x (yOf (max (p - 1) d) - (if d == 0 then 8.0 else 22.0))
              (toString q ++ " = " ++ toString p ++ sup k) 10.5 "#78350f" "middle" ]
        else []
      pale ++ bar ++ label

private def legend : List String :=
  let y := 508.0
  [ circle 96.0 (y - 4.0) 3.8 "#10b981" "#047857" 1.2,
    text 108.0 y "error 0: N is a retraction of GF(q) onto 𝔽ₚ" 12.5 "#0f172a" "start",
    rect 430.0 (y - 11.0) 10.0 14.0 1.5 "url(#hot)" "#991b1b" 1.0,
    text 448.0 y "error > 0: N moves that many elements of 𝔽ₚ" 12.5 "#0f172a" "start",
    rect 790.0 (y - 11.0) 10.0 14.0 1.5 "#fef3c7" "#fcd34d" 1.0,
    text 808.0 y "p − 1: largest possible error (k ≥ 2 only)" 12.5 "#0f172a" "start",
    text 1096.0 y "×  q is not a field size" 12.5 "#475569" "start" ]

private def caption : List String :=
  [ text 620.0 546.0
      ("61 of the 96 candidate sizes are not prime powers, so no field of that order exists;" ++
       " 31 have error 0; the remaining 4 are 9, 25, 49, 81.") 12.5 "#334155" "middle",
    text 620.0 568.0
      ("Every prime q = p has k = 1, where N is the identity;" ++
       " the proper prime powers with error 0 are 4, 8, 16, 32, 64 (characteristic 2) and 27.")
      12.5 "#334155" "middle" ]

/-- The picture written to `svg/field-size-scan.svg`. -/
def scanSvg : String :=
  document width height
    ([ text 620.0 40.0
         "Every q from 2 to 97 tested as a field size GF(q): does the Frobenius orbit product retract onto 𝔽ₚ?"
         18.0 "url(#ink)" "middle" "bold",
       text 620.0 62.0
         "q = p^k, N(x) = x · x^p · … · x^(p^(k−1)); error = #{a ∈ 𝔽ₚ : N(a) ≠ a} = (p−1) − gcd(p−1, k−1)"
         12.5 "#475569" "middle" ] ++
     gridLines ++ yAxisTitle ++ xTicks ++ rows.flatMap column ++ legend ++ caption)

/-! ### The companion picture: fixed characteristic, degrees `n = 2 … 97`

Reading `2 … 97` as *degrees* rather than as sizes gives a periodic picture: the error of
`GF(p ^ n)` depends on `n` only through `n mod (p - 1)`, and vanishes exactly on
`n ≡ 1 mod (p - 1)` (`FieldSizeScan.frobDefect_eq_zero_iff_modEq`).  The four panels are the
characteristics `2, 3, 5, 7`, whose error patterns are pinned down by
`FieldSizeScan.degreeScan_char_two`, `…_char_three`, `…_char_five`, `…_char_seven`. -/

private def dWidth : Float := 1240.0
private def dHeight : Float := 720.0
private def dLeft : Float := 118.0
private def dRight : Float := 1216.0
private def dUnit : Float := 17.0
private def dColw : Float := (dRight - dLeft) / 96.0

private def dxOf (n : ℕ) : Float := dLeft + (Float.ofNat (n - 2) + 0.5) * dColw

/-- The four characteristics drawn, with their baselines and bar colours. -/
private def panels : List (ℕ × Float × String × String) :=
  [(2, 150.0, "#0369a1", "#075985"), (3, 285.0, "#7c3aed", "#5b21b6"),
   (5, 445.0, "#dc2626", "#991b1b"), (7, 625.0, "#b45309", "#78350f")]

private def panel (pb : ℕ × Float × String × String) : List String :=
  let p := pb.1
  let base := pb.2.1
  let fill := pb.2.2.1
  let stroke := pb.2.2.2
  let rows := FieldSizeScan.degreeScan p
  let barw := dColw * 0.6
  let axis :=
    [ card (dLeft - 46.0) (base - Float.ofNat (p - 1) * dUnit - 34.0) (dRight - dLeft + 66.0)
        (Float.ofNat (p - 1) * dUnit + 62.0) 14.0 "#ffffffcc" "#e2e8f0" 1.0,
      line dLeft base dRight base "#334155" 1.4,
      line dLeft (base - Float.ofNat (p - 1) * dUnit) dRight
        (base - Float.ofNat (p - 1) * dUnit) "#e2e8f0" 1.0 "" "4 4",
      text (dLeft - 14.0) (base + 4.5) "0" 11.0 "#475569" "end",
      text (dLeft - 14.0) (base - Float.ofNat (p - 1) * dUnit + 4.5) (toString (p - 1)) 11.0
        "#475569" "end",
      text dLeft (base - Float.ofNat (p - 1) * dUnit - 16.0)
        ("characteristic p = " ++ toString p ++ ":  error 0 exactly for n ≡ 1 (mod " ++
          toString (p - 1) ++ ")") 13.0 stroke "start" "bold" ]
  let bars := rows.flatMap fun r =>
    let n := r.1
    let d := r.2
    let x := dxOf n
    if d == 0 then
      [ circle x base 3.0 "#10b981" "#047857" 1.0 ]
    else
      [ rect (x - barw / 2.0) (base - Float.ofNat d * dUnit) barw (Float.ofNat d * dUnit) 1.4
          fill stroke 0.8 ]
  let ticks := rows.flatMap fun r =>
    let n := r.1
    if n % 10 == 0 || n == 2 || n == 97 then
      [ line (dxOf n) base (dxOf n) (base + 5.0) "#94a3b8" 1.0,
        text (dxOf n) (base + 18.0) (toString n) 10.0 "#475569" "middle" ]
    else []
  axis ++ bars ++ ticks

/-- The picture written to `svg/field-size-scan-degrees.svg`. -/
def degreeSvg : String :=
  document dWidth dHeight
    ([ text 620.0 44.0
         "The same range read as degrees: GF(pⁿ) for n = 2 … 97, in characteristics 2, 3, 5, 7"
         18.0 "url(#ink)" "middle" "bold",
       text 620.0 66.0
         "bar height = error = #{a ∈ 𝔽ₚ : N(a) ≠ a} = (p−1) − gcd(p−1, n−1);  green dot = error 0, i.e. N is a retraction onto 𝔽ₚ"
         12.5 "#475569" "middle",
       text 620.0 690.0
         "In characteristic 2 the error is always 0, but degenerately: 𝔽₂ has a trivial unit group, so N(x) = 1 for every x ≠ 0."
         12.5 "#334155" "middle" ] ++
     panels.flatMap panel)

end ScanViz
