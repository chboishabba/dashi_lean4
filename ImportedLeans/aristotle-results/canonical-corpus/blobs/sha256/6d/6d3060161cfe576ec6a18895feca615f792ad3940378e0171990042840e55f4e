-- Reusable vector compatibility surface.

kThresholdMask : Nat → Int → Int → Vec15 Nat
kThresholdMask = thresholdMask15

kThresholdCount : Nat → Int → Int → Nat
kThresholdCount = thresholdCount

kThresholdSupportSubset :
