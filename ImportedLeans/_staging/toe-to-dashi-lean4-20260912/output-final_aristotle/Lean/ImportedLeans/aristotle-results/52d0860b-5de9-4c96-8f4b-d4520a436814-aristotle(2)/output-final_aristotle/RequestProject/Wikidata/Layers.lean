namespace Wikidata

/-- Which statement layer is being consumed. -/
inductive StatementLayer
  | full
  | truthy
  deriving DecidableEq, Repr, Inhabited

-- @source DASHI Agda bridge (PR #555/#581): `truthyQueryLayer`
/-- The truthy query layer, as a slice of the full statement layer. -/
def truthyLayer (kb : KB) : KB := restrict kb (IsTruthy kb)

/-- The knowledge base as seen at a layer. -/
def atLayer (kb : KB) : StatementLayer → KB
  | StatementLayer.full => kb
  | StatementLayer.truthy => truthyLayer kb

@[simp] theorem atLayer_full (kb : KB) : atLayer kb StatementLayer.full = kb := rfl

@[simp] theorem atLayer_truthy (kb : KB) : atLayer kb StatementLayer.truthy = truthyLayer kb := rfl

@[simp] theorem truthyLayer_entities (kb : KB) : (truthyLayer kb).entities = kb.entities := rfl

theorem truthyLayer_subset (kb : KB) : (truthyLayer kb).statements ⊆ kb.statements :=
  restrict_subset kb (IsTruthy kb)

theorem mem_truthyLayer_iff (kb : KB) (st : Statement) :
    st ∈ (truthyLayer kb).statements ↔ st ∈ kb.statements ∧ IsTruthy kb st = true :=
  mem_restrict_iff kb (IsTruthy kb) st

/-- Deprecated statements are invisible at the truthy layer. -/
theorem truthyLayer_no_deprecated (kb : KB) (st : Statement)
    (h : st ∈ (truthyLayer kb).statements) : st.rank ≠ Rank.deprecated := by
  intro hdep
  have := ((mem_truthyLayer_iff kb st).1 h).2
  rw [isTruthy_deprecated kb st hdep] at this
  exact Bool.noConfusion this

/-! ## Stability of the projection -/

/-- Statements of a given subject/property pair surviving the projection are
exactly the truthy ones. -/
theorem statementsFor_truthyLayer (kb : KB) (s : Qid) (p : Pid) :
    statementsFor (truthyLayer kb) s p =
      (statementsFor kb s p).filter (IsTruthy kb) := by
  simp [statementsFor, truthyLayer, restrict, List.filter_filter, Bool.and_comm]

/-- A preferred statement survives the projection, so rank shadowing is
unchanged by it. -/
theorem hasPreferred_truthyLayer (kb : KB) (s : Qid) (p : Pid) :
    hasPreferred (truthyLayer kb) s p = hasPreferred kb s p := by
  simp only [hasPreferred, statementsFor_truthyLayer, List.any_filter]
  rw [Bool.eq_iff_iff]
  simp only [List.any_eq_true, decide_eq_true_eq, Bool.and_eq_true]
  constructor
  · rintro ⟨st, hst, _, hpref⟩
    exact ⟨st, hst, hpref⟩
  · rintro ⟨st, hst, hpref⟩
    exact ⟨st, hst, isTruthy_preferred kb st hpref, hpref⟩

/-- Truthiness is computed the same way before and after the projection. -/
theorem isTruthy_truthyLayer (kb : KB) (st : Statement) :
    IsTruthy (truthyLayer kb) st = IsTruthy kb st := by
  simp [IsTruthy, hasPreferred_truthyLayer]

/-- The truthy layer projection is idempotent. -/
theorem truthyLayer_idem (kb : KB) : truthyLayer (truthyLayer kb) = truthyLayer kb := by
  have hf : IsTruthy (truthyLayer kb) = IsTruthy kb := funext (isTruthy_truthyLayer kb)
  show restrict (truthyLayer kb) (IsTruthy (truthyLayer kb)) = truthyLayer kb
  rw [hf]
  show restrict (restrict kb (IsTruthy kb)) (IsTruthy kb) = restrict kb (IsTruthy kb)
  rw [restrict_restrict]
  simp

/-! ## Conservativity: the derived graphs are unchanged -/

/-- Filtering the truthy layer by a truthiness-implying condition is the same as
filtering the whole base by it. -/
theorem filter_truthyLayer (kb : KB) (P : Statement → Prop) [DecidablePred P]
    (hP : ∀ st, P st → IsTruthy kb st = true) :
    (truthyLayer kb).statements.filter (fun st => decide (P st)) =
      kb.statements.filter (fun st => decide (P st)) := by
  show (kb.statements.filter (IsTruthy kb)).filter (fun st => decide (P st)) = _
  rw [List.filter_filter]
  apply List.filter_congr
  intro st _
  by_cases h : P st
  · simp [h, hP st h]
  · simp [h]

theorem subclassEdges_truthyLayer (kb : KB) : subclassEdges (truthyLayer kb) = subclassEdges kb := by
  have hf : IsTruthy (truthyLayer kb) = IsTruthy kb := funext (isTruthy_truthyLayer kb)
  simp only [subclassEdges, hf]
  rw [filter_truthyLayer kb (fun st => st.property = P279 ∧ IsTruthy kb st = true)
    (fun st h => h.2)]

theorem instanceEdges_truthyLayer (kb : KB) : instanceEdges (truthyLayer kb) = instanceEdges kb := by
  have hf : IsTruthy (truthyLayer kb) = IsTruthy kb := funext (isTruthy_truthyLayer kb)
  simp only [instanceEdges, hf]
  rw [filter_truthyLayer kb (fun st => st.property = P31 ∧ IsTruthy kb st = true)
    (fun st h => h.2)]

theorem directSubclass_truthyLayer_iff (kb : KB) (a b : Qid) :
    DirectSubclass (truthyLayer kb) a b ↔ DirectSubclass kb a b := by
  simp [DirectSubclass, subclassEdges_truthyLayer]

/-- **Conservativity of the truthy layer** for the subclass relation. -/
theorem subclassOf_truthyLayer_iff (kb : KB) (a b : Qid) :
    SubclassOf (truthyLayer kb) a b ↔ SubclassOf kb a b := by
  have h : DirectSubclass (truthyLayer kb) = DirectSubclass kb := by
    funext x y
    exact propext (directSubclass_truthyLayer_iff kb x y)
  simp [SubclassOf, h]

/-- **Conservativity of the truthy layer** for the instance relation. -/
theorem instanceOf_truthyLayer_iff (kb : KB) (x c : Qid) :
    InstanceOf (truthyLayer kb) x c ↔ InstanceOf kb x c := by
  simp only [InstanceOf, instanceEdges_truthyLayer]
  exact exists_congr fun c₀ => and_congr_right fun _ => subclassOf_truthyLayer_iff kb c₀ c

/-- The executable checkers agree across the two layers. -/
theorem isSubclassOf_truthyLayer (kb : KB) (a b : Qid) :
    isSubclassOf (truthyLayer kb) a b = isSubclassOf kb a b := by
  rw [Bool.eq_iff_iff, isSubclassOf_iff, isSubclassOf_iff]
  exact subclassOf_truthyLayer_iff kb a b

theorem isInstanceOf_truthyLayer (kb : KB) (x c : Qid) :
    isInstanceOf (truthyLayer kb) x c = isInstanceOf kb x c := by
  rw [Bool.eq_iff_iff, isInstanceOf_iff, isInstanceOf_iff]
  exact instanceOf_truthyLayer_iff kb x c

/-- Layer-indexed derivation: the answer does not depend on the layer. -/
theorem subclassOf_atLayer_iff (kb : KB) (l : StatementLayer) (a b : Qid) :
    SubclassOf (atLayer kb l) a b ↔ SubclassOf kb a b := by
  cases l with
  | full => exact Iff.rfl
  | truthy => exact subclassOf_truthyLayer_iff kb a b

theorem instanceOf_atLayer_iff (kb : KB) (l : StatementLayer) (x c : Qid) :
    InstanceOf (atLayer kb l) x c ↔ InstanceOf kb x c := by
  cases l with
  | full => exact Iff.rfl
  | truthy => exact instanceOf_truthyLayer_iff kb x c

/-! ## Layers and slices commute -/

/-- On a knowledge base with no rank distinctions, the truthy layer is the whole
base, so layer projection and any slice commute. -/
theorem truthyLayer_of_allNormal {kb : KB} (h : AllNormal kb) : truthyLayer kb = kb := by
  cases kb with
  | mk ents sts =>
      simp only [truthyLayer, restrict, KB.mk.injEq, true_and]
      rw [List.filter_eq_self]
      intro st hst
      exact isTruthy_of_allNormal h hst

theorem truthyLayer_restrict_of_allNormal {kb : KB} (h : AllNormal kb) (f : StatementFilter) :
    truthyLayer (restrict kb f) = restrict (truthyLayer kb) f := by
  rw [truthyLayer_of_allNormal (allNormal_restrict h f), truthyLayer_of_allNormal h]

end Wikidata
