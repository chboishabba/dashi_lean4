    denseToAnchoredExit :
      π-mdl-max level3-next
        ≢
      π-mdl-max level2-next
    anchoredToOneHotExit :
      π-mdl-max level2-next
        ≢
      π-mdl-max level1-next

canonicalShiftContractSupportCascadeTrajectory :
