import RequestProject.CenterRetraction
import RequestProject.CenterRetractionMore
import RequestProject.QuaternionCenterRetraction

/-!
# The commutator obstruction is necessary but not sufficient

`CenterRetractionMore.lean` proves that a group retracting onto its center has
`Disjoint (commutator G) (center G)`.  It is natural to ask whether this necessary condition is
also sufficient for a finite group.  It is **not**: the dicyclic group of order `12`
(`QuaternionGroup 3`) has

* center `{1, a 3}` of order `2`, meeting the derived subgroup trivially
  (`disjoint_commutator_center_dicyclic_twelve`), yet
* no retraction onto its center (`QuaternionGroup.not_hasCenterRetraction_dicyclic_twelve`).

The new ingredient is `QuaternionGroup.a_three_not_mem_commutator`: the derived subgroup of the
dicyclic group of order `12` (which is the cyclic group of order `3` generated by `a 2`) does not
contain the central involution `a 3`.  This is proved by exhibiting the abelianization character
`char12 : QuaternionGroup 3 →* Multiplicative (ZMod 4)`, `a i ↦ 2i`, `xa i ↦ 2i + 1`, under which
`a 3 ↦ 2 ≠ 0`, while every commutator is killed.

`disjoint_commutator_center_not_sufficient` packages the conclusion.
-/

open Subgroup

namespace QuaternionGroup

set_option maxRecDepth 100000 in
/-- The underlying function of the abelianization character of the dicyclic group of order `12`:
`a i ↦ 2i`, `xa i ↦ 2i + 1` in `ZMod 4`. -/
def char12Fun : QuaternionGroup 3 → ZMod 4
  | .a i => (2 * i.val : ZMod 4)
  | .xa i => (2 * i.val + 1 : ZMod 4)

set_option maxRecDepth 200000 in
theorem char12Fun_mul (x y : QuaternionGroup 3) :
    char12Fun (x * y) = char12Fun x + char12Fun y := by
  revert x y
  decide

/-- The abelianization character `QuaternionGroup 3 →* Multiplicative (ZMod 4)`. -/
def char12 : QuaternionGroup 3 →* Multiplicative (ZMod 4) :=
  MonoidHom.mk' (fun g => Multiplicative.ofAdd (char12Fun g)) fun x y => by
    show Multiplicative.ofAdd (char12Fun (x * y))
      = Multiplicative.ofAdd (char12Fun x + char12Fun y)
    rw [char12Fun_mul]

/-- The central involution of the dicyclic group of order `12` is **not** a product of
commutators. -/
theorem a_three_not_mem_commutator :
    (a 3 : QuaternionGroup 3) ∉ commutator (QuaternionGroup 3) := by
  intro h
  have hker := Abelianization.commutator_subset_ker char12 h
  rw [MonoidHom.mem_ker] at hker
  have h0 : char12Fun (a 3 : QuaternionGroup 3) = 0 := hker
  revert h0
  decide

/-- In the dicyclic group of order `12` the derived subgroup meets the center trivially. -/
theorem disjoint_commutator_center_dicyclic_twelve :
    Disjoint (commutator (QuaternionGroup 3)) (center (QuaternionGroup 3)) := by
  rw [Subgroup.disjoint_def]
  intro x hx hxc
  rcases (mem_center_three_iff x).1 hxc with rfl | rfl
  · rfl
  · exact absurd hx a_three_not_mem_commutator

/-- The center of the dicyclic group of order `12` is nontrivial. -/
theorem nontrivial_center_dicyclic_twelve : Nontrivial (center (QuaternionGroup 3)) := by
  refine ⟨⟨1, ⟨a 3, a_n_mem_center⟩, ?_⟩⟩
  intro h
  have := congrArg Subtype.val h
  revert this
  decide

end QuaternionGroup

/-- **The necessary condition `Disjoint (commutator G) (center G)` is not sufficient.**
The dicyclic group of order `12` has a nontrivial center meeting its derived subgroup trivially,
yet admits no retraction onto its center. -/
theorem disjoint_commutator_center_not_sufficient :
    Disjoint (commutator (QuaternionGroup 3)) (center (QuaternionGroup 3)) ∧
      Nontrivial (center (QuaternionGroup 3)) ∧
      ¬ HasCenterRetraction (QuaternionGroup 3) :=
  ⟨QuaternionGroup.disjoint_commutator_center_dicyclic_twelve,
    QuaternionGroup.nontrivial_center_dicyclic_twelve,
    QuaternionGroup.not_hasCenterRetraction_dicyclic_twelve⟩
