------------------------------------------------------------------------
-- Rows and the proof-carrying completion certificate
------------------------------------------------------------------------

data RowStatus : Set where
  openRow   : RowStatus
  provedRow : RowStatus

-- A decrement of the count must supply a proposition together with an
-- inhabitant of it, and must quote the normative statement it claims to
-- discharge.
record CompletionCertificate : Set₁ where
  field
    quotedNormativeStatement : String
    Proposition              : Set
    proof                    : Proposition
    level                    : ProofLevel
    locallyPromotable        : promotable level ≡ true

record ResearchRow : Set₂ where
  field
    label                   : String
    completionCondition     : String   -- verbatim from the normative document
    status                  : RowStatus
    certificate             : status ≡ provedRow → CompletionCertificate

open ResearchRow public

