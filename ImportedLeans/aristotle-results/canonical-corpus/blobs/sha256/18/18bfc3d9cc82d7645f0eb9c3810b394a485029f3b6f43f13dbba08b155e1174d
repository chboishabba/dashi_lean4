  P2Obstructionω {Nat} {Nat} canonicalCandidateFamily
canonicalPressureMetricP2Obstruction =
  record
    { canonVal =
        canonicalPressureScalar
    ; targetVal =
        realizationIndexedMetricScalar
    ; noBridge =
        λ β candidate _ →
          canonicalCandidateFamilyImpossible β candidate
    }

