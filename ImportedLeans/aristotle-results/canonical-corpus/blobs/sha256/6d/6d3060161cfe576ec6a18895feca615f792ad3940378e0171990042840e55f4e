-- Summary surfaces stay explicit but are now backed by real operators.

constant15 : Nat → PrimeCarrier15
constant15 n =
  mkVec15 n n n n n n n n n n n n n n n

maxNat-self : ∀ n → maxNat n n ≡ n
maxNat-self zero = refl
