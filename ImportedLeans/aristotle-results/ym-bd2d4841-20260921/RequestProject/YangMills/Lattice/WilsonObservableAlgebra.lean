/-
# A concrete dense algebra of observables on a time slice

`Lattice/DenseCorrelationExtension.lean` reduces the finite side of the mass gap
to a connected two-slice correlation estimate on the mean-zero part of *any*
sup-norm dense space of continuous observables.  This file supplies a concrete
such algebra for the literal four-dimensional `SU(2)` theory, so that the
remaining estimate is an estimate about polynomials in the link variables, and
not about an abstract dense subspace.

* `linkCoord l i` — the `i`-th quaternion coordinate of the gauge field on the
  spatial link `l`, a continuous complex-valued observable of the slice
  configuration.
* `separatesPoints_linkCoord` — the link coordinates separate configurations:
  two slice configurations agreeing on every coordinate of every link are equal.
* `starSubalgebra_separatesPoints_of_linkCoord`, `dense_of_linkCoord_mem` — hence
  *every* star subalgebra of continuous observables containing the link
  coordinates is sup-norm dense, by Stone–Weierstrass.
* `decorrelation_of_polynomial_correlation`,
  `ym_uniform_gap_of_polynomial_mixing` — the resulting form of the `F1`
  payment: a connected two-slice correlation bound for the *mean-zero
  polynomials in the link variables* gives the two-slice estimate for every
  state, and (along the trajectory, with the spectral defect condition) the
  uniform vacuum form gap the continuum weld consumes.

A caution that matters for the physical reading: the algebra used here is the
algebra generated by the link coordinates, which is *not* gauge invariant.  The
gauge-invariant Wilson-loop algebra separates only gauge orbits, so it is dense
in the gauge-invariant subspace rather than in the whole slice `L²`; the
statements below are about the whole slice `L²`, which is the carrier the
finite-spacing gap of this development is stated on.  No correlation estimate is
proved here: as everywhere in this lane, the interacting estimate is an
explicitly displayed hypothesis.
-/
import Mathlib
import RequestProject.YangMills.Lattice.DenseCorrelationExtension

namespace RequestProject.YangMills.Lattice

open MeasureTheory
open scoped InnerProductSpace
open RequestProject.YangMills.VacuumSectorSpectralGap

/-! ## Coordinates of a unit quaternion -/

/-- The four real coordinates of a quaternion. -/
noncomputable def quatCoord : Fin 4 → Quaternion ℝ → ℝ :=
  ![fun q => q.re, fun q => q.imI, fun q => q.imJ, fun q => q.imK]

theorem continuous_quatCoord (i : Fin 4) : Continuous (quatCoord i) := by
  fin_cases i
  · exact Quaternion.continuous_re
  · exact Quaternion.continuous_imI
  · exact Quaternion.continuous_imJ
  · exact Quaternion.continuous_imK

/-- The four coordinates determine a quaternion. -/
theorem quatCoord_ext {x y : Quaternion ℝ} (h : ∀ i, quatCoord i x = quatCoord i y) : x = y := by
  refine Quaternion.ext x y ?_ ?_ ?_ ?_
  · simpa [quatCoord] using h 0
  · simpa [quatCoord] using h 1
  · simpa [quatCoord] using h 2
  · simpa [quatCoord] using h 3

/-! ## The link coordinate observables -/

/-- **A link coordinate observable**: the `i`-th quaternion coordinate of the
`SU(2)` gauge field on the spatial link `l`. -/
noncomputable def linkCoord {n : ℕ} (l : SliceIdx n) (i : Fin 4) : C(SliceIdx n → SU2, ℂ) :=
  ⟨fun u => ((quatCoord i (u l : Quaternion ℝ) : ℝ) : ℂ), by
    refine Complex.continuous_ofReal.comp ?_
    exact (continuous_quatCoord i).comp (continuous_subtype_val.comp (continuous_apply l))⟩

/-- **The link coordinates separate configurations.** -/
theorem separatesPoints_linkCoord (n : ℕ) :
    Set.SeparatesPoints
      ((fun f : C(SliceIdx n → SU2, ℂ) => (f : (SliceIdx n → SU2) → ℂ)) ''
        (Set.range fun p : SliceIdx n × Fin 4 => linkCoord p.1 p.2)) := by
  intro u v huv
  by_contra hcon
  push_neg at hcon
  apply huv
  funext l
  have hcoord : ∀ i, quatCoord i (u l : Quaternion ℝ) = quatCoord i (v l : Quaternion ℝ) := by
    intro i
    have h := hcon (⇑(linkCoord l i)) ⟨linkCoord l i, ⟨⟨l, i⟩, rfl⟩, rfl⟩
    have hre := congrArg Complex.re h
    simpa [linkCoord] using hre
  exact Subtype.ext (quatCoord_ext hcoord)

/-- A star subalgebra of continuous observables containing all link coordinates
separates configurations. -/
theorem starSubalgebra_separatesPoints_of_linkCoord {n : ℕ}
    (A : StarSubalgebra ℂ C(SliceIdx n → SU2, ℂ)) (hA : ∀ l i, linkCoord l i ∈ A) :
    A.SeparatesPoints := by
  intro u v huv
  obtain ⟨f, hf, hne⟩ := separatesPoints_linkCoord n huv
  obtain ⟨g, ⟨⟨l, i⟩, rfl⟩, rfl⟩ := hf
  exact ⟨⇑(linkCoord l i), ⟨linkCoord l i, hA l i, rfl⟩, hne⟩

/-- **Stone–Weierstrass for the link-coordinate algebra**: a star subalgebra of
continuous observables containing the link coordinates is sup-norm dense. -/
theorem dense_of_linkCoord_mem {n : ℕ} (A : StarSubalgebra ℂ C(SliceIdx n → SU2, ℂ))
    (hA : ∀ l i, linkCoord l i ∈ A) : Dense (A : Set C(SliceIdx n → SU2, ℂ)) :=
  dense_of_separatesPoints A (starSubalgebra_separatesPoints_of_linkCoord A hA)

/-! ## `F1` as an estimate on polynomials in the link variables -/

/-- **The two-slice estimate from a correlation bound on a link-coordinate
algebra.**  If the connected two-slice correlation of the literal `SU(2)`
Wilson–Gibbs measure is bounded by `c` times the `L²` norm squared for every
mean-zero element of a star algebra of continuous observables containing the
link coordinates — for instance the algebra of polynomials in the link
variables — then the two-slice estimate holds for every vacuum-orthogonal state
of the slice `L²` space. -/
theorem decorrelation_of_polynomial_correlation {n : ℕ} (beta : ℝ) {c : ℝ}
    (A : StarSubalgebra ℂ C(SliceIdx n → SU2, ℂ)) (hA : ∀ l i, linkCoord l i ∈ A)
    (hbound : ∀ f ∈ A, (∫ u, f u ∂(sliceMeasure n SU2 beta chiSU2)) = 0 →
      ‖∫ U, (starRingEnd ℂ) (f (slice0 U)) * f (slice1 U) ∂(gibbs n SU2 beta chiSU2)‖
        ≤ c * ∫ u, ‖f u‖ ^ 2 ∂(sliceMeasure n SU2 beta chiSU2))
    (ψ : SliceL2 n SU2 beta chiSU2) (hψ : ⟪vacuum continuous_chiSU2 beta, ψ⟫_ℂ = 0) :
    ‖⟪embed0 n SU2 beta chiSU2 ψ, embed1 continuous_chiSU2 beta ψ⟫_ℂ‖ ≤ c * ‖ψ‖ ^ 2 :=
  decorrelation_of_dense_continuous_correlation (G := SU2) continuous_chiSU2 beta
    (S := A.toSubalgebra.toSubmodule) (dense_of_linkCoord_mem A hA) A.one_mem' hbound ψ hψ

/-- **The trajectory form.**  Connected two-slice correlation bounds `c_k` for
the mean-zero polynomials in the link variables, together with the spectral
defect condition `Δ·a_k ≤ 1 − c_k`, give the uniform vacuum form gap `Δ` of the
literal physical Hamiltonians along the trajectory. -/
theorem ym_uniform_gap_of_polynomial_mixing (vol : ℕ → ℕ) (beta a : ℕ → ℝ)
    (hapos : ∀ k, 0 < a k) {cs : ℕ → ℝ} {Δ : ℝ}
    (A : ∀ k, StarSubalgebra ℂ C(SliceIdx (vol k) → SU2, ℂ))
    (hA : ∀ k, ∀ l i, linkCoord l i ∈ A k)
    (hbound : ∀ k, ∀ f ∈ A k,
      (∫ u, f u ∂(sliceMeasure (vol k) SU2 (beta k) chiSU2)) = 0 →
        ‖∫ U, (starRingEnd ℂ) (f (slice0 U)) * f (slice1 U)
            ∂(gibbs (vol k) SU2 (beta k) chiSU2)‖
          ≤ cs k * ∫ u, ‖f u‖ ^ 2 ∂(sliceMeasure (vol k) SU2 (beta k) chiSU2))
    (hdefect : ∀ k, Δ * a k ≤ 1 - cs k) :
    ∀ k, HasVacuumFormGap (ymTrajectoryHam vol beta a (fun k => (hapos k).le) k)
      (ymTrajectoryVacuum vol beta k) Δ :=
  ym_uniform_gap_of_dense_continuous_mixing vol beta a hapos
    (fun k => (A k).toSubalgebra.toSubmodule)
    (fun k => dense_of_linkCoord_mem (A k) (hA k))
    (fun k => (A k).one_mem') hbound hdefect

end RequestProject.YangMills.Lattice

