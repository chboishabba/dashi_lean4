namespace Wikidata

open Epistemic

/-! ## Bounded search -/

/-- The subclass engine run with an explicit budget instead of the exact one. -/
def boundedSubclass (kb : KB) (budget : Nat) (a b : Qid) : Bool :=
  Wikidata.Reach.reachIn (superclasses kb) budget a b

/-- Search results only improve with a larger budget. -/
theorem reachIn_mono {α : Type} [DecidableEq α] (succ : α → List α) :
    ∀ {m n : Nat} {a b : α}, m ≤ n → Wikidata.Reach.reachIn succ m a b = true →
      Wikidata.Reach.reachIn succ n a b = true := by
  intro m
  induction m with
  | zero =>
      intro n a b _ h
      have hab : a = b := by
        simpa [Wikidata.Reach.reachIn] using h
      cases n with
      | zero => simpa [Wikidata.Reach.reachIn] using hab
      | succ k => simp [Wikidata.Reach.reachIn, hab]
  | succ m ih =>
      intro n a b hle h
      cases n with
      | zero => exact absurd hle (by omega)
      | succ k =>
          have hk : m ≤ k := by omega
          rcases Bool.or_eq_true_iff.1 h with hEq | hAny
          · simp [Wikidata.Reach.reachIn, hEq]
          · rcases List.any_eq_true.1 hAny with ⟨c, hc, hrec⟩
            refine Bool.or_eq_true_iff.2 (Or.inr (List.any_eq_true.2 ⟨c, hc, ih hk hrec⟩))

/-- A bounded search never claims more than the data supports. -/
theorem boundedSubclass_sound {kb : KB} {budget : Nat} {a b : Qid}
    (h : boundedSubclass kb budget a b = true) : SubclassOf kb a b := by
  have := Wikidata.Reach.reachIn_sound (succ := superclasses kb) budget a b h
  have hstep : Wikidata.Reach.Step (superclasses kb) = DirectSubclass kb := by
    funext x y
    exact propext (step_iff_directSubclass kb x y)
  rwa [hstep] at this

/-- With the exact budget the bounded search is the project's subclass checker. -/
theorem boundedSubclass_full (kb : KB) (a b : Qid) :
    boundedSubclass kb (subclassEdges kb).length a b = isSubclassOf kb a b := rfl

/-! ## Coverage dispositions -/

/-- How much of the intended observation was actually made. -/
inductive CoverageStatus
  | complete
  | incomplete
  | notInspected
  | invalidObservation
  deriving DecidableEq, Repr, Inhabited, Fintype

/-- What a reviewer may do with an observation of a given coverage. -/
inductive ReviewDisposition
  | mayProceed
  | abstainForCoverage
  | abstainForInvalidObservation
  deriving DecidableEq, Repr, Inhabited, Fintype

/-- Only a complete observation lets review proceed. -/
def dispositionFor : CoverageStatus → ReviewDisposition
  | .complete => .mayProceed
  | .incomplete => .abstainForCoverage
  | .notInspected => .abstainForCoverage
  | .invalidObservation => .abstainForInvalidObservation

/-- Incomplete coverage forces abstention. -/
theorem incomplete_coverage_abstains : dispositionFor .incomplete = .abstainForCoverage := rfl

/-- So does a property that was never inspected. -/
theorem notInspected_abstains : dispositionFor .notInspected = .abstainForCoverage := rfl

/-- An invalid observation abstains for its own reason, which is not coverage. -/
theorem invalid_observation_abstains :
    dispositionFor .invalidObservation = .abstainForInvalidObservation := rfl

/-- Review proceeds only on complete coverage. -/
theorem mayProceed_only_on_complete (s : CoverageStatus) (h : dispositionFor s = .mayProceed) :
    s = .complete := by
  cases s <;> simp_all [dispositionFor]

/-- The coverage of a bounded subclass search. -/
def searchCoverage (kb : KB) (budget : Nat) : CoverageStatus :=
  if (subclassEdges kb).length ≤ budget then .complete else .incomplete

/-- **Complete coverage decides.**  Once the budget covers the edge list, the
bounded search is exact, so abstention is required exactly while it does not. -/
theorem complete_coverage_decides (kb : KB) (budget : Nat) (a b : Qid)
    (h : searchCoverage kb budget = .complete) :
    boundedSubclass kb budget a b = true ↔ SubclassOf kb a b := by
  have hle : (subclassEdges kb).length ≤ budget := by
    by_contra hlt
    simp [searchCoverage, hlt] at h
  refine ⟨boundedSubclass_sound, fun hsub => ?_⟩
  have hfull : isSubclassOf kb a b = true := (isSubclassOf_iff kb a b).2 hsub
  exact reachIn_mono (superclasses kb) hle hfull

/-! ## The frontier is not an absence -/

/-- A three-link chain: `Q1 ⊑ Q2 ⊑ Q3`. -/
def chainKB : KB where
  entities := [⟨1⟩, ⟨2⟩, ⟨3⟩]
  statements :=
    [ { subject := ⟨1⟩, property := P279, value := ⟨2⟩ }
    , { subject := ⟨2⟩, property := P279, value := ⟨3⟩ } ]

/-- **A bounded frontier is not an absence.**  With a budget of one step the
search reports nothing, while `Q1` really is a subclass of `Q3`. -/
theorem bounded_frontier_is_not_absence :
    boundedSubclass chainKB 1 ⟨1⟩ ⟨3⟩ = false ∧ SubclassOf chainKB ⟨1⟩ ⟨3⟩ := by
  refine ⟨by decide, ?_⟩
  exact (isSubclassOf_iff chainKB ⟨1⟩ ⟨3⟩).1 (by decide)

/-- With the coverage it needs, the same search answers. -/
theorem covered_search_answers : boundedSubclass chainKB 2 ⟨1⟩ ⟨3⟩ = true := by decide

/-- And the shortfall is visible as a coverage status, not as a verdict. -/
theorem chainKB_coverage_incomplete : searchCoverage chainKB 1 = .incomplete := by decide

/-! ## Fail-closed verdicts at the frontier -/

/-- The evidence state a bounded search may report. -/
def frontierVerdict (kb : KB) (budget : Nat) (a b : Qid) : Trit :=
  if boundedSubclass kb budget a b then .supported else .unresolved

/-- **A bounded search never refutes.** -/
theorem frontierVerdict_ne_contradicted (kb : KB) (budget : Nat) (a b : Qid) :
    frontierVerdict kb budget a b ≠ Trit.contradicted := by
  unfold frontierVerdict
  split <;> simp

/-- The support a bounded search does report is backed by the data. -/
theorem frontierVerdict_supported_iff (kb : KB) (budget : Nat) (a b : Qid) :
    frontierVerdict kb budget a b = Trit.supported ↔ boundedSubclass kb budget a b = true := by
  unfold frontierVerdict
  split <;> simp_all

/-- In particular, support at the frontier entails the subclass relation. -/
theorem subclassOf_of_frontierVerdict {kb : KB} {budget : Nat} {a b : Qid}
    (h : frontierVerdict kb budget a b = Trit.supported) : SubclassOf kb a b :=
  boundedSubclass_sound ((frontierVerdict_supported_iff kb budget a b).1 h)

/-! ## Uninspected properties -/

/-- The verdict about a property, relative to the list of properties actually
inspected. -/
def propertyVerdict (kb : KB) (inspected : List Pid) (x : Qid) (p : Pid) : Trit :=
  if hasProperty kb x p then .supported
  else if p ∈ inspected then .contradicted else .unresolved

/-- **A property nobody looked at is not a missing property.** -/
theorem uninspected_property_is_not_absence (kb : KB) (inspected : List Pid) (x : Qid) (p : Pid)
    (hnot : p ∉ inspected) (hmiss : hasProperty kb x p = false) :
    propertyVerdict kb inspected x p = Trit.unresolved := by
  simp [propertyVerdict, hmiss, hnot]

/-- A refutation requires both that the property was inspected and that it is
absent. -/
theorem propertyVerdict_contradicted_iff (kb : KB) (inspected : List Pid) (x : Qid) (p : Pid) :
    propertyVerdict kb inspected x p = Trit.contradicted ↔
      hasProperty kb x p = false ∧ p ∈ inspected := by
  unfold propertyVerdict
  by_cases hp : hasProperty kb x p = true
  · simp [hp]
  · have hp' : hasProperty kb x p = false := by simpa using hp
    by_cases hi : p ∈ inspected <;> simp [hp', hi]

/-- Support about a property is backed by a truthy statement. -/
theorem propertyVerdict_supported_iff (kb : KB) (inspected : List Pid) (x : Qid) (p : Pid) :
    propertyVerdict kb inspected x p = Trit.supported ↔ hasProperty kb x p = true := by
  unfold propertyVerdict
  by_cases hp : hasProperty kb x p = true
  · simp [hp]
  · have hp' : hasProperty kb x p = false := by simpa using hp
    by_cases hi : p ∈ inspected <;> simp [hp', hi]

end Wikidata
